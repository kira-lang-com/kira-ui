import Foundation
import KiraUI

// The seven token sets, written out as Kira source.

function emitHeader() -> String {
    var text = "import Foundation\n\n"
    text = text + "// Generated by tools/tokens from KCoreUI's default catalog. Do not edit.\n"
    text = text + "//\n"
    text = text + "// Every value here was resolved out of `Resources/Default.kcui`. The catalog\n"
    text = text + "// is the source of truth; this is what the default style reads, because a\n"
    text = text + "// field default is evaluated on every construction and resolving live costs\n"
    text = text + "// a catalog load per token set.\n"
    text = text + "//\n"
    text = text + "// Change the catalog, then run `kira run tools/tokens` from the repository\n"
    text = text + "// root. The test suite resolves these names live and compares, so a catalog\n"
    text = text + "// edited without re-running this fails rather than shipping.\n\n"
    return text
}

function emitPalette(tokens: borrow StylePaletteTokens) -> String {
    var text = "function generatedPaletteTokens() -> StylePaletteTokens {\n"
    text = text + "    return StylePaletteTokens {\n"
    text = text + adaptiveLiteral("        ", "red", tokens.red)
    text = text + adaptiveLiteral("        ", "orange", tokens.orange)
    text = text + adaptiveLiteral("        ", "yellow", tokens.yellow)
    text = text + adaptiveLiteral("        ", "green", tokens.green)
    text = text + adaptiveLiteral("        ", "mint", tokens.mint)
    text = text + adaptiveLiteral("        ", "teal", tokens.teal)
    text = text + adaptiveLiteral("        ", "cyan", tokens.cyan)
    text = text + adaptiveLiteral("        ", "blue", tokens.blue)
    text = text + adaptiveLiteral("        ", "indigo", tokens.indigo)
    text = text + adaptiveLiteral("        ", "purple", tokens.purple)
    text = text + adaptiveLiteral("        ", "pink", tokens.pink)
    text = text + adaptiveLiteral("        ", "brown", tokens.brown)
    text = text + adaptiveLiteral("        ", "gray", tokens.gray)
    text = text + "    }\n}\n\n"
    return text
}

function emitForegrounds(tokens: borrow StyleForegroundTokens) -> String {
    var text = "function generatedForegroundTokens() -> StyleForegroundTokens {\n"
    text = text + "    return StyleForegroundTokens {\n"
    text = text + adaptiveLiteral("        ", "primary", tokens.primary)
    text = text + adaptiveLiteral("        ", "secondary", tokens.secondary)
    text = text + adaptiveLiteral("        ", "tertiary", tokens.tertiary)
    text = text + adaptiveLiteral("        ", "quaternary", tokens.quaternary)
    text = text + adaptiveLiteral("        ", "inverse", tokens.inverse)
    text = text + "    }\n}\n\n"
    return text
}

function emitBackgrounds(tokens: borrow StyleBackgroundTokens) -> String {
    var text = "function generatedBackgroundTokens() -> StyleBackgroundTokens {\n"
    text = text + "    return StyleBackgroundTokens {\n"
    text = text + adaptiveLiteral("        ", "canvas", tokens.canvas)
    text = text + adaptiveLiteral("        ", "surface", tokens.surface)
    text = text + adaptiveLiteral("        ", "raised", tokens.raised)
    text = text + adaptiveLiteral("        ", "overlay", tokens.overlay)
    text = text + "    }\n}\n\n"
    return text
}

function emitFills(tokens: borrow StyleFillTokens) -> String {
    var text = "function generatedFillTokens() -> StyleFillTokens {\n"
    text = text + "    return StyleFillTokens {\n"
    text = text + adaptiveLiteral("        ", "control", tokens.control)
    text = text + adaptiveLiteral("        ", "hover", tokens.hover)
    text = text + adaptiveLiteral("        ", "selection", tokens.selection)
    text = text + "    }\n}\n\n"
    return text
}

function emitTints(tokens: borrow StyleTintTokens) -> String {
    var text = "function generatedTintTokens() -> StyleTintTokens {\n"
    text = text + "    return StyleTintTokens {\n"
    text = text + adaptiveLiteral("        ", "accent", tokens.accent)
    text = text + adaptiveLiteral("        ", "success", tokens.success)
    text = text + adaptiveLiteral("        ", "warning", tokens.warning)
    text = text + adaptiveLiteral("        ", "danger", tokens.danger)
    text = text + "    }\n}\n\n"
    return text
}

function emitBorders(tokens: borrow StyleBorderTokens) -> String {
    var text = "function generatedBorderTokens() -> StyleBorderTokens {\n"
    text = text + "    return StyleBorderTokens {\n"
    text = text + borderLiteral("        ", "none", tokens.none)
    text = text + borderLiteral("        ", "subtle", tokens.subtle)
    text = text + borderLiteral("        ", "standard", tokens.standard)
    text = text + borderLiteral("        ", "strong", tokens.strong)
    text = text + borderLiteral("        ", "focus", tokens.focus)
    text = text + "    }\n}\n\n"
    return text
}

function emitTypography(tokens: borrow StyleTypographyTokens) -> String {
    var text = "function generatedTypographyTokens() -> StyleTypographyTokens {\n"
    text = text + "    return StyleTypographyTokens {\n"
    text = text + fontLiteral("        ", "caption", tokens.caption)
    text = text + fontLiteral("        ", "body", tokens.body)
    text = text + fontLiteral("        ", "control", tokens.control)
    text = text + fontLiteral("        ", "title", tokens.title)
    text = text + fontLiteral("        ", "bodyEmphasis", tokens.bodyEmphasis)
    text = text + fontLiteral("        ", "subheadline", tokens.subheadline)
    text = text + fontLiteral("        ", "footnote", tokens.footnote)
    text = text + fontLiteral("        ", "overline", tokens.overline)
    text = text + fontLiteral("        ", "label", tokens.label)
    text = text + fontLiteral("        ", "section", tokens.section)
    text = text + fontLiteral("        ", "headline", tokens.headline)
    text = text + fontLiteral("        ", "title1", tokens.title1)
    text = text + fontLiteral("        ", "title2", tokens.title2)
    text = text + fontLiteral("        ", "title3", tokens.title3)
    text = text + "    }\n}\n"
    return text
}

function emitAll() -> String {
    var text = emitHeader()
    text = text + emitPalette(catalogPaletteTokens())
    text = text + emitForegrounds(catalogForegroundTokens())
    text = text + emitBackgrounds(catalogBackgroundTokens())
    text = text + emitFills(catalogFillTokens())
    text = text + emitTints(catalogTintTokens())
    text = text + emitBorders(catalogBorderTokens())
    text = text + emitTypography(catalogTypographyTokens())
    return text
}

@Main
function main() -> Int {
    let source = emitAll()
    if !writeFile(generatedPath(), source) {
        printLine("tokens: could not write " + generatedPath())
        return 1
    }
    printLine("tokens: wrote " + generatedPath() + " (" + String(source.count) + " bytes)")
    return 0
}
