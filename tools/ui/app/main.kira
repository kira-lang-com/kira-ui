import Foundation
import ArgumentParser
import KiraUI
import Ember

// `ui` — the Kira UI command line, over both layers: it runs a tree of KiraUI
// widgets, which lower onto the UI Foundation, and reads a frame back. Launch and
// capture are typed flags fed through the foundation's harness, not the
// KIRA_GRAPHICS_CAPTURE_* / KIRA_UI_* environment variables a driven run used.

// A small gallery of KiraUI widgets, enough to prove both layers draw: the
// widgets are KiraUI, the column and text they lower to are the Foundation's.
construct Gallery() extends Widget {
    body {
        AppSurface {
            VStack(spacing: .Small) {
                Text(content: "Kira UI")
                Text(content: "UIFoundation + KiraUI")
                Button(
                    title: "Primary",
                    action: { in
                        return
                    }
                )
                Button(
                    title: "Danger",
                    role: .Destructive,
                    action: { in
                        return
                    }
                )
            }
        }
    }
}

@Derive(Parsable)
struct ShotArguments {
    let out: String
    let app: String?
    let arg: String?
    let frames: Number
    let at: Number
    let width: Number
    let height: Number
}

// Capture an application this command was never linked against.
//
// It needs no cooperation from the application and none of them were changed to
// allow it: Ember resolves its harness from the ENVIRONMENT whenever a run
// was handed none, so setting those variables and starting the program is the
// whole mechanism. An application that builds its own harness in code is saying
// it wants different knobs, and this correctly leaves it alone.
//
// The alternative -- a `shot` command inside every application -- is the same
// work repeated once per program and then drifting: one spells the flag `--out`,
// the next `-o`, and reviewing two side by side means remembering which is which.
function shootForeignApp(parsed: borrow ShotArguments, app: borrow String) -> Number {
    setCaptureEnvironment(parsed)
    // The launcher passes no argument for an empty one.
    let argument = match parsed.arg {
        Some(text) -> text
        None -> ""
    }
    let status = Number(kira_ui_launch_run(app, argument))
    if status != 0 {
        print("ui shot: \(app) exited with \(status)")
        return status
    }
    print("captured " + parsed.out)
    return 0
}

// The capture settings, in the environment Ember resolves its harness from when
// a run is handed none: a child inherits them, and the gallery run here reads them.
function setCaptureEnvironment(parsed: borrow ShotArguments) {
    kira_ui_launch_set("KIRA_GRAPHICS_CAPTURE_FRAME", parsed.out)
    kira_ui_launch_set("KIRA_GRAPHICS_CAPTURE_AT", String(parsed.at))
    kira_ui_launch_set("KIRA_GRAPHICS_QUIT_AFTER_FRAMES", String(parsed.frames))
}

construct ShotCommand() extends ParsableCommand {
    let configuration: CommandConfiguration {
        return CommandConfiguration {
            name: "shot",
            abstract: "Run the widget gallery and capture a frame to a PPM"
        }
    }

    let arguments: [ArgumentSpec] {
        return [option(name: "out", help: "Destination .ppm for the captured frame").short(
            "o"
        ).required(), option(
            name: "app",
            help: "Executable to run and capture; omitted, the built-in gallery is drawn"
        ).short("p"), option(name: "arg", help: "One argument to pass the application").short(
            "g"
        ), option(name: "frames", help: "Quit after this many frames").short(
            "f"
        ).whole().defaulting("120"), option(
            name: "at",
            help: "Capture at this frame (0 = the last one drawn)"
        ).short("a").whole().defaulting("0"), option(name: "width", help: "Window width").short(
            "w"
        ).whole().defaulting("1200"), option(name: "height", help: "Window height").short(
            "t"
        ).whole().defaulting("800")]
    }

    function run(arguments: borrow ParsedArguments) -> Number {
        let parsed = parse_ShotArguments(arguments)
        match parsed.app {
            Some(app) -> return shootForeignApp(parsed, app)
            // No application: the built-in gallery is drawn.
            None -> {}
        }
        setCaptureEnvironment(parsed)
        RunKiraWindowApp(
            "Kira UI Gallery",
            parsed.width,
            parsed.height,
            { in
                return Gallery()
            }
        )
        print("captured " + parsed.out)
        return 0
    }
}

construct RootCommand() extends ParsableCommand {
    let configuration: CommandConfiguration {
        return CommandConfiguration {
            name: "ui",
            abstract: "Kira UI command line (UIFoundation + KiraUI)",
            subcommands: ["shot"]
        }
    }

    let arguments: [ArgumentSpec] {
        return []
    }

    function run(arguments: borrow ParsedArguments) -> Number {
        return 0
    }
}

@Main
function main() -> Int {
    let root = RootCommand()
    let children: [Any ParsableCommand] = [ShotCommand()]
    return runCommandRouter(root, children, commandLineArguments())
}
