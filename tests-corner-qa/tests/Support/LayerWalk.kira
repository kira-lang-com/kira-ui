import Foundation
import KiraUI
import KCoreAnimation

// The layer at the bottom of a chain of single children: a modifier wraps its
// view in one layer per modifier, and the view itself is the innermost.
function innermostLayer(described: borrow CALayerDescription) -> CALayerDescription {
    var layer = copy described
    while layer.sublayers.count == 1 { layer = copy layer.sublayers[0] }
    return layer
}
