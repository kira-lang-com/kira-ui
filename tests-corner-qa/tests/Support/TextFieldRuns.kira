import Foundation
import KiraUI
import KCoreAnimation

// A text field's own layer, under the frames around it.
function fieldLayerOf(described: borrow CALayerDescription) -> CALayerDescription {
    var field = copy described
    while field.hitKey == 0 && field.sublayers.count == 1 { field = copy field.sublayers[0] }
    return field
}

// The runs of a text field: its placeholder, or its text around the caret,
// standing in the one line the field sets across itself. A field with no runs
// has none.
function fieldRunsOf(described: borrow CALayerDescription) -> [CALayerDescription] {
    let field = fieldLayerOf(described)
    if field.sublayers.count != 1 {
        return []
    }
    return copy field.sublayers[0].sublayers
}
