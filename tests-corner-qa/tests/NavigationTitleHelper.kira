import Foundation
import KiraUI
import KCoreAnimation

// Helper from the complete KiraUI navigation tests, included in this focused
// temporary package so the rail regression tests can run independently.
function navigationContainsTitle(layer: borrow CALayerDescription, title: borrow String) -> Bool {
    match layer.content {
        Text(run) -> { if run.content == title { return true } }
        else -> {}
    }
    for child in layer.sublayers {
        if navigationContainsTitle(child, title) { return true }
    }
    return false
}
