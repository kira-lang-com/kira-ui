import Foundation
import KiraUI
import KCoreAnimation

@Test
function clippedUsesNativeClipAndKeepsMeasuredLayout() {
    let unclipped = describedLayer(
        Rectangle().frame(width: 150.0, height: 80.0)
    )
    var clipped = describedLayer(
        Rectangle().frame(width: 150.0, height: 80.0).clipped()
    )
    layOutLayerTree(clipped, 150.0, 80.0)
    expect!(clipped.clipsChildren)
    expect!(clipped.sublayers.count == 1)
    expect!(clipped.size.width == 150.0)
    expect!(clipped.size.height == 80.0)
    expect!(clipped.sublayers[0].size.width == 150.0)
    expect!(unclipped.clipsChildren == false)
}