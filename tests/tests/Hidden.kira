import Foundation
import KiraUI
import KCoreAnimation

@Test
function hiddenPreservesLayoutButDoesNotDraw() {
    var visible = describedLayer(Text("Layout footprint"))
    var hidden = describedLayer(Text("Layout footprint").hidden())
    layOutLayerTree(visible, 320.0, 100.0)
    layOutLayerTree(hidden, 320.0, 100.0)
    expect!(hidden.opacity == 0.0)
    expect!(visible.size.width == hidden.size.width)
    expect!(visible.size.height == hidden.size.height)
}

@Test
function hiddenRemovesTheAccessibilitySubtree() {
    let labeled = accessibilityElementsOf(
        Text("Sensitive").accessibilityLabel("Readable")
    )
    let hidden = accessibilityElementsOf(
        Text("Sensitive").accessibilityLabel("Readable").hidden()
    )
    expect!(labeled.count == 1)
    expect!(hidden.count == 0)
    let labeledOutside = accessibilityElementsOf(
        Text("Sensitive").hidden().accessibilityLabel("Readable")
    )
    expect!(labeledOutside.count == 0)
}