import Foundation
import KiraUI
import KCoreAnimation

@Test
function longTouchGestureCreatesAnInteractiveHeldGestureArea() {
    let gesture = describedLayer(
        Text("Hold").onLongTouchGesture(minimumDuration: 0.75,
            action: { in }, onTouchingChanged: { touching in })
    )
    expect!(gesture.hittable)
    expect!(gesture.interactive)
    expect!(gesture.hitKey != 0)
    expect!(describedContainsText(gesture, "Hold"))
}

@Test
function defaultLongTouchOverloadRemainsAvailable() {
    let gesture = describedLayer(Text("Hold").onLongTouchGesture(action: { in }))
    expect!(gesture.hittable)
}