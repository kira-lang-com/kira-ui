import Foundation
import KiraUI

// The toolbar, sidebar, principal and navigation-drawer choices are distinct
// placements, not extra signatures that silently select the same behavior.
@Test
function searchPlacementKeepsBothNavigationDrawerDisplayModes() {
    expect!(navigationBarDrawer(.Automatic) == SearchFieldPlacement.NavigationBarDrawer)
    expect!(navigationBarDrawer(.Always) == SearchFieldPlacement.NavigationBarDrawerAlways)
    expect!(SearchFieldPlacement.Toolbar != SearchFieldPlacement.ToolbarPrincipal)
    expect!(SearchFieldPlacement.Toolbar != SearchFieldPlacement.Sidebar)
}

@Test
function searchMetadataKeepsItsRequestedPlacementAndPrompt() {
    let declared = WindowSearch {
        prompt: "Search chats",
        placement: .ToolbarPrincipal,
        presented: true
    }
    expect!(declared.prompt == "Search chats")
    expect!(declared.placement == SearchFieldPlacement.ToolbarPrincipal)
    expect!(declared.presented)
}