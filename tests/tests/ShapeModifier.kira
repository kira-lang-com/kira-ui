import Foundation
import KiraUI
import KCoreAnimation
import KiraLayout

// SwiftUI's `.clipShape(_:)`, `.strokeBorder(lineWidth:)` and
// `.ignoresSafeArea(_:edges:)`.

// Clipped to a rounded rectangle, the view is drawn inside its corners.
@Test
function aClipShapeClipsToItsCorners() {
    let described = describedLayer(Rectangle().clipShape(.RoundedRect(12.0)))
    expect!((described.clipsChildren) == (true))
    expect!((described.cornerRadius) == (12.0))
}

// A stroked border is the shape's outline alone, as wide as it is asked, with
// no fill inside it.
@Test
function aStrokeBorderIsTheOutlineAlone() {
    let described = describedLayer(
        RoundedRectangle(cornerRadius: 3.0).strokeBorder(lineWidth: resolvedLength(1.5))
    )
    match described.content {
        Solid(solid) -> {
            expect!((solid.fill.a) == (0.0))
            expect!((solid.borderWidth) == (1.5))
        }
        else -> {
            // A stroked border is a solid outline; any other content fails here.
            expect!((false) == (true))
        }
    }
}

// Ignoring the safe area, a view inside it draws out to the window's edges
// on the edges named, and keeps its place in the layout.
@Test
function aViewIgnoringTheSafeAreaReachesTheEdges() {
    var context = buildContext(FoundationUiContext {})
    context.safeArea = EdgeInsets { top: 20.0, bottom: 30.0 }
    var described = Rectangle().ignoresSafeArea(edges: EdgeSet.bottom).describe(
        context,
        ModifierContext {}
    )
    layOutLayerTree(described, 400.0, 300.0)
    let reaching = described.sublayers[0]
    expect!((described.size.height) == (300.0))
    expect!((reaching.size.height) == (330.0))
    expect!((reaching.layout.offset.y) == (0.0))
}
