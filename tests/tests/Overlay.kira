import Foundation
import KiraUI
import KCoreAnimation

// SwiftUI's `.overlay(_:alignment:)`: drawn over the content, in its box.

// An overlay wider than its content leaves the content its size.
@Test
function overlayTakesNoRoom() {
    let base = Rectangle().frame(width: 20.0, height: 10.0)
    let measured = describedLayer(base.overlay(Text(content: "Reduce Interruptions"))).measure(
        400.0
    )
    expect!((measured.width) == (20.0))
    expect!((measured.height) == (10.0))
}

// Aligned to the trailing edge, a narrower overlay ends where its content does.
@Test
function overlayStandsWhereItsAlignmentSays() {
    let base = Rectangle().frame(width: 100.0, height: 40.0)
    let mark = Rectangle().frame(width: 10.0, height: 10.0)
    var described = describedLayer(base.overlay(move mark, alignment: .Trailing))
    layOutLayerTree(described, 400.0, 300.0)
    let over = innermostLayer(described).sublayers[1]
    expect!((over.position.x) == (90.0))
    expect!((over.position.y) == (15.0))
    expect!((over.size.width) == (10.0))
}
