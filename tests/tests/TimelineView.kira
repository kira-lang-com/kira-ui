import Foundation
import KiraUI
import KCoreAnimation

// SwiftUI's `TimelineView`: a view is built from the time, and asks to be built
// again on its next tick.

// A timeline view on a five-second schedule is built with the time, and asks
// for its next tick within those five seconds.
@Test
function aTimelineViewAsksForItsNextTick() {
    var built: Number = 0.0
    describedLayer(
        TimelineView(
            schedule: .Periodic(5.0),
            content: { timeline in
                built = timeline.date
                return Text(content: "tick")
            }
        )
    )
    expect!((built > 0.0) == (true))
    match redrawWaitLimit(.None) {
        Some(limit) -> {
            expect!((limit >= 0.0) == (true))
            expect!((limit <= 5000.0) == (true))
        }
        None -> expect!((false) == (true))
    }
}
