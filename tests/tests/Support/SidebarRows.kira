import Foundation
import KiraUI
import KCoreAnimation

// The leading edge of the text a sidebar row draws, measured from the edge of
// the section that holds it.
function sidebarRowTextX(section: borrow CALayerDescription, row: Number) -> Number {
    let cell = section.sublayers[row]
    let band = cell.sublayers[0]
    return cell.position.x + band.position.x + band.sublayers[0].position.x
}
