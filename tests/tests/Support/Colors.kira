import Foundation
import KiraUI
import KCoreAnimation

// Colour equality across the four channels, which is what a test means when
// it says two inks are the same.
function sameColor(a: borrow CAColor, b: borrow CAColor) -> Bool {
    return a.r == b.r && a.g == b.g && a.b == b.b && a.a == b.a
}

// The fill of a solid layer, or a clear colour for any other content.
function solidFillOf(layer: borrow CALayerDescription) -> CAColor {
    var fill = CAColor { a: 0.0 }
    match layer.content {
        Solid(s) -> fill = copy s.fill
        else -> {
            // Only a solid layer is filled; any other content stays clear.
        }
    }
    return fill
}
