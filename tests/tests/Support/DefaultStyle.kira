import Foundation
import KiraUI

// The default style, and the tokens it resolves to.
function defaultStyle() -> Any StyleImplementation {
    return DefaultStyle {}
}

function defaultTokens() -> ThemeTokens {
    return styleThemeTokens(DefaultStyle {})
}

// Whether this host paints as a Mac. A colour is read once, in the mode the
// program starts in, and a desktop reads the Mac's renditions where the catalog
// has them, and the kit's elsewhere.
function runsAsMac() -> Bool {
    return hostInterfaceMode() == .AdaptiveDesktop
}
