import Foundation

// Four colour channels, red to alpha, on the unit scale.
struct ChannelSet {
    var r: Number = 0
    var g: Number = 0
    var b: Number = 0
    var a: Number = 0
}

// Channels as a token reads them.
function channelsOf(r: Number, g: Number, b: Number, a: Number) -> ChannelSet {
    return ChannelSet { r: r, g: g, b: b, a: a }
}

// Channels as a catalog quotes them: red, green and blue on 0-255, alpha on the
// unit scale.
function kitChannels(r: Number, g: Number, b: Number, a: Number) -> ChannelSet {
    return ChannelSet { r: r / 255.0, g: g / 255.0, b: b / 255.0, a: a }
}

// Two numbers agree within the rounding a catalog's 16.16 fixed-point channel
// leaves behind, which is finer than an 8-bit channel can express.
function nearly(left: Number, right: Number) -> Bool {
    return abs(left - right) < 0.0001
}

function channelsMatch(actual: ChannelSet, expected: ChannelSet) -> Bool {
    return nearly(actual.r, expected.r) && nearly(actual.g, expected.g)
        && nearly(actual.b, expected.b) && nearly(actual.a, expected.a)
}
