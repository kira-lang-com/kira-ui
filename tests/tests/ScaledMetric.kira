import Foundation
import KiraUI

// A length stated through `scaledMetric` is the kit's on a phone and the
// body's ratio of it on a desktop; a resolved length is taken as it is.
@Test
function scaledMetricFollowsTheSizing() {
    setInterfaceMode(.AdaptiveDesktop)
    expect!((scaledMetric(17).points) == (13.0))
    expect!((scaledMetric(34).points) == (26.0))
    expect!((scaledMetric(8.5).points) == (6.5))
    expect!((resolvedLength(20).points) == (20.0))
    setInterfaceMode(.AdaptiveMobile)
    expect!((scaledMetric(17).points) == (17.0))
    expect!((scaledMetric(34).points) == (34.0))
    setInterfaceMode(hostInterfaceMode())
}
