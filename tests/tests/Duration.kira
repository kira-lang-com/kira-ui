import Foundation
import KiraUI

// Swift's `Duration` formatted as its time style writes it.

// The minute-second style writes a duration in minutes and seconds, rounding to
// the whole second; the hour styles add the hours.
@Test
function aDurationIsWrittenInItsUnits() {
    expect!((Duration { seconds: 97.0 }.formatted(.Time(.MinuteSecond))) == ("1:37"))
    expect!((Duration { seconds: 2.5 }.formatted(.Time(.MinuteSecond))) == ("0:02"))
    expect!((Duration { seconds: 3725.0 }.formatted(.Time(.HourMinuteSecond))) == ("1:02:05"))
    expect!((Duration { seconds: 3725.0 }.formatted(.Time(.HourMinute))) == ("1:02"))
}
