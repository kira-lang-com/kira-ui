import Foundation
import KiraUI

// A length stated through `scaledMetric` is the kit's on a phone and the
// body's ratio of it on a desktop; a resolved length is taken as it is.
construct KuiScaledMetricFollowsTheSizing() extends Test {
    test {
        setInterfaceMode(.AdaptiveDesktop)
        let desktop = scaledMetric(17).points
        let doubled = scaledMetric(34).points
        let fraction = scaledMetric(8.5).points
        let resolved = resolvedLength(20).points
        setInterfaceMode(.AdaptiveMobile)
        let mobile = scaledMetric(17).points
        let mobileDoubled = scaledMetric(34).points
        setInterfaceMode(hostInterfaceMode())
        return desktop == 13 && doubled == 26 && fraction == 6.5 && resolved == 20 && mobile == 17
            && mobileDoubled == 34
    }
    expect {
        let expected: Result<Any, TestFailure> = .Ok(true)
        return expected
    }
}
