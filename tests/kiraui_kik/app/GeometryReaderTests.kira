import Foundation
import KiraUI
import KCoreAnimation

// SwiftUI's `GeometryReader`: it takes the room it is offered and builds its
// content from the size that comes to.

// Placed in a box, the reader builds a view half the box wide and as tall,
// at the box's top leading corner.
construct KuiAGeometryReaderBuildsFromItsSize() extends Test {
    test {
        var described = kuiDescribe(
            GeometryReader { proxy in
                return Rectangle().frame(width: proxy.size.width / 2, height: proxy.size.height)
            }.frame(width: 120.0, height: 40.0)
        )
        layOutLayerTree(described, 400.0, 300.0)
        var reader = described
        while reader.sublayers.count == 1 && reader.sizedContentKey == 0 {
            reader = copy reader.sublayers[0]
        }
        let content = reader.sublayers[0]
        return "\(reader.size.width)x\(reader.size.height) \(content.size.width)x\(content.size.height) at \(content.position.x),\(content.position.y)"
    }
    expect {
        let expected: Result<Any, TestFailure> = .Ok("120x40 60x40 at 0,0")
        return expected
    }
}

// In a row the reader takes what its siblings leave, as SwiftUI's does.
construct KuiAGeometryReaderTakesTheRowsRoom() extends Test {
    test {
        var described = kuiDescribe(
            HStack(spacing: .Length(0.0)) {
                Rectangle().frame(width: 30.0, height: 10.0)
                GeometryReader { proxy in
                    return Rectangle().frame(width: proxy.size.width, height: 10.0)
                }
                .height(resolvedLength(10.0))
            }.frame(width: 200.0, height: 10.0)
        )
        layOutLayerTree(described, 400.0, 300.0)
        var row = described
        while row.sublayers.count == 1 { row = copy row.sublayers[0] }
        var reader = copy row.sublayers[1]
        while reader.sublayers.count == 1 && reader.sizedContentKey == 0 {
            reader = copy reader.sublayers[0]
        }
        return reader.size.width
    }
    expect {
        let expected: Result<Any, TestFailure> = .Ok(170.0)
        return expected
    }
}
