import Foundation
import KiraUI
import KCoreAnimation

// How a button is drawn under `.buttonStyle(...)`, and where the lines of a
// wrapped run sit under `.multilineTextAlignment(...)`.

function kuiSameColor(a: borrow CAColor, b: borrow CAColor) -> Bool {
    return a.r == b.r && a.g == b.g && a.b == b.b && a.a == b.a
}

// The fill of a solid layer, or a clear color for any other content.
function kuiSolidFill(layer: borrow CALayerDescription) -> CAColor {
    var fill = CAColor { a: 0.0 }
    match layer.content {
        Solid(s) -> fill = copy s.fill
        Empty -> {}
        Text(t) -> {}
        Texture(x) -> {}
        Icon(i) -> {}
        Glass(g) -> {}
        Gradient(g) -> {}
    }
    return fill
}

construct KuiCenteredTextSitsMidway() extends Test {
    test {
        let centered = kuiTextRun(kuiDescribe(Text(content: "Sync").multilineTextAlignment(.Center)))
        let trailing = kuiTextRun(kuiDescribe(Text(content: "Sync").multilineTextAlignment(.Trailing)))
        let leading = kuiTextRun(kuiDescribe(Text(content: "Sync")))
        return centered.alignment == 0.5 && trailing.alignment == 1.0 && leading.alignment == 0.0
    }
    expect {
        let expected: Result<Any, TestFailure> = .Ok(true)
        return expected
    }
}

// The alignment reaches every run under it, not only the one it is set on.
construct KuiTextAlignmentCascades() extends Test {
    test {
        let described = kuiDescribe(VStack {
            Text(content: "One")
            Text(content: "Two")
        }.multilineTextAlignment(.Center))
        return kuiTextRun(described.sublayers[0]).alignment + kuiTextRun(described.sublayers[1]).alignment
    }
    expect {
        let expected: Result<Any, TestFailure> = .Ok(1.0)
        return expected
    }
}

// On its own, an automatic button is its label in the accent, with no fill.
construct KuiAStandaloneButtonIsBorderless() extends Test {
    test {
        let button = kuiDescribe(Button(title: "Open Settings", action: kuiNoAction))
        let accent = kuiTextRun(kuiDescribe(Text(content: "Open Settings").foregroundColor(.Accent)))
        let run = kuiTextRun(button)
        return run.content == "Open Settings" && kuiSameColor(run.color, accent.color) && button.hittable
    }
    expect {
        let expected: Result<Any, TestFailure> = .Ok(true)
        return expected
    }
}

// A plain button keeps the label's own ink.
construct KuiAPlainButtonKeepsItsInk() extends Test {
    test {
        let run = kuiTextRun(kuiDescribe(Button(title: "Done", action: kuiNoAction).buttonStyle(.Plain)))
        let bare = kuiTextRun(kuiDescribe(Text(content: "Done")))
        return kuiSameColor(run.color, bare.color)
    }
    expect {
        let expected: Result<Any, TestFailure> = .Ok(true)
        return expected
    }
}

// A bordered button is a rounded rectangle hugging its padded label, washed in the
// accent under the accent's words.
construct KuiABorderedButtonIsAWashedCapsule() extends Test {
    test {
        let button = kuiDescribe(Button(title: "Open Settings", action: kuiNoAction).buttonStyle(.Bordered))
        let metrics = resolvedControlMetrics(ModifierContext {})
        let accent = kuiTextRun(kuiDescribe(Text(content: "Open Settings").foregroundColor(.Accent)))
        let fill = kuiSolidFill(button)
        var out = 0
        if button.sublayers.count == 1 && !button.layout.widthFill && !button.layout.heightFill
            && button.layout.paddingLeading == metrics.buttonHorizontalInset
            && button.layout.paddingTop == metrics.buttonVerticalInset
            && button.cornerRadius == cornerRadiusImplementation(.Small, ModifierContext {})
            && fill.a > 0.0 && fill.a < accent.color.a
            && kuiSameColor(kuiTextRun(button.sublayers[0]).color, accent.color) {
            out = 1
        }
        return out
    }
    expect {
        let expected: Result<Any, TestFailure> = .Ok(1)
        return expected
    }
}

// A prominent button is a rounded rectangle of the accent under white words.
construct KuiAProminentButtonIsFilledWithTheAccent() extends Test {
    test {
        let button = kuiDescribe(Button(title: "Open Settings", action: kuiNoAction).buttonStyle(.BorderedProminent))
        let accent = kuiTextRun(kuiDescribe(Text(content: "Open Settings").foregroundColor(.Accent)))
        let words = kuiTextRun(button.sublayers[0])
        return kuiSameColor(kuiSolidFill(button), accent.color) && kuiSameColor(words.color, CAColor { r: 1.0, g: 1.0, b: 1.0, a: 1.0 })
    }
    expect {
        let expected: Result<Any, TestFailure> = .Ok(true)
        return expected
    }
}

// The style reaches every button under it, and a destructive one takes the
// danger ink.
construct KuiButtonStyleCascades() extends Test {
    test {
        let described = kuiDescribe(VStack {
            Button(title: "Keep", action: kuiNoAction)
            Button(title: "Delete", role: .Destructive, action: kuiNoAction)
        }.buttonStyle(.BorderedProminent))
        let danger = kuiTextRun(kuiDescribe(Text(content: "Delete").foregroundColor(.Danger)))
        return described.sublayers[0].sublayers.count == 1
            && kuiSameColor(kuiSolidFill(described.sublayers[1]), danger.color)
    }
    expect {
        let expected: Result<Any, TestFailure> = .Ok(true)
        return expected
    }
}

// `.buttonBorderShape(...)` names the outline: a capsule's ends are round, a
// stated radius is that radius, and a circle stands as wide as it is tall.
construct KuiButtonBorderShapeNamesTheOutline() extends Test {
    test {
        let capsule = kuiDescribe(Button(title: "Sync", action: kuiNoAction).buttonStyle(.Bordered).buttonBorderShape(.Capsule))
        let stated = kuiDescribe(Button(title: "Sync", action: kuiNoAction).buttonStyle(.Bordered).buttonBorderShape(.RoundedRectangleRadius(3.0)))
        let circle = kuiDescribe(Button(action: kuiNoAction) {
            Text(content: "+")
        }.buttonStyle(.BorderedProminent).buttonBorderShape(.Circle))
        return capsule.cornerRadius > 1000.0 && stated.cornerRadius == 3.0
            && circle.layout.minWidth == circle.layout.minHeight && circle.layout.minWidth > 0.0
            && circle.layout.paddingLeading == circle.layout.paddingTop
    }
    expect {
        let expected: Result<Any, TestFailure> = .Ok(true)
        return expected
    }
}

// An automatic button is text only even where a border shape is set.
construct KuiABorderShapeAloneDrawsNoBorder() extends Test {
    test {
        let button = kuiDescribe(Button(title: "Sync", action: kuiNoAction).buttonBorderShape(.Capsule))
        return kuiTextRun(button).content == "Sync" && kuiSolidFill(button).a == 0.0
    }
    expect {
        let expected: Result<Any, TestFailure> = .Ok(true)
        return expected
    }
}

// A text button held down lightens its ink a step at once -- the label's own color, so it
// keeps its hue -- with no surface of glass to swell or lean.
construct KuiAHeldTextButtonLightensItsInk() extends Test {
    test {
        kiraUiTapSeqReset()
        let resting = kuiDescribe(Button(title: "Open Settings", action: kuiNoAction))
        let key = resting.hitKey
        kiraUiTapSeqReset()
        let context = buildContext(FoundationUiContext { pressedKey: key, hoveredKey: key })
        let held = Button(title: "Open Settings", action: kuiNoAction).describe(context, ModifierContext {})
        let ink = kuiTextRun(resting).color
        let dimmed = kuiTextRun(held).color
        return key != 0 && held.hitKey == key && held.opacity == 1.0 && !held.allowsGroupOpacity
            && dimmed.b == ink.b && dimmed.a > ink.a * 0.5 && dimmed.a < ink.a
            && kuiTimed(held) && !held.interactive && !resting.interactive
    }
    expect {
        let expected: Result<Any, TestFailure> = .Ok(true)
        return expected
    }
}

// A touch on glass lights it faintly, fainter in the dark, and from a light
// reaching past the window, so a large surface still catches a trace of it.
construct KuiTheTouchLightIsFaintAndWindowWide() extends Test {
    test {
        var glass = CAGlass {}
        let light = MotionLight { x: 10.0, y: 10.0, radius: 1500.0, strength: motionGlowLevel() }
        let modifiers = ModifierContext {}
        interactiveGlassLit(glass, light, modifiers)
        let context = buildContext(FoundationUiContext { viewport: Size { width: 1100.0, height: 720.0 } })
        return glass.glowStrength == glassTouchLightLevel(modifierAppearance(modifiers))
            && glassTouchLightLevel(.Light) <= 0.2
            && glassTouchLightLevel(.Dark) < glassTouchLightLevel(.Light)
            && glassTouchLightReach(context) > 1100.0 * 2.0
    }
    expect {
        let expected: Result<Any, TestFailure> = .Ok(true)
        return expected
    }
}
