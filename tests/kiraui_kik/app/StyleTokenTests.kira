import Foundation
import KiraUI

// The default style's tokens.
//
// These are renditions in the KCoreUI catalog, and the catalog's colors are
// Apple's: the variables of the iOS and iPadOS 27 design kit, quoted 0-255 as
// the kit quotes them. A regression here is a regression in what the toolkit
// draws. What Apple has no word for -- the intents, the border ladder, ink on a
// filled control -- is the toolkit's own, quoted as it was authored.
//
// A catalog stores a channel as 16.16 fixed point, in Display P3, so a value
// comes back within a few parts in 65536 of what was written. That is finer
// than an 8-bit channel can express, and it is why these compare within a
// tolerance rather than exactly.

function kuiNear(left: Float, right: Float) -> Bool {
    return abs(left - right) < 0.0001
}

// Compared channel by channel rather than through one color parameter. KiraUI
// declares its own `Color` and the resolved token structs carry another, so a
// helper taking either would only work on half the cases here.
function kuiRgba(r: Float, g: Float, b: Float, a: Float, er: Float, eg: Float, eb: Float, ea: Float) -> Bool {
    return kuiNear(r, er) && kuiNear(g, eg) && kuiNear(b, eb) && kuiNear(a, ea)
}

// The same, against a color as the kit quotes it: 0-255 channels and a unit
// alpha.
function kuiKit(r: Float, g: Float, b: Float, a: Float, er: Float, eg: Float, eb: Float, ea: Float) -> Bool {
    return kuiRgba(r, g, b, a, er / 255.0, eg / 255.0, eb / 255.0, ea)
}

function kuiTokens() -> ThemeTokens {
    return styleThemeTokens(DefaultStyle {})
}

function kuiStyle() -> Any StyleImplementation {
    return DefaultStyle {}
}

// --- Palette ---------------------------------------------------------------

construct KuiThePaletteKeepsItsAuthoredValues() extends Test {
    test {
        let palette = kuiStyle().palette
        return kuiKit(palette.red.light.r, palette.red.light.g, palette.red.light.b, palette.red.light.a, 255.0, 56.0, 60.0, 1.0)
            && kuiKit(palette.red.dark.r, palette.red.dark.g, palette.red.dark.b, palette.red.dark.a, 255.0, 66.0, 69.0, 1.0)
            && kuiKit(palette.blue.light.r, palette.blue.light.g, palette.blue.light.b, palette.blue.light.a, 0.0, 136.0, 255.0, 1.0)
            && kuiKit(palette.gray.dark.r, palette.gray.dark.g, palette.gray.dark.b, palette.gray.dark.a, 142.0, 142.0, 147.0, 1.0)
    }
    expect { let e: Result<Any, TestFailure> = Result.Ok(true)
        return e
    }
}

// --- Foregrounds -----------------------------------------------------------

construct KuiTheForegroundLadderKeepsItsAuthoredValues() extends Test {
    test {
        let foregrounds = kuiStyle().foregrounds
        return kuiKit(foregrounds.primary.light.r, foregrounds.primary.light.g, foregrounds.primary.light.b, foregrounds.primary.light.a, 0.0, 0.0, 0.0, 1.0)
            && kuiKit(foregrounds.primary.dark.r, foregrounds.primary.dark.g, foregrounds.primary.dark.b, foregrounds.primary.dark.a, 255.0, 255.0, 255.0, 1.0)
            && kuiKit(foregrounds.secondary.light.r, foregrounds.secondary.light.g, foregrounds.secondary.light.b, foregrounds.secondary.light.a, 60.0, 60.0, 67.0, 0.6)
            && kuiKit(foregrounds.tertiary.light.r, foregrounds.tertiary.light.g, foregrounds.tertiary.light.b, foregrounds.tertiary.light.a, 60.0, 60.0, 67.0, 0.3)
            && kuiKit(foregrounds.quaternary.dark.r, foregrounds.quaternary.dark.g, foregrounds.quaternary.dark.b, foregrounds.quaternary.dark.a, 235.0, 235.0, 245.0, 0.16)
    }
    expect { let e: Result<Any, TestFailure> = Result.Ok(true)
        return e
    }
}

// Ink that stays readable on a filled control. Apple names no such color, so
// the catalog carries it under a name of the toolkit's own.
construct KuiTheInverseForegroundSurvivedTheMove() extends Test {
    test {
        let foregrounds = kuiStyle().foregrounds
        return kuiRgba(foregrounds.inverse.light.r, foregrounds.inverse.light.g, foregrounds.inverse.light.b, foregrounds.inverse.light.a, 0.98, 0.98, 1.0, 1.0)
            && kuiRgba(foregrounds.inverse.dark.r, foregrounds.inverse.dark.g, foregrounds.inverse.dark.b, foregrounds.inverse.dark.a, 0.06, 0.07, 0.1, 1.0)
    }
    expect { let e: Result<Any, TestFailure> = Result.Ok(true)
        return e
    }
}

// --- Backgrounds and fills -------------------------------------------------

construct KuiTheElevationLadderKeepsItsAuthoredValues() extends Test {
    test {
        let backgrounds = kuiStyle().backgrounds
        return kuiKit(backgrounds.canvas.light.r, backgrounds.canvas.light.g, backgrounds.canvas.light.b, backgrounds.canvas.light.a, 255.0, 255.0, 255.0, 1.0)
            && kuiKit(backgrounds.canvas.dark.r, backgrounds.canvas.dark.g, backgrounds.canvas.dark.b, backgrounds.canvas.dark.a, 0.0, 0.0, 0.0, 1.0)
            && kuiKit(backgrounds.surface.light.r, backgrounds.surface.light.g, backgrounds.surface.light.b, backgrounds.surface.light.a, 242.0, 242.0, 247.0, 1.0)
            && kuiKit(backgrounds.raised.dark.r, backgrounds.raised.dark.g, backgrounds.raised.dark.b, backgrounds.raised.dark.a, 44.0, 44.0, 46.0, 1.0)
            && kuiKit(backgrounds.overlay.light.r, backgrounds.overlay.light.g, backgrounds.overlay.light.b, backgrounds.overlay.light.a, 255.0, 255.0, 255.0, 1.0)
    }
    expect { let e: Result<Any, TestFailure> = Result.Ok(true)
        return e
    }
}

construct KuiTheFillsKeepTheirAuthoredValues() extends Test {
    test {
        let fills = kuiStyle().fills
        return kuiKit(fills.control.light.r, fills.control.light.g, fills.control.light.b, fills.control.light.a, 120.0, 120.0, 120.0, 0.2)
            && kuiKit(fills.hover.dark.r, fills.hover.dark.g, fills.hover.dark.b, fills.hover.dark.a, 120.0, 120.0, 128.0, 0.32)
            && kuiKit(fills.selection.light.r, fills.selection.light.g, fills.selection.light.b, fills.selection.light.a, 80.0, 156.0, 254.0, 0.2)
    }
    expect { let e: Result<Any, TestFailure> = Result.Ok(true)
        return e
    }
}

// --- Tints -----------------------------------------------------------------

construct KuiTheTintsKeepTheirAuthoredValues() extends Test {
    test {
        let tints = kuiStyle().tints
        return kuiKit(tints.accent.light.r, tints.accent.light.g, tints.accent.light.b, tints.accent.light.a, 0.0, 136.0, 255.0, 1.0)
            && kuiKit(tints.accent.dark.r, tints.accent.dark.g, tints.accent.dark.b, tints.accent.dark.a, 0.0, 145.0, 255.0, 1.0)
            && kuiRgba(tints.success.light.r, tints.success.light.g, tints.success.light.b, tints.success.light.a, 0.12, 0.58, 0.3, 1.0)
            && kuiRgba(tints.warning.dark.r, tints.warning.dark.g, tints.warning.dark.b, tints.warning.dark.a, 0.98, 0.75, 0.25, 1.0)
            && kuiKit(tints.danger.dark.r, tints.danger.dark.g, tints.danger.dark.b, tints.danger.dark.a, 255.0, 66.0, 69.0, 1.0)
    }
    expect { let e: Result<Any, TestFailure> = Result.Ok(true)
        return e
    }
}

// --- Borders ---------------------------------------------------------------

// A border is a catalog color and a width the toolkit still owns, so this case
// checks both halves of that split.
construct KuiTheBorderLadderKeepsItsColorsAndWidths() extends Test {
    test {
        let borders = kuiStyle().borders
        return kuiKit(borders.subtle.color.light.r, borders.subtle.color.light.g, borders.subtle.color.light.b, borders.subtle.color.light.a, 0.0, 0.0, 0.0, 0.12)
            && kuiRgba(borders.standard.color.dark.r, borders.standard.color.dark.g, borders.standard.color.dark.b, borders.standard.color.dark.a, 1.0, 1.0, 1.0, 0.18)
            && kuiRgba(borders.strong.color.light.r, borders.strong.color.light.g, borders.strong.color.light.b, borders.strong.color.light.a, 0.08, 0.1, 0.16, 0.32)
            && kuiRgba(borders.focus.color.dark.r, borders.focus.color.dark.g, borders.focus.color.dark.b, borders.focus.color.dark.a, 0.43, 0.67, 1.0, 0.9)
            && borders.none.width == 0.0
            && borders.subtle.width == 1.0
            && borders.standard.width == 1.0
            && borders.strong.width == 1.5
            && borders.focus.width == 2.0
    }
    expect { let e: Result<Any, TestFailure> = Result.Ok(true)
        return e
    }
}

// --- Typography ------------------------------------------------------------

function kuiFontIs(font: borrow FontImplementation, size: Float, lineHeight: Float, tracking: Float) -> Bool {
    return kuiNear(font.size, size) && kuiNear(font.lineHeight, lineHeight) && kuiNear(font.tracking, tracking)
}

construct KuiTheTextMetricsKeepTheirAuthoredValues() extends Test {
    test {
        let typography = kuiStyle().typography
        return kuiFontIs(typography.body, 17.0, 22.0, 0.0 - 0.43)
            && kuiFontIs(typography.caption, 12.0, 16.0, 0.0)
            && kuiFontIs(typography.control, 15.0, 20.0, 0.0)
            && kuiFontIs(typography.title, 28.0, 34.0, 0.38)
            && kuiFontIs(typography.footnote, 13.0, 18.0, 0.0 - 0.08)
            && kuiFontIs(typography.overline, 10.0, 13.0, 0.5)
            && kuiFontIs(typography.headline, 17.0, 22.0, 0.0 - 0.43)
            && kuiFontIs(typography.title1, 30.0, 36.0, 0.0 - 0.3)
            && kuiFontIs(typography.title2, 22.0, 28.0, 0.0 - 0.26)
            && kuiFontIs(typography.title3, 20.0, 25.0, 0.0 - 0.45)
    }
    expect { let e: Result<Any, TestFailure> = Result.Ok(true)
        return e
    }
}

// Weight survives the trip through the catalog's numeric axis.
construct KuiTheTextWeightsSurviveTheNumericAxis() extends Test {
    test {
        let typography = kuiStyle().typography
        return typography.body.weight == .Regular
            && typography.control.weight == .SemiBold
            && typography.label.weight == .SemiBold
            && typography.title.weight == .Regular
            && typography.section.weight == .Bold
    }
    expect { let e: Result<Any, TestFailure> = Result.Ok(true)
        return e
    }
}

// --- Through the theme -----------------------------------------------------

// The resolved tokens a widget actually reads. `styleThemeTokens` is the one
// place a style becomes tokens, so a value that survives the catalog but is
// dropped here would still be a regression on screen.
construct KuiResolvedTokensReachAWidgetUnchanged() extends Test {
    test {
        let tokens = kuiTokens()
        let expectedPrimary = themeAdaptiveColor(kuiStyle().foregrounds.primary, resolvedAppearance(kuiStyle().appearance))
        return kuiRgba(tokens.foreground.primary.r, tokens.foreground.primary.g, tokens.foreground.primary.b, tokens.foreground.primary.a, expectedPrimary.r, expectedPrimary.g, expectedPrimary.b, expectedPrimary.a)
            && tokens.border.focus.width == 2.0
            && kuiNear(tokens.bodySize, 17.0)
    }
    expect { let e: Result<Any, TestFailure> = Result.Ok(true)
        return e
    }
}
