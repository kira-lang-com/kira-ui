import Foundation
import KiraGraphics
import KiraLayout
import KCoreAnimation

// KiraUI navigation follows SwiftUI's value-driven model:
//
//   NavigationPath       heterogeneous navigation values
//   NavigationStack      one-column push navigation
//   NavigationLink        appends a typed value
//   navigationDestination maps a value type to a destination
//   NavigationSplitView   leading navigation plus detail, collapsing when narrow
//
// Navigation values are declarations backed by NavigationValue. Applications
// define typed values such as `NavigationValue ProjectsRoute { ... }`; the
// route value itself is stored in the path.

// --- Responsive policy ------------------------------------------------------

enum NavigationDevice {
    Automatic
    Phone
    Tablet
    PC
    TV
}

enum NavigationWidthClass {
    Compact
    Regular
    Expanded
}

enum NavigationPresentation {
    Stack
    Split
}

struct NavigationMetrics {
    let device: NavigationDevice
    let widthClass: NavigationWidthClass
    let presentation: NavigationPresentation
    let primaryWidth: Float
    let targetSize: Float
    let toolbarHeight: Float
    // The layout margin: how far a column holds its content off its edges, and
    // where the bar over it starts its title and items. Apple's rule is one
    // margin per width class -- 16 in a compact width, 20 in a regular one and
    // on the Mac -- with television held well inside the overscan edge.
    let contentMargin: Float
}

function navigationWidthClass(width: Float) -> NavigationWidthClass {
    if width < 600.0 {
        return .Compact
    }
    if width < 960.0 {
        return .Regular
    }
    return .Expanded
}

function navigationDeviceOverride() -> NavigationDevice {
    let requested = environmentValue("KIRA_UI_DEVICE")
    if requested == "phone" {
        return .Phone
    }
    if requested == "tablet" {
        return .Tablet
    }
    if requested == "pc" || requested == "desktop" {
        return .PC
    }
    if requested == "tv" || requested == "television" {
        return .TV
    }
    return .Automatic
}

function resolvedNavigationDevice(width: Float) -> NavigationDevice {
    let requestedDevice = navigationDeviceOverride()
    if requestedDevice != .Automatic {
        return requestedDevice
    }
    if width < 600.0 {
        return .Phone
    }
    if width < 960.0 {
        return .Tablet
    }
    return .PC
}

function navigationAdaptivePresentation(width: Float) -> NavigationPresentation {
    let device = resolvedNavigationDevice(width)
    let widthClass = navigationWidthClass(width)
    match device {
        Phone -> return .Stack
        Tablet -> {
            if widthClass == .Compact {
                return .Stack
            }
            return .Split
        }
        PC -> {
            if widthClass == .Compact {
                return .Stack
            }
            return .Split
        }
        TV -> return .Split
        Automatic -> return .Stack
    }
}

function navigationMetrics(width: Float) -> NavigationMetrics {
    let device = resolvedNavigationDevice(width)
    let widthClass = navigationWidthClass(width)
    var primaryWidth = 280.0
    var targetSize = 44.0
    var toolbarHeight = 48.0
    var contentMargin = 20.0
    if widthClass == .Expanded {
        primaryWidth = 320.0
    }
    if widthClass == .Compact {
        contentMargin = 16.0
    }
    if device == .Phone {
        targetSize = 44.0
        toolbarHeight = 52.0
        contentMargin = 16.0
    }
    if device == .Tablet {
        targetSize = 48.0
        toolbarHeight = 52.0
    }
    if device == .PC {
        targetSize = 40.0
        // The bar's real height, not a floor it always exceeds.
        //
        // `WindowToolbar` frames itself at `Min(toolbarHeight)` over content
        // that hugs, so a control of `targetSize` plus the section's own insets
        // decides the height whenever it comes to more -- and at 40 plus 6 above
        // and below it always did. The number was then 4pt short of the bar it
        // describes, which is fine for a minimum and wrong for anything that
        // reads it as the height: a compositor sizing a column's texture from it
        // made every surface 4pt too tall for the box it was drawn into.
        toolbarHeight = 52.0
    }
    if device == .TV {
        primaryWidth = 320.0
        targetSize = 64.0
        toolbarHeight = 64.0
        contentMargin = 80.0
    }
    return NavigationMetrics {
        device: device,
        widthClass: widthClass,
        presentation: navigationAdaptivePresentation(width),
        primaryWidth: primaryWidth,
        targetSize: targetSize,
        toolbarHeight: toolbarHeight,
        contentMargin: contentMargin
    }
}

// What a column's content is described under: the column's layout margin --
// the one it states with `.contentMargin(...)`, or the standard for this width.
// The bar over the column is told the same margin, so its title, its items and
// the content beneath start at one distance from the column's edge.
function navigationColumnModifiers(modifiers: borrow ModifierContext, metrics: borrow NavigationMetrics) -> ModifierContext {
    let margin = modifiers.hasContentMargin ? modifiers.contentMargin : metrics.contentMargin
    kiraUiToolbarSetMargin(margin)
    return modifierContextApply(modifiers, modifierDeltaContentMargin(margin))
}

// The sidebar column's: a list in it takes the sidebar style unless a view
// above chose one, which is what SwiftUI's automatic style does there.
function navigationSidebarModifiers(modifiers: borrow ModifierContext, metrics: borrow NavigationMetrics) -> ModifierContext {
    let column = navigationColumnModifiers(modifiers, metrics)
    if column.listStyle != .Automatic {
        return column
    }
    return modifierContextApply(column, modifierDeltaListStyle(.Sidebar))
}

// --- Typed navigation values and path --------------------------------------

// Every application route declaration is backed by this family. The family
// value is the type-erased element stored by NavigationPath, just as Apple's
// NavigationPath can hold heterogeneous Hashable values.
construct NavigationValue {
    @Required function navigationType() -> String
}

struct KiraUiNavigationPathState {
    var values: [Any NavigationValue] = []
}

// NavigationPath is an empty value-shaped handle over the app navigation state.
// The state slot is fixed because one active app navigation path is the
// default, while the values themselves remain typed NavigationValue family
// members. Keeping the handle empty also lets a view pass it through several
// NavigationStack and NavigationSplitView layers without ownership friction.
struct NavigationPath {
    function values() -> [Any NavigationValue] {
        return kiraUiNavigationValues()
    }

    function isEmpty() -> Bool {
        return self.values().count == 0
    }

    // Whether the path runs through this value first: what makes a sidebar's
    // row the selected one.
    function startsWith(value: borrow Any NavigationValue) -> Bool {
        let current = self.values()
        if current.count == 0 {
            return false
        }
        return current[0].navigationType() == value.navigationType()
    }

    function lastMatches(value: borrow Any NavigationValue) -> Bool {
        let current = self.values()
        if current.count == 0 {
            return false
        }
        return current[current.count - 1].navigationType() == value.navigationType()
    }

    function append(value: Any NavigationValue) {
        kiraUiNavigationPush(move value)
        return
    }

    function removeLast() {
        kiraUiNavigationPop()
        return
    }

    function removeAll() {
        kiraUiNavigationClear()
        return
    }
}

function kiraUiNavigationSlotKey() -> String {
    return "kiraui.navigation.path"
}

function kiraUiNavigationEnsure() {
    if kiraUiStateSlotHas(kiraUiNavigationSlotKey()) == false {
        kiraUiStateSlotPut(
            kiraUiNavigationSlotKey(),
            nativeUserData(nativeState(KiraUiNavigationPathState {}))
        )
    }
    return
}

function kiraUiNavigationValues() -> [Any NavigationValue] {
    kiraUiNavigationEnsure()
    let state = nativeRecover<KiraUiNavigationPathState>(
        kiraUiStateSlotGet(kiraUiNavigationSlotKey())
    )
    return state.values
}

function kiraUiNavigationSetValues(values: [Any NavigationValue]) {
    kiraUiNavigationEnsure()
    var state = nativeRecover<KiraUiNavigationPathState>(
        kiraUiStateSlotGet(kiraUiNavigationSlotKey())
    )
    state.values = move values
    return
}

function kiraUiNavigationPush(value: Any NavigationValue) {
    let current = kiraUiNavigationValues()
    var next: [Any NavigationValue] = []
    var index = 0
    while index < current.count {
        next.append(move current[index])
        index = index + 1
    }
    next.append(move value)
    kiraUiNavigationSetValues(move next)
    return
}

function kiraUiNavigationPop() {
    let current = kiraUiNavigationValues()
    if current.count == 0 {
        return
    }
    var next: [Any NavigationValue] = []
    var index = 0
    while index < current.count - 1 {
        next.append(move current[index])
        index = index + 1
    }
    kiraUiNavigationSetValues(move next)
    return
}

function kiraUiNavigationClear() {
    var empty: [Any NavigationValue] = []
    kiraUiNavigationSetValues(move empty)
    return
}

function navigationPath() -> NavigationPath {
    return NavigationPath {}
}

// --- Ambient container environment -----------------------------------------

struct KiraUiNavigationEnvironment {
    var split: Bool = false
    // What the view a stack is showing asked its column to be painted with, as
    // SwiftUI's `containerBackground(_:for: .navigation)` asks. A grouped list
    // asks for its grouped canvas, so the column under the bar is the list's
    // grey rather than a band of the window's own.
    var hasBackground: Bool = false
    var background: Color = Color {}
}

function kiraUiNavigationEnvironmentKey() -> String {
    return "kiraui.navigation.environment"
}

function kiraUiNavigationEnvironment() -> KiraUiNavigationEnvironment {
    if kiraUiStateSlotHas(kiraUiNavigationEnvironmentKey()) == false {
        kiraUiStateSlotPut(
            kiraUiNavigationEnvironmentKey(),
            nativeUserData(nativeState(KiraUiNavigationEnvironment {}))
        )
    }
    return nativeRecover<KiraUiNavigationEnvironment>(
        kiraUiStateSlotGet(kiraUiNavigationEnvironmentKey())
    )
}

function kiraUiNavigationEnter(split: Bool) -> KiraUiNavigationEnvironment {
    let previous = kiraUiNavigationEnvironment()
    var current = nativeRecover<KiraUiNavigationEnvironment>(
        kiraUiStateSlotGet(kiraUiNavigationEnvironmentKey())
    )
    current.split = split
    return previous
}

function kiraUiNavigationSetBackground(color: Color) {
    kiraUiNavigationEnvironment()
    var current = nativeRecover<KiraUiNavigationEnvironment>(
        kiraUiStateSlotGet(kiraUiNavigationEnvironmentKey())
    )
    current.hasBackground = true
    current.background = move color
    return
}

function kiraUiNavigationClearBackground() {
    kiraUiNavigationEnvironment()
    var current = nativeRecover<KiraUiNavigationEnvironment>(
        kiraUiStateSlotGet(kiraUiNavigationEnvironmentKey())
    )
    current.hasBackground = false
    return
}

// The column's canvas: what the view in it asked for, or the window's own.
function navigationColumnCanvas(modifiers: borrow ModifierContext) -> FoundationColor {
    let environment = kiraUiNavigationEnvironment()
    if environment.hasBackground {
        return foundationColor(environment.background)
    }
    return navigationCanvas(modifiers)
}

function kiraUiNavigationLeave(previous: borrow KiraUiNavigationEnvironment) {
    var current = nativeRecover<KiraUiNavigationEnvironment>(
        kiraUiStateSlotGet(kiraUiNavigationEnvironmentKey())
    )
    current.split = previous.split
    return
}

// --- Links and destinations -------------------------------------------------

function navigationPushAction(value: Any NavigationValue) -> () -> Void {
    // A mutable capture lets the typed family value survive in the action. The
    // value itself is the route; there is no numeric route discriminator.
    var targetValue = move value
    let action: () -> Void = { in
        let path = NavigationPath {}
        path.append(value: copy targetValue)
        return
    }
    return action
}

// What choosing a sidebar's row does: the path becomes that value alone, so
// the detail shows it and nothing pushed under the row chosen before.
function navigationSelectAction(value: Any NavigationValue) -> () -> Void {
    var targetValue = move value
    let action: () -> Void = { in
        let path = NavigationPath {}
        path.removeAll()
        path.append(value: copy targetValue)
        return
    }
    return action
}

function navigationPopAction() -> () -> Void {
    let action: () -> Void = { in
        let path = NavigationPath {}
        path.removeLast()
        return
    }
    return action
}

// --- The sidebar ------------------------------------------------------------

// Whether the person collapsed the split view's sidebar with its toggle. It
// outlives the frame like the path does, because it is the window's state and
// not any view's.
struct KiraUiSidebarState {
    var collapsed: Bool = false
}

function kiraUiSidebarSlotKey() -> String {
    return "kiraui.navigation.sidebar"
}

function kiraUiSidebarCollapsed() -> Bool {
    if kiraUiStateSlotHas(kiraUiSidebarSlotKey()) == false {
        kiraUiStateSlotPut(kiraUiSidebarSlotKey(), nativeUserData(nativeState(KiraUiSidebarState {})))
    }
    let state = nativeRecover<KiraUiSidebarState>(kiraUiStateSlotGet(kiraUiSidebarSlotKey()))
    return state.collapsed
}

function navigationSidebarToggleAction() -> () -> Void {
    let action: () -> Void = { in
        let collapsed = kiraUiSidebarCollapsed()
        var state = nativeRecover<KiraUiSidebarState>(kiraUiStateSlotGet(kiraUiSidebarSlotKey()))
        state.collapsed = !collapsed
        return
    }
    return action
}

// The back button a stack puts on the bar once it has pushed a view: a piece
// of glass of its own at the leading end of the document's section.
function navigationDeclareBack(context: borrow BuildContext, modifiers: borrow ModifierContext) {
    let button = Button(action: navigationPopAction()) {
        Icon(symbol: .ChevronBack)
    }
    kiraUiChromeAppend(.Back, KiraUiToolbarEntry {
        content: button.describe(context, modifierContextPresenting(modifiers, .Toolbar)),
        group: kiraUiToolbarOpenGroup()
    })
    return
}

// Value-based link, matching SwiftUI's NavigationLink(value:label:). The
// nearest stack or split view supplies the path through ambient environment.
construct NavigationLink(value: Any NavigationValue) extends Widget {
    let label: some Widget

    // SwiftUI's `NavigationLink("Settings", value: route)`: a link whose label
    // is the title it was given. It is a second way to construct the same
    // declaration, not a second declaration, so both forms lower identically.
    init(title: String, value: Any NavigationValue) {
        return NavigationLink(value: value, label: Text(content: title))
    }


    // In a sidebar the link is one of its rows, selected while the path starts
    // at its value. In a grouped list it is a row that drills in: its label,
    // then the chevron at the trailing end, pressed anywhere down the row's
    // height. Anywhere else it is its label, pressed to push the value.
    function describe(context: borrow BuildContext, modifiers: borrow ModifierContext) -> CALayerDescription {
        if modifiers.controlPresentation == .Sidebar {
            let selected = NavigationPath {}.startsWith(value: value)
            let row = SidebarRow(selected: selected, action: navigationSelectAction(move value)) {
                label
            }
            return row.describe(context, modifiers)
        }
        if modifiers.controlPresentation == .InsetGrouped {
            let face = modifierTheme(modifiers).typography(.body)
            let row = HStack(spacing: .None, alignment: .Center, spacingLength: listMetrics.accessorySpacing) {
                label

                Spacer()

                Icon(symbol: .ChevronForward)
                    .font(size: face.size, weight: .SemiBold)
                    .foregroundColor(.Tertiary)
            }
            .minHeight(listMetrics.rowHeight)
            return row.onClick(navigationPushAction(move value)).describe(context, modifiers)
        }
        let metrics = navigationMetrics(context.viewportWidth)
        let target = label.minHeight(metrics.targetSize)
        return target.onClick(navigationPushAction(move value)).describe(context, modifiers)
    }
}

construct NavigationBackButton() extends Widget {

    function describe(context: borrow BuildContext, modifiers: borrow ModifierContext) -> CALayerDescription {
        return Button(
            title: "Back",
            action: navigationPopAction()
        ).describe(context, modifiers)
    }
}

construct NavigationBar(title: String = "") extends Widget {

    function describe(context: borrow BuildContext, modifiers: borrow ModifierContext) -> CALayerDescription {
        let path = NavigationPath {}
        let metrics = navigationMetrics(context.viewportWidth)
        let items = HStack(spacing: .Small, alignment: .Center) {
            if path.isEmpty() == false {
                NavigationBackButton()
            }
            if title.count > 0 {
                Text(content: title)
                    .typography(.headline)
            }
            Spacer()
        }
        let bar = items
            .background(RoundedRectangle())
            .backgroundStyle(.Surface)
            .height(metrics.toolbarHeight)
        return bar.describe(context, modifiers)
    }
}

function navigationCanvas(modifiers: borrow ModifierContext) -> FoundationColor {
    return foundationColor(modifierTokens(modifiers).background.canvas)
}

function navigationSurface(modifiers: borrow ModifierContext) -> FoundationColor {
    return foundationColor(modifierTokens(modifiers).background.surface)
}

construct NavigationDestinationLayer(forType: Any NavigationValue) extends Widget {
    let content: some Widget
    let destination: some Widget


    // Shows the destination when the path's last value matches this type, the
    // content otherwise. The navigation bar chrome is applied by a later chrome
    // pass; describe carries the right screen.
    function describe(context: borrow BuildContext, modifiers: borrow ModifierContext) -> CALayerDescription {
        let path = NavigationPath {}
        if path.lastMatches(value: forType) == false {
            return content.describe(context, modifiers)
        }
        return destination.describe(context, modifiers)
    }
}

extend Widget {
    // The type witness is the Kira spelling of SwiftUI's `for: Route.self`.
    // It keeps the public navigation model typed without numeric route IDs.
    function navigationDestination(
        forType: Any NavigationValue,
        destination: some Widget,
    ) -> Any Widget {
        return NavigationDestinationLayer(forType: move forType, destination: destination) {
            self
        }
    }
}

// --- Containers -------------------------------------------------------------

// One-column push navigation. The root view is never put in the path and
// cannot be popped, matching NavigationStack.
construct NavigationStack(path: NavigationPath = NavigationPath {}) extends Widget {
    let root: some Widget


    function describe(context: borrow BuildContext, modifiers: borrow ModifierContext) -> CALayerDescription {
        let previous = kiraUiNavigationEnter(false)
        let columnModifiers = navigationColumnModifiers(modifiers, navigationMetrics(context.viewportWidth))
        if path.isEmpty() == false {
            navigationDeclareBack(context, modifiers)
        }
        kiraUiNavigationClearBackground()
        let view = root.describe(insideSafeArea(context), columnModifiers)
        let canvas = navigationColumnCanvas(modifiers)
        kiraUiNavigationLeave(previous)
        // The stack's canvas runs under the window's bar; what it shows starts
        // below it, under its title set large.
        kiraUiChromeSafeAreaHandled()
        var page: [CALayerDescription] = []
        let title = kiraUiToolbarColumnTitle()
        if title.count > 0 {
            kiraUiToolbarShowLargeTitle()
            page.append(navigationLargeTitle(move title, context, columnModifiers))
        }
        var content = move view
        content.layout.flex = 1
        page.append(move content)
        return CALayerDescription {
            clipsChildren: true,
            content: .Solid(CASolid {
                fill: caColorFromFoundation(canvas)
            }),
            sublayers: [safeAreaInset(CALayerDescription {
                layout: CALayoutIntent {
                    axis: .Column
                },
                sublayers: move page
            }, context.safeArea)]
        }
    }
}

// A stack's title set large under the bar, at the column's margin, in the
// emphasized large title face.
function navigationLargeTitle(title: String, context: borrow BuildContext, modifiers: borrow ModifierContext) -> CALayerDescription {
    let face = modifierTheme(modifiers).typography(.largeTitle)
    var text = Text(content: move title)
        .font(size: face.size, weight: .Bold)
        .describe(context, modifiers)
    text.layout.widthFill = false
    text.layout.heightFill = false
    return CALayerDescription {
        layout: CALayoutIntent {
            heightFill: false,
            paddingLeading: modifiers.contentMargin,
            paddingTrailing: modifiers.contentMargin,
            paddingTop: largeTitleMetrics.topInset,
            paddingBottom: largeTitleMetrics.bottomInset
        },
        sublayers: [text]
    }
}

// Which of a split view's columns are up, matching SwiftUI's
// NavigationSplitViewVisibility. `Automatic` is the platform's own answer, which
// on a window wide enough to split is every column the view was given.
//
// `DoubleColumn` means two columns beside the detail's neighbour: on the
// three-column form that is the content and the detail, and on the two-column
// form — where there is no content column to fall back to — it is the sidebar
// and the detail. SwiftUI reads the same way; the case is named for how many
// columns are up, not for which one is hidden.
enum NavigationSplitViewVisibility {
    Automatic
    All
    DoubleColumn
    DetailOnly
}

function navigationShowsSidebar(visibility: NavigationSplitViewVisibility, hasContent: Bool) -> Bool {
    match visibility {
        Automatic -> return true
        All -> return true
        DoubleColumn -> return hasContent == false
        DetailOnly -> return false
    }
}

function navigationShowsContent(visibility: NavigationSplitViewVisibility) -> Bool {
    match visibility {
        Automatic -> return true
        All -> return true
        DoubleColumn -> return true
        DetailOnly -> return false
    }
}

// A column of a split view: the width the split view gives it, the window's full
// height, and NO paint of its own.
//
// The column does not fill itself because filling it is what stops the content
// from doing so: a frosted list samples what is behind the column, and an opaque
// pane behind it is all it can find. The list, the form or the surface inside
// the column says what the column looks like, exactly as `.background(...)` and
// the list style do in SwiftUI.
construct NavigationSplitView(
    columnVisibility: NavigationSplitViewVisibility = .Automatic,
    path: NavigationPath = NavigationPath {},
) extends Widget {
    // The columns are child slots, so a window writes them as blocks in the
    // order it reads them:
    //
    //     NavigationSplitView { Sidebar() } detail: { Detail() }
    //
    // The bare block is the sidebar because the sidebar is the slot declared
    // first, and `content:` and `detail:` name theirs, which is what SwiftUI's
    // labels do. `content` keeps its default, so the two-column form is the
    // three-column one with the middle block left unwritten.
    let sidebar: some Widget
    let content: some Widget = EmptyView()
    let detail: some Widget


    // The columns as sublayers, each described under its own toolbar column so
    // the items and title each one declares land over it.
    //
    // Side by side, the sidebar is a pane of glass the window's full height:
    // it runs under the bar, so the window controls and the sidebar's items sit
    // on it, and only its content is held below the band. The detail does the
    // same over the window's canvas, a hairline between the two.
    function describe(context: borrow BuildContext, modifiers: borrow ModifierContext) -> CALayerDescription {
        let metrics = navigationMetrics(context.viewportWidth)
        let inner = insideSafeArea(context)
        let previous = kiraUiNavigationEnter(true)
        kiraUiInspectorCollect()
        kiraUiToolbarEnterColumn(kiraUiToolbarSidebarColumn())
        let sidebarDesc = sidebar.describe(inner, navigationSidebarModifiers(modifiers, metrics))
        kiraUiToolbarEnterColumn(kiraUiToolbarContentColumn())
        let contentDesc = content.describe(inner, navigationColumnModifiers(modifiers, metrics))
        // The detail is handed the window's safe area: a stack in it paints its
        // canvas under the bar and holds only its content below it, as the
        // sidebar's glass does. Anything else is held below the bar here.
        kiraUiToolbarEnterColumn(kiraUiToolbarDetailColumn())
        kiraUiChromeSafeAreaPending()
        var detailDesc = detail.describe(context, navigationColumnModifiers(modifiers, metrics))
        if !kiraUiChromeSafeAreaWasHandled() {
            detailDesc = safeAreaInset(move detailDesc, context.safeArea)
        }
        kiraUiInspectorStopCollecting()
        kiraUiNavigationLeave(previous)
        kiraUiChromeSafeAreaHandled()

        var columns: [CALayerDescription] = []
        if metrics.presentation == .Stack {
            let current = NavigationPath {}
            if current.isEmpty() {
                columns.append(safeAreaInset(move sidebarDesc, context.safeArea))
            } else {
                columns.append(move detailDesc)
            }
            return CALayerDescription {
                sublayers: move columns
            }
        }

        // The split view's own toggle is always on the bar; what it decides is
        // whether the sidebar is.
        kiraUiChromeShowSidebarToggle()
        let showsSidebar = navigationShowsSidebar(columnVisibility, false) && !kiraUiSidebarCollapsed()
        if showsSidebar {
            kiraUiChromeSetNavigationLayout(metrics.primaryWidth, true, kiraUiToolbarDetailColumn())
            columns.append(liquidGlassDescription(
                CALayoutIntent {
                    widthFill: false,
                    fixedWidth: metrics.primaryWidth
                },
                0.0,
                .Rect,
                glassSizing(.Regular, modifiers),
                modifiers,
                [safeAreaInset(move sidebarDesc, context.safeArea)]
            ))
            columns.append(splitDivider(modifiers))
        }
        // An unwritten content column measures nothing; the detail takes what
        // is left of the window.
        columns.append(safeAreaInset(move contentDesc, context.safeArea))
        var detailColumn = move detailDesc
        detailColumn.layout.flex = 1
        columns.append(detailColumn)
        return CALayerDescription {
            layout: CALayoutIntent {
                axis: .Row
            },
            sublayers: move columns
        }
    }
}

// The line between two columns: the platform's divider thickness, in the
// border's colour.
function splitDivider(modifiers: borrow ModifierContext) -> CALayerDescription {
    let border = modifierResolvedBorder(modifiers)
    return CALayerDescription {
        layout: CALayoutIntent {
            widthFill: false,
            fixedWidth: windowChromeMetrics.dividerThickness
        },
        content: .Solid(CASolid {
            fill: caColorFromFoundation(foundationColor(border.color))
        })
    }
}

// The navigation container reports the geometry the root chrome compositor needs
// to align horizontal chrome with the columns beneath it. It does not render any
// bar itself: Back, toolbar items and tabs are all composed once at the app root.
