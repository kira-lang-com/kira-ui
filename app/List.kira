import Foundation
import KiraGraphics
import KiraLayout
import KCoreAnimation

// SwiftUI's `List`: rows in one column, drawn the way the list's style says.
//
//     List {
//         Section("Workspace") {
//             NavigationLink(value = ProjectsRoute()) {
//                 Label("Projects", systemImage = .Folder)
//             }
//         }
//     }
//
// The list does not draw its rows; it says what they are in. Under the sidebar
// style a `Section` is its title over its rows, a `NavigationLink` is a row
// carrying the selection band and a `Label` sets its glyph in the accent. Under
// the inset grouped style the same `Section` is a header over a card of rows
// and the same link is a row that drills in.

// How a list is drawn, matching SwiftUI's list styles. `Automatic` is the
// platform's answer for where the list is: the sidebar style in a split view's
// sidebar column, inset grouped everywhere else, as on iPad.
public enum ListStyle {
    Automatic
    Plain
    InsetGrouped
    Sidebar
}

public construct List() extends Widget {
    let children: [some Widget]


    function describe(context: borrow BuildContext, modifiers: borrow ModifierContext) -> CALayerDescription {
        match modifiers.listStyle {
            Sidebar -> {
                let rows = ScrollView() {
                    VStack(spacing: .None) {
                        For(child in children) {
                            child
                        }
                    }
                }
                return rows.describe(context, modifierContextPresenting(modifiers, .Sidebar))
            }
            Plain -> {
                let rows = ScrollView() {
                    VStack(spacing: .None) {
                        For(child in children) {
                            child
                        }
                    }
                }
                return rows.describe(context, modifiers)
            }
            InsetGrouped -> {}
            Automatic -> {}
        }
        let grouped = ScrollView() {
            InsetGroupedList() {
                For(child in children) {
                    child
                }
            }
        }
        return grouped.describe(context, modifiers)
    }
}

// The inset grouped list: its sections down one readable column, centered in
// the room it has and held off its edges by the column's margin, on the
// grouped canvas. The canvas is also what it asks the column around it to be
// painted with, so the band under the bar is the same gray.
public construct InsetGroupedList() extends Widget {
    let children: [some Widget]


    function describe(context: borrow BuildContext, modifiers: borrow ModifierContext) -> CALayerDescription {
        let canvas = themeAdaptiveColor(groupedBackground, modifierAppearance(modifiers))
        kiraUiNavigationSetBackground(copy canvas)
        let sections = VStack(spacing: .None, spacingLength: listMetrics.sectionSpacing) {
            For(section in children) {
                section
            }
        }
        var column = sections.describe(context, modifierContextPresenting(modifiers, .InsetGrouped))
        column.layout.maxWidth = listMetrics.readableWidth
        return CALayerDescription {
            layout: CALayoutIntent {
                axis: .Column,
                paddingLeading: modifiers.contentMargin,
                paddingTop: listMetrics.topInset,
                paddingTrailing: modifiers.contentMargin,
                paddingBottom: listMetrics.topInset,
                alignment: Point { x: 0.5, y: 0.0 }
            },
            content: .Solid(CASolid {
                fill: caColorFromFoundation(modifierColor(foundationColor(move canvas), modifiers))
            }),
            sublayers: [column]
        }
    }
}

// One section of an inset grouped list: its header, then its rows together on
// one card, then its footer. A header or footer left at `EmptyView()` takes no
// room at all.
//
// The header is the emphasized `title2`, the footer the `footnote` in the
// secondary ink; both start where the rows' content does. Every row is at
// least the list's row height with its content centered in it, and every row
// after the first carries a hairline across its top, inset like its content.
public function insetGroupedSection(
    rows: [CALayerDescription],
    header: CALayerDescription,
    footer: CALayerDescription,
    modifiers: borrow ModifierContext,
) -> CALayerDescription {
    let radius = listMetrics.cornerRadius
    let card = CALayerDescription {
        layout: CALayoutIntent {
            axis: .Column,
            heightFill: false
        },
        cornerRadius: radius,
        clipsChildren: true,
        content: .Solid(CASolid {
            fill: caColorFromFoundation(modifierColor(foundationColor(themeAdaptiveColor(groupedCardBackground, modifierAppearance(modifiers))), modifiers)),
            cornerRadius: radius,
            shapeKind: 1
        }),
        sublayers: move rows
    }
    var group: [CALayerDescription] = []
    if !describesNothing(header) {
        group.append(CALayerDescription {
            layout: CALayoutIntent {
                heightFill: false,
                paddingLeading: listMetrics.rowInset,
                paddingTop: listMetrics.headerPadding,
                paddingTrailing: listMetrics.rowInset,
                paddingBottom: listMetrics.headerPadding
            },
            sublayers: [move header]
        })
    }
    group.append(move card)
    var parts: [CALayerDescription] = []
    parts.append(CALayerDescription {
        layout: CALayoutIntent {
            axis: .Column,
            spacing: listMetrics.sectionSpacing,
            heightFill: false
        },
        sublayers: move group
    })
    if !describesNothing(footer) {
        parts.append(CALayerDescription {
            layout: CALayoutIntent {
                heightFill: false,
                paddingLeading: listMetrics.rowInset,
                paddingTop: listMetrics.footerTopInset,
                paddingTrailing: listMetrics.rowInset,
                paddingBottom: listMetrics.footerBottomInset
            },
            sublayers: [move footer]
        })
    }
    return CALayerDescription {
        layout: CALayoutIntent {
            axis: .Column,
            heightFill: false
        },
        sublayers: move parts
    }
}

// One row of a grouped card: its content across the row and centered down at
// least the row height, held off the card's edges, under a hairline when a row
// comes before it.
//
// A row whose content can be pressed is pressed as a whole: the hit region is
// lifted off the content onto the row, and the row lights edge to edge while
// it is held, clipped by the card's corners. It does not light on hover.
public function insetGroupedRow(
    content: CALayerDescription,
    separated: Bool,
    context: borrow BuildContext,
    modifiers: borrow ModifierContext,
) -> CALayerDescription {
    var inner = content
    let key = inner.hitKey
    let pressable = inner.hittable
    inner.hittable = false
    var layers: [CALayerDescription] = []
    layers.append(CALayerDescription {
        layout: CALayoutIntent {
            heightFill: false,
            minHeight: listMetrics.rowHeight,
            alignment: Point { x: 0.0, y: 0.5 }
        },
        sublayers: [move inner]
    })
    // The hairline starts where the row says its separator does -- a label's
    // title, past its glyph -- and at the row's edge when nothing says.
    if separated {
        layers.append(CALayerDescription {
            layout: CALayoutIntent {
                heightFill: false,
                fixedHeight: listMetrics.separatorThickness,
                followsGuide: guideTag(ListRowSeparatorLeading())
            },
            content: .Solid(CASolid {
                fill: caColorFromFoundation(modifierColor(foundationColor(themeAdaptiveColor(listSeparator, modifierAppearance(modifiers))), modifiers))
            })
        })
    }
    return CALayerDescription {
        layout: CALayoutIntent {
            heightFill: false,
            paddingLeading: listMetrics.rowInset,
            paddingTrailing: listMetrics.rowInset
        },
        hittable: pressable,
        hitKey: pressable ? key : 0,
        content: .Solid(CASolid {
            fill: caColorFromFoundation(transparentFoundationColor())
        }),
        pressColor: insetGroupedRowWash(pressable, modifiers),
        sublayers: move layers
    }
}

// What lights a row: the list's highlight while it is held. A row on the
// platform does not answer the pointer resting on it; only a press lights it,
// and the tree lays the highlight on the row pressed.
public function insetGroupedRowWash(pressable: Bool, modifiers: borrow ModifierContext) -> CAColor {
    if !pressable {
        return CAColor { a: 0.0 }
    }
    return caColorFromFoundation(modifierColor(foundationColor(themeAdaptiveColor(listRowHighlight, modifierAppearance(modifiers))), modifiers))
}

public construct ListStyleLayer(style: ListStyle) extends Widget {
    let content: some Widget


    function describe(context: borrow BuildContext, modifiers: borrow ModifierContext) -> CALayerDescription {
        return content.describe(context, modifierContextApply(modifiers, modifierDeltaListStyle(style)))
    }
}

// A section's title in a sidebar: its own row, the title held off the column's
// edge and low in the row, close to the rows it heads, in the body face and
// the secondary ink. A header that is nothing takes no room, as a sidebar
// section without a header has none in SwiftUI.
public construct SidebarSectionHeader() extends Widget {
    let content: some Widget


    function describe(context: borrow BuildContext, modifiers: borrow ModifierContext) -> CALayerDescription {
        let title = content
            .typography(.body)
            .foregroundColor(.Secondary)
            .describe(context, modifiers)
        if describesNothing(title) {
            return title
        }
        return CALayerDescription {
            layout: CALayoutIntent {
                axis: .Row,
                heightFill: false,
                fixedHeight: sidebarMetrics.headerHeight,
                paddingLeading: sidebarMetrics.headerInset,
                paddingTop: sidebarMetrics.headerTopInset,
                paddingTrailing: sidebarMetrics.headerInset
            },
            sublayers: [move title]
        }
    }
}

// One row of a sidebar. Under `.SidebarCell` the section around it draws the
// cell, so the row is its title carrying its press and its selection band as
// the layer's background; anywhere else it is its own cell.
public construct SidebarRow(selected: Bool, action: () -> Void) extends Widget {
    let content: some Widget


    function describe(context: borrow BuildContext, modifiers: borrow ModifierContext) -> CALayerDescription {
        kiraUiSidebarSelectionRow(selected)
        let key = kiraUiTapSeqKey()
        kiraUiLayerActionRegister(key, action)
        let face = modifierTypography(modifiers, .body)
        let cell = modifiers.controlPresentation == .SidebarCell
        let title = content.font(size: face.size, weight: sidebarRowWeight(selected))
        var row = cell ? title.describe(context, modifierContextPresenting(modifiers, .Sidebar)) : title.describe(context, modifiers)
        row.hittable = !modifiers.disabled
        row.hitKey = key
        row.backgroundColor = caColorFromFoundation(modifierColor(foundationColor(sidebarRowBand(selected, modifiers)), modifiers))
        if cell {
            return row
        }
        return sidebarRowCell(move row)
    }
}

// The cell every row of a sidebar sits in: the column's width, at least the
// row height, its content further in than the band a selected row carries.
// The content's press and background are lifted onto the band, so the whole
// row is pressed and the band spans it with a continuous corner. Selection
// lands at once, as a sidebar cell's does: the band does not fade between rows.
public function sidebarRowCell(content: CALayerDescription) -> CALayerDescription {
    var inner = content
    let key = inner.hitKey
    let pressable = inner.hittable
    let band = inner.backgroundColor
    inner.hittable = false
    inner.hitKey = 0
    inner.backgroundColor = CAColor { a: 0.0 }
    let gutter = sidebarMetrics.rowInset - sidebarMetrics.selectionInset
    let radius = sidebarMetrics.selectionRadius
    return CALayerDescription {
        layout: CALayoutIntent {
            heightFill: false,
            minHeight: sidebarMetrics.rowHeight,
            paddingLeading: sidebarMetrics.selectionInset,
            paddingTrailing: sidebarMetrics.selectionInset
        },
        hittable: pressable,
        hitKey: pressable ? key : 0,
        sublayers: [CALayerDescription {
            layout: CALayoutIntent {
                axis: .Row,
                paddingLeading: gutter,
                paddingTrailing: gutter,
                alignment: Point { x: 0.0, y: 0.5 }
            },
            cornerRadius: radius,
            disablesActions: true,
            content: .Solid(CASolid {
                fill: band,
                cornerRadius: radius,
                shapeKind: 1
            }),
            sublayers: [move inner]
        }]
    }
}

public function sidebarRowWeight(selected: Bool) -> FontWeight {
    if selected {
        return .SemiBold
    }
    return .Regular
}

// The band behind a sidebar row: the sidebar's selection wash when the row is
// selected, nothing otherwise.
public function sidebarRowBand(selected: Bool, modifiers: borrow ModifierContext) -> Color {
    if selected {
        return themeAdaptiveColor(sidebarSelection, modifierAppearance(modifiers))
    }
    return Color { a: 0.0 }
}
