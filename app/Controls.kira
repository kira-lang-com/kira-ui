import KiraGraphics
import Foundation
import KiraLayout
import KCoreAnimation

// Value controls: Toggle and Slider.
//
// Both are drawn the way the platform draws them, at the catalog's sizes: a
// switch is green when on and a gray wash when off, a slider fills with the
// accent up to a white knob. `.tint(...)` retints the active side of either.
// State lives with the caller — the control renders `isOn` / `value` and
// reports interaction; the runner's per-frame rebuild shows the write on the
// next frame.

function kiraUiNoopFloat(value: Float) {
    return
}

function controlClamp01(value: Float) -> Float {
    if value < 0.0 {
        return 0.0
    }
    if value > 1.0 {
        return 1.0
    }
    return value
}

// The active-side color: the cascading `.tint(...)` when one is set, the theme's
// accent otherwise. Slider's filled segment and Progress's bar.
//
// It reads the TINT and not the foreground on purpose. A row that dims its label
// while its property is switched off states that with a foreground, and the
// switch that turns the property back on has to stay accented while it does —
// the two are different decisions and were the same value for as long as this
// read `foregroundColor`.
function controlActiveColor(modifiers: borrow ModifierContext) -> FoundationColor {
    if modifiers.hasTint {
        return modifierPrimaryColor(modifiers.tint, modifiers)
    }
    return foundationColor(modifierTokens(modifiers).tint.accent)
}

// A white capsule knob, as a switch and a slider both carry.
function controlKnobDescription(width: Float, height: Float, modifiers: borrow ModifierContext) -> CALayerDescription {
    let radius = min(width, height) / 2.0
    return CALayerDescription {
        layout: CALayoutIntent {
            widthFill: false,
            heightFill: false,
            fixedWidth: width,
            fixedHeight: height
        },
        cornerRadius: radius,
        content: .Solid(CASolid {
            fill: caColorFromFoundation(modifierColor(foundationColor(themeAdaptiveColor(controlKnob, modifierTheme(modifiers).appearance())), modifiers)),
            cornerRadius: radius
        })
    }
}

// How opaque a switch or slider stands: the catalog's disabled opacity while it
// is disabled, fully otherwise. The control fades as one picture, so its knob
// still hides the track under it.
function controlOpacity(modifiers: borrow ModifierContext) -> Float {
    if modifiers.disabled {
        return disabledControlOpacity
    }
    return 1.0
}

// A slider's knob as it rests: a white capsule under its two shadows. A
// layer casts one, so the soft shadow is cast by a holder of the knob's own
// shape and the tight one by the knob.
function sliderKnobDescription(width: Float, height: Float, modifiers: borrow ModifierContext) -> CALayerDescription {
    let metrics = sliderMetrics
    let ink = caColorFromFoundation(modifierColor(foundationColor(themeAdaptiveColor(knobShadow, modifierTheme(modifiers).appearance())), modifiers))
    var knob = controlKnobDescription(width, height, modifiers)
    knob.disablesActions = true
    knob.shadow = CAShadow {
        color: ink,
        radius: metrics.knobContactShadowRadius,
        offset: Point { x: 0.0, y: metrics.knobContactShadowOffset }
    }
    return CALayerDescription {
        layout: CALayoutIntent {
            widthFill: false,
            heightFill: false,
            fixedWidth: width,
            fixedHeight: height,
            alignment: Point { x: 0.5, y: 0.5 }
        },
        disablesActions: true,
        cornerRadius: height / 2.0,
        shadow: CAShadow {
            color: ink,
            radius: metrics.knobShadowRadius,
            offset: Point { x: 0.0, y: metrics.knobShadowOffset }
        },
        sublayers: [knob]
    }
}

// How a slider's knob is moving: lifted into glass while it is held, and
// stretched along the track by how fast it is dragged.
struct SliderKnob {
    var lift: MotionSpringState = MotionSpringState {}
    var lifted: Float = 0.0
    var held: Bool = false
    var lastX: Float = 0.0
    var stretch: Float = 0.0
}

function sliderKnobSlotKey(key: Int) -> String {
    return kiraUiSlotKey("kiraui.slider.", key)
}

// A switch: a capsule track with the knob held at its leading end when off and
// its trailing end when on. The caller owns the state and `.onClick(...)`
// flips it; the knob slides between its ends because it is the same layer in
// a new place.
construct Toggle(isOn: Bool) extends Widget {

    function describe(context: borrow BuildContext, modifiers: borrow ModifierContext) -> CALayerDescription {
        let metrics = switchMetrics
        let radius = metrics.height / 2.0
        let knob = controlKnobDescription(metrics.knobWidth, metrics.height - metrics.knobInset * 2.0, modifiers)
        return CALayerDescription {
            layout: CALayoutIntent {
                widthFill: false,
                heightFill: false,
                fixedWidth: metrics.width,
                fixedHeight: metrics.height,
                paddingLeading: metrics.knobInset,
                paddingTrailing: metrics.knobInset,
                alignment: Point { x: isOn ? 1.0 : 0.0, y: 0.5 }
            },
            opacity: controlOpacity(modifiers),
            allowsGroupOpacity: true,
            cornerRadius: radius,
            content: .Solid(CASolid {
                fill: caColorFromFoundation(modifierColor(toggleTrackColor(isOn, modifiers), modifiers)),
                cornerRadius: radius,
                shapeKind: 1
            }),
            sublayers: [knob]
        }
    }
}

// A switch's track: the tint when one is set and the switch is on, the
// platform's green otherwise, and the gray wash when off.
function toggleTrackColor(isOn: Bool, modifiers: borrow ModifierContext) -> FoundationColor {
    let appearance = modifierTheme(modifiers).appearance()
    if !isOn {
        return foundationColor(themeAdaptiveColor(switchOff, appearance))
    }
    if modifiers.hasTint {
        return modifierPrimaryColor(modifiers.tint, modifiers)
    }
    return foundationColor(themeAdaptiveColor(switchOn, appearance))
}

// A horizontal slider over 0...1: a thin track filled with the tint up to the
// value, under a knob that rides it. It runs `width` long, or across whatever
// it is offered when that is zero — in a row, the room the row has left.
//
// The slider is an interactive surface, so while it is held the runner hands it
// the pointer in its own coordinates: the knob follows the pointer at once and
// `onChange` receives the clamped value for the caller to store.
construct Slider(
    value: Float,
    width: Float = 0.0,
    onChange: (Float) -> Void = kiraUiNoopFloat,
) extends Widget {

    function describe(context: borrow BuildContext, modifiers: borrow ModifierContext) -> CALayerDescription {
        let k = kiraUiTapSeqKey()
        let metrics = sliderMetrics
        let inset = metrics.knobInset
        let held = context.heldKey == k
        var shown = controlClamp01(value)
        if held && context.heldSize.width > inset * 2.0 {
            shown = controlClamp01((context.heldPoint.x - inset) / (context.heldSize.width - inset * 2.0))
            if shown != value {
                let change = onChange
                change(shown)
            }
        }

        // The fill runs from the track's start to the knob's center, which
        // travels the track less an inset at either end: the inset is its
        // basis, and the value its share of the rest.
        let trackRadius = metrics.trackHeight / 2.0
        let filledShare = Int(shown * 1000.0 + 0.5)
        let track = CALayerDescription {
            layout: CALayoutIntent {
                axis: .Row,
                heightFill: false,
                fixedHeight: metrics.trackHeight
            },
            cornerRadius: trackRadius,
            content: .Solid(CASolid {
                fill: caColorFromFoundation(modifierColor(foundationColor(themeAdaptiveColor(sliderTrack, modifierTheme(modifiers).appearance())), modifiers)),
                cornerRadius: trackRadius
            }),
            sublayers: [
                CALayerDescription {
                    layout: CALayoutIntent {
                        minWidth: inset,
                        flex: filledShare
                    },
                    cornerRadius: trackRadius,
                    content: .Solid(CASolid {
                        fill: caColorFromFoundation(modifierColor(controlActiveColor(modifiers), modifiers)),
                        cornerRadius: trackRadius
                    })
                },
                CALayerDescription {
                    layout: CALayoutIntent {
                        minWidth: inset,
                        flex: 1000 - filledShare
                    }
                }
            ]
        }

        // The knob rides a point with no size, as the kit lays it out, and
        // stands centered on it.
        let lane = CALayerDescription {
            layout: CALayoutIntent {
                paddingLeading: inset,
                paddingTrailing: inset,
                alignment: Point { x: shown, y: 0.5 }
            },
            sublayers: [CALayerDescription {
                layout: CALayoutIntent {
                    widthFill: false,
                    heightFill: false,
                    fixedWidth: 0.0,
                    fixedHeight: 0.0,
                    alignment: Point { x: 0.5, y: 0.5 }
                },
                sublayers: sliderKnobLayers(context, k, held, modifiers)
            }]
        }
        return CALayerDescription {
            layout: CALayoutIntent {
                widthFill: width <= 0.0,
                heightFill: false,
                fixedWidth: width > 0.0 ? width : -1.0,
                fixedHeight: metrics.height,
                flex: width > 0.0 ? 0 : 1,
                alignment: Point { x: 0.0, y: 0.5 }
            },
            opacity: controlOpacity(modifiers),
            allowsGroupOpacity: true,
            hittable: !modifiers.disabled,
            interactive: !modifiers.disabled,
            hitKey: k,
            sublayers: [track, lane]
        }
    }
}

// The knob as it stands this frame. At rest it is the white capsule. Held, it
// swells into a larger piece of clear glass the track shows through, and
// dragged fast it stretches along the track and thins; let go, it springs
// back into the capsule.
function sliderKnobLayers(context: borrow BuildContext, key: Int, held: Bool, modifiers: borrow ModifierContext) -> [CALayerDescription] {
    let metrics = sliderMetrics
    if kiraUiStateSlotHas(sliderKnobSlotKey(key)) == false {
        kiraUiStateSlotPut(sliderKnobSlotKey(key), nativeUserData(nativeState(SliderKnob {})))
    }
    var knob = nativeRecover<SliderKnob>(kiraUiStateSlotGet(sliderKnobSlotKey(key)))
    let delta = kiraUiClockDelta()
    let x = context.heldPoint.x
    if held != knob.held {
        let curve = motionCurveFor(.Snappy, held ? 1.0 : 0.0, kiraUiReducedMotion())
        knob.lift = motionSpringStart(move curve, knob.lifted, 0.0)
        knob.held = held
        knob.lastX = x
    }
    let sample = motionSpringAdvance(knob.lift, delta)
    knob.lifted = sample.value
    var speed = 0.0
    if held && delta > 0.0 {
        speed = abs(x - knob.lastX) / delta
    }
    knob.lastX = x
    let reach = kiraUiReducedMotion() ? 0.0 : min(speed / 2000.0, 1.0) * 0.12
    knob.stretch = knob.stretch + (reach - knob.stretch) * min(delta * 12.0, 1.0)
    let settled = motionSpringSettled(knob.lift, sample, motionSpringEpsilon())
    if !settled || knob.stretch > 0.001 {
        kiraUiClockStillMoving()
    }

    let t = knob.lifted
    let width = (metrics.knobWidth + (metrics.heldKnobWidth - metrics.knobWidth) * t) * (1.0 + knob.stretch)
    let height = (metrics.knobHeight + (metrics.heldKnobHeight - metrics.knobHeight) * t) * (1.0 - knob.stretch * 0.6)
    var resting = sliderKnobDescription(width, height, modifiers)
    resting.opacity = clamp01(1.0 - t)
    var layers = [resting]
    if t > 0.001 {
        var glass = liquidGlassDescription(CALayoutIntent {
            widthFill: false,
            heightFill: false,
            fixedWidth: width,
            fixedHeight: height,
            alignment: Point { x: 0.5, y: 0.5 }
        }, height / 2.0, .Capsule, modifiers, [], .Clear)
        var lens = liquidGlassContent(.Capsule, modifiers, .Clear)
        lens.tint = caColorFromFoundation(modifierColor(foundationColor(themeAdaptiveColor(sliderKnobGlass, modifierTheme(modifiers).appearance())), modifiers))
        glass.content = .Glass(move lens)
        glass.opacity = clamp01(t)
        glass.disablesActions = true
        layers.append(glass)
    }
    return layers
}
