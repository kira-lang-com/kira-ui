import Foundation
import KiraUIFoundation

// KiraUI-facing pass-throughs for the ambient input / interaction / settings
// services that live in KiraUIFoundation. App code (camera controllers, custom
// gesture widgets, menus) reads pointer/hover/press state and the menu-placement
// setting through these `kiraUi*` names, so it never has to reach into
// KiraUIFoundation directly. Same thin-wrapper style as State.kira.

// Held pointer button: 0 none, 1 left, 2 right, 3 middle.
function kiraUiInputButton() -> Int {
    return KiraUIFoundation.foundationInputButton()
}

// True while the given fly key (bit from foundationKeyBit) is held.
function kiraUiKeyHeld(bit: Int) -> Bool {
    return KiraUIFoundation.foundationInputKeyHeld(bit)
}

function kiraUiShiftHeld() -> Bool {
    return KiraUIFoundation.foundationInputShift()
}

// Live logical viewport size (window minus nothing — the whole surface).
function kiraUiViewportWidth() -> Float {
    return KiraUIFoundation.foundationViewportWidth()
}

function kiraUiViewportHeight() -> Float {
    return KiraUIFoundation.foundationViewportHeight()
}

// Which pointer button is HELD: 0 none, 1 left, 2 right, 3 middle.
//
// Beside `kiraUiShiftHeld` and read the same way. A window compositing another
// process's surfaces needs it: the pointer belongs to the window and what is
// under it belongs to the component, so the window has to be able to say
// whether the button is down without owning anything the component drew.
function kiraUiPointerButton() -> Int {
    return KiraUIFoundation.foundationInputButton()
}

function kiraUiPointerIsDown() -> Bool {
    return kiraUiPointerButton() > 0
}

// Pointer position at the last press/release/key event (logical pixels).
function kiraUiPointerX() -> Float {
    return KiraUIFoundation.foundationPointerX()
}

function kiraUiPointerY() -> Float {
    return KiraUIFoundation.foundationPointerY()
}

// Bounds of the button the last left-click fired on (for anchoring popups).
function kiraUiPressBoundsX() -> Float {
    return KiraUIFoundation.foundationPressBoundsX()
}

function kiraUiPressBoundsY() -> Float {
    return KiraUIFoundation.foundationPressBoundsY()
}

function kiraUiPressBoundsW() -> Float {
    return KiraUIFoundation.foundationPressBoundsW()
}

function kiraUiPressBoundsH() -> Float {
    return KiraUIFoundation.foundationPressBoundsH()
}

// True when `key` is the region currently under the pointer — the primitive a
// widget uses to give itself a hover state.
function kiraUiHovered(key: Int) -> Bool {
    return KiraUIFoundation.foundationHovered(key)
}

function kiraUiHoveredKey() -> Int {
    return KiraUIFoundation.foundationHoveredKey()
}

// App-wide menu placement setting (0 below-left default, 1 below-right).
function kiraUiMenuPlacement() -> Int {
    return KiraUIFoundation.foundationMenuPlacement()
}

function kiraUiSetMenuPlacement(placement: Int) {
    KiraUIFoundation.foundationSetMenuPlacement(placement)
    return
}