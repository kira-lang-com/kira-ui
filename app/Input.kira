import Foundation
import KCoreAnimation

// KiraUI-facing pass-throughs for the ambient input / interaction / settings
// services that live in  App code (camera controllers, custom
// gesture widgets, menus) reads pointer/hover/press state and the menu-placement
// setting through these `kiraUi*` names, so it never has to reach into
// the underlying input store directly. Same thin-wrapper style as State.kira.

// Held pointer button: 0 none, 1 left, 2 right, 3 middle.
public function inputButton() -> Number {
    return foundationInputButton()
}

// True while the given fly key (bit from foundationKeyBit) is held.
public function keyHeld(bit: Number) -> Bool {
    return foundationInputKeyHeld(bit)
}

public function shiftHeld() -> Bool {
    return foundationInputShift()
}

// Whether the platform's command key is held with the press being handled:
// Command on Apple's systems, Control elsewhere, as a command-click adds a
// row to a selection.
public function commandHeld() -> Bool {
    return foundationInputCommand()
}

// How many presses in quick succession on one control the click being
// handled ends: 2 for a double-click.
public function clickCount() -> Number {
    return foundationInputClickCount()
}

// Live logical viewport size (window minus nothing — the whole surface).
public function viewportWidth() -> Number {
    return foundationViewportWidth()
}

public function viewportHeight() -> Number {
    return foundationViewportHeight()
}

// Which pointer button is HELD: 0 none, 1 left, 2 right, 3 middle.
//
// Beside `shiftHeld` and read the same way. A window compositing another
// process's surfaces needs it: the pointer belongs to the window and what is
// under it belongs to the component, so the window has to be able to say
// whether the button is down without owning anything the component drew.
public function pointerButton() -> Number {
    return foundationInputButton()
}

public function pointerIsDown() -> Bool {
    return pointerButton() > 0
}

// Pointer position at the last press/release/key event (logical pixels).
public function pointerX() -> Number {
    return foundationPointerX() / interfaceScale()
}

public function pointerY() -> Number {
    return foundationPointerY() / interfaceScale()
}

// Bounds of the button the last left-click fired on (for anchoring popups).
public function pressBoundsX() -> Number {
    return foundationPressBoundsX() / interfaceScale()
}

public function pressBoundsY() -> Number {
    return foundationPressBoundsY() / interfaceScale()
}

public function pressBoundsW() -> Number {
    return foundationPressBoundsW() / interfaceScale()
}

public function pressBoundsH() -> Number {
    return foundationPressBoundsH() / interfaceScale()
}

// True when `key` is the region currently under the pointer — the primitive a
// widget uses to give itself a hover state.
public function hovered(key: Number) -> Bool {
    return foundationHovered(key)
}

public function hoveredKey() -> Number {
    return foundationHoveredKey()
}

// App-wide menu placement setting (0 below-left default, 1 below-right).
public function menuPlacement() -> Number {
    return foundationMenuPlacement()
}

public function setMenuPlacement(placement: Number) {
    foundationSetMenuPlacement(placement)
}
