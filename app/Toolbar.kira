import Foundation
import KiraGraphics
import KiraLayout
import KiraUIFoundation

// The window's toolbar, and the items a view puts on it.
//
// A toolbar belongs to the WINDOW, not to a column. That is the whole point of
// the type: a split view's columns each have something to say across the top —
// the sidebar names what it is listing, the detail names where it is — and if
// each column builds its own bar, the three bars are three heights and nothing
// in the window lines up. SwiftUI settles it by making the bar a property of the
// scene: a view declares `.toolbar(...)` and the ITEMS travel up to the one bar,
// which is why a sidebar item and a detail item share a baseline without either
// view knowing the other exists.
//
//     HierarchyView()
//         .toolbar(ToolbarItem(placement = .Navigation) {
//             Icon(symbol = Symbol.FolderOpen)
//         })
//
// An item is not drawn where it is written. It is lowered where it stands — so
// it reads the modifiers and the theme of the view that declared it — and the
// resulting view is handed to the nearest `NavigationSplitView`, which is the
// thing that owns the bar.

// Where on the bar an item sits, named for the ROLE rather than for a side, the
// way SwiftUI names them: the same placement is leading on one platform and
// trailing on another, and a view that said "trailing" could not follow.
enum ToolbarItemPlacement {
    // Wherever the platform puts an unspecified item: the trailing end of the
    // section over the view that declared it.
    Automatic
    // The navigation section: over the sidebar, where a column says what it is
    // showing.
    Navigation
    // The centre section: the document's own title and breadcrumb.
    Principal
    // The action the window is most likely to be asked for, at the trailing end.
    PrimaryAction
}

// --- The sink ----------------------------------------------------------------
//
// Items are collected while the columns are lowered and read once the bar is
// built, which is the order a split view already works in: it lowers every
// column before it assembles anything. The collection lives in the ambient state
// store rather than being threaded through `lower`, because an item can be
// declared at any depth inside a column and every widget between it and the
// window would otherwise have to carry a parameter for it. This is what
// SwiftUI's preferences do, in the one direction this needs: child to ancestor.

struct KiraUiToolbarSink {
    var navigation: [KiraUIFoundation.FoundationView] = []
    var principal: [KiraUIFoundation.FoundationView] = []
    var primaryAction: [KiraUIFoundation.FoundationView] = []
    var automatic: [KiraUIFoundation.FoundationView] = []
    // What each column called itself with `.navigationTitle(...)`. A title is a
    // string rather than a view because that is what makes it a TITLE: the bar
    // decides how a title is set, which is how the sidebar's and the document's
    // are set the same way without either column saying so.
    var sidebarTitle: String = ""
    var detailTitle: String = ""
    // What each column holds its content off its edges by, so the SECTION over a
    // column starts where that column's own content starts. A negative value is
    // "the column did not say", and the size class answers instead.
    var sidebarMargin: Float = 0.0 - 1.0
    var detailMargin: Float = 0.0 - 1.0
    // Which column is being lowered, so a title declared inside one lands in the
    // section over it: 0 the sidebar, 1 the content, 2 the detail.
    var column: Int = 0
    // Whether a bar is being collected at all. An item declared with no split
    // view above it has nowhere to go, and is dropped rather than kept for
    // whatever window is built next.
    var collecting: Bool = false
}

// The columns, in the order a split view lowers them.
function kiraUiToolbarSidebarColumn() -> Int {
    return 0
}

function kiraUiToolbarContentColumn() -> Int {
    return 1
}

function kiraUiToolbarDetailColumn() -> Int {
    return 2
}

function kiraUiToolbarSinkKey() -> String {
    return "kiraui.toolbar.sink"
}

function kiraUiToolbarSinkEnsure() {
    if kiraUiStateSlotHas(kiraUiToolbarSinkKey()) == false {
        kiraUiStateSlotPut(
            kiraUiToolbarSinkKey(),
            nativeUserData(nativeState(KiraUiToolbarSink {}))
        )
    }
    return
}

// Opens collection for the window about to lower its columns, discarding
// whatever the last frame left: the tree is rebuilt every frame, and items are
// rebuilt with it.
function kiraUiToolbarCollect() {
    kiraUiToolbarSinkEnsure()
    var sink = nativeRecover<KiraUiToolbarSink>(kiraUiStateSlotGet(kiraUiToolbarSinkKey()))
    var navigation: [KiraUIFoundation.FoundationView] = []
    var principal: [KiraUIFoundation.FoundationView] = []
    var primaryAction: [KiraUIFoundation.FoundationView] = []
    var automatic: [KiraUIFoundation.FoundationView] = []
    sink.navigation = move navigation
    sink.principal = move principal
    sink.primaryAction = move primaryAction
    sink.automatic = move automatic
    sink.sidebarTitle = ""
    sink.detailTitle = ""
    sink.sidebarMargin = 0.0 - 1.0
    sink.detailMargin = 0.0 - 1.0
    sink.column = kiraUiToolbarSidebarColumn()
    sink.collecting = true
    return
}

// The column about to be lowered. Everything a view declares from here until the
// next one belongs to it.
function kiraUiToolbarEnterColumn(column: Int) {
    kiraUiToolbarSinkEnsure()
    var sink = nativeRecover<KiraUiToolbarSink>(kiraUiStateSlotGet(kiraUiToolbarSinkKey()))
    sink.column = column
    return
}

// What a column calls itself. The LAST title wins, matching SwiftUI: a title set
// deeper in a column is the one that column is currently showing.
function kiraUiToolbarSetTitle(title: String) {
    kiraUiToolbarSinkEnsure()
    var sink = nativeRecover<KiraUiToolbarSink>(kiraUiStateSlotGet(kiraUiToolbarSinkKey()))
    if sink.collecting == false {
        return
    }
    if sink.column == kiraUiToolbarSidebarColumn() {
        sink.sidebarTitle = move title
        return
    }
    sink.detailTitle = move title
    return
}

// What the column being lowered holds its content off its edges by.
function kiraUiToolbarSetMargin(margin: Float) {
    kiraUiToolbarSinkEnsure()
    var sink = nativeRecover<KiraUiToolbarSink>(kiraUiStateSlotGet(kiraUiToolbarSinkKey()))
    if sink.collecting == false {
        return
    }
    if sink.column == kiraUiToolbarSidebarColumn() {
        sink.sidebarMargin = margin
        return
    }
    sink.detailMargin = margin
    return
}

function kiraUiToolbarStopCollecting() {
    kiraUiToolbarSinkEnsure()
    var sink = nativeRecover<KiraUiToolbarSink>(kiraUiStateSlotGet(kiraUiToolbarSinkKey()))
    sink.collecting = false
    return
}

function kiraUiToolbarAppend(placement: ToolbarItemPlacement, view: KiraUIFoundation.FoundationView) {
    kiraUiToolbarSinkEnsure()
    var sink = nativeRecover<KiraUiToolbarSink>(kiraUiStateSlotGet(kiraUiToolbarSinkKey()))
    if sink.collecting == false {
        return
    }
    match placement {
        Automatic -> sink.automatic.append(move view);
        Navigation -> sink.navigation.append(move view);
        Principal -> sink.principal.append(move view);
        PrimaryAction -> sink.primaryAction.append(move view);
    }
    return
}

// --- Items -------------------------------------------------------------------

// One item on the window's bar, matching SwiftUI's `ToolbarItem(placement:)`.
//
// It lowers to nothing where it is written: the view it produces goes to the
// bar, and what stands in its place is empty. That is what lets a column declare
// its bar items beside the content they belong to without the items appearing
// inside the column.
Widget ToolbarItem(placement: ToolbarItemPlacement = ToolbarItemPlacement.Automatic) {
    let content: some Widget

    function lower(context: borrow KiraUIFoundation.FoundationUiContext, modifiers: borrow ModifierContext) -> KiraUIFoundation.FoundationView {
        kiraUiToolbarAppend(placement, content.lower(context, modifiers))
        return EmptyView().lower(context, modifiers)
    }
}

// Several items, each with its own placement, matching SwiftUI's
// `ToolbarContent`: what a view hands to `.toolbar(...)` when it has more than
// one thing to put on the bar.
Widget ToolbarContent() {
    let children: [some Widget]

    function lower(context: borrow KiraUIFoundation.FoundationUiContext, modifiers: borrow ModifierContext) -> KiraUIFoundation.FoundationView {
        for index in 0..children.count {
            let ignored = children[index].lower(context, modifiers)
        }
        return EmptyView().lower(context, modifiers)
    }
}

// Several items at one placement, matching SwiftUI's `ToolbarItemGroup`: the
// same as writing one `ToolbarItem` each, without repeating the placement.
Widget ToolbarItemGroup(placement: ToolbarItemPlacement = ToolbarItemPlacement.Automatic) {
    let children: [some Widget]

    function lower(context: borrow KiraUIFoundation.FoundationUiContext, modifiers: borrow ModifierContext) -> KiraUIFoundation.FoundationView {
        for index in 0..children.count {
            kiraUiToolbarAppend(placement, children[index].lower(context, modifiers))
        }
        return EmptyView().lower(context, modifiers)
    }
}

// --- The bar -----------------------------------------------------------------

// The window's one bar, assembled from what the columns declared.
//
// Its sections are laid out against the COLUMNS beneath it: the navigation
// section is exactly as wide as the sidebar, so an item over the sidebar is over
// the sidebar and not merely near it, and the rest of the bar belongs to the
// document. A window with nothing to put on the bar gets no bar at all — an
// empty band across the top is a band that has to be explained.
Widget WindowToolbar(navigationWidth: Float, hasNavigationColumn: Bool) {
    function lower(context: borrow KiraUIFoundation.FoundationUiContext, modifiers: borrow ModifierContext) -> KiraUIFoundation.FoundationView {
        let metrics = resolvedControlMetrics(modifiers)
        let sink = nativeRecover<KiraUiToolbarSink>(kiraUiStateSlotGet(kiraUiToolbarSinkKey()))
        var sections: [KiraUIFoundation.FoundationView] = []
        if hasNavigationColumn {
            sections.append(toolbarSection(
                toolbarItemsRow(sink.sidebarTitle, sink.navigation, context, modifiers),
                KiraUIFoundation.SizeMode.Fixed(navigationWidth),
                toolbarMargin(sink.sidebarMargin, metrics)
            ))
        }
        // With no sidebar to sit over — a window collapsed to a stack — the
        // navigation items lead the bar rather than disappearing with the
        // column: they are what the view says it is showing, and it is still
        // showing it.
        sections.append(toolbarSection(
            toolbarDocumentRow(sink, hasNavigationColumn, context, modifiers),
            KiraUIFoundation.SizeMode.Fill,
            toolbarMargin(sink.detailMargin, metrics)
        ))
        // The size class's height is a floor, not a cap: a control taller than
        // the bar — a search field, a segmented picker — grows the bar rather
        // than hanging out of both its edges.
        let bar = Panel(radius: CornerRadius.None) {
            FoundationRaw(view: KiraUIFoundation.Row(
                children: move sections,
                width: KiraUIFoundation.SizeMode.Fill,
                height: KiraUIFoundation.SizeMode.Hug,
                spacing: 0.0,
                padding: KiraUIFoundation.EdgeInsets {},
                crossAxisAlignment: KiraUIFoundation.CrossAlignment.Stretch
            ))
        }
        .backgroundStyle(.Surface)
        return KiraUIFoundation.Frame(
            bar.lower(context, modifiers),
            KiraUIFoundation.SizeMode.Fill,
            KiraUIFoundation.SizeMode.Min(metrics.toolbarHeight),
            0,
            KiraUIFoundation.Alignment.Center,
            KiraUIFoundation.EdgeInsets {}
        )
    }
}

// What a section insets its items by: the margin the column under it stated, and
// the size class's own when that column said nothing.
function toolbarMargin(declared: Float, metrics: borrow ControlMetricsImplementation) -> Float {
    if declared < 0.0 {
        return metrics.contentMargin
    }
    return declared
}

// One section of the bar: its items centred across the toolbar's height, inset
// by the margin the column beneath it holds ITS content off its edges by — so
// the bar starts where the column starts, whatever that column decided.
function toolbarSection(
    items: KiraUIFoundation.FoundationView,
    width: KiraUIFoundation.SizeMode,
    margin: Float,
) -> KiraUIFoundation.FoundationView {
    return KiraUIFoundation.Frame(
        move items,
        move width,
        KiraUIFoundation.SizeMode.Fill,
        0,
        KiraUIFoundation.Alignment.Center,
        KiraUIFoundation.EdgeInsets {
            leading: margin
            trailing: margin
        }
    )
}

// What a column is showing, and what it can be asked to do about it: the title
// at the leading edge, the controls at the TRAILING one.
//
// Pushed apart rather than run together, because the two ends mean different
// things. A title names the column and belongs where reading starts; a control
// acts on it and belongs against the boundary with the content it is acting for
// -- which is where the platform puts a sidebar toggle, and where the hand
// already is when it reaches across from the document.
//
// CENTRED, not baseline-aligned. A bar holds two kinds of thing -- runs of text,
// which have a baseline, and controls, which are boxes of the size class's own
// height and have none. Aligning those to a text baseline puts the box's bottom
// on the title's baseline, which drops every glyph on the bar by the title's
// descender and is exactly as wrong as it sounds. Centring is what the platform
// does, and it is the only rule the two kinds share.
function toolbarItemsRow(
    title: borrow String,
    items: borrow [KiraUIFoundation.FoundationView],
    context: borrow KiraUIFoundation.FoundationUiContext,
    modifiers: borrow ModifierContext,
) -> KiraUIFoundation.FoundationView {
    let row = HStack(spacing: Spacing.Medium, alignment: VerticalAlignment.Center) {
        if title.count > 0 {
            ToolbarTitle(text: copy title)
        }

        Spacer()

        For(item in items) {
            FoundationRaw(view: item)
        }
    }
    return row.lower(context, modifiers)
}

// A column's name, as the bar sets it. One place decides, so the sidebar's title
// and the document's are the same weight at the same size — which is the whole
// reason a title is a string handed up rather than a view sent up.
Widget ToolbarTitle(text: String) {
    function lower(context: borrow KiraUIFoundation.FoundationUiContext, modifiers: borrow ModifierContext) -> KiraUIFoundation.FoundationView {
        let title = Text(content: text)
            .typography(.headline)
        return title.lower(context, modifiers)
    }
}

// The document's section: what the window is showing at the leading end, and
// what it can be asked to do at the trailing one.
function toolbarDocumentRow(
    sink: borrow KiraUiToolbarSink,
    hasNavigationColumn: Bool,
    context: borrow KiraUIFoundation.FoundationUiContext,
    modifiers: borrow ModifierContext,
) -> KiraUIFoundation.FoundationView {
    // The sidebar's own items lead this row only when there is no sidebar column
    // for them to sit over. Written as one branch INSIDE the row, the empty case
    // still stands a child in it — and a stack puts a gap before the next one,
    // which is how the document's first glyph ended up a gap further in than the
    // sidebar's title.
    if hasNavigationColumn == false {
        return toolbarCollapsedRow(sink, context, modifiers)
    }
    let row = HStack(spacing: Spacing.Medium, alignment: VerticalAlignment.Center) {
        if sink.detailTitle.count > 0 {
            ToolbarTitle(text: copy sink.detailTitle)
        }

        For(item in sink.principal) {
            FoundationRaw(view: item)
        }

        Spacer()

        For(item in sink.automatic) {
            FoundationRaw(view: item)
        }

        For(item in sink.primaryAction) {
            FoundationRaw(view: item)
        }
    }
    return row.lower(context, modifiers)
}

// The same row on a window with no sidebar column: the sidebar's title and items
// lead it, ahead of the document's own.
function toolbarCollapsedRow(
    sink: borrow KiraUiToolbarSink,
    context: borrow KiraUIFoundation.FoundationUiContext,
    modifiers: borrow ModifierContext,
) -> KiraUIFoundation.FoundationView {
    let row = HStack(spacing: Spacing.Medium, alignment: VerticalAlignment.Center) {
        if sink.sidebarTitle.count > 0 {
            ToolbarTitle(text: copy sink.sidebarTitle)
        }

        For(item in sink.navigation) {
            FoundationRaw(view: item)
        }

        if sink.detailTitle.count > 0 {
            ToolbarTitle(text: copy sink.detailTitle)
        }

        For(item in sink.principal) {
            FoundationRaw(view: item)
        }

        Spacer()

        For(item in sink.automatic) {
            FoundationRaw(view: item)
        }

        For(item in sink.primaryAction) {
            FoundationRaw(view: item)
        }
    }
    return row.lower(context, modifiers)
}

// Whether anything was declared for the bar this frame.
function kiraUiToolbarHasItems() -> Bool {
    kiraUiToolbarSinkEnsure()
    let sink = nativeRecover<KiraUiToolbarSink>(kiraUiStateSlotGet(kiraUiToolbarSinkKey()))
    if sink.sidebarTitle.count + sink.detailTitle.count > 0 {
        return true
    }
    return sink.navigation.count
        + sink.principal.count
        + sink.primaryAction.count
        + sink.automatic.count > 0
}

extend Widget {
    // The items this view puts on the window's toolbar, matching SwiftUI's
    // `.toolbar { … }`. They are declared beside the content they belong to and
    // drawn on the one bar the window has.
    function toolbar(items: Any Widget) -> Any Widget {
        return ToolbarLayer(items: items) {
            self
        }
    }

    // What this column is showing, matching SwiftUI's `.navigationTitle(...)`.
    // The bar sets it, in the section over the column that declared it — a
    // column names itself and says nothing about how a name is drawn.
    function navigationTitle(title: String) -> Any Widget {
        return NavigationTitleLayer(title: title) {
            self
        }
    }
}

Widget ContentMarginLayer(value: Float) {
    let content: some Widget

    function lower(context: borrow KiraUIFoundation.FoundationUiContext, modifiers: borrow ModifierContext) -> KiraUIFoundation.FoundationView {
        // The column tells the bar as well as its own contents: the section over
        // a column is part of that column's leading edge, not the window's.
        kiraUiToolbarSetMargin(value)
        let resolved = modifierContextApply(modifiers, modifierDeltaContentMargin(value))
        return content.lower(context, resolved)
    }
}

Widget NavigationTitleLayer(title: String) {
    let content: some Widget

    function lower(context: borrow KiraUIFoundation.FoundationUiContext, modifiers: borrow ModifierContext) -> KiraUIFoundation.FoundationView {
        kiraUiToolbarSetTitle(copy title)
        return content.lower(context, modifiers)
    }
}

Widget ToolbarLayer(items: Any Widget) {
    let content: some Widget

    function lower(context: borrow KiraUIFoundation.FoundationUiContext, modifiers: borrow ModifierContext) -> KiraUIFoundation.FoundationView {
        let childModifiers = modifierContextForChildren(modifiers)
        // The items are lowered where they were WRITTEN — they read the theme
        // and the size class of the view that declared them — but they are SET
        // by the bar: the bar's type is what a title on it is, and it is what a
        // glyph beside that title is sized by. An item that wants otherwise says
        // so, exactly as it would anywhere else.
        let ignored = items.typography(.headline).lower(context, childModifiers)
        return content.lower(context, childModifiers)
    }
}
