import Foundation
import KiraGraphics
import KiraLayout
import KCoreAnimation

// The window's toolbar, and the items a view puts on it.
//
// A toolbar belongs to the WINDOW, not to a column. That is the whole point of
// the type: a split view's columns each have something to say across the top —
// the sidebar names what it is listing, the detail names where it is — and if
// each column builds its own bar, the three bars are three heights and nothing
// in the window lines up. SwiftUI settles it by making the bar a property of the
// scene: a view declares `.toolbar(...)` and the ITEMS travel up to the one bar,
// which is why a sidebar item and a detail item share a baseline without either
// view knowing the other exists.
//
//     HierarchyView()
//         .toolbar(ToolbarItem(placement = .Navigation) {
//             Icon(symbol = .FolderOpen)
//         })
//
// An item is not drawn where it is written. It is lowered where it stands — so
// it reads the modifiers and the theme of the view that declared it — and the
// resulting view is handed to the nearest `NavigationSplitView`, which is the
// thing that owns the bar.

// Where on the bar an item sits, named for the ROLE rather than for a side, the
// way SwiftUI names them: the same placement is leading on one platform and
// trailing on another, and a view that said "trailing" could not follow.
public enum ToolbarItemPlacement {
    // Wherever the platform puts an unspecified item: the trailing end of the
    // section over the view that declared it.
    Automatic
    // The navigation section: over the sidebar, where a column says what it is
    // showing.
    Navigation
    // The center section: the document's own title and breadcrumb.
    Principal
    // The action the window is most likely to be asked for, at the trailing end.
    PrimaryAction
}

// --- The sink ----------------------------------------------------------------
//
// Items are collected while the columns are lowered and read once the bar is
// built, which is the order a split view already works in: it lowers every
// column before it assembles anything. The collection lives in the ambient state
// store rather than being threaded through `lower`, because an item can be
// declared at any depth inside a column and every widget between it and the
// window would otherwise have to carry a parameter for it. This is what
// SwiftUI's preferences do, in the one direction this needs: child to ancestor.

// How wide a `ToolbarSpacer` is, matching SwiftUI's `SpacerSizing`.
public enum SpacerSizing {
    // A stated gap.
    Fixed
    // Takes what is left, pushing the groups either side of it apart.
    Flexible
}

// Whether an item joins the glass background its neighbors share, matching
// SwiftUI's `Visibility` as `.sharedBackgroundVisibility(...)` takes it.
public enum SharedBackgroundVisibility {
    // The platform's answer: share it.
    Automatic
    Visible
    // Stand alone. The item draws whatever it draws and nothing else joins it.
    Hidden
}

// The semantic reason an item belongs to application chrome. A role deliberately
// says nothing about an edge: the chrome compositor is the only code allowed to
// turn these into top/bottom bars or a vertical edge rail.
public enum ChromeRole {
    Back
    Navigation
    Principal
    Automatic
    PrimaryAction
    Tab
    TabSearch
}

// Whether custom chrome is allowed to follow a vertical presentation. System
// controls default to Automatic; a custom item may opt into vertical layout or
// insist on remaining horizontal when its shape cannot sensibly rotate/reflow.
public enum ChromeAxisBehavior {
    Automatic
    HorizontalOnly
    VerticalPreferred
}

// Where the compositor resolved application chrome for this frame.
public enum ChromeOrientation {
    Horizontal
    Vertical
}

public enum ChromeEdge {
    Top
    Bottom
    Leading
    Trailing
}

// One thing a view put on the bar: an item, or the space that ends a group.
//
// A bar is not a flat list of items — it is a run of GROUPS, and which items
// share a group is the whole of the Liquid Glass look. Keeping the grouping on
// the entry is what lets the bar be assembled after every column has spoken
// without any column having to know what its neighbors declared.
public struct KiraUiToolbarEntry {
    // What the item draws, described where it was declared — under the
    // modifiers and the theme of the view that put it on the bar.
    let content: CALayerDescription = CALayerDescription {}
    // Whether this item is drawn on glass at all.
    let shared: Bool = true
    // Which declaration the item came from. Items of one `ToolbarItemGroup`
    // share one piece of glass; a `ToolbarItem` is a piece of glass of its own,
    // as the platform draws two items written one after the other.
    let group: Int = 0
    // A spacer: closes the group before it and opens the next one. A fixed one
    // holds the platform's spacer width open; a flexible one takes what is left.
    let isSpacer: Bool = false
    let flexible: Bool = false
    let axisBehavior: ChromeAxisBehavior = .Automatic
    // Higher-priority chrome survives compression before lower-priority chrome.
    let visibilityPriority: Int = 0
}

// What one view in a stack put on the document's section of the bar: its back
// button, its items, its title and its tabs.
public struct KiraUiToolbarPage {
    var back: [KiraUiToolbarEntry] = []
    var tabs: [KiraUiToolbarEntry] = []
    var principal: [KiraUiToolbarEntry] = []
    var primaryAction: [KiraUiToolbarEntry] = []
    var automatic: [KiraUiToolbarEntry] = []
    var title: String = ""
    var largeTitle: Bool = false
    var titleCollapse: Float = 0.0
}

// How many entries each bucket held at some moment: what a stack takes as the
// line between what the views around it declared and what its own views did.
public struct KiraUiToolbarMark {
    var back: Int = 0
    var tabs: Int = 0
    var principal: Int = 0
    var primaryAction: Int = 0
    var automatic: Int = 0
}

public struct KiraUiToolbarSink {
    // Window chrome is collected semantically. The existing toolbar buckets stay
    // separate because horizontal desktop chrome lays them out by section; Back
    // and tabs are additional chrome families consumed by the same compositor.
    var back: [KiraUiToolbarEntry] = []
    var navigation: [KiraUiToolbarEntry] = []
    var principal: [KiraUiToolbarEntry] = []
    var primaryAction: [KiraUiToolbarEntry] = []
    var automatic: [KiraUiToolbarEntry] = []
    var tabs: [KiraUiToolbarEntry] = []
    var tabSearch: [KiraUiToolbarEntry] = []
    // What each column called itself with `.navigationTitle(...)`. A title is a
    // string rather than a view because that is what makes it a TITLE: the bar
    // decides how a title is set, which is how the sidebar's and the document's
    // are set the same way without either column saying so.
    var sidebarTitle: String = ""
    var detailTitle: String = ""
    // Whether the document's title is set large under the bar, by the stack
    // showing it, rather than in the bar's own band; and how far that title
    // has scrolled under the bar, which the band shows it inline as far as.
    var largeTitle: Bool = false
    var titleCollapse: Float = 0.0
    // What each column holds its content off its edges by, so the SECTION over a
    // column starts where that column's own content starts. A negative value is
    // "the column did not say", and the size class answers instead.
    var sidebarMargin: Float = 0.0 - 1.0
    var detailMargin: Float = 0.0 - 1.0
    // Geometry the navigation container reports after lowering. The root chrome
    // compositor consumes this once, after every contributor has been collected.
    var navigationWidth: Float = 0.0
    var hasNavigationColumn: Bool = false
    // How far out the sidebar is, from 0 tucked away to 1 beside the content,
    // as its toggle's spring has it this frame.
    var navigationShown: Float = 0.0
    var visibleColumn: Int = 2
    // Which column is being lowered, so a title declared inside one lands in the
    // section over it: 0 the sidebar, 1 the content, 2 the detail.
    var column: Int = 0
    // Whether a bar is being collected at all. An item declared with no split
    // view above it has nowhere to go, and is dropped rather than kept for
    // whatever window is built next.
    var collecting: Bool = false
    // Zero means this frame has no window toolbar. Set by WindowToolbar itself,
    // so a plain KiraUI tree and a raw KG app gain no phantom drag strip.
    var windowDragHeight: Float = 0.0
    // Set by `.sharedBackgroundVisibility(.hidden)` while an item's content is
    // being lowered, and taken by the `ToolbarItem` around it.
    //
    // SwiftUI writes that modifier INSIDE the item, on the control itself, and a
    // modifier context only travels downward — so the item cannot read it off
    // its own modifiers. Lowering is depth-first: the flag is set while the
    // content lowers and taken immediately after, which is the one moment it can
    // belong to exactly that item.
    var pendingSharedHidden: Bool = false
    // The group the next declaration opens.
    var nextGroup: Int = 1
    // Whether a split view put its sidebar toggle on the bar this frame.
    var sidebarToggle: Bool = false
    // Whether a container in the tree laid its content out inside the window's
    // safe area. A navigation container does, because its columns' backgrounds
    // run under the bar while their content does not; when nothing did, the
    // window insets its whole content instead.
    var safeAreaHandled: Bool = false
    // While a stack moves between two views, what the view coming into sight
    // put on the bar, and how far into sight it is: 0 shows only the items
    // above, 1 only these. The bar stays where it is and its items turn from
    // one view's into the other's.
    var moving: Bool = false
    var covered: KiraUiToolbarPage = KiraUiToolbarPage {}
    var coveredShown: Float = 0.0
    // The transaction the bar changes in while a stack moves under it: the
    // stack's own, so its titles and buttons travel on the pages' spring.
    var motion: CALayerAnimation = .Inherit
    // Where the view on top's own entries end: anything after was declared by
    // the views around the stack, and is on the bar for both views.
    var pageEnd: KiraUiToolbarMark = KiraUiToolbarMark {}
    // The search field a view asked for with `.searchable`, if one did: what
    // it prompts with while empty, and the key its clear button answers to.
    var searching: Bool = false
    var searchPrompt: String = ""
    var searchClearKey: Int = 0
}

// A button press happens in the input callback, while the native window is
// owned by the next RenderFrame. Keep one pending request in the same ambient
// store as the toolbar and consume it at the start of that frame.
public struct KiraUiWindowCommandState {
    // 0 none, 1 close, 2 minimize, 3 toggle maximize.
    var command: Int = 0
}

public function kiraUiWindowCommandKey() -> String {
    return "kiraui.window.command"
}

public function kiraUiWindowCommandEnsure() {
    if kiraUiStateSlotHas(kiraUiWindowCommandKey()) == false {
        kiraUiStateSlotPut(
            kiraUiWindowCommandKey(),
            nativeUserData(nativeState(KiraUiWindowCommandState {}))
        )
    }
    return
}

public function kiraUiRequestWindowClose() {
    kiraUiWindowCommandEnsure()
    var state = nativeRecover<KiraUiWindowCommandState>(kiraUiStateSlotGet(kiraUiWindowCommandKey()))
    state.command = 1
    return
}

public function kiraUiRequestWindowMinimize() {
    kiraUiWindowCommandEnsure()
    var state = nativeRecover<KiraUiWindowCommandState>(kiraUiStateSlotGet(kiraUiWindowCommandKey()))
    state.command = 2
    return
}

public function kiraUiRequestWindowToggleMaximize() {
    kiraUiWindowCommandEnsure()
    var state = nativeRecover<KiraUiWindowCommandState>(kiraUiStateSlotGet(kiraUiWindowCommandKey()))
    state.command = 3
    return
}

public function kiraUiConsumeWindowCommand(frame: borrow mut KiraGraphics.RenderFrame) {
    kiraUiWindowCommandEnsure()
    var state = nativeRecover<KiraUiWindowCommandState>(kiraUiStateSlotGet(kiraUiWindowCommandKey()))
    let command = state.command
    state.command = 0
    if command == 1 {
        frame.requestQuit()
        return
    }
    if command == 2 {
        frame.minimizeWindow()
        return
    }
    if command == 3 {
        frame.toggleMaximizeWindow()
    }
    return
}

// The columns, in the order a split view lowers them.
public function kiraUiToolbarSidebarColumn() -> Int {
    return 0
}

public function kiraUiToolbarContentColumn() -> Int {
    return 1
}

public function kiraUiToolbarDetailColumn() -> Int {
    return 2
}

public function kiraUiToolbarSinkKey() -> String {
    return "kiraui.toolbar.sink"
}

public function kiraUiToolbarSinkEnsure() {
    if kiraUiStateSlotHas(kiraUiToolbarSinkKey()) == false {
        kiraUiStateSlotPut(
            kiraUiToolbarSinkKey(),
            nativeUserData(nativeState(KiraUiToolbarSink {}))
        )
    }
    return
}

// Opens collection for the window about to lower its columns, discarding
// whatever the last frame left: the tree is rebuilt every frame, and items are
// rebuilt with it.
public function kiraUiToolbarCollect() {
    kiraUiToolbarSinkEnsure()
    var sink = nativeRecover<KiraUiToolbarSink>(kiraUiStateSlotGet(kiraUiToolbarSinkKey()))
    var back: [KiraUiToolbarEntry] = []
    var navigation: [KiraUiToolbarEntry] = []
    var principal: [KiraUiToolbarEntry] = []
    var primaryAction: [KiraUiToolbarEntry] = []
    var automatic: [KiraUiToolbarEntry] = []
    var tabs: [KiraUiToolbarEntry] = []
    var tabSearch: [KiraUiToolbarEntry] = []
    sink.back = move back
    sink.navigation = move navigation
    sink.principal = move principal
    sink.primaryAction = move primaryAction
    sink.automatic = move automatic
    sink.tabs = move tabs
    sink.tabSearch = move tabSearch
    sink.sidebarTitle = ""
    sink.detailTitle = ""
    sink.largeTitle = false
    sink.titleCollapse = 0.0
    sink.sidebarMargin = 0.0 - 1.0
    sink.detailMargin = 0.0 - 1.0
    sink.navigationWidth = 0.0
    sink.hasNavigationColumn = false
    sink.navigationShown = 0.0
    sink.visibleColumn = kiraUiToolbarDetailColumn()
    // A plain NavigationStack or root view is the document/detail surface. A
    // split view explicitly enters each of its columns while lowering them.
    sink.column = kiraUiToolbarDetailColumn()
    sink.collecting = true
    sink.windowDragHeight = 0.0
    sink.safeAreaHandled = false
    sink.nextGroup = 1
    sink.sidebarToggle = false
    sink.moving = false
    sink.covered = KiraUiToolbarPage {}
    sink.coveredShown = 0.0
    sink.motion = .Inherit
    sink.searching = false
    sink.searchPrompt = ""
    sink.searchClearKey = 0
    return
}

// What each bucket holds so far.
public function kiraUiToolbarMark() -> KiraUiToolbarMark {
    kiraUiToolbarSinkEnsure()
    let sink = nativeRecover<KiraUiToolbarSink>(kiraUiStateSlotGet(kiraUiToolbarSinkKey()))
    return KiraUiToolbarMark {
        back: sink.back.count,
        tabs: sink.tabs.count,
        principal: sink.principal.count,
        primaryAction: sink.primaryAction.count,
        automatic: sink.automatic.count
    }
}

// The entries after `from`, taken out of `entries`.
public function kiraUiToolbarSplit(entries: borrow mut [KiraUiToolbarEntry], from: Int) -> [KiraUiToolbarEntry] {
    var kept: [KiraUiToolbarEntry] = []
    var taken: [KiraUiToolbarEntry] = []
    for i in 0..entries.count {
        if i < from {
            kept.append(copy entries[i])
        } else {
            taken.append(copy entries[i])
        }
    }
    entries = move kept
    return taken
}

// `entries` with `more` after them.
public function kiraUiToolbarJoin(entries: borrow mut [KiraUiToolbarEntry], more: [KiraUiToolbarEntry]) {
    for entry in more {
        entries.append(copy entry)
    }
    return
}

// The view under a moving one is about to lower: what the view on top put on
// the bar since `mark` is set aside, so what this one declares can be told
// from it. What the views around the stack declared stays, for both.
public function kiraUiToolbarBeginCovered(mark: borrow KiraUiToolbarMark) -> KiraUiToolbarPage {
    kiraUiToolbarSinkEnsure()
    var sink = nativeRecover<KiraUiToolbarSink>(kiraUiStateSlotGet(kiraUiToolbarSinkKey()))
    let top = KiraUiToolbarPage {
        back: kiraUiToolbarSplit(sink.back, mark.back),
        tabs: kiraUiToolbarSplit(sink.tabs, mark.tabs),
        principal: kiraUiToolbarSplit(sink.principal, mark.principal),
        primaryAction: kiraUiToolbarSplit(sink.primaryAction, mark.primaryAction),
        automatic: kiraUiToolbarSplit(sink.automatic, mark.automatic),
        title: sink.detailTitle,
        largeTitle: sink.largeTitle,
        titleCollapse: sink.titleCollapse
    }
    sink.detailTitle = ""
    sink.largeTitle = false
    sink.titleCollapse = 0.0
    return top
}

// The covered view has lowered: everything on the bar now is what it shows
// with, and becomes the covered set, shown as far as it is uncovered. The view
// on top gets its own entries back.
public function kiraUiToolbarEndCovered(top: KiraUiToolbarPage, mark: borrow KiraUiToolbarMark, shown: Float, motion: CALayerAnimation) {
    kiraUiToolbarSinkEnsure()
    var sink = nativeRecover<KiraUiToolbarSink>(kiraUiStateSlotGet(kiraUiToolbarSinkKey()))
    var page = move top
    sink.covered = KiraUiToolbarPage {
        back: copy sink.back,
        tabs: copy sink.tabs,
        principal: copy sink.principal,
        primaryAction: copy sink.primaryAction,
        automatic: copy sink.automatic,
        title: sink.detailTitle,
        largeTitle: sink.largeTitle,
        titleCollapse: sink.titleCollapse
    }
    kiraUiToolbarSplit(sink.back, mark.back)
    kiraUiToolbarSplit(sink.tabs, mark.tabs)
    kiraUiToolbarSplit(sink.principal, mark.principal)
    kiraUiToolbarSplit(sink.primaryAction, mark.primaryAction)
    kiraUiToolbarSplit(sink.automatic, mark.automatic)
    kiraUiToolbarJoin(sink.back, move page.back)
    kiraUiToolbarJoin(sink.tabs, move page.tabs)
    kiraUiToolbarJoin(sink.principal, move page.principal)
    kiraUiToolbarJoin(sink.primaryAction, move page.primaryAction)
    kiraUiToolbarJoin(sink.automatic, move page.automatic)
    sink.detailTitle = page.title
    sink.largeTitle = page.largeTitle
    sink.titleCollapse = page.titleCollapse
    sink.moving = true
    sink.coveredShown = shown
    sink.motion = move motion
    sink.pageEnd = KiraUiToolbarMark {
        back: sink.back.count,
        tabs: sink.tabs.count,
        principal: sink.principal.count,
        primaryAction: sink.primaryAction.count,
        automatic: sink.automatic.count
    }
    return
}

// The covered view's entries for one bucket as the bar draws them: its own,
// then whatever the views around the stack declared after the stack lowered.
public function kiraUiToolbarCoveredEntries(
    covered: borrow [KiraUiToolbarEntry],
    current: borrow [KiraUiToolbarEntry],
    pageEnd: Int,
) -> [KiraUiToolbarEntry] {
    var entries = copy covered
    for i in 0..current.count {
        if i >= pageEnd {
            entries.append(copy current[i])
        }
    }
    return entries
}

// A fresh group for the declaration about to put its items on the bar.
public function kiraUiToolbarOpenGroup() -> Int {
    kiraUiToolbarSinkEnsure()
    var sink = nativeRecover<KiraUiToolbarSink>(kiraUiStateSlotGet(kiraUiToolbarSinkKey()))
    let group = sink.nextGroup
    sink.nextGroup = group + 1
    return group
}

// The column about to be lowered. Everything a view declares from here until the
// next one belongs to it.
public function kiraUiToolbarEnterColumn(column: Int) {
    kiraUiToolbarSinkEnsure()
    var sink = nativeRecover<KiraUiToolbarSink>(kiraUiStateSlotGet(kiraUiToolbarSinkKey()))
    sink.column = column
    return
}

// What a column calls itself. The LAST title wins, matching SwiftUI: a title set
// deeper in a column is the one that column is currently showing.
public function kiraUiToolbarSetTitle(title: String) {
    kiraUiToolbarSinkEnsure()
    var sink = nativeRecover<KiraUiToolbarSink>(kiraUiStateSlotGet(kiraUiToolbarSinkKey()))
    if sink.collecting == false {
        return
    }
    if sink.column == kiraUiToolbarSidebarColumn() {
        sink.sidebarTitle = move title
        return
    }
    sink.detailTitle = move title
    return
}

// A view asked for the window's search field. The last to ask wins, as the
// last title does.
public function kiraUiToolbarSetSearch(prompt: String, clearKey: Int) {
    kiraUiToolbarSinkEnsure()
    var sink = nativeRecover<KiraUiToolbarSink>(kiraUiStateSlotGet(kiraUiToolbarSinkKey()))
    if sink.collecting == false {
        return
    }
    sink.searching = true
    sink.searchPrompt = move prompt
    sink.searchClearKey = clearKey
    return
}

// What the column being lowered calls itself, so far.
public function kiraUiToolbarColumnTitle() -> String {
    kiraUiToolbarSinkEnsure()
    let sink = nativeRecover<KiraUiToolbarSink>(kiraUiStateSlotGet(kiraUiToolbarSinkKey()))
    if sink.column == kiraUiToolbarSidebarColumn() {
        return sink.sidebarTitle
    }
    return sink.detailTitle
}

// What a page told the bar about its title: what it is called, whether it is
// set large under the bar, and how far that has scrolled under.
public struct KiraUiToolbarTitle {
    var title: String = ""
    var largeTitle: Bool = false
    var titleCollapse: Float = 0.0
}

// The title the column just lowered declared, as a page, taken off the bar so
// the next column starts with none. A stacked split view's sidebar is its
// root page, and the bar shows its title only while it is the page in front.
public function kiraUiToolbarTakeColumnTitle() -> KiraUiToolbarTitle {
    kiraUiToolbarSinkEnsure()
    var sink = nativeRecover<KiraUiToolbarSink>(kiraUiStateSlotGet(kiraUiToolbarSinkKey()))
    let taken = KiraUiToolbarTitle {
        title: kiraUiToolbarColumnTitle(),
        largeTitle: sink.largeTitle,
        titleCollapse: sink.titleCollapse
    }
    sink.largeTitle = false
    sink.titleCollapse = 0.0
    return taken
}

// The bar shows `page`'s title as the document's.
public function kiraUiToolbarShowPageTitle(page: borrow KiraUiToolbarTitle) {
    kiraUiToolbarSinkEnsure()
    var sink = nativeRecover<KiraUiToolbarSink>(kiraUiStateSlotGet(kiraUiToolbarSinkKey()))
    sink.detailTitle = page.title
    sink.largeTitle = page.largeTitle
    sink.titleCollapse = page.titleCollapse
    return
}

// The document's title is being set large under the bar, so the band leaves
// it out.
public function kiraUiToolbarShowLargeTitle() {
    kiraUiToolbarSinkEnsure()
    var sink = nativeRecover<KiraUiToolbarSink>(kiraUiStateSlotGet(kiraUiToolbarSinkKey()))
    sink.largeTitle = true
    return
}

// The document's large title has scrolled this far under the bar, from none
// of it to all of it.
public function kiraUiToolbarCollapseLargeTitle(collapse: Float) {
    kiraUiToolbarSinkEnsure()
    var sink = nativeRecover<KiraUiToolbarSink>(kiraUiStateSlotGet(kiraUiToolbarSinkKey()))
    sink.titleCollapse = collapse
    return
}

// What the column being lowered holds its content off its edges by.
public function kiraUiToolbarSetMargin(margin: Float) {
    kiraUiToolbarSinkEnsure()
    var sink = nativeRecover<KiraUiToolbarSink>(kiraUiStateSlotGet(kiraUiToolbarSinkKey()))
    if sink.collecting == false {
        return
    }
    if sink.column == kiraUiToolbarSidebarColumn() {
        sink.sidebarMargin = margin
        return
    }
    sink.detailMargin = margin
    return
}

// A container laid its content out inside the window's safe area itself.
public function kiraUiChromeSafeAreaHandled() {
    kiraUiToolbarSinkEnsure()
    var sink = nativeRecover<KiraUiToolbarSink>(kiraUiStateSlotGet(kiraUiToolbarSinkKey()))
    sink.safeAreaHandled = true
    return
}

// A column is about to be lowered, and has laid out nothing inside the safe
// area yet.
public function kiraUiChromeSafeAreaPending() {
    kiraUiToolbarSinkEnsure()
    var sink = nativeRecover<KiraUiToolbarSink>(kiraUiStateSlotGet(kiraUiToolbarSinkKey()))
    sink.safeAreaHandled = false
    return
}

public function kiraUiChromeSafeAreaWasHandled() -> Bool {
    kiraUiToolbarSinkEnsure()
    let sink = nativeRecover<KiraUiToolbarSink>(kiraUiStateSlotGet(kiraUiToolbarSinkKey()))
    return sink.safeAreaHandled
}

public function kiraUiToolbarStopCollecting() {
    kiraUiToolbarSinkEnsure()
    var sink = nativeRecover<KiraUiToolbarSink>(kiraUiStateSlotGet(kiraUiToolbarSinkKey()))
    sink.collecting = false
    return
}

// Navigation reports the geometry its horizontal chrome used to own directly.
// The root compositor reads this after the whole tree has lowered.
public function kiraUiChromeSetNavigationLayout(
    navigationWidth: Float,
    hasNavigationColumn: Bool,
    navigationShown: Float,
    visibleColumn: Int,
) {
    kiraUiToolbarSinkEnsure()
    var sink = nativeRecover<KiraUiToolbarSink>(kiraUiStateSlotGet(kiraUiToolbarSinkKey()))
    sink.navigationWidth = navigationWidth
    sink.hasNavigationColumn = hasNavigationColumn
    sink.navigationShown = navigationShown
    sink.visibleColumn = visibleColumn
    return
}

// Where the sidebar ends across the window, as the last frame laid it out: 0
// with no sidebar beside the content, and partway while it slides.
public function kiraUiToolbarNavigationWidth() -> Float {
    kiraUiToolbarSinkEnsure()
    let sink = nativeRecover<KiraUiToolbarSink>(kiraUiStateSlotGet(kiraUiToolbarSinkKey()))
    if !sink.hasNavigationColumn {
        return 0.0
    }
    return sink.navigationWidth * sink.navigationShown
}

public function kiraUiChromeShowSidebarToggle() {
    kiraUiToolbarSinkEnsure()
    var sink = nativeRecover<KiraUiToolbarSink>(kiraUiStateSlotGet(kiraUiToolbarSinkKey()))
    sink.sidebarToggle = true
    return
}

public function kiraUiChromeAppend(role: ChromeRole, entry: KiraUiToolbarEntry) {
    kiraUiToolbarSinkEnsure()
    var sink = nativeRecover<KiraUiToolbarSink>(kiraUiStateSlotGet(kiraUiToolbarSinkKey()))
    if sink.collecting == false {
        return
    }
    let item = move entry
    match role {
        Back -> sink.back.append(move item)
        Navigation -> sink.navigation.append(move item)
        Principal -> sink.principal.append(move item)
        Automatic -> sink.automatic.append(move item)
        PrimaryAction -> sink.primaryAction.append(move item)
        Tab -> sink.tabs.append(move item)
        TabSearch -> sink.tabSearch.append(move item)
    }
    return
}

public function kiraUiToolbarHideNextSharedBackground() {
    kiraUiToolbarSinkEnsure()
    var sink = nativeRecover<KiraUiToolbarSink>(kiraUiStateSlotGet(kiraUiToolbarSinkKey()))
    sink.pendingSharedHidden = true
    return
}

public function kiraUiToolbarTakePendingShared() -> Bool {
    kiraUiToolbarSinkEnsure()
    var sink = nativeRecover<KiraUiToolbarSink>(kiraUiStateSlotGet(kiraUiToolbarSinkKey()))
    let hidden = sink.pendingSharedHidden
    sink.pendingSharedHidden = false
    return hidden == false
}

// The space that ends a group, matching SwiftUI's `ToolbarSpacer`. It is the
// only way a view separates its items into two pieces of glass rather than one.
public function kiraUiToolbarAppendSpacer(placement: ToolbarItemPlacement, sizing: SpacerSizing) {
    kiraUiToolbarAppendEntry(move placement, KiraUiToolbarEntry {
        isSpacer: true,
        flexible: sizing == .Flexible
    })
    return
}

public function kiraUiToolbarAppendEntry(placement: ToolbarItemPlacement, entry: KiraUiToolbarEntry) {
    kiraUiToolbarSinkEnsure()
    var sink = nativeRecover<KiraUiToolbarSink>(kiraUiStateSlotGet(kiraUiToolbarSinkKey()))
    if sink.collecting == false {
        return
    }
    let view = move entry
    match placement {
        // "The trailing end of the section over the view that DECLARED it" is
        // the whole meaning of `Automatic`, and `column` above is exactly which
        // view that is. Sending every automatic item to one bucket made the
        // default placement mean "the document section" wherever it was written,
        // so a sidebar asking for its own trailing action got it over the
        // detail column instead — the one placement a view can reach without
        // naming a position, landing somewhere the view cannot see.
        Automatic -> {
            if sink.column == kiraUiToolbarSidebarColumn() {
                sink.navigation.append(move view)
            } else {
                sink.automatic.append(move view)
            }
        }
        Navigation -> sink.navigation.append(move view)
        Principal -> sink.principal.append(move view)
        PrimaryAction -> sink.primaryAction.append(move view)
    }
    return
}

// --- Items -------------------------------------------------------------------

// One item on the window's bar, matching SwiftUI's `ToolbarItem(placement:)`.
//
// It lowers to nothing where it is written: the view it produces goes to the
// bar, and what stands in its place is empty. That is what lets a column declare
// its bar items beside the content they belong to without the items appearing
// inside the column.
public construct ToolbarItem(placement: ToolbarItemPlacement = .Automatic) extends Widget {
    let content: some Widget


    function describe(context: borrow BuildContext, modifiers: borrow ModifierContext) -> CALayerDescription {
        let group = kiraUiToolbarOpenGroup()
        kiraUiToolbarDeclare(placement, group, content.describe(context, modifiers))
        return CALayerDescription {}
    }
}

// One described item onto the bar. The shared-background flag is taken right
// after the item's content described, which is the one moment a
// `.sharedBackgroundVisibility(...)` written inside it can belong to it.
public function kiraUiToolbarDeclare(placement: ToolbarItemPlacement, group: Int, described: CALayerDescription) {
    kiraUiToolbarAppendEntry(move placement, KiraUiToolbarEntry {
        content: move described,
        shared: kiraUiToolbarTakePendingShared(),
        group: group
    })
    return
}

// Several items, each with its own placement, matching SwiftUI's
// `ToolbarContent`: what a view hands to `.toolbar(...)` when it has more than
// one thing to put on the bar.
public construct ToolbarContent() extends Widget {
    let children: [some Widget]


    function describe(context: borrow BuildContext, modifiers: borrow ModifierContext) -> CALayerDescription {
        return CALayerDescription {
            sublayers: describedChildren(context, modifiers, children)
        }
    }
}

// Several items at one placement on one piece of glass, matching SwiftUI's
// `ToolbarItemGroup`: the items read as one control with a seam between them.
public construct ToolbarItemGroup(placement: ToolbarItemPlacement = .Automatic) extends Widget {
    let children: [some Widget]


    function describe(context: borrow BuildContext, modifiers: borrow ModifierContext) -> CALayerDescription {
        let group = kiraUiToolbarOpenGroup()
        for child in children {
            kiraUiToolbarDeclare(placement, group, child.describe(context, modifiers))
        }
        return CALayerDescription {}
    }
}

// The space that splits one run of toolbar items into two, matching SwiftUI's
// `ToolbarSpacer`.
//
// A fixed spacer holds the platform's spacer width between the pieces of glass
// either side of it. `.Flexible` takes whatever room is left, which is what
// pushes a trailing group to the far end.
// SwiftUI takes the sizing UNLABELED and first — `ToolbarSpacer(.fixed,
// placement: .primaryAction)` — so it is first here too. Kira binds by position
// and treats a label as decoration, which means the order is the API.
public construct ToolbarSpacer(
    sizing: SpacerSizing = .Fixed,
    placement: ToolbarItemPlacement = .Automatic,
) extends Widget {

    function describe(context: borrow BuildContext, modifiers: borrow ModifierContext) -> CALayerDescription {
        kiraUiToolbarAppendSpacer(placement, sizing)
        return CALayerDescription {}
    }
}

// The transaction the bar changes in this build; see `motion`.
public function kiraUiToolbarMotion() -> CALayerAnimation {
    kiraUiToolbarSinkEnsure()
    let sink = nativeRecover<KiraUiToolbarSink>(kiraUiStateSlotGet(kiraUiToolbarSinkKey()))
    return copy sink.motion
}
