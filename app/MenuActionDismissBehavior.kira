import Foundation

// SwiftUI's MenuActionDismissBehavior. The automatic case is action-specific:
// an ordinary button defaults to dismissal, while adjustable menu controls
// such as a Stepper can opt into the host's non-dismissing behavior.
public enum MenuActionDismissBehavior {
    Automatic
    Enabled
    Disabled
}

public function menuActionDismisses(
    behavior: MenuActionDismissBehavior,
    automaticDefault: Bool = true
) -> Bool {
    return match behavior {
        Automatic -> automaticDefault
        Enabled -> true
        Disabled -> false
    }
}

extend Widget {
    // SwiftUI: `.menuActionDismissBehavior(_ behavior:)` applies to actions
    // received by the menu presentation, not to a visual layer or a lifetime
    // callback. Nested actions inherit the environment until overridden.
    function menuActionDismissBehavior(behavior: MenuActionDismissBehavior) -> Any Widget {
        return ModifierDeltaLayer(
            delta: modifierDeltaMenuActionDismissBehavior(behavior)
        ) { self }
    }
}