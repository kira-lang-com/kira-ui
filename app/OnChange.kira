import Foundation

// `.onChange(of: value) { oldValue, newValue in ... }`, as SwiftUI's: runs
// the action when a value the view is built with differs from the one it was
// built with last, handing it the value it was and the value it is.
//
// A view is built again whenever the interface is, so the modifier keeps the
// value it saw under the key its place in the build draws (`tapSeqKey`), the
// same each build while the interface keeps its shape. The first build only
// remembers the value.

// The value an `.onChange` saw when the view was last built.
struct ObservedValue<Value> {
    var value: Value
}

extend Widget {
    function onChange<Value>(of: Value, action: (Value, Value) -> Void) -> Any Widget {
        let slot = slotKey("kiraui.change.", tapSeqKey())
        if !ambientStateHas(copy slot) {
            ambientStatePut(move slot, nativeUserData(nativeState(ObservedValue<Value> { value: copy of })))
            return self
        }
        var observed = nativeRecover<ObservedValue<Value>>(ambientStateGet(move slot))
        if observed.value != of {
            let old = copy observed.value
            observed.value = copy of
            action(move old, move of)
        }
        return self
    }
}
