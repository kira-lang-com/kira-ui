import Foundation
import KCoreAnimation

// The bar's button that folds one of a workspace's edges away and brings it
// back, as Xcode's navigator, debug area and inspector buttons do:
//
//     .toolbar {
//         ToolbarItemGroup(placement = .Navigation) {
//             PanelEdgeToggle(edge = .Leading)
//             PanelEdgeToggle(edge = .Bottom)
//             PanelEdgeToggle(edge = .Trailing)
//         }
//     }
public construct PanelEdgeToggle(edge: PanelEdge) extends Widget {

    function describe(
        context: borrow BuildContext,
        modifiers: borrow ModifierContext
    ) -> CALayerDescription {
        let toggle = Button(action: panelEdgeToggleAction(edge)) {
            Icon(symbol: panelEdgeSymbol(edge))
        }
        return toggle.describe(context, modifiers)
    }
}

// The glyph for an edge: the side a sidebar is on, or the foot of a window.
public function panelEdgeSymbol(edge: borrow PanelEdge) -> Symbol {
    match edge {
        Leading -> return .SidebarLeft
        Trailing -> return .SidebarRight
        Bottom -> return .RectangleDock
        Center -> return .Rectangle
    }
}

public function panelEdgeToggleAction(edge: borrow PanelEdge) -> () -> Void {
    let folding = copy edge
    return { in
        workspaceToggle(folding)
        return
    }
}
