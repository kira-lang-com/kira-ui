import Foundation
import KiraGraphics
import KiraLayout
import KCoreAnimation

// Assembling the window's one bar from what the columns declared.
//
// `Toolbar.kira` is the DECLARING half — the placements, the sink, and the
// widgets a view writes. This file is the reading half: it takes the entries
// out of the sink once every column has been lowered and turns them into the
// sections, the shared glass groups, and the bar itself. The split is along
// that seam because the two halves run at different times and share only the
// sink between them.

// --- The bar -----------------------------------------------------------------

// The window's chrome: the band across the top that its title, its toolbar
// items and its window controls sit in, drawn over the content.
//
// The band is split along the columns beneath it, as SwiftUI splits it. Over a
// sidebar, the window controls hold the leading end and the sidebar's items --
// its toggle last -- sit at its trailing edge. Over the document, what the
// column is showing sits at the leading end, its principal item at the
// section's center, and what it can be asked to do at the trailing end. With
// the sidebar collapsed, its items and its toggle move up beside the window
// controls and the document's section takes the rest of the band -- the
// sidebar's section narrowing to them as the sidebar slides away, so the
// bar keeps one shape all the way and nothing in it is taken for another.
//
// Every length comes from the catalog (`windowChromeMetrics`), and the band
// paints nothing of its own: the glass under each group of items is the only
// surface it has, which is the Liquid Glass bar.
construct WindowChrome() extends Widget {

    function describe(context: borrow BuildContext, modifiers: borrow ModifierContext) -> CALayerDescription {
        kiraUiToolbarSinkEnsure()
        var sink = nativeRecover<KiraUiToolbarSink>(kiraUiStateSlotGet(kiraUiToolbarSinkKey()))
        let metrics = windowChromeMetrics
        sink.windowDragHeight = metrics.toolbarHeight
        let barModifiers = modifierContextPresenting(modifiers, .Toolbar)

        var sections: [CALayerDescription] = []
        var leading: [CALayerDescription] = []
        if sink.hasNavigationColumn {
            sections.append(sidebarSection(sink, metrics, context, barModifiers))
        } else {
            leading.append(windowControlsArea(metrics, context, barModifiers))
            for group in toolbarGroups(sink.navigation, metrics, context, barModifiers) {
                leading.append(group)
            }
            if sink.sidebarToggle {
                leading.append(sidebarToggle(metrics, context, barModifiers))
            }
        }
        sections.append(documentSection(sink, move leading, metrics, context, barModifiers))
        let band = CALayerDescription {
            layout: CALayoutIntent {
                axis: .Row,
                heightFill: false,
                fixedHeight: metrics.toolbarHeight
            },
            sublayers: move sections
        }
        if sink.tabs.count == 0 && sink.covered.tabs.count == 0 {
            return band
        }
        var layers: [CALayerDescription] = [band]
        if !sink.moving {
            layers.append(tabBar(sink.tabs, context, barModifiers))
        } else {
            // A view's tabs are its own: they leave with it and come with the
            // view uncovered.
            if sink.tabs.count > 0 {
                layers.append(toolbarFaded(tabBar(sink.tabs, context, barModifiers), 1.0 - sink.coveredShown))
            }
            let coveredTabs = kiraUiToolbarCoveredEntries(sink.covered.tabs, sink.tabs, sink.pageEnd.tabs)
            if coveredTabs.count > 0 {
                var under = tabBar(coveredTabs, context, barModifiers)
                layerInert(under)
                layers.append(toolbarFaded(move under, sink.coveredShown))
            }
        }
        return CALayerDescription {
            layout: CALayoutIntent {
                heightFill: false,
                fixedHeight: metrics.toolbarHeight,
                alignment: Point { x: 0.5, y: 0.5 }
            },
            sublayers: move layers
        }
    }

    // A `TabView`'s tabs: one capsule of glass centered on the window, in the
    // band's row, holding its tabs off every side.
    function tabBar(
        entries: borrow [KiraUiToolbarEntry],
        context: borrow BuildContext,
        modifiers: borrow ModifierContext,
    ) -> CALayerDescription {
        let metrics = tabBarMetrics
        var tabs: [CALayerDescription] = []
        for entry in entries {
            tabs.append(copy entry.content)
        }
        let row = CALayerDescription {
            layout: CALayoutIntent {
                axis: .Row,
                widthFill: false,
                heightFill: false,
                paddingLeading: metrics.inset,
                paddingTop: metrics.inset,
                paddingTrailing: metrics.inset,
                paddingBottom: metrics.inset,
                alignment: Point { x: 0.0, y: 0.5 }
            },
            sublayers: move tabs
        }
        return interactiveGlassDescription(
            context,
            kiraUiTapSeqKey(),
            CALayoutIntent {
                widthFill: false,
                heightFill: false,
                fixedHeight: metrics.height
            },
            containerShapeRadius(.Capsule, modifiers),
            .Capsule,
            modifiers,
            [row]
        )
    }

    // Over the sidebar: the window controls, then the sidebar's own items and
    // its toggle held at its trailing edge. As the sidebar slides away the
    // section narrows with it, down to what it holds, and its trailing edge
    // closes from a column's inset to the gap between two pieces of glass.
    function sidebarSection(
        sink: borrow KiraUiToolbarSink,
        metrics: borrow WindowChromeMetrics,
        context: borrow BuildContext,
        modifiers: borrow ModifierContext,
    ) -> CALayerDescription {
        var parts: [CALayerDescription] = []
        parts.append(windowControlsArea(metrics, context, modifiers))
        parts.append(toolbarFlexibleSpace())
        for group in toolbarGroups(sink.navigation, metrics, context, modifiers) {
            parts.append(group)
        }
        if sink.sidebarToggle {
            parts.append(sidebarToggle(metrics, context, modifiers))
        }
        let shown = sink.navigationShown
        var section = toolbarSection(move parts, metrics, sink.navigationWidth * shown, 0.0)
        section.layout.paddingTrailing = metrics.edgeInset * shown + metrics.itemSpacing * (1.0 - shown)
        section.key = 1
        return section
    }

    // Over the document: whatever leads it, a back button, the title, then the
    // items at the trailing end -- and the principal item centered over all of
    // it, the way the platform centers it on the section rather than between
    // whatever happens to be either side.
    function documentSection(
        sink: borrow KiraUiToolbarSink,
        leading: [CALayerDescription],
        metrics: borrow WindowChromeMetrics,
        context: borrow BuildContext,
        modifiers: borrow ModifierContext,
    ) -> CALayerDescription {
        // A section that starts at a column's edge holds its first piece of glass
        // off it; one that starts with the window controls starts at the window's.
        let leadingInset = leading.count > 0 ? 0.0 : metrics.edgeInset * sink.navigationShown
        // Each piece is known by what it is -- the back button, the title, the
        // space, each trailing group by its place among them, the search
        // field -- never by where it stands in the row: a back button going
        // away would otherwise have the tree hand its layers, the press it
        // holds included, to whatever moved up into its place.
        var parts: [CALayerDescription] = []
        let covered = sink.covered
        let shown = sink.coveredShown
        let end = sink.pageEnd
        let backGroups = toolbarMorphGroups(sink.back, kiraUiToolbarCoveredEntries(covered.back, sink.back, end.back), shown, sink.moving, metrics, context, modifiers, kiraUiNavigationGoingBack())
        let followsBack = backGroups.count > 0
        if followsBack {
            var back = toolbarBackArea(move backGroups, metrics)
            back.key = toolbarPieceBack()
            parts.append(move back)
        }
        if sink.moving {
            var title = toolbarMorphTitle(sink, followsBack, metrics, context, modifiers)
            title.key = toolbarPieceTitle()
            parts.append(move title)
        } else if sink.detailTitle.count > 0 && !sink.largeTitle {
            var title = windowTitle(sink.detailTitle, metrics, followsBack, context, modifiers)
            title.key = toolbarPieceTitle()
            parts.append(move title)
        }
        var space = toolbarFlexibleSpace()
        space.key = toolbarPieceSpace()
        parts.append(move space)
        var trailing = copy sink.automatic
        for entry in sink.primaryAction {
            trailing.append(copy entry)
        }
        var coveredTrailing = kiraUiToolbarCoveredEntries(covered.automatic, sink.automatic, end.automatic)
        for entry in kiraUiToolbarCoveredEntries(covered.primaryAction, sink.primaryAction, end.primaryAction) {
            coveredTrailing.append(copy entry)
        }
        var place = 0
        for group in toolbarMorphGroups(trailing, coveredTrailing, shown, sink.moving, metrics, context, modifiers) {
            var piece = copy group
            piece.key = toolbarPieceTrailing(place)
            parts.append(move piece)
            place = place + 1
        }
        if sink.searching {
            var search = toolbarSearchField(sink, metrics, context, modifiers)
            search.key = toolbarPieceSearch()
            parts.append(move search)
        }
        // The window's own pieces lead the section and stay what they are;
        // the page's follow, known by the path's generation, so a path that
        // starts somewhere new brings its own items rather than reshaping the
        // last page's into them.
        //
        // The page's items take their values at once. The bar's one motion is
        // the morph a push draws by its progress, and that changes which
        // pieces stand where -- a back button comes in at the front, a piece
        // folds away -- so a piece matched by its place to whatever stood
        // there before would slide across the bar to where it now is.
        var items = CALayerDescription {
            key: kiraUiNavigationGeneration() + 1,
            layout: CALayoutIntent {
                axis: .Row,
                spacing: metrics.itemSpacing,
                heightFill: false,
                fixedHeight: metrics.toolbarHeight,
                flex: 1,
                alignment: Point { x: 0.0, y: 0.5 }
            },
            sublayers: move parts
        }
        layerImmediate(items)
        var sectionParts = move leading
        sectionParts.append(move items)
        // The bar stands in the section whether a principal item is over it or
        // not, so a view that brings one does not move the bar a level down
        // and have the tree take every piece in it for another.
        var layers = [toolbarSection(move sectionParts, metrics, 0.0 - 1.0, leadingInset)]
        if sink.principal.count > 0 || sink.covered.principal.count > 0 {
            layers.append(principalRow(sink, metrics, context, modifiers))
        }
        return CALayerDescription {
            key: 2,
            layout: CALayoutIntent {
                heightFill: false,
                fixedHeight: metrics.toolbarHeight,
                flex: 1,
                alignment: Point { x: 0.5, y: 0.5 }
            },
            sublayers: move layers
        }
    }

    // The principal item, centered across the section.
    function principalRow(
        sink: borrow KiraUiToolbarSink,
        metrics: borrow WindowChromeMetrics,
        context: borrow BuildContext,
        modifiers: borrow ModifierContext,
    ) -> CALayerDescription {
        var row = CALayerDescription {
            // The page's, like the items beside it, and like them it takes its
            // values at once.
            key: kiraUiNavigationGeneration() + 1,
            layout: CALayoutIntent {
                axis: .Row,
                spacing: metrics.itemSpacing,
                widthFill: false,
                heightFill: false,
                fixedHeight: metrics.toolbarHeight,
                alignment: Point { x: 0.0, y: 0.5 }
            },
            sublayers: toolbarMorphGroups(sink.principal, kiraUiToolbarCoveredEntries(sink.covered.principal, sink.principal, sink.pageEnd.principal), sink.coveredShown, sink.moving, metrics, context, modifiers)
        }
        layerImmediate(row)
        return row
    }

    // The button that shows and hides the sidebar: a piece of glass of its own,
    // which the platform adds to every split view without being asked.
    function sidebarToggle(metrics: borrow WindowChromeMetrics, context: borrow BuildContext, modifiers: borrow ModifierContext) -> CALayerDescription {
        let button = Button(action: navigationSidebarToggleAction()) {
            Icon(symbol: .SidebarLeft)
        }
        return toolbarGlassGroup([button.describe(context, modifiers)], metrics, context, modifiers)
    }
}

// The keys the pieces of a document's section are known by. See
// `documentSection`.
function toolbarPieceBack() -> Int {
    return 1
}

function toolbarPieceTitle() -> Int {
    return 2
}

function toolbarPieceSpace() -> Int {
    return 3
}

function toolbarPieceSearch() -> Int {
    return 4
}

function toolbarPieceTrailing(place: Int) -> Int {
    return 100 + place
}

// One section of the band: its parts in a row, centered across the band's
// height, a piece of glass's gap apart, and the last one held off the
// section's trailing edge. A section is at least the width it is given and
// grows to what it holds; one given none takes what the sections before it
// left.
function toolbarSection(parts: [CALayerDescription], metrics: borrow WindowChromeMetrics, width: Float, leadingInset: Float) -> CALayerDescription {
    return CALayerDescription {
        layout: CALayoutIntent {
            axis: .Row,
            spacing: metrics.itemSpacing,
            widthFill: width < 0.0,
            heightFill: false,
            minWidth: max(width, 0.0),
            fixedHeight: metrics.toolbarHeight,
            paddingLeading: leadingInset,
            paddingTrailing: metrics.edgeInset,
            alignment: Point { x: 0.0, y: 0.5 }
        },
        sublayers: move parts
    }
}

// The room the close, minimize and zoom buttons take. The platform draws them
// where it has them; where the toolkit draws its own, they sit here.
function windowControlsArea(metrics: borrow WindowChromeMetrics, context: borrow BuildContext, modifiers: borrow ModifierContext) -> CALayerDescription {
    var controls = WindowControls().describe(context, modifiers)
    controls.layout.widthFill = false
    controls.layout.heightFill = false
    return CALayerDescription {
        layout: CALayoutIntent {
            widthFill: false,
            heightFill: false,
            fixedWidth: metrics.controlsEnd() - metrics.itemSpacing,
            paddingLeading: metrics.controlsLeading,
            alignment: Point { x: 0.0, y: 0.5 }
        },
        sublayers: [controls]
    }
}

// A column's title, set the way the platform sets a window title: its glyphs
// start the title inset past whatever leads the section -- the column's edge,
// the window controls, the sidebar's toggle -- or the title spacing past a back
// button.
function windowTitle(
    title: borrow String,
    metrics: borrow WindowChromeMetrics,
    followsBack: Bool,
    context: borrow BuildContext,
    modifiers: borrow ModifierContext,
) -> CALayerDescription {
    var text = Text(content: copy title)
        .font(size: windowTitleFont.size, weight: windowTitleFont.weight)
        .describe(context, modifiers)
    text.layout.widthFill = false
    text.layout.heightFill = false
    let gap = followsBack ? metrics.titleSpacing : metrics.titleInset
    text.layout.paddingLeading = max(gap - metrics.itemSpacing, 0.0)
    return text
}

function toolbarFlexibleSpace() -> CALayerDescription {
    return CALayerDescription {
        layout: CALayoutIntent {
            heightFill: false,
            flex: 1
        }
    }
}

// What one run of entries comes to on the bar: a row of items to set on one
// piece of glass, or something that stands bare -- an item that opted out of
// the shared background, or a spacer.
struct ToolbarPiece {
    var layer: CALayerDescription = CALayerDescription {}
    var glass: Bool = false
}

// Entries, collapsed into the pieces of glass they describe.
//
// The items of one declaration share one capsule: a `ToolbarItemGroup` is one
// control with seams, and each `ToolbarItem` is a piece of glass of its own --
// what the platform draws for each. An item that opted out of the shared
// background stands bare, and a spacer closes whatever was open.
function toolbarPieces(entries: borrow [KiraUiToolbarEntry], metrics: borrow WindowChromeMetrics) -> [ToolbarPiece] {
    var pieces: [ToolbarPiece] = []
    var run: [CALayerDescription] = []
    var runGroup = 0
    for entry in entries {
        let continuesRun = entry.shared && !entry.isSpacer && run.count > 0 && entry.group == runGroup
        if !continuesRun && run.count > 0 {
            pieces.append(ToolbarPiece { layer: toolbarGlassRow(move run, metrics), glass: true })
            run = []
        }
        if entry.isSpacer {
            if entry.flexible {
                pieces.append(ToolbarPiece { layer: toolbarFlexibleSpace() })
            } else if metrics.spacerWidth > metrics.itemSpacing * 2.0 {
                pieces.append(ToolbarPiece { layer: toolbarFixedSpace(metrics) })
            }
        } else if entry.shared {
            run.append(toolbarItemFrame(entry.content, metrics))
            runGroup = entry.group
        } else {
            pieces.append(ToolbarPiece { layer: toolbarItemFrame(entry.content, metrics) })
        }
    }
    if run.count > 0 {
        pieces.append(ToolbarPiece { layer: toolbarGlassRow(move run, metrics), glass: true })
    }
    return pieces
}

function toolbarGroups(
    entries: borrow [KiraUiToolbarEntry],
    metrics: borrow WindowChromeMetrics,
    context: borrow BuildContext,
    modifiers: borrow ModifierContext,
) -> [CALayerDescription] {
    var groups: [CALayerDescription] = []
    for piece in toolbarPieces(entries, metrics) {
        groups.append(toolbarPieceLayer(piece, metrics, context, modifiers))
    }
    return groups
}

function toolbarPieceLayer(
    piece: borrow ToolbarPiece,
    metrics: borrow WindowChromeMetrics,
    context: borrow BuildContext,
    modifiers: borrow ModifierContext,
) -> CALayerDescription {
    if piece.glass {
        var glass = toolbarGlass(copy piece.layer, 0.0 - 1.0, metrics, context, modifiers)
        if toolbarGlassLent(piece.layer) {
            glass.content = .Empty
            glass.capturesBackdrop = false
        }
        return glass
    }
    return copy piece.layer
}

// Whether a piece's glass is out as a menu: the piece is one item, and that
// item is a menu whose card is the glass it would sit on. The piece keeps its
// place and its press, and draws no glass until the menu comes home.
function toolbarGlassLent(row: borrow CALayerDescription) -> Bool {
    if row.sublayers.count != 1 || row.sublayers[0].sublayers.count != 1 {
        return false
    }
    return kiraUiMenuHoldsGlass(row.sublayers[0].sublayers[0].hitKey)
}

// The field `.searchable` puts at the trailing end of the bar, as iPadOS sets
// it: a capsule of glass of its own, the magnifier leading the prompt -- or,
// once there is text, the text and a button that clears it. A press anywhere
// on the glass puts the caret where it landed.
function toolbarSearchField(
    sink: borrow KiraUiToolbarSink,
    metrics: borrow WindowChromeMetrics,
    context: borrow BuildContext,
    modifiers: borrow ModifierContext,
) -> CALayerDescription {
    let key = kiraUiSearchFieldKey()
    let size = textFieldTextSize(modifiers)
    let st = nativeRecover<KiraUiTextFieldState>(kiraUiStateSlotGet(textFieldSlotKey(key)))
    let focused = context.focusedKey == key
    var runs: [CALayerDescription] = []
    // Its symbols are the bar's, at the bar's size and weight.
    let barModifiers = modifierContextPresenting(modifiers, .Toolbar)
    runs.append(Icon(symbol: .Search)
        .foregroundColor(.Secondary)
        .describe(context, barModifiers))
    if st.codes.count == 0 {
        if focused {
            runs.append(textFieldCaret(modifiers))
        }
        runs.append(Text(sink.searchPrompt)
            .font(size: size, weight: .Medium)
            .foregroundColor(.Secondary)
            .describe(context, modifiers))
    } else if focused {
        runs.append(textFieldRun(foundationStringFromCodepoints(st.codes, 0, st.caret), size, context, modifiers))
        runs.append(textFieldCaret(modifiers))
        runs.append(textFieldRun(foundationStringFromCodepoints(st.codes, st.caret, st.codes.count), size, context, modifiers))
    } else {
        runs.append(textFieldRun(foundationStringFromCodepoints(st.codes, 0, st.codes.count), size, context, modifiers))
    }
    var text = CALayerDescription {
        layout: CALayoutIntent {
            axis: .Row,
            heightFill: false,
            flex: 1,
            alignment: Point { x: 0.0, y: 0.5 }
        },
        clipsChildren: true,
        sublayers: [CALayerDescription {
            layout: CALayoutIntent {
                axis: .Row,
                spacing: metrics.searchSpacing,
                widthFill: false,
                heightFill: false,
                alignment: Point { x: 0.0, y: 0.5 }
            },
            sublayers: move runs
        }]
    }
    var parts = [move text]
    if st.codes.count > 0 {
        var clear = Icon(symbol: .XmarkCircleFill)
            .foregroundColor(.Tertiary)
            .describe(context, barModifiers)
        clear.hittable = true
        clear.hitKey = sink.searchClearKey
        parts.append(move clear)
    }
    var glass = interactiveGlassDescription(
        context,
        key,
        CALayoutIntent {
            axis: .Row,
            spacing: metrics.searchSpacing,
            widthFill: false,
            heightFill: false,
            fixedWidth: metrics.searchWidth,
            fixedHeight: metrics.itemHeight,
            paddingLeading: metrics.searchLeading,
            paddingTrailing: metrics.searchTrailing,
            alignment: Point { x: 0.0, y: 0.5 }
        },
        containerShapeRadius(.Capsule, modifiers),
        .Capsule,
        modifiers,
        move parts
    )
    glass.hittable = true
    return glass
}

// The back button's place, known by a key of its own so nothing else on the
// bar is ever matched to it. Going back to a view with nowhere further back,
// it stays as it is while the view goes, and only then leaves: it swells a
// little as it fades.
function toolbarBackArea(groups: [CALayerDescription], metrics: borrow WindowChromeMetrics) -> CALayerDescription {
    return CALayerDescription {
        key: 1,
        layout: CALayoutIntent {
            axis: .Row,
            spacing: metrics.itemSpacing,
            widthFill: false,
            heightFill: false,
            alignment: Point { x: 0.0, y: 0.5 }
        },
        removal: CARemoval {
            scale: metrics.backRemovalScale,
            opacity: 0.0,
            duration: metrics.backRemovalDuration
        },
        sublayers: move groups
    }
}

// Two views' entries for one place on the bar, while a stack moves between the
// views. The bar does not move: each piece of glass the two have in the same
// place, counted from the leading end, stays one piece, its width going from
// one view's to the other's as its items cross-fade, and a piece only one of
// them has fades and folds away on its own -- except, going back, one only
// the leaving view has, which stays as it is to leave once the view is gone.
// The covered view's items answer nothing until it is the view showing.
function toolbarMorphGroups(
    top: borrow [KiraUiToolbarEntry],
    covered: borrow [KiraUiToolbarEntry],
    shown: Float,
    moving: Bool,
    metrics: borrow WindowChromeMetrics,
    context: borrow BuildContext,
    modifiers: borrow ModifierContext,
    goingBack: Bool = false,
) -> [CALayerDescription] {
    if !moving {
        return toolbarGroups(top, metrics, context, modifiers)
    }
    let above = toolbarPieces(top, metrics)
    let below = toolbarPieces(covered, metrics)
    let count = above.count > below.count ? above.count : below.count
    var groups: [CALayerDescription] = []
    for slot in 0..count {
        let hasAbove = slot < above.count
        let hasBelow = slot < below.count
        if hasAbove && hasBelow && above[slot].glass && below[slot].glass {
            var under = copy below[slot].layer
            layerInert(under)
            groups.append(toolbarMorphGlass(copy above[slot].layer, move under, shown, metrics, context, modifiers))
        } else if hasAbove && hasBelow && !above[slot].glass && !below[slot].glass {
            var under = copy below[slot].layer
            layerInert(under)
            groups.append(toolbarCrossFade(copy above[slot].layer, move under, shown))
        } else {
            if hasAbove && goingBack {
                groups.append(toolbarPieceLayer(above[slot], metrics, context, modifiers))
            } else if hasAbove {
                groups.append(toolbarFolding(toolbarPieceLayer(above[slot], metrics, context, modifiers), 1.0 - shown))
            }
            if hasBelow {
                var under = toolbarPieceLayer(below[slot], metrics, context, modifiers)
                layerInert(under)
                groups.append(toolbarFolding(move under, shown))
            }
        }
    }
    return groups
}

// Two bare pieces in one place: one box going from the first's width to the
// second's, the first fading out over the second fading in.
function toolbarCrossFade(from: CALayerDescription, to: CALayerDescription, shown: Float) -> CALayerDescription {
    let fromWidth = caMeasure(from, windowChromeMetrics.toolbarHeight * 100.0).width
    let toWidth = caMeasure(to, windowChromeMetrics.toolbarHeight * 100.0).width
    var both = CALayerDescription {
        layout: CALayoutIntent {
            widthFill: false,
            heightFill: false,
            fixedWidth: fromWidth + (toWidth - fromWidth) * shown,
            alignment: Point { x: 0.5, y: 0.5 }
        },
        sublayers: [toolbarFaded(move from, 1.0 - shown), toolbarFaded(move to, shown)]
    }
    layerImmediate(both)
    return both
}

// A piece only one view has: as visible as that view, as wide, and as present
// in the bar, so the pieces beside it close up over its gap too as it goes.
function toolbarFolding(piece: CALayerDescription, shown: Float) -> CALayerDescription {
    let width = caMeasure(piece, windowChromeMetrics.toolbarHeight * 100.0).width
    var folded = CALayerDescription {
        layout: CALayoutIntent {
            widthFill: false,
            heightFill: false,
            fixedWidth: width * shown,
            presence: shown,
            alignment: Point { x: 0.0, y: 0.5 }
        },
        sublayers: [toolbarFaded(move piece, shown)]
    }
    layerImmediate(folded)
    return folded
}

// One piece of glass between two rows of items: as wide as the first row
// turning into as wide as the second, the first fading out over the second
// fading in.
function toolbarMorphGlass(
    from: CALayerDescription,
    to: CALayerDescription,
    shown: Float,
    metrics: borrow WindowChromeMetrics,
    context: borrow BuildContext,
    modifiers: borrow ModifierContext,
) -> CALayerDescription {
    let fromWidth = caMeasure(from, windowChromeMetrics.toolbarHeight * 100.0).width
    let toWidth = caMeasure(to, windowChromeMetrics.toolbarHeight * 100.0).width
    var leaving = move from
    leaving.opacity = 1.0 - shown
    var coming = move to
    coming.opacity = shown
    let rows = CALayerDescription {
        layout: CALayoutIntent {
            widthFill: false,
            heightFill: false,
            alignment: Point { x: 0.5, y: 0.5 }
        },
        sublayers: [move leaving, move coming]
    }
    var glass = toolbarGlass(move rows, fromWidth + (toWidth - fromWidth) * shown, metrics, context, modifiers)
    layerImmediate(glass)
    return glass
}

// A piece drawn at `opacity`, following the stack's motion frame by frame.
function toolbarFaded(piece: CALayerDescription, opacity: Float) -> CALayerDescription {
    var faded = move piece
    faded.opacity = opacity
    layerImmediate(faded)
    return faded
}

// Both views' titles in the band, cross-fading with the views.
function toolbarMorphTitle(
    sink: borrow KiraUiToolbarSink,
    followsBack: Bool,
    metrics: borrow WindowChromeMetrics,
    context: borrow BuildContext,
    modifiers: borrow ModifierContext,
) -> CALayerDescription {
    var titles: [CALayerDescription] = []
    if sink.detailTitle.count > 0 && !sink.largeTitle {
        titles.append(toolbarFaded(windowTitle(sink.detailTitle, metrics, followsBack, context, modifiers), 1.0 - sink.coveredShown))
    }
    if sink.covered.title.count > 0 && !sink.covered.largeTitle {
        titles.append(toolbarFaded(windowTitle(sink.covered.title, metrics, followsBack, context, modifiers), sink.coveredShown))
    }
    return CALayerDescription {
        layout: CALayoutIntent {
            widthFill: false,
            heightFill: false,
            alignment: Point { x: 0.0, y: 0.5 }
        },
        sublayers: move titles
    }
}

// A fixed spacer wider than the gap the section already leaves between two
// pieces of glass holds the rest open. At the platform's own numbers the gap
// alone is the spacer -- 8 points between the glass either side -- and nothing
// is added.
function toolbarFixedSpace(metrics: borrow WindowChromeMetrics) -> CALayerDescription {
    return CALayerDescription {
        layout: CALayoutIntent {
            widthFill: false,
            heightFill: false,
            fixedWidth: metrics.spacerWidth - metrics.itemSpacing * 2.0
        }
    }
}

// One item's box on the bar: as tall as a piece of glass, the item centered in
// it. A button already is that box; anything else -- a run of text, a picker --
// hugs its content.
function toolbarItemFrame(content: borrow CALayerDescription, metrics: borrow WindowChromeMetrics) -> CALayerDescription {
    var item = copy content
    item.layout.widthFill = false
    item.layout.heightFill = false
    return CALayerDescription {
        layout: CALayoutIntent {
            widthFill: false,
            heightFill: false,
            fixedHeight: metrics.itemHeight,
            alignment: Point { x: 0.5, y: 0.5 }
        },
        sublayers: [item]
    }
}

// A run of shared items in a row, ready for its glass: an item alone is its
// glass; two or more are held a little off the capsule's ends.
function toolbarGlassRow(items: [CALayerDescription], metrics: borrow WindowChromeMetrics) -> CALayerDescription {
    let inset = items.count > 1 ? metrics.groupInset : 0.0
    return CALayerDescription {
        layout: CALayoutIntent {
            axis: .Row,
            spacing: metrics.groupSpacing,
            paddingLeading: inset,
            paddingTrailing: inset,
            widthFill: false,
            heightFill: false,
            alignment: Point { x: 0.0, y: 0.5 }
        },
        sublayers: move items
    }
}

// A row on one capsule of glass, `width` wide or as wide as the row when
// negative. The capsule is interactive glass: a press on any item in it moves
// the whole capsule, as the platform's does, while the item takes the action.
function toolbarGlass(
    row: CALayerDescription,
    width: Float,
    metrics: borrow WindowChromeMetrics,
    context: borrow BuildContext,
    modifiers: borrow ModifierContext,
) -> CALayerDescription {
    return interactiveGlassDescription(
        context,
        kiraUiTapSeqKey(),
        CALayoutIntent {
            widthFill: false,
            heightFill: false,
            fixedWidth: width,
            fixedHeight: metrics.itemHeight,
            alignment: Point { x: 0.5, y: 0.5 }
        },
        containerShapeRadius(.Capsule, modifiers),
        .Capsule,
        modifiers,
        [move row]
    )
}

function toolbarGlassGroup(
    items: [CALayerDescription],
    metrics: borrow WindowChromeMetrics,
    context: borrow BuildContext,
    modifiers: borrow ModifierContext,
) -> CALayerDescription {
    return toolbarGlass(toolbarGlassRow(move items, metrics), 0.0 - 1.0, metrics, context, modifiers)
}

// The window: its background, its content, and its chrome over both.
//
// The content is laid out inside the safe area the chrome leaves, unless a
// container in it already did that itself — a split view does, so its sidebar
// can run under the bar.
function windowDescription(content: CALayerDescription, context: borrow BuildContext, modifiers: borrow ModifierContext) -> CALayerDescription {
    var body = move content
    if !kiraUiChromeSafeAreaWasHandled() {
        body = safeAreaInset(move body, context.safeArea)
    }
    var chrome = WindowChrome().describe(context, modifiers)
    chrome.layout.widthFill = true
    return CALayerDescription {
        content: .Solid(CASolid {
            fill: caColorFromFoundation(navigationCanvas(modifiers))
        }),
        sublayers: [body, chrome]
    }
}

// Content held inside a safe area, its box otherwise its own.
function safeAreaInset(content: CALayerDescription, insets: borrow EdgeInsets) -> CALayerDescription {
    return CALayerDescription {
        layout: CALayoutIntent {
            paddingLeading: insets.leading,
            paddingTop: insets.top,
            paddingTrailing: insets.trailing,
            paddingBottom: insets.bottom
        },
        sublayers: [move content]
    }
}

// The native compositor asks this only for a real pointer press. Controls in
// the toolbar still receive their ordinary UI event; the window decides whether
// the press begins a move once it belongs to the bar.
function kiraUiToolbarWindowDragRegion(x: Float, y: Float) -> Bool {
    kiraUiToolbarSinkEnsure()
    let sink = nativeRecover<KiraUiToolbarSink>(kiraUiStateSlotGet(kiraUiToolbarSinkKey()))
    if sink.windowDragHeight <= 0.0 {
        return graphicsApplicationFallbackWindowDragRegion(x, y)
    }
    if x < 0.0 || y < 0.0 || y >= sink.windowDragHeight {
        return false
    }
    // The close, minimize and zoom buttons are the window's, wherever they are
    // drawn, and a press on them is theirs.
    let metrics = windowChromeMetrics
    let controlsStart = metrics.controlsLeading
    let controlsEnd = controlsStart + metrics.controlDiameter * 3.0 + metrics.controlSpacing * 2.0
    return x < controlsStart || x > controlsEnd
}

construct SharedBackgroundVisibilityLayer(visibility: SharedBackgroundVisibility) extends Widget {
    let content: some Widget


    function describe(context: borrow BuildContext, modifiers: borrow ModifierContext) -> CALayerDescription {
        if visibility == .Hidden {
            kiraUiToolbarHideNextSharedBackground()
        }
        return content.describe(context, modifiers)
    }
}

extend Widget {
    // Whether this toolbar item is drawn on the glass its neighbors are drawn
    // on, matching SwiftUI's `.sharedBackgroundVisibility(...)`.
    //
    // `.Hidden` takes the item off the shared background entirely — for a
    // control that carries its own shape, an avatar, anything that would look
    // wrong sharing an edge with the buttons beside it.
    function sharedBackgroundVisibility(visibility: SharedBackgroundVisibility) -> Any Widget {
        return SharedBackgroundVisibilityLayer(visibility: visibility) {
            self
        }
    }

    // The items this view puts on the window's toolbar, matching SwiftUI's
    // `.toolbar { … }`. They are declared beside the content they belong to and
    // drawn on the one bar the window has.
    // SwiftUI writes this as a trailing block — `.toolbar { ToolbarItem { … } }`
    // — and so does this, because the last parameter is a content parameter and
    // a trailing block is what fills one. Taking the items as an ordinary
    // argument forced a container to be named at every call site for no reason
    // but the grammar.
    function toolbar(items: [some Widget]) -> Any Widget {
        return ToolbarLayer(items: ToolbarContent() {
            For(item in items) {
                item
            }
        }) {
            self
        }
    }

    // What this column is showing, matching SwiftUI's `.navigationTitle(...)`.
    // The bar sets it, in the section over the column that declared it — a
    // column names itself and says nothing about how a name is drawn.
    function navigationTitle(title: String) -> Any Widget {
        return NavigationTitleLayer(title: title) {
            self
        }
    }
}

construct ContentMarginLayer(value: Float) extends Widget {
    let content: some Widget


    function describe(context: borrow BuildContext, modifiers: borrow ModifierContext) -> CALayerDescription {
        kiraUiToolbarSetMargin(value)
        let resolved = modifierContextApply(modifiers, modifierDeltaContentMargin(value))
        return content.describe(context, resolved)
    }
}

construct NavigationTitleLayer(title: String) extends Widget {
    let content: some Widget


    function describe(context: borrow BuildContext, modifiers: borrow ModifierContext) -> CALayerDescription {
        kiraUiToolbarSetTitle(copy title)
        return content.describe(context, modifiers)
    }
}

construct ToolbarLayer(items: Any Widget) extends Widget {
    let content: some Widget


    function describe(context: borrow BuildContext, modifiers: borrow ModifierContext) -> CALayerDescription {
        let childModifiers = modifierContextForChildren(modifiers)
        let toolbarModifiers = modifierContextPresenting(modifiers, .Toolbar)
        // The items put themselves on the bar as they lower; what they lower to
        // is the bar's to draw. A toolbar's labels are set in the body face, as
        // the platform's are.
        items
            .backgroundStyle(.Clear)
            .describe(context, toolbarModifiers)
        return content.describe(context, childModifiers)
    }
}
