import Foundation
import KCoreAnimation

extend Widget {
    // SwiftUI: `.bold(_ isActive: Bool = true)`. A bold trait is not a
    // wholesale replacement for the current font; preserving the underlying
    // weight lets `.bold(false)` undo an inherited bold while keeping the
    // theme's chosen type style and the caller's explicit font weight.
    function bold(isActive: Bool = true) -> Any Widget {
        return ModifierDeltaLayer(delta: modifierDeltaBold(isActive)) { self }
    }

}