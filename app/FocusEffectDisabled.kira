import Foundation
import KCoreAnimation

// A focus effect is visual only: the focused view continues to receive its
// keyboard input, FocusState updates, and accessibility focus. SwiftUI gives
// the enclosing environment precedence over a nested conflicting preference.
public function modifierDeltaFocusEffectDisabled(disabled: Bool) -> ModifierDelta {
    return ModifierDelta {
        hasFocusEffectDisabled: true,
        focusEffectDisabled: disabled
    }
}

extend Widget {
    // SwiftUI: `.focusEffectDisabled(_ disabled: Bool = true)`.
    function focusEffectDisabled(disabled: Bool = true) -> Any Widget {
        return ModifierDeltaLayer(
            delta: modifierDeltaFocusEffectDisabled(disabled)
        ) { self }
    }
}