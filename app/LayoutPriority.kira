import Foundation
import KCoreAnimation

// A priority is a property of a sibling's layout request, never an inherited
// environment value or a visual transform. The stack applies it when the
// available width is smaller than the children's ideal sizes.
public construct LayoutPriorityLayer(value: Number) extends Widget {
    let content: some Widget

    function isSection() -> Bool { return content.isSection() }

    function describe(
        context: borrow BuildContext,
        modifiers: borrow ModifierContext
    ) -> CALayerDescription {
        var described = content.describe(context, modifiers)
        described.layout.layoutPriority = value
        return described
    }
}

extend Widget {
    // SwiftUI: `.layoutPriority(_ value: Double)`.
    function layoutPriority(value: Number) -> Any Widget {
        return LayoutPriorityLayer(value: value) { self }
    }
}