import Foundation
import Ember
import KiraLayout
import KCoreAnimation

// --- Navigation values and path ---------------------------------------------

// A place a navigation path goes, as SwiftUI's path holds `Hashable` values:
// a link appends one, and the stack shows the view the route draws. Each
// route an app goes to is a construct of this family, as each panel is one of
// `PanelValue`:
//
//     construct ProjectRoute(name: String) extends NavigationRoute {
//         function routeKey() -> String {
//             return "project/" + name
//         }
//
//         function destination() -> Any Widget {
//             return ProjectPage(name: name)
//         }
//     }
//
// A route draws its own view, rather than a stack looking its type up,
// because a route an app makes and KiraUI holds crosses a module's edge, and
// nothing that crosses one is asked its type.
public construct NavigationRoute {
    // What tells this route from another: two routes with one key are the
    // same place, as two equal `Hashable` values are.
    @Required function routeKey() -> String
    // The view the path shows when it ends here.
    @Required function destination() -> Any Widget
}

public struct NavigationPathState {
    var values: [Any NavigationRoute] = []
    // Which run of views the path is showing. Replacing the path with one
    // that starts somewhere else -- choosing another sidebar row -- starts a
    // new run: its views are new views, not the old ones changed.
    var generation: Number = 0
    // Which view a stacked sidebar has gone on to. Every one of them stands in
    // the detail's place, and each is a new view there: going on to Symbols
    // after coming back from Controls must not find Controls' layers, still
    // going off, and turn them into it.
    var detailRun: Number = 0
    // The path as it was last settled, while changes made since have not
    // been: everything one action does to the path lands as one change, as
    // SwiftUI's does, moving from this to `values`.
    var settled: [Any NavigationRoute] = []
    var unsettled: Bool = false
}

// NavigationPath is an empty value-shaped handle over the app navigation state.
// The state slot is fixed because one active app navigation path is the
// default, while the values themselves keep their own types. Keeping the handle empty also lets a view pass it through several
// NavigationStack and NavigationSplitView layers without ownership friction.
public struct NavigationPath {
    function values() -> [Any NavigationRoute] {
        return navigationValues()
    }

    function isEmpty() -> Bool {
        return self.values().count == 0
    }

    // Whether the path runs through this value first: what makes a sidebar's
    // row the selected one.
    function startsWith(value: borrow Any NavigationRoute) -> Bool {
        let current = self.values()
        if current.count == 0 {
            return false
        }
        return value.routeKey() == current[0].routeKey()
    }

    // The value the path ends at: what the view on top shows.
    function last() -> Optional<Any NavigationRoute> {
        let current = self.values()
        if current.count == 0 {
            return .None
        }
        return .Some(copy current[current.count - 1])
    }

    function append(value: Any NavigationRoute) {
        navigationPush(move value)
    }

    function removeLast() {
        navigationPop()
    }

    function removeAll() {
        navigationClear()
    }
}

public function navigationEnsure() {
    if !ambientStateHas(StateSlot.navigationPath) {
        ambientStatePut(
            StateSlot.navigationPath,
            nativeUserData(nativeState(NavigationPathState {}))
        )
    }
}

public function navigationValues() -> [Any NavigationRoute] {
    navigationEnsure()
    let state = nativeRecover<NavigationPathState>(ambientStateGet(StateSlot.navigationPath))
    return copy state.values
}

// The path, replaced as it is: nothing moves.
public function navigationStore(values: [Any NavigationRoute]) {
    navigationEnsure()
    var state = nativeRecover<NavigationPathState>(ambientStateGet(StateSlot.navigationPath))
    state.values = move values
}

// The path changed to `values`. Nothing moves yet: the change is settled
// with every other change the same action made, when the next frame begins.
public function navigationChange(values: [Any NavigationRoute]) {
    navigationEnsure()
    var state = nativeRecover<NavigationPathState>(ambientStateGet(StateSlot.navigationPath))
    if !state.unsettled {
        state.settled = copy state.values
        state.unsettled = true
    }
    state.values = move values
}

// The changes made to the path since it was last settled, landed as one, the
// way they leave it against the way they found it. A path that starts
// somewhere else is replaced outright, as choosing a sidebar's row replaces
// it: a new run of views, simply there, and whatever was moving stops. One
// that grew pushes its new view in over the old; one that shrank takes the
// old view off the one under it.
public function navigationSettle() {
    navigationEnsure()
    var state = nativeRecover<NavigationPathState>(ambientStateGet(StateSlot.navigationPath))
    if !state.unsettled {
        return
    }
    state.unsettled = false
    let before = copy state.settled
    let after = copy state.values
    // A path that starts elsewhere replaces what was showing. Stacked, though,
    // the sidebar is the root, and a path that empties is going back to it --
    // and one that fills from empty is going on from it.
    let fromSidebar = navigationRootDepth() == 0 && (before.count == 0 || after.count == 0)
    if fromSidebar && before.count == 0 && after.count > 0 {
        state.detailRun++
    }
    if !navigationSameRoot(before, after) && !fromSidebar {
        navigationTransitionCancel()
        state.generation++
        menuDismissAll()
    } else if after.count < before.count {
        navigationTransitionPop(move before, move after)
    } else if after.count > before.count || !navigationSamePath(before, after) {
        navigationTransitionPush(move before, move after)
    }
}

// Whether two paths run through the same values.
public function navigationSamePath(
    a: borrow [Any NavigationRoute],
    b: borrow [Any NavigationRoute]
) -> Bool {
    if a.count != b.count {
        return false
    }
    for index in 0..a.count {
        if a[index].routeKey() != b[index].routeKey() {
            return false
        }
    }
    return true
}

// Whether two paths start at the same value, two empty ones included.
public function navigationSameRoot(
    a: borrow [Any NavigationRoute],
    b: borrow [Any NavigationRoute]
) -> Bool {
    if a.count == 0 || b.count == 0 {
        return a.count == b.count
    }
    return a[0].routeKey() == b[0].routeKey()
}

public function navigationDetailRun() -> Number {
    navigationEnsure()
    let state = nativeRecover<NavigationPathState>(ambientStateGet(StateSlot.navigationPath))
    return state.detailRun
}

public function currentNavigationGeneration() -> Number {
    navigationEnsure()
    let state = nativeRecover<NavigationPathState>(ambientStateGet(StateSlot.navigationPath))
    return state.generation
}

// A value pushed.
public function navigationPush(value: Any NavigationRoute) {
    var next = navigationValues()
    next.append(move value)
    navigationChange(move next)
}

// The last value popped.
public function navigationPop() {
    let current = navigationValues()
    if current.count == 0 {
        return
    }
    var next: [Any NavigationRoute] = []
    for index in 0..current.count - 1 {
        next.append(copy current[index])
    }
    navigationChange(move next)
}

public function navigationClear() {
    var empty: [Any NavigationRoute] = []
    navigationChange(move empty)
}

public function navigationPath() -> NavigationPath {
    return NavigationPath {}
}

// --- Ambient container environment -----------------------------------------

public struct NavigationEnvironment {
    var split: Bool = false
    // What the view a stack is showing asked its column to be painted with, as
    // SwiftUI's `containerBackground(_:for: .navigation)` asks. A grouped list
    // asks for its grouped canvas, so the column under the bar is the list's
    // gray rather than a band of the window's own.
    var hasBackground: Bool = false
    var background: RGBAColor = RGBAColor {}
}

public function navigationEnvironment() -> NavigationEnvironment {
    if !ambientStateHas(StateSlot.navigationEnvironment) {
        ambientStatePut(
            StateSlot.navigationEnvironment,
            nativeUserData(nativeState(NavigationEnvironment {}))
        )
    }
    return nativeRecover<NavigationEnvironment>(ambientStateGet(StateSlot.navigationEnvironment))
}

public function navigationEnter(split: Bool) -> NavigationEnvironment {
    let previous = navigationEnvironment()
    var current = nativeRecover<NavigationEnvironment>(
        ambientStateGet(StateSlot.navigationEnvironment)
    )
    current.split = split
    return previous
}

public function navigationSetBackground(color: RGBAColor) {
    navigationEnvironment()
    var current = nativeRecover<NavigationEnvironment>(
        ambientStateGet(StateSlot.navigationEnvironment)
    )
    current.hasBackground = true
    current.background = move color
}

public function navigationClearBackground() {
    navigationEnvironment()
    var current = nativeRecover<NavigationEnvironment>(
        ambientStateGet(StateSlot.navigationEnvironment)
    )
    current.hasBackground = false
}

// The column's canvas: what the view in it asked for, or the window's own.
public function navigationColumnCanvas(modifiers: borrow ModifierContext) -> FoundationColor {
    let environment = navigationEnvironment()
    if environment.hasBackground {
        return foundationColor(environment.background)
    }
    return navigationCanvas(modifiers)
}

public function navigationLeave(previous: borrow NavigationEnvironment) {
    var current = nativeRecover<NavigationEnvironment>(
        ambientStateGet(StateSlot.navigationEnvironment)
    )
    current.split = previous.split
}

// --- Links and destinations -------------------------------------------------

public function navigationPushAction(value: Any NavigationRoute) -> () -> Void {
    // A mutable capture lets the value survive in the action. The value
    // itself is the route; there is no numeric route discriminator.
    var targetValue = move value
    let action: () -> Void = { in
        navigationPush(copy targetValue)
        return
    }
    return action
}

// What choosing a sidebar's row does: the path becomes that value alone, so
// the detail shows it and nothing pushed under the row chosen before.
public function navigationSelectAction(value: Any NavigationRoute) -> () -> Void {
    var targetValue = move value
    let action: () -> Void = { in
        var chosen: [Any NavigationRoute] = []
        chosen.append(copy targetValue)
        navigationChange(move chosen)
        return
    }
    return action
}

public function navigationPopAction() -> () -> Void {
    let action: () -> Void = { in
        navigationBack()
        return
    }
    return action
}
