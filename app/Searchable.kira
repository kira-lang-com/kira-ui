import Foundation
import Ember
import KCoreAnimation

public namespace SearchField {
    // The window has one search field, so its key is one constant, clear of the
    // bands minted and hero keys are drawn from (600000 up) and of the band below
    // them applications decode: a field keeps its focus and its text from frame to
    // frame by its key, and a minted one moves whenever what is built before it
    // does.
    let key: Number = 500000
}

// SwiftUI's `.searchable(text:prompt:)`: the window's search field, which
// iPadOS sets at the trailing end of the toolbar over the view that asks
// for it.
//
//     @State var query: String = ""
//
//     body {
//         ProjectList(query = query)
//             .searchable(text = query, onChange = { text in
//                 query = text
//                 return
//             })
//     }
//
// SwiftUI takes the text as a binding. A binding is two things -- the value
// the field shows and what to do when the field changes it -- and here they
// are the two arguments: the field shows `text`, and hands every edit to
// `onChange`. Setting the state to something else, an empty string to clear
// the search, puts that in the field.
public construct SearchableLayer(
    text: String,
    onChange: (String) -> Void,
    prompt: String
) extends Widget {
    let content: some Widget

    // The field is described by the bar; the view under it is described here.
    // The bar is collected after the whole tree, so the field is asked for
    // once the content -- which may hold the split view collecting it -- has
    // lowered.
    function describe(
        context: borrow BuildContext,
        modifiers: borrow ModifierContext
    ) -> CALayerDescription {
        let described = content.describe(context, modifiers)
        let key = SearchField.key
        textFieldFollow(key, text)
        // Return submits nothing: the search is already the text.
        layerTextInputRegister(
            key,
            textFieldTypeFn(key, onChange),
            textFieldCommandFn(key, onChange, layerNoop)
        )
        layerActionRegister(key, searchFieldPressFn(key, modifiers))
        let clearKey = tapSeqKey()
        layerActionRegister(clearKey, searchFieldClearFn(key, onChange))
        toolbarSetSearch(copy prompt, clearKey)
        return described
    }
}

extend Widget {
    // The window's search field, matching SwiftUI's `.searchable(text:prompt:)`.
    function searchable(
        text: String,
        onChange: (String) -> Void,
        prompt: String = "Search"
    ) -> Any Widget {
        return SearchableLayer(text: text, onChange: onChange, prompt: prompt) {
            self
        }
    }
}

// A press puts the caret where it landed, past the magnifier.
public function searchFieldPressFn(key: Number, modifiers: borrow ModifierContext) -> () -> Void {
    let metrics = windowChromeMetrics()
    return textFieldPressFn(
        key,
        modifierTextSize(modifiers),
        textFieldWeight(modifiers),
        metrics.searchLeading + metrics.symbolSize + metrics.searchSpacing
    )
}

public function searchFieldClearFn(key: Number, onChange: (String) -> Void) -> () -> Void {
    let k = key
    let change = onChange
    let f: () -> Void = { in
        textFieldReset(k)
        textFieldSeed(k, "")
        change("")
        return
    }
    return f
}
