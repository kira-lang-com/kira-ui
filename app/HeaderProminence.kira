import Foundation
import KCoreAnimation

// SwiftUI's two cases for the inherited prominence of Section headers.
// Increased prominence resolves a headline from the current theme and control
// size; standard retains the host's platform list-section font catalog.
public enum Prominence {
    Standard
    Increased
}

public function resolvedSectionHeaderFont(
    modifiers: borrow ModifierContext
) -> FontImplementation {
    return modifiers.headerProminence == .Increased
        ? typographyImplementation(.headline, modifiers)
        : listMetrics().headerFont
}

extend Widget {
    // SwiftUI: `.headerProminence(_ prominence: Prominence)`.
    function headerProminence(prominence: Prominence) -> Any Widget {
        return ModifierDeltaLayer(
            delta: modifierDeltaHeaderProminence(prominence)
        ) { self }
    }
}