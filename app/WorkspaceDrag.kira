import Foundation
import KiraLayout
import KCoreAnimation

// Dragging in a workspace: a tab carried to another edge, and a divider moved
// along the edge it bounds.
//
// Both are read off the press the window is holding, as a scroll view's bar is
// scrubbed: while a tab or a divider is held, every build sees the pointer
// where it is now and the workspace follows it; the first build after it is let
// go settles what the drag did. A tab is detached only by a vertical pull;
// horizontal movement belongs to its lifted tab-bar selection lens. Once
// either gesture wins the press, it keeps the press until release. A divider
// follows the pointer as before.

public enum WorkspaceDragKind {
    None
    Tab
    Divider
}

public enum WorkspaceTabGesture {
    Pending
    Lens
    Detach
}

// The drag under way: what is held and under which key, the panel a tab
// carries or the edge a divider bounds, where the press went down and where
// the pointer is now -- both in the workspace's own box -- the extent the
// divider started from, whether the drag has begun to move, and the edge a
// carried tab is over, -1 for none.
public struct WorkspaceDrag {
    var kind: WorkspaceDragKind = .None
    var key: Number = 0
    var press: Number = 0
    var panel: String = ""
    var edge: PanelEdge = .Leading
    var origin: Point = Point {}
    var pointer: Point = Point {}
    var startExtent: Number = 0.0
    var moving: Bool = false
    var target: Number = -1
    var tabGesture: WorkspaceTabGesture = .Pending
}

// --- Keys --------------------------------------------------------------------

// A workspace's controls answer under keys of their own, read back by what
// they are: a divider by its edge, a tab and its cross by their panel's place
// among the declarations. The band sits clear of the search field's key and
// below the minted ones, so neither can alias a workspace's.
public function workspaceDividerKey(edge: borrow PanelEdge) -> Number {
    return 509990 + panelEdgeIndex(edge)
}

public function workspaceTabKey(index: Number) -> Number {
    return 510000 + index * 2
}

public function workspaceCloseKey(index: Number) -> Number {
    return 510001 + index * 2
}

// Workspace tabs are each a label plus a full-sized X. While a press is
// sliding, the X belongs to that tab's *selection* region, never to its close
// action. An X closes only when the physical pointer-down began on that same
// X. Keep this mapping specific to an actual Workspace tab on the same edge:
// ordinary menu buttons and independently clicked X controls are unchanged.
public function workspaceSliderLandingKey(original: Number, hit: Number) -> Number {
    if original < workspaceTabKey(0) || original >= workspaceStripGlassKey(.Leading) {
        return hit
    }
    let originalIndex = trunc((original - workspaceTabKey(0)) / 2)
    if original != workspaceTabKey(originalIndex) { return hit }
    let state = workspaceState()
    // Once the press has become a vertical dock drag, releasing it must not
    // also select a tab, even if it happens to cross back over the strip.
    if state.drag.kind == .Tab && state.drag.tabGesture == .Detach { return 0 }
    if hit < workspaceCloseKey(0) || hit >= workspaceStripGlassKey(.Leading) {
        return hit
    }
    let targetIndex = trunc((hit - workspaceCloseKey(0)) / 2)
    if hit != workspaceCloseKey(targetIndex) { return hit }
    if originalIndex >= state.declared.count || targetIndex >= state.declared.count {
        return hit
    }
    let from = workspacePlacementIndex(state, state.declared[originalIndex])
    let to = workspacePlacementIndex(state, state.declared[targetIndex])
    if from < 0 || to < 0 { return hit }
    if !state.placements[from].shown || !state.placements[to].shown {
        return hit
    }
    if state.placements[from].edge != state.placements[to].edge { return hit }
    return workspaceTabKey(targetIndex)
}

// Every edge keeps the same glass/lens identity across builds and selection.
// A dynamically minted tap key would reuse an unrelated lens's spring state
// when panel contents changed the build traversal order.
public function workspaceStripGlassKey(edge: borrow PanelEdge) -> Number {
    return 510500 + panelEdgeIndex(edge)
}

public function panelEdgeAt(index: Number) -> PanelEdge {
    match index {
        0 -> return .Leading
        1 -> return .Trailing
        2 -> return .Bottom
        else -> return .Center
    }
}

// --- Following the press -----------------------------------------------------

// Follow the press the window holds. `origin` is where the workspace's box
// stands in the window and `size` how large it is.
public function workspaceDragAdvance(
    context: borrow BuildContext,
    origin: borrow Point,
    size: borrow Size
) {
    unsafe {
        workspaceArrangementEnsure()
        var state = nativeRecover<WorkspaceArrangement>(ambientStateGet(StateSlot.workspaceArrangement))
        let held = context.heldControl
        let pointer = Point { x: context.pointerX - origin.x, y: context.pointerY - origin.y }
        if state.drag.key != 0 && !workspaceDragPressHeld(state.drag, context.heldStartedControl) {
            // Let go: a tab carried over another edge docks its panel there.
            let carried = copy state.drag.panel
            let target = state.drag.kind == .Tab && state.drag.moving ? state.drag.target : -1
            state.drag = WorkspaceDrag {}
            if target >= 0 {
                workspaceDock(move carried, panelEdgeAt(target))
            }
            return
        }
        if state.drag.key == 0 {
            workspaceDragBegin(state, held, pointer)
            if state.drag.key != 0 {
                state.drag.press = context.heldPress
            }
            return
        }
        state.drag.pointer = copy pointer
        if state.drag.kind == .Divider {
            let travel = max(abs(pointer.x - state.drag.origin.x), abs(pointer.y - state.drag.origin.y))
            if travel > MotionPreset.dragSlop { state.drag.moving = true }
            if !state.drag.moving { return }
            workspaceDividerFollow(state, pointer, size)
            return
        }
        state.drag.tabGesture = workspaceTabGestureAdvance(
            state.drag.tabGesture, state.drag.origin, pointer
        )
        // The same press cannot scrub the lens and carry a panel. In
        // particular, a horizontal swipe must not become a dock drag if
        // the pointer later drifts outside the toolbar vertically.
        if state.drag.tabGesture != .Detach { return }
        state.drag.moving = true
        state.drag.target = workspaceDropTarget(state, size, pointer)
    }
}

// A press's physical down target stays fixed until release. The surface press
// serial DOES NOT: moving between another glass card rehomes its interactive
// press and increments the serial, which used to settle/drop the panel before
// the target dock was reached. Keep dragging until the physical mouse-up.
public function workspaceDragPressHeld(
    drag: borrow WorkspaceDrag,
    physicalDown: Number
) -> Bool {
    return physicalDown != 0 && drag.key == physicalDown
}

// A lifted tab lens slides along the strip. Detaching its panel is a separate
// up/down pull that starts before the pointer has scrubbed horizontally more
// than the normal drag slop. If both distances cross the threshold in one
// frame, the horizontal lens wins; the gesture is locked for this press.
public function workspaceTabGestureAdvance(
    gesture: WorkspaceTabGesture,
    origin: borrow Point,
    pointer: borrow Point
) -> WorkspaceTabGesture {
    if gesture != .Pending { return gesture }
    if abs(pointer.x - origin.x) > MotionPreset.dragSlop { return .Lens }
    if abs(pointer.y - origin.y) > MotionPreset.dragSlop { return .Detach }
    return .Pending
}

// A press just landed on a divider or a tab: the drag starts from here. A tab
// declared at the center is the center, and is not carried anywhere.
public function workspaceDragBegin(
    state: borrow mut WorkspaceArrangement,
    held: Number,
    pointer: borrow Point
) {
    if held >= workspaceDividerKey(.Leading) && held <= workspaceDividerKey(.Bottom) {
        let edge = panelEdgeAt(held - workspaceDividerKey(.Leading))
        state.drag = WorkspaceDrag {
            kind: .Divider,
            key: held,
            edge: copy edge,
            origin: copy pointer,
            pointer: copy pointer,
            startExtent: workspaceExtent(state, edge)
        }
        return
    }
    if held < workspaceTabKey(0) {
        return
    }
    let index = trunc((held - workspaceTabKey(0)) / 2)
    if held != workspaceTabKey(index) || index >= state.declared.count {
        return
    }
    let panel = copy state.declared[index]
    let placement = workspacePlacementIndex(state, panel)
    if placement < 0 || state.placements[placement].pinned {
        return
    }
    state.drag = WorkspaceDrag {
        kind: .Tab,
        key: held,
        panel: move panel,
        origin: copy pointer,
        pointer: copy pointer
    }
}

// A divider follows the pointer, as far as the edge's least and no further
// than half the workspace. Dragged under half its least, the edge folds away;
// brought back out, it opens again under the pointer.
public function workspaceDividerFollow(
    state: borrow mut WorkspaceArrangement,
    pointer: borrow Point,
    size: borrow Size
) {
    let edge = copy state.drag.edge
    var reach = state.drag.startExtent
    var most = size.width * 0.5
    match edge {
        Leading -> reach = reach + pointer.x - state.drag.origin.x
        Trailing -> reach = reach - pointer.x + state.drag.origin.x
        Bottom, Center -> {
            reach = reach - pointer.y + state.drag.origin.y
            most = size.height * 0.7
        }
    }
    let least = workspaceMinimumExtent(edge)
    let index = panelEdgeIndex(edge)
    state.edges[index].folded = reach < least * 0.5
    if !state.edges[index].folded {
        state.edges[index].extent = min(max(reach, least), max(most, least))
    }
}

// The edge a carried tab would dock its panel at, -1 for none. Each side
// reaches as far as its card when it is up, and a strip half its least wide
// when it is not; the foot reaches up as far as its card or that strip; the
// rest is the center, when it takes panels. The edge the panel already stands
// at is no target: it is where the panel goes back to.
public function workspaceDropTarget(
    state: borrow WorkspaceArrangement,
    size: borrow Size,
    pointer: borrow Point
) -> Number {
    if pointer.x < 0.0 || pointer.y < 0.0 || pointer.x > size.width || pointer.y > size.height {
        return -1
    }
    let metrics = workspaceMetrics()
    let geometry = workspaceGeometry(state, size, -1)
    var edge = -1
    let leadingReach = workspaceEdgeVisible(
        state,
        .Leading
    ) ? geometry.leading.x + geometry.leading.width : metrics.minimumWidth * 0.5
    let trailingReach = workspaceEdgeVisible(
        state,
        .Trailing
    ) ? geometry.trailing.x : size.width - metrics.minimumWidth * 0.5
    let bottomReach = workspaceEdgeVisible(
        state,
        .Bottom
    ) ? geometry.bottom.y : size.height - metrics.minimumHeight * 0.5
    if pointer.x < leadingReach {
        edge = panelEdgeIndex(.Leading)
    } else if pointer.x > trailingReach {
        edge = panelEdgeIndex(.Trailing)
    } else if pointer.y > bottomReach {
        edge = panelEdgeIndex(.Bottom)
    } else if state.center == .AcceptsPanels {
        edge = panelEdgeIndex(.Center)
    }
    let placement = workspacePlacementIndex(state, state.drag.panel)
    if placement >= 0 && edge == panelEdgeIndex(state.placements[placement].edge) {
        return -1
    }
    return edge
}

// --- What a drag shows -------------------------------------------------------

// The band a divider is grabbed by, down the middle of the gap it runs along
// and wider than it. The pointer resting on it lights it; while it is held, a
// hairline in the accent runs down its middle.
public function workspaceDivider(
    edge: borrow PanelEdge,
    geometry: borrow WorkspaceGeometry,
    state: borrow WorkspaceArrangement,
    modifiers: borrow ModifierContext,
) -> CALayerDescription {
    let metrics = workspaceMetrics()
    let thickness = metrics.dividerThickness
    let across = metrics.gap / 2.0 + thickness / 2.0
    let band = match edge {
        Leading -> Rect {
            x: geometry.leading.x + geometry.leading.width + metrics.gap / 2.0 - thickness / 2.0,
            y: geometry.leading.y,
            width: thickness,
            height: geometry.leading.height
        }
        Trailing -> Rect {
            x: geometry.trailing.x - across,
            y: geometry.trailing.y,
            width: thickness,
            height: geometry.trailing.height
        }
        Bottom, Center -> Rect {
            x: geometry.bottom.x,
            y: geometry.bottom.y - across,
            width: geometry.bottom.width,
            height: thickness
        }
    }
    let key = workspaceDividerKey(edge)
    let held = state.drag.kind == .Divider && state.drag.key == key
    let accent = colorFromFoundation(
        modifierColor(foundationColor(modifierTokens(modifiers).tint.accent), modifiers)
    )
    let vertical = edge != .Bottom
    var divider = CALayerDescription {
        key: 20 + panelEdgeIndex(edge),
        hittable: !modifiers.disabled,
        hitKey: key,
        hoverColor: hoverHighlight(modifiers),
        cornerRadius: thickness / 2.0,
        content: .Solid(CASolid { fill: CAColor { a: 0.0 }, cornerRadius: thickness / 2.0 }),
        layout: CALayoutIntent { alignment: Point { x: 0.5, y: 0.5 } },
        sublayers: [CALayerDescription {
            opacity: held ? 1.0 : 0.0,
            backgroundColor: accent,
            cornerRadius: 1.0,
            layout: CALayoutIntent {
                widthFill: !vertical,
                heightFill: vertical,
                fixedWidth: vertical ? 2.0 : -1.0,
                fixedHeight: vertical ? -1.0 : 2.0
            }
        }]
    }
    workspacePlace(divider, band)
    return divider
}

// Where a carried tab's panel would land: the card it would join, washed in
// the accent and ringed with it.
public function workspaceDropZone(
    rect: borrow Rect,
    modifiers: borrow ModifierContext
) -> CALayerDescription {
    var accent = colorFromFoundation(
        modifierColor(foundationColor(modifierTokens(modifiers).tint.accent), modifiers)
    )
    let ring = copy accent
    accent.a = accent.a * 0.14
    let radius = workspacePanelRadius()
    var zone = CALayerDescription {
        key: 30,
        cornerRadius: radius,
        content: .Solid(
            CASolid { fill: accent, border: ring, borderWidth: 2.0, cornerRadius: radius }
        ),
        entrance: CAEntrance { active: true, opacity: 0.0 },
        removal: CARemoval { opacity: 0.0, duration: 0.2 }
    }
    workspacePlace(zone, rect)
    return zone
}

// The tab under the pointer while it is carried: a regular pill, no longer
// the strip's selected Liquid Glass lens. It follows the pointer until it is
// docked, and selection belongs only to the strip it has left.
public function workspaceDragGhost(
    declaration: borrow PanelDeclaration,
    pointer: borrow Point,
    context: borrow BuildContext,
    modifiers: borrow ModifierContext,
) -> CALayerDescription {
    // A detached panel is a plain glass pill. A TabBar capsule would also
    // create an independent selection lens, even though no tab in it is
    // selected. Give it the window toolbar's ordinary glass group instead.
    var ghost = toolbarGlassGroup(
        [workspaceTabFace(declaration, false, context, modifiers)],
        windowChromeMetrics(),
        context,
        modifiers
    )
    let measured = ghost.measure(context.viewportWidth)
    ghost.key = 31
    ghost.animation = .Timed(CATiming { disableActions: true })
    ghost.layout.offset = Point {
        x: pointer.x - measured.width / 2.0,
        y: pointer.y - measured.height / 2.0
    }
    ghost.removal = CARemoval { opacity: 0.0, duration: 0.15 }
    // The carried surface is a preview, not a second toolbar taking input.
    ghost.makeInert()
    return ghost
}
