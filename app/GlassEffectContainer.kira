import Foundation
import KCoreAnimation

// SwiftUI's `GlassEffectContainer(spacing:)`: the glass pieces in its content
// rendered together, sampling what is behind them as one region. Pieces more
// than `spacing` apart stay apart, as SwiftUI's do; pieces nearer than that
// are not yet drawn fused into one.
//
//     GlassEffectContainer(spacing: 16.0) {
//         HStack {
//             Icon(symbol: .Airplane).glassEffect()
//             Icon(symbol: .Wifi).glassEffect()
//         }
//     }
public construct GlassEffectContainer(spacing: Number = 0.0) extends Widget {
    let content: some Widget

    function describe(
        context: borrow BuildContext,
        modifiers: borrow ModifierContext
    ) -> CALayerDescription {
        return content.describe(context, modifiers)
    }
}
