import Foundation
import KCoreAnimation

// SwiftUI Font.Width's four named widths and an explicit relative width.
// This is a FONT DESIGN AXIS, not a compressed view transform. It changes the
// glyph outlines and the advances of faces that provide OpenType's `wdth`
// axis, and keeps a font's natural width if no such axis exists.
public enum FontWidth {
    Compressed
    Condensed
    Standard
    Expanded
    Relative(Number)
}

public function fontWidthRatio(width: FontWidth?) -> Number {
    return match width {
        None -> 1.0
        Some(choice) -> match choice {
            Compressed -> 0.70
            Condensed -> 0.85
            Standard -> 1.0
            Expanded -> 1.20
            Relative(ratio) -> clamp(ratio, 0.5, 1.5)
        }
    }
}

public function modifierDeltaFontWidth(width: FontWidth?) -> ModifierDelta {
    return ModifierDelta {
        hasFontWidth: true,
        fontWidth: move width
    }
}

extend Widget {
    // SwiftUI: `.fontWidth(_ width: Font.Width?)`.
    function fontWidth(width: FontWidth?) -> Any Widget {
        return ModifierDeltaLayer(delta: modifierDeltaFontWidth(move width)) { self }
    }

    // KiraUI convenience; the optional overload above is the full reset
    // contract, while this spelling also accepts `.Condensed` directly.
    function fontWidth(width: FontWidth) -> Any Widget {
        return ModifierDeltaLayer(
            delta: modifierDeltaFontWidth(.Some(move width))
        ) { self }
    }
}