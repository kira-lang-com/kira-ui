import Foundation
import KCoreAnimation

// SwiftUI allows a text run to slightly reduce its spacing when the original
// glyphs almost fit in a line-limited width. The lower bound and actual
// glyph positions are resolved by the shared KCoreAnimation text engine.
public function modifierDeltaAllowsTightening(enabled: Bool) -> ModifierDelta {
    return ModifierDelta { hasAllowsTightening: true, allowsTightening: enabled }
}

extend Widget {
    // SwiftUI: `.allowsTightening(_ flag: Bool)`.
    function allowsTightening(enabled: Bool) -> Any Widget {
        return ModifierDeltaLayer(delta: modifierDeltaAllowsTightening(enabled)) { self }
    }
}