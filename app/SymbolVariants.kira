import Foundation

// Each symbol's filled drawing, for `.symbolVariant(.Fill)`. Generated by
// tools/cupertino/generate.py from the set's own names. Do not edit.
//
// A symbol the set draws only outlined answers itself, as SF Symbols does for
// a symbol with no fill: the variant is a preference, not a requirement.

function symbolFilled(symbol: borrow Symbol) -> Symbol {
    match symbol {
        None -> return .None
        Add -> return .Add
        AddCircled -> return .AddCircled
        AddCircledSolid -> return .AddCircledSolid
        Airplane -> return .Airplane
        Alarm -> return .AlarmFill
        AlarmFill -> return .AlarmFill
        Alt -> return .Alt
        Ant -> return .AntFill
        AntCircle -> return .AntCircleFill
        AntCircleFill -> return .AntCircleFill
        AntFill -> return .AntFill
