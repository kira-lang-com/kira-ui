import KiraLayout
import KiraGraphics
import Foundation
import KiraUIFoundation

@Derive(Copy)
struct Color {
    let r: Float = 0.0
    let g: Float = 0.0
    let b: Float = 0.0
    let a: Float = 1.0
}

// Design tools quote colors in 8-bit sRGB channels, so authoring a token set
// means writing that conversion somewhere. It belongs here once rather than in
// every application's theme file.

function colorRgb(r: Float, g: Float, b: Float) -> Color {
    return Color {
        r: r / 255.0
        g: g / 255.0
        b: b / 255.0
        a: 1.0
    }
}

function colorRgba(r: Float, g: Float, b: Float, a: Float) -> Color {
    return Color {
        r: r / 255.0
        g: g / 255.0
        b: b / 255.0
        a: a
    }
}

// The same color at a different alpha — a derived token (a tinted selection
// band, a faded wash) stated as the relationship it actually is.
function colorWithAlpha(color: borrow Color, alpha: Float) -> Color {
    return Color {
        r: color.r
        g: color.g
        b: color.b
        a: alpha
    }
}

// The palette, as free functions.
//
// Kira has no static members, and a block-bodied `let Name: Color { … }` member
// is a construct-backed surface a plain `struct` does not have — so `Color.Green`
// is not spellable. A zero-argument function is the form the language offers,
// and it reads the same at the call site: `colorGreen()`.

function colorGreen() -> Color {
    return Color {
        r: 0.34
        g: 0.85
        b: 0.52
        a: 1.0
    }
}

function colorYellow() -> Color {
    return Color {
        r: 0.98
        g: 0.80
        b: 0.36
        a: 1.0
    }
}

function colorBlue() -> Color {
    return Color {
        r: 0.43
        g: 0.67
        b: 1.0
        a: 1.0
    }
}

function colorPurple() -> Color {
    return Color {
        r: 0.65
        g: 0.40
        b: 0.95
        a: 1.0
    }
}

function colorCyan() -> Color {
    return Color {
        r: 0.25
        g: 0.78
        b: 0.82
        a: 1.0
    }
}

function colorWhite() -> Color {
    return Color {
        r: 1.0
        g: 1.0
        b: 1.0
        a: 1.0
    }
}

function colorBeige() -> Color {
    return Color {
        r: 0.96
        g: 0.95
        b: 0.93
        a: 1.0
    }
}

function colorBeigeDark() -> Color {
    return Color {
        r: 0.93
        g: 0.91
        b: 0.88
        a: 1.0
    }
}

function colorTaupe() -> Color {
    return Color {
        r: 0.61
        g: 0.53
        b: 0.48
        a: 1.0
    }
}

function colorBorderSoft() -> Color {
    return Color {
        r: 0.91
        g: 0.89
        b: 0.85
        a: 1.0
    }
}

function colorDarkText() -> Color {
    return Color {
        r: 0.11
        g: 0.11
        b: 0.12
        a: 1.0
    }
}

function colorSecondaryText() -> Color {
    return Color {
        r: 0.56
        g: 0.56
        b: 0.58
        a: 1.0
    }
}

function colorMutedText() -> Color {
    return Color {
        r: 0.69
        g: 0.68
        b: 0.66
        a: 1.0
    }
}

function colorMutedGreen() -> Color {
    return Color {
        r: 0.45
        g: 0.68
        b: 0.50
        a: 1.0
    }
}

function colorMutedBlue() -> Color {
    return Color {
        r: 0.45
        g: 0.58
        b: 0.72
        a: 1.0
    }
}

function colorMutedOrange() -> Color {
    return Color {
        r: 0.76
        g: 0.58
        b: 0.40
        a: 1.0
    }
}

enum Material {
    Flat
    Frosted
    LayeredGlass
}

enum SurfaceShape {
    RegularRoundedRect
    Squircle
}

enum ContentMargins {
    automatic: Float = 0.0
    fixed: Float
}

enum FontWeight {
    Regular
    SemiBold
    Bold
}

struct KiraUIApp {
    let name: String
    let content: Any Widget
}

construct Widget {
    @Required let body: Any Widget

    // Consuming: lowering a widget consumes the node (Rust `self` receiver).
    // Wrapper widgets expand `body` (which consumes self and partial-moves the
    // content channels out); leaf widgets drain their children arrays element
    // by element. The whole tree is single-owner and freed exactly once.
    @Consuming
    function lower(context: borrow KiraUIFoundation.FoundationUiContext, modifiers: borrow ModifierContext) -> KiraUIFoundation.FoundationView {
        return body.lower(context, modifiers)
    }
}

function surfaceMaterialSubtle() -> SurfaceTint {
    return SurfaceTint(
        color: Color {
            r: 0.16
            g: 0.19
            b: 0.26
            a: 0.88
        }
    )
}

function transparentFoundationColor() -> KiraUIFoundation.Color {
    return KiraUIFoundation.Color {
        r: 0.0
        g: 0.0
        b: 0.0
        a: 0.0
    }
}

// The tokens in effect for this widget: the theme in effect resolves them, and
// the library's own theme is in effect when the application applied none.
function modifierTokens(modifiers: borrow ModifierContext) -> ThemeTokens {
    return modifierTheme(modifiers).tokens()
}

function primaryColorAsColor(color: borrow PrimaryColor, tokens: borrow ThemeTokens) -> Color {
    match color {
        Primary -> return tokens.foreground.primary;
        Secondary -> return tokens.foreground.secondary;
        Tertiary -> return tokens.foreground.tertiary;
        Quaternary -> return tokens.foreground.quaternary;
        Inverse -> return tokens.foreground.inverse;
        Success -> return tokens.tint.success;
        Warning -> return tokens.tint.warning;
        Danger -> return tokens.tint.danger;
        Accent -> return tokens.tint.accent;
        Red -> return tokens.palette.red;
        Orange -> return tokens.palette.orange;
        Yellow -> return tokens.palette.yellow;
        Green -> return tokens.palette.green;
        Mint -> return tokens.palette.mint;
        Teal -> return tokens.palette.teal;
        Cyan -> return tokens.palette.cyan;
        Blue -> return tokens.palette.blue;
        Indigo -> return tokens.palette.indigo;
        Purple -> return tokens.palette.purple;
        Pink -> return tokens.palette.pink;
        Brown -> return tokens.palette.brown;
        Gray -> return tokens.palette.gray;
        Black -> return Color { r: 0.0, g: 0.0, b: 0.0, a: 1.0 };
        White -> return Color { r: 1.0, g: 1.0, b: 1.0, a: 1.0 };
        Clear -> return Color { r: 0.0, g: 0.0, b: 0.0, a: 0.0 };
    }
}

function modifierPrimaryColor(
    color: PrimaryColor,
    modifiers: borrow ModifierContext,
) -> KiraUIFoundation.Color {
    let tokens = modifierTokens(modifiers)
    return foundationColor(primaryColorAsColor(color, tokens))
}

function modifierTextColor(modifiers: borrow ModifierContext) -> KiraUIFoundation.Color {
    if modifiers.hasTextColor {
        return foundationColor(modifiers.textColor)
    }
    if modifiers.hasForegroundColor {
        return modifierPrimaryColor(modifiers.foregroundColor, modifiers)
    }
    // The primary ink of the tokens IN EFFECT — the applied theme's, or the
    // default style's when none was applied. A separate hardcoded ink for the
    // unthemed case is how an application with no theme drew near-white text on
    // the default style's light surface.
    return foundationColor(modifierTokens(modifiers).foreground.primary)
}

function modifierBackgroundStyle(
    style: borrow BackgroundStyle,
    modifiers: borrow ModifierContext,
) -> KiraUIFoundation.Color {
    let tokens = modifierTokens(modifiers)
    match style {
        Clear -> return transparentFoundationColor();
        Window -> return foundationColor(tokens.background.canvas);
        Surface -> return foundationColor(tokens.background.surface);
        Raised -> return foundationColor(tokens.background.raised);
        Control -> return foundationColor(tokens.fill.control);
        Overlay -> return foundationColor(tokens.background.overlay);
        Accent -> return foundationColor(tokens.tint.accent);
        Selection -> return foundationColor(tokens.fill.selection);
        Hover -> return foundationColor(tokens.fill.hover);
    }
}

function modifierSurfaceBorder(
    fallback: KiraUIFoundation.Color,
    modifiers: borrow ModifierContext,
) -> KiraUIFoundation.Color {
    if modifiers.hasThemeBorder {
        let tokens = modifierTokens(modifiers)
        match modifiers.themeBorder {
            Subtle -> return modifierColor(foundationColor(tokens.border.subtle.color), modifiers);
            Standard -> return modifierColor(foundationColor(tokens.border.standard.color), modifiers);
            Strong -> return modifierColor(foundationColor(tokens.border.strong.color), modifiers);
            Focus -> return modifierColor(foundationColor(tokens.border.focus.color), modifiers);
        }
    }
    return colorWithOpacity(fallback, modifiers.opacity)
}

function modifierSurfaceFill(
    fallback: KiraUIFoundation.Color,
    modifiers: borrow ModifierContext,
) -> KiraUIFoundation.Color {
    if modifiers.hasFill {
        return modifierColor(foundationColor(modifiers.fillColor), modifiers)
    }
    if modifiers.hasBackgroundStyle {
        return modifierColor(modifierBackgroundStyle(modifiers.backgroundStyle, modifiers), modifiers)
    }
    return colorWithOpacity(fallback, modifiers.opacity)
}

// What the window itself is painted in: the canvas of the theme in effect.
function modifierCanvas(modifiers: borrow ModifierContext) -> KiraUIFoundation.Color {
    return modifierColor(foundationColor(modifierTokens(modifiers).background.canvas), modifiers)
}

function foundationColor(color: Color) -> KiraUIFoundation.Color {
    return KiraUIFoundation.Color {
        r: color.r
        g: color.g
        b: color.b
        a: color.a
    }
}

function foundationFontWeight(weight: borrow FontWeight) -> Float {
    match weight {
        Regular -> return 400.0;
        SemiBold -> return 600.0;
        Bold -> return 700.0;
    }
}

function foundationMaterial(material: borrow Material) -> KiraUIFoundation.FoundationMaterial {
    match material {
        Flat -> return KiraUIFoundation.FoundationMaterial.Flat;
        Frosted -> return KiraUIFoundation.FoundationMaterial.Frosted;
        LayeredGlass -> return KiraUIFoundation.FoundationMaterial.LiquidGlass;
    }
}

function foundationShape(shape: SurfaceShape) -> KiraUIFoundation.FoundationShape {
    match shape {
        RegularRoundedRect -> return KiraUIFoundation.FoundationShape.RegularRoundedRect;
        Squircle -> return KiraUIFoundation.FoundationShape.Squircle;
    }
}

function uniformInsets(length: Float) -> KiraUIFoundation.EdgeInsets {
    return KiraUIFoundation.EdgeInsets {
        top: length
        trailing: length
        bottom: length
        leading: length
    }
}

function contentMarginsInset(margins: ContentMargins) -> Float {
    match margins {
        automatic(extra) -> {
            var inset = extra
            if inset < 0.0 {
                inset = 0.0
            }
            return inset
        }
        fixed(length) -> {
            if length < 0.0 {
                return 0.0
            }
            return length
        }
    }
}

function cardFill(material: borrow Material) -> KiraUIFoundation.Color {
    match material {
        Flat -> return KiraUIFoundation.Color {
            r: 1.0
            g: 1.0
            b: 1.0
            a: 1.0
        };
        Frosted -> return KiraUIFoundation.Color {
            r: 1.0
            g: 1.0
            b: 1.0
            a: 0.14
        };
        LayeredGlass -> return KiraUIFoundation.Color {
            r: 0.86
            g: 0.93
            b: 1.0
            a: 0.18
        };
    }
}

function cardBorder(material: borrow Material) -> KiraUIFoundation.Color {
    match material {
        Flat -> return KiraUIFoundation.Color {
            r: 0.91
            g: 0.89
            b: 0.85
            a: 1.0
        };
        Frosted -> return KiraUIFoundation.Color {
            r: 1.0
            g: 1.0
            b: 1.0
            a: 0.10
        };
        LayeredGlass -> return KiraUIFoundation.Color {
            r: 1.0
            g: 1.0
            b: 1.0
            a: 0.20
        };
    }
}

function cardEffects(material: borrow Material) -> [KiraUIFoundation.FoundationEffect] {
    match material {
        Flat -> return [];
        Frosted -> return [];
        LayeredGlass -> return [
            KiraUIFoundation.FoundationEffect.LayerGlow(KiraUIFoundation.Glow {
                color: KiraUIFoundation.Color {
                    r: 0.34
                    g: 0.56
                    b: 1.0
                    a: 1.0
                }
                radius: 18.0
                intensity: 0.16
            })
        ];
    }
}

function loweredChildren(
    context: borrow KiraUIFoundation.FoundationUiContext,
    modifiers: borrow ModifierContext,
    widgets: [Any Widget],
) -> [KiraUIFoundation.FoundationView] {
    var children: [KiraUIFoundation.FoundationView] = []
    let childModifiers = modifierContextForChildren(modifiers)
    var index = 0
    while index < widgets.count {
        children.append(widgets[index].lower(context, childModifiers))
        index = index + 1
    }
    return children
}

function overlayView(
    background: KiraUIFoundation.FoundationView,
    foreground: KiraUIFoundation.FoundationView,
) -> KiraUIFoundation.FoundationView {
    let stretchedBackground = KiraUIFoundation.FoundationView {
        kind: KiraUIFoundation.FoundationViewKind.Frame
        width: KiraUIFoundation.SizeMode.Fill
        height: KiraUIFoundation.SizeMode.Fill
        alignment: KiraUIFoundation.Alignment.Center
        padding: KiraUIFoundation.EdgeInsets {}
        children: [background]
    }

    return KiraUIFoundation.FoundationView {
        kind: KiraUIFoundation.FoundationViewKind.Frame
        width: foreground.width
        height: foreground.height
        flex: foreground.flex
        alignment: KiraUIFoundation.Alignment.Center
        padding: KiraUIFoundation.EdgeInsets {}
        children: [stretchedBackground, foreground]
    }
}

function lerp(a: Float, b: Float, t: Float) -> Float {
    return a + (b - a) * t
}

function lerpColor(start: borrow Color, end: borrow Color, t: Float) -> Color {
    return Color {
        r: lerp(start.r, end.r, t)
        g: lerp(start.g, end.g, t)
        b: lerp(start.b, end.b, t)
        a: lerp(start.a, end.a, t)
    }
}

function colorWithOpacity(color: borrow KiraUIFoundation.Color, opacity: Float) -> KiraUIFoundation.Color {
    return KiraUIFoundation.Color {
        r: color.r
        g: color.g
        b: color.b
        a: color.a * opacity
    }
}

function effectWithOpacity(effect: borrow KiraUIFoundation.FoundationEffect, opacity: Float) -> KiraUIFoundation.FoundationEffect {
    match effect {
        BackdropGlow(glow) -> {
            return KiraUIFoundation.FoundationEffect.BackdropGlow(KiraUIFoundation.Glow {
                color: colorWithOpacity(glow.color, opacity)
                radius: glow.radius
                intensity: glow.intensity
            })
        }

        LayerGlow(glow) -> {
            return KiraUIFoundation.FoundationEffect.LayerGlow(KiraUIFoundation.Glow {
                color: colorWithOpacity(glow.color, opacity)
                radius: glow.radius
                intensity: glow.intensity
            })
        }
    }
}

// Structural modifiers rebuild one FoundationView node to change its layout or
// surface shape. Their children are transferred unchanged; semantic modifiers
// are consumed before lowering and never walk a completed descendant tree.

function identityChildren(children: [KiraUIFoundation.FoundationView]) -> [KiraUIFoundation.FoundationView] {
    return children
}

function identityEffects(effects: [KiraUIFoundation.FoundationEffect]) -> [KiraUIFoundation.FoundationEffect] {
    return effects
}

function identityGuides(
    guides: [KiraUIFoundation.FoundationGuidePublication],
) -> [KiraUIFoundation.FoundationGuidePublication] {
    return guides
}

// The same view, answering one more guide, and the same view reading two.
//
// Every `viewWith…` helper below rebuilds the view field by field, so anything a
// modifier attached earlier has to be carried through each of them or it is
// dropped without a word. That is why the guide fields are restated in all of
// them rather than left to a default.
function viewWithGuides(
    view: KiraUIFoundation.FoundationView,
    guides: [KiraUIFoundation.FoundationGuidePublication],
) -> KiraUIFoundation.FoundationView {
    return viewWithGuideFields(move view, move guides, -1, -1)
}

// The same view, taking its painted extent from a pair of guides.
function viewWithGuideRange(
    view: KiraUIFoundation.FoundationView,
    leading: Int,
    trailing: Int,
) -> KiraUIFoundation.FoundationView {
    let carried = identityGuides(view.guides)
    return viewWithGuideFields(move view, move carried, leading, trailing)
}

// One rebuild for both guide edits. `leading`/`trailing` of -1 keep what the
// view already had, so publishing a guide never clears the ones it reads.
function viewWithGuideFields(
    view: KiraUIFoundation.FoundationView,
    guides: [KiraUIFoundation.FoundationGuidePublication],
    leading: Int,
    trailing: Int,
) -> KiraUIFoundation.FoundationView {
    var readsLeading = view.guideLeading
    var readsTrailing = view.guideTrailing
    if leading >= 0 {
        readsLeading = leading
    }
    if trailing >= 0 {
        readsTrailing = trailing
    }
    return KiraUIFoundation.FoundationView {
        kind: view.kind
        key: view.key
        guides: move guides
        guideLeading: readsLeading
        guideTrailing: readsTrailing
        children: identityChildren(view.children)
        width: view.width
        height: view.height
        flex: view.flex
        gap: view.gap
        padding: view.padding
        crossAxisAlignment: view.crossAxisAlignment
        alignment: view.alignment
        fill: view.fill
        border: view.border
        borderWidth: view.borderWidth
        radius: view.radius
        shape: view.shape
        material: view.material
        effects: identityEffects(view.effects)
        clipContent: view.clipContent
        content: view.content
        color: view.color
        size: view.size
        inkLeft: view.inkLeft
        inkRight: view.inkRight
        inkTop: view.inkTop
        inkBottom: view.inkBottom
        lineHeight: view.lineHeight
        weight: view.weight
        disabled: view.disabled
        focusable: view.focusable
        autofocus: view.autofocus
        onPress: view.onPress
        onTextInput: view.onTextInput
        onTextCodepoint: view.onTextCodepoint
        onBackspace: view.onBackspace
        onSubmit: view.onSubmit
        onKey: view.onKey
        onScroll: view.onScroll
        minLength: view.minLength
        interaction: view.interaction
        texture: view.texture
        textureOpacity: view.textureOpacity
    }
}

function modifierColor(
    color: KiraUIFoundation.Color,
    modifiers: borrow ModifierContext,
) -> KiraUIFoundation.Color {
    return colorWithOpacity(color, modifiers.opacity)
}

function modifierEffects(
    effects: [KiraUIFoundation.FoundationEffect],
    modifiers: borrow ModifierContext,
) -> [KiraUIFoundation.FoundationEffect] {
    if modifiers.opacity == 1.0 {
        return effects
    }
    var adjusted: [KiraUIFoundation.FoundationEffect] = []
    var index = 0
    while index < effects.count {
        adjusted.append(effectWithOpacity(effects[index], modifiers.opacity))
        index = index + 1
    }
    return adjusted
}

function viewWithSurfaceRadius(view: KiraUIFoundation.FoundationView, radius: Float) -> KiraUIFoundation.FoundationView {
    return KiraUIFoundation.FoundationView {
        kind: view.kind
        key: view.key
        guides: identityGuides(view.guides)
        guideLeading: view.guideLeading
        guideTrailing: view.guideTrailing
        children: identityChildren(view.children)
        width: view.width
        height: view.height
        flex: view.flex
        gap: view.gap
        padding: view.padding
        crossAxisAlignment: view.crossAxisAlignment
        alignment: view.alignment
        fill: view.fill
        border: view.border
        borderWidth: view.borderWidth
        radius: radius
        shape: view.shape
        material: view.material
        effects: identityEffects(view.effects)
        clipContent: view.clipContent
        content: view.content
        color: view.color
        size: view.size
        inkLeft: view.inkLeft
        inkRight: view.inkRight
        inkTop: view.inkTop
        inkBottom: view.inkBottom
        lineHeight: view.lineHeight
        weight: view.weight
        disabled: view.disabled
        focusable: view.focusable
        autofocus: view.autofocus
        onPress: view.onPress
        onTextInput: view.onTextInput
        onTextCodepoint: view.onTextCodepoint
        onBackspace: view.onBackspace
        onSubmit: view.onSubmit
        onKey: view.onKey
        onScroll: view.onScroll
        minLength: view.minLength
        interaction: view.interaction
        texture: view.texture
        textureOpacity: view.textureOpacity
    }
}

function viewWithSurfaceShape(view: KiraUIFoundation.FoundationView, shape: SurfaceShape) -> KiraUIFoundation.FoundationView {
    return KiraUIFoundation.FoundationView {
        kind: view.kind
        key: view.key
        guides: identityGuides(view.guides)
        guideLeading: view.guideLeading
        guideTrailing: view.guideTrailing
        children: identityChildren(view.children)
        width: view.width
        height: view.height
        flex: view.flex
        gap: view.gap
        padding: view.padding
        crossAxisAlignment: view.crossAxisAlignment
        alignment: view.alignment
        fill: view.fill
        border: view.border
        borderWidth: view.borderWidth
        radius: view.radius
        shape: foundationShape(move shape)
        material: view.material
        effects: identityEffects(view.effects)
        clipContent: view.clipContent
        content: view.content
        color: view.color
        size: view.size
        inkLeft: view.inkLeft
        inkRight: view.inkRight
        inkTop: view.inkTop
        inkBottom: view.inkBottom
        lineHeight: view.lineHeight
        weight: view.weight
        disabled: view.disabled
        focusable: view.focusable
        autofocus: view.autofocus
        onPress: view.onPress
        onTextInput: view.onTextInput
        onTextCodepoint: view.onTextCodepoint
        onBackspace: view.onBackspace
        onSubmit: view.onSubmit
        onKey: view.onKey
        onScroll: view.onScroll
        minLength: view.minLength
        interaction: view.interaction
        texture: view.texture
        textureOpacity: view.textureOpacity
    }
}

function viewWithSurfaceBorder(view: KiraUIFoundation.FoundationView, color: KiraUIFoundation.Color, width: Float) -> KiraUIFoundation.FoundationView {
    return KiraUIFoundation.FoundationView {
        kind: view.kind
        key: view.key
        guides: identityGuides(view.guides)
        guideLeading: view.guideLeading
        guideTrailing: view.guideTrailing
        children: identityChildren(view.children)
        width: view.width
        height: view.height
        flex: view.flex
        gap: view.gap
        padding: view.padding
        crossAxisAlignment: view.crossAxisAlignment
        alignment: view.alignment
        fill: view.fill
        border: color
        borderWidth: width
        radius: view.radius
        shape: view.shape
        material: view.material
        effects: identityEffects(view.effects)
        clipContent: view.clipContent
        content: view.content
        color: view.color
        size: view.size
        inkLeft: view.inkLeft
        inkRight: view.inkRight
        inkTop: view.inkTop
        inkBottom: view.inkBottom
        lineHeight: view.lineHeight
        weight: view.weight
        disabled: view.disabled
        focusable: view.focusable
        autofocus: view.autofocus
        onPress: view.onPress
        onTextInput: view.onTextInput
        onTextCodepoint: view.onTextCodepoint
        onBackspace: view.onBackspace
        onSubmit: view.onSubmit
        onKey: view.onKey
        onScroll: view.onScroll
        minLength: view.minLength
        interaction: view.interaction
        texture: view.texture
        textureOpacity: view.textureOpacity
    }
}

function viewWithWidth(view: KiraUIFoundation.FoundationView, width: KiraUIFoundation.SizeMode) -> KiraUIFoundation.FoundationView {
    return KiraUIFoundation.FoundationView {
        kind: view.kind
        key: view.key
        guides: identityGuides(view.guides)
        guideLeading: view.guideLeading
        guideTrailing: view.guideTrailing
        children: identityChildren(view.children)
        width: width
        height: view.height
        flex: view.flex
        gap: view.gap
        padding: view.padding
        crossAxisAlignment: view.crossAxisAlignment
        alignment: view.alignment
        fill: view.fill
        border: view.border
        borderWidth: view.borderWidth
        radius: view.radius
        shape: view.shape
        material: view.material
        effects: identityEffects(view.effects)
        clipContent: view.clipContent
        content: view.content
        color: view.color
        size: view.size
        inkLeft: view.inkLeft
        inkRight: view.inkRight
        inkTop: view.inkTop
        inkBottom: view.inkBottom
        lineHeight: view.lineHeight
        weight: view.weight
        disabled: view.disabled
        focusable: view.focusable
        autofocus: view.autofocus
        onPress: view.onPress
        onTextInput: view.onTextInput
        onTextCodepoint: view.onTextCodepoint
        onBackspace: view.onBackspace
        onSubmit: view.onSubmit
        onKey: view.onKey
        onScroll: view.onScroll
        minLength: view.minLength
        interaction: view.interaction
        texture: view.texture
        textureOpacity: view.textureOpacity
    }
}

