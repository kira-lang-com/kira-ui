Widget BlurBehindLayer(radius: Float, saturation: Float) {
    let content: some Widget

    function lower(context: borrow KiraUIFoundation.FoundationUiContext, modifiers: borrow ModifierContext) -> KiraUIFoundation.FoundationView {
        let ignored = saturation + intAsFloat(value: context.frameCount)
        let childModifiers = modifierContextForChildren(modifiers)
        return Surface(
            children: [content.lower(context, childModifiers)],
            width: KiraUIFoundation.SizeMode.Fill,
            height: KiraUIFoundation.SizeMode.Hug,
            flex: 0,
            fill: modifierSurfaceFill(transparentFoundationColor(), modifiers),
            border: transparentFoundationColor(),
            borderWidth: 0.0,
            radius: radius,
            shape: KiraUIFoundation.FoundationShape.RegularRoundedRect,
            material: KiraUIFoundation.FoundationMaterial.LiquidGlass,
            effects: modifierEffects([
                KiraUIFoundation.FoundationEffect.BackdropGlow(KiraUIFoundation.Glow {
                    color: KiraUIFoundation.Color {
                        r: 1.0
                        g: 1.0
                        b: 1.0
                        a: 0.08
                    }
                    radius: radius
                    intensity: 0.08
                })
            ], modifiers),
            padding: KiraUIFoundation.EdgeInsets {},
            clipContent: false
        )
    }
}

