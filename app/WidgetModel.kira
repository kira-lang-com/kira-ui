// `.backgroundColor(...)` paints a hug-sized wash behind exactly the widget it
// wraps — it never becomes the subtree's surface role, mirroring how a
// background sits behind one view and not its descendants.
Widget BackgroundColorLayer(color: PrimaryColor) {
    let content: some Widget

    function lower(context: borrow KiraUIFoundation.FoundationUiContext, modifiers: borrow ModifierContext) -> KiraUIFoundation.FoundationView {
        let resolved = modifierColor(modifierPrimaryColor(color, modifiers), modifiers)
        let childModifiers = modifierContextForChildren(modifiers)
        return KiraUIFoundation.FoundationView {
            kind: KiraUIFoundation.FoundationViewKind.Surface
            width: KiraUIFoundation.SizeMode.Hug
            height: KiraUIFoundation.SizeMode.Hug
            fill: move resolved
            padding: KiraUIFoundation.EdgeInsets {}
            children: [content.lower(context, childModifiers)]
        }
    }
}

