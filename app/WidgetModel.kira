import KiraLayout
import KiraGraphics
import Foundation
import KiraUIFoundation

@Derive(Copy)
struct Color {
    let r: Float = 0.0
    let g: Float = 0.0
    let b: Float = 0.0
    let a: Float = 1.0
}

// Design tools quote colors in 8-bit sRGB channels, so authoring a token set
// means writing that conversion somewhere. It belongs here once rather than in
// every application's theme file.

function colorRgb(r: Float, g: Float, b: Float) -> Color {
    return Color {
        r: r / 255.0
        g: g / 255.0
        b: b / 255.0
        a: 1.0
    }
}

function colorRgba(r: Float, g: Float, b: Float, a: Float) -> Color {
    return Color {
        r: r / 255.0
        g: g / 255.0
        b: b / 255.0
        a: a
    }
}

// The same color at a different alpha — a derived token (a tinted selection
// band, a faded wash) stated as the relationship it actually is.
function colorWithAlpha(color: borrow Color, alpha: Float) -> Color {
    return Color {
        r: color.r
        g: color.g
        b: color.b
        a: alpha
    }
}

// The palette, as free functions.
//
// Kira has no static members, and a block-bodied `let Name: Color { … }` member
// is a construct-backed surface a plain `struct` does not have — so `Color.Green`
// is not spellable. A zero-argument function is the form the language offers,
// and it reads the same at the call site: `colorGreen()`.

function colorGreen() -> Color {
    return Color {
        r: 0.34
        g: 0.85
        b: 0.52
        a: 1.0
    }
}

function colorYellow() -> Color {
    return Color {
        r: 0.98
        g: 0.80
        b: 0.36
        a: 1.0
    }
}

function colorBlue() -> Color {
    return Color {
        r: 0.43
        g: 0.67
        b: 1.0
        a: 1.0
    }
}

function colorPurple() -> Color {
    return Color {
        r: 0.65
        g: 0.40
        b: 0.95
        a: 1.0
    }
}

function colorCyan() -> Color {
    return Color {
        r: 0.25
        g: 0.78
        b: 0.82
        a: 1.0
    }
}

function colorWhite() -> Color {
    return Color {
        r: 1.0
        g: 1.0
        b: 1.0
        a: 1.0
    }
}

function colorBeige() -> Color {
    return Color {
        r: 0.96
        g: 0.95
        b: 0.93
        a: 1.0
    }
}

function colorBeigeDark() -> Color {
    return Color {
        r: 0.93
        g: 0.91
        b: 0.88
        a: 1.0
    }
}

function colorTaupe() -> Color {
    return Color {
        r: 0.61
        g: 0.53
        b: 0.48
        a: 1.0
    }
}

function colorBorderSoft() -> Color {
    return Color {
        r: 0.91
        g: 0.89
        b: 0.85
        a: 1.0
    }
}

function colorDarkText() -> Color {
    return Color {
        r: 0.11
        g: 0.11
        b: 0.12
        a: 1.0
    }
}

function colorSecondaryText() -> Color {
    return Color {
        r: 0.56
        g: 0.56
        b: 0.58
        a: 1.0
    }
}

function colorMutedText() -> Color {
    return Color {
        r: 0.69
        g: 0.68
        b: 0.66
        a: 1.0
    }
}

function colorMutedGreen() -> Color {
    return Color {
        r: 0.45
        g: 0.68
        b: 0.50
        a: 1.0
    }
}

function colorMutedBlue() -> Color {
    return Color {
        r: 0.45
        g: 0.58
        b: 0.72
        a: 1.0
    }
}

function colorMutedOrange() -> Color {
    return Color {
        r: 0.76
        g: 0.58
        b: 0.40
        a: 1.0
    }
}

enum Material {
    Flat
    Frosted
    LayeredGlass
    // What is behind the WINDOW, blurred and tinted by the desktop compositor:
    // the material a platform sidebar is made of.
    //
    // Frosted and LayeredGlass blur what the application drew underneath them.
    // This one does not blur anything the application can see — the surface
    // becomes a hole in the window and the compositor fills it with everything
    // under the window, which is the only place that view exists. It needs a
    // transparent window (RunWidgetInteractiveApp(transparent: true)); in an
    // ordinary one there is no hole to fill and it draws flat.
    WindowBackdrop
}

enum SurfaceShape {
    RegularRoundedRect
    Squircle
}

enum ContentMargins {
    automatic: Float = 0.0
    fixed: Float
}

enum FontWeight {
    Regular
    SemiBold
    Bold
}

struct KiraUIApp {
    let name: String
    let content: Any Widget
}

construct Widget {
    @Required let body: Any Widget

    // Consuming: lowering a widget consumes the node (Rust `self` receiver).
    // Wrapper widgets expand `body` (which consumes self and partial-moves the
    // content channels out); leaf widgets drain their children arrays element
    // by element. The whole tree is single-owner and freed exactly once.
    @Consuming
    function lower(context: borrow FoundationUiContext, modifiers: borrow ModifierContext) -> FoundationView {
        return body.lower(context, modifiers)
    }
}

function surfaceMaterialSubtle() -> SurfaceTint {
    return SurfaceTint(
        color: Color {
            r: 0.16
            g: 0.19
            b: 0.26
            a: 0.88
        }
    )
}

function transparentFoundationColor() -> FoundationColor {
    return foundationRgba(0.0, 0.0, 0.0, 0.0)
}

// The tokens in effect for this widget: the theme in effect resolves them, and
// the library's own theme is in effect when the application applied none.
function modifierTokens(modifiers: borrow ModifierContext) -> ThemeTokens {
    return modifierTheme(modifiers).tokens()
}

function primaryColorAsColor(color: borrow PrimaryColor, tokens: borrow ThemeTokens) -> Color {
    match color {
        Primary -> return tokens.foreground.primary;
        Secondary -> return tokens.foreground.secondary;
        Tertiary -> return tokens.foreground.tertiary;
        Quaternary -> return tokens.foreground.quaternary;
        Inverse -> return tokens.foreground.inverse;
        Success -> return tokens.tint.success;
        Warning -> return tokens.tint.warning;
        Danger -> return tokens.tint.danger;
        Accent -> return tokens.tint.accent;
        Red -> return tokens.palette.red;
        Orange -> return tokens.palette.orange;
        Yellow -> return tokens.palette.yellow;
        Green -> return tokens.palette.green;
        Mint -> return tokens.palette.mint;
        Teal -> return tokens.palette.teal;
        Cyan -> return tokens.palette.cyan;
        Blue -> return tokens.palette.blue;
        Indigo -> return tokens.palette.indigo;
        Purple -> return tokens.palette.purple;
        Pink -> return tokens.palette.pink;
        Brown -> return tokens.palette.brown;
        Gray -> return tokens.palette.gray;
        Black -> return Color { r: 0.0, g: 0.0, b: 0.0, a: 1.0 };
        White -> return Color { r: 1.0, g: 1.0, b: 1.0, a: 1.0 };
        Clear -> return Color { r: 0.0, g: 0.0, b: 0.0, a: 0.0 };
    }
}

function modifierPrimaryColor(
    color: PrimaryColor,
    modifiers: borrow ModifierContext,
) -> FoundationColor {
    let tokens = modifierTokens(modifiers)
    return foundationColor(primaryColorAsColor(color, tokens))
}

function modifierTextColor(modifiers: borrow ModifierContext) -> FoundationColor {
    if modifiers.hasTextColor {
        return foundationColor(modifiers.textColor)
    }
    if modifiers.hasForegroundColor {
        return modifierPrimaryColor(modifiers.foregroundColor, modifiers)
    }
    // The primary ink of the tokens IN EFFECT — the applied theme's, or the
    // default style's when none was applied. A separate hardcoded ink for the
    // unthemed case is how an application with no theme drew near-white text on
    // the default style's light surface.
    return foundationColor(modifierTokens(modifiers).foreground.primary)
}

function modifierBackgroundStyle(
    style: borrow BackgroundStyle,
    modifiers: borrow ModifierContext,
) -> FoundationColor {
    let tokens = modifierTokens(modifiers)
    match style {
        Clear -> return transparentFoundationColor();
        Window -> return foundationColor(tokens.background.canvas);
        Surface -> return foundationColor(tokens.background.surface);
        Raised -> return foundationColor(tokens.background.raised);
        Control -> return foundationColor(tokens.fill.control);
        Overlay -> return foundationColor(tokens.background.overlay);
        Accent -> return foundationColor(tokens.tint.accent);
        Selection -> return foundationColor(tokens.fill.selection);
        Hover -> return foundationColor(tokens.fill.hover);
    }
}

function modifierSurfaceBorder(
    fallback: FoundationColor,
    modifiers: borrow ModifierContext,
) -> FoundationColor {
    if modifiers.hasThemeBorder {
        let tokens = modifierTokens(modifiers)
        match modifiers.themeBorder {
            Subtle -> return modifierColor(foundationColor(tokens.border.subtle.color), modifiers);
            Standard -> return modifierColor(foundationColor(tokens.border.standard.color), modifiers);
            Strong -> return modifierColor(foundationColor(tokens.border.strong.color), modifiers);
            Focus -> return modifierColor(foundationColor(tokens.border.focus.color), modifiers);
        }
    }
    return colorWithOpacity(fallback, modifiers.opacity)
}

function modifierSurfaceFill(
    fallback: FoundationColor,
    modifiers: borrow ModifierContext,
) -> FoundationColor {
    if modifiers.hasFill {
        return modifierColor(foundationColor(modifiers.fillColor), modifiers)
    }
    if modifiers.hasBackgroundStyle {
        return modifierColor(modifierBackgroundStyle(modifiers.backgroundStyle, modifiers), modifiers)
    }
    return colorWithOpacity(fallback, modifiers.opacity)
}

// What the window itself is painted in: the canvas of the theme in effect.
function modifierCanvas(modifiers: borrow ModifierContext) -> FoundationColor {
    return modifierColor(foundationColor(modifierTokens(modifiers).background.canvas), modifiers)
}

function foundationColor(color: Color) -> FoundationColor {
    return foundationRgba(color.r, color.g, color.b, color.a)
}

function foundationFontWeight(weight: borrow FontWeight) -> Float {
    match weight {
        Regular -> return 400.0;
        SemiBold -> return 600.0;
        Bold -> return 700.0;
    }
}

function foundationMaterial(material: borrow Material) -> FoundationMaterial {
    match material {
        Flat -> return .Flat;
        Frosted -> return .Frosted;
        LayeredGlass -> return .LiquidGlass;
        WindowBackdrop -> return .WindowBackdrop;
    }
}

function foundationShape(shape: SurfaceShape) -> FoundationShape {
    match shape {
        RegularRoundedRect -> return .RegularRoundedRect;
        Squircle -> return .Squircle;
    }
}

function uniformInsets(length: Float) -> EdgeInsets {
    return EdgeInsets {
        top: length
        trailing: length
        bottom: length
        leading: length
    }
}

function contentMarginsInset(margins: ContentMargins) -> Float {
    match margins {
        automatic(extra) -> {
            var inset = extra
            if inset < 0.0 {
                inset = 0.0
            }
            return inset
        }
        fixed(length) -> {
            if length < 0.0 {
                return 0.0
            }
            return length
        }
    }
}

function cardFill(material: borrow Material) -> FoundationColor {
    match material {
        Flat -> return foundationRgba(1.0, 1.0, 1.0, 1.0);
        Frosted -> return foundationRgba(1.0, 1.0, 1.0, 0.14);
        LayeredGlass -> return foundationRgba(0.86, 0.93, 1.0, 0.18);
        // The compositor fills it; the surface paints nothing of its own.
        WindowBackdrop -> return transparentFoundationColor();
    }
}

function cardBorder(material: borrow Material) -> FoundationColor {
    match material {
        Flat -> return foundationRgba(0.91, 0.89, 0.85, 1.0);
        Frosted -> return foundationRgba(1.0, 1.0, 1.0, 0.10);
        LayeredGlass -> return foundationRgba(1.0, 1.0, 1.0, 0.20);
        WindowBackdrop -> return transparentFoundationColor();
    }
}

function cardEffects(material: borrow Material) -> [FoundationEffect] {
    match material {
        Flat -> return [];
        Frosted -> return [];
        WindowBackdrop -> return [];
        LayeredGlass -> return [
            .LayerGlow(Glow {
                color: foundationRgba(0.34, 0.56, 1.0, 1.0)
                radius: 18.0
                intensity: 0.16
            })
        ];
    }
}

function loweredChildren(
    context: borrow FoundationUiContext,
    modifiers: borrow ModifierContext,
    widgets: [Any Widget],
) -> [FoundationView] {
    var children: [FoundationView] = []
    let childModifiers = modifierContextForChildren(modifiers)
    var index = 0
    while index < widgets.count {
        children.append(widgets[index].lower(context, childModifiers))
        index = index + 1
    }
    return children
}

function overlayView(
    background: FoundationView,
    foreground: FoundationView,
) -> FoundationView {
    let stretchedBackground = FoundationView {
        kind: .Frame
        width: .Fill
        height: .Fill
        alignment: .Center
        padding: EdgeInsets {}
        children: [background]
    }

    return FoundationView {
        kind: .Frame
        width: foreground.width
        height: foreground.height
        flex: foreground.flex
        alignment: .Center
        padding: EdgeInsets {}
        children: [stretchedBackground, foreground]
    }
}

function lerp(a: Float, b: Float, t: Float) -> Float {
    return a + (b - a) * t
}

function lerpColor(start: borrow Color, end: borrow Color, t: Float) -> Color {
    return Color {
        r: lerp(start.r, end.r, t)
        g: lerp(start.g, end.g, t)
        b: lerp(start.b, end.b, t)
        a: lerp(start.a, end.a, t)
    }
}

function colorWithOpacity(color: borrow FoundationColor, opacity: Float) -> FoundationColor {
    return foundationRgba(color.r, color.g, color.b, color.a * opacity)
}

function effectWithOpacity(effect: borrow FoundationEffect, opacity: Float) -> FoundationEffect {
    match effect {
        BackdropGlow(glow) -> {
            return .BackdropGlow(Glow {
                color: colorWithOpacity(glow.color, opacity)
                radius: glow.radius
                intensity: glow.intensity
            })
        }

        LayerGlow(glow) -> {
            return .LayerGlow(Glow {
                color: colorWithOpacity(glow.color, opacity)
                radius: glow.radius
                intensity: glow.intensity
            })
        }
    }
}

// Structural modifiers rebuild one FoundationView node to change its layout or
// surface shape. Their children are transferred unchanged; semantic modifiers
// are consumed before lowering and never walk a completed descendant tree.

function identityChildren(children: [FoundationView]) -> [FoundationView] {
    return children
}

function identityEffects(effects: [FoundationEffect]) -> [FoundationEffect] {
    return effects
}

function identityGuides(
    guides: [FoundationGuidePublication],
) -> [FoundationGuidePublication] {
    return guides
}

// The same view, answering one more guide, and the same view reading two.
//
// Every `viewWith…` helper below rebuilds the view field by field, so anything a
// modifier attached earlier has to be carried through each of them or it is
// dropped without a word. That is why the guide fields are restated in all of
// them rather than left to a default.
function viewWithGuides(
    view: FoundationView,
    guides: [FoundationGuidePublication],
) -> FoundationView {
    return viewWithGuideFields(move view, move guides, -1, -1)
}

// The same view, taking its painted extent from a pair of guides.
function viewWithGuideRange(
    view: FoundationView,
    leading: Int,
    trailing: Int,
) -> FoundationView {
    let carried = identityGuides(view.guides)
    return viewWithGuideFields(move view, move carried, leading, trailing)
}

// One rebuild for both guide edits. `leading`/`trailing` of -1 keep what the
// view already had, so publishing a guide never clears the ones it reads.
function viewWithGuideFields(
    view: FoundationView,
    guides: [FoundationGuidePublication],
    leading: Int,
    trailing: Int,
) -> FoundationView {
    var readsLeading = view.guideLeading
    var readsTrailing = view.guideTrailing
    if leading >= 0 {
        readsLeading = leading
    }
    if trailing >= 0 {
        readsTrailing = trailing
    }
    return FoundationView {
        kind: view.kind
        key: view.key
        guides: move guides
        guideLeading: readsLeading
        guideTrailing: readsTrailing
        children: identityChildren(view.children)
        width: view.width
        height: view.height
        flex: view.flex
        gap: view.gap
        padding: view.padding
        crossAxisAlignment: view.crossAxisAlignment
        alignment: view.alignment
        fill: view.fill
        border: view.border
        borderWidth: view.borderWidth
        radius: view.radius
        shape: view.shape
        material: view.material
        effects: identityEffects(view.effects)
        clipContent: view.clipContent
        content: view.content
        color: view.color
        size: view.size
        inkLeft: view.inkLeft
        inkRight: view.inkRight
        inkTop: view.inkTop
        inkBottom: view.inkBottom
        lineHeight: view.lineHeight
        weight: view.weight
        disabled: view.disabled
        focusable: view.focusable
        autofocus: view.autofocus
        onPress: view.onPress
        onTextInput: view.onTextInput
        onTextCodepoint: view.onTextCodepoint
        onBackspace: view.onBackspace
        onSubmit: view.onSubmit
        onKey: view.onKey
        onScroll: view.onScroll
        minLength: view.minLength
        interaction: view.interaction
        texture: view.texture
        textureOpacity: view.textureOpacity
    }
}

function modifierColor(
    color: FoundationColor,
    modifiers: borrow ModifierContext,
) -> FoundationColor {
    return colorWithOpacity(color, modifiers.opacity)
}

function modifierEffects(
    effects: [FoundationEffect],
    modifiers: borrow ModifierContext,
) -> [FoundationEffect] {
    if modifiers.opacity == 1.0 {
        return effects
    }
    var adjusted: [FoundationEffect] = []
    var index = 0
    while index < effects.count {
        adjusted.append(effectWithOpacity(effects[index], modifiers.opacity))
        index = index + 1
    }
    return adjusted
}

// A view with a handful of fields replaced, and every other field carried.
//
// ONE list of the fields, because seven of them was seven chances to forget.
// Each of the modifiers below used to rebuild the view field by field, and every
// field added to `FoundationView` after those were written was dropped by all of
// them -- silently, because a dropped field reads as its default rather than as
// an error.
//
// What that cost: a TextureView lost the texture it was crossfading TOWARDS the
// moment anything gave it a width, so a swipe between two components' sidebars
// ran the whole transition and showed nothing move. A gradient lost its end
// colour, glass lost its material and its blur, a scroll region lost the fact
// that it scrolls. All the same bug, and none of them visible in the modifier
// that caused it.
function viewCopying(
    view: borrow FoundationView,
    width: SizeMode,
    height: SizeMode,
    radius: Float,
    shape: FoundationShape,
    border: FoundationColor,
    borderWidth: Float,
    padding: EdgeInsets,
) -> FoundationView {
    return FoundationView {
        kind: view.kind
        key: view.key
        guides: identityGuides(view.guides)
        guideLeading: view.guideLeading
        guideTrailing: view.guideTrailing
        children: identityChildren(view.children)
        width: width
        height: height
        flex: view.flex
        gap: view.gap
        padding: padding
        crossAxisAlignment: view.crossAxisAlignment
        alignment: view.alignment
        fill: view.fill
        border: border
        borderWidth: borderWidth
        fillEnd: view.fillEnd
        gradient: view.gradient
        radius: radius
        backgroundFill: view.backgroundFill
        shape: shape
        material: view.material
        effects: identityEffects(view.effects)
        clipContent: view.clipContent
        content: view.content
        color: view.color
        size: view.size
        inkLeft: view.inkLeft
        inkRight: view.inkRight
        inkTop: view.inkTop
        inkBottom: view.inkBottom
        lineHeight: view.lineHeight
        weight: view.weight
        baseline: view.baseline
        iconWidth: view.iconWidth
        weightGrowth: view.weightGrowth
        disabled: view.disabled
        focusable: view.focusable
        autofocus: view.autofocus
        onPress: view.onPress
        onTextInput: view.onTextInput
        onTextCodepoint: view.onTextCodepoint
        onBackspace: view.onBackspace
        onSubmit: view.onSubmit
        onKey: view.onKey
        onScroll: view.onScroll
        scrolls: view.scrolls
        wheel: view.wheel
        minLength: view.minLength
        interaction: view.interaction
        texture: view.texture
        textureOpacity: view.textureOpacity
        secondaryTexture: view.secondaryTexture
        textureTransition: view.textureTransition
        adaptiveInk: view.adaptiveInk
        blur: view.blur
        glassMaterial: view.glassMaterial
        edgeRefraction: view.edgeRefraction
    }
}

function viewWithSurfaceRadius(view: FoundationView, radius: Float) -> FoundationView {
    return viewCopying(
        view,
        view.width,
        view.height,
        move radius,
        view.shape,
        view.border,
        view.borderWidth,
        view.padding
    )
}

function viewWithSurfaceShape(view: FoundationView, shape: SurfaceShape) -> FoundationView {
    return viewCopying(
        view,
        view.width,
        view.height,
        view.radius,
        foundationShape(move shape),
        view.border,
        view.borderWidth,
        view.padding
    )
}

function viewWithSurfaceBorder(view: FoundationView, color: FoundationColor, width: Float) -> FoundationView {
    return viewCopying(
        view,
        view.width,
        view.height,
        view.radius,
        view.shape,
        move color,
        move width,
        view.padding
    )
}

function viewWithWidth(view: FoundationView, width: SizeMode) -> FoundationView {
    return viewCopying(
        view,
        move width,
        view.height,
        view.radius,
        view.shape,
        view.border,
        view.borderWidth,
        view.padding
    )
}

function viewWithHeight(view: FoundationView, height: SizeMode) -> FoundationView {
    return viewCopying(
        view,
        view.width,
        move height,
        view.radius,
        view.shape,
        view.border,
        view.borderWidth,
        view.padding
    )
}

function viewWithSurfacePadding(view: FoundationView, length: Float) -> FoundationView {
    return viewCopying(
        view,
        view.width,
        view.height,
        view.radius,
        view.shape,
        view.border,
        view.borderWidth,
        uniformInsets(length)
    )
}

function viewWithContentMargins(view: FoundationView, inset: Float) -> FoundationView {
    let margins = EdgeInsets {
        top: view.padding.top + inset
        trailing: view.padding.trailing + inset
        bottom: view.padding.bottom + inset
        leading: view.padding.leading + inset
    }
    return viewCopying(
        view,
        view.width,
        view.height,
        view.radius,
        view.shape,
        view.border,
        view.borderWidth,
        move margins
    )
}

construct SurfacePaddingLayer(value: Float) extends Widget {
    let content: some Widget

    function lower(context: borrow FoundationUiContext, modifiers: borrow ModifierContext) -> FoundationView {
        let childModifiers = modifierContextForChildren(modifiers)
        return viewWithSurfacePadding(content.lower(context, childModifiers), value)
    }
}

construct ContentMarginsLayer(value: ContentMargins) extends Widget {
    let content: some Widget

    function lower(context: borrow FoundationUiContext, modifiers: borrow ModifierContext) -> FoundationView {
        let childModifiers = modifierContextForChildren(modifiers)
        let view = content.lower(context, childModifiers)
        let inset = contentMarginsInset(move value)
        return viewWithContentMargins(move view, inset)
    }
}

construct WidthLayer(value: Float) extends Widget {
    let content: some Widget

    function lower(context: borrow FoundationUiContext, modifiers: borrow ModifierContext) -> FoundationView {
        let childModifiers = modifierContextForChildren(modifiers)
        return viewWithWidth(content.lower(context, childModifiers), .Fixed(value))
    }
}

construct FillWidthLayer() extends Widget {
    let content: some Widget

    function lower(context: borrow FoundationUiContext, modifiers: borrow ModifierContext) -> FoundationView {
        let childModifiers = modifierContextForChildren(modifiers)
        return viewWithWidth(content.lower(context, childModifiers), .Fill)
    }
}

construct FillHeightLayer() extends Widget {
    let content: some Widget

    function lower(context: borrow FoundationUiContext, modifiers: borrow ModifierContext) -> FoundationView {
        let childModifiers = modifierContextForChildren(modifiers)
        return viewWithHeight(content.lower(context, childModifiers), .Fill)
    }
}

construct HeightLayer(value: Float) extends Widget {
    let content: some Widget

    function lower(context: borrow FoundationUiContext, modifiers: borrow ModifierContext) -> FoundationView {
        let childModifiers = modifierContextForChildren(modifiers)
        return viewWithHeight(content.lower(context, childModifiers), .Fixed(value))
    }
}

function scaledTypography(
    font: FontImplementation,
    modifiers: borrow ModifierContext,
) -> FontImplementation {
    let scale = resolvedControlMetrics(modifiers).typeScale
    return FontImplementation {
        size: font.size * scale
        weight: font.weight
        lineHeight: font.lineHeight * scale
        tracking: font.tracking
    }
}

// Fill and Fixed both had a modifier; Hug did not, so a widget that fills by
// default could never be told to shrink to its content without exposing its own
// SizeMode argument.
construct HugWidthLayer() extends Widget {
    let content: some Widget

    function lower(context: borrow FoundationUiContext, modifiers: borrow ModifierContext) -> FoundationView {
        let childModifiers = modifierContextForChildren(modifiers)
        return viewWithWidth(content.lower(context, childModifiers), .Hug)
    }
}

construct HugHeightLayer() extends Widget {
    let content: some Widget

    function lower(context: borrow FoundationUiContext, modifiers: borrow ModifierContext) -> FoundationView {
        let childModifiers = modifierContextForChildren(modifiers)
        return viewWithHeight(content.lower(context, childModifiers), .Hug)
    }
}

// A role's font, at the size the region around it is drawn in.
//
// The size class scales the WHOLE scale rather than each role separately, so the
// relationships a theme authored — a header quieter than a label, a title well
// above both — survive being drawn small. A per-role size per class would let
// those relationships drift apart between classes, which is the thing a type
// scale exists to prevent.
function typographyImplementation(
    style: TypographyStyle,
    modifiers: borrow ModifierContext,
) -> FontImplementation {
    return scaledTypography(modifierTheme(modifiers).typography(style), modifiers)
}

function cornerRadiusImplementation(
    style: CornerRadius,
    modifiers: borrow ModifierContext,
) -> Float {
    return modifierTheme(modifiers).cornerRadius(style)
}

function spacingImplementation(
    style: Spacing,
    modifiers: borrow ModifierContext,
) -> Float {
    return modifierTheme(modifiers).spacing(style)
}

construct Text(content: String) extends Widget {
    function lower(context: borrow FoundationUiContext, modifiers: borrow ModifierContext) -> FoundationView {
        let ignored = context.frameCount
        var textSize = 16.0
        var textLineHeight = 0.0
        var textWeight = 400.0
        if modifiers.hasFont {
            textSize = modifiers.fontSize
            textWeight = foundationFontWeight(modifiers.fontWeight)
        } else if modifiers.hasTypography {
            let selected = typographyImplementation(modifiers.typography, modifiers)
            textSize = selected.size
            textLineHeight = selected.lineHeight
            textWeight = foundationFontWeight(selected.weight)
        } else {
            // Through the same resolution every named role goes through, so an
            // unstyled run is scaled by the size class like everything else.
            // Reading `tokens.bodySize` directly is how a row label stayed at
            // full size inside a `.Small` panel while the header beside it
            // shrank.
            let selected = typographyImplementation(.body, modifiers)
            textSize = selected.size
            // Weight before metrics: a run's line height and ink are measured
            // from the weight it will be DRAWN in, so resolving the weight after
            // measuring hands layout the regular cut's numbers for a semibold
            // run.
            textWeight = foundationFontWeight(selected.weight)
            textLineHeight = foundationTextRunLineHeight(size: textSize, weight: textWeight)
        }
        return FoundationView {
            kind: .Text
            content: content
            color: modifierColor(modifierTextColor(modifiers), modifiers)
            size: textSize
            inkLeft: foundationTextRunInkLeft(content: content, size: textSize, weight: textWeight)
            inkRight: foundationTextRunInkRight(content: content, size: textSize, weight: textWeight)
            inkTop: foundationTextRunInkTop(content: content, size: textSize, weight: textWeight)
            inkBottom: foundationTextRunInkBottom(content: content, size: textSize, weight: textWeight)
            lineHeight: textLineHeight
            weight: textWeight
            disabled: modifiers.disabled
        }
    }
}

enum ButtonRole {
    Normal
    Destructive
}

// Button fills with the control token (or the danger tint for a destructive
// role); the cascading `.foregroundColor(...)` names the LABEL ink, exactly as
// it does on a bare Text. Its label is an implementation detail of the control,
// so it receives the presentation context explicitly rather than inheriting
// through the general child traversal.
// SwiftUI's button is a LABEL and an action, and the label is a view:
//
//     Button(action: copy) {
//         Label("Copy", systemImage: .DocOnDoc)
//     }
//
// with `Button("Copy", action: copy)` as the shorthand for the case where the
// label is only a run of text. Those are not two widgets — the second builds the
// first's label out of a `Text` and hands it straight over — so they are one
// name with two ways in, which is what an `init` on a construct-backed
// declaration is. A widget that only ever took a String could not put a glyph,
// a badge or a two-line label on a button at all.
construct Button(
    role: ButtonRole = .Normal,
    action: () -> Void,
) extends Widget {
    let label: some Widget

    init(title: String, action: () -> Void) {
        return Button(role: .Normal, action: action) {
            Text(content: title)
        }
    }

    init(title: String, role: ButtonRole, action: () -> Void) {
        return Button(role: role, action: action) {
            Text(content: title)
        }
    }

    function lower(context: borrow FoundationUiContext, modifiers: borrow ModifierContext) -> FoundationView {
        let k = kiraUiTapSeqKey()
        let press = action
        let tokens = modifierTokens(modifiers)
        var buttonFill = foundationColor(tokens.fill.control)
        match role {
            Normal -> {}
            Destructive -> {
                buttonFill = foundationColor(tokens.tint.danger)
            }
        }
        // A filled button's default label is whichever ink the FILL can be read
        // against: the inverse ink over a light fill, the ordinary ink over a
        // dark one. Naming one of them outright is how a label ends up dark grey
        // on a dark control — legible on the theme it was written against and
        // invisible on the next one. An explicit `.foregroundColor(...)` or
        // `.textColor(...)` on the button still wins.
        var labelModifiers = modifierContextForPresentation(modifiers)
        if modifiers.hasForegroundColor == false && modifiers.hasTextColor == false {
            var labelColor = tokens.foreground.inverse
            if colorIsDark(buttonFill) {
                labelColor = tokens.foreground.primary
            }
            let labelDelta = modifierDeltaTextColor(move labelColor)
            labelModifiers = modifierContextApply(labelModifiers, move labelDelta)
        }
        let labelView = label.lower(context, labelModifiers)
        return buttonView(context, modifiers, k, move press, move labelView, move buttonFill)
    }
}

// Whether a fill is dark enough that light ink reads on it. The usual weighted
// luminance, so a saturated accent answers the way the eye does rather than the
// way an average of three channels would.
function colorIsDark(fill: borrow FoundationColor) -> Bool {
    return (0.2126 * fill.r + 0.7152 * fill.g + 0.0722 * fill.b) < 0.5
}

// The pressable box a button is, around a label that has already been lowered:
// the ink the label is set in depends on the FILL, and the fill is the button's,
// so the caller resolves the two together and this takes the result.
function buttonBorderWidth(fill: borrow FoundationColor) -> Float {
    if fill.a <= 0.0 {
        return 0.0
    }
    return 1.0
}

function buttonView(
    context: borrow FoundationUiContext,
    modifiers: borrow ModifierContext,
    key: Int,
    press: () -> Void,
    labelView: FoundationView,
    fill: FoundationColor,
) -> FoundationView {
    let ignored = context.frameCount
    let resolvedFill = modifierSurfaceFill(move fill, modifiers)
    return FoundationView {
        kind: .HitArea
        key: key
        width: .Hug
        height: .Hug
        backgroundFill: resolvedFill
        border: modifierColor(foundationRgba(1.0, 1.0, 1.0, 0.16), modifiers)
        // A button with no fill has no edge to draw. The hairline is what gives
        // a filled control its lip; over nothing it is just a rectangle around a
        // word, which is what a toolbar item on shared glass came out as.
        borderWidth: buttonBorderWidth(resolvedFill)
        padding: EdgeInsets {
            top: 10.0
            trailing: 15.0
            bottom: 10.0
            leading: 15.0
        }
        radius: 10.0
        disabled: modifiers.disabled
        focusable: true
        autofocus: modifiers.hasFocused && modifiers.focused
        onPress: press
        children: [labelView]
    }
}

construct AppSurface() extends Widget {
    let content: some Widget

    function lower(context: borrow FoundationUiContext, modifiers: borrow ModifierContext) -> FoundationView {
        let childModifiers = modifierContextForChildren(modifiers)
        return Surface(
            children: [content.lower(context, childModifiers)],
            width: .Fill,
            height: .Fill,
            flex: 0,
            fill: modifierCanvas(modifiers),
            border: transparentFoundationColor(),
            borderWidth: 0.0,
            radius: 0.0,
            shape: .RegularRoundedRect,
            material: .Flat,
            effects: [],
            padding: EdgeInsets {},
            clipContent: false
        )
    }
}

construct Card(
    title: String = "",
    material: Material = .Frosted,
) extends Widget {
    let children: [some Widget]

    function lower(context: borrow FoundationUiContext, modifiers: borrow ModifierContext) -> FoundationView {
        let childModifiers = modifierContextForChildren(modifiers)
        let tokens = modifierTokens(modifiers)
        // The card is the theme's surface, in the theme's material, at the
        // theme's card radius. `material` names the one thing the card decides
        // for itself: a FLAT card is the raised elevation rather than the glass
        // stack, whatever the theme's own surface material is.
        var selectedMaterial = tokens.surfaceMaterial
        var selectedRadius = tokens.cardRadius
        var selectedFill = foundationColor(tokens.background.surface)
        var selectedBorder = foundationColor(tokens.border.standard.color)
        if material == .Flat {
            selectedMaterial = .Flat
            selectedFill = foundationColor(tokens.background.raised)
            selectedBorder = foundationColor(tokens.border.subtle.color)
        }
        if modifiers.hasMaterial {
            selectedMaterial = modifiers.material
            if selectedMaterial == .Flat {
                selectedFill = foundationColor(tokens.background.raised)
                selectedBorder = foundationColor(tokens.border.subtle.color)
            } else {
                selectedFill = cardFill(selectedMaterial)
                selectedBorder = cardBorder(selectedMaterial)
            }
        }
        let selectedEffects = cardEffects(selectedMaterial)
        var cardChildren: [FoundationView] = []
        if title.count > 0 {
            let titleDelta = modifierDeltaTypography(.headline)
            let titleModifiers = modifierContextApply(childModifiers, move titleDelta)
            cardChildren.append(Text(content: move title).lower(context, titleModifiers))
        }
        var index = 0
        while index < children.count {
            cardChildren.append(children[index].lower(context, childModifiers))
            index = index + 1
        }
        let cardColumn = Column(
            children: move cardChildren,
            width: .Fill,
            height: .Hug,
            spacing: spacingImplementation(.Medium, modifiers),
            padding: uniformInsets(spacingImplementation(.Medium, modifiers)),
            crossAxisAlignment: .Start
        )
        return Surface(
            children: [move cardColumn],
            width: .Fill,
            height: .Hug,
            flex: 0,
            fill: modifierSurfaceFill(move selectedFill, modifiers),
            border: modifierSurfaceBorder(move selectedBorder, modifiers),
            borderWidth: 1.0,
            radius: selectedRadius,
            shape: .RegularRoundedRect,
            material: foundationMaterial(selectedMaterial),
            effects: modifierEffects(move selectedEffects, modifiers),
            padding: EdgeInsets {},
            clipContent: true
        )
    }
}

// The bar tints with the cascading `.foregroundColor(...)` when one is set,
// the accent otherwise; the track is the control fill.
construct Progress(value: Float) extends Widget {
    function lower(context: borrow FoundationUiContext, modifiers: borrow ModifierContext) -> FoundationView {
        var progress = value
        if progress < 0.0 {
            progress = 0.0
        }
        if progress > 1.0 {
            progress = 1.0
        }
        let tokens = modifierTokens(modifiers)
        var barColor = foundationColor(tokens.tint.accent)
        if modifiers.hasForegroundColor {
            barColor = modifierPrimaryColor(modifiers.foregroundColor, modifiers)
        }
        let track = Surface(
            children: [],
            width: .Fixed(96.0),
            height: .Fixed(6.0),
            flex: 0,
            fill: modifierSurfaceFill(foundationColor(tokens.fill.control), modifiers),
            border: transparentFoundationColor(),
            borderWidth: 0.0,
            radius: 999.0,
            shape: .RegularRoundedRect,
            material: .Flat,
            effects: [],
            padding: EdgeInsets {},
            clipContent: true
        )
        let filled = Surface(
            children: [],
            width: .Fixed(96.0 * progress),
            height: .Fixed(6.0),
            flex: 0,
            fill: modifierColor(move barColor, modifiers),
            border: transparentFoundationColor(),
            borderWidth: 0.0,
            radius: 999.0,
            shape: .RegularRoundedRect,
            material: .Flat,
            effects: [],
            padding: EdgeInsets {},
            clipContent: true
        )
        return FoundationView {
            kind: .Frame
            width: .Fixed(96.0)
            height: .Fixed(6.0)
            alignment: .Leading
            padding: EdgeInsets {}
            children: [move track, move filled]
        }
    }
}

construct Spacer() extends Widget {
    function lower(context: borrow FoundationUiContext, modifiers: borrow ModifierContext) -> FoundationView {
        let ignored = context.frameCount
        return FoundationView {
            kind: .Spacer
            width: .Fill
            height: .Fill
            flex: 1
            minLength: 0.0
        }
    }
}

construct Circle() extends Widget {
    function lower(context: borrow FoundationUiContext, modifiers: borrow ModifierContext) -> FoundationView {
        let ignored = context.frameCount
        var circleFill = foundationColor(modifierTokens(modifiers).foreground.primary)
        if modifiers.hasForegroundColor {
            circleFill = modifierPrimaryColor(modifiers.foregroundColor, modifiers)
        }
        return Surface(
            children: [],
            width: .Fixed(0.0),
            height: .Fixed(0.0),
            flex: 0,
            fill: modifierSurfaceFill(move circleFill, modifiers),
            border: transparentFoundationColor(),
            borderWidth: 0.0,
            radius: 999.0,
            shape: .Squircle,
            material: .Flat,
            effects: [],
            padding: EdgeInsets {},
            clipContent: true
        )
    }
}

// Which way a gradient runs. The application names a direction rather than an
// angle, because these are the ones a layout can answer without knowing how
// large the surface came out — an angle over a box whose aspect changes is a
// gradient that shears when the window is resized.
enum GradientDirection {
    Down
    Across
    Diagonal
}

function foundationGradient(direction: borrow GradientDirection) -> FoundationGradient {
    match direction {
        Down -> return .Down;
        Across -> return .Across;
        Diagonal -> return .Diagonal;
    }
}

// A fade from one colour to another, across the space it is given.
//
//     LinearGradient(start: colorPurple(), end: colorBlue())
//     LinearGradient(start: top, end: bottom, direction: .Across)
//
// ONE surface, blended per corner by the compositor. It used to be a column of
// twelve strips, which is twelve quads, a visible band at every seam, and a
// gradient that could only ever run downwards.
construct LinearGradient(
    start: Color,
    end: Color,
    direction: GradientDirection = .Down,
    radius: CornerRadius = .None,
) extends Widget {
    function lower(context: borrow FoundationUiContext, modifiers: borrow ModifierContext) -> FoundationView {
        let ignored = context.viewport.width
        return FoundationView {
            kind: .Surface
            width: .Fill
            height: .Fill
            fill: modifierColor(foundationColor(start), modifiers)
            fillEnd: modifierColor(foundationColor(end), modifiers)
            gradient: foundationGradient(direction)
            radius: cornerRadiusImplementation(radius, modifiers)
        }
    }
}

// A fill-sized wash in a background style — the band behind a list row, the pill
// under a tab. The themed counterpart to SurfaceTint, which can only be handed a
// color someone else already resolved.
construct BackgroundFill(style: BackgroundStyle, radius: CornerRadius = .None) extends Widget {
    function lower(context: borrow FoundationUiContext, modifiers: borrow ModifierContext) -> FoundationView {
        let ignored = context.frameCount
        return FoundationView {
            kind: .Surface
            width: .Fill
            height: .Fill
            fill: modifierColor(modifierBackgroundStyle(style, modifiers), modifiers)
            radius: cornerRadiusImplementation(radius, modifiers)
        }
    }
}

construct SurfaceTint(color: Color) extends Widget {
    function lower(context: borrow FoundationUiContext, modifiers: borrow ModifierContext) -> FoundationView {
        let ignored = context.frameCount
        return Surface(
            children: [],
            width: .Fill,
            height: .Fill,
            flex: 0,
            fill: modifierSurfaceFill(foundationColor(color), modifiers),
            border: transparentFoundationColor(),
            borderWidth: 0.0,
            radius: 0.0,
            shape: .RegularRoundedRect,
            material: .Flat,
            effects: [],
            padding: EdgeInsets {},
            clipContent: false
        )
    }
}

// A container's own inset, in spacing tokens, one axis at a time.
//
// This is not padding: padding is a length someone chose at a call site, and
// every one of them drifts. An inset states which spacing STEP a container holds
// its content off its edges by, and the theme decides what that step measures.
construct Inset(
    horizontal: Spacing = .None,
    vertical: Spacing = .None,
) extends Widget {
    let content: some Widget

    function lower(context: borrow FoundationUiContext, modifiers: borrow ModifierContext) -> FoundationView {
        let childModifiers = modifierContextForChildren(modifiers)
        let side = spacingImplementation(horizontal, modifiers)
        let ends = spacingImplementation(vertical, modifiers)
        let view = content.lower(context, childModifiers)
        // The inset takes the SIZING of what it wraps. Forcing Fill here is how
        // a pill that hugs its label collapsed to nothing the moment it was
        // given an inset: the frame claimed a width its hug-sized parent had
        // none of. Padding is not a sizing decision.
        let width = view.width
        let height = view.height
        return Frame(
            move view,
            move width,
            move height,
            0,
            .TopLeading,
            EdgeInsets {
                top: ends
                trailing: side
                bottom: ends
                leading: side
            }
        )
    }
}

// Semantic modifiers contribute a typed delta and then lower the receiving
// widget with the resolved context. No FoundationView has been built yet, so
// the value can be consumed by the widget itself and its own child traversal
// can decide which fields continue downstream.
construct ThemeLayer(theme: Any Theme) extends Widget {
    let content: some Widget

    function lower(context: borrow FoundationUiContext, modifiers: borrow ModifierContext) -> FoundationView {
        let delta = modifierDeltaTheme(move theme)
        let resolved = modifierContextApply(modifiers, move delta)
        return content.lower(context, resolved)
    }
}

construct BackgroundStyleLayer(style: BackgroundStyle) extends Widget {
    let content: some Widget

    function lower(context: borrow FoundationUiContext, modifiers: borrow ModifierContext) -> FoundationView {
        let delta = modifierDeltaBackgroundStyle(style)
        let resolved = modifierContextApply(modifiers, move delta)
        return content.lower(context, resolved)
    }
}

construct ThemeBorderLayer(border: ThemeBorder) extends Widget {
    let content: some Widget

    function lower(context: borrow FoundationUiContext, modifiers: borrow ModifierContext) -> FoundationView {
        let delta = modifierDeltaThemeBorder(border)
        let resolved = modifierContextApply(modifiers, move delta)
        return content.lower(context, resolved)
    }
}

construct ForegroundColorLayer(color: PrimaryColor) extends Widget {
    let content: some Widget

    function lower(context: borrow FoundationUiContext, modifiers: borrow ModifierContext) -> FoundationView {
        let delta = modifierDeltaForegroundColor(color)
        let resolved = modifierContextApply(modifiers, move delta)
        return content.lower(context, resolved)
    }
}

// `.backgroundColor(...)` paints a hug-sized wash behind exactly the widget it
// wraps — it never becomes the subtree's surface role, mirroring how a
// background sits behind one view and not its descendants.
construct BackgroundColorLayer(color: PrimaryColor) extends Widget {
    let content: some Widget

    function lower(context: borrow FoundationUiContext, modifiers: borrow ModifierContext) -> FoundationView {
        let resolved = modifierColor(modifierPrimaryColor(color, modifiers), modifiers)
        let childModifiers = modifierContextForChildren(modifiers)
        return FoundationView {
            kind: .Surface
            width: .Hug
            height: .Hug
            fill: move resolved
            padding: EdgeInsets {}
            children: [content.lower(context, childModifiers)]
        }
    }
}

construct MaterialLayer(value: Material) extends Widget {
    let content: some Widget

    function lower(context: borrow FoundationUiContext, modifiers: borrow ModifierContext) -> FoundationView {
        let delta = modifierDeltaMaterial(value)
        let resolved = modifierContextApply(modifiers, move delta)
        return content.lower(context, resolved)
    }
}

construct DisabledLayer(value: Bool) extends Widget {
    let content: some Widget

    function lower(context: borrow FoundationUiContext, modifiers: borrow ModifierContext) -> FoundationView {
        let delta = modifierDeltaDisabled(value)
        let resolved = modifierContextApply(modifiers, move delta)
        return content.lower(context, resolved)
    }
}

construct FocusedLayer(value: Bool) extends Widget {
    let content: some Widget

    function lower(context: borrow FoundationUiContext, modifiers: borrow ModifierContext) -> FoundationView {
        let delta = modifierDeltaFocused(value)
        let resolved = modifierContextApply(modifiers, move delta)
        return content.lower(context, resolved)
    }
}

construct BackgroundLayer(fill: Any Widget) extends Widget {
    let content: some Widget

    function lower(context: borrow FoundationUiContext, modifiers: borrow ModifierContext) -> FoundationView {
        // The two halves get DIFFERENT contexts, and the difference is the whole
        // point of the modifier.
        //
        // `modifierContextForChildren` clears the surface modifiers — the fill,
        // the background style, the material, the themed border — because a box's
        // own surface must not cascade into what it contains. That is right for
        // the CONTENT and exactly wrong for the FILL: in
        // `.background(RoundedRectangle()).backgroundStyle(.Surface)` those
        // modifiers are the shape's whole description, and handing it the
        // stripped context leaves it painting transparent. A window toolbar
        // written that way vanished, showing the canvas straight through a bar
        // that was supposed to be a surface.
        //
        // The fill is not a child. It is the surface the modifiers describe, so
        // it is lowered against the modifiers as written.
        let childModifiers = modifierContextForChildren(modifiers)
        return overlayView(fill.lower(context, modifiers), content.lower(context, childModifiers))
    }
}

construct CornerRadiusLayer(radius: Float) extends Widget {
    let content: some Widget

    function lower(context: borrow FoundationUiContext, modifiers: borrow ModifierContext) -> FoundationView {
        let childModifiers = modifierContextForChildren(modifiers)
        return Surface(
            children: [content.lower(context, childModifiers)],
            width: .Fill,
            height: .Hug,
            flex: 0,
            fill: modifierSurfaceFill(transparentFoundationColor(), modifiers),
            border: transparentFoundationColor(),
            borderWidth: 0.0,
            radius: radius,
            shape: .RegularRoundedRect,
            material: .Flat,
            effects: [],
            padding: EdgeInsets {},
            clipContent: true
        )
    }
}

construct BlurBehindLayer(radius: Float, saturation: Float) extends Widget {
    let content: some Widget

    function lower(context: borrow FoundationUiContext, modifiers: borrow ModifierContext) -> FoundationView {
        let ignored = saturation + intAsFloat(value: context.frameCount)
        let childModifiers = modifierContextForChildren(modifiers)
        return Surface(
            children: [content.lower(context, childModifiers)],
            width: .Fill,
            height: .Hug,
            flex: 0,
            fill: modifierSurfaceFill(transparentFoundationColor(), modifiers),
            border: transparentFoundationColor(),
            borderWidth: 0.0,
            radius: radius,
            shape: .RegularRoundedRect,
            material: .LiquidGlass,
            effects: modifierEffects([
                .BackdropGlow(Glow {
                    color: foundationRgba(1.0, 1.0, 1.0, 0.08)
                    radius: radius
                    intensity: 0.08
                })
            ], modifiers),
            padding: EdgeInsets {},
            clipContent: false
        )
    }
}

construct GlowLayer(intensity: Float) extends Widget {
    let content: some Widget

    function lower(context: borrow FoundationUiContext, modifiers: borrow ModifierContext) -> FoundationView {
        let ignored = context.pointerX
        let childModifiers = modifierContextForChildren(modifiers)
        return Surface(
            children: [content.lower(context, childModifiers)],
            width: .Fill,
            height: .Hug,
            flex: 0,
            fill: modifierSurfaceFill(transparentFoundationColor(), modifiers),
            border: transparentFoundationColor(),
            borderWidth: 0.0,
            radius: 0.0,
            shape: .RegularRoundedRect,
            material: .Flat,
            effects: modifierEffects([
                .LayerGlow(Glow {
                    color: foundationRgba(0.31, 0.57, 1.0, 1.0)
                    radius: 24.0
                    intensity: intensity
                })
            ], modifiers),
            padding: EdgeInsets {},
            clipContent: false
        )
    }
}

construct FontLayer(size: Float, weight: FontWeight) extends Widget {
    let content: some Widget

    function lower(context: borrow FoundationUiContext, modifiers: borrow ModifierContext) -> FoundationView {
        let delta = modifierDeltaFont(size, weight)
        let resolved = modifierContextApply(modifiers, move delta)
        return content.lower(context, resolved)
    }
}

construct TypographyLayer(style: TypographyStyle) extends Widget {
    let content: some Widget

    function lower(context: borrow FoundationUiContext, modifiers: borrow ModifierContext) -> FoundationView {
        let delta = modifierDeltaTypography(style)
        let resolved = modifierContextApply(modifiers, move delta)
        return content.lower(context, resolved)
    }
}

construct OpacityLayer(value: Float) extends Widget {
    let content: some Widget

    function lower(context: borrow FoundationUiContext, modifiers: borrow ModifierContext) -> FoundationView {
        let delta = modifierDeltaOpacity(value)
        let resolved = modifierContextApply(modifiers, move delta)
        return content.lower(context, resolved)
    }
}

construct MinHeightLayer(value: Float) extends Widget {
    let content: some Widget

    function lower(context: borrow FoundationUiContext, modifiers: borrow ModifierContext) -> FoundationView {
        let childModifiers = modifierContextForChildren(modifiers)
        return viewWithHeight(content.lower(context, childModifiers), .Min(value))
    }
}

construct MinWidthLayer(value: Float) extends Widget {
    let content: some Widget

    function lower(context: borrow FoundationUiContext, modifiers: borrow ModifierContext) -> FoundationView {
        let childModifiers = modifierContextForChildren(modifiers)
        return Frame(
            content.lower(context, childModifiers),
            .Fixed(value),
            .Hug,
            0,
            .TopLeading,
            EdgeInsets {}
        )
    }
}

construct SizeLayer(value: Float) extends Widget {
    let content: some Widget

    function lower(context: borrow FoundationUiContext, modifiers: borrow ModifierContext) -> FoundationView {
        let childModifiers = modifierContextForChildren(modifiers)
        return Frame(
            content.lower(context, childModifiers),
            .Fixed(value),
            .Fixed(value),
            0,
            .Center,
            EdgeInsets {}
        )
    }
}

construct FillLayer(color: Color) extends Widget {
    let content: some Widget

    function lower(context: borrow FoundationUiContext, modifiers: borrow ModifierContext) -> FoundationView {
        let delta = modifierDeltaFill(move color)
        let resolved = modifierContextApply(modifiers, move delta)
        return content.lower(context, resolved)
    }
}

construct TextColorLayer(color: Color) extends Widget {
    let content: some Widget

    function lower(context: borrow FoundationUiContext, modifiers: borrow ModifierContext) -> FoundationView {
        let delta = modifierDeltaTextColor(move color)
        let resolved = modifierContextApply(modifiers, move delta)
        return content.lower(context, resolved)
    }
}

construct SurfaceRadiusLayer(value: Float) extends Widget {
    let content: some Widget

    function lower(context: borrow FoundationUiContext, modifiers: borrow ModifierContext) -> FoundationView {
        let childModifiers = modifierContextForChildren(modifiers)
        return viewWithSurfaceRadius(content.lower(context, childModifiers), value)
    }
}

construct SurfaceShapeLayer(shape: SurfaceShape) extends Widget {
    let content: some Widget

    function lower(context: borrow FoundationUiContext, modifiers: borrow ModifierContext) -> FoundationView {
        let childModifiers = modifierContextForChildren(modifiers)
        return viewWithSurfaceShape(content.lower(context, childModifiers), shape)
    }
}

construct SurfaceBorderLayer(color: Color, width: Float) extends Widget {
    let content: some Widget

    function lower(context: borrow FoundationUiContext, modifiers: borrow ModifierContext) -> FoundationView {
        let border = foundationColor(move color)
        let childModifiers = modifierContextForChildren(modifiers)
        return viewWithSurfaceBorder(content.lower(context, childModifiers), move border, width)
    }
}

// A hairline between two things.
//
// Its colour and its thickness are the theme's border tokens, and how far it is
// held off the edges it runs between is the size class's — leading and trailing
// separately, because a grouped list insets its separators to the label column
// on one side and runs them to the edge on the other. `.themeBorder(...)` picks
// which border it is drawn in.
//
// The inset lives on the divider rather than on whatever encloses it, so a
// section, a sidebar and a toolbar all divide the same way without any of them
// restating it.
//
// `follows` names a pair of guides the divider takes its extent from instead,
// when something before it publishes them. That is how a hairline lines up with
// a label column it has no way to measure: the column answers the guide, and the
// divider reads the answer. The size class's insets remain the fallback for when
// nothing does.
construct Divider(
    followsLeading: Any AlignmentGuide = ListRowSeparatorLeading(),
    followsTrailing: Any AlignmentGuide = ListRowSeparatorTrailing(),
) extends Widget {
    function lower(context: borrow FoundationUiContext, modifiers: borrow ModifierContext) -> FoundationView {
        let ignored = context.frameCount
        let metrics = resolvedControlMetrics(modifiers)
        let border = modifierResolvedBorder(modifiers)
        let line = Surface(
            children: [],
            width: .Fill,
            height: .Fixed(border.width),
            flex: 0,
            fill: modifierSurfaceFill(foundationColor(border.color), modifiers),
            border: transparentFoundationColor(),
            borderWidth: 0.0,
            radius: 0.0,
            shape: .RegularRoundedRect,
            material: .Flat,
            effects: [],
            padding: EdgeInsets {},
            clipContent: false
        )
        // The hairline itself reads the guides, not the frame around it: what a
        // guide moves is the painted extent, and the frame keeps the width the
        // stack gave it so nothing beside the divider shifts.
        let following = viewFollowingGuides(
            move line,
            guideTag(followsLeading),
            guideTag(followsTrailing)
        )
        return Frame(
            move following,
            .Fill,
            .Hug,
            0,
            .Leading,
            EdgeInsets {
                leading: metrics.dividerLeading
                trailing: metrics.dividerTrailing
            }
        )
    }
}

// The border a widget is drawn in: the named `.themeBorder(...)` when one is in
// effect, the subtle hairline otherwise. Colour and width together, because a
// border is both.
function modifierResolvedBorder(modifiers: borrow ModifierContext) -> ResolvedBorder {
    let tokens = modifierTokens(modifiers)
    if modifiers.hasThemeBorder == false {
        return tokens.border.subtle
    }
    match modifiers.themeBorder {
        Subtle -> return tokens.border.subtle;
        Standard -> return tokens.border.standard;
        Strong -> return tokens.border.strong;
        Focus -> return tokens.border.focus;
    }
}
