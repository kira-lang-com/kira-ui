// A hairline between two things.
//
// Its colour and its thickness are the theme's border tokens, and how far it is
// held off the edges it runs between is the size class's — leading and trailing
// separately, because a grouped list insets its separators to the label column
// on one side and runs them to the edge on the other. `.themeBorder(...)` picks
// which border it is drawn in.
//
// The inset lives on the divider rather than on whatever encloses it, so a
// section, a sidebar and a toolbar all divide the same way without any of them
// restating it.
//
// `follows` names a pair of guides the divider takes its extent from instead,
// when something before it publishes them. That is how a hairline lines up with
// a label column it has no way to measure: the column answers the guide, and the
// divider reads the answer. The size class's insets remain the fallback for when
// nothing does.
Widget Divider(
    followsLeading: Any AlignmentGuide = ListRowSeparatorLeading(),
    followsTrailing: Any AlignmentGuide = ListRowSeparatorTrailing(),
) {
    function lower(context: borrow KiraUIFoundation.FoundationUiContext, modifiers: borrow ModifierContext) -> KiraUIFoundation.FoundationView {
        let ignored = context.frameCount
        let metrics = resolvedControlMetrics(modifiers)
        let border = modifierResolvedBorder(modifiers)
        let line = Surface(
            children: [],
            width: KiraUIFoundation.SizeMode.Fill,
            height: KiraUIFoundation.SizeMode.Fixed(border.width),
            flex: 0,
            fill: modifierSurfaceFill(foundationColor(border.color), modifiers),
            border: transparentFoundationColor(),
            borderWidth: 0.0,
            radius: 0.0,
            shape: KiraUIFoundation.FoundationShape.RegularRoundedRect,
            material: KiraUIFoundation.FoundationMaterial.Flat,
            effects: [],
            padding: KiraUIFoundation.EdgeInsets {},
            clipContent: false
        )
        // The hairline itself reads the guides, not the frame around it: what a
        // guide moves is the painted extent, and the frame keeps the width the
        // stack gave it so nothing beside the divider shifts.
        let following = viewFollowingGuides(
            move line,
            guideTag(followsLeading),
            guideTag(followsTrailing)
        )
        return Frame(
            move following,
            KiraUIFoundation.SizeMode.Fill,
            KiraUIFoundation.SizeMode.Hug,
            0,
            KiraUIFoundation.Alignment.Leading,
            KiraUIFoundation.EdgeInsets {
                leading: metrics.dividerLeading
                trailing: metrics.dividerTrailing
            }
        )
    }
}

// The border a widget is drawn in: the named `.themeBorder(...)` when one is in
// effect, the subtle hairline otherwise. Colour and width together, because a
// border is both.
function modifierResolvedBorder(modifiers: borrow ModifierContext) -> ResolvedBorder {
    let tokens = modifierTokens(modifiers)
    if modifiers.hasThemeBorder == false {
        return tokens.border.subtle
    }
    match modifiers.themeBorder {
        Subtle -> return tokens.border.subtle;
        Standard -> return tokens.border.standard;
        Strong -> return tokens.border.strong;
        Focus -> return tokens.border.focus;
    }
}
