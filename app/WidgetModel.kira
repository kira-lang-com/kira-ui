    function lower(context: borrow KiraUIFoundation.FoundationUiContext, modifiers: borrow ModifierContext) -> KiraUIFoundation.FoundationView {
        let border = foundationColor(move color)
        let childModifiers = modifierContextForChildren(modifiers)
        return viewWithSurfaceBorder(content.lower(context, childModifiers), move border, width)
    }
}

Widget Divider(color: Color = Color {}) {
    function lower(context: borrow KiraUIFoundation.FoundationUiContext, modifiers: borrow ModifierContext) -> KiraUIFoundation.FoundationView {
        let ignored = context.frameCount
        var dividerColor = foundationColor(color)
        if modifiers.hasTheme {
            let tokens = modifiers.theme.tokens()
            dividerColor = foundationColor(tokens.borderSubtle)
        }
        if modifiers.hasThemeBorder {
            dividerColor = modifierSurfaceBorder(move dividerColor, modifiers)
        }
        return Surface(
            children: [],
            width: KiraUIFoundation.SizeMode.Fill,
            height: KiraUIFoundation.SizeMode.Fixed(1.0),
            flex: 0,
            fill: modifierSurfaceFill(move dividerColor, modifiers),
            border: transparentFoundationColor(),
            borderWidth: 0.0,
            radius: 0.0,
            shape: KiraUIFoundation.FoundationShape.RegularRoundedRect,
            material: KiraUIFoundation.FoundationMaterial.Flat,
            effects: [],
            padding: KiraUIFoundation.EdgeInsets {},
            clipContent: false
        )
    }
}
