function viewWithSurfacePadding(view: KiraUIFoundation.FoundationView, length: Float) -> KiraUIFoundation.FoundationView {
    return KiraUIFoundation.FoundationView {
        kind: view.kind
        key: view.key
        children: identityChildren(view.children)
        width: view.width
        height: view.height
        flex: view.flex
        gap: view.gap
        padding: uniformInsets(length)
        crossAxisAlignment: view.crossAxisAlignment
        alignment: view.alignment
        fill: view.fill
        border: view.border
        borderWidth: view.borderWidth
        radius: view.radius
        shape: view.shape
        material: view.material
        effects: identityEffects(view.effects)
        clipContent: view.clipContent
        content: view.content
        color: view.color
        size: view.size
        inkLeft: view.inkLeft
        inkRight: view.inkRight
        inkTop: view.inkTop
        inkBottom: view.inkBottom
        lineHeight: view.lineHeight
        weight: view.weight
        disabled: view.disabled
        focusable: view.focusable
        autofocus: view.autofocus
        onPress: view.onPress
        onTextInput: view.onTextInput
        onTextCodepoint: view.onTextCodepoint
        onBackspace: view.onBackspace
        onSubmit: view.onSubmit
        onKey: view.onKey
        onScroll: view.onScroll
        minLength: view.minLength
        interaction: view.interaction
        texture: view.texture
        textureOpacity: view.textureOpacity
    }
}

function viewWithContentMargins(view: KiraUIFoundation.FoundationView, inset: Float) -> KiraUIFoundation.FoundationView {
    return KiraUIFoundation.FoundationView {
        kind: view.kind
        key: view.key
        children: identityChildren(view.children)
        width: view.width
        height: view.height
        flex: view.flex
        gap: view.gap
        padding: KiraUIFoundation.EdgeInsets {
            top: view.padding.top + inset
            trailing: view.padding.trailing + inset
            bottom: view.padding.bottom + inset
            leading: view.padding.leading + inset
        }
        crossAxisAlignment: view.crossAxisAlignment
        alignment: view.alignment
        fill: view.fill
        border: view.border
        borderWidth: view.borderWidth
        radius: view.radius
        shape: view.shape
        material: view.material
        effects: identityEffects(view.effects)
        clipContent: view.clipContent
        content: view.content
        color: view.color
        size: view.size
        inkLeft: view.inkLeft
        inkRight: view.inkRight
        inkTop: view.inkTop
        inkBottom: view.inkBottom
        lineHeight: view.lineHeight
        weight: view.weight
        disabled: view.disabled
        focusable: view.focusable
        autofocus: view.autofocus
        onPress: view.onPress
        onTextInput: view.onTextInput
        onTextCodepoint: view.onTextCodepoint
        onBackspace: view.onBackspace
        onSubmit: view.onSubmit
        onKey: view.onKey
        onScroll: view.onScroll
        minLength: view.minLength
        interaction: view.interaction
        texture: view.texture
        textureOpacity: view.textureOpacity
    }
}

Widget SurfacePaddingLayer(value: Float) {
    @Content let content: Any Widget

    function lower(context: borrow KiraUIFoundation.FoundationUiContext, modifiers: borrow ModifierContext) -> KiraUIFoundation.FoundationView {
        let childModifiers = modifierContextForChildren(modifiers)
        return viewWithSurfacePadding(content.lower(context, childModifiers), value)
    }
}

Widget ContentMarginsLayer(value: ContentMargins) {
    @Content let content: Any Widget

    function lower(context: borrow KiraUIFoundation.FoundationUiContext, modifiers: borrow ModifierContext) -> KiraUIFoundation.FoundationView {
        let childModifiers = modifierContextForChildren(modifiers)
        let view = content.lower(context, childModifiers)
        let inset = contentMarginsInset(move value)
        return viewWithContentMargins(move view, inset)
    }
}

Widget WidthLayer(value: Float) {
    @Content let content: Any Widget

    function lower(context: borrow KiraUIFoundation.FoundationUiContext, modifiers: borrow ModifierContext) -> KiraUIFoundation.FoundationView {
        let childModifiers = modifierContextForChildren(modifiers)
        return viewWithWidth(content.lower(context, childModifiers), KiraUIFoundation.SizeMode.Fixed(value))
    }
}

Widget FillHeightLayer() {
    @Content let content: Any Widget

    function lower(context: borrow KiraUIFoundation.FoundationUiContext, modifiers: borrow ModifierContext) -> KiraUIFoundation.FoundationView {
        let childModifiers = modifierContextForChildren(modifiers)
        return viewWithHeight(content.lower(context, childModifiers), KiraUIFoundation.SizeMode.Fill)
    }
}

Widget HeightLayer(value: Float) {
    @Content let content: Any Widget

    function lower(context: borrow KiraUIFoundation.FoundationUiContext, modifiers: borrow ModifierContext) -> KiraUIFoundation.FoundationView {
        let childModifiers = modifierContextForChildren(modifiers)
        return viewWithHeight(content.lower(context, childModifiers), KiraUIFoundation.SizeMode.Fixed(value))
    }
}

// Fill and Fixed both had a modifier; Hug did not, so a widget that fills by
// default could never be told to shrink to its content without exposing its own
// SizeMode argument.
Widget HugWidthLayer() {
    @Content let content: Any Widget

    function lower(context: borrow KiraUIFoundation.FoundationUiContext, modifiers: borrow ModifierContext) -> KiraUIFoundation.FoundationView {
        let childModifiers = modifierContextForChildren(modifiers)
        return viewWithWidth(content.lower(context, childModifiers), KiraUIFoundation.SizeMode.Hug)
    }
}

Widget HugHeightLayer() {
    @Content let content: Any Widget

    function lower(context: borrow KiraUIFoundation.FoundationUiContext, modifiers: borrow ModifierContext) -> KiraUIFoundation.FoundationView {
        let childModifiers = modifierContextForChildren(modifiers)
        return viewWithHeight(content.lower(context, childModifiers), KiraUIFoundation.SizeMode.Hug)
    }
}

function typographyImplementation(
    style: TypographyStyle,
    modifiers: borrow ModifierContext,
) -> FontImplementation {
    if modifiers.hasTheme {
        return modifiers.theme.typography(style)
    }
    let values = defaultStyleTypographyTokens()
    match style {
        caption -> return values.caption;
        body -> return values.body;
        control -> return values.control;
        subheadline -> return values.subheadline;
        bodyEmphasis -> return values.bodyEmphasis;
        footnote -> return values.footnote;
        overline -> return values.overline;
        label -> return values.label;
        section -> return values.section;
        headline -> return values.headline;
        title -> return values.title;
        title1 -> return values.title1;
        title2 -> return values.title2;
        title3 -> return values.title3;
    }
}

function cornerRadiusImplementation(
    style: CornerRadius,
    modifiers: borrow ModifierContext,
) -> Float {
    if modifiers.hasTheme {
        return modifiers.theme.cornerRadius(style)
    }
    let values = defaultStyleCornerRadiusTokens()
    match style {
        None -> return values.none;
        Small -> return values.small;
        Medium -> return values.medium;
        Large -> return values.large;
        ExtraLarge -> return values.extraLarge;
        Capsule -> return values.capsule;
    }
}

function spacingImplementation(
    style: Spacing,
    modifiers: borrow ModifierContext,
) -> Float {
    if modifiers.hasTheme {
        return modifiers.theme.spacing(style)
    }
    let values = defaultStyleSpacingTokens()
    match style {
        None -> return values.none;
        ExtraSmall -> return values.extraSmall;
        Small -> return values.small;
        Medium -> return values.medium;
        Large -> return values.large;
        ExtraLarge -> return values.extraLarge;
        Section -> return values.section;
    }
}

Widget Text(content: String) {
    function lower(context: borrow KiraUIFoundation.FoundationUiContext, modifiers: borrow ModifierContext) -> KiraUIFoundation.FoundationView {
        let ignored = context.frameCount
        var textSize = 16.0
        var textLineHeight = 0.0
        var textWeight = 400.0
        if modifiers.hasFont {
            textSize = modifiers.fontSize
            textWeight = foundationFontWeight(modifiers.fontWeight)
        } else if modifiers.hasTypography {
            let selected = typographyImplementation(modifiers.typography, modifiers)
            textSize = selected.size
            textLineHeight = selected.lineHeight
            textWeight = foundationFontWeight(selected.weight)
        } else if modifiers.hasTheme {
            let tokens = modifiers.theme.tokens()
            textSize = tokens.bodySize
            textLineHeight = KiraUIFoundation.foundationTextRunLineHeight(size: textSize)
            textWeight = foundationFontWeight(tokens.bodyWeight)
        }
        return KiraUIFoundation.FoundationView {
            kind: KiraUIFoundation.FoundationViewKind.Text
            content: content
            color: modifierColor(modifierTextColor(modifiers), modifiers)
            size: textSize
            inkLeft: KiraUIFoundation.foundationTextRunInkLeft(content: content, size: textSize)
            inkRight: KiraUIFoundation.foundationTextRunInkRight(content: content, size: textSize)
            inkTop: KiraUIFoundation.foundationTextRunInkTop(content: content, size: textSize)
            inkBottom: KiraUIFoundation.foundationTextRunInkBottom(content: content, size: textSize)
            lineHeight: textLineHeight
            weight: textWeight
            disabled: modifiers.disabled
        }
    }
}

enum ButtonRole {
    Normal
    Destructive
}

// Button consumes the scoped foreground on its own presentation surface. Its
// label is an implementation detail of the control, so it receives the
// presentation context explicitly rather than inheriting foreground color
// through the general child traversal.
Widget Button(
    label: String,
    role: ButtonRole = ButtonRole.Normal,
    onPress: () -> Void,
) {
    function lower(context: borrow KiraUIFoundation.FoundationUiContext, modifiers: borrow ModifierContext) -> KiraUIFoundation.FoundationView {
        let k = kiraUiTapSeqKey()
        let press = onPress
        var buttonFill = KiraUIFoundation.Color {
            r: 0.16
            g: 0.18
            b: 0.26
            a: 1.0
        }
        if modifiers.hasTheme {
            let tokens = modifiers.theme.tokens()
            buttonFill = foundationColor(tokens.backgroundControl)
        }
        if modifiers.hasThemeColor {
            buttonFill = modifierThemeColor(modifiers.themeColor, modifiers)
        }
        if modifiers.hasForegroundColor {
            buttonFill = modifierThemeColor(modifiers.foregroundColor, modifiers)
        }
        match role {
            Normal -> {}
            Destructive -> {
                if modifiers.hasTheme {
                    let tokens = modifiers.theme.tokens()
                    buttonFill = foundationColor(tokens.danger)
                } else {
                    buttonFill = KiraUIFoundation.Color {
                        r: 0.82
                        g: 0.12
                        b: 0.18
                        a: 1.0
                    }
                }
            }
        }
        return buttonView(context, modifiers, k, move press, move label, move buttonFill)
    }
}

function buttonView(
    context: borrow KiraUIFoundation.FoundationUiContext,
    modifiers: borrow ModifierContext,
    key: Int,
    press: () -> Void,
    label: String,
    fill: KiraUIFoundation.Color,
) -> KiraUIFoundation.FoundationView {
    // A filled button's label is the inverse ink, not white — white on a light
    // theme's control fill is unreadable every time.
    var labelModifiers = modifierContextForPresentation(modifiers)
    var labelColor = colorWhite()
    if modifiers.hasTheme {
        labelColor = modifiers.theme.tokens().foregroundInverse
    }
    let labelDelta = modifierDeltaTextColor(move labelColor)
    labelModifiers = modifierContextApply(labelModifiers, move labelDelta)
    let labelView = Text(content: move label).lower(context, labelModifiers)
    return KiraUIFoundation.FoundationView {
        kind: KiraUIFoundation.FoundationViewKind.HitArea
        key: key
        width: KiraUIFoundation.SizeMode.Hug
        height: KiraUIFoundation.SizeMode.Hug
        backgroundFill: modifierSurfaceFill(move fill, modifiers)
        border: modifierColor(KiraUIFoundation.Color {
            r: 1.0
            g: 1.0
            b: 1.0
            a: 0.16
        }, modifiers)
        borderWidth: 1.0
        padding: KiraUIFoundation.EdgeInsets {
            top: 10.0
            trailing: 15.0
            bottom: 10.0
            leading: 15.0
        }
        radius: 10.0
        disabled: modifiers.disabled
        focusable: true
        autofocus: modifiers.hasFocused && modifiers.focused
        onPress: press
        children: [labelView]
    }
}

Widget AppSurface(
    padding: Spacing = Spacing.None,
    paddingValue: Float = -1.0,
) {
    @Content let content: Any Widget

    function lower(context: borrow KiraUIFoundation.FoundationUiContext, modifiers: borrow ModifierContext) -> KiraUIFoundation.FoundationView {
        let childModifiers = modifierContextForChildren(modifiers)
        var resolvedPadding = spacingImplementation(padding, modifiers)
        if paddingValue >= 0.0 {
            resolvedPadding = paddingValue
        }
        return Surface(
            children: [content.lower(context, childModifiers)],
            width: KiraUIFoundation.SizeMode.Fill,
            height: KiraUIFoundation.SizeMode.Fill,
            flex: 0,
            fill: modifierThemeBackground(KiraUIFoundation.Color {
                r: 0.035
                g: 0.04
                b: 0.065
                a: 1.0
            }, modifiers),
            border: transparentFoundationColor(),
            borderWidth: 0.0,
            radius: 0.0,
            shape: KiraUIFoundation.FoundationShape.RegularRoundedRect,
            material: KiraUIFoundation.FoundationMaterial.Flat,
            effects: [],
            padding: uniformInsets(resolvedPadding),
            clipContent: false
        )
    }
}

Widget VStack(
    spacing: Spacing = Spacing.Medium,
    spacingValue: Float = -1.0,
) {
    @Content let children: [Any Widget]

    function lower(context: borrow KiraUIFoundation.FoundationUiContext, modifiers: borrow ModifierContext) -> KiraUIFoundation.FoundationView {
        var resolvedSpacing = spacingImplementation(spacing, modifiers)
        if spacingValue >= 0.0 {
            resolvedSpacing = spacingValue
        }
        return Column(
            children: loweredChildren(context, modifiers, children),
            width: KiraUIFoundation.SizeMode.Fill,
            height: KiraUIFoundation.SizeMode.Hug,
            spacing: resolvedSpacing,
            padding: KiraUIFoundation.EdgeInsets {},
            crossAxisAlignment: KiraUIFoundation.CrossAlignment.Start
        )
    }
}

function hStackWidth(distribution: Distribution) -> KiraUIFoundation.SizeMode {
    match distribution {
        Fill -> return KiraUIFoundation.SizeMode.Fill;
        Start -> return KiraUIFoundation.SizeMode.Fill;
        Center -> return KiraUIFoundation.SizeMode.Fill;
        Stretch -> return KiraUIFoundation.SizeMode.Fill;
    }
}

function hStackHeight(distribution: Distribution) -> KiraUIFoundation.SizeMode {
    match distribution {
        Fill -> return KiraUIFoundation.SizeMode.Fill;
        Start -> return KiraUIFoundation.SizeMode.Hug;
        Center -> return KiraUIFoundation.SizeMode.Hug;
        Stretch -> return KiraUIFoundation.SizeMode.Hug;
    }
}

function hStackCrossAxisAlignment(distribution: Distribution) -> KiraUIFoundation.CrossAlignment {
    match distribution {
        Fill -> return KiraUIFoundation.CrossAlignment.Stretch;
        Start -> return KiraUIFoundation.CrossAlignment.Start;
        Center -> return KiraUIFoundation.CrossAlignment.Center;
        Stretch -> return KiraUIFoundation.CrossAlignment.Stretch;
    }
}

Widget HStack(
    spacing: Spacing = Spacing.Medium,
    spacingValue: Float = -1.0,
    distribution: Distribution = Distribution.Center,
) {
    @Content let children: [Any Widget]

    function lower(context: borrow KiraUIFoundation.FoundationUiContext, modifiers: borrow ModifierContext) -> KiraUIFoundation.FoundationView {
        var resolvedSpacing = spacingImplementation(spacing, modifiers)
        if spacingValue >= 0.0 {
            resolvedSpacing = spacingValue
        }
        return Row(
            children: loweredChildren(context, modifiers, children),
            width: hStackWidth(distribution),
            height: hStackHeight(distribution),
            spacing: resolvedSpacing,
            padding: KiraUIFoundation.EdgeInsets {},
            crossAxisAlignment: hStackCrossAxisAlignment(distribution)
        )
    }
}

Widget VStackFill(
    spacing: Spacing = Spacing.Medium,
    spacingValue: Float = -1.0,
) {
    @Content let children: [Any Widget]

    function lower(context: borrow KiraUIFoundation.FoundationUiContext, modifiers: borrow ModifierContext) -> KiraUIFoundation.FoundationView {
        var resolvedSpacing = spacingImplementation(spacing, modifiers)
        if spacingValue >= 0.0 {
            resolvedSpacing = spacingValue
        }
        return Column(
            children: loweredChildren(context, modifiers, children),
            width: KiraUIFoundation.SizeMode.Fill,
            height: KiraUIFoundation.SizeMode.Fill,
            spacing: resolvedSpacing,
            padding: KiraUIFoundation.EdgeInsets {},
            crossAxisAlignment: KiraUIFoundation.CrossAlignment.Start
        )
    }
}

Widget Card(
    title: String = "",
    material: Material = Material.Frosted,
) {
    @Content let children: [Any Widget]

    function lower(context: borrow KiraUIFoundation.FoundationUiContext, modifiers: borrow ModifierContext) -> KiraUIFoundation.FoundationView {
        let childModifiers = modifierContextForChildren(modifiers)
        var selectedMaterial = material
        var selectedRadius = 22.0
        var selectedFill = cardFill(material)
        var selectedBorder = cardBorder(material)
        var selectedEffects = cardEffects(material)
        if modifiers.hasTheme {
            let tokens = modifiers.theme.tokens()
            selectedMaterial = tokens.surfaceMaterial
            selectedRadius = tokens.cardRadius
            selectedFill = foundationColor(tokens.backgroundSurface)
            selectedBorder = foundationColor(tokens.borderStandard)
            selectedEffects = cardEffects(selectedMaterial)
            if material == Material.Flat {
                selectedMaterial = Material.Flat
                selectedFill = foundationColor(tokens.backgroundRaised)
                selectedBorder = foundationColor(tokens.borderSubtle)
                selectedEffects = cardEffects(selectedMaterial)
            }
        }
        if modifiers.hasMaterial {
            selectedMaterial = modifiers.material
            if modifiers.hasTheme {
                let tokens = modifiers.theme.tokens()
                if selectedMaterial == Material.Flat {
                    selectedFill = foundationColor(tokens.backgroundRaised)
                    selectedBorder = foundationColor(tokens.borderSubtle)
                } else {
                    selectedFill = cardFill(selectedMaterial)
                    selectedBorder = cardBorder(selectedMaterial)
                }
            } else {
                selectedFill = cardFill(selectedMaterial)
                selectedBorder = cardBorder(selectedMaterial)
            }
            selectedEffects = cardEffects(selectedMaterial)
        }
        var cardChildren: [KiraUIFoundation.FoundationView] = []
        if title.count > 0 {
            let titleDelta = modifierDeltaTypography(TypographyStyle.headline)
            let titleModifiers = modifierContextApply(childModifiers, move titleDelta)
            cardChildren.append(Text(content: move title).lower(context, titleModifiers))
        }
        var index = 0
        while index < children.count {
            cardChildren.append(children[index].lower(context, childModifiers))
            index = index + 1
        }
        let cardColumn = KiraUIFoundation.Column(
            children: move cardChildren,
            width: KiraUIFoundation.SizeMode.Fill,
            height: KiraUIFoundation.SizeMode.Hug,
            spacing: spacingImplementation(Spacing.Medium, modifiers),
            padding: uniformInsets(spacingImplementation(Spacing.Medium, modifiers)),
            crossAxisAlignment: KiraUIFoundation.CrossAlignment.Start
        )
        return Surface(
            children: [move cardColumn],
            width: KiraUIFoundation.SizeMode.Fill,
            height: KiraUIFoundation.SizeMode.Hug,
            flex: 0,
            fill: modifierSurfaceFill(move selectedFill, modifiers),
            border: modifierSurfaceBorder(move selectedBorder, modifiers),
            borderWidth: 1.0,
            radius: selectedRadius,
            shape: KiraUIFoundation.FoundationShape.RegularRoundedRect,
            material: foundationMaterial(selectedMaterial),
            effects: modifierEffects(move selectedEffects, modifiers),
            padding: KiraUIFoundation.EdgeInsets {},
            clipContent: true
        )
    }
}

Widget Progress(value: Float) {
    function lower(context: borrow KiraUIFoundation.FoundationUiContext, modifiers: borrow ModifierContext) -> KiraUIFoundation.FoundationView {
        var progress = value
        if progress < 0.0 {
            progress = 0.0
        }
        if progress > 1.0 {
            progress = 1.0
        }
        let track = Surface(
            children: [],
            width: KiraUIFoundation.SizeMode.Fixed(96.0),
            height: KiraUIFoundation.SizeMode.Fixed(6.0),
            flex: 0,
            fill: modifierSurfaceFill(KiraUIFoundation.Color {
                r: 0.16
                g: 0.18
                b: 0.26
                a: 1.0
            }, modifiers),
            border: transparentFoundationColor(),
            borderWidth: 0.0,
            radius: 999.0,
            shape: KiraUIFoundation.FoundationShape.RegularRoundedRect,
            material: KiraUIFoundation.FoundationMaterial.Flat,
            effects: [],
            padding: KiraUIFoundation.EdgeInsets {},
            clipContent: true
        )
        let filled = Surface(
            children: [],
            width: KiraUIFoundation.SizeMode.Fixed(96.0 * progress),
            height: KiraUIFoundation.SizeMode.Fixed(6.0),
            flex: 0,
            fill: modifierColor(KiraUIFoundation.Color {
                r: 0.43
                g: 0.67
                b: 1.0
                a: 1.0
            }, modifiers),
            border: transparentFoundationColor(),
            borderWidth: 0.0,
            radius: 999.0,
            shape: KiraUIFoundation.FoundationShape.RegularRoundedRect,
            material: KiraUIFoundation.FoundationMaterial.Flat,
            effects: [],
            padding: KiraUIFoundation.EdgeInsets {},
            clipContent: true
        )
        return KiraUIFoundation.FoundationView {
            kind: KiraUIFoundation.FoundationViewKind.Frame
            width: KiraUIFoundation.SizeMode.Fixed(96.0)
            height: KiraUIFoundation.SizeMode.Fixed(6.0)
            alignment: KiraUIFoundation.Alignment.Leading
            padding: KiraUIFoundation.EdgeInsets {}
            children: [move track, move filled]
        }
    }
}

Widget Spacer() {
    function lower(context: borrow KiraUIFoundation.FoundationUiContext, modifiers: borrow ModifierContext) -> KiraUIFoundation.FoundationView {
        let ignored = context.frameCount
        return KiraUIFoundation.FoundationView {
            kind: KiraUIFoundation.FoundationViewKind.Spacer
            width: KiraUIFoundation.SizeMode.Fill
            height: KiraUIFoundation.SizeMode.Fill
            flex: 1
            minLength: 0.0
        }
    }
}

Widget Circle() {
    function lower(context: borrow KiraUIFoundation.FoundationUiContext, modifiers: borrow ModifierContext) -> KiraUIFoundation.FoundationView {
        let ignored = context.frameCount
        var circleFill = defaultTextColor()
        if modifiers.hasTheme {
            let tokens = modifiers.theme.tokens()
            circleFill = foundationColor(tokens.foregroundPrimary)
        }
        if modifiers.hasThemeColor {
            circleFill = modifierThemeColor(modifiers.themeColor, modifiers)
        }
        return Surface(
            children: [],
            width: KiraUIFoundation.SizeMode.Fixed(0.0),
            height: KiraUIFoundation.SizeMode.Fixed(0.0),
            flex: 0,
            fill: modifierSurfaceFill(move circleFill, modifiers),
            border: transparentFoundationColor(),
            borderWidth: 0.0,
            radius: 999.0,
            shape: KiraUIFoundation.FoundationShape.Squircle,
            material: KiraUIFoundation.FoundationMaterial.Flat,
            effects: [],
            padding: KiraUIFoundation.EdgeInsets {},
            clipContent: true
        )
    }
}

Widget LinearGradient(start: Color, end: Color) {
    function lower(context: borrow KiraUIFoundation.FoundationUiContext, modifiers: borrow ModifierContext) -> KiraUIFoundation.FoundationView {
        let ignored = context.viewport.width
        var strips: [KiraUIFoundation.FoundationView] = []
        var index = 0
        while index < 12 {
            let ratio = intAsFloat(value: index) / 11.0
                let color = modifierSurfaceFill(foundationColor(lerpColor(start, end, ratio)), modifiers)
            let strip = Surface(
                children: [],
                width: KiraUIFoundation.SizeMode.Fill,
                height: KiraUIFoundation.SizeMode.Fill,
                flex: 1,
                fill: move color,
                border: transparentFoundationColor(),
                borderWidth: 0.0,
                radius: 0.0,
                shape: KiraUIFoundation.FoundationShape.RegularRoundedRect,
                material: KiraUIFoundation.FoundationMaterial.Flat,
                effects: [],
                padding: KiraUIFoundation.EdgeInsets {},
                clipContent: false
            )
            strips.append(move strip)
            index = index + 1
        }
        return Column(
            children: move strips,
            width: KiraUIFoundation.SizeMode.Fill,
            height: KiraUIFoundation.SizeMode.Fill,
            spacing: 0.0,
            padding: KiraUIFoundation.EdgeInsets {},
            crossAxisAlignment: KiraUIFoundation.CrossAlignment.Stretch
        )
    }
}

// A fill-sized wash in a surface role — the band behind a list row, the pill
// under a tab. The themed counterpart to SurfaceTint, which can only be handed a
// color someone else already resolved.
Widget ThemeTint(surface: ThemeSurface, radius: CornerRadius = CornerRadius.None) {
    function lower(context: borrow KiraUIFoundation.FoundationUiContext, modifiers: borrow ModifierContext) -> KiraUIFoundation.FoundationView {
        let ignored = context.frameCount
        return KiraUIFoundation.FoundationView {
            kind: KiraUIFoundation.FoundationViewKind.Surface
            width: KiraUIFoundation.SizeMode.Fill
            height: KiraUIFoundation.SizeMode.Fill
            fill: modifierColor(modifierThemeSurface(surface, modifiers), modifiers)
            radius: cornerRadiusImplementation(radius, modifiers)
        }
    }
}

Widget SurfaceTint(color: Color) {
    function lower(context: borrow KiraUIFoundation.FoundationUiContext, modifiers: borrow ModifierContext) -> KiraUIFoundation.FoundationView {
        let ignored = context.frameCount
        return Surface(
            children: [],
            width: KiraUIFoundation.SizeMode.Fill,
            height: KiraUIFoundation.SizeMode.Fill,
            flex: 0,
            fill: modifierSurfaceFill(foundationColor(color), modifiers),
            border: transparentFoundationColor(),
            borderWidth: 0.0,
            radius: 0.0,
            shape: KiraUIFoundation.FoundationShape.RegularRoundedRect,
            material: KiraUIFoundation.FoundationMaterial.Flat,
            effects: [],
            padding: KiraUIFoundation.EdgeInsets {},
            clipContent: false
        )
    }
}

Widget Padding(length: Float) {
    @Content let content: Any Widget

    function lower(context: borrow KiraUIFoundation.FoundationUiContext, modifiers: borrow ModifierContext) -> KiraUIFoundation.FoundationView {
        let childModifiers = modifierContextForChildren(modifiers)
        return Frame(
            content.lower(context, childModifiers),
            KiraUIFoundation.SizeMode.Fill,
            KiraUIFoundation.SizeMode.Hug,
            0,
            KiraUIFoundation.Alignment.TopLeading,
            uniformInsets(length)
        )
    }
}

// Padding along one axis at a time, in spacing tokens.
//
// Uniform padding was the only kind on offer, so the extremely common "inset the
// row's contents from the panel edge, but do not add height" case had no way to
// say itself, and every such row opened and closed with a FixedGap standing in
// for the padding it actually wanted. A leading gap is not a gap — it is the
// container's inset, and a reader cannot tell the two apart once they are both
// spelled FixedGap.
Widget Inset(
    horizontal: Spacing = Spacing.None,
    vertical: Spacing = Spacing.None,
) {
    @Content let content: Any Widget

    function lower(context: borrow KiraUIFoundation.FoundationUiContext, modifiers: borrow ModifierContext) -> KiraUIFoundation.FoundationView {
        let childModifiers = modifierContextForChildren(modifiers)
        let side = spacingImplementation(horizontal, modifiers)
        let ends = spacingImplementation(vertical, modifiers)
        return Frame(
            content.lower(context, childModifiers),
            KiraUIFoundation.SizeMode.Fill,
            KiraUIFoundation.SizeMode.Hug,
            0,
            KiraUIFoundation.Alignment.TopLeading,
            KiraUIFoundation.EdgeInsets {
                top: ends
                trailing: side
                bottom: ends
                leading: side
            }
        )
    }
}

// Semantic modifiers contribute a typed delta and then lower the receiving
// widget with the resolved context. No FoundationView has been built yet, so
// the value can be consumed by the widget itself and its own child traversal
// can decide which fields continue downstream.
Widget ThemeLayer(theme: Any Theme) {
    @Content let content: Any Widget

    function lower(context: borrow KiraUIFoundation.FoundationUiContext, modifiers: borrow ModifierContext) -> KiraUIFoundation.FoundationView {
        let delta = modifierDeltaTheme(move theme)
        let resolved = modifierContextApply(modifiers, move delta)
        return content.lower(context, resolved)
    }
}

