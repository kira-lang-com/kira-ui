import KiraLayout
import KiraGraphics
import Foundation
import KCoreAnimation

// Design tools quote colors in 8-bit sRGB channels, so authoring a token set
// means writing that conversion somewhere. It belongs here once rather than in
// every application's theme file.

function colorRgb(r: Float, g: Float, b: Float) -> Color {
    return Color {
        r: r / 255.0,
        g: g / 255.0,
        b: b / 255.0,
        a: 1.0
    }
}

function colorRgba(r: Float, g: Float, b: Float, a: Float) -> Color {
    return Color {
        r: r / 255.0,
        g: g / 255.0,
        b: b / 255.0,
        a: a
    }
}

// The same color at a different alpha — a derived token (a tinted selection
// band, a faded wash) stated as the relationship it actually is.
function colorWithAlpha(color: borrow Color, alpha: Float) -> Color {
    return Color {
        r: color.r,
        g: color.g,
        b: color.b,
        a: alpha
    }
}

// The palette, as free functions.
//
// Kira has no static members, and a block-bodied `let Name: Color { … }` member
// is a construct-backed surface a plain `struct` does not have — so `Color.Green`
// is not spellable. A zero-argument function is the form the language offers,
// and it reads the same at the call site: `colorGreen()`.

function colorGreen() -> Color {
    return Color {
        r: 0.34,
        g: 0.85,
        b: 0.52,
        a: 1.0
    }
}

function colorYellow() -> Color {
    return Color {
        r: 0.98,
        g: 0.80,
        b: 0.36,
        a: 1.0
    }
}

function colorBlue() -> Color {
    return Color {
        r: 0.43,
        g: 0.67,
        b: 1.0,
        a: 1.0
    }
}

function colorPurple() -> Color {
    return Color {
        r: 0.65,
        g: 0.40,
        b: 0.95,
        a: 1.0
    }
}

function colorCyan() -> Color {
    return Color {
        r: 0.25,
        g: 0.78,
        b: 0.82,
        a: 1.0
    }
}

function colorWhite() -> Color {
    return Color {
        r: 1.0,
        g: 1.0,
        b: 1.0,
        a: 1.0
    }
}

function colorBeige() -> Color {
    return Color {
        r: 0.96,
        g: 0.95,
        b: 0.93,
        a: 1.0
    }
}

function colorBeigeDark() -> Color {
    return Color {
        r: 0.93,
        g: 0.91,
        b: 0.88,
        a: 1.0
    }
}

function colorTaupe() -> Color {
    return Color {
        r: 0.61,
        g: 0.53,
        b: 0.48,
        a: 1.0
    }
}

function colorBorderSoft() -> Color {
    return Color {
        r: 0.91,
        g: 0.89,
        b: 0.85,
        a: 1.0
    }
}

function colorDarkText() -> Color {
    return Color {
        r: 0.11,
        g: 0.11,
        b: 0.12,
        a: 1.0
    }
}

function colorSecondaryText() -> Color {
    return Color {
        r: 0.56,
        g: 0.56,
        b: 0.58,
        a: 1.0
    }
}

function colorMutedText() -> Color {
    return Color {
        r: 0.69,
        g: 0.68,
        b: 0.66,
        a: 1.0
    }
}

function colorMutedGreen() -> Color {
    return Color {
        r: 0.45,
        g: 0.68,
        b: 0.50,
        a: 1.0
    }
}

function colorMutedBlue() -> Color {
    return Color {
        r: 0.45,
        g: 0.58,
        b: 0.72,
        a: 1.0
    }
}

function colorMutedOrange() -> Color {
    return Color {
        r: 0.76,
        g: 0.58,
        b: 0.40,
        a: 1.0
    }
}

enum Material {
    Flat
    Frosted
    LayeredGlass
    // What is behind the WINDOW, blurred and tinted by the desktop compositor:
    // the material a platform sidebar is made of.
    //
    // Frosted and LayeredGlass blur what the application drew underneath them.
    // This one does not blur anything the application can see — the surface
    // becomes a hole in the window and the compositor fills it with everything
    // under the window, which is the only place that view exists. It needs a
    // transparent window (RunWidgetInteractiveApp(transparent: true)); in an
    // ordinary one there is no hole to fill and it draws flat.
    WindowBackdrop
}

enum SurfaceShape {
    RegularRoundedRect
    Squircle
}

enum ContentMargins {
    automatic: Float = 0.0
    fixed: Float
}

enum FontWeight {
    Regular
    Medium
    SemiBold
    Bold
    // A point on the variable font's weight axis, for a label carried between
    // two of the named weights by the same value that moves everything else.
    Axis: Float
}

construct Widget {
    @Required let body: Any Widget

    // Emit the retained-tree description this widget reconciles into.
    //
    // The sole lowering: a widget produces the `CALayerDescription` the
    // compositor reconciles into its retained `CALayerTree`, so a rebuild sets
    // properties on layers that were already there and every change animates.
    // Content leaves emit their content; containers emit sublayers; modifier
    // layers mutate the description their child produced. Consuming: a widget
    // tree is single-owner and produces its description once.
    @Consuming
    function describe(context: borrow BuildContext, modifiers: borrow ModifierContext) -> CALayerDescription {
        return self.body.describe(context, modifiers)
    }
}

function surfaceMaterialSubtle() -> SurfaceTint {
    return SurfaceTint(
        color: Color {
            r: 0.16,
            g: 0.19,
            b: 0.26,
            a: 0.88
        }
    )
}

function transparentFoundationColor() -> FoundationColor {
    return foundationRgba(0.0, 0.0, 0.0, 0.0)
}

// The tokens in effect for this widget: the theme in effect resolves them, and
// the library's own theme is in effect when the application applied none.
function modifierTokens(modifiers: borrow ModifierContext) -> ThemeTokens {
    return modifierTheme(modifiers).tokens()
}

function primaryColorAsColor(color: borrow PrimaryColor, tokens: borrow ThemeTokens) -> Color {
    match color {
        Primary -> return tokens.foreground.primary
        Secondary -> return tokens.foreground.secondary
        Tertiary -> return tokens.foreground.tertiary
        Quaternary -> return tokens.foreground.quaternary
        Inverse -> return tokens.foreground.inverse
        Success -> return tokens.tint.success
        Warning -> return tokens.tint.warning
        Danger -> return tokens.tint.danger
        Accent -> return tokens.tint.accent
        Red -> return tokens.palette.red
        Orange -> return tokens.palette.orange
        Yellow -> return tokens.palette.yellow
        Green -> return tokens.palette.green
        Mint -> return tokens.palette.mint
        Teal -> return tokens.palette.teal
        Cyan -> return tokens.palette.cyan
        Blue -> return tokens.palette.blue
        Indigo -> return tokens.palette.indigo
        Purple -> return tokens.palette.purple
        Pink -> return tokens.palette.pink
        Brown -> return tokens.palette.brown
        Gray -> return tokens.palette.gray
        Black -> return Color { r: 0.0, g: 0.0, b: 0.0, a: 1.0 }
        White -> return Color { r: 1.0, g: 1.0, b: 1.0, a: 1.0 }
        Clear -> return Color { r: 0.0, g: 0.0, b: 0.0, a: 0.0 }
    }
}

function modifierPrimaryColor(
    color: PrimaryColor,
    modifiers: borrow ModifierContext,
) -> FoundationColor {
    let tokens = modifierTokens(modifiers)
    // SwiftUI's `.tint` is the accent of everything under it, so `.Accent`
    // names the tint wherever one was set.
    if color == .Accent && modifiers.hasTint && modifiers.tint != .Accent {
        return foundationColor(primaryColorAsColor(modifiers.tint, tokens))
    }
    return foundationColor(primaryColorAsColor(color, tokens))
}

function modifierTextColor(modifiers: borrow ModifierContext) -> FoundationColor {
    if modifiers.hasTextColor {
        return foundationColor(modifiers.textColor)
    }
    if modifiers.hasForegroundColor {
        return modifierPrimaryColor(modifiers.foregroundColor, modifiers)
    }
    // The primary ink of the tokens IN EFFECT — the applied theme's, or the
    // default style's when none was applied. A separate hardcoded ink for the
    // unthemed case is how an application with no theme drew near-white text on
    // the default style's light surface.
    return foundationColor(modifierTokens(modifiers).foreground.primary)
}

function modifierBackgroundStyle(
    style: borrow BackgroundStyle,
    modifiers: borrow ModifierContext,
) -> FoundationColor {
    let tokens = modifierTokens(modifiers)
    match style {
        Clear -> return transparentFoundationColor()
        Window -> return foundationColor(tokens.background.canvas)
        Surface -> return foundationColor(tokens.background.surface)
        Raised -> return foundationColor(tokens.background.raised)
        Control -> return foundationColor(tokens.fill.control)
        Overlay -> return foundationColor(tokens.background.overlay)
        Accent -> return foundationColor(tokens.tint.accent)
        Selection -> return foundationColor(tokens.fill.selection)
        Hover -> return foundationColor(tokens.fill.hover)
    }
}

function modifierSurfaceBorder(
    fallback: FoundationColor,
    modifiers: borrow ModifierContext,
) -> FoundationColor {
    if modifiers.hasThemeBorder {
        let tokens = modifierTokens(modifiers)
        match modifiers.themeBorder {
            Subtle -> return modifierColor(foundationColor(tokens.border.subtle.color), modifiers)
            Standard -> return modifierColor(foundationColor(tokens.border.standard.color), modifiers)
            Strong -> return modifierColor(foundationColor(tokens.border.strong.color), modifiers)
            Focus -> return modifierColor(foundationColor(tokens.border.focus.color), modifiers)
        }
    }
    return colorWithOpacity(fallback, modifiers.opacity)
}

function modifierSurfaceFill(
    fallback: FoundationColor,
    modifiers: borrow ModifierContext,
) -> FoundationColor {
    if modifiers.hasFill {
        return modifierColor(foundationColor(modifiers.fillColor), modifiers)
    }
    if modifiers.hasBackgroundStyle {
        return modifierColor(modifierBackgroundStyle(modifiers.backgroundStyle, modifiers), modifiers)
    }
    return colorWithOpacity(fallback, modifiers.opacity)
}

// What the window itself is painted in: the canvas of the theme in effect.
function modifierCanvas(modifiers: borrow ModifierContext) -> FoundationColor {
    return modifierColor(foundationColor(modifierTokens(modifiers).background.canvas), modifiers)
}

function foundationColor(color: Color) -> FoundationColor {
    return foundationRgba(color.r, color.g, color.b, color.a)
}

function foundationFontWeight(weight: borrow FontWeight) -> Float {
    match weight {
        Regular -> return 400.0
        // SF Pro's Medium instance sits at 510 on its weight axis, not 500.
        Medium -> return 510.0
        SemiBold -> return 600.0
        Bold -> return 700.0
        Axis(value) -> return value
    }
}

// The weight `amount` of the way from one weight to another, along the axis.
function fontWeightBetween(from: borrow FontWeight, to: borrow FontWeight, amount: Float) -> FontWeight {
    let start = foundationFontWeight(from)
    return .Axis(start + (foundationFontWeight(to) - start) * amount)
}

function foundationMaterial(material: borrow Material) -> FoundationMaterial {
    match material {
        Flat -> return .Flat
        Frosted -> return .Frosted
        LayeredGlass -> return .LiquidGlass
        WindowBackdrop -> return .WindowBackdrop
    }
}

function foundationShape(shape: SurfaceShape) -> FoundationShape {
    match shape {
        RegularRoundedRect -> return .RegularRoundedRect
        Squircle -> return .Squircle
    }
}

function uniformInsets(length: Float) -> EdgeInsets {
    return EdgeInsets {
        top: length,
        trailing: length,
        bottom: length,
        leading: length
    }
}

// `.automatic` is the column's layout margin with any extra added on top;
// `.fixed` is exactly the length it names.
function contentMarginsInset(margins: ContentMargins, modifiers: borrow ModifierContext) -> Float {
    match margins {
        automatic(extra) -> {
            var inset = resolvedContentMargin(modifiers) + extra
            if inset < 0.0 {
                inset = 0.0
            }
            return inset
        }
        fixed(length) -> {
            if length < 0.0 {
                return 0.0
            }
            return length
        }
    }
}

// Each child's description, under the same inherited modifier context a child
// receives.
// under the same inherited modifier context a lowered child receives.
function describedChildren(
    context: borrow BuildContext,
    modifiers: borrow ModifierContext,
    widgets: [Any Widget],
) -> [CALayerDescription] {
    var children: [CALayerDescription] = []
    let childModifiers = modifierContextForChildren(modifiers)
    for widget in widgets {
        let child = widget.describe(context, childModifiers)
        if !describesNothing(child) {
            children.append(move child)
        }
    }
    return children
}

function uiLerp(a: Float, b: Float, t: Float) -> Float {
    return a + (b - a) * t
}

function lerpColor(start: borrow Color, end: borrow Color, t: Float) -> Color {
    return Color {
        r: uiLerp(start.r, end.r, t),
        g: uiLerp(start.g, end.g, t),
        b: uiLerp(start.b, end.b, t),
        a: uiLerp(start.a, end.a, t)
    }
}

function colorWithOpacity(color: borrow FoundationColor, opacity: Float) -> FoundationColor {
    return foundationRgba(color.r, color.g, color.b, color.a * opacity)
}

function effectWithOpacity(effect: borrow FoundationEffect, opacity: Float) -> FoundationEffect {
    match effect {
        BackdropGlow(glow) -> {
            return .BackdropGlow(Glow {
                color: colorWithOpacity(glow.color, opacity),
                radius: glow.radius,
                intensity: glow.intensity
            })
        }

        LayerGlow(glow) -> {
            return .LayerGlow(Glow {
                color: colorWithOpacity(glow.color, opacity),
                radius: glow.radius,
                intensity: glow.intensity
            })
        }
    }
}

// Structural modifiers rebuild one FoundationView node to change its layout or
// surface shape. Their children are transferred unchanged; semantic modifiers
// are consumed before lowering and never walk a completed descendant tree.

function identityEffects(effects: [FoundationEffect]) -> [FoundationEffect] {
    return effects
}

function modifierColor(
    color: FoundationColor,
    modifiers: borrow ModifierContext,
) -> FoundationColor {
    return colorWithOpacity(color, modifiers.opacity)
}

function modifierEffects(
    effects: [FoundationEffect],
    modifiers: borrow ModifierContext,
) -> [FoundationEffect] {
    if modifiers.opacity == 1.0 {
        return effects
    }
    var adjusted: [FoundationEffect] = []
    for effect in effects {
        adjusted.append(effectWithOpacity(effect, modifiers.opacity))
    }
    return adjusted
}

// A view with a handful of fields replaced, and every other field carried.
//
// ONE list of the fields, because seven of them was seven chances to forget.
// Each of the modifiers below used to rebuild the view field by field, and every
// field added to `FoundationView` after those were written was dropped by all of
// them -- silently, because a dropped field reads as its default rather than as
// an error.
//
// What that cost: a TextureView lost the texture it was crossfading TOWARDS the
// moment anything gave it a width, so a swipe between two components' sidebars
// ran the whole transition and showed nothing move. A gradient lost its end
// color, glass lost its material and its blur, a scroll region lost the fact
// that it scrolls. All the same bug, and none of them visible in the modifier
// that caused it.
construct SurfacePaddingLayer(value: Float) extends Widget {
    let content: some Widget


    function describe(context: borrow BuildContext, modifiers: borrow ModifierContext) -> CALayerDescription {
        return insetDescription(content.describe(context, modifierContextForChildren(modifiers)), value)
    }
}

construct ContentMarginsLayer(value: ContentMargins) extends Widget {
    let content: some Widget


    function describe(context: borrow BuildContext, modifiers: borrow ModifierContext) -> CALayerDescription {
        return insetDescription(content.describe(context, modifierContextForChildren(modifiers)), contentMarginsInset(value, modifiers))
    }
}

construct WidthLayer(value: Float) extends Widget {
    let content: some Widget


    function describe(context: borrow BuildContext, modifiers: borrow ModifierContext) -> CALayerDescription {
        var described = content.describe(context, modifierContextForChildren(modifiers))
        described.layout.fixedWidth = value
        described.layout.widthFill = false
        return described
    }
}

construct FillWidthLayer() extends Widget {
    let content: some Widget


    function describe(context: borrow BuildContext, modifiers: borrow ModifierContext) -> CALayerDescription {
        var described = content.describe(context, modifierContextForChildren(modifiers))
        described.layout.widthFill = true
        described.layout.fixedWidth = -1.0
        return described
    }
}

construct ScenePaddingLayer() extends Widget {
    let content: some Widget


    function describe(context: borrow BuildContext, modifiers: borrow ModifierContext) -> CALayerDescription {
        let described = content.describe(context, modifierContextForChildren(modifiers))
        if modifiers.hasContentMargin {
            return insetDescription(move described, modifiers.contentMargin)
        }
        return described
    }
}

construct FillHeightLayer() extends Widget {
    let content: some Widget


    function describe(context: borrow BuildContext, modifiers: borrow ModifierContext) -> CALayerDescription {
        var described = content.describe(context, modifierContextForChildren(modifiers))
        described.layout.heightFill = true
        described.layout.fixedHeight = -1.0
        return described
    }
}

construct HeightLayer(value: Float) extends Widget {
    let content: some Widget


    function describe(context: borrow BuildContext, modifiers: borrow ModifierContext) -> CALayerDescription {
        var described = content.describe(context, modifierContextForChildren(modifiers))
        described.layout.fixedHeight = value
        described.layout.heightFill = false
        return described
    }
}

function scaledTypography(
    font: FontImplementation,
    modifiers: borrow ModifierContext,
) -> FontImplementation {
    let scale = resolvedControlMetrics(modifiers).typeScale
    return FontImplementation {
        size: font.size * scale,
        weight: font.weight,
        lineHeight: font.lineHeight * scale,
        tracking: font.tracking
    }
}

// Fill and Fixed both had a modifier; Hug did not, so a widget that fills by
// default could never be told to shrink to its content without exposing its own
// SizeMode argument.
construct HugWidthLayer() extends Widget {
    let content: some Widget


    function describe(context: borrow BuildContext, modifiers: borrow ModifierContext) -> CALayerDescription {
        var described = content.describe(context, modifierContextForChildren(modifiers))
        described.layout.widthFill = false
        return described
    }
}

construct HugHeightLayer() extends Widget {
    let content: some Widget


    function describe(context: borrow BuildContext, modifiers: borrow ModifierContext) -> CALayerDescription {
        var described = content.describe(context, modifierContextForChildren(modifiers))
        described.layout.heightFill = false
        return described
    }
}

// A role's font, at the size the region around it is drawn in.
//
// The size class scales the WHOLE scale rather than each role separately, so the
// relationships a theme authored — a header quieter than a label, a title well
// above both — survive being drawn small. A per-role size per class would let
// those relationships drift apart between classes, which is the thing a type
// scale exists to prevent.
function typographyImplementation(
    style: TypographyStyle,
    modifiers: borrow ModifierContext,
) -> FontImplementation {
    return scaledTypography(modifierTheme(modifiers).typography(style), modifiers)
}

function cornerRadiusImplementation(
    style: CornerRadius,
    modifiers: borrow ModifierContext,
) -> Float {
    return modifierTheme(modifiers).cornerRadius(style)
}

function spacingImplementation(
    style: Spacing,
    modifiers: borrow ModifierContext,
) -> Float {
    return modifierTheme(modifiers).spacing(style)
}

construct Text(content: String) extends Widget {

    function describe(context: borrow BuildContext, modifiers: borrow ModifierContext) -> CALayerDescription {
        var textSize = 16.0
        var textWeight = 400.0
        if modifiers.hasFont {
            textSize = modifiers.fontSize
            textWeight = foundationFontWeight(modifiers.fontWeight)
        } else if modifiers.hasTypography {
            let selected = typographyImplementation(modifiers.typography, modifiers)
            textSize = selected.size
            textWeight = foundationFontWeight(selected.weight)
        } else {
            let selected = typographyImplementation(.body, modifiers)
            textSize = selected.size
            textWeight = foundationFontWeight(selected.weight)
        }
        let measured = foundationTextMeasure(content, textSize, textWeight)
        return CALayerDescription {
            layout: CALayoutIntent {
                widthFill: false,
                heightFill: false,
                intrinsicWidth: measured.width,
                intrinsicHeight: measured.height
            },
            content: .Text(CAText {
                content: content,
                color: caColorFromFoundation(modifierColor(modifierTextColor(modifiers), modifiers)),
                size: textSize,
                weight: textWeight,
                inkLeft: foundationTextRunInkLeft(content: content, size: textSize, weight: textWeight),
                inkRight: foundationTextRunInkRight(content: content, size: textSize, weight: textWeight),
                inkTop: foundationTextRunInkTop(content: content, size: textSize, weight: textWeight),
                inkBottom: foundationTextRunInkBottom(content: content, size: textSize, weight: textWeight),
                wraps: true
            })
        }
    }
}

enum ButtonRole {
    Normal
    Destructive
}

// Button fills with the control token (or the danger tint for a destructive
// role); the cascading `.foregroundColor(...)` names the LABEL ink, exactly as
// it does on a bare Text. Its label is an implementation detail of the control,
// so it receives the presentation context explicitly rather than inheriting
// through the general child traversal.
// SwiftUI's button is a LABEL and an action, and the label is a view:
//
//     Button(action: copy) {
//         Label("Copy", systemImage: .DocOnDoc)
//     }
//
// with `Button("Copy", action: copy)` as the shorthand for the case where the
// label is only a run of text. Those are not two widgets — the second builds the
// first's label out of a `Text` and hands it straight over — so they are one
// name with two ways in, which is what an `init` on a construct-backed
// declaration is. A widget that only ever took a String could not put a glyph,
// a badge or a two-line label on a button at all.
construct Button(
    role: ButtonRole = .Normal,
    action: () -> Void,
) extends Widget {
    let label: some Widget

    init(title: String, action: () -> Void) {
        return Button(role: .Normal, action: action) {
            Text(content: title)
        }
    }

    init(title: String, role: ButtonRole, action: () -> Void) {
        return Button(role: role, action: action) {
            Text(content: title)
        }
    }


    function describe(context: borrow BuildContext, modifiers: borrow ModifierContext) -> CALayerDescription {
        let k = kiraUiTapSeqKey()
        // In a menu a button is the menu's row or action: no fill of its own,
        // the highlight is the menu's, and choosing it dismisses the menu.
        match modifiers.controlPresentation {
            MenuRow -> {
                kiraUiLayerActionRegister(k, kiraUiMenuChooseFn(action))
                match role {
                    Normal -> {}
                    // A destructive row is set in the danger ink, glyph and title.
                    Destructive -> {
                        return menuRowDescription(context, modifierContextApply(modifiers, modifierDeltaForegroundColor(.Danger)), k, label)
                    }
                }
                return menuRowDescription(context, modifiers, k, label)
            }
            MenuAction -> {
                kiraUiLayerActionRegister(k, kiraUiMenuChooseFn(action))
                return menuActionDescription(context, modifiers, k, label)
            }
            Toolbar -> {
                kiraUiLayerActionRegister(k, action)
                return toolbarButtonDescription(context, modifiers, k, label)
            }
            InsetGrouped -> {
                kiraUiLayerActionRegister(k, action)
                var row = label
                    .foregroundColor(insetGroupedButtonInk(role, modifiers.disabled))
                    .describe(context, modifiers)
                row.hittable = !modifiers.disabled
                row.hitKey = k
                return row
            }
            Sidebar -> {}
            Standalone -> {}
        }
        kiraUiLayerActionRegister(k, action)
        let tokens = modifierTokens(modifiers)
        var buttonFill = foundationColor(tokens.fill.control)
        match role {
            Normal -> {}
            Destructive -> {
                buttonFill = foundationColor(tokens.tint.danger)
            }
        }
        var labelModifiers = modifierContextForPresentation(modifiers)
        if modifiers.hasForegroundColor == false && modifiers.hasTextColor == false {
            var labelColor = tokens.foreground.inverse
            if colorIsDark(buttonFill) {
                labelColor = tokens.foreground.primary
            }
            let labelDelta = modifierDeltaTextColor(move labelColor)
            labelModifiers = modifierContextApply(labelModifiers, move labelDelta)
        }
        let radius = cornerRadiusImplementation(.Small, modifiers)
        let borderWidth = buttonBorderWidth(buttonFill)
        var button = CALayerDescription {
            hittable: !modifiers.disabled,
            hitKey: k,
            cornerRadius: radius,
            content: .Solid(CASolid {
                fill: caColorFromFoundation(modifierSurfaceFill(move buttonFill, modifiers)),
                borderWidth: borderWidth,
                cornerRadius: radius
            }),
            sublayers: [label.describe(context, labelModifiers)]
        }
        // Pressed, it comes up to meet the pointer and leans after it as glass
        // does; it has no glass to light.
        if !modifiers.disabled {
            interactivePress(button, k, context)
        }
        return button
    }
}

// A button's ink in a grouped list, where the ink is all it has: the accent, the
// danger tint for a destructive role, and the tertiary ink while disabled.
function insetGroupedButtonInk(role: ButtonRole, disabled: Bool) -> PrimaryColor {
    if disabled {
        return .Tertiary
    }
    match role {
        Normal -> return .Accent
        Destructive -> return .Danger
    }
}

// A button on the window's bar: its label in the bar's ink on no fill of its
// own, because the glass under its group is its surface. Its box is the whole
// of its piece of glass -- as tall, a symbol centered in a square of it, words
// held off its ends -- so a press anywhere on the glass is a press on it. Held
// down, it is the glass under it that answers.
function toolbarButtonDescription(
    context: borrow BuildContext,
    modifiers: borrow ModifierContext,
    key: Int,
    label: borrow Any Widget,
) -> CALayerDescription {
    let metrics = windowChromeMetrics
    var described = label.describe(context, modifierContextForPresentation(modifiers))
    described.layout.widthFill = false
    described.layout.heightFill = false
    let inset = toolbarLabelInset(described, metrics)
    return CALayerDescription {
        hittable: !modifiers.disabled,
        hitKey: key,
        opacity: modifiers.disabled ? 0.4 : 1.0,
        layout: CALayoutIntent {
            widthFill: false,
            heightFill: false,
            fixedHeight: metrics.itemHeight,
            minWidth: metrics.itemWidth,
            paddingLeading: inset,
            paddingTrailing: inset,
            alignment: Point { x: 0.5, y: 0.5 }
        },
        sublayers: [described]
    }
}

// How far a bar button holds its label off its ends: a symbol sits in the
// square the item's width makes and needs nothing more, words take the bar's
// label inset.
function toolbarLabelInset(label: borrow CALayerDescription, metrics: borrow WindowChromeMetrics) -> Float {
    if drawsOnlySymbol(label) {
        return 0.0
    }
    return metrics.labelInset
}

// Whether a description draws one symbol and nothing else: the glyph itself,
// or boxes around it that draw nothing of their own.
function drawsOnlySymbol(layer: borrow CALayerDescription) -> Bool {
    match layer.content {
        Icon(i) -> return true
        Empty -> {
            if layer.sublayers.count != 1 {
                return false
            }
            return drawsOnlySymbol(layer.sublayers[0])
        }
        Text(t) -> return false
        Solid(s) -> return false
        Glass(g) -> return false
        Gradient(r) -> return false
        Texture(x) -> return false
    }
}

// Whether a fill is dark enough that light ink reads on it. The usual weighted
// luminance, so a saturated accent answers the way the eye does rather than the
// way an average of three channels would.
function colorIsDark(fill: borrow FoundationColor) -> Bool {
    return (0.2126 * fill.r + 0.7152 * fill.g + 0.0722 * fill.b) < 0.5
}

// The pressable box a button is, around a label that has already been lowered:
// the ink the label is set in depends on the FILL, and the fill is the button's,
// so the caller resolves the two together and this takes the result.
function buttonBorderWidth(fill: borrow FoundationColor) -> Float {
    if fill.a <= 0.0 {
        return 0.0
    }
    return 1.0
}

construct AppSurface() extends Widget {
    let content: some Widget


    // The canvas reaches the column's edges; what stands on it is held inside
    // the column's layout margin, the way a list or form adopts the margins of
    // the column it fills. Outside any column there is no margin to adopt, so
    // the window's own surface runs edge to edge.
    function describe(context: borrow BuildContext, modifiers: borrow ModifierContext) -> CALayerDescription {
        var described = content.describe(context, modifierContextForChildren(modifiers))
        if modifiers.hasContentMargin {
            described = insetDescription(move described, modifiers.contentMargin)
        }
        return CALayerDescription {
            content: .Solid(CASolid {
                fill: caColorFromFoundation(modifierCanvas(modifiers))
            }),
            sublayers: [described]
        }
    }
}

// A determinate progress bar. The fill takes the cascading `.tint(...)` when
// one is set and the accent otherwise, like a slider's.
construct Progress(value: Float) extends Widget {

    // A thin track across the room it is offered, filled with the tint up to
    // the value: two shares of one row, so the fill is a fraction of whatever
    // width the track ends up.
    function describe(context: borrow BuildContext, modifiers: borrow ModifierContext) -> CALayerDescription {
        let radius = progressTrackHeight / 2.0
        let filledShare = Int(controlClamp01(value) * 1000.0 + 0.5)
        let filled = CALayerDescription {
            layout: CALayoutIntent {
                flex: filledShare
            },
            cornerRadius: radius,
            content: .Solid(CASolid {
                fill: caColorFromFoundation(modifierColor(controlActiveColor(modifiers), modifiers)),
                cornerRadius: radius,
                shapeKind: 1
            })
        }
        return CALayerDescription {
            layout: CALayoutIntent {
                axis: .Row,
                heightFill: false,
                fixedHeight: progressTrackHeight,
                flex: 1
            },
            cornerRadius: radius,
            content: .Solid(CASolid {
                fill: caColorFromFoundation(modifierColor(foundationColor(themeAdaptiveColor(progressTrack, modifierTheme(modifiers).appearance())), modifiers)),
                cornerRadius: radius,
                shapeKind: 1
            }),
            sublayers: [filled, CALayerDescription {
                layout: CALayoutIntent {
                    flex: 1000 - filledShare
                }
            }]
        }
    }
}

construct Spacer() extends Widget {

    // A flexing gap: no content, it takes the leftover main-axis space.
    function describe(context: borrow BuildContext, modifiers: borrow ModifierContext) -> CALayerDescription {
        return CALayerDescription {
            layout: CALayoutIntent {
                flex: 1
            }
        }
    }
}

construct Circle() extends Widget {

    // A capsule in a square box: the unbounded radius comes out at half the
    // side.
    function describe(context: borrow BuildContext, modifiers: borrow ModifierContext) -> CALayerDescription {
        return shapeDescription(context, modifiers, containerShapeUnbounded(), 0)
    }
}

// Which way a gradient runs. The application names a direction rather than an
// angle, because these are the ones a layout can answer without knowing how
// large the surface came out — an angle over a box whose aspect changes is a
// gradient that shears when the window is resized.
enum GradientDirection {
    Down
    Across
    Diagonal
}

function foundationGradient(direction: borrow GradientDirection) -> FoundationGradient {
    match direction {
        Down -> return .Down
        Across -> return .Across
        Diagonal -> return .Diagonal
    }
}

// A fade from one color to another, across the space it is given.
//
//     LinearGradient(start: colorPurple(), end: colorBlue())
//     LinearGradient(start: top, end: bottom, direction: .Across)
//
// ONE surface, blended per corner by the compositor. It used to be a column of
// twelve strips, which is twelve quads, a visible band at every seam, and a
// gradient that could only ever run downwards.
construct LinearGradient(
    start: Color,
    end: Color,
    direction: GradientDirection = .Down,
    radius: CornerRadius = .None,
) extends Widget {

    function describe(context: borrow BuildContext, modifiers: borrow ModifierContext) -> CALayerDescription {
        return CALayerDescription {
            cornerRadius: cornerRadiusImplementation(radius, modifiers),
            content: .Gradient(CAGradient {
                start: caColorFromFoundation(modifierColor(foundationColor(start), modifiers)),
                end: caColorFromFoundation(modifierColor(foundationColor(end), modifiers)),
                axis: foundationLayerGradientAxis(foundationGradient(direction))
            })
        }
    }
}

// A fill-sized wash in a background style — the band behind a list row, the pill
// under a tab. The themed counterpart to SurfaceTint, which can only be handed a
// color someone else already resolved.
construct BackgroundFill(style: BackgroundStyle, radius: CornerRadius = .None) extends Widget {

    function describe(context: borrow BuildContext, modifiers: borrow ModifierContext) -> CALayerDescription {
        let cr = cornerRadiusImplementation(radius, modifiers)
        return CALayerDescription {
            cornerRadius: cr,
            content: .Solid(CASolid {
                fill: caColorFromFoundation(modifierColor(modifierBackgroundStyle(style, modifiers), modifiers)),
                cornerRadius: cr
            })
        }
    }
}

construct SurfaceTint(color: Color) extends Widget {

    function describe(context: borrow BuildContext, modifiers: borrow ModifierContext) -> CALayerDescription {
        return CALayerDescription {
            content: .Solid(CASolid {
                fill: caColorFromFoundation(modifierSurfaceFill(foundationColor(color), modifiers))
            })
        }
    }
}

// A container's own inset, in spacing tokens, one axis at a time.
//
// This is not padding: padding is a length someone chose at a call site, and
// every one of them drifts. An inset states which spacing STEP a container holds
// its content off its edges by, and the theme decides what that step measures.
construct Inset(
    horizontal: Spacing = .None,
    vertical: Spacing = .None,
) extends Widget {
    let content: some Widget


    // A wrapper that insets the child by one spacing step per axis.
    function describe(context: borrow BuildContext, modifiers: borrow ModifierContext) -> CALayerDescription {
        let side = spacingImplementation(horizontal, modifiers)
        let ends = spacingImplementation(vertical, modifiers)
        let described = content.describe(context, modifierContextForChildren(modifiers))
        let fillsWidth = described.layout.widthFill
        let fillsHeight = described.layout.heightFill
        return CALayerDescription {
            layout: CALayoutIntent {
                widthFill: fillsWidth,
                heightFill: fillsHeight,
                paddingLeading: side,
                paddingTop: ends,
                paddingTrailing: side,
                paddingBottom: ends
            },
            sublayers: [described]
        }
    }
}

// Semantic modifiers contribute a typed delta and then lower the receiving
// widget with the resolved context. No FoundationView has been built yet, so
// the value can be consumed by the widget itself and its own child traversal
// can decide which fields continue downstream.
construct ThemeLayer(theme: Any Theme) extends Widget {
    let content: some Widget


    function describe(context: borrow BuildContext, modifiers: borrow ModifierContext) -> CALayerDescription {
        let delta = modifierDeltaTheme(move theme)
        let resolved = modifierContextApply(modifiers, move delta)
        return content.describe(context, resolved)
    }
}

construct BackgroundStyleLayer(style: BackgroundStyle) extends Widget {
    let content: some Widget


    function describe(context: borrow BuildContext, modifiers: borrow ModifierContext) -> CALayerDescription {
        let delta = modifierDeltaBackgroundStyle(style)
        let resolved = modifierContextApply(modifiers, move delta)
        return content.describe(context, resolved)
    }
}

construct ThemeBorderLayer(border: ThemeBorder) extends Widget {
    let content: some Widget


    function describe(context: borrow BuildContext, modifiers: borrow ModifierContext) -> CALayerDescription {
        let delta = modifierDeltaThemeBorder(border)
        let resolved = modifierContextApply(modifiers, move delta)
        return content.describe(context, resolved)
    }
}

construct ForegroundColorLayer(color: PrimaryColor) extends Widget {
    let content: some Widget


    function describe(context: borrow BuildContext, modifiers: borrow ModifierContext) -> CALayerDescription {
        let delta = modifierDeltaForegroundColor(color)
        let resolved = modifierContextApply(modifiers, move delta)
        return content.describe(context, resolved)
    }
}

// `.backgroundColor(...)` paints a hug-sized wash behind exactly the widget it
// wraps — it never becomes the subtree's surface role, mirroring how a
// background sits behind one view and not its descendants.
construct BackgroundColorLayer(color: PrimaryColor) extends Widget {
    let content: some Widget


    // A wash behind the content: a filled layer carrying the content as its
    // sublayer.
    function describe(context: borrow BuildContext, modifiers: borrow ModifierContext) -> CALayerDescription {
        let resolved = modifierColor(modifierPrimaryColor(color, modifiers), modifiers)
        return CALayerDescription {
            content: .Solid(CASolid { fill: caColorFromFoundation(resolved) }),
            sublayers: [content.describe(context, modifierContextForChildren(modifiers))]
        }
    }
}

construct MaterialLayer(value: Material) extends Widget {
    let content: some Widget


    function describe(context: borrow BuildContext, modifiers: borrow ModifierContext) -> CALayerDescription {
        let delta = modifierDeltaMaterial(value)
        let resolved = modifierContextApply(modifiers, move delta)
        return content.describe(context, resolved)
    }
}

construct DisabledLayer(value: Bool) extends Widget {
    let content: some Widget


    function describe(context: borrow BuildContext, modifiers: borrow ModifierContext) -> CALayerDescription {
        let delta = modifierDeltaDisabled(value)
        let resolved = modifierContextApply(modifiers, move delta)
        return content.describe(context, resolved)
    }
}

construct FocusedLayer(value: Bool) extends Widget {
    let content: some Widget


    function describe(context: borrow BuildContext, modifiers: borrow ModifierContext) -> CALayerDescription {
        let delta = modifierDeltaFocused(value)
        let resolved = modifierContextApply(modifiers, move delta)
        return content.describe(context, resolved)
    }
}

construct BackgroundLayer(fill: Any Widget) extends Widget {
    let content: some Widget


    // The fill is the surface the modifiers describe, drawn behind the content;
    // both share this layer's bounds, fill first so it sits underneath.
    function describe(context: borrow BuildContext, modifiers: borrow ModifierContext) -> CALayerDescription {
        return CALayerDescription {
            sublayers: [
                fill.describe(context, modifiers),
                content.describe(context, modifierContextForChildren(modifiers))
            ]
        }
    }
}

construct CornerRadiusLayer(radius: Float) extends Widget {
    let content: some Widget


    // A clipping surface around the content: its own layer carrying the radius
    // and the clip, with the content as its sublayer.
    function describe(context: borrow BuildContext, modifiers: borrow ModifierContext) -> CALayerDescription {
        return CALayerDescription {
            cornerRadius: radius,
            clipsChildren: true,
            sublayers: [content.describe(context, modifierContextForChildren(modifiers))]
        }
    }
}

construct FontLayer(size: Float, weight: FontWeight) extends Widget {
    let content: some Widget


    function describe(context: borrow BuildContext, modifiers: borrow ModifierContext) -> CALayerDescription {
        let delta = modifierDeltaFont(size, weight)
        let resolved = modifierContextApply(modifiers, move delta)
        return content.describe(context, resolved)
    }
}

construct TypographyLayer(style: TypographyStyle) extends Widget {
    let content: some Widget


    function describe(context: borrow BuildContext, modifiers: borrow ModifierContext) -> CALayerDescription {
        let delta = modifierDeltaTypography(style)
        let resolved = modifierContextApply(modifiers, move delta)
        return content.describe(context, resolved)
    }
}

construct OpacityLayer(value: Float) extends Widget {
    let content: some Widget


    function describe(context: borrow BuildContext, modifiers: borrow ModifierContext) -> CALayerDescription {
        var described = content.describe(context, modifierContextForChildren(modifiers))
        // Compose, so nested `.opacity` multiplies as the cascade does rather
        // than the outer one replacing the inner.
        described.opacity = described.opacity * value
        return described
    }
}

// `.shadow(...)`: cast by the view's own layer, so it takes that layer's
// outline -- a card's continuous corner, a capsule's ends -- rather than the box
// around it, and a layer under glass casts it only past its edge.
construct ShadowLayer(color: Color, radius: Float, x: Float, y: Float) extends Widget {
    let content: some Widget


    function describe(context: borrow BuildContext, modifiers: borrow ModifierContext) -> CALayerDescription {
        var described = content.describe(context, modifierContextForChildren(modifiers))
        described.shadow = CAShadow {
            color: caColorFromFoundation(modifierColor(foundationColor(color), modifiers)),
            radius: radius,
            offset: Point { x: x, y: y }
        }
        return described
    }
}

// `.scaleEffect(...)`: the subtree drawn larger or smaller than it was laid out.
//
// A DEFORMATION rather than a resize, which is the whole distinction. The view
// keeps exactly the space layout gave it and only its pixels move, so scaling a
// row inside a menu cannot reflow the menu — and the transform descends, so the
// row's label and glyph go with it instead of being scaled one by one.
//
// It scales about `anchor`, the subtree's own center unless it names another
// point, as SwiftUI's `scaleEffect(_:anchor:)` does.
// `.rotationEffect(...)`: the subtree's leaves drawn turned about their centers.
//
// Drawing state, so a turning glyph keeps the space layout gave it and cannot
// reflow the row it is in — which is the whole reason a chevron can be animated
// at all. A chevron that resized its row as it turned would move every label
// beside it, and that is what swapping one glyph for another did.
construct RotationLayer(radians: Float) extends Widget {
    let content: some Widget


    function describe(context: borrow BuildContext, modifiers: borrow ModifierContext) -> CALayerDescription {
        var described = content.describe(context, modifierContextForChildren(modifiers))
        described.rotation = radians
        return described
    }
}

construct ScaleLayer(value: Float, anchor: StackAlignment = .Center) extends Widget {
    let content: some Widget


    function describe(context: borrow BuildContext, modifiers: borrow ModifierContext) -> CALayerDescription {
        var described = content.describe(context, modifierContextForChildren(modifiers))
        described.scaleX = value
        described.scaleY = value
        described.anchorPoint = stackAlignmentUnitPoint(anchor)
        return described
    }
}

construct MinHeightLayer(value: Float) extends Widget {
    let content: some Widget


    function describe(context: borrow BuildContext, modifiers: borrow ModifierContext) -> CALayerDescription {
        var described = content.describe(context, modifierContextForChildren(modifiers))
        described.layout.minHeight = value
        return described
    }
}

construct MinWidthLayer(value: Float) extends Widget {
    let content: some Widget


    function describe(context: borrow BuildContext, modifiers: borrow ModifierContext) -> CALayerDescription {
        var described = content.describe(context, modifierContextForChildren(modifiers))
        described.layout.minWidth = value
        return described
    }
}

construct MaxWidthLayer(value: Float) extends Widget {
    let content: some Widget


    function describe(context: borrow BuildContext, modifiers: borrow ModifierContext) -> CALayerDescription {
        var described = content.describe(context, modifierContextForChildren(modifiers))
        described.layout.maxWidth = value
        return described
    }
}

construct SizeLayer(value: Float) extends Widget {
    let content: some Widget


    function describe(context: borrow BuildContext, modifiers: borrow ModifierContext) -> CALayerDescription {
        var described = content.describe(context, modifierContextForChildren(modifiers))
        described.layout.fixedWidth = value
        described.layout.fixedHeight = value
        described.layout.widthFill = false
        described.layout.heightFill = false
        return described
    }
}

construct FillLayer(color: Color) extends Widget {
    let content: some Widget


    function describe(context: borrow BuildContext, modifiers: borrow ModifierContext) -> CALayerDescription {
        let delta = modifierDeltaFill(move color)
        let resolved = modifierContextApply(modifiers, move delta)
        return content.describe(context, resolved)
    }
}

construct TextColorLayer(color: Color) extends Widget {
    let content: some Widget


    function describe(context: borrow BuildContext, modifiers: borrow ModifierContext) -> CALayerDescription {
        let delta = modifierDeltaTextColor(move color)
        let resolved = modifierContextApply(modifiers, move delta)
        return content.describe(context, resolved)
    }
}

construct SurfaceBorderLayer(color: Color, width: Float) extends Widget {
    let content: some Widget


    function describe(context: borrow BuildContext, modifiers: borrow ModifierContext) -> CALayerDescription {
        var described = content.describe(context, modifierContextForChildren(modifiers))
        described.borderColor = caColorFromFoundation(foundationColor(move color))
        described.borderWidth = width
        return described
    }
}

// A hairline between two things.
//
// Its color and its thickness are the theme's border tokens, and how far it is
// held off the edges it runs between is the size class's — leading and trailing
// separately, because a grouped list insets its separators to the label column
// on one side and runs them to the edge on the other. `.themeBorder(...)` picks
// which border it is drawn in.
//
// The inset lives on the divider rather than on whatever encloses it, so a
// section, a sidebar and a toolbar all divide the same way without any of them
// restating it.
construct Divider() extends Widget {

    // A hairline across whatever holds it: the border's width tall, in the
    // border's color.
    function describe(context: borrow BuildContext, modifiers: borrow ModifierContext) -> CALayerDescription {
        let border = modifierResolvedBorder(modifiers)
        let line = CALayerDescription {
            layout: CALayoutIntent {
                heightFill: false,
                fixedHeight: border.width
            },
            content: .Solid(CASolid {
                fill: caColorFromFoundation(modifierSurfaceFill(foundationColor(border.color), modifiers))
            })
        }
        // In a menu a divider is a GROUP BOUNDARY, and that is more than a line.
        // Measured off the platform's menu (Examples/liquid-glass-menu): rows
        // inside a group sit on a 42pt pitch, rows either side of a separator on
        // 64 — so the separator is a rule with air above and below it, inset
        // from each edge rather than running edge to edge.
        if modifiers.controlPresentation == .MenuRow {
            let metrics = resolvedControlMetrics(modifiers)
            return CALayerDescription {
                layout: CALayoutIntent {
                    heightFill: false,
                    paddingLeading: metrics.menuDividerInset,
                    paddingTop: metrics.menuDividerVerticalInset,
                    paddingTrailing: metrics.menuDividerInset,
                    paddingBottom: metrics.menuDividerVerticalInset
                },
                sublayers: [line]
            }
        }
        return line
    }
}

// The border a widget is drawn in: the named `.themeBorder(...)` when one is in
// effect, the subtle hairline otherwise. Color and width together, because a
// border is both.
function modifierResolvedBorder(modifiers: borrow ModifierContext) -> ResolvedBorder {
    let tokens = modifierTokens(modifiers)
    if modifiers.hasThemeBorder == false {
        return tokens.border.subtle
    }
    match modifiers.themeBorder {
        Subtle -> return tokens.border.subtle
        Standard -> return tokens.border.standard
        Strong -> return tokens.border.strong
        Focus -> return tokens.border.focus
    }
}
