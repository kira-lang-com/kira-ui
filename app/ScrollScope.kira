import Foundation
import Ember
import KiraLayout
import KCoreAnimation

// A scroll view's scope while its content is described, the page it claims,
// and the drags and wheel turns it takes (see Scroll.kira).

public struct ScrollScope {
    var scope: Number = 0
    var built: Number = 0
    // Whether the scope is a stack's page, whose first scroll view is the
    // page's own -- running under the bar, `barInset` deep, and carrying the
    // page's large title -- and whether one has claimed it.
    var page: Bool = false
    var pageTaken: Bool = false
    var barInset: Number = 0.0
    // The search field the page sets under its title, as a phone's does.
    var search: WindowSearch? = .None
}

// What a page hands the scroll view that claims it: its large title, empty
// when it sets none, how deep the bar stands over the page's top edge, and
// the search field it sets under the title.
public struct ScrollPage {
    var title: String = ""
    var barInset: Number = 0.0
    var search: WindowSearch? = .None
}

public function scrollScopeEnsure() {
    if !ambientStateHas(StateSlot.scrollScope) {
        ambientStatePut(StateSlot.scrollScope, nativeUserData(nativeState(ScrollScope {})))
    }
}

// A new build starts in the window's scope.
public function scrollScopeReset() {
    scrollScopeEnsure()
    var current = nativeRecover<ScrollScope>(ambientStateGet(StateSlot.scrollScope))
    current.scope = 0
    current.built = 0
    current.page = false
    current.pageTaken = false
    current.barInset = 0.0
    current.search = .None
}

// A stack's page starts lowering in `scope`, under a bar `barInset` deep. What
// was in effect comes back, to hand to the leave.
public function scrollScopeEnter(scope: Number, barInset: Number) -> ScrollScope {
    scrollScopeEnsure()
    var current = nativeRecover<ScrollScope>(ambientStateGet(StateSlot.scrollScope))
    let previous = ScrollScope {
        scope: current.scope,
        built: current.built,
        page: current.page,
        pageTaken: current.pageTaken,
        barInset: current.barInset,
        search: copy current.search
    }
    current.scope = scope
    current.built = 0
    current.page = true
    current.pageTaken = false
    current.barInset = barInset
    current.search = .None
    return previous
}

// What floats over the window -- a popover, a full-screen cover -- lowers in
// a scope of its own that is no page: its scroll views carry none of the
// page's large title, and run under no bar. What was in effect comes back,
// to hand to `scrollScopeLeave`.
public function scrollScopeEnterFloating(scope: Number) -> ScrollScope {
    let previous = scrollScopeEnter(scope, 0.0)
    var current = nativeRecover<ScrollScope>(ambientStateGet(StateSlot.scrollScope))
    current.page = false
    return previous
}

// The page has lowered. Whether one of its scroll views claimed it.
public function scrollScopeLeave(previous: ScrollScope) -> Bool {
    scrollScopeEnsure()
    var current = nativeRecover<ScrollScope>(ambientStateGet(StateSlot.scrollScope))
    let taken = current.pageTaken
    current.scope = previous.scope
    current.built = previous.built
    current.page = previous.page
    current.pageTaken = previous.pageTaken
    current.barInset = previous.barInset
    current.search = copy previous.search
    return taken
}

// The next scroll view's identity in the scope being built.
public function scrollIdentity() -> Number {
    scrollScopeEnsure()
    var current = nativeRecover<ScrollScope>(ambientStateGet(StateSlot.scrollScope))
    current.built++
    return 1000000000 + current.scope * 1000 + current.built
}

// The page, for the first scroll view on it; nothing for any other, nor for
// one outside a page.
public function scrollClaimPage() -> ScrollPage {
    scrollScopeEnsure()
    var current = nativeRecover<ScrollScope>(ambientStateGet(StateSlot.scrollScope))
    if !current.page || current.pageTaken {
        return ScrollPage {}
    }
    current.pageTaken = true
    return ScrollPage {
        title: toolbarColumnTitle(),
        barInset: current.barInset,
        search: copy current.search
    }
}

// A view on the page being lowered asked for a search field the page sets in
// its content. Whether there is such a page, still unclaimed, to set it.
public function scrollPageSearch(search: WindowSearch) -> Bool {
    scrollScopeEnsure()
    var current = nativeRecover<ScrollScope>(ambientStateGet(StateSlot.scrollScope))
    if !current.page || current.pageTaken {
        return false
    }
    current.search = .Some(move search)
    return true
}

// --- Input -----------------------------------------------------------------------
//
// What the pointer and the fingers did to a scroll view since its last build:
// the runner gathers it as it arrives, against the scroll view under the
// pointer, and the scroll view takes it as it is built.

public struct ScrollInput {
    // The scroll view the gesture belongs to.
    var target: Number = 0
    // Whether a drag began, moved, ended, or was taken from the surface by
    // something else -- a swipe back -- since the last build.
    var began: Bool = false
    var moved: Bool = false
    var ended: Bool = false
    var cancelled: Bool = false
    // How far the fingers have carried the content since the drag began, and
    // how hard an end resists them.
    var travel: Number = 0.0
    // When the fingers came down, and each report since the last build -- how
    // far they had carried the content by then, and when -- in order, so the
    // surface measures its speed report by report, on the input's own clock.
    var beganAt: Number = -1.0
    var reports: [DragReport] = []
    var resistance: Number = 0.55
    // How far the wheel's notches have asked the surface to go.
    var wheel: Number = 0.0
}

// How far the fingers had carried the content by one report, and when.
struct DragReport {
    let travel: Number
    let time: Number
}

public function scrollInputEnsure() {
    if !ambientStateHas(StateSlot.scrollInput) {
        ambientStatePut(StateSlot.scrollInput, nativeUserData(nativeState(ScrollInput {})))
    }
}

// Fingers come down over the scroll view under `target`, resisted past an end
// by `resistance`.
public function scrollDragBegin(target: Number, resistance: Number, time: Number = -1.0) {
    scrollInputEnsure()
    var input = nativeRecover<ScrollInput>(ambientStateGet(StateSlot.scrollInput))
    input.target = target
    input.began = target != 0
    input.moved = false
    input.ended = false
    input.cancelled = false
    input.travel = 0.0
    input.resistance = resistance
    input.wheel = 0.0
    input.beganAt = time
    input.reports = []
}

// The fingers carried the content this far down, at `time` on the input's
// clock where it says.
public function scrollDragMove(distance: Number, time: Number = -1.0) {
    scrollInputEnsure()
    var input = nativeRecover<ScrollInput>(ambientStateGet(StateSlot.scrollInput))
    if input.target == 0 {
        return
    }
    input.travel = input.travel + distance
    input.moved = true
    input.reports.append(DragReport { travel: input.travel, time: time })
}

// The fingers lifted.
public function scrollDragEnd() {
    scrollInputEnsure()
    var input = nativeRecover<ScrollInput>(ambientStateGet(StateSlot.scrollInput))
    if input.target != 0 {
        input.ended = true
    }
}

// Something else took the fingers: the surface stops where it is, or goes
// back inside an end it was pulled past, and throws nothing.
public function scrollDragCancel() {
    scrollInputEnsure()
    var input = nativeRecover<ScrollInput>(ambientStateGet(StateSlot.scrollInput))
    if input.target != 0 && !input.ended {
        input.cancelled = true
    }
}

// A wheel turned over the scroll view under `target`, asking it this far down
// its content.
public function scrollWheel(target: Number, distance: Number) {
    scrollInputEnsure()
    var input = nativeRecover<ScrollInput>(ambientStateGet(StateSlot.scrollInput))
    if target == 0 {
        return
    }
    if input.target != target {
        input.began = false
        input.moved = false
        input.ended = false
        input.cancelled = false
        input.wheel = 0.0
    }
    input.target = target
    input.wheel = input.wheel + distance
}

// What has happened to the scroll view under `key` since it was last built,
// and nothing more from then on. A drag still under way stays its own.
public function scrollTake(key: Number) -> ScrollInput {
    scrollInputEnsure()
    var input = nativeRecover<ScrollInput>(ambientStateGet(StateSlot.scrollInput))
    if input.target != key {
        return ScrollInput {}
    }
    let taken = ScrollInput {
        target: input.target,
        began: input.began,
        moved: input.moved,
        ended: input.ended,
        cancelled: input.cancelled,
        travel: input.travel,
        resistance: input.resistance,
        wheel: input.wheel,
        beganAt: input.beganAt,
        reports: copy input.reports
    }
    input.began = false
    input.moved = false
    input.reports = []
    input.wheel = 0.0
    if input.ended || input.cancelled {
        input.target = 0
        input.ended = false
        input.cancelled = false
    }
    return taken
}
