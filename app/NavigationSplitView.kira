import Foundation
import Ember
import KiraLayout
import KCoreAnimation

// Which of a split view's columns are up, matching SwiftUI's
// NavigationSplitViewVisibility. `Automatic` is the platform's own answer, which
// on a window wide enough to split is every column the view was given.
//
// `DoubleColumn` means two columns beside the detail's neighbor: on the
// three-column form that is the content and the detail, and on the two-column
// form — where there is no content column to fall back to — it is the sidebar
// and the detail. SwiftUI reads the same way; the case is named for how many
// columns are up, not for which one is hidden.
public enum NavigationSplitViewVisibility {
    Automatic
    All
    DoubleColumn
    DetailOnly
}

public function navigationShowsSidebar(
    visibility: NavigationSplitViewVisibility,
    hasContent: Bool
) -> Bool {
    match visibility {
        Automatic -> return true
        All -> return true
        DoubleColumn -> return !hasContent
        DetailOnly -> return false
    }
}

public function navigationShowsContent(visibility: NavigationSplitViewVisibility) -> Bool {
    match visibility {
        Automatic -> return true
        All -> return true
        DoubleColumn -> return true
        DetailOnly -> return false
    }
}

// A column of a split view: the width the split view gives it, the window's full
// height, and NO paint of its own.
//
// The column does not fill itself because filling it is what stops the content
// from doing so: a frosted list samples what is behind the column, and an opaque
// pane behind it is all it can find. The list, the form or the surface inside
// the column says what the column looks like, exactly as `.background(...)` and
// the list style do in SwiftUI.
public construct NavigationSplitView(
    columnVisibility: NavigationSplitViewVisibility = .Automatic,
    path: NavigationPath = NavigationPath {},
    // Radius of the single *content* top-leading corner at the junction with
    // the unified toolbar. The sidebar is not a floating rounded card.
    paneCornerRadius: Number? = .None,
) extends Widget {
    // The columns are child slots, so a window writes them as blocks in the
    // order it reads them:
    //
    //     NavigationSplitView { Sidebar() } detail: { Detail() }
    //
    // The bare block is the sidebar because the sidebar is the slot declared
    // first, and `content:` and `detail:` name theirs, which is what SwiftUI's
    // labels do. `content` keeps its default, so the two-column form is the
    // three-column one with the middle block left unwritten. A rail is an
    // additional *named* child slot: keeping sidebar first ensures existing
    // bare-block constructions never silently become rails.
    let sidebar: some Widget
    let content: some Widget = EmptyView()
    let detail: some Widget
    let rail: some Widget = EmptyView()

    // The columns, each described under its own toolbar column so the items
    // and title each one declares land over it.
    //
    // Side by side, the rail and sidebar hand their content to the window so
    // it can draw a single translucent material behind them and the toolbar.
    // The detail stays under the leading region, while its content is held
    // clear of the rail and sidebar by the appropriate safe area.
    function describe(
        context: borrow BuildContext,
        modifiers: borrow ModifierContext
    ) -> CALayerDescription {
        let metrics = navigationMetrics(context.viewportWidth)
        let split = metrics.presentation == .Split
        // The split view's own toggle is always on the bar; what it decides is
        // whether the sidebar is, and it slides there.
        let hasSidebar = split && navigationShowsSidebar(columnVisibility, false)
        let shown = hasSidebar ? sidebarShown(context) : 0.0
        let showsSidebar = shown > 0.0
        let bleed = sidebarMetrics().glassBleed
        // Side by side, the row chosen in the sidebar is the root of what the
        // detail shows; stacked, the sidebar is the root and the row is pushed.
        navigationSetRootDepth(split ? 1 : 0)
        let inner = insideSafeArea(context)
        let previous = navigationEnter(true)
        toolbarEnterColumn(ToolbarColumn.sidebar)
        var railDesc = CALayerDescription {}
        if split {
            railDesc = rail.describe(inner, navigationColumnModifiers(modifiers, metrics))
        }
        let hasRail = split && !describesNothing(railDesc)
        let railWidth = hasRail ? railDesc.measure(context.viewportWidth).width : 0.0
        let paneRadius = match paneCornerRadius {
            Some(value) -> max(value, 0.0)
            None -> windowChromeMetrics().cornerRadius
        }
        let sidebarModifiers = navigationSidebarModifiers(modifiers, metrics)
        var sidebarDesc = CALayerDescription {}
        var rootCarried = false
        if split {
            // The first sidebar List/ScrollView is a page-level scroll view
            // even on desktop: it owns the large title, which moves underneath
            // the sidebar's section of the one window toolbar as it scrolls.
            // Previously only the compact branch installed this scroll scope,
            // so desktop could show only a permanently inline title.
            let scope = scrollScopeEnter(navigationSplitSidebarScope, context.safeArea.top)
            sidebarSelectionBegin()
            sidebarDesc = sidebar.describe(inner, sidebarModifiers)
            sidebarSelectionEnd()
            rootCarried = scrollScopeLeave(move scope)
            let title = toolbarColumnTitle()
            if title.count > 0 && !rootCarried {
                toolbarShowLargeTitle()
                sidebarDesc = CALayerDescription {
                    layout: CALayoutIntent { axis: .Column, heightFill: false },
                    sublayers: [
                        navigationLargeTitle(copy title, context, sidebarModifiers),
                        move sidebarDesc
                    ]
                }
            }
        } else {
            // Stacked, the sidebar is the stack's root page, and is lowered as
            // one: its first scroll view runs up under the bar with its title.
            let scope = scrollScopeEnter(navigationStackedRootScope, context.safeArea.top)
            sidebarDesc = sidebar.describe(inner, sidebarModifiers)
            rootCarried = scrollScopeLeave(move scope)
        }
        let primaryWidth = navigationSplitColumnWidth(sidebarDesc, metrics.primaryWidth)
        var rootTitle = ToolbarTitle {}
        if !split {
            rootTitle = toolbarTakeColumnTitle()
            rootTitle.largeTitle = rootTitle.title.count > 0
        }
        toolbarEnterColumn(ToolbarColumn.content)
        let contentDesc = content.describe(inner, navigationColumnModifiers(modifiers, metrics))
        // The detail is handed the window's safe area, and the sidebar and the
        // content column as more of it on the leading side: a stack in it
        // paints its canvas under all of them and holds only its content clear.
        // Anything else is held clear here.
        var beside = railWidth + primaryWidth * shown
        if split {
            beside = beside + contentDesc.measure(context.viewportWidth).width
        }
        var detailContext = copy context
        detailContext.safeArea.leading = detailContext.safeArea.leading + beside
        toolbarEnterColumn(ToolbarColumn.detail)
        chromeSafeAreaPending()
        // Stacked, going on from the sidebar or back to it is this view's own
        // push and pop: the detail slides over the sidebar, showing the view
        // it is going to or leaving, and a stack in it holds still meanwhile,
        // since it has no sidebar to show under it.
        navigationTransitionAdvance(context)
        let transition = navigationTransition()
        let slides = !split && transition.active && transition.covered.count == 0 && transition.front.count > 0
        let current = navigationValues()
        if slides {
            navigationStore(copy transition.front)
        }
        navigationSetSplitSlides(slides)
        var detailDesc = detail.describe(
            detailContext,
            navigationColumnModifiers(modifiers, metrics)
        )
        navigationSetSplitSlides(false)
        navigationStore(move current)
        if !chromeSafeAreaWasHandled() {
            detailDesc = safeAreaInset(move detailDesc, detailContext.safeArea)
        }
        navigationLeave(previous)
        chromeSafeAreaHandled()

        if !split {
            var root = navigationStackedRoot(
                move sidebarDesc,
                rootCarried,
                rootTitle.title,
                context,
                sidebarModifiers
            )
            if !slides && navigationValues().count == 0 {
                toolbarShowPageTitle(rootTitle)
            }
            root.key = 1
            detailDesc.key = navigationDetailRun() + 2
            var columns: [CALayerDescription] = []
            if slides {
                let popping = navigationTransitionPopping(transition)
                let animation = navigationTransitionAnimation(transition, context.frameCount)
                columns.append(
                    navigationCoveredPage(
                        move root,
                        transition.shown,
                        navigationTransitionFrom(transition),
                        context.viewportWidth,
                        popping,
                        copy animation
                    )
                )
                columns.append(
                    navigationMovingPage(
                        move detailDesc,
                        transition.shown,
                        navigationTransitionFrom(transition),
                        context.viewportWidth,
                        popping,
                        move animation
                    )
                )
            } else if navigationValues().count == 0 {
                columns.append(move root)
            } else {
                columns.append(move detailDesc)
            }
            return CALayerDescription { clipsChildren: true, sublayers: move columns }
        }

        chromeShowSidebarToggle()
        if hasRail {
            // The rail is persistent even when the sidebar slides away. The
            // toolbar boundary and the detail safe area include its width.
            chromeSetNavigationLayout(
                railWidth + primaryWidth * shown, true, 1.0, ToolbarColumn.detail, railWidth
            )
        } else if hasSidebar {
            chromeSetNavigationLayout(primaryWidth, true, shown, ToolbarColumn.detail)
        }
        // Each column is known by its own key, so the sidebar coming and going
        // never has the tree take the content column for it.
        //
        // The sidebar takes the room it is out by and slides in it, past the
        // window's leading edge as it goes. The window owns the shared chrome
        // material, and the individual columns supply content rather than
        // overlapping backgrounds.
        var columns: [CALayerDescription] = []
        let nativeBackdrop = windowBackdropShown()
        var backdropParts: [CALayerDescription] = []
        if hasRail {
            var railColumn = safeAreaInset(move railDesc, context.safeArea)
            railColumn.key = 3
            railColumn.layout.widthFill = false
            railColumn.layout.fixedWidth = railWidth
            // The window draws the same material behind every leading column,
            // then lifts their contents over it in one pass.
            backdropParts.append(move railColumn)
        }
        if showsSidebar {
            // The sidebar's page ScrollView has already reserved the toolbar
            // inset in its scrollable content. Insetting that layer again
            // would double the top clearance and break the large-title scroll
            // handoff. Other safe-area edges still apply to the glass pane.
            var sidebarArea = copy context.safeArea
            if rootCarried { sidebarArea.top = 0.0 }
            let pane = CALayerDescription {
                layout: CALayoutIntent {
                    widthFill: false,
                    heightFill: false,
                    fixedWidth: primaryWidth + bleed,
                    fixedHeight: context.viewportHeight + bleed * 2.0,
                    paddingLeading: bleed,
                    paddingTop: bleed,
                    paddingBottom: bleed
                },
                clipsChildren: true,
                sublayers: [safeAreaInset(move sidebarDesc, sidebarArea)]
            }
            // The pane has no glass, solid paint or shadow. Its content is
            // lifted over the host's translucent backdrop when available.
            let slid = CALayerDescription {
                layout: CALayoutIntent {
                    axis: .Row,
                    widthFill: false,
                    heightFill: false,
                    offset: Point { x: -primaryWidth * (1.0 - shown) - bleed, y: -bleed }
                },
                sublayers: [move pane]
            }
            var column = CALayerDescription {
                key: 1,
                layout: CALayoutIntent {
                    widthFill: false,
                    fixedWidth: primaryWidth * shown
                }
            }
            if hasRail {
                backdropParts.append(move slid)
            } else if nativeBackdrop {
                // Preserve the existing leading-edge backdrop geometry
                // for split views without the new rail slot.
                windowBackdropSidebar(
                    move slid,
                    primaryWidth * shown,
                    context.viewportHeight,
                    surfaceGlassScheme(modifiers),
                    railWidth: 0.0,
                    cornerRadius: paneRadius
                )
            } else {
                column.sublayers = [move slid]
                columns.append(move column)
            }
        }
        if hasRail {
            // The window owns the entire L-shaped material. The rail and
            // sidebar supply only their content, including the profile and
            // sidebar buttons. They never each draw a separate glass panel.
            // Native hosts get one cut over the leading region; standalone
            // windows use the same backdrop-sampling material as the toolbar.
            windowBackdropSidebar(
                CALayerDescription {
                    layout: CALayoutIntent {
                        axis: .Row,
                        widthFill: false,
                        heightFill: false,
                        fixedWidth: railWidth + primaryWidth * shown,
                        fixedHeight: context.viewportHeight
                    },
                    sublayers: move backdropParts
                },
                railWidth + primaryWidth * shown,
                context.viewportHeight,
                surfaceGlassScheme(modifiers),
                true,
                context.viewportWidth,
                railWidth,
                paneRadius
            )
        }
        detailDesc = navigationSelectedDetail(move detailDesc)
        // An unwritten content column measures nothing.
        var contentColumn = safeAreaInset(move contentDesc, context.safeArea)
        contentColumn.key = 2
        contentColumn.layout.widthFill = false
        columns.append(move contentColumn)
        return CALayerDescription {
            sublayers: [move detailDesc, CALayerDescription {
                layout: CALayoutIntent { axis: .Row, widthFill: false },
                sublayers: move columns
            }]
        }
    }
}

// The shadow the detail casts into the sidebar: a strip standing just past the
// glass's trailing edge, `width` in, which the glass clips away, so only the
// shadow it casts falls back inside along that edge. It runs past the
// window's `height` at both ends, so the shadow does not thin out at them.
public function sidebarShadow(
    width: Number,
    height: Number,
    modifiers: borrow ModifierContext
) -> CALayerDescription {
    let ink = colorFromFoundation(
        modifierColor(
            foundationColor(themeAdaptiveColor(sidebarShadowColor, modifierAppearance(modifiers))),
            modifiers
        )
    )
    let radius = sidebarMetrics().shadowRadius
    return CALayerDescription {
        disablesActions: true,
        backgroundColor: ink,
        shadow: CAShadow { color: ink, radius: radius },
        layout: CALayoutIntent {
            widthFill: false,
            heightFill: false,
            fixedWidth: radius * 2.0,
            fixedHeight: height + radius * 4.0,
            offset: Point { x: width, y: -radius * 2.0 }
        }
    }
}

// What a split view's sidebar is cut from. On a desktop it is the Mac's
// sidebar material, not Liquid Glass: what is behind it blurred, set at the
// sidebar tone's luminance and drained of most of its color, so it reads as a
// darker tone of the window. It has no lens and no rim, since it meets the
// window's edges and the detail with none. Elsewhere it is Liquid Glass.
function sidebarGlass(modifiers: borrow ModifierContext) -> CAGlass {
    if interfaceMode() == .AdaptiveMobile {
        return (liquidGlassContent(.Rect, modifiers)).edgeless()
    }
    return windowBackdropGlass(surfaceGlassScheme(modifiers), windowActive())
}

// The navigation container reports the geometry the root chrome compositor needs
// to align horizontal chrome with the columns beneath it. It does not render any
// bar itself: Back, toolbar items and tabs are all composed once at the app root.
