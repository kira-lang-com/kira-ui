import Foundation
import KCoreAnimation

// A Label's icon column and its gap to the title are container-owned layout
// measurements. These environment modifiers only affect Label, not every
// horizontal stack or a descendant's glyph scale. The platform's existing
// label metrics remain authoritative when the caller has not provided a value.
public function resolvedLabelIconToTitleSpacing(
    modifiers: borrow ModifierContext,
    platformSpacing: Number
) -> Number {
    return modifiers.hasLabelIconToTitleSpacing
        ? modifiers.labelIconToTitleSpacing : platformSpacing
}

public function resolvedLabelReservedIconWidth(
    modifiers: borrow ModifierContext,
    platformWidth: Number
) -> Number {
    return modifiers.hasLabelReservedIconWidth
        ? modifiers.labelReservedIconWidth : platformWidth
}

public function modifierDeltaLabelIconToTitleSpacing(value: Number) -> ModifierDelta {
    return ModifierDelta {
        hasLabelIconToTitleSpacing: true,
        labelIconToTitleSpacing: value
    }
}

public function modifierDeltaLabelReservedIconWidth(value: Number) -> ModifierDelta {
    return ModifierDelta {
        hasLabelReservedIconWidth: true,
        labelReservedIconWidth: value
    }
}

extend Widget {
    // SwiftUI: `.labelIconToTitleSpacing(_ value: CGFloat)`.
    function labelIconToTitleSpacing(value: Number) -> Any Widget {
        return ModifierDeltaLayer(
            delta: modifierDeltaLabelIconToTitleSpacing(value)
        ) { self }
    }

    // SwiftUI: `.labelReservedIconWidth(_ value: CGFloat)`.
    function labelReservedIconWidth(value: Number) -> Any Widget {
        return ModifierDeltaLayer(
            delta: modifierDeltaLabelReservedIconWidth(value)
        ) { self }
    }
}