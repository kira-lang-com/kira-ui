import KiraGraphics
import Foundation
extend Widget {
    function theme(value: Any Theme) -> Any Widget {
        return ThemeLayer(theme: value) {
            self
        }
    }

    function themeColor(value: ThemeColor) -> Any Widget {
        return ThemeColorLayer(color: value) {
            self
        }
    }

    function themeSurface(value: ThemeSurface) -> Any Widget {
        return ThemeSurfaceLayer(surface: value) {
            self
        }
    }

    function themeBorder(value: ThemeBorder) -> Any Widget {
        return ThemeBorderLayer(border: value) {
            self
        }
    }

    function foregroundColor(value: ThemeColor) -> Any Widget {
        return ForegroundColorLayer(color: value) {
            self
        }
    }

    function material(value: Material) -> Any Widget {
        return MaterialLayer(value: value) {
            self
        }
    }

    function disabled(value: Bool) -> Any Widget {
        return DisabledLayer(value: value) {
            self
        }
    }

    function focused(value: Bool) -> Any Widget {
        return FocusedLayer(value: value) {
            self
        }
    }

    function padding(length: Float) -> Any Widget {
        return Padding(length: length) {
            self
        }
    }

    function background(fill: Any Widget) -> Any Widget {
        return BackgroundLayer(fill: fill) {
            self
        }
    }

    function cornerRadius(radius: Float) -> Any Widget {
        return CornerRadiusLayer(radius: radius) {
            self
        }
    }

    function blurBehind(radius: Float, saturation: Float) -> Any Widget {
        return BlurBehindLayer(radius: radius, saturation: saturation) {
            self
        }
    }

    function glow(intensity: Float) -> Any Widget {
        return GlowLayer(intensity: intensity) {
            self
        }
    }

    function font(size: Float, weight: FontWeight = FontWeight.Regular) -> Any Widget {
        return FontLayer(size: size, weight: weight) {
            self
        }
    }

    function typography(style: TypographyStyle) -> Any Widget {
        return TypographyLayer(style: style) {
            self
        }
    }

    function opacity(value: Float) -> Any Widget {
        return OpacityLayer(value: value) {
            self
        }
    }

    function minWidth(value: Float) -> Any Widget {
        return MinWidthLayer(value: value) {
            self
        }
    }

    function width(value: Float) -> Any Widget {
        return WidthLayer(value: value) {
            self
        }
    }

    function fillHeight() -> Any Widget {
        return FillHeightLayer() {
            self
        }
    }

    function height(value: Float) -> Any Widget {
        return HeightLayer(value: value) {
            self
        }
    }

    function size(value: Float) -> Any Widget {
        return SizeLayer(value: value) {
            self
        }
    }

    function fill(color: Color) -> Any Widget {
        return FillLayer(color: color) {
            self
        }
    }

    function textColor(color: Color) -> Any Widget {
        return TextColorLayer(color: color) {
            self
        }
    }

    function surfaceRadius(value: Float) -> Any Widget {
        return SurfaceRadiusLayer(value: value) {
            self
        }
    }

    function surfacePadding(value: Float) -> Any Widget {
        return SurfacePaddingLayer(value: value) {
            self
        }
    }

    function contentMargins(value: ContentMargins) -> Any Widget {
        return ContentMarginsLayer(value: value) {
            self
        }
    }

    function surfaceShape(shape: SurfaceShape) -> Any Widget {
        return SurfaceShapeLayer(shape: shape) {
            self
        }
    }

    function surfaceBorder(color: Color, width: Float = 1.0) -> Any Widget {
        return SurfaceBorderLayer(color: color, width: width) {
            self
        }
    }
}
