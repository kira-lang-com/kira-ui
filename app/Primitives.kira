import KiraGraphics
import KiraLayout
import Foundation
import KCoreAnimation

// The layout and shape primitives everything else is built from: the three
// stacks, a fixed gap, a rectangle, and the two ways a vector reaches the
// screen.
//
// There is ONE stack per axis. A hug-sized row and a fill-sized row are the same
// widget under two sizing modifiers, and a leading-aligned column and a centered
// one are the same widget under two alignments — so a vocabulary carrying
// `HGroup` beside `HStack`, and `VGroupLeading` beside `VGroup`, is a vocabulary
// asking every reader to learn which of four names means the row they wanted.
//
//     HStack(spacing = .Small) { … }                 a row across its parent
//     HStack(spacing = .Small) { … }.hugWidth()      a row around its content
//     VStack(alignment = .Center) { … }.fillHeight() a column down the panel

// Where a child sits inside an overlay stack's bounds.
enum StackAlignment {
    TopLeading
    Top
    TopTrailing
    Leading
    Center
    Trailing
    BottomLeading
    Bottom
    BottomTrailing
}

// Where a row's children sit on the row's cross axis.
enum VerticalAlignment {
    Top
    Center
    Bottom
    Stretch
    // The line the row's text is written on, matching SwiftUI's
    // `.firstTextBaseline`. Runs at different sizes share it, and a glyph or a
    // control beside them hangs from it by its bottom edge — which is how a
    // symbol sits beside a word rather than merely near it.
    FirstTextBaseline
}

// Where a column's children sit on the column's cross axis.
enum HorizontalAlignment {
    Leading
    Center
    Trailing
    Stretch
}

function foundationAlignment(alignment: StackAlignment) -> Alignment {
    match alignment {
        TopLeading -> return .TopLeading
        Top -> return .Top
        TopTrailing -> return .TopTrailing
        Leading -> return .Leading
        Center -> return .Center
        Trailing -> return .Trailing
        BottomLeading -> return .BottomLeading
        Bottom -> return .Bottom
        BottomTrailing -> return .BottomTrailing
    }
}

function foundationVerticalAlignment(alignment: VerticalAlignment) -> CrossAlignment {
    match alignment {
        Top -> return .Start
        Center -> return .Center
        Bottom -> return .End
        Stretch -> return .Stretch
        FirstTextBaseline -> return .Baseline
    }
}

function foundationHorizontalAlignment(alignment: HorizontalAlignment) -> CrossAlignment {
    match alignment {
        Leading -> return .Start
        Center -> return .Center
        Trailing -> return .End
        Stretch -> return .Stretch
    }
}

// --- Dynamic content helpers ---
// The `For(x in xs) { ... }` builder sugar appends into a widget's `[Widget]`
// content, but its iterator must be a real array. `indices(n)` gives the loop a
// `[Int]` to walk when it needs the position (selection state, row identity)
// beside the item: `For(i in indices(count)) { Row(i, items[i]) }`.
function indices(count: Int) -> [Int] {
    var out: [Int] = []
    var i = 0
    while i < count {
        out.append(i)
        i = i + 1
    }
    return out
}

construct EmptyView() extends Widget {

    function describe(context: borrow BuildContext, modifiers: borrow ModifierContext) -> CALayerDescription {
        return CALayerDescription {
            layout: CALayoutIntent {
                fixedWidth: 0.0,
                fixedHeight: 0.0
            }
        }
    }
}

// Whether a layer is an `EmptyView`'s: nothing drawn, nothing held, no room
// taken. A stack leaves such a layer out altogether, the spacing around it
// included, as SwiftUI's stacks leave out an `EmptyView` — so a slot left at
// its default really is absent rather than a gap.
function describesNothing(layer: borrow CALayerDescription) -> Bool {
    if layer.sublayers.count > 0 || layer.layout.fixedWidth != 0.0 || layer.layout.fixedHeight != 0.0 {
        return false
    }
    match layer.content {
        Empty -> return true
        Text(t) -> return false
        Solid(s) -> return false
        Icon(i) -> return false
        Glass(g) -> return false
        Gradient(r) -> return false
        Texture(x) -> return false
    }
}

// A layer and everything in it, made deaf to presses: a view on screen that is
// on its way out, or not yet the one in front.
function layerInert(node: borrow mut CALayerDescription) {
    node.hittable = false
    node.interactive = false
    node.hitKey = 0
    for i in 0..node.sublayers.count {
        layerInert(node.sublayers[i])
    }
    return
}

// A layer and everything in it, landing on each change at once. For a view a
// spring already moves frame by frame: an implicit action on top of it would
// trail the motion it is given, each layer on its own clock.
function layerImmediate(node: borrow mut CALayerDescription) {
    node.disablesActions = true
    for i in 0..node.sublayers.count {
        layerImmediate(node.sublayers[i])
    }
    return
}

// --- Stacks ------------------------------------------------------------------

// The gap between a stack's children: the theme's step, unless the caller
// carries a length of its own.
//
// A step is what a stack should normally ask for, and `spacingLength` is not a
// way back to writing 13.0 at a call site. It is for the gap the LAYOUT
// computes rather than the theme owns — a grid's gutter, derived from its tile
// size and the width it was given, which no token can name because it changes
// with the window. A negative length means "no length; use the step".
function stackSpacing(
    spacing: Spacing,
    length: Float,
    modifiers: borrow ModifierContext,
) -> Float {
    if length >= 0.0 {
        return length
    }
    return spacingImplementation(move spacing, modifiers)
}

// A row across its parent's width. `.hugWidth()` makes it a group around its
// content instead.
construct HStack(
    spacing: Spacing = .None,
    alignment: VerticalAlignment = .Center,
    spacingLength: Float = -1.0,
) extends Widget {
    let children: [some Widget]


    function describe(context: borrow BuildContext, modifiers: borrow ModifierContext) -> CALayerDescription {
        return CALayerDescription {
            layout: CALayoutIntent {
                axis: .Row,
                spacing: stackSpacing(spacing, spacingLength, modifiers),
                heightFill: false,
                alignment: Point { x: 0.0, y: verticalAlignmentUnit(alignment) }
            },
            sublayers: describedChildren(context, modifiers, children)
        }
    }
}

// A column down its parent's width. `.fillHeight()` makes it claim the whole
// height; `.hugWidth()` makes it a group around its content.
construct VStack(
    spacing: Spacing = .None,
    alignment: HorizontalAlignment = .Leading,
    spacingLength: Float = -1.0,
) extends Widget {
    let children: [some Widget]


    function describe(context: borrow BuildContext, modifiers: borrow ModifierContext) -> CALayerDescription {
        return CALayerDescription {
            layout: CALayoutIntent {
                axis: .Column,
                spacing: stackSpacing(spacing, spacingLength, modifiers),
                heightFill: false,
                alignment: Point { x: horizontalAlignmentUnit(alignment), y: 0.0 }
            },
            sublayers: describedChildren(context, modifiers, children)
        }
    }
}

// An overlay stack: children draw in declaration order (first at the bottom),
// each placed by `alignment` within the stack's bounds.
construct ZStack(alignment: StackAlignment = .Center) extends Widget {
    let children: [some Widget]


    // Overlay stack: children share the frame's bounds, in stack order, each
    // placed within it by `alignment`.
    function describe(context: borrow BuildContext, modifiers: borrow ModifierContext) -> CALayerDescription {
        return CALayerDescription {
            layout: CALayoutIntent {
                alignment: stackAlignmentUnitPoint(alignment)
            },
            sublayers: describedChildren(context, modifiers, children)
        }
    }
}

// Where a row's alignment puts a shorter child, as a fraction of the leftover
// height. A first-text-baseline row centers until layout reads ink metrics.
function verticalAlignmentUnit(alignment: VerticalAlignment) -> Float {
    match alignment {
        Top -> return 0.0
        Center -> return 0.5
        Bottom -> return 1.0
        Stretch -> return 0.0
        FirstTextBaseline -> return 0.5
    }
}

// Where a column's alignment puts a narrower child, as a fraction of the
// leftover width.
function horizontalAlignmentUnit(alignment: HorizontalAlignment) -> Float {
    match alignment {
        Leading -> return 0.0
        Center -> return 0.5
        Trailing -> return 1.0
        Stretch -> return 0.0
    }
}

// Where an alignment puts a child in its box, as the unit point layout reads.
function stackAlignmentUnitPoint(alignment: StackAlignment) -> Point {
    match alignment {
        TopLeading -> return Point { x: 0.0, y: 0.0 }
        Top -> return Point { x: 0.5, y: 0.0 }
        TopTrailing -> return Point { x: 1.0, y: 0.0 }
        Leading -> return Point { x: 0.0, y: 0.5 }
        Center -> return Point { x: 0.5, y: 0.5 }
        Trailing -> return Point { x: 1.0, y: 0.5 }
        BottomLeading -> return Point { x: 0.0, y: 1.0 }
        Bottom -> return Point { x: 0.5, y: 1.0 }
        BottomTrailing -> return Point { x: 1.0, y: 1.0 }
    }
}

// --- Shapes ------------------------------------------------------------------

// A fixed-size, paint-free box: deterministic spacing inside stacks, where the
// flexing Spacer would absorb leftover space instead.
construct FixedGap(width: Float, height: Float) extends Widget {

    // A paint-free box of a fixed extent.
    function describe(context: borrow BuildContext, modifiers: borrow ModifierContext) -> CALayerDescription {
        return CALayerDescription {
            layout: CALayoutIntent {
                widthFill: false,
                heightFill: false,
                fixedWidth: width,
                fixedHeight: height
            }
        }
    }
}

// A fixed-size rounded rectangle: filled, stroked, or both. The atom for
// underlines, swatches, ticks and hairline rules.
// --- Vectors -----------------------------------------------------------------

// A symbol from the library, drawn at the size the region around it implies and
// inked by the cascading foreground:
//
//     Icon(.sidebar).onClick(toggleSidebar)
//
// Nothing about how large or what color is stated here. `.imageScale(...)`
// names the glyph's size RELATIVE to the size class in effect, and
// `.foregroundColor(...)` names its ink exactly as it does a run of text's.
construct Icon(symbol: Symbol) extends Widget {

    function describe(context: borrow BuildContext, modifiers: borrow ModifierContext) -> CALayerDescription {
        // On the bar a symbol is set at the bar's own size and weight, not
        // those of the type beside it — a toolbar's glyphs and its labels are
        // two sizes — and inked vibrant, into the glass it stands on.
        if modifiers.controlPresentation == .Toolbar {
            let points = iconScaleFactor(modifiers.imageScale) * windowChromeMetrics.symbolSize
            var ink = vibrantLabel(modifiers)
            if modifiers.hasForegroundColor || modifiers.hasTextColor {
                ink = VibrantInk { color: caColorFromFoundation(iconInk(modifiers)) }
            }
            return iconLayer(
                symbolImplementation(symbol, modifiers),
                symbolEm(points),
                ink,
                symbolWeightGrowth(points, windowChromeMetrics.symbolWeight),
            )
        }
        // Everywhere else a symbol is the size SF's would be beside the same
        // type.
        return iconDescription(symbolImplementation(symbol, modifiers), symbolEm(iconScaleSize(modifiers.imageScale, modifiers)), modifiers)
    }
}

// Vector artwork the application owns rather than the theme: the document on the
// canvas, the thumbnail of it in a list.
//
// It is sized like a glyph by default, so a swatch in a row follows the size
// class around it. `points` overrides that with a length, and is the one place a
// size is a NUMBER rather than a token — because the number is the document's
// and not the theme's. An icon being authored at 1024 points is the whole
// subject of the window.
//
// `svg` is SVG text (the subset the foundation's rasterizer reads: paths
// including arcs, circle / rect / line / polyline / polygon, fill and stroke).
construct Artwork(svg: String, scale: IconScale = .Medium, points: Float = -1.0) extends Widget {

    function describe(context: borrow BuildContext, modifiers: borrow ModifierContext) -> CALayerDescription {
        var size = iconScaleSize(scale, modifiers)
        if points >= 0.0 {
            size = points
        }
        return iconDescription(svg, size, modifiers)
    }
}

// A symbol's own metrics. The library is not one shape — a folder is wider than
// it is tall, a chevron is narrower — so the one thing a caller needs is how the
// ink is SHAPED; where it sits inside the canvas it was drawn on is the icon
// engine's business now, because the engine trims that margin away.
function iconInkAspect(svg: borrow String) -> Float {
    return foundationIconInkAspect(svg)
}

// How much of its own box a symbol's drawing covers, and the share above which
// it counts as drawn SOLID rather than stroked. An outline leaves most of its
// box empty; a filled shape does not.
function iconInkDensity(svg: borrow String) -> Float {
    return foundationIconInkDensity(svg)
}

// How much of its own box a symbol's ink covers before it counts as solid.
// Measured on the set: an outline of a compact shape -- a folder, a tag, two
// squares -- covers 0.41 to 0.45 of its box, a filled one 0.73 to 0.88. The
// line sits between the two, where 0.4 took the compact outlines for solids
// and left them a cut lighter than the type beside them.
function iconSolidDensity() -> Float {
    return 0.6
}

function iconDescription(
    svg: String,
    size: Float,
    modifiers: borrow ModifierContext,
) -> CALayerDescription {
    var growth = 0.0
    // Only a STROKED symbol is thickened. A solid one — a cursor, a filled
    // marker — has no stems to match against the type beside it, and growing it
    // just swells the shape until it reads as a blob.
    if iconInkDensity(svg) < iconSolidDensity() {
        growth = iconWeightGrowth(size, modifiers)
    }
    return iconLayer(move svg, size, VibrantInk { color: caColorFromFoundation(iconInk(modifiers)) }, growth)
}

// The color a glyph is inked in.
//
// A glyph is ink, so it answers the same explicit override a run of text does.
// `.foregroundColor(...)` names a role and is what application code should
// reach for; `.textColor(...)` is the escape hatch for artwork whose color is
// the document's rather than the theme's — a gizmo's axis, a swatch — and an
// icon that ignored it had no way to be one of those.
function iconInk(modifiers: borrow ModifierContext) -> FoundationColor {
    var ink = modifierColor(foundationColor(modifierTokens(modifiers).foreground.primary), modifiers)
    if modifiers.hasForegroundColor {
        ink = modifierColor(modifierPrimaryColor(modifiers.foregroundColor, modifiers), modifiers)
    }
    if modifiers.hasTextColor {
        ink = modifierColor(foundationColor(modifiers.textColor), modifiers)
    }
    return ink
}

// A glyph `size` em tall, inked with `ink` and grown `growth` points heavier
// than drawn.
function iconLayer(
    svg: String,
    size: Float,
    ink: borrow VibrantInk,
    growth: Float,
) -> CALayerDescription {
    // `size` is the glyph's EM. A symbol is rasterized trimmed to its ink, so
    // the ink layer is the share of the em this glyph's drawing occupies — the
    // library's shared canvas makes that knowable — and it stands centered in an
    // em-tall box, so glyphs of different shapes share a center line and the
    // words beside or below them share a baseline.
    let inkHeight = size * (foundationIconInkBottom(svg) - foundationIconInkTop(svg))
    let inkWidth = inkHeight * iconInkAspect(svg)
    let glyph = CALayerDescription {
        layout: CALayoutIntent {
            widthFill: false,
            heightFill: false,
            intrinsicWidth: inkWidth,
            intrinsicHeight: inkHeight
        },
        content: .Icon(CAIcon {
            svg: move svg,
            tint: ink.color,
            weightGrowth: growth,
            blend: ink.blend
        })
    }
    return CALayerDescription {
        layout: CALayoutIntent {
            widthFill: false,
            heightFill: false,
            intrinsicWidth: inkWidth,
            fixedHeight: size,
            alignment: Point { x: 0.5, y: 0.5 }
        },
        sublayers: [glyph]
    }
}

// How much heavier than drawn this glyph is.
//
// The symbol library is one weight — a hairline outline — and the type around it
// is not. Beside a semibold headline, an unthickened symbol is a different,
// lighter object standing near the words rather than a character in the same
// run: the stems say one thing and the outline says another, and no amount of
// aligning it fixes that. So the artwork is grown outward until its stroke
// matches the stems it stands with.
//
// The library's stroke is 16 of its 256 units. A regular face's stem is about a
// twelfth of the cap band, and a heavier one thickens roughly with its weight —
// the difference, halved (growth applies to both sides of a stroke), is what the
// glyph has to gain.
function iconWeightGrowth(band: Float, modifiers: borrow ModifierContext) -> Float {
    let drawn = band * 0.0625
    let wanted = iconCapBand(modifiers) * iconStemRatio(iconTypeWeight(modifiers))
    if wanted <= drawn {
        return 0.0
    }
    return (wanted - drawn) / 2.0
}

// A stem, as a fraction of the cap band, at a given weight.
//
// 400 is the face's regular cut, and at that weight the answer is what the
// library already draws — a regular symbol beside regular words needs no
// thickening at all. Heavier cuts thicken faster than their weight number does,
// which is why the slope is steeper than one.
function iconStemRatio(weight: Float) -> Float {
    return 0.09 * (1.0 + 1.7 * (weight / 400.0 - 1.0))
}


// The weight the words beside the glyph are set at, so the band is measured on
// the type actually in effect.
function iconTypeWeight(modifiers: borrow ModifierContext) -> Float {
    if modifiers.hasFont {
        return foundationFontWeight(modifiers.fontWeight)
    }
    if modifiers.hasTypography {
        return foundationFontWeight(typographyImplementation(modifiers.typography, modifiers).weight)
    }
    return 400.0
}
