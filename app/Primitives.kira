import KiraGraphics
import KiraLayout
import Foundation
import KiraUIFoundation

// The layout and shape primitives everything else is built from: the three
// stacks, a fixed gap, a rectangle, and the two ways a vector reaches the
// screen.
//
// There is ONE stack per axis. A hug-sized row and a fill-sized row are the same
// widget under two sizing modifiers, and a leading-aligned column and a centred
// one are the same widget under two alignments — so a vocabulary carrying
// `HGroup` beside `HStack`, and `VGroupLeading` beside `VGroup`, is a vocabulary
// asking every reader to learn which of four names means the row they wanted.
//
//     HStack(spacing = .Small) { … }                 a row across its parent
//     HStack(spacing = .Small) { … }.hugWidth()      a row around its content
//     VStack(alignment = .Center) { … }.fillHeight() a column down the panel

// Where a child sits inside an overlay stack's bounds.
enum StackAlignment {
    TopLeading
    Top
    TopTrailing
    Leading
    Center
    Trailing
    BottomLeading
    Bottom
    BottomTrailing
}

// Where a row's children sit on the row's cross axis.
enum VerticalAlignment {
    Top
    Center
    Bottom
    Stretch
    // The line the row's text is written on, matching SwiftUI's
    // `.firstTextBaseline`. Runs at different sizes share it, and a glyph or a
    // control beside them hangs from it by its bottom edge — which is how a
    // symbol sits beside a word rather than merely near it.
    FirstTextBaseline
}

// Where a column's children sit on the column's cross axis.
enum HorizontalAlignment {
    Leading
    Center
    Trailing
    Stretch
}

function foundationAlignment(alignment: StackAlignment) -> KiraUIFoundation.Alignment {
    match alignment {
        TopLeading -> return KiraUIFoundation.Alignment.TopLeading;
        Top -> return KiraUIFoundation.Alignment.Top;
        TopTrailing -> return KiraUIFoundation.Alignment.TopTrailing;
        Leading -> return KiraUIFoundation.Alignment.Leading;
        Center -> return KiraUIFoundation.Alignment.Center;
        Trailing -> return KiraUIFoundation.Alignment.Trailing;
        BottomLeading -> return KiraUIFoundation.Alignment.BottomLeading;
        Bottom -> return KiraUIFoundation.Alignment.Bottom;
        BottomTrailing -> return KiraUIFoundation.Alignment.BottomTrailing;
    }
}

function foundationVerticalAlignment(alignment: VerticalAlignment) -> KiraUIFoundation.CrossAlignment {
    match alignment {
        Top -> return KiraUIFoundation.CrossAlignment.Start;
        Center -> return KiraUIFoundation.CrossAlignment.Center;
        Bottom -> return KiraUIFoundation.CrossAlignment.End;
        Stretch -> return KiraUIFoundation.CrossAlignment.Stretch;
        FirstTextBaseline -> return KiraUIFoundation.CrossAlignment.Baseline;
    }
}

function foundationHorizontalAlignment(alignment: HorizontalAlignment) -> KiraUIFoundation.CrossAlignment {
    match alignment {
        Leading -> return KiraUIFoundation.CrossAlignment.Start;
        Center -> return KiraUIFoundation.CrossAlignment.Center;
        Trailing -> return KiraUIFoundation.CrossAlignment.End;
        Stretch -> return KiraUIFoundation.CrossAlignment.Stretch;
    }
}

// --- Dynamic content helpers ---
// The `For(x in xs) { ... }` builder sugar appends into a widget's `[Widget]`
// content, but its iterator must be a real array. `indices(n)` gives the loop a
// `[Int]` to walk when it needs the position (selection state, row identity)
// beside the item: `For(i in indices(count)) { Row(i, items[i]) }`.
function indices(count: Int) -> [Int] {
    var out: [Int] = []
    var i = 0
    while i < count {
        out.append(i)
        i = i + 1
    }
    return out
}

// Adopts an already-built low-level FoundationView into the Widget family, so an
// existing hand-lowered helper drops straight into a `For(...)` content block
// without rewriting its body: `FoundationRaw(view = …)`.
Widget FoundationRaw(view: KiraUIFoundation.FoundationView) {
    function lower(context: borrow KiraUIFoundation.FoundationUiContext, modifiers: borrow ModifierContext) -> KiraUIFoundation.FoundationView {
        let ignored = context.frameCount
        return view
    }
}

// Nothing, with a place in the tree — SwiftUI's `EmptyView`. It is what a widget
// argument defaults to when the caller supplies no view: a section without a
// footer draws no footer, rather than the container having to carry a flag for
// each optional slot.
Widget EmptyView() {
    function lower(context: borrow KiraUIFoundation.FoundationUiContext, modifiers: borrow ModifierContext) -> KiraUIFoundation.FoundationView {
        let ignored = context.frameCount
        return KiraUIFoundation.FoundationView {
            kind: KiraUIFoundation.FoundationViewKind.Surface
            width: KiraUIFoundation.SizeMode.Fixed(0.0)
            height: KiraUIFoundation.SizeMode.Fixed(0.0)
            fill: transparentFoundationColor()
        }
    }
}

// --- Stacks ------------------------------------------------------------------

// The gap between a stack's children: the theme's step, unless the caller
// carries a length of its own.
//
// A step is what a stack should normally ask for, and `spacingLength` is not a
// way back to writing 13.0 at a call site. It is for the gap the LAYOUT
// computes rather than the theme owns — a grid's gutter, derived from its tile
// size and the width it was given, which no token can name because it changes
// with the window. A negative length means "no length; use the step".
function stackSpacing(
    spacing: Spacing,
    length: Float,
    modifiers: borrow ModifierContext,
) -> Float {
    if length >= 0.0 {
        return length
    }
    return spacingImplementation(move spacing, modifiers)
}

// A row across its parent's width. `.hugWidth()` makes it a group around its
// content instead.
Widget HStack(
    spacing: Spacing = Spacing.None,
    alignment: VerticalAlignment = VerticalAlignment.Center,
    spacingLength: Float = -1.0,
) {
    let children: [some Widget]

    function lower(context: borrow KiraUIFoundation.FoundationUiContext, modifiers: borrow ModifierContext) -> KiraUIFoundation.FoundationView {
        return KiraUIFoundation.Row(
            children: loweredChildren(context, modifiers, children),
            width: KiraUIFoundation.SizeMode.Fill,
            height: KiraUIFoundation.SizeMode.Hug,
            spacing: stackSpacing(spacing, spacingLength, modifiers),
            padding: KiraUIFoundation.EdgeInsets {},
            crossAxisAlignment: foundationVerticalAlignment(alignment)
        )
    }
}

// A column down its parent's width. `.fillHeight()` makes it claim the whole
// height; `.hugWidth()` makes it a group around its content.
Widget VStack(
    spacing: Spacing = Spacing.None,
    alignment: HorizontalAlignment = HorizontalAlignment.Leading,
    spacingLength: Float = -1.0,
) {
    let children: [some Widget]

    function lower(context: borrow KiraUIFoundation.FoundationUiContext, modifiers: borrow ModifierContext) -> KiraUIFoundation.FoundationView {
        return KiraUIFoundation.Column(
            children: loweredChildren(context, modifiers, children),
            width: KiraUIFoundation.SizeMode.Fill,
            height: KiraUIFoundation.SizeMode.Hug,
            spacing: stackSpacing(spacing, spacingLength, modifiers),
            padding: KiraUIFoundation.EdgeInsets {},
            crossAxisAlignment: foundationHorizontalAlignment(alignment)
        )
    }
}

// An overlay stack: children draw in declaration order (first at the bottom),
// each placed by `alignment` within the stack's bounds.
Widget ZStack(alignment: StackAlignment = StackAlignment.Center) {
    let children: [some Widget]

    function lower(context: borrow KiraUIFoundation.FoundationUiContext, modifiers: borrow ModifierContext) -> KiraUIFoundation.FoundationView {
        return KiraUIFoundation.FoundationView {
            kind: KiraUIFoundation.FoundationViewKind.Frame
            width: KiraUIFoundation.SizeMode.Fill
            height: KiraUIFoundation.SizeMode.Fill
            alignment: foundationAlignment(alignment)
            padding: KiraUIFoundation.EdgeInsets {}
            children: loweredChildren(context, modifiers, children)
        }
    }
}

// --- Shapes ------------------------------------------------------------------

// A fixed-size, paint-free box: deterministic spacing inside stacks, where the
// flexing Spacer would absorb leftover space instead.
Widget FixedGap(width: Float, height: Float) {
    function lower(context: borrow KiraUIFoundation.FoundationUiContext, modifiers: borrow ModifierContext) -> KiraUIFoundation.FoundationView {
        let ignored = context.frameCount
        return KiraUIFoundation.FoundationView {
            kind: KiraUIFoundation.FoundationViewKind.Surface
            width: KiraUIFoundation.SizeMode.Fixed(width)
            height: KiraUIFoundation.SizeMode.Fixed(height)
            fill: transparentFoundationColor()
        }
    }
}

// A fixed-size rounded rectangle: filled, stroked, or both. The atom for
// underlines, swatches, ticks and hairline rules.
Widget Rectangle(
    width: Float,
    height: Float,
    radius: Float = 0.0,
    fill: Color = Color { a: 0.0 },
    stroke: Color = Color { a: 0.0 },
    strokeWidth: Float = 0.0,
) {
    function lower(context: borrow KiraUIFoundation.FoundationUiContext, modifiers: borrow ModifierContext) -> KiraUIFoundation.FoundationView {
        let ignored = context.frameCount
        return KiraUIFoundation.FoundationView {
            kind: KiraUIFoundation.FoundationViewKind.Surface
            width: KiraUIFoundation.SizeMode.Fixed(width)
            height: KiraUIFoundation.SizeMode.Fixed(height)
            fill: modifierSurfaceFill(foundationColor(fill), modifiers)
            border: modifierColor(foundationColor(stroke), modifiers)
            borderWidth: strokeWidth
            radius: radius
        }
    }
}

// --- Vectors -----------------------------------------------------------------

// A symbol from the library, drawn at the size the region around it implies and
// inked by the cascading foreground:
//
//     Icon(.sidebar).onClick(toggleSidebar)
//
// Nothing about how large or what colour is stated here. `.imageScale(...)`
// names the glyph's size RELATIVE to the size class in effect, and
// `.foregroundColor(...)` names its ink exactly as it does a run of text's.
Widget Icon(symbol: Symbol) {
    function lower(context: borrow KiraUIFoundation.FoundationUiContext, modifiers: borrow ModifierContext) -> KiraUIFoundation.FoundationView {
        let ignored = context.frameCount
        return iconView(
            symbolImplementation(symbol, modifiers),
            iconScaleSize(modifiers.imageScale, modifiers),
            modifiers
        )
    }
}

// Vector artwork the application owns rather than the theme: the document on the
// canvas, the thumbnail of it in a list.
//
// It is sized like a glyph by default, so a swatch in a row follows the size
// class around it. `points` overrides that with a length, and is the one place a
// size is a NUMBER rather than a token — because the number is the document's
// and not the theme's. An icon being authored at 1024 points is the whole
// subject of the window.
//
// `svg` is SVG text (the subset the foundation's rasterizer reads: paths
// including arcs, circle / rect / line / polyline / polygon, fill and stroke).
Widget Artwork(svg: String, scale: IconScale = IconScale.Medium, points: Float = -1.0) {
    function lower(context: borrow KiraUIFoundation.FoundationUiContext, modifiers: borrow ModifierContext) -> KiraUIFoundation.FoundationView {
        let ignored = context.frameCount
        var size = iconScaleSize(scale, modifiers)
        if points >= 0.0 {
            size = points
        }
        return iconView(svg, size, modifiers)
    }
}

// A symbol's own metrics. The library is not one shape — a folder is wider than
// it is tall, a chevron is narrower — so the one thing a caller needs is how the
// ink is SHAPED; where it sits inside the canvas it was drawn on is the icon
// engine's business now, because the engine trims that margin away.
function iconInkAspect(svg: borrow String) -> Float {
    return KiraUIFoundation.foundationIconInkAspect(svg)
}

// How much of its own box a symbol's drawing covers, and the share above which
// it counts as drawn SOLID rather than stroked. An outline leaves most of its
// box empty; a filled shape does not.
function iconInkDensity(svg: borrow String) -> Float {
    return KiraUIFoundation.foundationIconInkDensity(svg)
}

function iconSolidDensity() -> Float {
    return 0.4
}

function iconView(
    svg: String,
    size: Float,
    modifiers: borrow ModifierContext,
) -> KiraUIFoundation.FoundationView {
    var ink = modifierColor(foundationColor(modifierTokens(modifiers).foreground.primary), modifiers)
    if modifiers.hasForegroundColor {
        ink = modifierColor(modifierPrimaryColor(modifiers.foregroundColor, modifiers), modifiers)
    }
    // A glyph is ink, so it answers the same explicit override a run of text
    // does. `.foregroundColor(...)` names a role and is what application code
    // should reach for; `.textColor(...)` is the escape hatch for artwork whose
    // colour is the document's rather than the theme's — a gizmo's axis, a
    // swatch — and an icon that ignored it had no way to be one of those.
    if modifiers.hasTextColor {
        ink = modifierColor(foundationColor(modifiers.textColor), modifiers)
    }
    // The box IS the ink: `size` is the band the glyph's drawing fills, and the
    // width follows from the shape of that drawing. There is no canvas margin
    // left in it, so the glyph starts where a letter starts and its bottom is
    // the line a letter sits on — the two things that made a symbol beside a
    // word look like a picture placed near it.
    let aspect = iconInkAspect(svg)
    var growth = 0.0
    // Only a STROKED symbol is thickened. A solid one — a cursor, a filled
    // marker — has no stems to match against the type beside it, and growing it
    // just swells the shape until it reads as a blob.
    if iconInkDensity(svg) < iconSolidDensity() {
        growth = iconWeightGrowth(size, modifiers)
    }
    return KiraUIFoundation.FoundationView {
        kind: KiraUIFoundation.FoundationViewKind.Icon
        content: move svg
        color: move ink
        size: size
        iconWidth: size * aspect
        baseline: size
        weightGrowth: growth
    }
}

// How much heavier than drawn this glyph is.
//
// The symbol library is one weight — a hairline outline — and the type around it
// is not. Beside a semibold headline, an unthickened symbol is a different,
// lighter object standing near the words rather than a character in the same
// run: the stems say one thing and the outline says another, and no amount of
// aligning it fixes that. So the artwork is grown outward until its stroke
// matches the stems it stands with.
//
// The library's stroke is 16 of its 256 units. A regular face's stem is about a
// twelfth of the cap band, and a heavier one thickens roughly with its weight —
// the difference, halved (growth applies to both sides of a stroke), is what the
// glyph has to gain.
function iconWeightGrowth(band: Float, modifiers: borrow ModifierContext) -> Float {
    let drawn = band * 0.0625
    let wanted = iconCapBand(modifiers) * iconStemRatio(iconTypeWeight(modifiers))
    if wanted <= drawn {
        return 0.0
    }
    return (wanted - drawn) / 2.0
}

// A stem, as a fraction of the cap band, at a given weight.
//
// 400 is the face's regular cut, and at that weight the answer is what the
// library already draws — a regular symbol beside regular words needs no
// thickening at all. Heavier cuts thicken faster than their weight number does,
// which is why the slope is steeper than one.
function iconStemRatio(weight: Float) -> Float {
    return 0.09 * (1.0 + 1.7 * (weight / 400.0 - 1.0))
}

// The weight the words beside the glyph are set at, so the band is measured on
// the type actually in effect.
function iconTypeWeight(modifiers: borrow ModifierContext) -> Float {
    if modifiers.hasFont {
        return foundationFontWeight(modifiers.fontWeight)
    }
    if modifiers.hasTypography {
        return foundationFontWeight(typographyImplementation(modifiers.typography, modifiers).weight)
    }
    return 400.0
}
