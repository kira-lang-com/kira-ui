import KiraLayout
import KiraGraphics
import Foundation
import KCoreAnimation

// Design tools quote colors in 8-bit sRGB channels, so authoring a token set
// means writing that conversion somewhere. It belongs here once rather than in
// every application's theme file.

public function colorRgb(r: Float, g: Float, b: Float) -> Color {
    return Color {
        r: r / 255.0,
        g: g / 255.0,
        b: b / 255.0,
        a: 1.0
    }
}

public function colorRgba(r: Float, g: Float, b: Float, a: Float) -> Color {
    return Color {
        r: r / 255.0,
        g: g / 255.0,
        b: b / 255.0,
        a: a
    }
}

// The same color at a different alpha — a derived token (a tinted selection
// band, a faded wash) stated as the relationship it actually is.
public function colorWithAlpha(color: borrow Color, alpha: Float) -> Color {
    return Color {
        r: color.r,
        g: color.g,
        b: color.b,
        a: alpha
    }
}

// The palette, as free functions.
//
// Kira has no static members, and a block-bodied `let Name: Color { … }` member
// is a construct-backed surface a plain `struct` does not have — so `Color.Green`
// is not spellable. A zero-argument function is the form the language offers,
// and it reads the same at the call site: `colorGreen()`.

public function colorGreen() -> Color {
    return Color {
        r: 0.34,
        g: 0.85,
        b: 0.52,
        a: 1.0
    }
}

public function colorYellow() -> Color {
    return Color {
        r: 0.98,
        g: 0.80,
        b: 0.36,
        a: 1.0
    }
}

public function colorBlue() -> Color {
    return Color {
        r: 0.43,
        g: 0.67,
        b: 1.0,
        a: 1.0
    }
}

public function colorPurple() -> Color {
