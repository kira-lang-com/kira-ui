import KiraLayout
import Ember
import Foundation
import KCoreAnimation

// Design tools quote colors in 8-bit sRGB channels, so authoring a token set
// means writing that conversion somewhere. It belongs here once rather than in
// every application's theme file.

public function colorRgb(r: Number, g: Number, b: Number) -> RGBAColor {
    return RGBAColor { r: r / 255.0, g: g / 255.0, b: b / 255.0, a: 1.0 }
}

public function colorRgba(r: Number, g: Number, b: Number, a: Number) -> RGBAColor {
    return RGBAColor { r: r / 255.0, g: g / 255.0, b: b / 255.0, a: a }
}

// The same color at a different alpha — a derived token (a tinted selection
// band, a faded wash) stated as the relationship it actually is.
public function colorWithAlpha(color: borrow RGBAColor, alpha: Number) -> RGBAColor {
    return RGBAColor { r: color.r, g: color.g, b: color.b, a: alpha }
}

// The palette, as free functions.
//
// Kira has no static members, and a block-bodied `let Name: Color { … }` member
// is a construct-backed surface a plain `struct` does not have — so `Color.Green`
// is not spellable. A zero-argument function is the form the language offers,
// and it reads the same at the call site: `colorGreen()`.

public function colorGreen() -> RGBAColor {
    return RGBAColor { r: 0.34, g: 0.85, b: 0.52, a: 1.0 }
}

public function colorYellow() -> RGBAColor {
    return RGBAColor { r: 0.98, g: 0.80, b: 0.36, a: 1.0 }
}

public function colorBlue() -> RGBAColor {
    return RGBAColor { r: 0.43, g: 0.67, b: 1.0, a: 1.0 }
}

public function colorPurple() -> RGBAColor {
    return RGBAColor { r: 0.65, g: 0.40, b: 0.95, a: 1.0 }
}

public function colorCyan() -> RGBAColor {
    return RGBAColor { r: 0.25, g: 0.78, b: 0.82, a: 1.0 }
}

public function colorWhite() -> RGBAColor {
    return RGBAColor { r: 1.0, g: 1.0, b: 1.0, a: 1.0 }
}

public function colorBeige() -> RGBAColor {
    return RGBAColor { r: 0.96, g: 0.95, b: 0.93, a: 1.0 }
}

public function colorBeigeDark() -> RGBAColor {
    return RGBAColor { r: 0.93, g: 0.91, b: 0.88, a: 1.0 }
}

public function colorTaupe() -> RGBAColor {
    return RGBAColor { r: 0.61, g: 0.53, b: 0.48, a: 1.0 }
}

public function colorBorderSoft() -> RGBAColor {
    return RGBAColor { r: 0.91, g: 0.89, b: 0.85, a: 1.0 }
}

public function colorDarkText() -> RGBAColor {
    return RGBAColor { r: 0.11, g: 0.11, b: 0.12, a: 1.0 }
}

public function colorSecondaryText() -> RGBAColor {
    return RGBAColor { r: 0.56, g: 0.56, b: 0.58, a: 1.0 }
}

public function colorMutedText() -> RGBAColor {
    return RGBAColor { r: 0.69, g: 0.68, b: 0.66, a: 1.0 }
}

public function colorMutedGreen() -> RGBAColor {
    return RGBAColor { r: 0.45, g: 0.68, b: 0.50, a: 1.0 }
}

public function colorMutedBlue() -> RGBAColor {
    return RGBAColor { r: 0.45, g: 0.58, b: 0.72, a: 1.0 }
}

public function colorMutedOrange() -> RGBAColor {
    return RGBAColor { r: 0.76, g: 0.58, b: 0.40, a: 1.0 }
}
