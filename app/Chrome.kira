import Foundation
import KiraGraphics
import KiraLayout
import KiraUIFoundation

// Window chrome: the source list beside the document, and the boxes a chrome
// glyph sits in.
//
// These are the parts of a document window that every document window has, and
// the parts hardest to get right by hand because none of their sizes are
// content-derived: a source list row is 34 points tall because that is what a
// row is, and an application that has to say so is an application that will say
// something slightly different in its next window.
//
// The bar across the top is not here, and no widget builds one: it belongs to
// the window, which is `NavigationSplitView`, and a view says what goes on it
// with `.toolbar(...)`. See `Toolbar.kira`.
//
// There is no button widget here, and there should not be. A glyph that can be
// pressed is a glyph with `.onClick(...)` on it.

// The three window controls, in the standard order and the standard colours.
Widget WindowControls(spacing: Spacing = Spacing.Small) {
    function lower(context: borrow KiraUIFoundation.FoundationUiContext, modifiers: borrow ModifierContext) -> KiraUIFoundation.FoundationView {
        let controls = HStack(spacing: spacing, alignment: VerticalAlignment.Center) {
            WindowButton(ink: PrimaryColor.Red)

            WindowButton(ink: PrimaryColor.Yellow)

            WindowButton(ink: PrimaryColor.Green)
        }
        .hugWidth()
        return controls.lower(context, modifiers)
    }
}

Widget WindowButton(ink: PrimaryColor) {
    function lower(context: borrow KiraUIFoundation.FoundationUiContext, modifiers: borrow ModifierContext) -> KiraUIFoundation.FoundationView {
        let metrics = resolvedControlMetrics(modifiers)
        let button = Circle()
            .width(metrics.windowButton)
            .height(metrics.windowButton)
            .foregroundColor(ink)
        return button.lower(context, modifiers)
    }
}

// --- Boxes -------------------------------------------------------------------

// Content centred in whatever box its parent gives it.
//
// A Surface stretches its child, which places a hug-sized run of text or a glyph
// against the box's top edge rather than in the middle of it. Every fixed-size
// control needs the opposite, and every one of them was arriving at it its own
// way.
Widget CenteredContent() {
    let content: some Widget

    function lower(context: borrow KiraUIFoundation.FoundationUiContext, modifiers: borrow ModifierContext) -> KiraUIFoundation.FoundationView {
        return Frame(
            content.lower(context, modifiers),
            KiraUIFoundation.SizeMode.Fill,
            KiraUIFoundation.SizeMode.Fill,
            0,
            KiraUIFoundation.Alignment.Center,
            KiraUIFoundation.EdgeInsets {}
        )
    }
}

// A control-sized box around a glyph: the toolbar item, one segment of a group.
// It carries the pressed-in fill a mode item holds while its mode is on.
Widget ControlSlot(active: Bool = false, radius: CornerRadius = CornerRadius.Small) {
    let content: some Widget

    function lower(context: borrow KiraUIFoundation.FoundationUiContext, modifiers: borrow ModifierContext) -> KiraUIFoundation.FoundationView {
        let metrics = resolvedControlMetrics(modifiers)
        let slot = Panel(radius: radius) {
            CenteredContent() {
                content
            }
        }
        .backgroundStyle(controlSlotSurface(active))
        .width(metrics.buttonWidth)
        .height(metrics.height)
        return slot.lower(context, modifiers)
    }
}

function controlSlotSurface(active: Bool) -> BackgroundStyle {
    if active {
        return BackgroundStyle.Control
    }
    return BackgroundStyle.Clear
}

// The ink a chrome glyph takes: the accent while its mode is on, secondary
// otherwise.
function controlStateInk(active: Bool) -> PrimaryColor {
    if active {
        return PrimaryColor.Accent
    }
    return PrimaryColor.Secondary
}

// A capsule of controls that belong together: the appearance previews on a
// toolbar, a run of mode glyphs. It is a container, not a control — what each
// item does is that item's own `.onClick(...)`.
Widget ControlGroup(spacing: Spacing = Spacing.ExtraSmall) {
    let children: [some Widget]

    function lower(context: borrow KiraUIFoundation.FoundationUiContext, modifiers: borrow ModifierContext) -> KiraUIFoundation.FoundationView {
        let metrics = resolvedControlMetrics(modifiers)
        let items = HStack(spacing: spacing, alignment: VerticalAlignment.Center) {
            For(item in children) {
                item
            }
        }
        .hugWidth()
        let group = Panel(radius: CornerRadius.Capsule) {
            FoundationRaw(view: Frame(
                items.lower(context, modifiers),
                KiraUIFoundation.SizeMode.Hug,
                KiraUIFoundation.SizeMode.Hug,
                0,
                KiraUIFoundation.Alignment.Center,
                uniformInsets(metrics.toggleInset)
            ))
        }
        .backgroundStyle(.Control)
        .hugWidth()
        .hugHeight()
        return group.lower(context, modifiers)
    }
}

// --- Source list -------------------------------------------------------------

// There is no Sidebar widget here. A window's leading column is a COLUMN OF THE
// SPLIT VIEW, not a panel an application drops into a row of its own: it is
// `NavigationSplitView`'s `sidebar`, which is what gives it the window's full
// height, its width from the split view's metrics, and the collapse to a stack
// on a narrow window. A widget that painted the column itself could give it none
// of those, and every window that used one had to rebuild the row around it.
// What goes IN the column is an ordinary list of `ListRow`s.

// The column on the other side of the document: the properties of whatever is
// selected, as a form of sections. It takes its width from the metrics table, so
// a window states neither it nor the split view's sidebar width.
// Sections stand well apart: the gap between two grouped cards is two thirds of
// a row on the platform, and a tighter one makes three cards read as one long
// list rather than as three groups.
Widget Inspector(
    spacing: Spacing = Spacing.ExtraLarge,
    background: BackgroundStyle = BackgroundStyle.Surface,
    material: Material = Material.Flat,
) {
    let children: [some Widget]

    function lower(context: borrow KiraUIFoundation.FoundationUiContext, modifiers: borrow ModifierContext) -> KiraUIFoundation.FoundationView {
        let metrics = resolvedControlMetrics(modifiers)
        let panel = Panel(radius: CornerRadius.None) {
            Form(spacing: spacing) {
                For(section in children) {
                    section
                }

                Spacer()
            }
        }
        .backgroundStyle(background)
        .material(material)
        .width(metrics.inspectorWidth)
        .fillHeight()
        return panel.lower(context, modifiers)
    }
}

// One row of a source list or outline: its content across the list's width, at
// the size class's row height, indented one gutter per level of disclosure, and
// carrying the selection band when it is the selected row.
//
// A selected row paints its content in the inverse ink, so nothing inside it has
// to know that it is selected.
Widget ListRow(
    selected: Bool = false,
    level: Int = 0,
    spacing: Spacing = Spacing.Small,
) {
    let children: [some Widget]

    function lower(context: borrow KiraUIFoundation.FoundationUiContext, modifiers: borrow ModifierContext) -> KiraUIFoundation.FoundationView {
        let metrics = resolvedControlMetrics(modifiers)
        // The row FILLS its list rather than hugging its content, and holds it
        // against the leading edge. A Spacer of its own would be one the caller
        // cannot see: a row that ends with `Spacer()` and a trailing count would
        // then have two of them, and the two would split the slack between them
        // — which is how a right-hand count ends up in the middle of the row.
        let content = HStack(spacing: spacing, alignment: VerticalAlignment.Center) {
            if level > 0 {
                FixedGap(width: intAsFloat(value: level) * metrics.listIndent, height: 1.0)
            }

            For(item in children) {
                item
            }
        }
        // The row's CONTENT starts at the column's margin, like everything else in
        // the column — the bar above it, the header over the list. The selection
        // band is what is inset instead: it is held off the column's edge by half
        // that margin, so a selected row reads as a pill inside the column rather
        // than as a stripe across it, and the text inside it does not move when it
        // becomes selected.
        let bandInset = metrics.contentMargin / 2.0
        let band = FoundationRaw(view: Frame(
            content.lower(context, listRowModifiers(modifiers, selected)),
            KiraUIFoundation.SizeMode.Fill,
            KiraUIFoundation.SizeMode.Fixed(metrics.listRowHeight),
            0,
            KiraUIFoundation.Alignment.Leading,
            KiraUIFoundation.EdgeInsets {
                leading: metrics.contentMargin - bandInset
                trailing: metrics.contentMargin - bandInset
            }
        ))
        .background(BackgroundFill(style: listRowSurface(selected), radius: CornerRadius.Small))
        let row = FoundationRaw(view: Frame(
            band.lower(context, modifiers),
            KiraUIFoundation.SizeMode.Fill,
            KiraUIFoundation.SizeMode.Hug,
            0,
            KiraUIFoundation.Alignment.Leading,
            KiraUIFoundation.EdgeInsets {
                leading: bandInset
                trailing: bandInset
            }
        ))
        return row.lower(context, modifiers)
    }
}

function listRowModifiers(modifiers: borrow ModifierContext, selected: Bool) -> ModifierContext {
    if selected == false {
        return modifierContextApply(modifiers, ModifierDelta {})
    }
    return modifierContextApply(modifiers, modifierDeltaForegroundColor(listRowSelectedInk(modifiers)))
}

// The ink a selected row is set in.
//
// A selection band is one of two things, and the theme says which by the ALPHA
// it gives the token: a filled bar, which the row's content has to invert
// against, or a wash over the surface, which it must not — white on a pale wash
// is a row a light interface cannot read. Hardcoding the inverse ink here is
// what made the selected row disappear the moment a theme washed its selection.
function listRowSelectedInk(modifiers: borrow ModifierContext) -> PrimaryColor {
    if modifierTokens(modifiers).fill.selection.a >= 0.6 {
        return PrimaryColor.Inverse
    }
    return PrimaryColor.Primary
}

function listRowSurface(selected: Bool) -> BackgroundStyle {
    if selected {
        return BackgroundStyle.Selection
    }
    return BackgroundStyle.Clear
}
