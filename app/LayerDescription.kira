import Foundation
import KCoreAnimation
import KiraLayout

public struct BuildContext {
    let frameCount: Int
    let viewportWidth: Float
    let viewportHeight: Float
    let pointerX: Float
    var pointerY: Float = 0.0
    let focusedKey: Int
    // The control being held down, while the pointer is still on it: the one
    // that acts if it is let go now. Zero when nothing is.
    var pressedKey: Int = 0
    // What the pointer is over: the control, or the surface or backdrop it
    // answers under. Zero over nothing.
    var hoveredKey: Int = 0
    // The interactive surface a held press landed on, wherever the pointer has
    // gone since; the pointer in that surface's own coordinates; the surface's
    // size; where its top-leading corner sat in the window when it was
    // pressed; and whether the press went down on a control in it rather than
    // on the surface itself. Interactive glass follows the pointer off its
    // edge, gives less toward a window edge it is near, and comes back to the
    // box it rests in when it is let go.
    var heldKey: Int = 0
    var heldPoint: Point = Point {}
    var heldSize: Size = Size {}
    var heldOrigin: Point = Point {}
    var heldOnControl: Bool = false
    // The control a held press is on, whether or not the pointer is still
    // over it; zero when nothing is held.
    var heldControl: Int = 0
    // Whether the held press is one that slides across a menu.
    var heldSlides: Bool = false
    // Which press is held: a new number each time a press lands on a surface,
    // or moves on to another.
    var heldPress: Int = 0
    // The window's safe area: the band along each edge the window's own chrome
    // draws over. Content is laid out inside it; a container whose background
    // belongs edge to edge -- a split view's sidebar -- draws under it and holds
    // only its content in.
    var safeArea: EdgeInsets = EdgeInsets {}
    var systemSafeArea: EdgeInsets = EdgeInsets {}
}

// The context a container's content is built in once the container has laid it
// out inside the safe area itself: nothing further in is under the chrome.
public function insideSafeArea(context: borrow BuildContext) -> BuildContext {
    var inner = copy context
    inner.safeArea = EdgeInsets {}
    return inner
}

public function buildContext(context: borrow FoundationUiContext) -> BuildContext {
    return BuildContext {
        frameCount: context.frameCount,
        viewportWidth: context.viewport.width,
        viewportHeight: context.viewport.height,
        pointerX: context.pointerX,
        pointerY: context.pointerY,
        focusedKey: context.focusedKey,
        pressedKey: context.pressedKey == context.hoveredKey ? context.pressedKey : 0,
        hoveredKey: context.hoveredKey
    }
}

