import Foundation
import KCoreAnimation

// The sizes a control IS.
//
// Colors, radii, spacing and type were already tokens; the geometry a control is
// actually built from — how tall a form row stands, how wide the numeric field
// beside it runs, which column its label starts in — was not, so every
// application re-derived it with literals at the call site and every panel came
// out a little different from the one beside it.
//
// A style declares the table once per size class. An application picks the class
// for a region and states nothing else:
//
//     Inspector()
//         .controlSize(.Small)
//
// and every row, field, switch, glyph and separator inside follows.
//
// GAPS are not here. The distance between two things is a spacing token, and the
// theme's spacing scale already names those steps; a second scale for the same
// decision is how a row's label gap ends up disagreeing with the panel's.

// The size class a region's controls are drawn at, the way macOS sizes a control
// mini through large. It cascades: naming it on a panel names it for everything
// the panel contains.
enum ControlSize {
    Mini
    Small
    Regular
    Large
}

// How large a glyph is drawn RELATIVE to the controls around it, the way
// SwiftUI's image scale is relative. The absolute point size is the size class's
// business, so the same `.Medium` glyph is smaller inside a `.Mini` region than
// inside a `.Regular` one without anything at the call site changing.
enum IconScale {
    Small
    Medium
    Large
    ExtraLarge
}

// One size class, resolved. The defaults are the regular class; a style states
// all four.
struct ControlMetricsImplementation {
    // How large TYPE is drawn in this size class, against the theme's scale.
    //
    // Type belongs to the size class. Stated globally, a `.Small` region shrinks
    // its rows and its controls and leaves the text at full size — which is how
    // a row label ends up filling almost half its row while the header above it
    // is barely legible. The theme still owns the RELATIONSHIPS between roles;
    // this decides how loudly the whole scale speaks here.
    let typeScale: Float = 1.0
    // A form row's height. Every row in a section stands the same height
    // whatever control it carries — that is what makes a column of them read as
    // a list rather than as a stack of unrelated widgets.
    let rowHeight: Float = 34.0
    // An inline control's own height: a numeric field, a menu pill, a segment.
    let height: Float = 24.0
    // A numeric field's width, fixed so a column of them aligns on its right
    // edge no matter what the values currently are, and its inset.
    let fieldWidth: Float = 64.0
    let fieldInset: Float = 7.0
    // A form row's own inset from the card's edges. The separators between rows
    // run the card's full width, so the inset belongs to the row rather than to
    // the card around it.
    let rowInset: Float = 12.0
    // The leading column a row's glyph sits in. A row WITHOUT a glyph still
    // reserves it, so a sub-property lines up with the property above it.
    let gutter: Float = 28.0
    let toggleWidth: Float = 38.0
    let toggleHeight: Float = 22.0
    // The track's inset around its knob.
    let toggleInset: Float = 2.0
    // Linear value controls. Their geometry follows the same size class as the
    // switch and fields around them instead of carrying private constants.
    let sliderWidth: Float = 160.0
    let sliderHeight: Float = 24.0
    let sliderTrackHeight: Float = 4.0
    let sliderKnobSize: Float = 18.0
    let progressWidth: Float = 96.0
    let progressHeight: Float = 6.0
    // Menu group separators are presentation geometry: the rule itself is the
    // theme border, while these values say where that rule sits in a menu row.
    let menuDividerInset: Float = 24.0
    let menuDividerVerticalInset: Float = 10.5
    // Menu chrome is one presentation system, so its row, text, card and
    // accessory geometry come from the same size-class table as every other
    // control instead of being measured constants hidden in Menu.kira.
    let menuRowHeight: Float = 42.0
    let menuLeadingInset: Float = 30.0
    let menuTrailingInset: Float = 28.0
    let menuLabelSize: Float = 16.5
    let menuCardWidth: Float = 250.0
    let menuCardRadius: Float = 34.0
    let menuActionPadding: Float = 8.0
    let menuPillInset: Float = 6.0
    let menuRowRadius: Float = 10.0
    let menuChevronBox: Float = 14.0
    // The glyphs a menu draws, by their em (see `iconScaleSize`), measured off
    // the platform's menu: a row's glyph is centred in a fixed column with a gap
    // before its title (30 + 22 + 14 puts the title 66pt in), an action's glyph
    // stands larger than the caption under it, and the disclosure chevron is a
    // small mark rather than a glyph at the title's size.
    let menuIconColumn: Float = 22.0
    let menuIconGap: Float = 14.0
    let menuActionIconSize: Float = 21.0
    // The actions across the top stand in their own air: more above the glyphs
    // than below the captions, with the caption a clear step under its glyph.
    let menuActionsTopInset: Float = 18.0
    let menuActionsBottomInset: Float = 10.0
    let menuActionSpacing: Float = 8.0
    let menuChevronSize: Float = 11.0
    // One wheel notch. This is interaction geometry, so it scales with the
    // region rather than ScrollView carrying one platform constant forever.
    let scrollStep: Float = 48.0
    // A two-dimensional value pad: its size, its knob, and the ruler along its
    // bottom edge.
    let padWidth: Float = 168.0
    let padHeight: Float = 96.0
    let padKnob: Float = 10.0
    let padTick: Float = 6.0
    // How far a COLUMN holds its content off its own leading and trailing edges.
    //
    // One margin for the whole column, and every part of it obeys the same one:
    // the bar across its top, the rows in its list, the header above them. Each
    // of them used to inset itself — a toolbar by one number, a row by another,
    // a header by a third — and a column whose contents start at three different
    // distances from its edge reads as three columns that happen to be adjacent.
    //
    // A column's edge margin is a property of the column, not of the control size
    // inside it, so it does not scale with the class the way a control's own
    // insets do: it is the same 16 in every class, as a platform's layout margin
    // is one constant its content stands off its edges by.
    let contentMargin: Float = 16.0
    // The window's toolbar: how tall it stands.
    let toolbarHeight: Float = 48.0
    // Button geometry belongs to the size class, not to Button itself. A
    // standalone text control uses the insets; system chrome can instead use the
    // square buttonSize x buttonSize slot for an icon-only control.
    let buttonSize: Float = 36.0
    let buttonHorizontalInset: Float = 15.0
    let buttonVerticalInset: Float = 10.0
    // A window control's diameter.
    let windowButton: Float = 12.0
    // A list or outline row: its height, the list's inset, and one level of
    // disclosure.
    let listRowHeight: Float = 28.0
    let listInset: Float = 6.0
    let listIndent: Float = 16.0
    // The default widths of the columns beside a document: the source list on
    // the leading side and the property panel on the trailing one.
    let sidebarWidth: Float = 260.0
    let inspectorWidth: Float = 300.0
    // A section card's own inset around its rows, its header's height and how
    // far the header is held off the card's leading edge.
    let cardPadding: Float = 0.0
    let headerHeight: Float = 20.0
    let headerInset: Float = 10.0
    // How far a divider is held off the edges it runs between. Leading and
    // trailing separately: a grouped list insets its separators to the label
    // column on the leading side and runs them to the edge on the trailing one,
    // and a single inset cannot say that.
    let dividerLeading: Float = 0.0
    let dividerTrailing: Float = 0.0
    // A form's inset from the surface it is placed on.
    let formInset: Float = 10.0
}

