// The metrics for one class, from the theme in effect — the same rule every
// other token family resolves by.
function controlMetricsImplementation(
    size: ControlSize,
    modifiers: borrow ModifierContext,
) -> ControlMetricsImplementation {
    return modifierTheme(modifiers).controlMetrics(size)
}

// The margin the COLUMN in effect holds its content off its edges by: what the
// column said with `.contentMargin(...)`, and otherwise the size class's own.
// Everything that stands against a column's edge asks this — the bar's sections,
// a list row, a list's header — so one answer moves all of them together.
function resolvedContentMargin(modifiers: borrow ModifierContext) -> Float {
    if modifiers.hasContentMargin {
        return modifiers.contentMargin
    }
    return resolvedControlMetrics(modifiers).contentMargin
}

// The metrics in effect here: the cascaded `.controlSize(...)`, or regular.
function resolvedControlMetrics(modifiers: borrow ModifierContext) -> ControlMetricsImplementation {
    return controlMetricsImplementation(modifiers.controlSize, modifiers)
}

// How large a glyph is drawn here: on the EM of the type it stands in, the way
// a symbol is on the platform.
//
// A symbol is a character in the run beside it, and like a character it is
// drawn on the font's em box rather than fitted to a band. Each glyph's ink is
// as tall as its artwork draws it on that em — `play.rectangle` squat,
// `photo.on.rectangle` tall; the platform's menu renders the two 69 and 83
// device pixels high at one size. Fitting every glyph's INK to the cap band made
// them one height, and all of them small: the platform's row glyph is 17.3pt of
// ink beside 12.3pt capitals.
function iconScaleSize(scale: IconScale, modifiers: borrow ModifierContext) -> Float {
    return iconScaleFactor(scale) * iconTypeSize(modifiers)
}

// The cap band of the type in effect, measured from the face: `H` reaches the
// cap line and sits on the baseline, so the top of its ink IS the band.
function iconCapBand(modifiers: borrow ModifierContext) -> Float {
    return foundationTextRunInkTop("H", iconTypeSize(modifiers), iconTypeWeight(modifiers))
}


// The type a glyph is standing in, resolved through exactly the order a run of
// text resolves its own size — so a glyph in a `.headline` is headline-sized, a
// glyph in a `.font(...)` is that font's, and a glyph in neither is body-sized
// like the words it stands with.
function iconTypeSize(modifiers: borrow ModifierContext) -> Float {
    if modifiers.hasFont {
        return modifiers.fontSize
    }
    if modifiers.hasTypography {
        return typographyImplementation(modifiers.typography, modifiers).size
    }
    return modifierTokens(modifiers).bodySize
}

// The scale steps, against the cap band: a medium glyph IS the capitals beside
// it, and the steps either side are the ones the platform's symbol scales take.
function iconScaleFactor(scale: borrow IconScale) -> Float {
    match scale {
        Small -> return 0.85
        Medium -> return 1.0
        Large -> return 1.2
        ExtraLarge -> return 1.5
    }
}

construct ControlSizeLayer(value: ControlSize) extends Widget {
    let content: some Widget


    function describe(context: borrow BuildContext, modifiers: borrow ModifierContext) -> CALayerDescription {
        let resolved = modifierContextApply(modifiers, modifierDeltaControlSize(value))
        return content.describe(context, resolved)
    }
}

construct ImageScaleLayer(value: IconScale) extends Widget {
    let content: some Widget


    function describe(context: borrow BuildContext, modifiers: borrow ModifierContext) -> CALayerDescription {
        let resolved = modifierContextApply(modifiers, modifierDeltaImageScale(value))
        return content.describe(context, resolved)
    }
}

construct TintLayer(value: PrimaryColor) extends Widget {
    let content: some Widget


    function describe(context: borrow BuildContext, modifiers: borrow ModifierContext) -> CALayerDescription {
        let resolved = modifierContextApply(modifiers, modifierDeltaTint(value))
        return content.describe(context, resolved)
    }
}
