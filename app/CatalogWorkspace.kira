import Foundation
import KCoreUI
import KCoreAnimation

// The lengths a workspace is laid out with, resolved once for each interface
// mode like every other group the catalog sizes.

// The gap the panels stand apart by on the window's canvas; the room a tab
// holds its cross in by; how far a panel holds its strip off its edges; the
// band a divider is grabbed by, which is wider than the gap it runs down; how
// wide or tall each edge opens; and how small one may be dragged before it
// folds away.
public struct WorkspaceMetrics {
    let gap: Number
    let tabSpacing: Number
    let stripInset: Number
    let dividerThickness: Number
    let leadingWidth: Number
    let trailingWidth: Number
    let bottomHeight: Number
    let minimumWidth: Number
    let minimumHeight: Number
}

public function catalogWorkspaceMetrics(mode: InterfaceMode) -> WorkspaceMetrics {
    return WorkspaceMetrics {
        gap: catalogMetric(catalogStack, MetricName.workspaceGap, mode),
        tabSpacing: catalogMetric(catalogStack, MetricName.workspaceTabSpacing, mode),
        stripInset: catalogMetric(catalogStack, MetricName.workspaceStripInset, mode),
        dividerThickness: catalogMetric(catalogStack, MetricName.workspaceDividerThickness, mode),
        leadingWidth: catalogMetric(catalogStack, MetricName.workspaceLeadingWidth, mode),
        trailingWidth: catalogMetric(catalogStack, MetricName.workspaceTrailingWidth, mode),
        bottomHeight: catalogMetric(catalogStack, MetricName.workspaceBottomHeight, mode),
        minimumWidth: catalogMetric(catalogStack, MetricName.workspaceMinimumWidth, mode),
        minimumHeight: catalogMetric(catalogStack, MetricName.workspaceMinimumHeight, mode)
    }
}

let desktopWorkspaceMetrics = catalogWorkspaceMetrics(.AdaptiveDesktop)
let mobileWorkspaceMetrics = catalogWorkspaceMetrics(.AdaptiveMobile)

public function workspaceMetrics() -> WorkspaceMetrics {
    return interfaceMode() == .AdaptiveDesktop ? desktopWorkspaceMetrics : mobileWorkspaceMetrics
}

// The card a workspace's panels sit on.
public let workspacePanelColor = catalogAdaptive(catalogStack, ColorName.workspacePanel)

// The window under a workspace's cards: the grouped background, a gray a
// step under the white cards in the light appearance and black under the dark
// ones, as grouped content stands on it.
public let workspaceCanvasColor = catalogAdaptive(catalogStack, ColorName.systemGroupedBackground)

// The card's color as a layer fill, through the opacity in effect.
public function workspacePanelFill(modifiers: borrow ModifierContext) -> CAColor {
    let resolved = themeAdaptiveColor(workspacePanelColor, modifierAppearance(modifiers))
    return colorFromFoundation(modifierColor(foundationColor(move resolved), modifiers))
}

// How far an edge opens before anyone has dragged its divider.
public function workspaceOpeningExtent(edge: borrow PanelEdge) -> Number {
    let metrics = workspaceMetrics()
    match edge {
        Leading -> return metrics.leadingWidth
        Trailing -> return metrics.trailingWidth
        Bottom -> return metrics.bottomHeight
        Center -> return 0.0
    }
}

// The least an edge may be dragged to before it folds away.
public function workspaceMinimumExtent(edge: borrow PanelEdge) -> Number {
    let metrics = workspaceMetrics()
    match edge {
        Leading -> return metrics.minimumWidth
        Trailing -> return metrics.minimumWidth
        Bottom -> return metrics.minimumHeight
        Center -> return 0.0
    }
}
