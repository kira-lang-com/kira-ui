// KiraUI's canonical style vocabulary. The family is intentionally small and
// typed: an application fills the tokens once, and component style values are
// construct-backed updates of the same implementation.

// The presentation a style's tokens are authored around. A style declares the
// branch it wants by default; the host environment overrides it with
// KIRA_UI_APPEARANCE=light|dark. Without this the only way an application could
// pick a default was to re-encode the choice inside every single adaptive token,
// which is exactly the duplication the token vocabulary exists to remove.
enum Appearance {
    Light
    Dark
}

struct AdaptiveColor {
    let light: Color
    let dark: Color
}

struct StyleColorTokens {
    let foregroundPrimary: AdaptiveColor
    let foregroundSecondary: AdaptiveColor
    let foregroundDisabled: AdaptiveColor
    let foregroundInverse: AdaptiveColor
    let backgroundCanvas: AdaptiveColor
    let backgroundSurface: AdaptiveColor
    let backgroundRaised: AdaptiveColor
    let backgroundOverlay: AdaptiveColor
    let backgroundControl: AdaptiveColor
    let accent: AdaptiveColor
    let danger: AdaptiveColor
    let success: AdaptiveColor
    let warning: AdaptiveColor
    let borderSubtle: AdaptiveColor
    let borderStandard: AdaptiveColor
    let borderStrong: AdaptiveColor
    let borderFocus: AdaptiveColor
    let glassTint: AdaptiveColor
}

struct StyleCornerRadiusTokens {
    let none: Float
    let small: Float
    let medium: Float
    let large: Float
    let extraLarge: Float
    let capsule: Float
}

struct StyleSpacingTokens {
    let none: Float
    let extraSmall: Float
    let small: Float
    let medium: Float
    let large: Float
    let extraLarge: Float
    let section: Float
}

struct FontImplementation {
    let size: Float
    let weight: FontWeight
    let lineHeight: Float
    let tracking: Float
}

// Every entry here must be reachable from `.typography(...)`. `control` and
// `title` are required tokens on the style, so leaving them out of this enum
// left applications with no way to ask for the font their own theme declared —
// which is how explicit `.font(size:weight:)` calls creep back in.
enum TypographyStyle {
    caption
    body
    control
    subheadline
    bodyEmphasis
    footnote
    overline
    label
    section
    headline
    title
    title1
    title2
    title3
}

enum Spacing {
    None
    ExtraSmall
    Small
    Medium
    Large
    ExtraLarge
    Section
}

struct StyleTypographyTokens {
    let caption: FontImplementation
    let body: FontImplementation
    let control: FontImplementation
    let title: FontImplementation
    let bodyEmphasis: FontImplementation = FontImplementation {
        size: 14.0
        weight: FontWeight.SemiBold
        lineHeight: 20.0
        tracking: 0.0
    }
    let subheadline: FontImplementation = FontImplementation {
        size: 13.0
        weight: FontWeight.Regular
        lineHeight: 18.0
        tracking: 0.0
    }
    let footnote: FontImplementation = FontImplementation {
        size: 11.0
        weight: FontWeight.Regular
        lineHeight: 15.0
        tracking: 0.0
    }
    let overline: FontImplementation = FontImplementation {
        size: 10.0
        weight: FontWeight.SemiBold
        lineHeight: 13.0
        tracking: 0.5
    }
    let label: FontImplementation = FontImplementation {
        size: 12.0
        weight: FontWeight.SemiBold
        lineHeight: 16.0
        tracking: 0.0
    }
    let section: FontImplementation = FontImplementation {
        size: 16.0
        weight: FontWeight.Bold
        lineHeight: 20.0
        tracking: 0.0
    }
    let headline: FontImplementation = FontImplementation {
        size: 18.0
        weight: FontWeight.SemiBold
        lineHeight: 23.0
        tracking: 0.0
    }
    let title1: FontImplementation = FontImplementation {
        size: 30.0
        weight: FontWeight.Bold
        lineHeight: 36.0
        tracking: -0.3
    }
    let title2: FontImplementation = FontImplementation {
        size: 24.0
        weight: FontWeight.Bold
        lineHeight: 29.0
        tracking: -0.2
    }
    let title3: FontImplementation = FontImplementation {
        size: 28.0
        weight: FontWeight.Bold
        lineHeight: 34.0
        tracking: -0.2
    }
}

enum StyleBorderColor {
    BorderSubtle
    BorderStandard
    BorderStrong
    BorderFocus
}

struct BorderImplementation {
    let color: StyleBorderColor
    let width: Float
}

struct StyleBorderTokens {
    let none: BorderImplementation
    let subtle: BorderImplementation
    let standard: BorderImplementation
    let strong: BorderImplementation
    let focus: BorderImplementation
}

enum MaterialLevel {
    Low
    Medium
    High
    XHigh
}

struct FrostedMaterialImplementation {
    let level: MaterialLevel
}

struct LiquidGlassMaterialImplementation {
    let level: MaterialLevel
    let edgeLighting: Bool
    let material: MaterialLevel = MaterialLevel.XHigh
}

struct StyleMaterialTokens {
    let frosted: FrostedMaterialImplementation
    let liquidGlass: LiquidGlassMaterialImplementation
}

enum ShadowLevel {
    Light
    Medium
    Heavy
}

struct ShadowEffect {
    let level: ShadowLevel
}

function defaultStyleColorTokens() -> StyleColorTokens {
    return StyleColorTokens {
        foregroundPrimary: AdaptiveColor {
            light: Color { r: 0.08, g: 0.09, b: 0.12, a: 1.0 }
            dark: Color { r: 0.95, g: 0.96, b: 0.99, a: 1.0 }
        }
        foregroundSecondary: AdaptiveColor {
            light: Color { r: 0.38, g: 0.40, b: 0.46, a: 1.0 }
            dark: Color { r: 0.68, g: 0.71, b: 0.78, a: 1.0 }
        }
        foregroundDisabled: AdaptiveColor {
            light: Color { r: 0.50, g: 0.51, b: 0.55, a: 0.58 }
            dark: Color { r: 0.58, g: 0.60, b: 0.66, a: 0.58 }
        }
        foregroundInverse: AdaptiveColor {
            light: Color { r: 0.98, g: 0.98, b: 1.0, a: 1.0 }
            dark: Color { r: 0.06, g: 0.07, b: 0.10, a: 1.0 }
        }
        backgroundCanvas: AdaptiveColor {
            light: Color { r: 0.95, g: 0.96, b: 0.98, a: 1.0 }
            dark: Color { r: 0.035, g: 0.04, b: 0.065, a: 1.0 }
        }
        backgroundSurface: AdaptiveColor {
            light: Color { r: 1.0, g: 1.0, b: 1.0, a: 0.92 }
            dark: Color { r: 0.08, g: 0.10, b: 0.15, a: 0.92 }
        }
        backgroundRaised: AdaptiveColor {
            light: Color { r: 1.0, g: 1.0, b: 1.0, a: 0.98 }
            dark: Color { r: 0.12, g: 0.14, b: 0.20, a: 0.96 }
        }
        backgroundOverlay: AdaptiveColor {
            light: Color { r: 0.96, g: 0.97, b: 1.0, a: 0.88 }
            dark: Color { r: 0.10, g: 0.12, b: 0.18, a: 0.88 }
        }
        backgroundControl: AdaptiveColor {
            light: Color { r: 0.91, g: 0.93, b: 0.98, a: 1.0 }
            dark: Color { r: 0.16, g: 0.18, b: 0.26, a: 1.0 }
        }
        accent: AdaptiveColor {
            light: Color { r: 0.20, g: 0.45, b: 0.96, a: 1.0 }
            dark: Color { r: 0.43, g: 0.67, b: 1.0, a: 1.0 }
        }
        danger: AdaptiveColor {
            light: Color { r: 0.82, g: 0.12, b: 0.18, a: 1.0 }
            dark: Color { r: 0.96, g: 0.31, b: 0.37, a: 1.0 }
        }
        success: AdaptiveColor {
            light: Color { r: 0.12, g: 0.58, b: 0.30, a: 1.0 }
            dark: Color { r: 0.34, g: 0.85, b: 0.52, a: 1.0 }
        }
        warning: AdaptiveColor {
            light: Color { r: 0.78, g: 0.48, b: 0.06, a: 1.0 }
            dark: Color { r: 0.98, g: 0.75, b: 0.25, a: 1.0 }
        }
        borderSubtle: AdaptiveColor {
            light: Color { r: 0.08, g: 0.10, b: 0.16, a: 0.10 }
            dark: Color { r: 1.0, g: 1.0, b: 1.0, a: 0.10 }
        }
        borderStandard: AdaptiveColor {
            light: Color { r: 0.08, g: 0.10, b: 0.16, a: 0.18 }
            dark: Color { r: 1.0, g: 1.0, b: 1.0, a: 0.18 }
        }
        borderStrong: AdaptiveColor {
            light: Color { r: 0.08, g: 0.10, b: 0.16, a: 0.32 }
            dark: Color { r: 1.0, g: 1.0, b: 1.0, a: 0.32 }
        }
        borderFocus: AdaptiveColor {
            light: Color { r: 0.20, g: 0.45, b: 0.96, a: 0.86 }
            dark: Color { r: 0.43, g: 0.67, b: 1.0, a: 0.90 }
        }
        glassTint: AdaptiveColor {
            light: Color { r: 1.0, g: 1.0, b: 1.0, a: 1.0 }
            dark: Color { r: 0.72, g: 0.78, b: 0.92, a: 1.0 }
        }
    }
}

function defaultStyleCornerRadiusTokens() -> StyleCornerRadiusTokens {
    return StyleCornerRadiusTokens {
        none: 0.0
        small: 8.0
        medium: 12.0
        large: 18.0
        extraLarge: 24.0
        capsule: 999.0
    }
}

function defaultStyleSpacingTokens() -> StyleSpacingTokens {
    return StyleSpacingTokens {
        none: 0.0
        extraSmall: 4.0
        small: 8.0
        medium: 12.0
        large: 18.0
        extraLarge: 24.0
        section: 32.0
    }
}

function defaultStyleTypographyTokens() -> StyleTypographyTokens {
    let body = FontImplementation {
        size: 15.0
        weight: FontWeight.Regular
        lineHeight: 21.0
        tracking: 0.0
    }
    return StyleTypographyTokens {
        caption: FontImplementation {
            size: 12.0
            weight: FontWeight.Regular
            lineHeight: 16.0
            tracking: 0.2
        }
        body: body
        control: FontImplementation {
            size: 15.0
            weight: FontWeight.SemiBold
            lineHeight: 20.0
            tracking: 0.0
        }
        title: FontImplementation {
            size: 28.0
            weight: FontWeight.Bold
            lineHeight: 34.0
            tracking: -0.3
        }
    }
}

function defaultStyleBorderTokens() -> StyleBorderTokens {
    return StyleBorderTokens {
        none: BorderImplementation { color: StyleBorderColor.BorderSubtle, width: 0.0 }
        subtle: BorderImplementation { color: StyleBorderColor.BorderSubtle, width: 1.0 }
        standard: BorderImplementation { color: StyleBorderColor.BorderStandard, width: 1.0 }
        strong: BorderImplementation { color: StyleBorderColor.BorderStrong, width: 1.5 }
        focus: BorderImplementation { color: StyleBorderColor.BorderFocus, width: 2.0 }
    }
}

function defaultStyleMaterialTokens() -> StyleMaterialTokens {
    return StyleMaterialTokens {
        frosted: FrostedMaterialImplementation { level: MaterialLevel.Medium }
        liquidGlass: LiquidGlassMaterialImplementation {
            level: MaterialLevel.XHigh
            edgeLighting: true
        }
    }
}

construct StyleImplementation {
    @Required let colors: StyleColorTokens
    @Required let cornerRadii: StyleCornerRadiusTokens
    @Required let spacing: StyleSpacingTokens
    @Required let typography: StyleTypographyTokens
    @Required let borders: StyleBorderTokens
    @Required let materials: StyleMaterialTokens
    // Which branch of every AdaptiveColor this style presents when the host has
    // no appearance preference.
    let appearance: Appearance = Appearance.Dark
    // The grouped token is the canonical source; this flattened member is the
    // component-override surface used by `liquidGlass.material: ...`.
    let liquidGlass: LiquidGlassMaterialImplementation = LiquidGlassMaterialImplementation {
        level: MaterialLevel.XHigh
        edgeLighting: true
    }
    let additionalEffect: [ShadowEffect] = []
    let thickness: Float = 1.0
}

StyleImplementation DefaultStyle {
    let colors = defaultStyleColorTokens()
    let cornerRadii = defaultStyleCornerRadiusTokens()
    let spacing = defaultStyleSpacingTokens()
    let typography = defaultStyleTypographyTokens()
    let borders = defaultStyleBorderTokens()
    let materials = defaultStyleMaterialTokens()
}
