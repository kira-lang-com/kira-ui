import Foundation

// How a symbol becomes a drawing.
//
// The names are in SymbolNames.kira and the drawings in SymbolAssets.kira, both
// generated from Phosphor Icons (MIT, phosphor-icons/core, regular weight). What
// lives here is the part that is a design decision rather than a data dump: how
// a theme redraws one.
//
// A theme states OVERRIDES rather than a full table. Fifteen hundred icons is
// far past the point where "one struct member per icon" works — a theme wanting
// its own folder would have to restate the other fifteen hundred and eleven —
// and a list of the ones it disagrees about is the same statement without the
// restating:
//
//     StyleImplementation AppStyle {
//         let symbols = StyleSymbolTokens {
//             overrides = [
//                 SymbolOverride { symbol = .Folder, svg = "<svg …>" }
//             ]
//         }
//     }

// One redrawn symbol.
public struct SymbolOverride {
    let symbol: Symbol
    let svg: String
}

// The symbols a style draws differently from the library's own.
public struct StyleSymbolTokens {
    let overrides: [SymbolOverride] = []
}

// The library's drawings, built once and kept: a match across every case
// walked them in order, and copied the drawing out, on each lookup.
struct KiraUiSymbolAssets {
    var drawings: [String] = []
}

function kiraUiSymbolAssetsKey() -> String {
    return "kiraui.symbol.assets"
}

// The library's own drawing of a symbol.
public function symbolAsset(symbol: borrow Symbol) -> String {
    var slot = kiraUiStateSlotGet(kiraUiSymbolAssetsKey())
    if slot == RawPtr.null {
        kiraUiStateSlotPut(kiraUiSymbolAssetsKey(), nativeUserData(nativeState(KiraUiSymbolAssets { drawings: symbolAssetTable() })))
        slot = kiraUiStateSlotGet(kiraUiSymbolAssetsKey())
    }
    let assets = nativeRecover<KiraUiSymbolAssets>(slot)
    return assets.drawings[code(symbol)]
}

public function styleSymbol(symbols: borrow StyleSymbolTokens, symbol: borrow Symbol) -> String {
    for entry in symbols.overrides {
        if entry.symbol == symbol {
            return entry.svg
        }
    }
    return symbolAsset(symbol)
}

// The drawing a symbol resolves to here: the override the theme in effect
// states, or the library's own — the same rule every other token family
// resolves by.
public function symbolImplementation(symbol: Symbol, modifiers: borrow ModifierContext) -> String {
    if modifiers.symbolVariant == .Fill {
        return modifierSymbol(modifiers, symbolFilled(symbol))
    }
    return modifierSymbol(modifiers, symbol)
}

// SwiftUI's `SymbolVariants`: the drawing of a symbol a subtree asks for. A
// symbol the set has no fill for is drawn as it is.
public enum SymbolVariants {
    None
    Fill
}

// The em a symbol stated in SF Symbols' point size is drawn at here.
//
// Apple states a symbol as a point size, and this library's drawings sit in a
// larger em than SF's: set at the same nominal size, every glyph comes out
// about four fifths as tall — a bell's ink is 14.6 points against SF's 18.8 at
// 17, an ellipsis circle's 14.6 against 17.9, a sidebar's 13.1 against 16.9.
// Scaling the em by their ratio sets the drawing at the size Apple's is.
public function symbolEm(points: Float) -> Float {
    return points * 1.28
}

// How much heavier than drawn a symbol stated at `weight` is, in points of
// outward growth on each side of its strokes.
//
// Brought to SF's size, this library's strokes are SF's regular weight: an
// ellipsis circle's ring 1.6 points against SF's 1.5 at 17, a sidebar's 1.44
// against 1.5. SF's own stroke grows with weight at about 0.018% of the point
// size per unit — 1.5 points at regular, 1.875 at medium (510), 2.375 at bold —
// so the difference from regular, halved because growth thickens both sides,
// is what the drawing has to gain. A weight lighter than regular is drawn as
// regular: growth only ever thickens.
public function symbolWeightGrowth(points: Float, weight: Float) -> Float {
    if weight <= 400.0 {
        return 0.0
    }
    return points * 0.00009 * (weight - 400.0)
}
