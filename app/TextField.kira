import KiraLayout
import KiraGraphics
import Foundation
import KCoreAnimation
// TextField — a focusable, editable single-line text input.
//
// The library owns the edit state (codepoint buffer + caret) in a per-key state
// slot, seeded once from `initial` (String is opaque, so it is decoded to
// codepoints via foundationStringToCodepoints). Typing inserts
// at the caret; Backspace / forward-Delete remove around it; Left/Right/Home/End
// move it; a click focuses the field and sets the caret to the nearest character
// (prefix measurement). The caret is rendered without measurement by splitting
// the text at the caret and placing a thin bar between the two halves. Return
// fires onSubmit; the text stays, and `textFieldText(key)` reads it.

public struct KiraUiTextFieldState {
    var codes: [Int] = []
    var caret: Int = 0
    // Selection anchor. anchor == caret means no selection; otherwise the
    // selection spans [min(anchor,caret), max(anchor,caret)).
    var anchor: Int = 0
    var seeded: Bool = false
}

public function textFieldSelMin(anchor: Int, caret: Int) -> Int {
    if anchor < caret {
        return anchor
    }
    return caret
}

public function textFieldSelMax(anchor: Int, caret: Int) -> Int {
    if anchor > caret {
        return anchor
    }
    return caret
}

// Per-field slot key.
public function textFieldSlotKey(key: Int) -> String {
    return kiraUiSlotKey("kiraui.tf.", key)
}

public function textFieldEnsure(key: Int) {
    if kiraUiStateSlotHas(textFieldSlotKey(key)) == false {
        kiraUiStateSlotPut(textFieldSlotKey(key), nativeUserData(nativeState(KiraUiTextFieldState {})))
    }
    return
}

public function textFieldSeed(key: Int, initial: borrow String) {
    textFieldEnsure(key)
    var st = nativeRecover<KiraUiTextFieldState>(kiraUiStateSlotGet(textFieldSlotKey(key)))
    if st.seeded == false {
        st.codes = foundationStringToCodepoints(initial)
        st.caret = st.codes.count
        st.anchor = st.caret
        st.seeded = true
    }
    return
}

public function textFieldText(key: Int) -> String {
    textFieldEnsure(key)
    let st = nativeRecover<KiraUiTextFieldState>(kiraUiStateSlotGet(textFieldSlotKey(key)))
    return foundationStringFromCodepoints(st.codes, 0, st.codes.count)
}

public function textFieldReset(key: Int) {
    textFieldEnsure(key)
    var st = nativeRecover<KiraUiTextFieldState>(kiraUiStateSlotGet(textFieldSlotKey(key)))
    var empty: [Int] = []
    st.codes = move empty
    st.caret = 0
    st.anchor = 0
    st.seeded = false
    return
}

// Delete the selected range (if any), collapsing the caret to its start.
public function textFieldDeleteSelection(key: Int) {
    textFieldEnsure(key)
    var st = nativeRecover<KiraUiTextFieldState>(kiraUiStateSlotGet(textFieldSlotKey(key)))
    if st.anchor == st.caret {
        return
    }
    let a = textFieldSelMin(st.anchor, st.caret)
    let b = textFieldSelMax(st.anchor, st.caret)
    var next: [Int] = []
    var i = 0
    while i < st.codes.count {
        if i < a || i >= b {
            next.append(st.codes[i])
        }
        i = i + 1
    }
    st.codes = move next
    st.caret = a
    st.anchor = a
    return
}

public function textFieldSelectAll(key: Int) {
    textFieldEnsure(key)
    var st = nativeRecover<KiraUiTextFieldState>(kiraUiStateSlotGet(textFieldSlotKey(key)))
    st.anchor = 0
    st.caret = st.codes.count
    return
}

public function textFieldInsert(key: Int, cp: Int) {
    if cp < 32 {
        return
    }
    // Typing over a selection replaces it.
    textFieldDeleteSelection(key)
    textFieldEnsure(key)
    var st = nativeRecover<KiraUiTextFieldState>(kiraUiStateSlotGet(textFieldSlotKey(key)))
    var next: [Int] = []
    var i = 0
    while i < st.caret {
        next.append(st.codes[i])
        i = i + 1
    }
    next.append(cp)
    while i < st.codes.count {
        next.append(st.codes[i])
        i = i + 1
    }
    st.codes = move next
    st.caret = st.caret + 1
    st.anchor = st.caret
    return
}

public function textFieldBackspace(key: Int) {
    textFieldEnsure(key)
    var st = nativeRecover<KiraUiTextFieldState>(kiraUiStateSlotGet(textFieldSlotKey(key)))
    // A selection is deleted whole.
    if st.anchor != st.caret {
        textFieldDeleteSelection(key)
        return
    }
    if st.caret <= 0 {
        return
    }
    let removeAt = st.caret - 1
    var next: [Int] = []
    var i = 0
    while i < st.codes.count {
        if i != removeAt {
            next.append(st.codes[i])
        }
        i = i + 1
    }
    st.codes = move next
    st.caret = st.caret - 1
    st.anchor = st.caret
    return
}

public function textFieldDeleteForward(key: Int) {
    textFieldEnsure(key)
    var st = nativeRecover<KiraUiTextFieldState>(kiraUiStateSlotGet(textFieldSlotKey(key)))
    if st.anchor != st.caret {
        textFieldDeleteSelection(key)
        return
    }
    if st.caret >= st.codes.count {
        return
    }
    let removeAt = st.caret
    var next: [Int] = []
    var i = 0
    while i < st.codes.count {
        if i != removeAt {
            next.append(st.codes[i])
        }
        i = i + 1
    }
    st.codes = move next
    return
}

public function textFieldNav(key: Int, keyCode: Int) {
    if keyCode == 261 {
        textFieldDeleteForward(key)
        return
    }
    if keyCode == 300 {
        textFieldSelectAll(key)
        return
    }
    textFieldEnsure(key)
    var st = nativeRecover<KiraUiTextFieldState>(kiraUiStateSlotGet(textFieldSlotKey(key)))
    let hasSel = st.anchor != st.caret
    if keyCode == 263 {
        // Left: collapse a selection to its start, else step left.
        if hasSel {
            st.caret = textFieldSelMin(st.anchor, st.caret)
        } else {
            if st.caret > 0 {
                st.caret = st.caret - 1
            }
        }
        st.anchor = st.caret
    }
    if keyCode == 262 {
        if hasSel {
            st.caret = textFieldSelMax(st.anchor, st.caret)
        } else {
            if st.caret < st.codes.count {
                st.caret = st.caret + 1
            }
        }
        st.anchor = st.caret
    }
    if keyCode == 268 {
        st.caret = 0
        st.anchor = 0
    }
    if keyCode == 269 {
        st.caret = st.codes.count
        st.anchor = st.caret
    }
    return
}

// Click-to-position: map the press x (relative to the field's text start) to the
// nearest caret index by measuring codepoint prefixes.
public function textFieldClickCaret(key: Int, size: Float, weight: Float, leftPad: Float) {
    textFieldEnsure(key)
    var st = nativeRecover<KiraUiTextFieldState>(kiraUiStateSlotGet(textFieldSlotKey(key)))
    let relX = kiraUiPointerX() - kiraUiPressBoundsX() - leftPad
    if relX <= 0.0 {
        st.caret = 0
        st.anchor = 0
        return
    }
    let n = st.codes.count
    var k = 0
    var prevW = 0.0
    var placed = false
    while k <= n && placed == false {
        let prefix = foundationStringFromCodepoints(st.codes, 0, k)
        let w = foundationTextRunWidth(prefix, size, weight)
        if w >= relX {
            if k > 0 && (relX - prevW) < (w - relX) {
                st.caret = k - 1
            } else {
                st.caret = k
            }
            placed = true
        }
        prevW = w
        k = k + 1
    }
    if placed == false {
        st.caret = n
    }
    // A click positions the caret and clears any selection.
    st.anchor = st.caret
    return
}

// --- Closure builders (capture locals, never widget fields). ---

public function textFieldInsertFn(key: Int) -> (Int) -> Void {
    let k = key
    let f: (Int) -> Void = { cp in
        textFieldInsert(k, cp)
        return
    }
    return f
}

public function textFieldBackspaceFn(key: Int) -> () -> Void {
    let k = key
    let f: () -> Void = { in
        textFieldBackspace(k)
        return
    }
    return f
}

public function textFieldNavFn(key: Int) -> (Int) -> Void {
    let k = key
    let f: (Int) -> Void = { kc in
        textFieldNav(k, kc)
        return
    }
    return f
}

// The keys a focused field answers: Return submits, Delete removes behind the
// caret, and the rest move it.
public function textFieldCommandFn(key: Int, onSubmit: () -> Void) -> (Int) -> Void {
    let k = key
    let submit = onSubmit
    let f: (Int) -> Void = { code in
        if code == 257 {
            submit()
        } else if code == 259 {
            textFieldBackspace(k)
        } else {
            textFieldNav(k, code)
        }
        return
    }
    return f
}

// One run of a field's text, in the field's size and `ink`, keyed `key`.
//
// A field is one line: its runs never wrap, and they land where typing or the
// caret puts them at once -- a run eased to its new width would break onto
// further lines on the way there.
public function textFieldRun(
    content: String,
    size: Float,
    key: Int,
    ink: PrimaryColor,
    context: borrow BuildContext,
    modifiers: borrow ModifierContext,
) -> CALayerDescription {
    return textFieldLine(Text(content)
        .font(size: size, weight: .Axis(textFieldWeight(modifiers)))
        .foregroundColor(move ink)
        .describe(context, modifiers), key)
}

// A described run, made one of a field's lines.
public function textFieldLine(described: CALayerDescription, key: Int) -> CALayerDescription {
    var run = move described
    run.key = key
    run.disablesActions = true
    match run.content {
        Text(t) -> {
            var line = copy t
            line.wraps = false
            run.content = .Text(move line)
        }
        Empty -> {}
        Solid(s) -> {}
        Texture(x) -> {}
        Icon(i) -> {}
        Glass(g) -> {}
        Gradient(g) -> {}
    }
    return run
}

// The field's runs are keyed by what they are, not where they fall: the caret
// comes and goes beside the text and the placeholder, and a run matched by
// position would hand one's layer to the other and animate between them.
public function textFieldPlaceholderKey() -> Int {
    return 1
}

public function textFieldLeadKey() -> Int {
    return 2
}

public function textFieldCaretKey() -> Int {
    return 3
}

public function textFieldTrailKey() -> Int {
    return 4
}


// The insertion point: the catalog's bar in the accent.
public function textFieldCaret(modifiers: borrow ModifierContext) -> CALayerDescription {
    let metrics = caretMetrics
    return CALayerDescription {
        key: textFieldCaretKey(),
        layout: CALayoutIntent {
            widthFill: false,
            heightFill: false,
            fixedWidth: metrics.width,
            fixedHeight: metrics.height
        },
        cornerRadius: metrics.width / 2.0,
        disablesActions: true,
        content: .Solid(CASolid {
            fill: caColorFromFoundation(modifierColor(foundationColor(modifierTokens(modifiers).tint.accent), modifiers)),
            cornerRadius: metrics.width / 2.0
        })
    }
}

public function textFieldPressFn(key: Int, size: Float, weight: Float, leftPad: Float) -> () -> Void {
    let k = key
    let sz = size
    let wt = weight
    let lp = leftPad
    let f: () -> Void = { in
        textFieldClickCaret(k, sz, wt, lp)
        return
    }
    return f
}

public function textFieldColor(c: borrow FoundationColor) -> FoundationColor {
    return foundationRgba(c.r, c.g, c.b, c.a)
}

public function textFieldColorWithOpacity(
    c: borrow FoundationColor,
    opacity: Float,
) -> FoundationColor {
    return foundationRgba(c.r, c.g, c.b, c.a * opacity)
}

// The weight editable text is set at: the weight of the type in effect.
//
// One value, resolved once, because the caret is placed by measuring PREFIXES of
// the same string the field draws: a measurement at one weight and a draw at
// another puts the caret beside the glyph it belongs to rather than against it.
public function textFieldWeight(modifiers: borrow ModifierContext) -> Float {
    return modifierTextWeight(modifiers)
}

public function textFieldTextSize(modifiers: borrow ModifierContext) -> Float {
    if modifiers.hasFont {
        return modifiers.fontSize
    }
    if modifiers.hasTypography {
        return typographyImplementation(modifiers.typography, modifiers).size
    }
    return modifierTokens(modifiers).bodySize
}

public function textFieldPlaceholderColor(modifiers: borrow ModifierContext) -> FoundationColor {
    return modifierColor(foundationColor(modifierTokens(modifiers).foreground.tertiary), modifiers)
}

// The selection band is the accent at reading strength — opaque accent would
// bury the glyphs it is drawn behind.
public function textFieldSelectionColor(modifiers: borrow ModifierContext) -> FoundationColor {
    let accent = modifierTokens(modifiers).tint.accent
    return modifierColor(foundationColor(colorWithAlpha(accent, 0.35)), modifiers)
}

public function textFieldRadius(modifiers: borrow ModifierContext) -> Float {
    return modifierTokens(modifiers).controlRadius
}

// An editable field resolves its own presentation from the theme, exactly like
// Button and Card. Requiring five explicit colors at every call site meant a
// field could never follow a theme change, and made the surrounding code carry a
// resolved palette purely to feed this constructor.
//
// Overrides remain available through the ordinary modifiers: `.background(...)`
// or `.fill(...)` for the field's background, `.themeColor(...)` /
// `.textColor(...)` for the ink, `.typography(...)` / `.font(...)` for the size.
public construct TextField(
    key: Int,
    initial: String,
    placeholder: String,
    width: Float,
    height: Float,
    onSubmit: () -> Void
) extends Widget {

    // The field's text, or its placeholder while it is empty. Focused, it takes
    // the keyboard and splits its text at the caret with the insertion point
    // drawn between the halves, so no glyph has to be measured to place it.
    //
    // In a grouped list the row is the field, as it is in a platform form: no
    // fill of its own, across the row. Anywhere else it is a filled box of the
    // size it was given.
    function describe(context: borrow BuildContext, modifiers: borrow ModifierContext) -> CALayerDescription {
        let size = textFieldTextSize(modifiers)
        textFieldSeed(key, initial)
        kiraUiLayerTextInputRegister(key, textFieldInsertFn(key), textFieldCommandFn(key, onSubmit))
        let st = nativeRecover<KiraUiTextFieldState>(kiraUiStateSlotGet(textFieldSlotKey(key)))
        let focused = context.focusedKey == key
        var runs: [CALayerDescription] = []
        if st.codes.count == 0 {
            if focused {
                runs.append(textFieldCaret(modifiers))
            }
            runs.append(textFieldRun(placeholder, size, textFieldPlaceholderKey(), .Tertiary, context, modifiers))
        } else if focused {
            runs.append(textFieldRun(foundationStringFromCodepoints(st.codes, 0, st.caret), size, textFieldLeadKey(), .Primary, context, modifiers))
            runs.append(textFieldCaret(modifiers))
            runs.append(textFieldRun(foundationStringFromCodepoints(st.codes, st.caret, st.codes.count), size, textFieldTrailKey(), .Primary, context, modifiers))
        } else {
            runs.append(textFieldRun(foundationStringFromCodepoints(st.codes, 0, st.codes.count), size, textFieldLeadKey(), .Primary, context, modifiers))
        }
        let grouped = modifiers.controlPresentation == .InsetGrouped
        var fill = transparentFoundationColor()
        if !grouped {
            fill = modifierSurfaceFill(foundationColor(modifierTokens(modifiers).fill.control), modifiers)
        }
        let radius = textFieldRadius(modifiers)
        let inset = grouped ? 0.0 : radius
        kiraUiLayerActionRegister(key, textFieldPressFn(key, size, textFieldWeight(modifiers), inset))
        return CALayerDescription {
            layout: CALayoutIntent {
                axis: .Row,
                widthFill: grouped || width <= 0.0,
                heightFill: false,
                fixedWidth: grouped || width <= 0.0 ? -1.0 : width,
                fixedHeight: height,
                paddingLeading: inset,
                paddingTrailing: inset,
                flex: grouped || width <= 0.0 ? 1 : 0,
                alignment: Point { x: 0.0, y: 0.5 }
            },
            hittable: !modifiers.disabled,
            hitKey: key,
            cornerRadius: radius,
            clipsChildren: true,
            content: .Solid(CASolid {
                fill: caColorFromFoundation(textFieldColorWithOpacity(fill, modifiers.opacity)),
                cornerRadius: radius
            }),
            sublayers: move runs
        }
    }
}
