import KiraLayout
import KiraGraphics
import Foundation
import KCoreAnimation
// TextField — a focusable, editable single-line text input.
//
// The library owns the edit state (codepoint buffer + caret) in a per-key state
// slot, seeded once from `initial` (String is opaque, so it is decoded to
// codepoints via foundationStringToCodepoints). Typing inserts
// at the caret; Backspace / forward-Delete remove around it; Left/Right/Home/End
// move it (routed through onKey); a click sets the caret to the nearest character
// (prefix measurement). The caret is rendered without measurement by splitting
// the text at the caret and placing a thin bar between the two halves. Enter
// fires onSubmit with the current text and resets the field so it re-seeds next
// time it is mounted.

struct KiraUiTextFieldState {
    var codes: [Int] = []
    var caret: Int = 0
    // Selection anchor. anchor == caret means no selection; otherwise the
    // selection spans [min(anchor,caret), max(anchor,caret)).
    var anchor: Int = 0
    var seeded: Bool = false
}

function textFieldSelMin(anchor: Int, caret: Int) -> Int {
    if anchor < caret {
        return anchor
    }
    return caret
}

function textFieldSelMax(anchor: Int, caret: Int) -> Int {
    if anchor > caret {
        return anchor
    }
    return caret
}

// Per-field slot key.
function textFieldSlotKey(key: Int) -> String {
    return kiraUiSlotKey("kiraui.tf.", key)
}

function textFieldEnsure(key: Int) {
    if kiraUiStateSlotHas(textFieldSlotKey(key)) == false {
        kiraUiStateSlotPut(textFieldSlotKey(key), nativeUserData(nativeState(KiraUiTextFieldState {})))
    }
    return
}

function textFieldSeed(key: Int, initial: borrow String) {
    textFieldEnsure(key)
    var st = nativeRecover<KiraUiTextFieldState>(kiraUiStateSlotGet(textFieldSlotKey(key)))
    if st.seeded == false {
        st.codes = foundationStringToCodepoints(initial)
        st.caret = st.codes.count
        st.anchor = st.caret
        st.seeded = true
    }
    return
}

function textFieldText(key: Int) -> String {
    textFieldEnsure(key)
    let st = nativeRecover<KiraUiTextFieldState>(kiraUiStateSlotGet(textFieldSlotKey(key)))
    return foundationStringFromCodepoints(st.codes, 0, st.codes.count)
}

function textFieldReset(key: Int) {
    textFieldEnsure(key)
    var st = nativeRecover<KiraUiTextFieldState>(kiraUiStateSlotGet(textFieldSlotKey(key)))
    var empty: [Int] = []
    st.codes = move empty
    st.caret = 0
    st.anchor = 0
    st.seeded = false
    return
}

// Delete the selected range (if any), collapsing the caret to its start.
function textFieldDeleteSelection(key: Int) {
    textFieldEnsure(key)
    var st = nativeRecover<KiraUiTextFieldState>(kiraUiStateSlotGet(textFieldSlotKey(key)))
    if st.anchor == st.caret {
        return
    }
    let a = textFieldSelMin(st.anchor, st.caret)
    let b = textFieldSelMax(st.anchor, st.caret)
    var next: [Int] = []
    var i = 0
    while i < st.codes.count {
        if i < a || i >= b {
            next.append(st.codes[i])
        }
        i = i + 1
    }
    st.codes = move next
    st.caret = a
    st.anchor = a
    return
}

function textFieldSelectAll(key: Int) {
    textFieldEnsure(key)
    var st = nativeRecover<KiraUiTextFieldState>(kiraUiStateSlotGet(textFieldSlotKey(key)))
    st.anchor = 0
    st.caret = st.codes.count
    return
}

function textFieldInsert(key: Int, cp: Int) {
    if cp < 32 {
        return
    }
    // Typing over a selection replaces it.
    textFieldDeleteSelection(key)
    textFieldEnsure(key)
    var st = nativeRecover<KiraUiTextFieldState>(kiraUiStateSlotGet(textFieldSlotKey(key)))
    var next: [Int] = []
    var i = 0
    while i < st.caret {
        next.append(st.codes[i])
        i = i + 1
    }
    next.append(cp)
    while i < st.codes.count {
        next.append(st.codes[i])
        i = i + 1
    }
    st.codes = move next
    st.caret = st.caret + 1
    st.anchor = st.caret
    return
}

function textFieldBackspace(key: Int) {
    textFieldEnsure(key)
    var st = nativeRecover<KiraUiTextFieldState>(kiraUiStateSlotGet(textFieldSlotKey(key)))
    // A selection is deleted whole.
    if st.anchor != st.caret {
        textFieldDeleteSelection(key)
        return
    }
    if st.caret <= 0 {
        return
    }
    let removeAt = st.caret - 1
    var next: [Int] = []
    var i = 0
    while i < st.codes.count {
        if i != removeAt {
            next.append(st.codes[i])
        }
        i = i + 1
    }
    st.codes = move next
    st.caret = st.caret - 1
    st.anchor = st.caret
    return
}

function textFieldDeleteForward(key: Int) {
    textFieldEnsure(key)
    var st = nativeRecover<KiraUiTextFieldState>(kiraUiStateSlotGet(textFieldSlotKey(key)))
    if st.anchor != st.caret {
        textFieldDeleteSelection(key)
        return
    }
    if st.caret >= st.codes.count {
        return
    }
    let removeAt = st.caret
    var next: [Int] = []
    var i = 0
    while i < st.codes.count {
        if i != removeAt {
            next.append(st.codes[i])
        }
        i = i + 1
    }
    st.codes = move next
    return
}

function textFieldNav(key: Int, keyCode: Int) {
    if keyCode == 261 {
        textFieldDeleteForward(key)
        return
    }
    if keyCode == 300 {
        textFieldSelectAll(key)
        return
    }
    textFieldEnsure(key)
    var st = nativeRecover<KiraUiTextFieldState>(kiraUiStateSlotGet(textFieldSlotKey(key)))
    let hasSel = st.anchor != st.caret
    if keyCode == 263 {
        // Left: collapse a selection to its start, else step left.
        if hasSel {
            st.caret = textFieldSelMin(st.anchor, st.caret)
        } else {
            if st.caret > 0 {
                st.caret = st.caret - 1
            }
        }
        st.anchor = st.caret
    }
    if keyCode == 262 {
        if hasSel {
            st.caret = textFieldSelMax(st.anchor, st.caret)
        } else {
            if st.caret < st.codes.count {
                st.caret = st.caret + 1
            }
        }
        st.anchor = st.caret
    }
    if keyCode == 268 {
        st.caret = 0
        st.anchor = 0
    }
    if keyCode == 269 {
        st.caret = st.codes.count
        st.anchor = st.caret
    }
    return
}

// Click-to-position: map the press x (relative to the field's text start) to the
// nearest caret index by measuring codepoint prefixes.
function textFieldClickCaret(key: Int, size: Float, leftPad: Float) {
    textFieldEnsure(key)
    var st = nativeRecover<KiraUiTextFieldState>(kiraUiStateSlotGet(textFieldSlotKey(key)))
    let relX = kiraUiPointerX() - kiraUiPressBoundsX() - leftPad
    if relX <= 0.0 {
        st.caret = 0
        st.anchor = 0
        return
    }
    let n = st.codes.count
    var k = 0
    var prevW = 0.0
    var placed = false
    while k <= n && placed == false {
        let prefix = foundationStringFromCodepoints(st.codes, 0, k)
        let w = foundationTextRunWidth(prefix, size, textFieldWeight())
        if w >= relX {
            if k > 0 && (relX - prevW) < (w - relX) {
                st.caret = k - 1
            } else {
                st.caret = k
            }
            placed = true
        }
        prevW = w
        k = k + 1
    }
    if placed == false {
        st.caret = n
    }
    // A click positions the caret and clears any selection.
    st.anchor = st.caret
    return
}

// --- Closure builders (capture locals, never widget fields). ---

function textFieldInsertFn(key: Int) -> (Int) -> Void {
    let k = key
    let f: (Int) -> Void = { cp in
        textFieldInsert(k, cp)
        return
    }
    return f
}

function textFieldBackspaceFn(key: Int) -> () -> Void {
    let k = key
    let f: () -> Void = { in
        textFieldBackspace(k)
        return
    }
    return f
}

function textFieldNavFn(key: Int) -> (Int) -> Void {
    let k = key
    let f: (Int) -> Void = { kc in
        textFieldNav(k, kc)
        return
    }
    return f
}

function textFieldPressFn(key: Int, size: Float, leftPad: Float) -> () -> Void {
    let k = key
    let sz = size
    let lp = leftPad
    let f: () -> Void = { in
        textFieldClickCaret(k, sz, lp)
        return
    }
    return f
}

function textFieldColor(c: borrow FoundationColor) -> FoundationColor {
    return foundationRgba(c.r, c.g, c.b, c.a)
}

function textFieldColorWithOpacity(
    c: borrow FoundationColor,
    opacity: Float,
) -> FoundationColor {
    return foundationRgba(c.r, c.g, c.b, c.a * opacity)
}

// The weight editable text is set at.
//
// One value, named once, because the caret is placed by measuring PREFIXES of
// the same string the field draws: a measurement at one weight and a draw at
// another puts the caret beside the glyph it belongs to rather than against it.
function textFieldWeight() -> Float {
    return 400.0
}

function textFieldTextSize(modifiers: borrow ModifierContext) -> Float {
    if modifiers.hasFont {
        return modifiers.fontSize
    }
    if modifiers.hasTypography {
        return typographyImplementation(modifiers.typography, modifiers).size
    }
    return modifierTokens(modifiers).bodySize
}

function textFieldPlaceholderColor(modifiers: borrow ModifierContext) -> FoundationColor {
    return modifierColor(foundationColor(modifierTokens(modifiers).foreground.tertiary), modifiers)
}

// The selection band is the accent at reading strength — opaque accent would
// bury the glyphs it is drawn behind.
function textFieldSelectionColor(modifiers: borrow ModifierContext) -> FoundationColor {
    let accent = modifierTokens(modifiers).tint.accent
    return modifierColor(foundationColor(colorWithAlpha(accent, 0.35)), modifiers)
}

function textFieldRadius(modifiers: borrow ModifierContext) -> Float {
    return modifierTokens(modifiers).controlRadius
}

// An editable field resolves its own presentation from the theme, exactly like
// Button and Card. Requiring five explicit colors at every call site meant a
// field could never follow a theme change, and made the surrounding code carry a
// resolved palette purely to feed this constructor.
//
// Overrides remain available through the ordinary modifiers: `.background(...)`
// or `.fill(...)` for the field's background, `.themeColor(...)` /
// `.textColor(...)` for the ink, `.typography(...)` / `.font(...)` for the size.
construct TextField(
    key: Int,
    initial: String,
    placeholder: String,
    width: Float,
    height: Float,
    onSubmit: () -> Void
) extends Widget {

    // A hittable field box with its text (or placeholder) as content. The caret,
    // selection and per-glyph layout are the input stage's; describe carries the
    // field surface and the current string.
    function describe(context: borrow BuildContext, modifiers: borrow ModifierContext) -> CALayerDescription {
        let size = textFieldTextSize(modifiers)
        var bg = foundationColor(modifierTokens(modifiers).fill.control)
        bg = modifierSurfaceFill(move bg, modifiers)
        textFieldSeed(key, initial)
        let st = nativeRecover<KiraUiTextFieldState>(kiraUiStateSlotGet(textFieldSlotKey(key)))
        let n = st.codes.count
        var shown = placeholder
        var ink = textFieldPlaceholderColor(modifiers)
        if n > 0 {
            shown = foundationStringFromCodepoints(st.codes, 0, n)
            ink = modifierTextColor(modifiers)
        }
        let radius = textFieldRadius(modifiers)
        return CALayerDescription {
            hittable: !modifiers.disabled,
            hitKey: key,
            cornerRadius: radius,
            clipsChildren: true,
            content: .Solid(CASolid {
                fill: caColorFromFoundation(textFieldColorWithOpacity(bg, modifiers.opacity)),
                cornerRadius: radius
            }),
            sublayers: [CALayerDescription {
                content: .Text(CAText {
                    content: move shown,
                    color: caColorFromFoundation(ink),
                    size: size,
                    weight: 400.0
                })
            }]
        }
    }
}
