import Foundation

// The compiler currently has no library-defined annotation hook for a form
// such as `@Modifier(.Scoped)`. Keep the vocabulary explicit and typed here so
// the declaration mechanism can migrate to that annotation when the compiler
// grows it without changing the traversal or widget API.
enum ModifierInheritance {
    Inherited
    Scoped
    Cascading
    Environment
    Isolated
}

// What `.foregroundColor(...)` and `.backgroundColor(...)` accept: the content
// hierarchy, the accent, and the standard palette, on one type — mirroring how
// a color is named at a call site. Each case resolves through the theme's
// separated token groups (foregrounds, tints, palette); `Black`, `White` and
// `Clear` are absolute.
enum PrimaryColor {
    Primary
    Secondary
    Tertiary
    Quaternary
    // The ink that stays readable ON a filled control, and the three semantic
    // intents. They belong here beside `Accent` for the same reason it does: a
    // destructive label asks for `.Danger` and follows the theme's tint, where
    // `.Red` would pin it to a hue the theme does not own.
    Inverse
    Success
    Warning
    Danger
    Accent
    Red
    Orange
    Yellow
    Green
    Mint
    Teal
    Cyan
    Blue
    Indigo
    Purple
    Pink
    Brown
    Gray
    Black
    White
    Clear
}

// --- Resolved tokens ---------------------------------------------------------
// The appearance-resolved view of a style, grouped the same way the style
// groups its tokens. Widgets consume these; they never resolve an
// AdaptiveColor themselves.

struct PaletteColors {
    let red: Color
    let orange: Color
    let yellow: Color
    let green: Color
    let mint: Color
    let teal: Color
    let cyan: Color
    let blue: Color
    let indigo: Color
    let purple: Color
    let pink: Color
    let brown: Color
    let gray: Color
}

struct ForegroundColors {
    let primary: Color
    let secondary: Color
    let tertiary: Color
    let quaternary: Color
    let inverse: Color
}

struct BackgroundColors {
    let canvas: Color
    let surface: Color
    let raised: Color
    let overlay: Color
}

struct FillColors {
    let control: Color
    let hover: Color
    let selection: Color
}

struct TintColors {
    let accent: Color
    let success: Color
    let warning: Color
    let danger: Color
}

struct ResolvedBorder {
    let color: Color
    let width: Float
}

struct BorderTokens {
    let subtle: ResolvedBorder
    let standard: ResolvedBorder
    let strong: ResolvedBorder
    let focus: ResolvedBorder
}

struct ThemeTokens {
    let palette: PaletteColors
    let foreground: ForegroundColors
    let background: BackgroundColors
    let fill: FillColors
    let tint: TintColors
    let border: BorderTokens
    let glassTint: Color
    let surfaceMaterial: Material
    let cardRadius: Float
    let controlRadius: Float
    let bodySize: Float
    let bodyWeight: FontWeight
    let controlSize: Float
    let controlWeight: FontWeight
    let titleSize: Float
    let titleWeight: FontWeight
}

function themeAdaptiveColor(color: borrow AdaptiveColor, appearance: borrow Appearance) -> Color {
    match appearance {
        Light -> return color.light;
        Dark -> return color.dark;
    }
}

function resolvedBorder(border: borrow BorderImplementation, appearance: borrow Appearance) -> ResolvedBorder {
    return ResolvedBorder {
        color: themeAdaptiveColor(border.color, appearance)
        width: border.width
    }
}

// The one place a style becomes resolved tokens. Theme.tokens() and the
// no-theme fallback both come through here, so a widget cannot see two
// different resolution rules.
function styleThemeTokens(style: Any StyleImplementation) -> ThemeTokens {
    let appearance = resolvedAppearance(style.appearance)
    let palette = style.palette
    let foregrounds = style.foregrounds
    let backgrounds = style.backgrounds
    let fills = style.fills
    let tints = style.tints
    let borders = style.borders
    let materials = style.materials
    let radii = style.cornerRadii
    let typography = style.typography
    return ThemeTokens {
        palette: PaletteColors {
            red: themeAdaptiveColor(palette.red, appearance)
            orange: themeAdaptiveColor(palette.orange, appearance)
            yellow: themeAdaptiveColor(palette.yellow, appearance)
            green: themeAdaptiveColor(palette.green, appearance)
            mint: themeAdaptiveColor(palette.mint, appearance)
            teal: themeAdaptiveColor(palette.teal, appearance)
            cyan: themeAdaptiveColor(palette.cyan, appearance)
            blue: themeAdaptiveColor(palette.blue, appearance)
            indigo: themeAdaptiveColor(palette.indigo, appearance)
            purple: themeAdaptiveColor(palette.purple, appearance)
            pink: themeAdaptiveColor(palette.pink, appearance)
            brown: themeAdaptiveColor(palette.brown, appearance)
            gray: themeAdaptiveColor(palette.gray, appearance)
        }
        foreground: ForegroundColors {
            primary: themeAdaptiveColor(foregrounds.primary, appearance)
            secondary: themeAdaptiveColor(foregrounds.secondary, appearance)
            tertiary: themeAdaptiveColor(foregrounds.tertiary, appearance)
            quaternary: themeAdaptiveColor(foregrounds.quaternary, appearance)
            inverse: themeAdaptiveColor(foregrounds.inverse, appearance)
        }
        background: BackgroundColors {
            canvas: themeAdaptiveColor(backgrounds.canvas, appearance)
            surface: themeAdaptiveColor(backgrounds.surface, appearance)
            raised: themeAdaptiveColor(backgrounds.raised, appearance)
            overlay: themeAdaptiveColor(backgrounds.overlay, appearance)
        }
        fill: FillColors {
            control: themeAdaptiveColor(fills.control, appearance)
            hover: themeAdaptiveColor(fills.hover, appearance)
            selection: themeAdaptiveColor(fills.selection, appearance)
        }
        tint: TintColors {
            accent: themeAdaptiveColor(tints.accent, appearance)
            success: themeAdaptiveColor(tints.success, appearance)
            warning: themeAdaptiveColor(tints.warning, appearance)
            danger: themeAdaptiveColor(tints.danger, appearance)
        }
        border: BorderTokens {
            subtle: resolvedBorder(borders.subtle, appearance)
            standard: resolvedBorder(borders.standard, appearance)
            strong: resolvedBorder(borders.strong, appearance)
            focus: resolvedBorder(borders.focus, appearance)
        }
        glassTint: themeAdaptiveColor(materials.glassTint, appearance)
        surfaceMaterial: Material.LayeredGlass
        cardRadius: radii.large
        controlRadius: radii.small
        bodySize: typography.body.size
        bodyWeight: typography.body.weight
        controlSize: typography.control.size
        controlWeight: typography.control.weight
        titleSize: typography.title.size
        titleWeight: typography.title.weight
    }
}

construct Theme {
    @Required let StyleImplementation: Any StyleImplementation
    @Required let text: Any StyleImplementation
    @Required let icon: Any StyleImplementation
    @Required let button: Any StyleImplementation
    @Required let card: Any StyleImplementation
    @Required let progress: Any StyleImplementation
    @Required let textField: Any StyleImplementation
    @Required let toggle: Any StyleImplementation
    @Required let slider: Any StyleImplementation
    @Required let sidebar: Any StyleImplementation
    @Required let divider: Any StyleImplementation

    function appearance() -> Appearance {
        return resolvedAppearance(StyleImplementation.appearance)
    }

    function tokens() -> ThemeTokens {
        return styleThemeTokens(StyleImplementation)
    }

    function typography(style: borrow TypographyStyle) -> FontImplementation {
        let values = StyleImplementation.typography
        match style {
            caption -> return values.caption;
            body -> return values.body;
            control -> return values.control;
            subheadline -> return values.subheadline;
            bodyEmphasis -> return values.bodyEmphasis;
            footnote -> return values.footnote;
            overline -> return values.overline;
            label -> return values.label;
            section -> return values.section;
            headline -> return values.headline;
            title -> return values.title;
            title1 -> return values.title1;
            title2 -> return values.title2;
            title3 -> return values.title3;
        }
    }

    function cornerRadius(style: borrow CornerRadius) -> Float {
        let values = StyleImplementation.cornerRadii
        match style {
            None -> return values.none;
            Small -> return values.small;
            Medium -> return values.medium;
            Large -> return values.large;
            ExtraLarge -> return values.extraLarge;
            Capsule -> return values.capsule;
        }
    }

    function symbol(name: borrow Symbol) -> String {
        return styleSymbol(StyleImplementation.symbols, name)
    }

    function controlMetrics(size: borrow ControlSize) -> ControlMetricsImplementation {
        let values = StyleImplementation.metrics
        match size {
            Mini -> return values.mini;
            Small -> return values.small;
            Regular -> return values.regular;
            Large -> return values.large;
        }
    }

    function spacing(style: borrow Spacing) -> Float {
        let values = StyleImplementation.spacing
        match style {
            None -> return values.none;
            ExtraSmall -> return values.extraSmall;
            Small -> return values.small;
            Medium -> return values.medium;
            Large -> return values.large;
            ExtraLarge -> return values.extraLarge;
            Section -> return values.section;
        }
    }
}

Theme DefaultTheme {
    let StyleImplementation = DefaultStyle {}
    let text = DefaultStyle {}
    let icon = DefaultStyle {}
    let button = DefaultStyle {}
    let card = DefaultStyle {}
    let progress = DefaultStyle {}
    let textField = DefaultStyle {}
    let toggle = DefaultStyle {}
    let slider = DefaultStyle {}
    let sidebar = DefaultStyle {}
    let divider = DefaultStyle {}
}

// The theme in effect here: the applied one, or the library's own when nothing
// applied a theme.
//
// Every resolution goes through this, so a themed tree and an unthemed one
// differ in their TOKENS and in nothing else. Asking `hasTheme` at a call site
// and reaching for a literal on the other branch is what left an application
// with no theme drawing near-white text on a light surface and asking
// `.backgroundStyle(.Surface)` for a colour that came back transparent: two
// defaults that were never authored together.
function modifierTheme(modifiers: borrow ModifierContext) -> Any Theme {
    if modifiers.hasTheme {
        return copy modifiers.theme
    }
    return DefaultTheme {}
}

// What `.background(...)` paints with: a style, named after what it IS rather
// than where it sits, resolved from the theme's own tokens. Beyond the four
// elevation styles, list and tree UIs need the control interior, the band behind
// a selected row, and the wash under a hovered one. `Clear` is the honest name
// for a row in neither state — a conditional background answers with a style,
// not with a transparent color.
enum BackgroundStyle {
    Clear
    Window
    Surface
    Raised
    Control
    Overlay
    Accent
    Selection
    Hover
}

enum ThemeBorder {
    Subtle
    Standard
    Strong
    Focus
}

// One modifier call contributes a sparse delta. Presence flags distinguish an
// omitted value from a value whose scalar representation happens to be a
// default, without introducing a dynamic property map or a permanently
// materialized resolved style on each widget.
struct ModifierDelta {
    let hasTheme: Bool = false
    let theme: Any Theme = DefaultTheme {}
    let hasForegroundColor: Bool = false
    let foregroundColor: PrimaryColor = PrimaryColor.Primary
    let hasMaterial: Bool = false
    let material: Material = Material.Flat
    let hasFill: Bool = false
    let fillColor: Color = Color {}
    let hasBackgroundStyle: Bool = false
    let backgroundStyle: BackgroundStyle = BackgroundStyle.Surface
    let hasThemeBorder: Bool = false
    let themeBorder: ThemeBorder = ThemeBorder.Subtle
    let hasTextColor: Bool = false
    let textColor: Color = Color {}
    let hasTypography: Bool = false
    let typography: TypographyStyle = TypographyStyle.body
    let hasControlSize: Bool = false
    let controlSize: ControlSize = ControlSize.Regular
    let hasImageScale: Bool = false
    let imageScale: IconScale = IconScale.Medium
    let hasTint: Bool = false
    let tint: PrimaryColor = PrimaryColor.Accent
    let hasContentInset: Bool = false
    let contentInset: Float = 0.0
    // How far the COLUMN this view is in holds its content off its own leading
    // and trailing edges. A column states it once and everything in it obeys the
    // same one — the bar across its top, the rows in its list, the header over
    // them — so a column whose canvas runs edge to edge can say so and have the
    // bar above that canvas start where the canvas starts.
    let hasContentMargin: Bool = false
    let contentMargin: Float = 0.0
    let hasFont: Bool = false
    let fontSize: Float = 16.0
    let fontWeight: FontWeight = FontWeight.Regular
    // Opacity is a per-modifier visual composition, not a theme token.
    let hasOpacity: Bool = false
    let opacity: Float = 1.0
    let disabled: Bool = false
    let hasFocused: Bool = false
    let focused: Bool = false
}

// The resolved context is traversal-local. It is passed by borrow to every
// widget and derived once at the point where a widget consumes a delta. Scoped
// and isolated values are removed by modifierContextForChildren; inherited,
// cascading, and environmental values remain available to descendants.
struct ModifierContext {
    let theme: Any Theme = DefaultTheme {}
    let hasTheme: Bool = false
    // `.foregroundColor(...)` cascades: it is the subtree's ink until something
    // deeper restates it, exactly like text color in a retained environment.
    let foregroundColor: PrimaryColor = PrimaryColor.Primary
    let hasForegroundColor: Bool = false
    let material: Material = Material.Flat
    let hasMaterial: Bool = false
    let fillColor: Color = Color {}
    let hasFill: Bool = false
    let backgroundStyle: BackgroundStyle = BackgroundStyle.Surface
    let hasBackgroundStyle: Bool = false
    let themeBorder: ThemeBorder = ThemeBorder.Subtle
    let hasThemeBorder: Bool = false
    let textColor: Color = Color {}
    let hasTextColor: Bool = false
    let typography: TypographyStyle = TypographyStyle.body
    let hasTypography: Bool = false
    // The size class every control in this subtree is drawn at. Cascading, like
    // typography: a panel names it once and its rows, fields and switches follow.
    let controlSize: ControlSize = ControlSize.Regular
    let hasControlSize: Bool = false
    // How large a glyph is drawn relative to the size class around it.
    let imageScale: IconScale = IconScale.Medium
    let hasImageScale: Bool = false
    // The colour a control's ACTIVE side takes: a switch's on-track, a slider's
    // filled segment, a progress bar's fill. Separate from the foreground so a
    // row can dim its label without draining the accent out of the switch that
    // turns the row back on.
    let tint: PrimaryColor = PrimaryColor.Accent
    let hasTint: Bool = false
    // How far the enclosing card holds its content off its own edges: the radius
    // of that card, so content begins exactly where the corner arc ends. A card
    // states it once and every row inside starts in the right place, including
    // when the theme retunes the radius.
    let contentInset: Float = 0.0
    let hasContentInset: Bool = false
    let contentMargin: Float = 0.0
    let hasContentMargin: Bool = false
    let fontSize: Float = 16.0
    let fontWeight: FontWeight = FontWeight.Regular
    let hasFont: Bool = false
    let hasOpacity: Bool = false
    let opacity: Float = 1.0
    let disabled: Bool = false
    let focused: Bool = false
    let hasFocused: Bool = false
}

function modifierContextApply(
    context: borrow ModifierContext,
    delta: ModifierDelta,
) -> ModifierContext {
    return ModifierContext {
        theme: delta.hasTheme ? delta.theme : context.theme
        hasTheme: delta.hasTheme ? true : context.hasTheme
        foregroundColor: delta.hasForegroundColor ? delta.foregroundColor : context.foregroundColor
        hasForegroundColor: delta.hasForegroundColor ? true : context.hasForegroundColor
        material: delta.hasMaterial ? delta.material : context.material
        hasMaterial: delta.hasMaterial ? true : context.hasMaterial
        fillColor: delta.hasFill ? delta.fillColor : context.fillColor
        hasFill: delta.hasFill ? true : context.hasFill
        backgroundStyle: delta.hasBackgroundStyle ? delta.backgroundStyle : context.backgroundStyle
        hasBackgroundStyle: delta.hasBackgroundStyle ? true : context.hasBackgroundStyle
        themeBorder: delta.hasThemeBorder ? delta.themeBorder : context.themeBorder
        hasThemeBorder: delta.hasThemeBorder ? true : context.hasThemeBorder
        textColor: delta.hasTextColor ? delta.textColor : context.textColor
        hasTextColor: delta.hasTextColor ? true : context.hasTextColor
        typography: delta.hasTypography ? delta.typography : context.typography
        hasTypography: delta.hasTypography ? true : context.hasTypography
        controlSize: delta.hasControlSize ? delta.controlSize : context.controlSize
        hasControlSize: delta.hasControlSize ? true : context.hasControlSize
        imageScale: delta.hasImageScale ? delta.imageScale : context.imageScale
        hasImageScale: delta.hasImageScale ? true : context.hasImageScale
        tint: delta.hasTint ? delta.tint : context.tint
        hasTint: delta.hasTint ? true : context.hasTint
        contentInset: delta.hasContentInset ? delta.contentInset : context.contentInset
        hasContentInset: delta.hasContentInset ? true : context.hasContentInset
        contentMargin: delta.hasContentMargin ? delta.contentMargin : context.contentMargin
        hasContentMargin: delta.hasContentMargin ? true : context.hasContentMargin
        fontSize: delta.hasFont ? delta.fontSize : context.fontSize
        fontWeight: delta.hasFont ? delta.fontWeight : context.fontWeight
        hasFont: delta.hasFont ? true : context.hasFont
        hasOpacity: delta.hasOpacity ? true : context.hasOpacity
        opacity: context.opacity * (delta.hasOpacity ? delta.opacity : 1.0)
        disabled: context.disabled || delta.disabled
        focused: delta.hasFocused ? delta.focused : context.focused
        hasFocused: delta.hasFocused ? true : context.hasFocused
    }
}

function modifierContextForChildren(context: borrow ModifierContext) -> ModifierContext {
    return ModifierContext {
        theme: context.theme
        hasTheme: context.hasTheme
        foregroundColor: context.foregroundColor
        hasForegroundColor: context.hasForegroundColor
        material: Material.Flat
        hasMaterial: false
        fillColor: Color {}
        hasFill: false
        backgroundStyle: BackgroundStyle.Surface
        hasBackgroundStyle: false
        themeBorder: ThemeBorder.Subtle
        hasThemeBorder: false
        textColor: Color {}
        hasTextColor: false
        typography: context.typography
        hasTypography: context.hasTypography
        controlSize: context.controlSize
        hasControlSize: context.hasControlSize
        imageScale: context.imageScale
        hasImageScale: context.hasImageScale
        tint: context.tint
        hasTint: context.hasTint
        contentInset: context.contentInset
        hasContentInset: context.hasContentInset
        contentMargin: context.contentMargin
        hasContentMargin: context.hasContentMargin
        fontSize: context.fontSize
        fontWeight: context.fontWeight
        hasFont: context.hasFont
        hasOpacity: context.hasOpacity
        opacity: context.opacity
        disabled: context.disabled
        focused: false
        hasFocused: false
    }
}

// A component such as Button renders its label as part of the receiving widget.
// The cascading foreground and explicit text color remain available to that
// local presentation, while material and focus remain isolated from the
// internal label node.
function modifierContextForPresentation(context: borrow ModifierContext) -> ModifierContext {
    return ModifierContext {
        theme: context.theme
        hasTheme: context.hasTheme
        foregroundColor: context.foregroundColor
        hasForegroundColor: context.hasForegroundColor
        material: Material.Flat
        hasMaterial: false
        fillColor: context.fillColor
        hasFill: context.hasFill
        backgroundStyle: BackgroundStyle.Surface
        hasBackgroundStyle: false
        themeBorder: ThemeBorder.Subtle
        hasThemeBorder: false
        textColor: context.textColor
        hasTextColor: context.hasTextColor
        typography: context.typography
        hasTypography: context.hasTypography
        controlSize: context.controlSize
        hasControlSize: context.hasControlSize
        imageScale: context.imageScale
        hasImageScale: context.hasImageScale
        tint: context.tint
        hasTint: context.hasTint
        contentInset: context.contentInset
        hasContentInset: context.hasContentInset
        contentMargin: context.contentMargin
        hasContentMargin: context.hasContentMargin
        fontSize: context.fontSize
        fontWeight: context.fontWeight
        hasFont: context.hasFont
        hasOpacity: context.hasOpacity
        opacity: context.opacity
        disabled: context.disabled
        focused: false
        hasFocused: false
    }
}

function modifierDeltaTheme(theme: Any Theme) -> ModifierDelta {
    return ModifierDelta {
        hasTheme: true
        theme: move theme
    }
}

function modifierDeltaForegroundColor(color: PrimaryColor) -> ModifierDelta {
    return ModifierDelta {
        hasForegroundColor: true
        foregroundColor: color
    }
}

function modifierDeltaMaterial(material: Material) -> ModifierDelta {
    return ModifierDelta {
        hasMaterial: true
        material: material
    }
}

function modifierDeltaFill(color: Color) -> ModifierDelta {
    return ModifierDelta {
        hasFill: true
        fillColor: move color
    }
}

function modifierDeltaBackgroundStyle(surface: BackgroundStyle) -> ModifierDelta {
    return ModifierDelta {
        hasBackgroundStyle: true
        backgroundStyle: surface
    }
}

function modifierDeltaThemeBorder(border: ThemeBorder) -> ModifierDelta {
    return ModifierDelta {
        hasThemeBorder: true
        themeBorder: border
    }
}

function modifierDeltaTextColor(color: Color) -> ModifierDelta {
    return ModifierDelta {
        hasTextColor: true
        textColor: move color
    }
}

function modifierDeltaTypography(style: TypographyStyle) -> ModifierDelta {
    return ModifierDelta {
        hasTypography: true
        typography: style
    }
}

function modifierDeltaControlSize(size: ControlSize) -> ModifierDelta {
    return ModifierDelta {
        hasControlSize: true
        controlSize: size
    }
}

function modifierDeltaImageScale(scale: IconScale) -> ModifierDelta {
    return ModifierDelta {
        hasImageScale: true
        imageScale: scale
    }
}

function modifierDeltaContentMargin(length: Float) -> ModifierDelta {
    return ModifierDelta {
        hasContentMargin: true
        contentMargin: length
    }
}

function modifierDeltaContentInset(length: Float) -> ModifierDelta {
    return ModifierDelta {
        hasContentInset: true
        contentInset: length
    }
}

function modifierDeltaTint(color: PrimaryColor) -> ModifierDelta {
    return ModifierDelta {
        hasTint: true
        tint: color
    }
}

function modifierDeltaFont(size: Float, weight: FontWeight) -> ModifierDelta {
    return ModifierDelta {
        hasFont: true
        fontSize: size
        fontWeight: weight
    }
}

function modifierDeltaOpacity(value: Float) -> ModifierDelta {
    return ModifierDelta {
        hasOpacity: true
        opacity: value
    }
}

function modifierDeltaDisabled(value: Bool) -> ModifierDelta {
    return ModifierDelta {
        disabled: value
    }
}

function modifierDeltaFocused(value: Bool) -> ModifierDelta {
    return ModifierDelta {
        hasFocused: true
        focused: value
    }
}
