import Foundation
import KCoreAnimation

// The compiler currently has no library-defined annotation hook for a form
// such as `@Modifier(.Scoped)`. Keep the vocabulary explicit and typed here so
// the declaration mechanism can migrate to that annotation when the compiler
// grows it without changing the traversal or widget API.
// Where a control finds itself, and therefore what it looks like.
public enum ControlPresentation {
    // Ordinary content: a control owns its fill and its standalone geometry.
    Standalone
    // System chrome: the bar owns the shared surface and controls resolve their
    // geometry from the toolbar metrics instead of carrying standalone padding.
    Toolbar
    // A tab bar's capsule: a button is a symbol cell the tab's height, held
    // off its ends by the tab's symbol inset and set in the tab's ink, as
    // the kit's sidebar and search buttons stand beside its tabs.
    TabBar
    // A tab on a phone's tab bar: a label stacks its symbol over its title, as
    // the kit's iPhone tab does.
    PhoneTabBar
    // A menu: a full-width row, the panel's ink, no fill.
    MenuRow
    // The group of actions across the top of a menu: an equal column, its glyph
    // above its title.
    MenuAction
    // A list in the sidebar style: a section is its title over its rows, a link
    // is a row that carries the selection band, and a label sets its glyph in
    // the accent.
    Sidebar
    // The content of one row of a sidebar section, whose cell the section draws:
    // a row states its press and its selection band and the section insets it.
    SidebarCell
    // A list in the inset grouped style, which is what a `Form` is: a section
    // is a header over a card of rows over a footer, a link is a row that
    // drills in, and a button is a row set in the accent.
    InsetGrouped
}

public enum ModifierInheritance {
    Inherited
    Scoped
    Cascading
    Environment
    Isolated
}

// What `.foregroundColor(...)` and `.backgroundColor(...)` accept: the content
// hierarchy, the accent, and the standard palette, on one type — mirroring how
// a color is named at a call site. Each case resolves through the theme's
// separated token groups (foregrounds, tints, palette); `Black`, `White` and
// `Clear` are absolute.
public enum PrimaryColor {
    Primary
    Secondary
    Tertiary
    Quaternary
    // The ink that stays readable ON a filled control, and the three semantic
    // intents. They belong here beside `Accent` for the same reason it does: a
    // destructive label asks for `.Danger` and follows the theme's tint, where
    // `.Red` would pin it to a hue the theme does not own.
    Inverse
    Success
    Warning
    Danger
    Accent
    Red
    Orange
    Yellow
    Green
    Mint
    Teal
    Cyan
    Blue
    Indigo
    Purple
    Pink
    Brown
    Gray
    Black
    White
    Clear
}

// What `.background(...)` paints with: a style, named after what it IS rather
// than where it sits, resolved from the theme's own tokens. Beyond the four
// elevation styles, list and tree UIs need the control interior, the band behind
// a selected row, and the wash under a hovered one. `Clear` is the honest name
// for a row in neither state — a conditional background answers with a style,
// not with a transparent color.
public enum BackgroundStyle {
    Clear
    Window
    Surface
    Raised
    Control
    Overlay
    Accent
    Selection
    Hover
}

public enum ThemeBorder {
    Subtle
    Standard
    Strong
    Focus
}

// The resolved context is traversal-local. It is passed by borrow to every
// widget and derived once at the point where a widget consumes a delta. Scoped
// and isolated values are removed by modifierContextForChildren; inherited,
// cascading, and environmental values remain available to descendants.
public struct ModifierContext {
    let theme: Any Theme = copy defaultTheme
    let hasTheme: Bool = false
    // `.foregroundColor(...)` cascades: it is the subtree's ink until something
    // deeper restates it, exactly like text color in a retained environment.
    let foregroundColor: PrimaryColor = .Primary
    let hasForegroundColor: Bool = false
    // Whether that ink is a labeled row's value ink rather than one a caller
    // stated: a button under it keeps its own accent, as SwiftUI's does in a
    // `LabeledContent`.
    let foregroundIsValue: Bool = false
    let material: Material = .Flat
    let hasMaterial: Bool = false
    let fillColor: RGBAColor = RGBAColor {}
    let hasFill: Bool = false
    // `.stroke(...)`: the shape is its outline alone, `strokeWidth` wide, in
    // `strokeColor` when one was named and in the shape's ink otherwise.
    let hasStroke: Bool = false
    let strokeWidth: Number = 1.0
    let hasStrokeColor: Bool = false
    let strokeColor: RGBAColor = RGBAColor {}
    let backgroundStyle: BackgroundStyle = .Surface
    let hasBackgroundStyle: Bool = false
    let themeBorder: ThemeBorder = .Subtle
    let hasThemeBorder: Bool = false
    let textColor: RGBAColor = RGBAColor {}
    let hasTextColor: Bool = false
    // How text is inked into what is under it: over it, or burned or dodged
    // into it as a vibrant label is into glass. A text color stated without
    // one inks over.
    let textBlend: CABlendMode = .Normal
    let typography: TypographyStyle = .body
    let hasTypography: Bool = false
    // The size class every control in this subtree is drawn at. Cascading, like
    // typography: a panel names it once and its rows, fields and switches follow.
    let controlSize: ControlSize = .Regular
    let hasControlSize: Bool = false
    let dynamicType: DynamicTypeSelection = DynamicTypeSelection {}
    let textScale: TextScale = .Default
    // How large a glyph is drawn relative to the size class around it.
    let imageScale: IconScale = .Medium
    let hasImageScale: Bool = false
    // Which drawing of a symbol is used: the outlined one, or its fill.
    let symbolVariant: SymbolVariants = .None
    let hasSymbolVariant: Bool = false
    // The color a control's ACTIVE side takes: a switch's on-track, a slider's
    // filled segment, a progress bar's fill. Separate from the foreground so a
    // row can dim its label without draining the accent out of the switch that
    // turns the row back on.
    let tint: PrimaryColor = .Accent
    let hasTint: Bool = false
    let tintColor: RGBAColor? = .None
    // The corner a concentric shape takes where this view stands: the radius of
    // the container it is in, less how far that container holds it off its
    // edges. Zero is a square container, which the window's content area is.
    let containerCornerRadius: Number = 0.0
    // The glass that container is, which a menu grown out of it is made of.
    let containerGlass: Glass = .Regular
    let contentMargin: Number = 0.0
    let hasContentMargin: Bool = false
    let fontSize: Number = 16.0
    let fontWeight: FontWeight = .Regular
    let hasFont: Bool = false
    let weightOverride: FontWeight = .Regular
    let hasWeightOverride: Bool = false
    let fontDesign: FontDesign = .Default
    let fontWidth: FontWidth? = .None
    // Unlike `.fontWeight`, this is an additive bold trait. An inner
    // `.bold(false)` clears the trait without replacing the selected font.
    let bold: Bool = false
    let textAlignment: TextAlignment = .Leading
    let lineLimit: Number = 0
    let minimumScaleFactor: Number = 1.0
    let baselineOffset: Number = 0.0
    let hasTracking: Bool = false
    let tracking: Number = 0.0
    let hasKerning: Bool = false
    let kerning: Number = 0.0
    let allowsTightening: Bool = false
    let truncationMode: TextTruncationMode = .Tail
    let lineLimitMin: Number = 0
    let lineLimitReservesSpace: Bool = false
    let lineSpacing: Number = 0.0
    // These are explicit modifier boundaries, not inherited visual traits.
    // An outer `.lineHeight(nil)`, `.underline(false)` or row-tint nil must
    // defeat an inner declaration even though modifier bodies are lowered
    // from the outside towards their content.
    let hasLineHeight: Bool = false
    let lineHeight: TextLineHeight? = .None
    let hasUnderline: Bool = false
    let underline: Bool = false
    let underlinePattern: TextLinePattern = .Solid
    let underlineInk: TextDecorationInk = .Inherit
    let hasStrikethrough: Bool = false
    let strikethrough: Bool = false
    let strikethroughPattern: TextLinePattern = .Solid
    let strikethroughInk: TextDecorationInk = .Inherit
    let buttonStyle: ButtonStyle = .Automatic
    let buttonSizing: ButtonSizing = .Automatic
    let buttonRepeatBehavior: ButtonRepeatBehavior = .Automatic
    let toggleStyle: Any ToggleStyle = DefaultToggleStyle {}
    let progressViewStyle: Any ProgressViewStyle = DefaultProgressViewStyle {}
    let menuStyle: MenuStyle = .Automatic
    let menuIndicator: Visibility = .Automatic
    let menuActionDismissBehavior: MenuActionDismissBehavior = .Automatic
    let menuOrder: MenuOrder = .Automatic
    let insideScrollView: Bool = false
    let navigationBackButtonHidden: Bool = false
    let navigationLinkIndicatorVisibility: Visibility = .Automatic
    let navigationBarTitleDisplayMode: NavigationBarTitleDisplayMode = .Automatic
    let scrollIndicatorVisibility: Visibility = .Automatic
    let scrollIndicatorAxes: ScrollIndicatorAxes = .All
    // SwiftUI's `isScrollEnabled` environment is inherited by scroll views,
    // including lists; a disabled ancestor cannot be re-enabled by a child.
    let scrollEnabled: Bool = true
    // The scroll viewport owns clipping, not the content or an outer frame.
    let scrollClipDisabled: Bool = false
    let scrollDismissesKeyboard: ScrollDismissesKeyboardMode = .Automatic
    let scrollAnchors: ScrollAnchorPreferences = ScrollAnchorPreferences {}
    let scrollEdgeEffects: ScrollEdgeEffectPreferences = ScrollEdgeEffectPreferences {}
    let scrollPhaseHandlers: [ScrollPhaseChangeHandler] = []
    let scrollGeometryObservers: [ScrollGeometryChangeHandler] = []
    // Unlike a child-local hover effect, a parent's environment opt-out
    // takes precedence over a descendant's `.hoverEffectDisabled(false)`.
    let hasHoverEffectDisabled: Bool = false
    let hoverEffectDisabled: Bool = false
    let hasFocusEffectDisabled: Bool = false
    let focusEffectDisabled: Bool = false
    let defaultHoverEffect: HoverEffect? = .None
    let hasListRowHoverEffect: Bool = false
    let listRowHoverEffect: HoverEffect? = .None
    let hasListRowHoverEffectDisabled: Bool = false
    let listRowHoverEffectDisabled: Bool = false
    // Each scrollable axis has its own inherited bounce mode. The current
    // ScrollView consumes Vertical; future horizontal scrollers use Horizontal.
    let scrollBounceVertical: ScrollBounceBehavior = .Automatic
    let scrollBounceHorizontal: ScrollBounceBehavior = .Automatic
    let scrollFlashEnabled: Bool = false
    let scrollFlashGeneration: Number = 0.0
    let formStyle: FormStyle = .Automatic
    let scrollContentBackground: Visibility = .Automatic
    let hasListRowBackground: Bool = false
    let listRowBackground: RGBAColor = RGBAColor {}
    let pickerStyle: PickerStyle = .Automatic
    let horizontalRadioGroupLayout: Bool = false
    let buttonBorderShape: ButtonBorderShape = .Automatic
    let hasOpacity: Bool = false
    let opacity: Number = 1.0
    let disabled: Bool = false
    let redactionReasons: RedactionReasons = RedactionReasons.None
    // Every `.focused(...)` binding on the field, outermost first. Like
    // material, it stays with the view it was written on.
    let focus: [FocusBinding] = []
    // How a control in this subtree presents itself.
    //
    // The same `Button(title:action:)` is a filled control in a form, a full
    // width row in a menu, and one of three equal columns in a menu's action
    // group at the top. Those are not three widgets — they are one declaration
    // and three environments, which is exactly how SwiftUI's controls change
    // shape by where they are put.
    //
    // How a `List` in this subtree is drawn. An environment value, like the
    // theme: the split view states it for its sidebar column and `.listStyle`
    // restates it anywhere below.
    let listStyle: ListStyle = .Automatic
    // Trait of a list row's icon, distinct from the environment tint used by
    // switches, sliders and unrelated controls. Nil returns to the style's
    // default; monochrome uses the label's inherited foreground ink.
    let hasListItemTint: Bool = false
    let listItemTint: ListItemTint? = .None
    // Selection is a container interaction, separate from `disabled`: a
    // selectable Picker/List row can refuse selection while unrelated
    // buttons and gestures inside the same view remain interactive.
    let selectionDisabled: Bool = false
    let headerProminence: Prominence = .Standard
    let listSectionSpacing: ListSectionSpacing = .Default
    let listSectionSeparator: SectionSeparatorPreferences = SectionSeparatorPreferences {}
    let listSectionMargins: ListSectionMargins = ListSectionMargins {}
    let insidePlainList: Bool = false
    let listRowSpacing: Number? = .None
    let sliderThumbVisibility: Visibility = .Automatic
    // How a `Table` in this subtree is drawn, whether its rows alternate a
    // band, and whether its column headers show: environment values, as
    // SwiftUI's `.tableStyle`, `.alternatingRowBackgrounds` and
    // `.tableColumnHeaders` set them.
    let tableStyle: TableStyle = .Automatic
    let alternatingRowBackgrounds: AlternatingRowBackgroundBehavior = .Automatic
    let tableColumnHeaders: Visibility = .Automatic
    // Which halves of a `Label` show, an environment value like the list
    // style: `.labelStyle` states it and every label below it follows.
    let labelStyle: LabelStyle = .Automatic
    let hasLabelIconToTitleSpacing: Bool = false
    let labelIconToTitleSpacing: Number = 0.0
    let hasLabelReservedIconWidth: Bool = false
    let labelReservedIconWidth: Number = 0.0
    // Whether the controls here show their titles: `.labelsHidden()` keeps a
    // toggle or a picker to its control alone, its title left to the
    // accessibility label, as SwiftUI's does.
    let labelsHidden: Bool = false
    // The axis of the stack the view stands in: a divider runs across it, a
    // rule under a column's rows and a stroke between a row's.
    let stackAxis: GuideAxis = .Vertical
    // How the text fields here are drawn.
    let textFieldStyle: TextFieldStyle = .Automatic
    // What Return in a field here does: every `.onSubmit { }` around it, the
    // nearest first.
    let submit: () -> Void = layerNoop
    // A kind rather than a Bool because there turned out to be three of them the
    // moment a `ControlGroup` was put in a menu: the group's children are in a
    // menu and are NOT rows, and a Bool can only say they are or they are not.
    let controlPresentation: ControlPresentation = .Standalone
}

public function modifierContextApply(
    context: borrow ModifierContext,
    delta: ModifierDelta,
) -> ModifierContext {
    return ModifierContext {
        theme: delta.hasTheme ? delta.theme : context.theme,
        hasTheme: delta.hasTheme ? true : context.hasTheme,
        foregroundColor: delta.hasForegroundColor ? delta.foregroundColor : context.foregroundColor,
        hasForegroundColor: delta.hasForegroundColor ? true : context.hasForegroundColor,
        foregroundIsValue: delta.hasForegroundColor ? delta.foregroundIsValue : context.foregroundIsValue,
        material: delta.hasMaterial ? delta.material : context.material,
        hasMaterial: delta.hasMaterial ? true : context.hasMaterial,
        fillColor: delta.hasFill ? delta.fillColor : context.fillColor,
        hasFill: delta.hasFill ? true : context.hasFill,
        hasStroke: delta.hasStroke ? true : context.hasStroke,
        strokeWidth: delta.hasStroke ? delta.strokeWidth : context.strokeWidth,
        hasStrokeColor: delta.hasStroke ? delta.hasStrokeColor : context.hasStrokeColor,
        strokeColor: delta.hasStroke ? delta.strokeColor : context.strokeColor,
        backgroundStyle: delta.hasBackgroundStyle ? delta.backgroundStyle : context.backgroundStyle,
        hasBackgroundStyle: delta.hasBackgroundStyle ? true : context.hasBackgroundStyle,
        themeBorder: delta.hasThemeBorder ? delta.themeBorder : context.themeBorder,
        hasThemeBorder: delta.hasThemeBorder ? true : context.hasThemeBorder,
        textColor: delta.hasTextColor ? delta.textColor : context.textColor,
        hasTextColor: delta.hasTextColor ? true : context.hasTextColor,
        textBlend: delta.hasTextBlend ? copy delta.textBlend : (
            delta.hasTextColor ? .Normal : copy context.textBlend
        ),
        typography: delta.hasTypography ? delta.typography : context.typography,
        hasTypography: delta.hasTypography ? true : (delta.hasFont ? false : context.hasTypography),
        controlSize: delta.hasControlSize ? delta.controlSize : context.controlSize,
        hasControlSize: delta.hasControlSize ? true : context.hasControlSize,
        dynamicType: resolvedDynamicTypeSelection(
            context.dynamicType, copy delta.dynamicTypeSizeOverride,
            copy delta.dynamicTypeSizeRange
        ),
        textScale: delta.hasTextScale ? delta.textScale : context.textScale,
        imageScale: delta.hasImageScale ? delta.imageScale : context.imageScale,
        hasImageScale: delta.hasImageScale ? true : context.hasImageScale,
        symbolVariant: delta.hasSymbolVariant ? delta.symbolVariant : context.symbolVariant,
        hasSymbolVariant: delta.hasSymbolVariant ? true : context.hasSymbolVariant,
        tint: delta.hasTint ? delta.tint : context.tint,
        hasTint: delta.hasTint ? true : (delta.hasTintColor ? false : context.hasTint),
        tintColor: delta.hasTintColor ? delta.tintColor : (
            delta.hasTint ? .None : context.tintColor
        ),
        containerCornerRadius: delta.containerCornerRadius.or(context.containerCornerRadius),
        containerGlass: delta.containerGlass.or(context.containerGlass),
        contentMargin: delta.hasContentMargin ? delta.contentMargin : context.contentMargin,
        hasContentMargin: delta.hasContentMargin ? true : context.hasContentMargin,
        fontSize: delta.hasFont ? delta.fontSize : context.fontSize,
        fontWeight: delta.hasFont ? delta.fontWeight : context.fontWeight,
        hasFont: delta.hasFont ? true : (delta.hasTypography ? false : context.hasFont),
        weightOverride: delta.hasWeightOverride ? delta.weightOverride : context.weightOverride,
        hasWeightOverride: delta.hasWeightOverride ? true : (
            delta.hasFont ? false : context.hasWeightOverride
        ),
        fontDesign: delta.hasFontDesign ? delta.fontDesign : context.fontDesign,
        fontWidth: delta.hasFontWidth ? copy delta.fontWidth : copy context.fontWidth,
        bold: delta.hasBold ? delta.bold : context.bold,
        textAlignment: delta.hasTextAlignment ? delta.textAlignment : context.textAlignment,
        lineLimit: delta.hasLineLimit ? delta.lineLimit : context.lineLimit,
        minimumScaleFactor: delta.hasMinimumScaleFactor
            ? delta.minimumScaleFactor : context.minimumScaleFactor,
        baselineOffset: delta.hasBaselineOffset
            ? delta.baselineOffset : context.baselineOffset,
        hasTracking: context.hasTracking || delta.hasTracking,
        tracking: delta.hasTracking ? delta.tracking : context.tracking,
        hasKerning: context.hasKerning || delta.hasKerning,
        kerning: delta.hasKerning ? delta.kerning : context.kerning,
        allowsTightening: delta.hasAllowsTightening
            ? delta.allowsTightening : context.allowsTightening,
        truncationMode: delta.hasTruncationMode ? delta.truncationMode : context.truncationMode,
        lineLimitMin: delta.hasLineLimit ? delta.lineLimitMin : context.lineLimitMin,
        lineLimitReservesSpace: delta.hasLineLimit ? delta.lineLimitReservesSpace : context.lineLimitReservesSpace,
        lineSpacing: delta.hasLineSpacing ? delta.lineSpacing : context.lineSpacing,
        hasLineHeight: delta.hasLineHeight || context.hasLineHeight,
        lineHeight: delta.hasLineHeight ? copy delta.lineHeight : copy context.lineHeight,
        hasUnderline: delta.hasUnderline || context.hasUnderline,
        underline: delta.hasUnderline ? delta.underline : context.underline,
        underlinePattern: delta.hasUnderline ? delta.underlinePattern : context.underlinePattern,
        underlineInk: delta.hasUnderline ? copy delta.underlineInk : copy context.underlineInk,
        hasStrikethrough: delta.hasStrikethrough || context.hasStrikethrough,
        strikethrough: delta.hasStrikethrough ? delta.strikethrough : context.strikethrough,
        strikethroughPattern: delta.hasStrikethrough
            ? delta.strikethroughPattern : context.strikethroughPattern,
        strikethroughInk: delta.hasStrikethrough
            ? copy delta.strikethroughInk : copy context.strikethroughInk,
        buttonStyle: delta.hasButtonStyle ? delta.buttonStyle : context.buttonStyle,
        buttonSizing: delta.hasButtonSizing ? delta.buttonSizing : context.buttonSizing,
        buttonRepeatBehavior: delta.hasButtonRepeatBehavior
            ? delta.buttonRepeatBehavior : context.buttonRepeatBehavior,
        toggleStyle: delta.hasToggleStyle ? delta.toggleStyle : context.toggleStyle,
        progressViewStyle: delta.hasProgressViewStyle ? delta.progressViewStyle : context.progressViewStyle,
        menuStyle: delta.hasMenuStyle ? delta.menuStyle : context.menuStyle,
        menuIndicator: delta.hasMenuIndicator ? delta.menuIndicator : context.menuIndicator,
        menuActionDismissBehavior: delta.hasMenuActionDismissBehavior
            ? delta.menuActionDismissBehavior : context.menuActionDismissBehavior,
        menuOrder: delta.hasMenuOrder ? delta.menuOrder : context.menuOrder,
        insideScrollView: context.insideScrollView || delta.entersScrollContent,
        navigationBackButtonHidden: delta.hasNavigationBackButtonHidden
            ? delta.navigationBackButtonHidden : context.navigationBackButtonHidden,
        navigationLinkIndicatorVisibility: delta.hasNavigationLinkIndicatorVisibility
            ? delta.navigationLinkIndicatorVisibility : context.navigationLinkIndicatorVisibility,
        navigationBarTitleDisplayMode: delta.hasNavigationBarTitleDisplayMode
            ? delta.navigationBarTitleDisplayMode : context.navigationBarTitleDisplayMode,
        scrollIndicatorVisibility: delta.hasScrollIndicators ? delta.scrollIndicatorVisibility : context.scrollIndicatorVisibility,
        scrollIndicatorAxes: delta.hasScrollIndicators ? delta.scrollIndicatorAxes : context.scrollIndicatorAxes,
        scrollEnabled: context.scrollEnabled && (
            delta.hasScrollEnabled ? delta.scrollEnabled : true
        ),
        scrollClipDisabled: delta.hasScrollClipDisabled
            ? delta.scrollClipDisabled : context.scrollClipDisabled,
        scrollDismissesKeyboard: delta.hasScrollDismissesKeyboard
            ? delta.scrollDismissesKeyboard : context.scrollDismissesKeyboard,
        scrollAnchors: scrollAnchorPreferencesApply(
            context.scrollAnchors, copy delta.scrollAnchorChange
        ),
        scrollEdgeEffects: scrollEdgeEffectsApply(
            context.scrollEdgeEffects, copy delta.scrollEdgeEffectChange
        ),
        scrollPhaseHandlers: scrollPhaseHandlersAppending(
            context.scrollPhaseHandlers, copy delta.onScrollPhaseChange
        ),
        scrollGeometryObservers: scrollGeometryObserversAppending(
            context.scrollGeometryObservers, copy delta.onScrollGeometryChange
        ),
        hasHoverEffectDisabled: context.hasHoverEffectDisabled || delta.hasHoverEffectDisabled,
        hoverEffectDisabled: context.hasHoverEffectDisabled
            ? context.hoverEffectDisabled : (
                delta.hasHoverEffectDisabled ? delta.hoverEffectDisabled : context.hoverEffectDisabled
            ),
        hasFocusEffectDisabled: context.hasFocusEffectDisabled || delta.hasFocusEffectDisabled,
        focusEffectDisabled: context.hasFocusEffectDisabled
            ? context.focusEffectDisabled : (
                delta.hasFocusEffectDisabled ? delta.focusEffectDisabled : context.focusEffectDisabled
            ),
        defaultHoverEffect: match delta.defaultHoverEffect {
            Some(value) -> .Some(value)
            None -> copy context.defaultHoverEffect
        },
        hasListRowHoverEffect: context.hasListRowHoverEffect || delta.hasListRowHoverEffect,
        listRowHoverEffect: delta.hasListRowHoverEffect
            ? copy delta.listRowHoverEffect : copy context.listRowHoverEffect,
        hasListRowHoverEffectDisabled: context.hasListRowHoverEffectDisabled
            || delta.hasListRowHoverEffectDisabled,
        listRowHoverEffectDisabled: context.hasListRowHoverEffectDisabled
            ? context.listRowHoverEffectDisabled : (
                delta.hasListRowHoverEffectDisabled
                    ? delta.listRowHoverEffectDisabled : context.listRowHoverEffectDisabled
            ),
        scrollBounceVertical: delta.hasScrollBounceVertical
            ? delta.scrollBounceVertical : context.scrollBounceVertical,
        scrollBounceHorizontal: delta.hasScrollBounceHorizontal
            ? delta.scrollBounceHorizontal : context.scrollBounceHorizontal,
        scrollFlashEnabled: context.scrollFlashEnabled || delta.hasScrollFlash,
        scrollFlashGeneration: context.scrollFlashGeneration + (
            delta.hasScrollFlash ? delta.scrollFlashGeneration : 0.0
        ),
        formStyle: delta.hasFormStyle ? delta.formStyle : context.formStyle,
        scrollContentBackground: delta.hasScrollContentBackground ? delta.scrollContentBackground : context.scrollContentBackground,
        hasListRowBackground: delta.hasListRowBackground ? true : context.hasListRowBackground,
        listRowBackground: delta.hasListRowBackground ? delta.listRowBackground : context.listRowBackground,
        pickerStyle: delta.hasPickerStyle ? delta.pickerStyle : context.pickerStyle,
        horizontalRadioGroupLayout: context.horizontalRadioGroupLayout
            || delta.horizontalRadioGroupLayout,
        buttonBorderShape: delta.hasButtonBorderShape ? delta.buttonBorderShape : context.buttonBorderShape,
        hasOpacity: delta.hasOpacity ? true : context.hasOpacity,
        opacity: context.opacity * (delta.hasOpacity ? delta.opacity : 1.0),
        disabled: context.disabled || delta.disabled,
        redactionReasons: delta.resetRedaction
            ? RedactionReasons.None
            : context.redactionReasons.union(delta.redactionReasons),
        focus: delta.hasFocus ? withFocusBinding(context.focus, delta.focus) : context.focus,
        listStyle: delta.hasListStyle ? delta.listStyle : context.listStyle,
        hasListItemTint: delta.hasListItemTint || context.hasListItemTint,
        listItemTint: delta.hasListItemTint ? copy delta.listItemTint : copy context.listItemTint,
        selectionDisabled: delta.hasSelectionDisabled
            ? delta.selectionDisabled : context.selectionDisabled,
        headerProminence: delta.hasHeaderProminence
            ? delta.headerProminence : context.headerProminence,
        listSectionSpacing: delta.hasListSectionSpacing
            ? delta.listSectionSpacing : context.listSectionSpacing,
        listSectionSeparator: mergedSectionSeparatorPreferences(
            context.listSectionSeparator, delta.listSectionSeparator
        ),
        listSectionMargins: mergedListSectionMargins(
            context.listSectionMargins, delta.listSectionMargins
        ),
        insidePlainList: context.insidePlainList || delta.entersPlainList,
        listRowSpacing: delta.hasListRowSpacing ? delta.listRowSpacing : context.listRowSpacing,
        sliderThumbVisibility: delta.hasSliderThumbVisibility
            ? delta.sliderThumbVisibility : context.sliderThumbVisibility,
        tableStyle: delta.hasTableStyle ? delta.tableStyle : context.tableStyle,
        alternatingRowBackgrounds: delta.hasAlternatingRowBackgrounds ? delta.alternatingRowBackgrounds : context.alternatingRowBackgrounds,
        tableColumnHeaders: delta.hasTableColumnHeaders ? delta.tableColumnHeaders : context.tableColumnHeaders,
        labelStyle: delta.hasLabelStyle ? delta.labelStyle : context.labelStyle,
        hasLabelIconToTitleSpacing: delta.hasLabelIconToTitleSpacing
            || context.hasLabelIconToTitleSpacing,
        labelIconToTitleSpacing: delta.hasLabelIconToTitleSpacing
            ? delta.labelIconToTitleSpacing : context.labelIconToTitleSpacing,
        hasLabelReservedIconWidth: delta.hasLabelReservedIconWidth
            || context.hasLabelReservedIconWidth,
        labelReservedIconWidth: delta.hasLabelReservedIconWidth
            ? delta.labelReservedIconWidth : context.labelReservedIconWidth,
        labelsHidden: delta.hasLabelsHidden ? delta.labelsHidden : context.labelsHidden,
        stackAxis: delta.hasStackAxis ? delta.stackAxis : context.stackAxis,
        textFieldStyle: delta.hasTextFieldStyle ? delta.textFieldStyle : context.textFieldStyle,
        submit: delta.hasSubmit ? delta.submit : context.submit,
        // Carried, not defaulted: a `.foregroundColor(...)` inside a menu would
        // otherwise rebuild the context without it and every control below that
        // modifier would present itself as though it were not in one.
        controlPresentation: context.controlPresentation
    }
}

// The context something HOISTED is built in.
//
// An overlay has left the box it was declared in, so the visual state of that
// box is no longer its own. Opacity is the one that matters and the one that
// bites: a menu fading itself out behind an open submenu cascades that fade into
// every view lowered under it — including the submenu, which is built there and
// then hoisted away. The card comes out dimmed by the very thing it is supposed
// to be standing in front of.
//
// The theme, the typography and the ink DO carry: an overlay opened from a
// themed panel is still that panel's overlay, and a popover that lost the font
// its content was written in would be a worse bug than the one this fixes. What
// resets is the presenter's own transient state — how faded it currently is —
// which describes the presenter's box and nothing beyond it.
public function modifierContextForOverlay(context: borrow ModifierContext) -> ModifierContext {
    let inherited = modifierContextForChildren(context)
    return ModifierContext {
        theme: inherited.theme,
        hasTheme: inherited.hasTheme,
        foregroundColor: inherited.foregroundColor,
        hasForegroundColor: inherited.hasForegroundColor,
        foregroundIsValue: inherited.foregroundIsValue,
        material: inherited.material,
        hasMaterial: inherited.hasMaterial,
        fillColor: inherited.fillColor,
        hasFill: inherited.hasFill,
        hasStroke: inherited.hasStroke,
        strokeWidth: inherited.strokeWidth,
        hasStrokeColor: inherited.hasStrokeColor,
        strokeColor: inherited.strokeColor,
        backgroundStyle: inherited.backgroundStyle,
        hasBackgroundStyle: inherited.hasBackgroundStyle,
        themeBorder: inherited.themeBorder,
        hasThemeBorder: inherited.hasThemeBorder,
        textColor: inherited.textColor,
        hasTextColor: inherited.hasTextColor,
        textBlend: copy inherited.textBlend,
        typography: inherited.typography,
        hasTypography: inherited.hasTypography,
        controlSize: inherited.controlSize,
        hasControlSize: inherited.hasControlSize,
        dynamicType: copy inherited.dynamicType,
        textScale: inherited.textScale,
        imageScale: inherited.imageScale,
        hasImageScale: inherited.hasImageScale,
        symbolVariant: inherited.symbolVariant,
        hasSymbolVariant: inherited.hasSymbolVariant,
        tint: inherited.tint,
        hasTint: inherited.hasTint,
        tintColor: inherited.tintColor,
        contentMargin: inherited.contentMargin,
        hasContentMargin: inherited.hasContentMargin,
        fontSize: inherited.fontSize,
        fontWeight: inherited.fontWeight,
        hasFont: inherited.hasFont,
        weightOverride: inherited.weightOverride,
        hasWeightOverride: inherited.hasWeightOverride,
        fontDesign: inherited.fontDesign,
        fontWidth: copy inherited.fontWidth,
        bold: inherited.bold,
        textAlignment: inherited.textAlignment,
        lineLimit: inherited.lineLimit,
        minimumScaleFactor: inherited.minimumScaleFactor,
        baselineOffset: inherited.baselineOffset,
        hasTracking: inherited.hasTracking,
        tracking: inherited.tracking,
        hasKerning: inherited.hasKerning,
        kerning: inherited.kerning,
        allowsTightening: inherited.allowsTightening,
        truncationMode: inherited.truncationMode,
        lineLimitMin: inherited.lineLimitMin,
        lineLimitReservesSpace: inherited.lineLimitReservesSpace,
        lineSpacing: inherited.lineSpacing,
        lineHeight: copy inherited.lineHeight,
        underline: inherited.underline,
        underlinePattern: inherited.underlinePattern,
        underlineInk: copy inherited.underlineInk,
        strikethrough: inherited.strikethrough,
        strikethroughPattern: inherited.strikethroughPattern,
        strikethroughInk: copy inherited.strikethroughInk,
        buttonStyle: inherited.buttonStyle,
        buttonSizing: inherited.buttonSizing,
        buttonRepeatBehavior: inherited.buttonRepeatBehavior,
        toggleStyle: inherited.toggleStyle,
        progressViewStyle: inherited.progressViewStyle,
        menuStyle: inherited.menuStyle,
        menuIndicator: inherited.menuIndicator,
        menuActionDismissBehavior: inherited.menuActionDismissBehavior,
        menuOrder: inherited.menuOrder,
        insideScrollView: inherited.insideScrollView,
        navigationBackButtonHidden: inherited.navigationBackButtonHidden,
        navigationLinkIndicatorVisibility: inherited.navigationLinkIndicatorVisibility,
        navigationBarTitleDisplayMode: inherited.navigationBarTitleDisplayMode,
        scrollIndicatorVisibility: inherited.scrollIndicatorVisibility,
        scrollIndicatorAxes: inherited.scrollIndicatorAxes,
        scrollEnabled: inherited.scrollEnabled,
        scrollClipDisabled: inherited.scrollClipDisabled,
        scrollDismissesKeyboard: inherited.scrollDismissesKeyboard,
        scrollAnchors: copy inherited.scrollAnchors,
        scrollEdgeEffects: copy inherited.scrollEdgeEffects,
        scrollPhaseHandlers: copy inherited.scrollPhaseHandlers,
        scrollGeometryObservers: copy inherited.scrollGeometryObservers,
        hasHoverEffectDisabled: inherited.hasHoverEffectDisabled,
        hoverEffectDisabled: inherited.hoverEffectDisabled,
        hasFocusEffectDisabled: inherited.hasFocusEffectDisabled,
        focusEffectDisabled: inherited.focusEffectDisabled,
        defaultHoverEffect: copy inherited.defaultHoverEffect,
        hasListRowHoverEffect: inherited.hasListRowHoverEffect,
        listRowHoverEffect: copy inherited.listRowHoverEffect,
        hasListRowHoverEffectDisabled: inherited.hasListRowHoverEffectDisabled,
        listRowHoverEffectDisabled: inherited.listRowHoverEffectDisabled,
        scrollBounceVertical: inherited.scrollBounceVertical,
        scrollBounceHorizontal: inherited.scrollBounceHorizontal,
        scrollFlashEnabled: inherited.scrollFlashEnabled,
        scrollFlashGeneration: inherited.scrollFlashGeneration,
        formStyle: inherited.formStyle,
        scrollContentBackground: inherited.scrollContentBackground,
        hasListRowBackground: inherited.hasListRowBackground,
        listRowBackground: inherited.listRowBackground,
        pickerStyle: inherited.pickerStyle,
        horizontalRadioGroupLayout: inherited.horizontalRadioGroupLayout,
        buttonBorderShape: inherited.buttonBorderShape,
        // Full strength, whatever the presenter currently is.
        hasOpacity: false,
        opacity: 1.0,
        disabled: inherited.disabled,
        redactionReasons: inherited.redactionReasons,
        focus: inherited.focus,
        listStyle: inherited.listStyle,
        listItemTint: copy inherited.listItemTint,
        selectionDisabled: inherited.selectionDisabled,
        headerProminence: inherited.headerProminence,
        listSectionSpacing: inherited.listSectionSpacing,
        listSectionSeparator: copy inherited.listSectionSeparator,
        listSectionMargins: copy inherited.listSectionMargins,
        insidePlainList: inherited.insidePlainList,
        listRowSpacing: inherited.listRowSpacing,
        sliderThumbVisibility: inherited.sliderThumbVisibility,
        tableStyle: inherited.tableStyle,
        alternatingRowBackgrounds: inherited.alternatingRowBackgrounds,
        tableColumnHeaders: inherited.tableColumnHeaders,
        labelStyle: inherited.labelStyle,
        hasLabelIconToTitleSpacing: inherited.hasLabelIconToTitleSpacing,
        labelIconToTitleSpacing: inherited.labelIconToTitleSpacing,
        hasLabelReservedIconWidth: inherited.hasLabelReservedIconWidth,
        labelReservedIconWidth: inherited.labelReservedIconWidth,
        labelsHidden: inherited.labelsHidden,
        stackAxis: inherited.stackAxis,
        textFieldStyle: inherited.textFieldStyle,
        submit: inherited.submit,
        controlPresentation: inherited.controlPresentation
    }
}

// The context a menu's contents are built in. What makes a `Button` inside one
