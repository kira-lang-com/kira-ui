        labelsHidden: inherited.labelsHidden,
        stackAxis: inherited.stackAxis,
        textFieldStyle: inherited.textFieldStyle,
        submit: inherited.submit,
        controlPresentation: presentation
    }
}

// The context a container's content is built in: a container drawn with
// `radius` corners is what a concentric shape inside it follows.
public function modifierContextContained(
    context: borrow ModifierContext,
    radius: Number,
    glass: Glass? = .None,
) -> ModifierContext {
    var delta = modifierDeltaContainerCornerRadius(radius)
    delta.containerGlass = move glass
    return modifierContextApply(modifierContextForChildren(context), move delta)
}

// The context content held `length` off its edges is built in. Its concentric
// corner is the container's less that length, as AppKit's
// `_NSConcentricCornerRadius` takes the container's radius less the corner's
// distance from the container's, and never below a square.
public function modifierContextInset(
    context: borrow ModifierContext,
    length: Number,
) -> ModifierContext {
    return modifierContextApply(
        modifierContextForChildren(context),
        modifierDeltaContainerCornerRadius(max(context.containerCornerRadius - length, 0.0))
    )
}

public function modifierContextForChildren(context: borrow ModifierContext) -> ModifierContext {
    return ModifierContext {
        theme: context.theme,
        hasTheme: context.hasTheme,
        foregroundColor: context.foregroundColor,
        hasForegroundColor: context.hasForegroundColor,
        foregroundIsValue: context.foregroundIsValue,
        material: .Flat,
        hasMaterial: false,
        fillColor: RGBAColor {},
        hasFill: false,
        hasStroke: false,
