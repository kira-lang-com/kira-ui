import Foundation

// The compiler currently has no library-defined annotation hook for a form
// such as `@Modifier(.Scoped)`. Keep the vocabulary explicit and typed here so
// the declaration mechanism can migrate to that annotation when the compiler
// grows it without changing the traversal or widget API.
// Where a control finds itself, and therefore what it looks like.
public enum ControlPresentation {
    // Ordinary content: a control owns its fill and its standalone geometry.
    Standalone
    // System chrome: the bar owns the shared surface and controls resolve their
    // geometry from the toolbar metrics instead of carrying standalone padding.
    Toolbar
    // A menu: a full-width row, the panel's ink, no fill.
    MenuRow
    // The group of actions across the top of a menu: an equal column, its glyph
    // above its title.
    MenuAction
    // A list in the sidebar style: a section is its title over its rows, a link
    // is a row that carries the selection band, and a label sets its glyph in
    // the accent.
    Sidebar
    // The content of one row of a sidebar section, whose cell the section draws:
    // a row states its press and its selection band and the section insets it.
    SidebarCell
    // A list in the inset grouped style, which is what a `Form` is: a section
    // is a header over a card of rows over a footer, a link is a row that
    // drills in, and a button is a row set in the accent.
    InsetGrouped
}

public enum ModifierInheritance {
    Inherited
    Scoped
    Cascading
    Environment
    Isolated
}

// What `.foregroundColor(...)` and `.backgroundColor(...)` accept: the content
// hierarchy, the accent, and the standard palette, on one type — mirroring how
// a color is named at a call site. Each case resolves through the theme's
// separated token groups (foregrounds, tints, palette); `Black`, `White` and
// `Clear` are absolute.
public enum PrimaryColor {
    Primary
    Secondary
    Tertiary
    Quaternary
    // The ink that stays readable ON a filled control, and the three semantic
    // intents. They belong here beside `Accent` for the same reason it does: a
    // destructive label asks for `.Danger` and follows the theme's tint, where
    // `.Red` would pin it to a hue the theme does not own.
    Inverse
    Success
    Warning
    Danger
    Accent
    Red
    Orange
    Yellow
    Green
    Mint
    Teal
    Cyan
    Blue
    Indigo
    Purple
    Pink
    Brown
    Gray
    Black
    White
    Clear
}

// What `.background(...)` paints with: a style, named after what it IS rather
// than where it sits, resolved from the theme's own tokens. Beyond the four
// elevation styles, list and tree UIs need the control interior, the band behind
// a selected row, and the wash under a hovered one. `Clear` is the honest name
// for a row in neither state — a conditional background answers with a style,
// not with a transparent color.
public enum BackgroundStyle {
    Clear
    Window
    Surface
    Raised
    Control
    Overlay
    Accent
    Selection
    Hover
}

public enum ThemeBorder {
    Subtle
    Standard
    Strong
    Focus
}

// One modifier call contributes a sparse delta. Presence flags distinguish an
// omitted value from a value whose scalar representation happens to be a
// default, without introducing a dynamic property map or a permanently
// materialized resolved style on each widget.
public struct ModifierDelta {
    let hasTheme: Bool = false
    let theme: Any Theme = copy defaultTheme
    let hasForegroundColor: Bool = false
    let foregroundColor: PrimaryColor = .Primary
    let hasMaterial: Bool = false
    let material: Material = .Flat
    let hasFill: Bool = false
    let fillColor: Color = Color {}
    let hasBackgroundStyle: Bool = false
    let backgroundStyle: BackgroundStyle = .Surface
    let hasThemeBorder: Bool = false
    let themeBorder: ThemeBorder = .Subtle
    let hasTextColor: Bool = false
    let textColor: Color = Color {}
    let hasTypography: Bool = false
    let typography: TypographyStyle = .body
    let hasControlSize: Bool = false
    let controlSize: ControlSize = .Regular
    let hasImageScale: Bool = false
    let imageScale: IconScale = .Medium
    let hasSymbolVariant: Bool = false
    let symbolVariant: SymbolVariants = .None
    let hasTint: Bool = false
    let tint: PrimaryColor = .Accent
    let hasContentInset: Bool = false
    let contentInset: Float = 0.0
    // How far the COLUMN this view is in holds its content off its own leading
    // and trailing edges. A column states it once and everything in it obeys the
    // same one — the bar across its top, the rows in its list, the header over
    // them — so a column whose canvas runs edge to edge can say so and have the
    // bar above that canvas start where the canvas starts.
    let hasContentMargin: Bool = false
    let contentMargin: Float = 0.0
    let hasFont: Bool = false
    let fontSize: Float = 16.0
    let fontWeight: FontWeight = .Regular
    // `.fontWeight(...)`: a weight over whichever font is in effect, until a
    // `.font(...)` inside it names a weight of its own.
    let hasWeightOverride: Bool = false
    let weightOverride: FontWeight = .Regular
    // `.multilineTextAlignment(...)`: where the lines of wrapped text sit.
    let hasTextAlignment: Bool = false
    let textAlignment: TextAlignment = .Leading
    // `.buttonStyle(...)`: how the buttons in this subtree are drawn.
    let hasButtonStyle: Bool = false
    let buttonStyle: ButtonStyle = .Automatic
    // `.buttonBorderShape(...)`: the outline a bordered button is drawn in.
    let hasButtonBorderShape: Bool = false
    let buttonBorderShape: ButtonBorderShape = .Automatic
    // Opacity is a per-modifier visual composition, not a theme token.
    let hasOpacity: Bool = false
    let opacity: Float = 1.0
    let disabled: Bool = false
    let hasFocused: Bool = false
    let focused: Bool = false
    let inMenu: Bool = false
    let hasListStyle: Bool = false
    let listStyle: ListStyle = .Automatic
}

// The resolved context is traversal-local. It is passed by borrow to every
// widget and derived once at the point where a widget consumes a delta. Scoped
// and isolated values are removed by modifierContextForChildren; inherited,
// cascading, and environmental values remain available to descendants.
public struct ModifierContext {
    let theme: Any Theme = copy defaultTheme
    let hasTheme: Bool = false
    // `.foregroundColor(...)` cascades: it is the subtree's ink until something
    // deeper restates it, exactly like text color in a retained environment.
    let foregroundColor: PrimaryColor = .Primary
    let hasForegroundColor: Bool = false
    let material: Material = .Flat
    let hasMaterial: Bool = false
    let fillColor: Color = Color {}
    let hasFill: Bool = false
    let backgroundStyle: BackgroundStyle = .Surface
    let hasBackgroundStyle: Bool = false
    let themeBorder: ThemeBorder = .Subtle
    let hasThemeBorder: Bool = false
    let textColor: Color = Color {}
    let hasTextColor: Bool = false
    let typography: TypographyStyle = .body
    let hasTypography: Bool = false
    // The size class every control in this subtree is drawn at. Cascading, like
    // typography: a panel names it once and its rows, fields and switches follow.
    let controlSize: ControlSize = .Regular
    let hasControlSize: Bool = false
    // How large a glyph is drawn relative to the size class around it.
    let imageScale: IconScale = .Medium
    let hasImageScale: Bool = false
    // Which drawing of a symbol is used: the outlined one, or its fill.
    let symbolVariant: SymbolVariants = .None
    let hasSymbolVariant: Bool = false
    // The color a control's ACTIVE side takes: a switch's on-track, a slider's
    // filled segment, a progress bar's fill. Separate from the foreground so a
    // row can dim its label without draining the accent out of the switch that
    // turns the row back on.
    let tint: PrimaryColor = .Accent
    let hasTint: Bool = false
    // How far the enclosing card holds its content off its own edges: the radius
    // of that card, so content begins exactly where the corner arc ends. A card
    // states it once and every row inside starts in the right place, including
    // when the theme retunes the radius.
    let contentInset: Float = 0.0
    let hasContentInset: Bool = false
    let contentMargin: Float = 0.0
    let hasContentMargin: Bool = false
    let fontSize: Float = 16.0
    let fontWeight: FontWeight = .Regular
    let hasFont: Bool = false
    let weightOverride: FontWeight = .Regular
    let hasWeightOverride: Bool = false
    let textAlignment: TextAlignment = .Leading
    let buttonStyle: ButtonStyle = .Automatic
    let buttonBorderShape: ButtonBorderShape = .Automatic
    let hasOpacity: Bool = false
    let opacity: Float = 1.0
    let disabled: Bool = false
    let focused: Bool = false
    let hasFocused: Bool = false
    // How a control in this subtree presents itself.
    //
    // The same `Button(title:action:)` is a filled control in a form, a full
    // width row in a menu, and one of three equal columns in a menu's action
    // group at the top. Those are not three widgets — they are one declaration
    // and three environments, which is exactly how SwiftUI's controls change
    // shape by where they are put.
    //
    // How a `List` in this subtree is drawn. An environment value, like the
    // theme: the split view states it for its sidebar column and `.listStyle`
    // restates it anywhere below.
    let listStyle: ListStyle = .Automatic
    // A kind rather than a Bool because there turned out to be three of them the
    // moment a `ControlGroup` was put in a menu: the group's children are in a
    // menu and are NOT rows, and a Bool can only say they are or they are not.
    let controlPresentation: ControlPresentation = .Standalone
}

public function modifierContextApply(
    context: borrow ModifierContext,
    delta: ModifierDelta,
) -> ModifierContext {
    return ModifierContext {
        theme: delta.hasTheme ? delta.theme : context.theme,
        hasTheme: delta.hasTheme ? true : context.hasTheme,
        foregroundColor: delta.hasForegroundColor ? delta.foregroundColor : context.foregroundColor,
        hasForegroundColor: delta.hasForegroundColor ? true : context.hasForegroundColor,
        material: delta.hasMaterial ? delta.material : context.material,
        hasMaterial: delta.hasMaterial ? true : context.hasMaterial,
        fillColor: delta.hasFill ? delta.fillColor : context.fillColor,
        hasFill: delta.hasFill ? true : context.hasFill,
        backgroundStyle: delta.hasBackgroundStyle ? delta.backgroundStyle : context.backgroundStyle,
        hasBackgroundStyle: delta.hasBackgroundStyle ? true : context.hasBackgroundStyle,
        themeBorder: delta.hasThemeBorder ? delta.themeBorder : context.themeBorder,
        hasThemeBorder: delta.hasThemeBorder ? true : context.hasThemeBorder,
        textColor: delta.hasTextColor ? delta.textColor : context.textColor,
        hasTextColor: delta.hasTextColor ? true : context.hasTextColor,
        typography: delta.hasTypography ? delta.typography : context.typography,
        hasTypography: delta.hasTypography ? true : (delta.hasFont ? false : context.hasTypography),
        controlSize: delta.hasControlSize ? delta.controlSize : context.controlSize,
        hasControlSize: delta.hasControlSize ? true : context.hasControlSize,
        imageScale: delta.hasImageScale ? delta.imageScale : context.imageScale,
        hasImageScale: delta.hasImageScale ? true : context.hasImageScale,
        symbolVariant: delta.hasSymbolVariant ? delta.symbolVariant : context.symbolVariant,
        hasSymbolVariant: delta.hasSymbolVariant ? true : context.hasSymbolVariant,
        tint: delta.hasTint ? delta.tint : context.tint,
        hasTint: delta.hasTint ? true : context.hasTint,
        contentInset: delta.hasContentInset ? delta.contentInset : context.contentInset,
        hasContentInset: delta.hasContentInset ? true : context.hasContentInset,
        contentMargin: delta.hasContentMargin ? delta.contentMargin : context.contentMargin,
        hasContentMargin: delta.hasContentMargin ? true : context.hasContentMargin,
        fontSize: delta.hasFont ? delta.fontSize : context.fontSize,
        fontWeight: delta.hasFont ? delta.fontWeight : context.fontWeight,
        hasFont: delta.hasFont ? true : (delta.hasTypography ? false : context.hasFont),
        weightOverride: delta.hasWeightOverride ? delta.weightOverride : context.weightOverride,
        hasWeightOverride: delta.hasWeightOverride ? true : (delta.hasFont ? false : context.hasWeightOverride),
        textAlignment: delta.hasTextAlignment ? delta.textAlignment : context.textAlignment,
        buttonStyle: delta.hasButtonStyle ? delta.buttonStyle : context.buttonStyle,
        buttonBorderShape: delta.hasButtonBorderShape ? delta.buttonBorderShape : context.buttonBorderShape,
        hasOpacity: delta.hasOpacity ? true : context.hasOpacity,
        opacity: context.opacity * (delta.hasOpacity ? delta.opacity : 1.0),
        disabled: context.disabled || delta.disabled,
        focused: delta.hasFocused ? delta.focused : context.focused,
        hasFocused: delta.hasFocused ? true : context.hasFocused,
        listStyle: delta.hasListStyle ? delta.listStyle : context.listStyle,
        // Carried, not defaulted: a `.foregroundColor(...)` inside a menu would
        // otherwise rebuild the context without it and every control below that
        // modifier would present itself as though it were not in one.
        controlPresentation: context.controlPresentation
    }
}

// The context something HOISTED is built in.
//
// An overlay has left the box it was declared in, so the visual state of that
// box is no longer its own. Opacity is the one that matters and the one that
// bites: a menu fading itself out behind an open submenu cascades that fade into
// every view lowered under it — including the submenu, which is built there and
// then hoisted away. The card comes out dimmed by the very thing it is supposed
// to be standing in front of.
//
// The theme, the typography and the ink DO carry: an overlay opened from a
// themed panel is still that panel's overlay, and a popover that lost the font
// its content was written in would be a worse bug than the one this fixes. What
// resets is the presenter's own transient state — how faded it currently is —
// which describes the presenter's box and nothing beyond it.
public function modifierContextForOverlay(context: borrow ModifierContext) -> ModifierContext {
    let inherited = modifierContextForChildren(context)
    return ModifierContext {
        theme: inherited.theme,
        hasTheme: inherited.hasTheme,
        foregroundColor: inherited.foregroundColor,
        hasForegroundColor: inherited.hasForegroundColor,
        material: inherited.material,
        hasMaterial: inherited.hasMaterial,
        fillColor: inherited.fillColor,
        hasFill: inherited.hasFill,
        backgroundStyle: inherited.backgroundStyle,
        hasBackgroundStyle: inherited.hasBackgroundStyle,
        themeBorder: inherited.themeBorder,
        hasThemeBorder: inherited.hasThemeBorder,
        textColor: inherited.textColor,
        hasTextColor: inherited.hasTextColor,
        typography: inherited.typography,
        hasTypography: inherited.hasTypography,
        controlSize: inherited.controlSize,
        hasControlSize: inherited.hasControlSize,
        imageScale: inherited.imageScale,
        hasImageScale: inherited.hasImageScale,
        symbolVariant: inherited.symbolVariant,
        hasSymbolVariant: inherited.hasSymbolVariant,
        tint: inherited.tint,
        hasTint: inherited.hasTint,
        contentInset: inherited.contentInset,
        hasContentInset: inherited.hasContentInset,
        contentMargin: inherited.contentMargin,
        hasContentMargin: inherited.hasContentMargin,
        fontSize: inherited.fontSize,
        fontWeight: inherited.fontWeight,
        hasFont: inherited.hasFont,
        weightOverride: inherited.weightOverride,
        hasWeightOverride: inherited.hasWeightOverride,
        textAlignment: inherited.textAlignment,
        buttonStyle: inherited.buttonStyle,
        buttonBorderShape: inherited.buttonBorderShape,
        // Full strength, whatever the presenter currently is.
        hasOpacity: false,
        opacity: 1.0,
        disabled: inherited.disabled,
        focused: inherited.focused,
        hasFocused: inherited.hasFocused,
        listStyle: inherited.listStyle,
        controlPresentation: inherited.controlPresentation
    }
}

// The context a menu's contents are built in. What makes a `Button` inside one
// present itself as a row, and a `ControlGroup`'s children present themselves as
// the actions across the top instead.
public function modifierContextPresenting(
    context: borrow ModifierContext,
    presentation: ControlPresentation,
) -> ModifierContext {
    let inherited = modifierContextForChildren(context)
    return ModifierContext {
        theme: inherited.theme,
        hasTheme: inherited.hasTheme,
        foregroundColor: inherited.foregroundColor,
        hasForegroundColor: inherited.hasForegroundColor,
        material: inherited.material,
        hasMaterial: inherited.hasMaterial,
        fillColor: inherited.fillColor,
        hasFill: inherited.hasFill,
        backgroundStyle: inherited.backgroundStyle,
        hasBackgroundStyle: inherited.hasBackgroundStyle,
        themeBorder: inherited.themeBorder,
        hasThemeBorder: inherited.hasThemeBorder,
        textColor: inherited.textColor,
        hasTextColor: inherited.hasTextColor,
        typography: inherited.typography,
        hasTypography: inherited.hasTypography,
        controlSize: inherited.controlSize,
        hasControlSize: inherited.hasControlSize,
        imageScale: inherited.imageScale,
        hasImageScale: inherited.hasImageScale,
        symbolVariant: inherited.symbolVariant,
        hasSymbolVariant: inherited.hasSymbolVariant,
        tint: inherited.tint,
        hasTint: inherited.hasTint,
        contentInset: inherited.contentInset,
        hasContentInset: inherited.hasContentInset,
        contentMargin: inherited.contentMargin,
        hasContentMargin: inherited.hasContentMargin,
        fontSize: inherited.fontSize,
        fontWeight: inherited.fontWeight,
        hasFont: inherited.hasFont,
        weightOverride: inherited.weightOverride,
        hasWeightOverride: inherited.hasWeightOverride,
        textAlignment: inherited.textAlignment,
        buttonStyle: inherited.buttonStyle,
        buttonBorderShape: inherited.buttonBorderShape,
        hasOpacity: inherited.hasOpacity,
        opacity: inherited.opacity,
        disabled: inherited.disabled,
        focused: inherited.focused,
        hasFocused: inherited.hasFocused,
        listStyle: inherited.listStyle,
        controlPresentation: presentation
    }
}

public function modifierContextForChildren(context: borrow ModifierContext) -> ModifierContext {
    return ModifierContext {
        theme: context.theme,
        hasTheme: context.hasTheme,
        foregroundColor: context.foregroundColor,
        hasForegroundColor: context.hasForegroundColor,
        material: .Flat,
        hasMaterial: false,
        fillColor: Color {},
        hasFill: false,
        backgroundStyle: .Surface,
        hasBackgroundStyle: false,
        themeBorder: .Subtle,
        hasThemeBorder: false,
        textColor: Color {},
        hasTextColor: false,
        typography: context.typography,
        hasTypography: context.hasTypography,
        controlSize: context.controlSize,
        hasControlSize: context.hasControlSize,
        imageScale: context.imageScale,
        hasImageScale: context.hasImageScale,
        symbolVariant: context.symbolVariant,
        hasSymbolVariant: context.hasSymbolVariant,
        tint: context.tint,
        hasTint: context.hasTint,
        contentInset: context.contentInset,
        hasContentInset: context.hasContentInset,
        contentMargin: context.contentMargin,
        hasContentMargin: context.hasContentMargin,
        fontSize: context.fontSize,
        fontWeight: context.fontWeight,
        hasFont: context.hasFont,
        weightOverride: context.weightOverride,
        hasWeightOverride: context.hasWeightOverride,
        textAlignment: context.textAlignment,
        buttonStyle: context.buttonStyle,
        buttonBorderShape: context.buttonBorderShape,
        hasOpacity: context.hasOpacity,
        opacity: context.opacity,
        disabled: context.disabled,
        focused: false,
        hasFocused: false,
        listStyle: context.listStyle,
        controlPresentation: context.controlPresentation
    }
}

// A component such as Button renders its label as part of the receiving widget.
// The cascading foreground and explicit text color remain available to that
// local presentation, while material and focus remain isolated from the
// internal label node.
public function modifierContextForPresentation(context: borrow ModifierContext) -> ModifierContext {
    return ModifierContext {
        theme: context.theme,
        hasTheme: context.hasTheme,
        foregroundColor: context.foregroundColor,
        hasForegroundColor: context.hasForegroundColor,
        material: .Flat,
        hasMaterial: false,
        fillColor: context.fillColor,
        hasFill: context.hasFill,
        backgroundStyle: .Surface,
        hasBackgroundStyle: false,
        themeBorder: .Subtle,
        hasThemeBorder: false,
        textColor: context.textColor,
        hasTextColor: context.hasTextColor,
        typography: context.typography,
        hasTypography: context.hasTypography,
        controlSize: context.controlSize,
        hasControlSize: context.hasControlSize,
        imageScale: context.imageScale,
        hasImageScale: context.hasImageScale,
        symbolVariant: context.symbolVariant,
        hasSymbolVariant: context.hasSymbolVariant,
        tint: context.tint,
        hasTint: context.hasTint,
        contentInset: context.contentInset,
        hasContentInset: context.hasContentInset,
        contentMargin: context.contentMargin,
        hasContentMargin: context.hasContentMargin,
        fontSize: context.fontSize,
        fontWeight: context.fontWeight,
        hasFont: context.hasFont,
        weightOverride: context.weightOverride,
        hasWeightOverride: context.hasWeightOverride,
        textAlignment: context.textAlignment,
        buttonStyle: context.buttonStyle,
        buttonBorderShape: context.buttonBorderShape,
        hasOpacity: context.hasOpacity,
        opacity: context.opacity,
        disabled: context.disabled,
        focused: false,
        hasFocused: false,
        listStyle: context.listStyle,
        controlPresentation: context.controlPresentation
    }
}

public function modifierDeltaTheme(theme: Any Theme) -> ModifierDelta {
    return ModifierDelta {
        hasTheme: true,
        theme: move theme
    }
}

public function modifierDeltaForegroundColor(color: PrimaryColor) -> ModifierDelta {
    return ModifierDelta {
        hasForegroundColor: true,
        foregroundColor: color
    }
}

public function modifierDeltaMaterial(material: Material) -> ModifierDelta {
    return ModifierDelta {
        hasMaterial: true,
        material: material
    }
}

public function modifierDeltaFill(color: Color) -> ModifierDelta {
    return ModifierDelta {
        hasFill: true,
        fillColor: move color
    }
}

public function modifierDeltaBackgroundStyle(surface: BackgroundStyle) -> ModifierDelta {
    return ModifierDelta {
        hasBackgroundStyle: true,
        backgroundStyle: surface
    }
}

public function modifierDeltaThemeBorder(border: ThemeBorder) -> ModifierDelta {
    return ModifierDelta {
        hasThemeBorder: true,
        themeBorder: border
    }
}

public function modifierDeltaTextColor(color: Color) -> ModifierDelta {
    return ModifierDelta {
        hasTextColor: true,
        textColor: move color
    }
}

public function modifierDeltaTypography(style: TypographyStyle) -> ModifierDelta {
    return ModifierDelta {
        hasTypography: true,
        typography: style
    }
}

public function modifierDeltaControlSize(size: ControlSize) -> ModifierDelta {
    return ModifierDelta {
        hasControlSize: true,
        controlSize: size
    }
}

public function modifierDeltaImageScale(scale: IconScale) -> ModifierDelta {
    return ModifierDelta {
        hasImageScale: true,
        imageScale: scale
    }
}

public function modifierDeltaSymbolVariant(variant: SymbolVariants) -> ModifierDelta {
    return ModifierDelta {
        hasSymbolVariant: true,
        symbolVariant: variant
    }
}

public function modifierDeltaContentMargin(length: Float) -> ModifierDelta {
    return ModifierDelta {
        hasContentMargin: true,
        contentMargin: length
    }
}

public function modifierDeltaListStyle(style: ListStyle) -> ModifierDelta {
    return ModifierDelta {
        hasListStyle: true,
        listStyle: style
    }
}

public function modifierDeltaContentInset(length: Float) -> ModifierDelta {
    return ModifierDelta {
        hasContentInset: true,
        contentInset: length
    }
}

public function modifierDeltaTint(color: PrimaryColor) -> ModifierDelta {
    return ModifierDelta {
        hasTint: true,
        tint: color
    }
}

public function modifierDeltaFont(size: Float, weight: FontWeight) -> ModifierDelta {
    return ModifierDelta {
        hasFont: true,
        fontSize: size,
        fontWeight: weight
    }
}

public function modifierDeltaFontWeight(weight: FontWeight) -> ModifierDelta {
    return ModifierDelta {
        hasWeightOverride: true,
        weightOverride: weight
    }
}

public function modifierDeltaTextAlignment(alignment: TextAlignment) -> ModifierDelta {
    return ModifierDelta {
        hasTextAlignment: true,
        textAlignment: alignment
    }
}

public function modifierDeltaButtonStyle(style: ButtonStyle) -> ModifierDelta {
    return ModifierDelta {
        hasButtonStyle: true,
        buttonStyle: style
    }
}

public function modifierDeltaButtonBorderShape(shape: ButtonBorderShape) -> ModifierDelta {
    return ModifierDelta {
        hasButtonBorderShape: true,
        buttonBorderShape: shape
    }
}

public function modifierDeltaOpacity(value: Float) -> ModifierDelta {
    return ModifierDelta {
        hasOpacity: true,
        opacity: value
    }
}

public function modifierDeltaDisabled(value: Bool) -> ModifierDelta {
    return ModifierDelta {
        disabled: value
    }
}

public function modifierDeltaFocused(value: Bool) -> ModifierDelta {
    return ModifierDelta {
        hasFocused: true,
        focused: value
    }
}
