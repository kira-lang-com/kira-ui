import Foundation
import Ember

// Which interface the toolkit draws: one interface, at two sizes.
//
// A phone and a tablet are touched, and the toolkit draws them at the iOS and
// iPadOS kit's size: 44-point rows, 17-point text, nothing lighting under a
// pointer that is not there. A computer is pointed at, and the toolkit draws
// the same views at the Mac's size -- 28-point sidebar rows, 13-point text --
// and lights a row the pointer rests on, as AppKit does. Nothing else differs:
// the views, their structure and their motion are the same in both.
//
// The catalog carries both sizes, the mobile one as its floor and the desktop
// one pinned to the desktop idiom, and the toolkit resolves every length and
// text style once for each. Changing the mode changes which set the next build
// reads, so an application can switch while it runs and the retained tree
// carries its views from one size to the other.
public enum InterfaceMode {
    // macOS, Windows and Linux.
    AdaptiveDesktop
    // iOS, iPadOS and Android.
    AdaptiveMobile
}

// The mode a program starts in: what `KIRA_UI_MODE=desktop|mobile` fixes for
// the run, and otherwise the host's own: iOS and Android are mobile, and every
// other host is a desktop.
public function hostInterfaceMode() -> InterfaceMode {
    let requested = environmentValue("KIRA_UI_MODE")
    if requested == "desktop" {
        return .AdaptiveDesktop
    }
    if requested == "mobile" {
        return .AdaptiveMobile
    }
    let platform = hostPlatform()
    if platform == .IOS || platform == .Android {
        return .AdaptiveMobile
    }
    return .AdaptiveDesktop
}

var interfaceModeInEffect: InterfaceMode = hostInterfaceMode()

// The mode the toolkit is drawing in.
public function interfaceMode() -> InterfaceMode {
    return interfaceModeInEffect
}

// Draw in `mode` from the next build on.
public function setInterfaceMode(mode: InterfaceMode) {
    interfaceModeInEffect = mode
    return
}

// Whether what can be pressed lights while the pointer rests on it: on a
// desktop, where there is a pointer to rest.
public function interfaceHovers() -> Bool {
    return interfaceMode() == .AdaptiveDesktop
}
