import Foundation
import KCoreAnimation

// One frame of the desktop: `root` over the whole output, in the application
// named `application`. The desktop lies under the system's bar and every
// window, as Finder's desktop does on a Mac, so it has no window chrome and
// no canvas: its picture runs edge to edge, the bar's band too, and what it
// lays out keeps clear of the bar itself. Its commands are declared as a
// window's are, so the bar holds its menus while it is in front.
public function desktopFrame(
    root: Any Widget,
    application: String,
    context: BuildContext,
    viewport: borrow Size
) -> CALayerDescription {
    overlayCollect()
    commandsCollect(move application)
    toolbarCollect()
    let content = root.describe(context, ModifierContext {})
    toolbarStopCollecting()
    commandsStopCollecting()
    overlayStopCollecting()
    return overlayStack(move content, overlaysThisFrame(), viewport.width, viewport.height)
}
