import KiraLayout
import Ember
import Foundation
import KCoreAnimation

// A view with a handful of fields replaced, and every other field carried.
//
// ONE list of the fields, because seven of them was seven chances to forget.
// Each of the modifiers below used to rebuild the view field by field, and every
// field added to `FoundationView` after those were written was dropped by all of
// them -- silently, because a dropped field reads as its default rather than as
// an error.
//
// What that cost: a TextureView lost the texture it was crossfading TOWARDS the
// moment anything gave it a width, so a swipe between two components' sidebars
// ran the whole transition and showed nothing move. A gradient lost its end
// color, glass lost its material and its blur, a scroll region lost the fact
// that it scrolls. All the same bug, and none of them visible in the modifier
// that caused it.
public construct SurfacePaddingLayer(value: Number) extends Widget {
    let content: some Widget

    function describe(
        context: borrow BuildContext,
        modifiers: borrow ModifierContext
    ) -> CALayerDescription {
        return insetDescription(
            content.describe(context, modifierContextInset(modifiers, value)),
            value
        )
    }
}

public construct ContentMarginsLayer(value: ContentMargins) extends Widget {
    let content: some Widget

    function describe(
        context: borrow BuildContext,
        modifiers: borrow ModifierContext
    ) -> CALayerDescription {
        let inset = contentMarginsInset(value, modifiers)
        return insetDescription(
            content.describe(context, modifierContextInset(modifiers, inset)),
            inset
        )
    }
}

public construct WidthLayer(value: Number) extends Widget {
    let content: some Widget

    function describe(
        context: borrow BuildContext,
        modifiers: borrow ModifierContext
    ) -> CALayerDescription {
        let described = content.describe(context, modifierContextForChildren(modifiers))
        var frame = fixedAxisFrame(move described)
        frame.layout.fixedWidth = value
        frame.layout.widthFill = false
        frame.layout.expandsWidth = false
        frame.layout.flex = 0
        return frame
    }
}

// SwiftUI's `.frame(width:)` and `.frame(height:)`: a box of that length on
// one axis, the content centered in it, and the box taking the content's own
// size on the other axis. The length is the box's, not the content's, so a
// content that hugs, or holds its own content off its edges, is centered in
// the box rather than stretched from its top-leading corner.
function fixedAxisFrame(described: CALayerDescription) -> CALayerDescription {
    let layout = copy described.layout
    return CALayerDescription {
        layout: CALayoutIntent {
            widthFill: layout.widthFill,
            heightFill: layout.heightFill,
            flex: layout.flex,
            expandsWidth: layout.expandsWidth,
            expandsHeight: layout.expandsHeight,
            fixedWidth: layout.fixedWidth,
            fixedHeight: layout.fixedHeight,
            aspectRatio: layout.aspectRatio,
            aspectFills: layout.aspectFills,
            alignment: Point { x: 0.5, y: 0.5 }
        },
        sublayers: [described]
    }
}

public construct FillWidthLayer() extends Widget {
    let content: some Widget

    function describe(
        context: borrow BuildContext,
        modifiers: borrow ModifierContext
    ) -> CALayerDescription {
        var described = content.describe(context, modifierContextForChildren(modifiers))
        described.layout.widthFill = true
        described.layout.fixedWidth = -1.0
        described.layout.expandsWidth = true
        return described
    }
}

public construct ScenePaddingLayer() extends Widget {
    let content: some Widget

    function describe(
        context: borrow BuildContext,
        modifiers: borrow ModifierContext
    ) -> CALayerDescription {
        let margin = resolvedContentMargin(modifiers)
        let described = content.describe(context, modifierContextInset(modifiers, margin))
        return insetDescription(move described, margin)
    }
}

public construct FillHeightLayer() extends Widget {
    let content: some Widget

    function describe(
        context: borrow BuildContext,
        modifiers: borrow ModifierContext
    ) -> CALayerDescription {
        var described = content.describe(context, modifierContextForChildren(modifiers))
        described.layout.heightFill = true
        described.layout.fixedHeight = -1.0
        described.layout.expandsHeight = true
        return described
    }
}

public construct HeightLayer(value: Number) extends Widget {
    let content: some Widget

    function describe(
        context: borrow BuildContext,
        modifiers: borrow ModifierContext
    ) -> CALayerDescription {
        let described = content.describe(context, modifierContextForChildren(modifiers))
        var frame = fixedAxisFrame(move described)
        frame.layout.fixedHeight = value
        frame.layout.heightFill = false
        frame.layout.expandsHeight = false
        return frame
    }
}

// Fill and Fixed both had a modifier; Hug did not, so a widget that fills by
// default could never be told to shrink to its content without exposing its own
// SizeMode argument.
public construct HugWidthLayer() extends Widget {
    let content: some Widget

    function describe(
        context: borrow BuildContext,
        modifiers: borrow ModifierContext
    ) -> CALayerDescription {
        var described = content.describe(context, modifierContextForChildren(modifiers))
        described.layout.widthFill = false
        described.layout.expandsWidth = false
        return described
    }
}

public construct HugHeightLayer() extends Widget {
    let content: some Widget

    function describe(
        context: borrow BuildContext,
        modifiers: borrow ModifierContext
    ) -> CALayerDescription {
        var described = content.describe(context, modifierContextForChildren(modifiers))
        described.layout.heightFill = false
        described.layout.expandsHeight = false
        return described
    }
}

// Semantic modifiers contribute a typed delta and then lower the receiving
// widget with the resolved context. No FoundationView has been built yet, so
// the value can be consumed by the widget itself and its own child traversal
// can decide which fields continue downstream.
public construct ThemeLayer(theme: Any Theme) extends Widget {
    let content: some Widget

    function describe(
        context: borrow BuildContext,
        modifiers: borrow ModifierContext
    ) -> CALayerDescription {
        let delta = modifierDeltaTheme(move theme)
        let resolved = modifierContextApply(modifiers, move delta)
        return content.describe(context, resolved)
    }
}

