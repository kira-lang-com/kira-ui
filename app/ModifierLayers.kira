public construct FrameLayer(width: Number, height: Number) extends Widget {
    let content: some Widget

    function describe(
        context: borrow BuildContext,
        modifiers: borrow ModifierContext
    ) -> CALayerDescription {
        return CALayerDescription {
            layout: CALayoutIntent {
                widthFill: false,
                heightFill: false,
                fixedWidth: width,
                fixedHeight: height,
                alignment: Point { x: 0.5, y: 0.5 }
            },
            sublayers: [content.describe(context, modifierContextForChildren(modifiers))]
        }
    }
}

public construct ZIndexLayer(value: Number) extends Widget {
    let content: some Widget

    function describe(
        context: borrow BuildContext,
        modifiers: borrow ModifierContext
    ) -> CALayerDescription {
        var described = content.describe(context, modifiers)
        described.layout.zIndex = value
        return described
    }
}

public construct BackgroundLayer(fill: Any Widget) extends Widget {
    let content: some Widget

    // The fill is the surface the modifiers describe, drawn behind the content;
    // both share this layer's bounds, fill first so it sits underneath.
    function describe(
        context: borrow BuildContext,
        modifiers: borrow ModifierContext
    ) -> CALayerDescription {
        let described = content.describe(context, modifierContextForChildren(modifiers))
        var behind = fill.describe(context, modifiers)
        behind.layout.decorates = true
        return CALayerDescription {
            layout: surfaceFootprint(described.layout),
            sublayers: [move behind, described]
        }
    }
}

// SwiftUI's `.overlay(_:alignment:)`: a view drawn over the content, offered
// the content's size and placed in it where `alignment` says. It takes no room
// of its own, so the content is as large as it was.
public construct OverlayLayer(overlay: Any Widget, alignment: StackAlignment) extends Widget {
    let content: some Widget

    function describe(
        context: borrow BuildContext,
        modifiers: borrow ModifierContext
    ) -> CALayerDescription {
        let described = content.describe(context, modifierContextForChildren(modifiers))
        var over = overlay.describe(context, modifiers)
        over.layout.decorates = true
        var layout = surfaceFootprint(described.layout)
        layout.alignment = stackAlignmentUnitPoint(alignment)
        return CALayerDescription { layout: layout, sublayers: [described, move over] }
    }
}

public construct CornerRadiusLayer(radius: Number) extends Widget {
    let content: some Widget

    // A clipping surface around the content: its own layer carrying the radius
    // and the clip, with the content as its sublayer.
    function describe(
        context: borrow BuildContext,
        modifiers: borrow ModifierContext
    ) -> CALayerDescription {
        let described = content.describe(context, modifierContextForChildren(modifiers))
        return CALayerDescription {
            layout: surfaceFootprint(described.layout),
            cornerRadius: radius,
            clipsChildren: true,
            sublayers: [described]
        }
    }
}

public construct ClipShapeLayer(shape: ContainerShape) extends Widget {
    let content: some Widget

    function describe(
        context: borrow BuildContext,
        modifiers: borrow ModifierContext
    ) -> CALayerDescription {
        let radius = containerShapeRadius(copy shape, modifiers)
        let described = content.describe(context, modifierContextContained(modifiers, radius))
        return CALayerDescription {
            layout: surfaceFootprint(described.layout),
            cornerRadius: radius,
            clipsChildren: true,
            sublayers: [described]
        }
    }
}

public construct OpacityLayer(value: Number) extends Widget {
    let content: some Widget

    function describe(
        context: borrow BuildContext,
        modifiers: borrow ModifierContext
    ) -> CALayerDescription {
        var described = content.describe(context, modifierContextForChildren(modifiers))
        // Compose, so nested `.opacity` multiplies as the cascade does rather
        // than the outer one replacing the inner.
        described.opacity = described.opacity * value
        return described
    }
}

// `.shadow(...)`: cast by the view's own layer, so it takes that layer's
// outline -- a card's continuous corner, a capsule's ends -- rather than the box
// around it, and a layer under glass casts it only past its edge.
public construct ShadowLayer(
    color: RGBAColor,
    radius: Number,
    x: Number,
    y: Number
) extends Widget {
    let content: some Widget

    function describe(
        context: borrow BuildContext,
        modifiers: borrow ModifierContext
    ) -> CALayerDescription {
        var described = content.describe(context, modifierContextForChildren(modifiers))
        let shadow = CAShadow {
            color: colorFromFoundation(modifierColor(foundationColor(color), modifiers)),
            radius: radius,
            offset: Point { x: x, y: y }
        }
        // A stack draws nothing of its own, so its box is no outline: it
        // casts the shape at its back, as SwiftUI's shadow of a shape with a
        // label over it follows the shape's corners.
        if !castsFromBack(described, shadow) { described.shadow = move shadow }
        return described
    }
}

// Gives `shadow` to the shape at the back of `layer`, through every layer
// that only holds others; false when there is none, and `layer` casts it.
function castsFromBack(layer: borrow mut CALayerDescription, shadow: borrow CAShadow) -> Bool {
    if layer.sublayers.count == 0 { return false }
    let holds = match layer.content {
        Empty -> true
        Solid, Texture, Icon, Glass, Gradient, Text -> false
    }
    if !holds { return false }
    let back = match layer.sublayers[0].content {
        Solid -> true
        Empty, Texture, Icon, Glass, Gradient, Text -> false
    }
    if back {
        layer.sublayers[0].shadow = copy shadow
        return true
    }
    return castsFromBack(layer.sublayers[0], shadow)
}

// `.scaleEffect(...)`: the subtree drawn larger or smaller than it was laid out.
//
// A DEFORMATION rather than a resize, which is the whole distinction. The view
// keeps exactly the space layout gave it and only its pixels move, so scaling a
// row inside a menu cannot reflow the menu — and the transform descends, so the
// row's label and glyph go with it instead of being scaled one by one.
//
// It scales about `anchor`, the subtree's own center unless it names another
// point, as SwiftUI's `scaleEffect(_:anchor:)` does.
// `.rotationEffect(...)`: the subtree's leaves drawn turned about their centers.
//
// Drawing state, so a turning glyph keeps the space layout gave it and cannot
// reflow the row it is in — which is the whole reason a chevron can be animated
// at all. A chevron that resized its row as it turned would move every label
// beside it, and that is what swapping one glyph for another did.
public construct RotationLayer(radians: Number) extends Widget {
    let content: some Widget

    function describe(
        context: borrow BuildContext,
        modifiers: borrow ModifierContext
    ) -> CALayerDescription {
        var described = content.describe(context, modifierContextForChildren(modifiers))
        described.rotation = radians
        return described
    }
}

public construct ScaleLayer(value: Number, anchor: StackAlignment = .Center) extends Widget {
    let content: some Widget

    function describe(
        context: borrow BuildContext,
        modifiers: borrow ModifierContext
    ) -> CALayerDescription {
        var described = content.describe(context, modifierContextForChildren(modifiers))
        described.scaleX = value
        described.scaleY = value
        described.anchorPoint = stackAlignmentUnitPoint(anchor)
        return described
    }
}

