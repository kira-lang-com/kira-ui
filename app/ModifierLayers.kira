public construct SizeLayer(value: Number) extends Widget {
    let content: some Widget

    function describe(
        context: borrow BuildContext,
        modifiers: borrow ModifierContext
    ) -> CALayerDescription {
        var described = content.describe(context, modifierContextForChildren(modifiers))
        described.layout.fixedWidth = value
        described.layout.fixedHeight = value
        described.layout.widthFill = false
        described.layout.heightFill = false
        described.layout.expandsWidth = false
        return described
    }
}

public construct FillLayer(color: RGBAColor) extends Widget {
    let content: some Widget

    function describe(
        context: borrow BuildContext,
        modifiers: borrow ModifierContext
    ) -> CALayerDescription {
        let delta = modifierDeltaFill(move color)
        let resolved = modifierContextApply(modifiers, move delta)
        return content.describe(context, resolved)
    }
}

public construct StrokeLayer(width: Number) extends Widget {
    let content: some Widget

    function describe(
        context: borrow BuildContext,
        modifiers: borrow ModifierContext
    ) -> CALayerDescription {
        return content.describe(
            context,
            modifierContextApply(modifiers, modifierDeltaStroke(width))
        )
    }
}

public construct StrokeColorLayer(color: RGBAColor, width: Number) extends Widget {
    let content: some Widget

    function describe(
        context: borrow BuildContext,
        modifiers: borrow ModifierContext
    ) -> CALayerDescription {
        let delta = modifierDeltaStrokeColor(move color, width)
        return content.describe(context, modifierContextApply(modifiers, move delta))
    }
}

public construct TextColorLayer(color: RGBAColor) extends Widget {
    let content: some Widget

    function describe(
        context: borrow BuildContext,
        modifiers: borrow ModifierContext
    ) -> CALayerDescription {
        let delta = modifierDeltaTextColor(move color)
        let resolved = modifierContextApply(modifiers, move delta)
        return content.describe(context, resolved)
    }
}

public construct BorderLayer(color: PrimaryColor, width: Number) extends Widget {
    let content: some Widget

    function describe(
        context: borrow BuildContext,
        modifiers: borrow ModifierContext
    ) -> CALayerDescription {
        let ink = primaryColorAsColor(color, modifierTokens(modifiers))
        return SurfaceBorderLayer(color: move ink, width: width) {
            content
        }
        .describe(context, modifiers)
    }
}

public construct SurfaceBorderLayer(color: RGBAColor, width: Number) extends Widget {
    let content: some Widget

    // A line around the content's edge: a clear layer stroked in `color`,
    // carrying the content as its sublayer, as a background does.
    function describe(
        context: borrow BuildContext,
        modifiers: borrow ModifierContext
    ) -> CALayerDescription {
        let described = content.describe(context, modifierContextForChildren(modifiers))
        return CALayerDescription {
            layout: surfaceFootprint(described.layout),
            content: .Solid(
                CASolid {
                    fill: CAColor { a: 0.0 },
                    border: colorFromFoundation(foundationColor(move color)),
                    borderWidth: width
                }
            ),
            sublayers: [described]
        }
    }
}

// A modifier that sets one value for its subtree and nothing more.
public construct ModifierDeltaLayer(delta: ModifierDelta) extends Widget {
    let content: some Widget

    function describe(
        context: borrow BuildContext,
        modifiers: borrow ModifierContext
    ) -> CALayerDescription {
        return content.describe(context, modifierContextApply(modifiers, copy delta))
    }
}
