import Foundation
import KCoreAnimation
// `@State` — persistent per-declaration UI state, the first `@PropertyWrapper` client.
//
// `@State var count: Int = 0` inside a Widget form reads and writes through this wrapper. The
// value lives behind an ambient native slot keyed "<Form>.<field>" (see the identity note in
// PropertyWrapper.kira: one shared value per declaration), allocated once with `nativeState` and
// recovered by reference afterwards — so state survives the per-frame widget rebuilds of the
// interactive app loop, which re-runs every widget initializer.
//
// `Wrapped` is the wrapper-template placeholder type: the @PropertyWrapper macro monomorphizes
// this struct per wrapped field, substituting `Wrapped` with the field's declared type and
// renaming `State` (including the `State { ... }` literal and `nativeRecover<State>` below) to
// the per-field struct name.

public @PropertyWrapper
struct State {
    var wrappedValue: Wrapped
    var key: String = ""

    function get() -> Wrapped {
        if kiraUiStateSlotHas(self.key) == false {
            kiraUiStateSlotPut(self.key, nativeUserData(nativeState(State {
                wrappedValue: self.wrappedValue,
                key: self.key
            })))
        }
        let store = nativeRecover<State>(kiraUiStateSlotGet(self.key))
        return store.wrappedValue
    }

    function set(value: Wrapped) {
        if kiraUiStateSlotHas(self.key) == false {
            kiraUiStateSlotPut(self.key, nativeUserData(nativeState(State {
                wrappedValue: self.wrappedValue,
                key: self.key
            })))
        }
        var store = nativeRecover<State>(kiraUiStateSlotGet(self.key))
        store.wrappedValue = move value
        return
    }
}

// Ambient-slot shims. Monomorphized wrapper code is spliced into the USER's package, where the
// underlying store's own module is not in scope — but KiraUI is (any package using widgets
// imports it), so the wrapper reaches the state store through these KiraUI-owned names.
public function kiraUiStateSlotHas(key: String) -> Bool {
    return stateSlotHas(move key)
}

public function kiraUiStateSlotGet(key: String) -> RawPtr {
    return stateSlotGet(move key)
}

public function kiraUiStateSlotPut(key: String, value: NativeState<Any>) {
    stateSlotPut(move key, move value)
    return
}

// The slot a KEYED widget's state lives in: a prefix and the widget's key, as
// decimal digits.
//
// Auto-minted keys are build-sequence numbers, so one widget's state has to be
// reachable from its key alone — there is nowhere else to put it. Every keyed
// widget asks for its slot on every build, so the digits are prepended as
// literals rather than gathered into a codepoint array and converted.
public function kiraUiSlotKey(prefix: String, key: Int) -> String {
    var remaining = key
    if remaining < 0 {
        remaining = 0 - remaining
    }
    var digits = kiraUiDecimalDigit(remaining - (remaining / 10) * 10)
    remaining = remaining / 10
    while remaining > 0 {
        digits = kiraUiDecimalDigit(remaining - (remaining / 10) * 10) + digits
        remaining = remaining / 10
    }
    return prefix + digits
}

function kiraUiDecimalDigit(digit: Int) -> String {
    if digit < 5 {
        if digit == 0 {
            return "0"
        }
        if digit == 1 {
            return "1"
        }
        if digit == 2 {
            return "2"
        }
        if digit == 3 {
            return "3"
        }
        return "4"
    }
    if digit == 5 {
        return "5"
    }
    if digit == 6 {
        return "6"
    }
    if digit == 7 {
        return "7"
    }
    if digit == 8 {
        return "8"
    }
    return "9"
}
