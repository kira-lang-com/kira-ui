import Foundation
import KCoreAnimation

// `@State` — persistent per-declaration UI state, as SwiftUI's `State` is.
//
// `@State var count: Number = 0` inside a Widget form reads and writes through
// a `State<Number>` the compiler stores as `_count` (a generic struct named by a
// field annotation is that field's property wrapper, KLF-RIDL section 30), so a
// program linking KiraUI's contract writes it as KiraUI does. The value lives
// behind an ambient native slot keyed "<Form>.<field>", which the compiler
// fills in as `key`: one shared value per declaration, allocated once with
// `nativeState` and recovered by reference afterwards, so state survives the
// per-frame widget rebuilds of the interactive app loop.

// The ambient slots KiraUI keeps its own state in, one per kind of state.
public namespace StateSlot {
    let clock: String = "kiraui.clock"
    let inspectorSink: String = "kiraui.inspector.sink"
    let tapSequence: String = "kiraui.tapseq"
    let layerActions: String = "kiraui.layer.actions"
    let navigationTransition: String = "kiraui.navigation.transition"
    let overlaySink: String = "kiraui.overlay.sink"
    let surfaceSink: String = "kiraui.surface.sink"
    let symbolAssets: String = "kiraui.symbol.assets"
    let tagEnvironment: String = "kiraui.tag.environment"
    let toolbarSink: String = "kiraui.toolbar.sink"
    let menu: String = "kiraui.menu"
    let menuBarVisibility: String = "kiraui.menubar.visibility"
    let redraw: String = "kiraui.redraw"
    let interfaceMode: String = "kiraui.interface.mode"
    let sidebar: String = "kiraui.navigation.sidebar"
    let navigationPath: String = "kiraui.navigation.path"
    let navigationEnvironment: String = "kiraui.navigation.environment"
    let sidebarSelection: String = "kiraui.navigation.sidebar-selection"
    let picker: String = "kiraui.picker"
    let scrollScope: String = "kiraui.scroll.scope"
    let scrollInput: String = "kiraui.scroll.input"
    let tokens: String = "kiraui.tokens"
    let workspaceSink: String = "kiraui.workspace.sink"
    let commands: String = "kiraui.commands"
    let menuBar: String = "kiraui.menubar"
    let menuExport: String = "kiraui.menubar.export"
    let windowCommand: String = "kiraui.window.command"
    let workspaceArrangement: String = "kiraui.workspace"
    let windowCanvas: String = "kiraui.window.canvas"
    let windowDecoration: String = "kiraui.window.decoration"
    let pendingShortcut: String = "kiraui.shortcut.pending"
    let environment: String = "kiraui.environment"
    let commandKey: String = "kiraui.command.key"
    let appStorage: String = "kiraui.app-storage"
    let preferredColorScheme: String = "kiraui.preferred-color-scheme"
    let imageDrawings: String = "kiraui.image.drawings"
}

@Instance(Bool)
@Instance(Number)
@Instance(String)
public struct State<Value> {
    var wrappedValue: Value
    var key: String = ""

    function get() -> Value {
        if !ambientStateHas(self.key) {
            ambientStatePut(
                self.key,
                nativeUserData(
                    nativeState(State<Value> { wrappedValue: self.wrappedValue, key: self.key })
                )
            )
        }
        let store = nativeRecover<State<Value>>(ambientStateGet(self.key))
        return copy store.wrappedValue
    }

    function set(value: Value) {
        if !ambientStateHas(self.key) {
            ambientStatePut(
                self.key,
                nativeUserData(
                    nativeState(State<Value> { wrappedValue: self.wrappedValue, key: self.key })
                )
            )
        }
        var store = nativeRecover<State<Value>>(ambientStateGet(self.key))
        store.wrappedValue = move value
    }

    // `$name`: a binding to the value this state keeps, which a control
    // reads and writes through.
    function projectedValue() -> Binding<Value> {
        let state = copy self
        let written = copy self
        return Binding<Value> {
            get: { in
                return state.get()
            },
            set: { value in
                written.set(move value)
            }
        }
    }
}

// The slot a KEYED widget's state lives in: a prefix and the widget's key, as
// decimal digits.
//
// Auto-minted keys are build-sequence numbers, so one widget's state has to be
// reachable from its key alone — there is nowhere else to put it. Every keyed
// widget asks for its slot on every build, so the digits are prepended as
// literals rather than gathered into a codepoint array and converted.
public function slotKey(prefix: String, key: Number) -> String {
    var remaining = abs(key)
    var digits = decimalDigit(remaining % 10)
    remaining = trunc(remaining / 10)
    while remaining > 0 {
        digits = decimalDigit(remaining % 10) + digits
        remaining = trunc(remaining / 10)
    }
    return prefix + digits
}

function decimalDigit(digit: Number) -> String {
    match digit {
        0 -> return "0"
        1 -> return "1"
        2 -> return "2"
        3 -> return "3"
        4 -> return "4"
        5 -> return "5"
        6 -> return "6"
        7 -> return "7"
        8 -> return "8"
        else -> return "9"
    }
}

// Makes the process's own ambient scope current, the one it starts in and no
// runner enters for its loop, and answers the scope that was. Settings that
// hold for the whole process -- the interface mode, whether the menu bar is
// drawn, when the interface is next described -- are kept there, so one made
// before a runner started holds inside it. The caller enters the answer again.
function enterProcessScope() -> AmbientScope {
    let previous = ambientScopeCurrent()
    ambientScopeEnter(AmbientScope(0))
    return previous
}
