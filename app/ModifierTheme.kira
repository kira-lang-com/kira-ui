import Foundation

// The theme in effect's answers, asked of it where it stands. Copying the
// theme out of the context to ask it one question cost more than the answer,
// and an unthemed tree asks at nearly every widget.

public function modifierAppearance(modifiers: borrow ModifierContext) -> Appearance {
    if modifiers.hasTheme {
        return modifiers.theme.appearance()
    }
    return resolvedAppearance(copy defaultThemeAppearance)
}

// The scheme the library's own theme declares, read once: asking the theme
// reads it out of the theme's whole style.
let defaultThemeAppearance: Appearance = defaultTheme.style.appearance

public function modifierTypography(modifiers: borrow ModifierContext, style: borrow TypographyStyle) -> FontImplementation {
    if modifiers.hasTheme {
        return modifiers.theme.typography(style)
    }
    return defaultTheme.typography(style)
}

public function modifierSymbol(modifiers: borrow ModifierContext, symbol: borrow Symbol) -> String {
    if modifiers.hasTheme {
        return modifiers.theme.symbol(symbol)
    }
    return defaultTheme.symbol(symbol)
}

public function modifierSpacing(modifiers: borrow ModifierContext, style: borrow Spacing) -> Float {
    if modifiers.hasTheme {
        return modifiers.theme.spacing(style)
    }
    return defaultTheme.spacing(style)
}

public function modifierCornerRadius(modifiers: borrow ModifierContext, style: borrow CornerRadius) -> Float {
    if modifiers.hasTheme {
        return modifiers.theme.cornerRadius(style)
    }
    return defaultTheme.cornerRadius(style)
}

public function modifierControlMetrics(modifiers: borrow ModifierContext, size: borrow ControlSize) -> ControlMetricsImplementation {
    if modifiers.hasTheme {
        return modifiers.theme.controlMetrics(size)
    }
    return defaultTheme.controlMetrics(size)
}
