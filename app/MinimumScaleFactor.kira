import Foundation
import KCoreAnimation

// SwiftUI's inherited minimum text scale, consumed while measuring and
// drawing a line-limited Text. A value of 1 leaves normal line breaking and
// ellipsis; a value below 1 chooses the largest font that fits the proposal.
// The full original Text remains the accessible label.
public function modifierDeltaMinimumScaleFactor(value: Number) -> ModifierDelta {
    return ModifierDelta {
        hasMinimumScaleFactor: true,
        minimumScaleFactor: clamp(value, 0.01, 1.0)
    }
}

extend Widget {
    // SwiftUI: `.minimumScaleFactor(_ factor: CGFloat)`.
    function minimumScaleFactor(factor: Number) -> Any Widget {
        return ModifierDeltaLayer(delta: modifierDeltaMinimumScaleFactor(factor)) { self }
    }
}