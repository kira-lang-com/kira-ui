import Foundation
import KiraUIFoundation

// Inspecting a lowered widget tree, for a test that has no window.
//
// A headless gate wants to ask what a widget tree came out as — does it say
// "DEFEATED", how many painted surfaces does it have — and lowering is the only
// way to find out, because a widget's own value carries the intent and not the
// result. Doing that at the call site meant an app naming
// `FoundationView` and its view kinds, which is the one package
// an app is not supposed to see: KiraUI and KiraGraphics are the whole surface.
//
// So the lowered tree is a value KiraUI hands out and answers questions about,
// and the foundation stays behind it.

struct LoweredWidgetTree {
    var view: FoundationView
}

// Lower `root` the way an app's frame would, with a fresh context and no
// inherited modifiers.
function lowerWidgetForTest(root: Any Widget) -> LoweredWidgetTree {
    let context = FoundationUiContext {}
    return LoweredWidgetTree {
        view: root.lower(context, ModifierContext {})
    }
}

function loweredViewContainsText(view: borrow FoundationView, wanted: borrow String) -> Bool {
    if view.kind == .Text {
        if view.content == wanted {
            return true
        }
    }
        for i in 0..view.children.count {
        if loweredViewContainsText(view.children[i], wanted) {
            return true
        }
            }
    return false
}

// Whether any text node in the tree reads exactly `wanted`.
function loweredTreeContainsText(tree: borrow LoweredWidgetTree, wanted: borrow String) -> Bool {
    return loweredViewContainsText(tree.view, wanted)
}

function loweredViewSurfaceCount(view: borrow FoundationView) -> Int {
    var count = 0
    if view.kind == .Surface {
        count = 1
    }
        for i in 0..view.children.count {
        count = count + loweredViewSurfaceCount(view.children[i])
            }
    return count
}

// How many painted surfaces the tree holds — what a test counts to say a panel
// was built rather than skipped.
function loweredTreeSurfaceCount(tree: borrow LoweredWidgetTree) -> Int {
    return loweredViewSurfaceCount(tree.view)
}
