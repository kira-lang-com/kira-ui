import Foundation
import KCoreUI
import KCoreAnimation

// SwiftUI's `Glass`: what a piece of Liquid Glass is made of.
//
// `.Regular` is the glass of controls, bars and sidebars. `.Clear` only
// refracts, for glass over media that should show through untouched. Either one
// is a single recipe across every size, read from the catalog, so the case says
// which glass and the surface's laid-out size says how it looks: the 36-point
// capsule on a toolbar shows none of the blur a sidebar does.
public enum Glass {
    Regular
    Clear
}

// One input of a catalog recipe as the ramp the compositor applies, or a flat
// zero when the recipe leaves it out.
public function glassCompositorRamp(recipe: borrow ResolvedGlass, input: GlassInput) -> CAGlassRamp {
    let wanted = glassInputValue(input)
    for ramp in recipe.ramps {
        if glassInputValue(ramp.input) == wanted {
            return CAGlassRamp {
                base: ramp.base,
                slope: ramp.slope,
                minimum: ramp.minimum,
                maximum: ramp.maximum
            }
        }
    }
    return CAGlassRamp {}
}

// A recipe as what the compositor draws with it. Glass blurs everything
// behind it, as far as the recipe's radius says at the surface's size -- a
// little under a control, far under a menu or a panel -- and never shows the
// backdrop sharp through the blur. The edge's grays and its light are the
// recipe's own at every size. Liquid Glass casts no shadow, so a recipe's
// shadow inputs are not drawn.
public function glassCompositorSizing(recipe: borrow ResolvedGlass) -> CAGlassSizing {
    return CAGlassSizing {
        blurRadius: glassCompositorRamp(recipe, .BlurRadius),
        ringTone: glassCompositorRamp(recipe, .EdgeRingTone),
        sideTone: glassCompositorRamp(recipe, .EdgeSideTone),
        lightDodge: glassCompositorRamp(recipe, .EdgeLightDodge),
        lightBurn: glassCompositorRamp(recipe, .EdgeLightBurn)
    }
}

// A glass in both appearances, resolved once.
public struct GlassSizingPair {
    var light: CAGlassSizing = CAGlassSizing {}
    var dark: CAGlassSizing = CAGlassSizing {}
}

public function catalogGlassSizing(stack: borrow CatalogStack, name: borrow String) -> GlassSizingPair {
    return GlassSizingPair {
        light: glassCompositorSizing(resolveGlass(stack, name, kiraUICatalogEnvironment(.Light))),
        dark: glassCompositorSizing(resolveGlass(stack, name, kiraUICatalogEnvironment(.Dark)))
    }
}

public let regularGlassSizing = catalogGlassSizing(kiraUICatalogStack, glassRegular())
public let clearGlassSizing = catalogGlassSizing(kiraUICatalogStack, glassClear())

// What `glass` does with size in the appearance in effect.
public function glassSizing(glass: borrow Glass, modifiers: borrow ModifierContext) -> CAGlassSizing {
    var pair = regularGlassSizing
    if glass == .Clear {
        pair = clearGlassSizing
    }
    match modifierAppearance(modifiers) {
        Light -> return pair.light
        Dark -> return pair.dark
    }
}

// --- Vibrancy ----------------------------------------------------------------
//
// What content set into glass is inked with. Apple does not paint a symbol over
// the glass in a gray; it burns the gray into it in the light appearance and
// dodges it in the dark, so the glass — and whatever it refracts — shows through
// the glyph. The catalog states each style as a material of one fill layer: the
// gray and the blend together.

public struct VibrantInk {
    var color: CAColor = CAColor {}
    var blend: CABlendMode = .Normal
}

public struct VibrantInkPair {
    var light: VibrantInk = VibrantInk {}
    var dark: VibrantInk = VibrantInk {}
}

// The blends the compositor can set ink in; every other one inks normally.
public function vibrantBlend(blend: borrow BlendMode) -> CABlendMode {
    match blend {
        LinearBurn -> return .LinearBurn
        LinearDodge -> return .LinearDodge
        Normal -> return .Normal
        ColorDodge -> return .Normal
        HardLight -> return .Normal
        Overlay -> return .Normal
        Lighten -> return .Normal
        Darken -> return .Normal
        Multiply -> return .Normal
        Luminosity -> return .Normal
        Unknown(value) -> return .Normal
    }
}

public function vibrantInkFrom(layer: borrow ResolvedMaterialLayer) -> VibrantInk {
    return VibrantInk {
        color: CAColor { r: layer.color.r, g: layer.color.g, b: layer.color.b, a: layer.color.a * layer.opacity },
        blend: vibrantBlend(layer.blend)
    }
}

public function catalogVibrantInkAt(stack: borrow CatalogStack, name: borrow String, appearance: borrow Appearance) -> VibrantInk {
    let material = resolveMaterial(stack, name, kiraUICatalogEnvironment(appearance))
    for layer in material.layers {
        match layer.kind {
            Fill -> return vibrantInkFrom(layer)
            BackdropBlur -> {}
            Saturation -> {}
            Tint -> {}
            Noise -> {}
            Border -> {}
        }
    }
    return VibrantInk {}
}

public function catalogVibrantInk(stack: borrow CatalogStack, name: borrow String) -> VibrantInkPair {
    return VibrantInkPair {
        light: catalogVibrantInkAt(stack, name, .Light),
        dark: catalogVibrantInkAt(stack, name, .Dark)
    }
}

public let vibrantLabelInk = catalogVibrantInk(kiraUICatalogStack, materialVibrantLabel())

// The primary vibrant ink in the appearance in effect.
public function vibrantLabel(modifiers: borrow ModifierContext) -> VibrantInk {
    match modifierAppearance(modifiers) {
        Light -> return vibrantLabelInk.light
        Dark -> return vibrantLabelInk.dark
    }
}

// --- Interactive glass -------------------------------------------------------
//
// SwiftUI's `.glassEffect(.regular.interactive())`: a piece of glass that
// answers a press anywhere on it, whichever control inside took it. The whole
// piece comes up to meet the finger, swelling uniformly by a fixed rise; a
// light comes up in it under the fingertip and travels with it; a pull drags it
// a little way after the pointer through resistance and reshapes it, tall and
// narrow pulled up or down, long pulled sideways; and let go, it springs home,
// dipping under its resting size before it settles. Whatever it holds is part
// of the piece: it moves, swells and leans with it.

public struct InteractiveGlass {
    var pull: MotionPullState = MotionPullState {}
    var glow: MotionGlowState = MotionGlowState {}
    var held: Bool = false
    // Which press it is holding. A surface only sees a press end while it is
    // built, and one that was not -- a submenu's card shut under the finger
    // -- would take the next press on it for the old one still going.
    var press: Int = 0
    // The box the glass rests in, kept from the press so it settles back into
    // it after the pointer has let go.
    var size: Size = Size {}
}

public function interactiveGlassSlotKey(key: Int) -> String {
    return kiraUiSlotKey("kiraui.glass.", key)
}


// Makes `layer` interactive under `key`: pressed anywhere, whichever control
// inside took the press, it swells, follows the pointer and leans, and let go
// it springs home. A `panel` -- a menu's glass -- answers as the platform's
// menus do: it follows and leans but never swells, and lights only under a
// press on the panel itself, since a row pressed lights its own highlight. The swell is the layer's own scale, so what it holds is
// drawn at the size it swells to; the follow and the lean are its
// deformation, which deforms that drawing as a picture, so nothing on it
// reflows or slips while it is pulled. Its box -- and everything around it --
// stays where layout put it. What comes back is the light the press has
// brought up, carried back through the pull into the layer's own coordinates,
// for a glass to draw.
public function interactivePress(layer: borrow mut CALayerDescription, key: Int, context: borrow BuildContext, panel: Bool = false) -> MotionLight {
    layer.interactive = true
    layer.hitKey = key
    // A press between its controls lands on the surface itself, not on
    // whatever is behind it; on a panel it slides from control to control.
    layer.hittable = true
    layer.slidesPress = panel

    // Recovered in place rather than through a helper: a recovered value
    // handed back out of a function is a copy, and the press would be lost.
    if kiraUiStateSlotHas(interactiveGlassSlotKey(key)) == false {
        kiraUiStateSlotPut(interactiveGlassSlotKey(key), nativeUserData(nativeState(InteractiveGlass {})))
    }
    var glass = nativeRecover<InteractiveGlass>(kiraUiStateSlotGet(interactiveGlassSlotKey(key)))
    let held = context.heldKey == key
    if held && glass.held && glass.press != context.heldPress {
        glass.pull = MotionPullState {}
        glass.glow = MotionGlowState {}
        glass.held = false
    }
    glass.press = context.heldPress
    let point = context.heldPoint
    let delta = kiraUiClockDelta()
    let reduced = kiraUiReducedMotion()
    if held && !glass.held {
        glass.size = context.heldSize
        motionPullFit(glass.pull, glass.size.width, glass.size.height)
        let origin = context.heldOrigin
        motionPullRoom(
            glass.pull,
            origin.x,
            origin.y,
            context.viewportWidth - origin.x - glass.size.width,
            context.viewportHeight - origin.y - glass.size.height
        )
        if panel {
            motionPullHangs(glass.pull)
        }
        motionPullPress(glass.pull, point.x, point.y, reduced)
        if !panel || !context.heldOnControl {
            motionGlowFit(glass.glow, glass.size.width, glass.size.height, glassTouchLightReach(context))
            motionGlowPress(glass.glow, point.x, point.y)
        }
    } else if held {
        motionPullMove(glass.pull, point.x, point.y, delta)
        motionGlowMove(glass.glow, point.x, point.y)
    } else if glass.held {
        motionPullRelease(glass.pull, reduced)
        motionGlowRelease(glass.glow)
    }
    glass.held = held
    let pulled = motionPullAdvance(glass.pull, delta, reduced)
    motionGlowAdvance(glass.glow, delta)
    if !motionPullMoving(glass.pull) && !motionGlowLit(glass.glow) {
        return MotionLight {}
    }
    kiraUiClockStillMoving()

    let centerX = glass.size.width * 0.5
    let centerY = glass.size.height * 0.5
    let swell = panel ? 1.0 : pulled.pressScale
    let scaleX = swell * pulled.scaleX
    let scaleY = swell * pulled.scaleY
    layer.scaleX = layer.scaleX * swell
    layer.scaleY = layer.scaleY * swell
    layer.deformation = CADeformation {
        x: pulled.x,
        y: pulled.y,
        scaleX: pulled.scaleX,
        scaleY: pulled.scaleY
    }
    layer.disablesActions = true
    // The light stays on the surface: a pointer pulled off its edge lights the
    // edge it left by.
    let light = motionGlowLight(glass.glow)
    return MotionLight {
        x: clamp(centerX + (light.x - pulled.x - centerX) / scaleX, 0.0, glass.size.width),
        y: clamp(centerY + (light.y - pulled.y - centerY) / scaleY, 0.0, glass.size.height),
        radius: light.radius,
        strength: light.strength
    }
}

// Draws `light` in a piece of glass, as bright as the appearance takes it.
public function interactiveGlassLit(glass: borrow mut CAGlass, light: borrow MotionLight, modifiers: borrow ModifierContext) {
    glass.glowX = light.x
    glass.glowY = light.y
    glass.glowRadius = light.radius
    glass.glowStrength = light.strength / motionGlowLevel() * glassTouchLightLevel(modifierAppearance(modifiers))
}

// The touch light at its center, white added to the glass. Faint, and fainter
// in the dark, where the same white over a dark material reads far brighter:
// the glass lifts under the finger, it does not shine.
public function glassTouchLightLevel(appearance: Appearance) -> Float {
    match appearance {
        Light -> return 0.16
        Dark -> return 0.10
    }
}

// How far the touch light reaches, across: past the window, so it falls off
// over the whole of it -- one light that a large surface still catches a trace
// of at its far edge, not a spot on a small one.
public function glassTouchLightReach(context: borrow BuildContext) -> Float {
    return hypot(context.viewportWidth, context.viewportHeight) * 2.4
}

// A piece of Liquid Glass, as `liquidGlassDescription` draws it, that is
// interactive under `key`. Whatever it holds is part of the piece.
public function interactiveGlassDescription(
    context: borrow BuildContext,
    key: Int,
    layout: CALayoutIntent,
    radius: Float,
    shape: borrow ContainerShape,
    modifiers: borrow ModifierContext,
    sublayers: [CALayerDescription],
    variant: borrow Glass = .Regular,
    panel: Bool = false,
) -> CALayerDescription {
    var layer = liquidGlassDescription(move layout, radius, shape, modifiers, move sublayers, variant)
    let light = interactivePress(layer, key, context, panel)
    var content = liquidGlassContent(shape, modifiers, variant)
    interactiveGlassLit(content, light, modifiers)
    layer.content = .Glass(move content)
    return layer
}
