import Foundation
import KCoreUI

// The lengths the window's chrome, the sidebar, lists, titles, the stack's
// transitions and scroll views are laid out and moved with, and the colors
// they are painted with.
//
// Every group is resolved once for each interface mode, and read through a
// function that answers with the one the interface is drawn at, so switching
// the mode costs a comparison rather than a catalog lookup.

// --- Window chrome ---------------------------------------------------------

// The lengths the window's chrome is laid out with, read once from the catalog.
//
// Every one is a catalog metric, so the bar is the platform's bar wherever the
// catalog has measured it and an application overrides a length with a partial
// blob rather than with code.
public struct WindowChromeMetrics {
    // The band the bar takes: the window kit's on a tablet or a computer, and
    // the compact one under an iPhone's status bar. `windowChromeMetricsFor`
    // says which a window of a given width is drawn with. The content is held
    // under `bandHeight`, which on a computer is the bar's own height and on an
    // iPhone runs past its row.
    var toolbarHeight: Float
    var bandHeight: Float
    let compactToolbarHeight: Float
    let compactBandHeight: Float
    let itemHeight: Float
    let itemWidth: Float
    let groupSpacing: Float
    let groupInset: Float
    let itemSpacing: Float
    let spacerWidth: Float
    var edgeInset: Float
    let compactEdgeInset: Float
    let labelInset: Float
    let symbolSize: Float
    let symbolWeight: Float
    let controlsLeading: Float
    let controlDiameter: Float
    let controlSpacing: Float
    let controlsTrailing: Float
    let backRemovalScale: Float
    let searchWidth: Float
    let searchLeading: Float
    let searchTrailing: Float
    let searchSpacing: Float
    let backRemovalDuration: Float
    // The window's own corner.
    let cornerRadius: Float

    // Where the bar's own content may start: past the close, minimize and zoom
    // buttons and the room the platform leaves after them.
    function controlsEnd() -> Float {
        return controlsLeading + controlDiameter * 3.0 + controlSpacing * 2.0 + controlsTrailing
    }
}

public function catalogWindowChromeMetrics(mode: InterfaceMode) -> WindowChromeMetrics {
    return WindowChromeMetrics {
        toolbarHeight: catalogMetric(kiraUICatalogStack, metricToolbarHeight(), mode),
        bandHeight: catalogMetric(kiraUICatalogStack, metricToolbarHeight(), mode),
        compactToolbarHeight: catalogMetric(kiraUICatalogStack, metricToolbarCompactHeight(), mode),
        compactBandHeight: catalogMetric(kiraUICatalogStack, metricToolbarCompactBandHeight(), mode),
        itemHeight: catalogMetric(kiraUICatalogStack, metricToolbarItemHeight(), mode),
        itemWidth: catalogMetric(kiraUICatalogStack, metricToolbarItemWidth(), mode),
        groupSpacing: catalogMetric(kiraUICatalogStack, metricToolbarGroupSpacing(), mode),
        groupInset: catalogMetric(kiraUICatalogStack, metricToolbarGroupInset(), mode),
        itemSpacing: catalogMetric(kiraUICatalogStack, metricToolbarItemSpacing(), mode),
        spacerWidth: catalogMetric(kiraUICatalogStack, metricToolbarSpacerWidth(), mode),
        edgeInset: catalogMetric(kiraUICatalogStack, metricToolbarEdgeInset(), mode),
        compactEdgeInset: catalogMetric(kiraUICatalogStack, metricToolbarCompactEdgeInset(), mode),
        labelInset: catalogMetric(kiraUICatalogStack, metricToolbarItemLabelInset(), mode),
        symbolSize: catalogMetric(kiraUICatalogStack, metricToolbarSymbolSize(), mode),
        symbolWeight: catalogMetric(kiraUICatalogStack, metricToolbarSymbolWeight(), mode),
        controlsLeading: catalogMetric(kiraUICatalogStack, metricWindowControlsLeading(), mode),
        controlDiameter: catalogMetric(kiraUICatalogStack, metricWindowControlDiameter(), mode),
        controlSpacing: catalogMetric(kiraUICatalogStack, metricWindowControlSpacing(), mode),
        controlsTrailing: catalogMetric(kiraUICatalogStack, metricWindowControlsTrailing(), mode),
        backRemovalScale: catalogMetric(kiraUICatalogStack, metricToolbarBackRemovalScale(), mode),
        searchWidth: catalogMetric(kiraUICatalogStack, metricToolbarSearchWidth(), mode),
        searchLeading: catalogMetric(kiraUICatalogStack, metricToolbarSearchLeading(), mode),
        searchTrailing: catalogMetric(kiraUICatalogStack, metricToolbarSearchTrailing(), mode),
        searchSpacing: catalogMetric(kiraUICatalogStack, metricToolbarSearchSpacing(), mode),
        backRemovalDuration: catalogMetric(kiraUICatalogStack, metricToolbarBackRemovalDuration(), mode),
        cornerRadius: catalogMetric(kiraUICatalogStack, metricWindowCornerRadius(), mode)
    }
}

let desktopWindowChromeMetrics = catalogWindowChromeMetrics(.AdaptiveDesktop)
let mobileWindowChromeMetrics = catalogWindowChromeMetrics(.AdaptiveMobile)

public function windowChromeMetrics() -> WindowChromeMetrics {
    return interfaceMode() == .AdaptiveDesktop ? desktopWindowChromeMetrics : mobileWindowChromeMetrics
}

// The chrome a window this wide is drawn with: on a phone, the compact bar. A
// desktop window keeps its own bar however narrow it is drawn.
public function windowChromeMetricsFor(width: Float) -> WindowChromeMetrics {
    var metrics = windowChromeMetrics()
    if interfaceMode() == .AdaptiveMobile && resolvedNavigationDevice(width) == .Phone {
        metrics.toolbarHeight = metrics.compactToolbarHeight
        metrics.bandHeight = metrics.compactBandHeight
        metrics.edgeInset = metrics.compactEdgeInset
    }
    return metrics
}

// The window title's typeface: a toolkit text style, since Apple names none.
public function catalogWindowTitleFont(mode: InterfaceMode) -> FontImplementation {
    return catalogFont(kiraUICatalogStack, "windowTitle", mode)
}

let desktopWindowTitleFont = catalogWindowTitleFont(.AdaptiveDesktop)
let mobileWindowTitleFont = catalogWindowTitleFont(.AdaptiveMobile)
let compactWindowTitleFont = catalogFont(kiraUICatalogStack, "windowTitleCompact", .AdaptiveMobile)

// The bar's title face for a window this wide: on a phone, the compact bar's.
public function windowTitleFontFor(width: Float) -> FontImplementation {
    if interfaceMode() == .AdaptiveDesktop {
        return desktopWindowTitleFont
    }
    if resolvedNavigationDevice(width) == .Phone {
        return compactWindowTitleFont
    }
    return mobileWindowTitleFont
}

// --- Menu bar --------------------------------------------------------------

// The lengths the window's menu bar is laid out with: the row across the top
// of the window, the pill each title lights in while its menu is out, the
// room around a title and between two, and how far under the row a menu's
// card hangs.
public struct MenuBarMetrics {
    let height: Float
    let titleHeight: Float
    let titlePadding: Float
    let titleSpacing: Float
    let cardGap: Float
}

public function catalogMenuBarMetrics(mode: InterfaceMode) -> MenuBarMetrics {
    return MenuBarMetrics {
        height: catalogMetric(kiraUICatalogStack, metricMenuBarHeight(), mode),
        titleHeight: catalogMetric(kiraUICatalogStack, metricMenuBarTitleHeight(), mode),
        titlePadding: catalogMetric(kiraUICatalogStack, metricMenuBarTitlePadding(), mode),
        titleSpacing: catalogMetric(kiraUICatalogStack, metricMenuBarTitleSpacing(), mode),
        cardGap: catalogMetric(kiraUICatalogStack, metricMenuBarCardGap(), mode)
    }
}

let desktopMenuBarMetrics = catalogMenuBarMetrics(.AdaptiveDesktop)
let mobileMenuBarMetrics = catalogMenuBarMetrics(.AdaptiveMobile)

public function menuBarMetrics() -> MenuBarMetrics {
    return interfaceMode() == .AdaptiveDesktop ? desktopMenuBarMetrics : mobileMenuBarMetrics
}

// A menu's title on the bar, and the application's, which is set heavier.
let desktopMenuBarTitleFont = catalogFont(kiraUICatalogStack, "menuBarTitle", .AdaptiveDesktop)
let mobileMenuBarTitleFont = catalogFont(kiraUICatalogStack, "menuBarTitle", .AdaptiveMobile)
let desktopMenuBarApplicationFont = catalogFont(kiraUICatalogStack, "menuBarApplicationTitle", .AdaptiveDesktop)
let mobileMenuBarApplicationFont = catalogFont(kiraUICatalogStack, "menuBarApplicationTitle", .AdaptiveMobile)

public function menuBarTitleFont(application: Bool) -> FontImplementation {
    if interfaceMode() == .AdaptiveDesktop {
        return application ? desktopMenuBarApplicationFont : desktopMenuBarTitleFont
    }
    return application ? mobileMenuBarApplicationFont : mobileMenuBarTitleFont
}

// --- Sidebar ---------------------------------------------------------------

// How wide a split view's sidebar column opens, in a window of regular width
// and in an expanded one, and the lengths a `List` in it is laid out with, all
// of them from the column's own edge: the section title's row, where its text
// starts and how far down, the rows and where their content starts, the
// selection band and its corner, and the column the glyph is centered in before
// the title -- and the spring the column slides in and out on when its toggle
// is pressed, which does not bounce: a sidebar is a pane, not a card. Its
// glass runs past the window's edges by `glassBleed`, so the edge a piece of
// glass draws -- its rim, its antialiased border -- is off the window, and a
// view sliding under the pane never shows through it there. Along its
// trailing edge the detail casts a shadow into it, `shadowRadius` soft.
public struct SidebarMetrics {
    let width: Float
    let expandedWidth: Float
    let headerHeight: Float
    let headerInset: Float
    let headerTopInset: Float
    let rowHeight: Float
    let rowInset: Float
    let selectionInset: Float
    let selectionRadius: Float
    let iconColumn: Float
    let titleSpacing: Float
    let symbolSize: Float
    let toggleResponse: Float
    let toggleDamping: Float
    let glassBleed: Float
    let shadowRadius: Float
}

public function catalogSidebarMetrics(mode: InterfaceMode) -> SidebarMetrics {
    return SidebarMetrics {
        width: catalogMetric(kiraUICatalogStack, metricSidebarWidth(), mode),
        expandedWidth: catalogMetric(kiraUICatalogStack, metricSidebarExpandedWidth(), mode),
        headerHeight: catalogMetric(kiraUICatalogStack, metricSidebarHeaderHeight(), mode),
        headerInset: catalogMetric(kiraUICatalogStack, metricSidebarHeaderInset(), mode),
        headerTopInset: catalogMetric(kiraUICatalogStack, metricSidebarHeaderTopInset(), mode),
        rowHeight: catalogMetric(kiraUICatalogStack, metricSidebarRowHeight(), mode),
        rowInset: catalogMetric(kiraUICatalogStack, metricSidebarRowInset(), mode),
        selectionInset: catalogMetric(kiraUICatalogStack, metricSidebarSelectionInset(), mode),
        selectionRadius: catalogMetric(kiraUICatalogStack, metricSidebarSelectionRadius(), mode),
        iconColumn: catalogMetric(kiraUICatalogStack, metricSidebarIconColumn(), mode),
        titleSpacing: catalogMetric(kiraUICatalogStack, metricSidebarTitleSpacing(), mode),
        symbolSize: catalogMetric(kiraUICatalogStack, metricSidebarSymbolSize(), mode),
        toggleResponse: catalogMetric(kiraUICatalogStack, metricSidebarToggleResponse(), mode),
        toggleDamping: catalogMetric(kiraUICatalogStack, metricSidebarToggleDamping(), mode),
        glassBleed: catalogMetric(kiraUICatalogStack, metricSidebarGlassBleed(), mode),
        shadowRadius: catalogMetric(kiraUICatalogStack, metricSidebarShadowRadius(), mode)
    }
}

let desktopSidebarMetrics = catalogSidebarMetrics(.AdaptiveDesktop)
let mobileSidebarMetrics = catalogSidebarMetrics(.AdaptiveMobile)

public function sidebarMetrics() -> SidebarMetrics {
    return interfaceMode() == .AdaptiveDesktop ? desktopSidebarMetrics : mobileSidebarMetrics
}

// The selected row's band: a wash over the column's glass, not the accent.
public let sidebarSelection = catalogAdaptive(kiraUICatalogStack, "sidebarSelection")

// The shadow the detail casts into the sidebar's glass along its trailing
// edge.
public let sidebarShadowColor = catalogAdaptive(kiraUICatalogStack, colorSidebarShadow())

// --- Inset grouped list ------------------------------------------------------

// The lengths `Form` and an inset grouped `List` are laid out with: the
// readable column and the gaps down it, the card and its rows, and the room
// around a header and a footer.
public struct ListMetrics {
    let readableWidth: Float
    let sectionSpacing: Float
    let topInset: Float
    let cornerRadius: Float
    let rowHeight: Float
    let rowInset: Float
    let separatorThickness: Float
    let accessorySpacing: Float
    let headerPadding: Float
    let footerTopInset: Float
    let footerBottomInset: Float
}

public function catalogListMetrics(mode: InterfaceMode) -> ListMetrics {
    return ListMetrics {
        readableWidth: catalogMetric(kiraUICatalogStack, metricListReadableWidth(), mode),
        sectionSpacing: catalogMetric(kiraUICatalogStack, metricListSectionSpacing(), mode),
        topInset: catalogMetric(kiraUICatalogStack, metricListTopInset(), mode),
        cornerRadius: catalogMetric(kiraUICatalogStack, metricListCornerRadius(), mode),
        rowHeight: catalogMetric(kiraUICatalogStack, metricListRowHeight(), mode),
        rowInset: catalogMetric(kiraUICatalogStack, metricListRowInset(), mode),
        separatorThickness: catalogMetric(kiraUICatalogStack, metricListSeparatorThickness(), mode),
        accessorySpacing: catalogMetric(kiraUICatalogStack, metricListAccessorySpacing(), mode),
        headerPadding: catalogMetric(kiraUICatalogStack, metricListHeaderPadding(), mode),
        footerTopInset: catalogMetric(kiraUICatalogStack, metricListFooterTopInset(), mode),
        footerBottomInset: catalogMetric(kiraUICatalogStack, metricListFooterBottomInset(), mode)
    }
}

let desktopListMetrics = catalogListMetrics(.AdaptiveDesktop)
let mobileListMetrics = catalogListMetrics(.AdaptiveMobile)

public function listMetrics() -> ListMetrics {
    return interfaceMode() == .AdaptiveDesktop ? desktopListMetrics : mobileListMetrics
}

// What a grouped list is painted with: the canvas the sections sit on, the
// card its rows share, and the hairline between two rows.
public let groupedBackground = catalogAdaptive(kiraUICatalogStack, colorSystemGroupedBackground())
public let groupedCardBackground = catalogAdaptive(kiraUICatalogStack, colorSecondarySystemGroupedBackground())
public let listSeparator = catalogAdaptive(kiraUICatalogStack, colorSeparator())
// A row held down lights in the fourth gray, as a cell does.
public let listRowHighlight = catalogAdaptive(kiraUICatalogStack, colorSystemGray4())

// --- Large title -------------------------------------------------------------

// Where a column's large title sits under the bar, and the room it leaves
// before the content; how long it takes to fade over to the bar's inline
// title once it goes under, and how far the inline one rises and how blurred
// it starts as it comes.
public struct LargeTitleMetrics {
    let topInset: Float
    let bottomInset: Float
    let fadeDuration: Float
    let inlineTravel: Float
    let inlineBlur: Float
}

public function catalogLargeTitleMetrics(mode: InterfaceMode) -> LargeTitleMetrics {
    return LargeTitleMetrics {
        topInset: catalogMetric(kiraUICatalogStack, metricLargeTitleTopInset(), mode),
        bottomInset: catalogMetric(kiraUICatalogStack, metricLargeTitleBottomInset(), mode),
        fadeDuration: catalogMetric(kiraUICatalogStack, metricLargeTitleFadeDuration(), mode),
        inlineTravel: catalogMetric(kiraUICatalogStack, metricLargeTitleInlineTravel(), mode),
        inlineBlur: catalogMetric(kiraUICatalogStack, metricLargeTitleInlineBlur(), mode)
    }
}

let desktopLargeTitleMetrics = catalogLargeTitleMetrics(.AdaptiveDesktop)
let mobileLargeTitleMetrics = catalogLargeTitleMetrics(.AdaptiveMobile)

public function largeTitleMetrics() -> LargeTitleMetrics {
    return interfaceMode() == .AdaptiveDesktop ? desktopLargeTitleMetrics : mobileLargeTitleMetrics
}

// How a stack moves between its views: the moving view's corner, how dark
// the view under it sits, and when a swipe back starts and goes
// through.
public struct NavigationTransitionMetrics {
    let pageCornerRadius: Float
    let coveredDim: Float
    let coveredParallax: Float
    let pushResponse: Float
    let pushDamping: Float
    let commitFraction: Float
    let commitVelocity: Float
    let swipeSlop: Float
}

public function catalogNavigationTransitionMetrics(mode: InterfaceMode) -> NavigationTransitionMetrics {
    return NavigationTransitionMetrics {
        pageCornerRadius: catalogMetric(kiraUICatalogStack, metricNavigationPageCornerRadius(), mode),
        coveredDim: catalogMetric(kiraUICatalogStack, metricNavigationCoveredDim(), mode),
        coveredParallax: catalogMetric(kiraUICatalogStack, metricNavigationCoveredParallax(), mode),
        pushResponse: catalogMetric(kiraUICatalogStack, metricNavigationPushResponse(), mode),
        pushDamping: catalogMetric(kiraUICatalogStack, metricNavigationPushDamping(), mode),
        commitFraction: catalogMetric(kiraUICatalogStack, metricNavigationSwipeCommitFraction(), mode),
        commitVelocity: catalogMetric(kiraUICatalogStack, metricNavigationSwipeCommitVelocity(), mode),
        swipeSlop: catalogMetric(kiraUICatalogStack, metricNavigationSwipeSlop(), mode)
    }
}

let desktopNavigationTransitionMetrics = catalogNavigationTransitionMetrics(.AdaptiveDesktop)
let mobileNavigationTransitionMetrics = catalogNavigationTransitionMetrics(.AdaptiveMobile)

public function navigationTransitionMetrics() -> NavigationTransitionMetrics {
    return interfaceMode() == .AdaptiveDesktop ? desktopNavigationTransitionMetrics : mobileNavigationTransitionMetrics
}

// The bar a scroll view shows along its trailing edge while it scrolls: how
// thick it is, and how thick under a pointer that holds it; the shortest it
// gets over long content, and the shortest it squeezes to past an end; how far
// beyond it a pointer still takes it, across and along; how long it stays once
// scrolling stops and how long it fades; how long it swells and thins back;
// and what it is painted with.
public struct ScrollIndicatorMetrics {
    let thickness: Float
    let expandedThickness: Float
    let minimumLength: Float
    let overscrolledLength: Float
    let hitOutsetAcross: Float
    let hitOutsetAlong: Float
    let hideDelay: Float
    let fadeDuration: Float
    let expandDuration: Float
    let collapseDuration: Float
}

public function catalogScrollIndicatorMetrics(mode: InterfaceMode) -> ScrollIndicatorMetrics {
    return ScrollIndicatorMetrics {
        thickness: catalogMetric(kiraUICatalogStack, metricScrollIndicatorThickness(), mode),
        expandedThickness: catalogMetric(kiraUICatalogStack, metricScrollIndicatorExpandedThickness(), mode),
        minimumLength: catalogMetric(kiraUICatalogStack, metricScrollIndicatorMinimumLength(), mode),
        overscrolledLength: catalogMetric(kiraUICatalogStack, metricScrollIndicatorOverscrolledLength(), mode),
        hitOutsetAcross: catalogMetric(kiraUICatalogStack, metricScrollIndicatorHitOutsetAcross(), mode),
        hitOutsetAlong: catalogMetric(kiraUICatalogStack, metricScrollIndicatorHitOutsetAlong(), mode),
        hideDelay: catalogMetric(kiraUICatalogStack, metricScrollIndicatorHideDelay(), mode),
        fadeDuration: catalogMetric(kiraUICatalogStack, metricScrollIndicatorFadeDuration(), mode),
        expandDuration: catalogMetric(kiraUICatalogStack, metricScrollIndicatorExpandDuration(), mode),
        collapseDuration: catalogMetric(kiraUICatalogStack, metricScrollIndicatorCollapseDuration(), mode)
    }
}

let desktopScrollIndicatorMetrics = catalogScrollIndicatorMetrics(.AdaptiveDesktop)
let mobileScrollIndicatorMetrics = catalogScrollIndicatorMetrics(.AdaptiveMobile)

public function scrollIndicatorMetrics() -> ScrollIndicatorMetrics {
    return interfaceMode() == .AdaptiveDesktop ? desktopScrollIndicatorMetrics : mobileScrollIndicatorMetrics
}

public let scrollIndicatorColor = catalogAdaptive(kiraUICatalogStack, colorScrollIndicator())

// The hard scroll edge effect a scroll view lays under the bar once its
// content runs under it: how far it blurs what passes beneath, the hairline
// along its bottom edge, and what each is painted with.
public struct ScrollEdgeMetrics {
    let blurRadius: Float
    let borderWidth: Float
}

public function catalogScrollEdgeMetrics(mode: InterfaceMode) -> ScrollEdgeMetrics {
    return ScrollEdgeMetrics {
        blurRadius: catalogMetric(kiraUICatalogStack, metricScrollEdgeBlurRadius(), mode),
        borderWidth: catalogMetric(kiraUICatalogStack, metricScrollEdgeBorderWidth(), mode)
    }
}

let desktopScrollEdgeMetrics = catalogScrollEdgeMetrics(.AdaptiveDesktop)
let mobileScrollEdgeMetrics = catalogScrollEdgeMetrics(.AdaptiveMobile)

public function scrollEdgeMetrics() -> ScrollEdgeMetrics {
    return interfaceMode() == .AdaptiveDesktop ? desktopScrollEdgeMetrics : mobileScrollEdgeMetrics
}

public let scrollEdgeFillColor = catalogAdaptive(kiraUICatalogStack, colorScrollEdgeFill())
public let scrollEdgeBorderColor = catalogAdaptive(kiraUICatalogStack, colorScrollEdgeBorder())
