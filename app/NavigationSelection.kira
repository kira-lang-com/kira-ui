import Foundation
import KCoreAnimation

// Which row a split view's sidebar has selected, as SwiftUI's
// `List(selection:)` knows it. Rows are counted in the order the sidebar
// describes them, and the selected one is remembered from build to build: a
// different row selected, or a path that starts somewhere else, is a new run
// of the detail -- a new view, keyed apart from the old one.
public struct SidebarSelectionState {
    var counting: Bool = false
    var ordinal: Number = 0
    var selected: Number = -1
    var shown: Number = -2
    var navigationGeneration: Number = 0
    var run: Number = 0
}

public function sidebarSelectionEnsure() {
    if !ambientStateHas(StateSlot.sidebarSelection) {
        ambientStatePut(
            StateSlot.sidebarSelection,
            nativeUserData(nativeState(SidebarSelectionState {}))
        )
    }
}

public function sidebarSelectionState() -> SidebarSelectionState {
    sidebarSelectionEnsure()
    return nativeRecover<SidebarSelectionState>(ambientStateGet(StateSlot.sidebarSelection))
}

// The sidebar is about to be described: count its rows from the top.
public function sidebarSelectionBegin() {
    sidebarSelectionEnsure()
    var state = nativeRecover<SidebarSelectionState>(ambientStateGet(StateSlot.sidebarSelection))
    state.counting = true
    state.ordinal = 0
    state.selected = -1
}

// A row of the sidebar, and whether it is the selected one.
public function sidebarSelectionRow(selected: Bool) {
    sidebarSelectionEnsure()
    var state = nativeRecover<SidebarSelectionState>(ambientStateGet(StateSlot.sidebarSelection))
    if !state.counting {
        return
    }
    if selected && state.selected < 0 {
        state.selected = state.ordinal
    }
    state.ordinal++
}

// The sidebar has been described: settle which run of the detail it selects.
public function sidebarSelectionEnd() {
    sidebarSelectionEnsure()
    var state = nativeRecover<SidebarSelectionState>(ambientStateGet(StateSlot.sidebarSelection))
    state.counting = false
    let generation = currentNavigationGeneration()
    if state.selected != state.shown || generation != state.navigationGeneration {
        state.run++
        state.shown = state.selected
        state.navigationGeneration = generation
    }
}

// The detail of a split view as the view of one selection: keyed by its run,
// so the tree takes a new selection's view as a new layer -- nothing of the
// old one carried over or moved into it -- simply there in its place.
public function navigationSelectedDetail(detail: CALayerDescription) -> CALayerDescription {
    let state = sidebarSelectionState()
    var page = detail
    page.key = state.run + 1
    return page
}
