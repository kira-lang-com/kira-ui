import Foundation
import Ember
import KiraLayout
import KCoreAnimation

// The inspector: the column on the trailing edge of the window.
//
// It belongs to the WINDOW, exactly as the toolbar does, and for the same
// reason. SwiftUI spells it `.inspector(isPresented:) { … }` — a modifier on a
// view inside the scene, not a box the view packs beside its own content —
// because an inspector is a column of the window: it runs the window's height,
// it sits outside the document rather than inside it, and it is shown and hidden
// as a whole. A document that laid one out beside itself would be a document
// deciding the window's shape.
//
//     DocumentView()
//         .inspector(isPresented = workspace().hasSelection()) {
//             ItemInspector()
//         }
//
// The content is lowered where it is written — it reads the theme and the size
// class of the view that declared it — and the view travels up to the split
// view, which is the thing that owns the columns.

// The inspector is hoisted while the window's content lowers. Keeping the
// already-described layer in the sink retains the actual child state, action
// identities, and geometry preferences without constructing a second copy of
// its body when the window positions the trailing column.
public struct InspectorSink {
    var collecting: Bool = false
    var presented: Bool = false
    var content: CALayerDescription = CALayerDescription {}
}

public function inspectorSinkEnsure() {
    if !ambientStateHas(StateSlot.inspectorSink) {
        ambientStatePut(StateSlot.inspectorSink, nativeUserData(nativeState(InspectorSink {})))
    }
}

// Opens collection for the window about to lower its columns, discarding what
// the last frame left.
public function inspectorCollect() {
    unsafe {
        inspectorSinkEnsure()
        var sink = nativeRecover<InspectorSink>(ambientStateGet(StateSlot.inspectorSink))
        sink.collecting = true
        sink.presented = false
        sink.content = CALayerDescription {}
    }
}

public function inspectorStopCollecting() {
    unsafe {
        inspectorSinkEnsure()
        var sink = nativeRecover<InspectorSink>(ambientStateGet(StateSlot.inspectorSink))
        sink.collecting = false
    }
}

public function inspectorIsPresented() -> Bool {
    unsafe {
        inspectorSinkEnsure()
        let sink = nativeRecover<InspectorSink>(ambientStateGet(StateSlot.inspectorSink))
        return sink.presented
    }
}

public function inspectorPresent(content: CALayerDescription) {
    unsafe {
        inspectorSinkEnsure()
        var sink = nativeRecover<InspectorSink>(ambientStateGet(StateSlot.inspectorSink))
        if !sink.collecting { return }
        sink.content = move content
        sink.presented = true
    }
}

// With no explicit preference the window picks its standard inspector width.
// A stated inspectorColumnWidth preference belongs to the INSPECTOR content,
// not to the pane the detail view happens to be in.
public namespace InspectorMetrics {
    let width: Number = 320.0
    let minWidth: Number = 180.0
    let detailMinWidth: Number = 300.0
    let borderWidth: Number = 1.0
}

public function inspectorResolvedWidth(
    described: borrow CALayerDescription,
    available: Number
) -> Number {
    let preferences = inspectorColumnWidthPreferences(described)
    return inspectorColumnWidthResolved(
        preferences, InspectorMetrics.width,
        max(1.0, available - InspectorMetrics.detailMinWidth)
    )
}

// A real KiraUI surface: the inspector supplies a separate trailing pane with
// its own background and border, rather than inventing a second centered
// sidebar or making the detail view itself paint its inspector's chrome.
public construct InspectorColumn() extends Widget {
    function describe(
        context: borrow BuildContext,
        modifiers: borrow ModifierContext
    ) -> CALayerDescription {
        unsafe {
            inspectorSinkEnsure()
            let sink = nativeRecover<InspectorSink>(ambientStateGet(StateSlot.inspectorSink))
            if !sink.presented { return CALayerDescription {} }
            let tint = colorFromFoundation(modifierColor(
                modifierPrimaryColor(.Primary, modifiers), modifiers
            ))
            let sheet = copy sink.content
            return CALayerDescription {
                content: .Solid(CASolid {
                    fill: colorFromFoundation(windowCanvas(modifiers)),
                    border: CAColor {
                        r: tint.r, g: tint.g, b: tint.b, a: 0.13
                    },
                    borderWidth: InspectorMetrics.borderWidth
                }),
                clipsChildren: true,
                layout: CALayoutIntent {
                    widthFill: true,
                    heightFill: true,
                    paddingLeading: resolvedContentMargin(modifiers),
                    paddingTrailing: resolvedContentMargin(modifiers),
                    paddingTop: context.safeArea.top,
                    paddingBottom: context.safeArea.bottom
                },
                sublayers: [move sheet]
            }
        }
    }
}

// The document is inset by the measured inspector width, and the pane is
// positioned on the window's trailing edge in a separate layer. This keeps
// its hit regions above the document while leaving the native toolbar and
// window controls their own unmodified, full-width chrome layer.
public function inspectorWindowContent(
    document: CALayerDescription,
    context: borrow BuildContext,
    modifiers: borrow ModifierContext
) -> CALayerDescription {
    if !inspectorIsPresented() { return document }
    unsafe {
        let sink = nativeRecover<InspectorSink>(ambientStateGet(StateSlot.inspectorSink))
        let width = inspectorResolvedWidth(sink.content, context.viewportWidth)
        let pane = InspectorColumn().describe(context, modifiers)
        return CALayerDescription {
            layout: CALayoutIntent { widthFill: true, heightFill: true },
            sublayers: [
                CALayerDescription {
                    layout: CALayoutIntent {
                        widthFill: true,
                        heightFill: true,
                        paddingTrailing: width
                    },
                    sublayers: [move document]
                },
                CALayerDescription {
                    layout: CALayoutIntent {
                        widthFill: false,
                        heightFill: true,
                        fixedWidth: width,
                        offset: Point { x: context.viewportWidth - width }
                    },
                    sublayers: [move pane]
                }
            ]
        }
    }
}

extend Widget {
    // The inspector this view puts on the window's trailing edge, matching
    // SwiftUI's `.inspector(isPresented:)`. An inspector nobody asked for is not
    // built at all, and the columns beside it take the width back.
    function inspector(isPresented: Bool = true, content: some Widget) -> Any Widget {
        return InspectorLayer(isPresented: isPresented, content: content) {
            self
        }
    }
}

public construct InspectorLayer(isPresented: Bool = true, content: Any Widget) extends Widget {
    let subject: some Widget

    function isSection() -> Bool { return subject.isSection() }

    // Lowering remains a single traversal. A hidden inspector never lowers
    // its content and therefore never retains phantom actions or FocusState.
    function describe(
        context: borrow BuildContext,
        modifiers: borrow ModifierContext
    ) -> CALayerDescription {
        let described = subject.describe(context, modifierContextForChildren(modifiers))
        if isPresented {
            inspectorPresent(content.describe(context, modifierContextForChildren(modifiers)))
        }
        return described
    }
}
