import Foundation
import KiraGraphics
import KiraLayout
import KCoreAnimation

// The inspector: the column on the trailing edge of the window.
//
// It belongs to the WINDOW, exactly as the toolbar does, and for the same
// reason. SwiftUI spells it `.inspector(isPresented:) { … }` — a modifier on a
// view inside the scene, not a box the view packs beside its own content —
// because an inspector is a column of the window: it runs the window's height,
// it sits outside the document rather than inside it, and it is shown and hidden
// as a whole. A document that laid one out beside itself would be a document
// deciding the window's shape.
//
//     DocumentView()
//         .inspector(isPresented = workspace().hasSelection()) {
//             ItemInspector()
//         }
//
// The content is lowered where it is written — it reads the theme and the size
// class of the view that declared it — and the view travels up to the split
// view, which is the thing that owns the columns.

struct KiraUiInspectorSink {
    var collecting: Bool = false
}

function kiraUiInspectorSinkKey() -> String {
    return "kiraui.inspector.sink"
}

function kiraUiInspectorSinkEnsure() {
    if kiraUiStateSlotHas(kiraUiInspectorSinkKey()) == false {
        kiraUiStateSlotPut(
            kiraUiInspectorSinkKey(),
            nativeUserData(nativeState(KiraUiInspectorSink {}))
        )
    }
    return
}

// Opens collection for the window about to lower its columns, discarding what
// the last frame left.
function kiraUiInspectorCollect() {
    kiraUiInspectorSinkEnsure()
    var sink = nativeRecover<KiraUiInspectorSink>(kiraUiStateSlotGet(kiraUiInspectorSinkKey()))
    sink.collecting = true
    return
}

function kiraUiInspectorStopCollecting() {
    kiraUiInspectorSinkEnsure()
    var sink = nativeRecover<KiraUiInspectorSink>(kiraUiStateSlotGet(kiraUiInspectorSinkKey()))
    sink.collecting = false
    return
}

function kiraUiInspectorIsPresented() -> Bool {
    // Retained inspector presentation is a later stage; nothing is collected into
    // the sink on the describe path yet.
    return false
}

// The inspector column, as the window places it: the width the metrics table
// says an inspector is, the window's full height under the bar.
construct InspectorColumn() extends Widget {

    // The inspector column is filled from a sink that still holds
    // FoundationViews; its content migrates to descriptions when the inspector
    // sink does, so describe contributes the column's space for now.
    function describe(context: borrow BuildContext, modifiers: borrow ModifierContext) -> CALayerDescription {
        let ignored = context.frameCount
        return CALayerDescription {}
    }
}

extend Widget {
    // The inspector this view puts on the window's trailing edge, matching
    // SwiftUI's `.inspector(isPresented:)`. An inspector nobody asked for is not
    // built at all, and the columns beside it take the width back.
    function inspector(isPresented: Bool = true, content: some Widget) -> Any Widget {
        return InspectorLayer(isPresented: isPresented, content: content) {
            self
        }
    }
}

construct InspectorLayer(isPresented: Bool = true, content: Any Widget) extends Widget {
    let subject: some Widget


    // The inspector column is presented through a side channel that the retained
    // inspector stage drives; describe carries the subject through.
    function describe(context: borrow BuildContext, modifiers: borrow ModifierContext) -> CALayerDescription {
        return subject.describe(context, modifierContextForChildren(modifiers))
    }
}
