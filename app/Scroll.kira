import Foundation
import Ember
import KiraLayout
import KCoreAnimation

// Content taller than the room it has.
//
//     ScrollView {
//         VStack {
//             For(item in items) { Row(item = item) }
//         }
//     }
//
// The content is laid out at its full height and the view shows a window onto
// it, so nothing inside has to know it is being scrolled: a row is measured,
// drawn and clicked exactly as it would be in a column that fit.
//
// It moves as an iPad scroll view does, on UIKit's own curves: two fingers on
// a trackpad or one on the glass drag it, resisted past either end; let go
// fast enough it coasts and slows, and runs out past an end and is drawn back
// to it; a wheel's notches ease it a step at a time. While it moves, a thin
// bar along its trailing edge shows where in the content it is, swells under
// a pointer that comes onto it, and scrubs through the content when held and
// dragged; a second after it stops, the bar fades.
//
// Where it is scrolled to belongs to the view it is in, not to its place in
// the whole build: a scroll view is known by the page of a navigation stack
// it is on and which scroll view of that page it is, so a page pushed over it
// and popped again finds it where it was, and so does the page under a swipe
// back while the swipe is still deciding.
//
// The first scroll view on a stack's page is the page's own. It runs up under
// the bar, its content resting below it and passing beneath it as it scrolls,
// and once anything has gone under it lays the bar's hard edge effect down
// behind the bar's items. It carries the page's large title at the top of its
// content: the title goes up with the content, and as soon as it meets the
// bar it fades out while the bar's own title fades in, rising into place --
// and back again once it comes out.
public construct ScrollView(listLike: Bool = false) extends Widget {
    let content: some Widget

    function describe(
        context: borrow BuildContext,
        modifiers: borrow ModifierContext
    ) -> CALayerDescription {
        unsafe {
            let key = scrollIdentity()
            let indicatorKey = tapSeqKey()
            var page = scrollClaimPage()
            if !navigationBarUsesLargeTitle(modifiers.navigationBarTitleDisplayMode) {
                // An inline page never creates a title inside scrolling
                // content: the toolbar owns it at full opacity from the start.
                page.title = ""
            }
            // A presented search stands where the bar did, at the top of the
            // screen, and the page runs on under it without its large title.
            var presented = false
            match page.search {
                Some(search) -> {
                    if search.presented {
                        presented = true
                        page.title = ""
                        page.barInset = context.systemSafeArea.top + searchFieldMetrics().height
                    }
                }
                None -> {}
            }
            let document = content.describe(
                context,
                modifierContextApply(
                    modifierContextForChildren(modifiers),
                    ModifierDelta { entersScrollContent: true }
                )
            )

            // Recovered in place rather than through a helper: a recovered value
            // handed back out of a function is a copy, and the motion would be lost.
            let slot = scrollViewSlotKey(key)
            if !ambientStateHasView(slot) {
                ambientStatePutView(copy slot, nativeUserData(nativeState(ScrollViewState {})))
            }
            var scroll = nativeRecover<ScrollViewState>(ambientStateGetView(slot))
            scroll.keyboardDismissMode = resolvedScrollDismissesKeyboard(
                modifiers.scrollDismissesKeyboard, listLike
            )
            scroll.keyboardDismissEnabled = modifiers.scrollEnabled
            let bounds = MotionScrollBounds {
                contentLength: scroll.contentLength,
                viewportLength: scroll.viewportLength
            }
            // Measurement from the preceding frame is the earliest point at
            // which a scroll anchor can be resolved. Initialize only after
            // nonzero viewport measurement, and preserve the scroll position
            // across later content/viewport changes according to the role.
            scrollApplyDefaultAnchors(scroll, modifiers.scrollAnchors)
            scroll.motion.bounces = scrollBounces(
                modifiers.scrollBounceVertical, scroll.contentLength, scroll.viewportLength
            )
            let delta = clockDelta()
            let metrics = scrollIndicatorMetrics()
            // A flash is a scroll-view event, not an opacity modifier on its
            // content. Consume each inherited generation exactly once.
            let flash = consumeScrollIndicatorFlash(scroll, modifiers)
            if flash {
                scroll.still = 0.0
                clockStillMoving()
            }

            // What the fingers and the wheel did to it since the last frame, in the
            // order they did it.
            let input = scrollTake(key)
            if modifiers.scrollEnabled && input.began {
                motionScrollDragBegin(scroll.motion, 0.0, bounds, input.resistance, input.beganAt)
                scroll.dragHasMoved = false
            }
            if modifiers.scrollEnabled && input.moved {
                for report in input.reports {
                    motionScrollDragMove(scroll.motion, report.travel, bounds, report.time)
                    if report.travel != 0.0 { scroll.dragHasMoved = true }
                }
            }
            if modifiers.scrollEnabled && input.cancelled {
                scroll.motion.velocity = 0.0
            }
            if modifiers.scrollEnabled && (input.ended || input.cancelled) {
                motionScrollDragEnd(scroll.motion, bounds, prefersReducedMotion())
            }
            if modifiers.scrollEnabled && input.wheel != 0.0 {
                motionScrollWheel(scroll.motion, input.wheel, bounds)
            }
            if !modifiers.scrollEnabled {
                // Disable an already coasting/dragging scroll immediately. The
                // content stays where it was, but receives no new scroll input.
                scroll.motion.phase = .Idle
                scroll.motion.velocity = 0.0
                scroll.motion.offset = motionScrollClamp(scroll.motion.offset, bounds)
            }

            // Held, the bar scrubs: the content follows the pointer as far along
            // its whole length as the pointer goes along the track the bar runs
            // in, and let go it coasts on from however fast it was going.
            let track = max(scroll.viewportLength - page.barInset, 0.0)
            let length = scrollIndicatorLength(scroll.contentLength, track, metrics)
            let scrubbing = modifiers.scrollEnabled
                && context.heldControl == indicatorKey && indicatorKey != 0
            if scrubbing && !scroll.scrubbing {
                scroll.scrubFrom = scroll.motion.offset
                scroll.scrubPointer = context.pointerY
                motionScrollScrubBegin(scroll.motion)
                scroll.dragHasMoved = true
            }
            if !scrubbing && scroll.scrubbing {
                motionScrollScrubEnd(scroll.motion, bounds, prefersReducedMotion())
            }
            scroll.scrubbing = scrubbing
            if scrubbing && track > length {
                let reach = motionScrollMaxOffset(bounds) / (track - length)
                motionScrollScrub(
                    scroll.motion,
                    scroll.scrubFrom + (context.pointerY - scroll.scrubPointer) * reach,
                    bounds
                )
            }

            // Content that shrank under a surface at rest leaves it where the
            // content still reaches.
            if scroll.motion.phase == .Idle {
                scroll.motion.offset = motionScrollClamp(scroll.motion.offset, bounds)
            }
            let moving = motionScrollAdvance(scroll.motion, delta, bounds)
            scrollPhaseDidChange(scroll, modifiers.scrollPhaseHandlers)
            scrollGeometryDidChange(key, scroll, modifiers.scrollGeometryObservers)

            // The bar shows while the surface moves or a pointer is on it, and a
            // second after the last of either it fades.
            let hovered = context.hoveredKey == indicatorKey && indicatorKey != 0
            let scrollable = scroll.contentLength > scroll.viewportLength + 0.5
            if moving || scrubbing || (hovered && scroll.opacity > 0.0) {
                scroll.still = 0.0
            } else {
                scroll.still = scroll.still + delta
            }
            let indicatorAllowed = scrollIndicatorIsAllowed(
                modifiers.scrollIndicatorVisibility, modifiers.scrollIndicatorAxes
            )
            scroll.opacity = scrollable && indicatorAllowed ? (
                modifiers.scrollIndicatorVisibility == .Visible
                    && scrollIndicatorAffectsVertical(modifiers.scrollIndicatorAxes)
                    ? 1.0 : scrollIndicatorOpacity(scroll.still, metrics)
            ) : 0.0
            let expanded = (hovered || scrubbing) && scroll.opacity > 0.0
            let swelling = scrollIndicatorSwell(scroll, expanded, metrics, delta)
            let offset = scroll.motion.offset
            // The bar goes over to scrolled content all at once -- its edge effect
            // in, and the large title out for the bar's own -- as soon as the
            // content, or the large title leading it, meets the bar.
            let reach = page.title.count > 0 ? largeTitleMetrics().topInset : 0.0
            scroll.barFade = scrollFadeStep(scroll.barFade, page.barInset > 0.0 && offset > reach)
            if moving || scroll.opacity > 0.0 || swelling || scrollFading(scroll.barFade) {
                clockStillMoving()
            }
            let barShown = motionEase(.EaseInOut, scroll.barFade)
            // Collapse the title according to how far its actual header has
            // moved under the window bar. The edge wash may fade on a clock,
            // but title position must track the scroll, including when a user
            // slowly scrubs or reverses direction.
            let titleFace = modifierTypography(modifiers, .largeTitle)
            let titleShown = scrollLargeTitleProgress(
                offset,
                largeTitleMetrics().topInset,
                titleFace.lineHeight + largeTitleMetrics().bottomInset
            )

            let overshoot = motionScrollOvershoot(offset, bounds)
            let thickness = scroll.thickness
            let opacity = scroll.opacity

            var moved = move document
            var bar: [CALayerDescription] = []
            match page.search {
                Some(search) -> {
                    if presented {
                        bar.append(scrollSearchPresented(search, context, modifiers))
                    } else {
                        moved = scrollSearchDrawn(move moved, search, context, modifiers)
                    }
                }
                None -> {}
            }
            if page.title.count > 0 {
                if page.contentTitleHeader {
                    // Editable document headings already live inside `moved`.
                    // They scroll like every other body view; only their
                    // compact toolbar counterpart is managed by navigation.
                    toolbarCollapseLargeTitle(titleShown)
                } else {
                    moved = scrollLargeTitled(
                        move moved,
                        copy page.title,
                        titleShown,
                        page.search != .None,
                        context,
                        modifiers
                    )
                }
            }
            if page.barInset > 0.0 {
                moved = CALayerDescription {
                    layout: CALayoutIntent {
                        axis: .Column,
                        heightFill: false,
                        paddingTop: page.barInset
                    },
                    sublayers: [move moved]
                }
            }
            moved.layout.offset = Point {
                x: moved.layout.offset.x,
                y: moved.layout.offset.y - offset + scrollSmallContentAlignment(
                    scroll.contentLength, scroll.viewportLength,
                    modifiers.scrollAnchors.alignment
                )
            }
            // The surface moves its content itself, every frame.
            moved.disablesActions = true

            var indicator = scrollIndicator(
                indicatorKey,
                thickness,
                scrollIndicatorShownLength(length, overshoot, metrics),
                page.barInset + scrollIndicatorPosition(
                    offset,
                    bounds,
                    track,
                    length,
                    overshoot,
                    metrics
                ),
                opacity,
                modifiers
            )
            if !modifiers.scrollEnabled {
                indicator.hitKey = 0
                indicator.hittable = false
            }
            var layers = [CALayerDescription {
                hitKey: key,
                scrollAxis: .Column,
                acceptsScrollInput: modifiers.scrollEnabled,
                clipsChildren: !modifiers.scrollClipDisabled,
                sublayers: [move moved]
            }]
            if barShown > 0.0 && scrollTopEdgeEffectShows(modifiers) {
                layers.append(scrollEdgeEffect(page.barInset, barShown, modifiers))
            }
            // A hidden bar is not merely transparent: it has no hit region,
            // so its invisible scrub target cannot obstruct content controls.
            if indicatorAllowed {
                layers.append(move indicator)
            }
            for field in bar {
                layers.append(field)
            }
            return CALayerDescription {
                layout: CALayoutIntent { flex: 1, alignment: Point { x: 1.0, y: 0.0 } },
                sublayers: move layers
            }
        }
    }
}

// The page's large title over `document`, going up with it, faded out as far
// as the bar has gone over to its own title -- which `inline` is -- so it
// never shows through the bar. A search field under it hangs closer than
// content does.
public function scrollLargeTitled(
    document: CALayerDescription,
    title: String,
    inline: Number,
    searched: Bool,
    context: borrow BuildContext,
    modifiers: borrow ModifierContext,
) -> CALayerDescription {
    var heading = navigationLargeTitle(move title, context, modifiers)
    if searched {
        heading.layout.paddingBottom = searchFieldMetrics().titleSpacing
    }
    toolbarCollapseLargeTitle(inline)
    heading.opacity = 1.0 - inline
    heading.disablesActions = true
    return CALayerDescription {
        layout: CALayoutIntent { axis: .Column, heightFill: false },
        sublayers: [move heading, move document]
    }
}

// Zero at the resting large title, one after its full line and lower inset
// have passed into the toolbar. A positive continuous value during the travel
// lets both the large heading and compact window title share one transition.
// Reduced-motion mode switches at the boundary without a sliding fade.
public function scrollLargeTitleProgress(
    offset: Number,
    topInset: Number,
    travel: Number
) -> Number {
    let progress = min(max((offset - max(topInset, 0.0)) / max(travel, 1.0), 0.0), 1.0)
    if prefersReducedMotion() { return progress >= 1.0 ? 1.0 : 0.0 }
    return motionEase(.EaseInOut, progress)
}

// The page's search field over `document`, across the column, going up with
// it.
public function scrollSearchDrawn(
    document: CALayerDescription,
    search: borrow WindowSearch,
    context: borrow BuildContext,
    modifiers: borrow ModifierContext,
) -> CALayerDescription {
    let field = CALayerDescription {
        layout: CALayoutIntent {
            heightFill: false,
            paddingLeading: resolvedContentMargin(modifiers),
            paddingTrailing: resolvedContentMargin(modifiers)
        },
        sublayers: [pageSearchField(search, context, modifiers)]
    }
    return CALayerDescription {
        layout: CALayoutIntent { axis: .Column, heightFill: false },
        sublayers: [move field, move document]
    }
}

// The page's search field presented, standing at the top of the screen
// across the column, its cancel button after it.
public function scrollSearchPresented(
    search: borrow WindowSearch,
    context: borrow BuildContext,
    modifiers: borrow ModifierContext,
) -> CALayerDescription {
    let height = searchFieldMetrics().height
    var field = pageSearchField(search, context, modifiers)
    field.layout.flex = 1
    return CALayerDescription {
        layout: CALayoutIntent {
            axis: .Row,
            spacing: windowChromeMetrics().itemSpacing,
            heightFill: false,
            paddingTop: context.systemSafeArea.top,
            paddingLeading: resolvedContentMargin(modifiers),
            paddingTrailing: resolvedContentMargin(modifiers),
            alignment: Point { x: 0.0, y: 0.5 }
        },
        sublayers: [move field, searchCancelButton(search, height, context, modifiers)]
    }
}

// `fade` a frame further toward whole while `shown`, or toward nothing while
// not, at the fixed pace the bar goes over at.
public function scrollFadeStep(fade: Number, shown: Bool) -> Number {
    // An isolated view may be laid out before platform metrics have loaded.
    // A zero-duration fade is an immediate state change, not a divide by zero.
    let duration = largeTitleMetrics().fadeDuration
    if prefersReducedMotion() || duration <= 0.0 {
        return shown ? 1.0 : 0.0
    }
    let step = clockDelta() / duration
    return shown ? min(fade + step, 1.0) : max(fade - step, 0.0)
}

// Whether a fade is partway, and wants another frame.
public function scrollFading(fade: Number) -> Bool {
    return fade > 0.0 && fade < 1.0
}

// The system scroll-edge effect exists only where pinned window controls
// overlap scrolling content. Its default is the kit's hard, glass-backed
// boundary; an explicit soft effect distributes that same native blur over
// successive translucent bands without a separating hairline. Both stay
// outside the content's clipping/hit-test subtree and fade with the toolbar.
public function scrollEdgeEffect(
    height: Number,
    opacity: Number,
    modifiers: borrow ModifierContext
) -> CALayerDescription {
    let metrics = scrollEdgeMetrics()
    let appearance = modifierAppearance(modifiers)
    let wash = colorFromFoundation(
        modifierColor(
            foundationColor(themeAdaptiveColor(scrollEdgeFillColor, appearance)),
            modifiers
        )
    )
    let hairline = colorFromFoundation(
        modifierColor(
            foundationColor(themeAdaptiveColor(scrollEdgeBorderColor, appearance)),
            modifiers
        )
    )
    let radius = metrics.blurRadius
    if resolvedScrollEdgeEffectStyle(modifiers.scrollEdgeEffects.top) == .Soft {
        // Soft is a progressively weakening backdrop blur rather than a
        // solid, opaque bar. Keep the system's real glass sampling, divided
        // into strips from the strongly protected toolbar edge to the content.
        // Eight strips keep the step differences below typical display alpha
        // quantization after ease-out, without allocating a fragment shader.
        var faded: [CALayerDescription] = []
        let bands = 8
        let pitch = height / Number(bands)
        for index in 0..bands {
            let progress = (Number(index) + 0.5) / Number(bands)
            let strength = (1.0 - progress) * (1.0 - progress)
            faded.append(CALayerDescription {
                opacity: strength,
                disablesActions: true,
                capturesBackdrop: true,
                content: .Glass((CAGlass {
                    tint: wash,
                    sizing: CAGlassSizing {
                        blurRadius: CAGlassRamp {
                            base: radius, minimum: radius, maximum: radius
                        }
                    }
                }).edgeless()),
                layout: CALayoutIntent {
                    heightFill: false,
                    fixedHeight: pitch,
                    offset: Point { y: Number(index) * pitch }
                }
            })
        }
        return CALayerDescription {
            opacity: opacity,
            disablesActions: true,
            layout: CALayoutIntent {
                heightFill: false,
                fixedHeight: height,
                alignment: Point { x: 0.0, y: 0.0 }
            },
            sublayers: move faded
        }
    }
    return CALayerDescription {
        opacity: opacity,
        disablesActions: true,
        capturesBackdrop: true,
        content: .Glass(
            (
                CAGlass {
                    tint: wash,
                    sizing: CAGlassSizing {
                        blurRadius: CAGlassRamp { base: radius, minimum: radius, maximum: radius }
                    }
                }
            ).edgeless()
        ),
        layout: CALayoutIntent {
            heightFill: false,
            fixedHeight: height,
            alignment: Point { x: 0.0, y: 1.0 }
        },
        sublayers: [CALayerDescription {
            disablesActions: true,
            content: .Solid(CASolid { fill: hairline }),
            layout: CALayoutIntent { heightFill: false, fixedHeight: metrics.borderWidth }
        }]
    }
}

// Where one scroll view is: its motion, the content and window lengths
// layout last measured, its bar -- how long since anything moved it, how
// opaque and how thick it is, and the press scrubbing it -- and how far the
// window's bar over it has gone over to scrolled content: its edge effect in,
// its large title out.
public struct ScrollViewState {
    var motion: MotionScrollState = MotionScrollState {}
    var contentLength: Number = 0.0
    var viewportLength: Number = 0.0
    var viewportCrossLength: Number = 0.0
    var contentCrossLength: Number = 0.0
    var dragHasMoved: Bool = false
    var lastReportedPhase: ScrollPhase = .Idle
    var defaultAnchorInitialized: Bool = false
    var lastAnchoredContentLength: Number = 0.0
    var lastAnchoredViewportLength: Number = 0.0
    var still: Number = 1000000.0
    var lastFlashGeneration: Number = 0.0
    var keyboardDismissMode: ScrollDismissesKeyboardMode = .Interactively
    var keyboardDismissEnabled: Bool = true
    var opacity: Number = 0.0
    var thickness: Number = 0.0
    var thicknessVelocity: Number = 0.0
    var swell: MotionSpringState = MotionSpringState {}
    var scrubbing: Bool = false
    var scrubFrom: Number = 0.0
    var scrubPointer: Number = 0.0
    var barFade: Number = 0.0
}

// A scroll viewport's first *measured* frame, followed by changes to that
// viewport or its content. Regular user scrolling updates `motion.offset`
// directly; this function never pulls the view back to its default anchor on
// an otherwise unchanged frame. A drag or coast is not interrupted by a
// simultaneous layout change. Each ScrollView retains its own measurements.
public function scrollApplyDefaultAnchors(
    scroll: borrow mut ScrollViewState,
    anchors: borrow ScrollAnchorPreferences
) {
    if scroll.viewportLength <= 0.0 { return }
    let currentContent = scroll.contentLength
    let currentViewport = scroll.viewportLength
    if !scroll.defaultAnchorInitialized {
        scroll.defaultAnchorInitialized = true
        scroll.lastAnchoredContentLength = currentContent
        scroll.lastAnchoredViewportLength = currentViewport
        match anchors.initialOffset {
            Some(point) -> {
                scroll.motion.offset = scrollAnchoredOffset(
                    currentContent, currentViewport, .Some(point)
                )
                scroll.motion.velocity = 0.0
                scroll.motion.phase = .Idle
            }
            None -> {}
        }
        return
    }
    if scroll.lastAnchoredContentLength == currentContent
        && scroll.lastAnchoredViewportLength == currentViewport { return }
    if scroll.motion.phase == .Idle {
        scroll.motion.offset = scrollAnchorResizedOffset(
            scroll.motion.offset,
            scroll.lastAnchoredContentLength,
            scroll.lastAnchoredViewportLength,
            currentContent, currentViewport,
            anchors.sizeChanges
        )
    }
    scroll.lastAnchoredContentLength = currentContent
    scroll.lastAnchoredViewportLength = currentViewport
}

// One flash per version for each descendant scroll view, independent of its
// sibling scroll views and their content identities.
public function consumeScrollIndicatorFlash(
    scroll: borrow mut ScrollViewState,
    modifiers: borrow ModifierContext
) -> Bool {
    if !modifiers.scrollFlashEnabled { return false }
    if scroll.lastFlashGeneration == modifiers.scrollFlashGeneration { return false }
    scroll.lastFlashGeneration = modifiers.scrollFlashGeneration
    return true
}

public function scrollViewSlotKey(key: Number) -> ViewStateKey {
    return slotKey("kiraui.scroll.", key)
}

// Layout's answer for the scroll view under `key`: how long its content came
// out and how long the window onto it is. The motion reads it on the next
// frame.
public function scrollMeasured(
    key: Number,
    contentLength: Number,
    viewportLength: Number,
    contentCrossLength: Number = 0.0,
    viewportCrossLength: Number = 0.0
) {
    unsafe {
        if !ambientStateHasView(scrollViewSlotKey(key)) {
            return
        }
        var scroll = nativeRecover<ScrollViewState>(ambientStateGetView(scrollViewSlotKey(key)))
        scroll.contentLength = contentLength
        scroll.viewportLength = viewportLength
        scroll.contentCrossLength = contentCrossLength
        scroll.viewportCrossLength = viewportCrossLength
    }
}

// --- The scroll indicator ------------------------------------------------------
//
// UIKit's: as long against its track as the window is against the content,
// never shorter than its minimum, and as far along the track as the surface is
// through its range. Pulled past an end it stays at that end and is squeezed
// by however far past it the surface is.

public function scrollIndicatorLength(
    contentLength: Number,
    track: Number,
    metrics: borrow ScrollIndicatorMetrics
) -> Number {
    if contentLength <= 0.0 {
        return track
    }
    return min(max(round(track * track / contentLength), metrics.minimumLength), track)
}

public function scrollIndicatorShownLength(
    length: Number,
    overshoot: Number,
    metrics: borrow ScrollIndicatorMetrics
) -> Number {
    return max(length - abs(overshoot), metrics.overscrolledLength)
}

public function scrollIndicatorPosition(
    offset: Number,
    bounds: borrow MotionScrollBounds,
    track: Number,
    length: Number,
    overshoot: Number,
    metrics: borrow ScrollIndicatorMetrics,
) -> Number {
    if overshoot > 0.0 {
        return track - scrollIndicatorShownLength(length, overshoot, metrics)
    }
    let limit = motionScrollMaxOffset(bounds)
    if overshoot < 0.0 || limit <= 0.0 {
        return 0.0
    }
    return (track - length) * clamp(offset / limit, 0.0, 1.0)
}

// Opaque until its delay has passed since anything moved it, then fading, as
// UIKit's default curve eases, to nothing.
public function scrollIndicatorOpacity(
    still: Number,
    metrics: borrow ScrollIndicatorMetrics
) -> Number {
    if still < metrics.hideDelay {
        return 1.0
    }
    return 1.0 - motionEase(.EaseInOut, (still - metrics.hideDelay) / metrics.fadeDuration)
}

// Swells the bar to its held thickness, or thins it back, on the critically
// damped spring UIKit fits into each one's duration. Whether it is still
// changing.
public function scrollIndicatorSwell(
    scroll: borrow mut ScrollViewState,
    expanded: Bool,
    metrics: borrow ScrollIndicatorMetrics,
    delta: Number,
) -> Bool {
    let wanted = expanded ? metrics.expandedThickness : metrics.thickness
    if scroll.thickness == 0.0 {
        scroll.thickness = wanted
        scroll.swell = motionSpringStart(MotionSpring { target: wanted }, wanted, 0.0)
        return false
    }
    if scroll.swell.spring.target != wanted {
        let duration = expanded ? metrics.expandDuration : metrics.collapseDuration
        scroll.swell = motionSpringStart(
            MotionSpring {
                response: scrollIndicatorSpringResponse(duration),
                damping: 1.0,
                target: wanted
            },
            scroll.thickness,
            scroll.thicknessVelocity
        )
    }
    if scroll.thickness == wanted {
        return false
    }
    let sample = motionSpringAdvance(scroll.swell, delta)
    if motionSpringSettled(scroll.swell, sample, MotionSpringLimit.epsilon) {
        scroll.thickness = wanted
        scroll.thicknessVelocity = 0.0
        return false
    }
    scroll.thickness = sample.value
    scroll.thicknessVelocity = sample.velocity
    return true
}

// The response of the critically damped spring UIKit fits into a duration:
// one within a thousandth of home where ωt reaches 9.23.
public function scrollIndicatorSpringResponse(duration: Number) -> Number {
    return 6.283185307179586 * duration / 9.23
}

// The bar, `thickness` across and `length` along, `position` down its track,
// in a box that takes a pointer a little way beyond it on every side. It sits
// against the trailing edge, and swells inward from it.
public function scrollIndicator(
    key: Number,
    thickness: Number,
    length: Number,
    position: Number,
    opacity: Number,
    modifiers: borrow ModifierContext,
) -> CALayerDescription {
    let metrics = scrollIndicatorMetrics()
    let across = metrics.hitOutsetAcross
    let along = metrics.hitOutsetAlong
    let ink = colorFromFoundation(
        modifierColor(
            foundationColor(
                themeAdaptiveColor(scrollIndicatorColor, modifierAppearance(modifiers))
            ),
            modifiers
        )
    )
    return CALayerDescription {
        opacity: opacity,
        hittable: opacity > 0.0,
        hitKey: key,
        disablesActions: true,
        layout: CALayoutIntent {
            widthFill: false,
            heightFill: false,
            fixedWidth: thickness + across * 2.0,
            fixedHeight: length + along * 2.0,
            paddingLeading: across,
            paddingTop: along,
            paddingTrailing: across,
            paddingBottom: along,
            offset: Point { x: across, y: position - along }
        },
        sublayers: [CALayerDescription {
            disablesActions: true,
            content: .Solid(CASolid { fill: ink, cornerRadius: thickness * 0.5 })
        }]
    }
}

// --- Identity --------------------------------------------------------------------
//
// A scroll view is known by the scope it is built in -- a stack's page, by the
// path it belongs to and how deep on it the page is -- and by how many scroll
// views the scope has built before it. Outside any page the whole window is
// one scope. The numbers stand clear of every key the build mints.
