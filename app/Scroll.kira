import Foundation
import KiraGraphics
import KiraLayout
import KCoreAnimation

// Content taller than the room it has.
//
//     ScrollView {
//         VStack {
//             For(item in items) { Row(item = item) }
//         }
//     }
//
// The content is laid out at its full height and the view shows a window onto
// it, so nothing inside has to know it is being scrolled: a row is measured,
// drawn and clicked exactly as it would be in a column that fit.
//
// How far it is scrolled belongs to the foundation rather than to a `@State`
// here, because the two numbers that bound it — the content's height and the
// window's — are only known once layout has run, and a wheel that counts past
// the end of a list needs the same number of turns back before the list moves.
//
// The `key` is the application's, not a minted one, because where a list is
// scrolled to has to survive the tree above it changing: a minted key is a
// position in the build, so disclosing a folder in the panel above would
// renumber this one and the list would jump back to its top.
construct ScrollView(key: Int) extends Widget {
    let content: some Widget


    // A clipping, hittable window over the content; the scroll offset is applied
    // by the input/layout stage that reads the region's key.
    function describe(context: borrow BuildContext, modifiers: borrow ModifierContext) -> CALayerDescription {
        return CALayerDescription {
            hittable: true,
            hitKey: key,
            clipsChildren: true,
            sublayers: [content.describe(context, modifierContextForChildren(modifiers))]
        }
    }
}
