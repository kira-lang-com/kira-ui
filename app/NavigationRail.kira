import Foundation
import KCoreAnimation

// The fixed leading icon strip of a split navigation window. The rail is a
// peer of the sidebar, never a section inside its List, so its controls remain
// visible while the sidebar is hidden or independently scrolled.
//
//     NavigationSplitView {
//         Sidebar()
//     } rail: {
//         NavigationRail {
//             NavigationRailItem(title: "Chats", systemImage: .BubbleLeft,
//                                selected: true, action: openChats)
//         } bottom: {
//             AccountMenu()
//         }
//     } detail: {
//         Detail()
//     }
//
// Neither the rail nor its toolbar paints a separate background: the window
// composites one shared translucent macOS navigation material behind both.
// Individual navigation icons are not wrapped in Liquid Glass. Buttons use
// full-width hit regions on a common center axis.
public namespace NavigationRailMetrics {
    let width: Number = 64.0
    let itemHeight: Number = 44.0
    let iconSize: Number = 14.0
    let spacing: Number = 6.0
    let verticalInset: Number = 12.0
}

public construct NavigationRail(width: Number = NavigationRailMetrics.width) extends Widget {
    let content: [some Widget]
    let bottom: some Widget = EmptyView()

    function describe(
        context: borrow BuildContext,
        modifiers: borrow ModifierContext
    ) -> CALayerDescription {
        let strip = VStack(spacing: .None, alignment: .Center) {
            VStack(spacing: .Length(NavigationRailMetrics.spacing), alignment: .Center) {
                For(item in content) {
                    item
                }
            }
            Spacer()
            bottom
        }
        .edgePadding(EdgeSet.top, resolvedLength(NavigationRailMetrics.verticalInset))
        .edgePadding(EdgeSet.bottom, resolvedLength(NavigationRailMetrics.verticalInset))
        .frame(width: width, alignment: .Center)
        .frame(maxHeight: FrameLimit.Infinity)
        .describe(context, modifiers)

        return CALayerDescription {
            layout: CALayoutIntent {
                fixedWidth: width,
                heightFill: true
            },
            // A column is layout only: it must not cover the window behind it.
            sublayers: [strip]
        }
    }
}

public construct NavigationRailItem(
    title: String,
    systemImage: Symbol,
    selected: Bool = false,
    width: Number = NavigationRailMetrics.width,
    action: () -> Void
) extends Widget {
    body {
        Button(action: action) {
            ZStack(alignment: .Center) {
                Icon(symbol: systemImage)
                .font(size: resolvedLength(NavigationRailMetrics.iconSize))
                .foregroundColor(selected ? .Accent : .Secondary)
            }
            .frame(width: width,
                   height: NavigationRailMetrics.itemHeight,
                   alignment: .Center)
        }
        .buttonStyle(.Plain)
        .accessibilityLabel(title)
    }
}