import Foundation
import Ember
import KiraLayout
import KCoreAnimation

// Views that float FREE of what declared them.
//
// A menu, a submenu, a popover, a dialog. What they have in common is that none
// of them belong to the box they were written in: a submenu declared on the
// fourth row of a panel is not four rows tall and does not stop at the panel's
// edge, and a menu opened near the bottom of a window has to be allowed to stand
// over everything above it.
//
// Nothing in the widget layer could say that. A view is laid out inside its
// parent, clipped by its parent, and drawn in the order the tree walks — so
// "over everything, sized to itself, positioned where I say" had no spelling,
// and the way round it was to expand inline and grow the panel instead. That is
// a different interaction: it moves what is underneath, it cannot leave the
// panel, and the thing you opened ends up bounded by the thing you opened it
// from.
//
// # How a view escapes
//
// It is HOISTED. During the build an overlay declares itself here instead of
// lowering in place; the root then puts every one it collected into a
// canvas-sized stack after the application's own content. From layout's point of
// view they are simply the last children of the root, which is what buys all
// three properties at once and needs nothing new underneath:
//
//   * measured against the whole canvas rather than the declaring parent's box,
//     so they are the size they want to be;
//   * drawn after everything, and outside every clip the declaring parent
//     pushed, because they are no longer inside it;
//   * flattened last, and hit regions are picked LAST TO FIRST — so a press over
//     an overlay reaches the overlay and not the view it is covering.
//
// # Where it lands
//
// From the press. `foundationPressBounds…` is the rectangle of the region a
// click fired on, recorded just before the handler runs — so a control that
// opens something anchors it to ITSELF rather than to the cursor, and does it
// without any way to read its own resolved frame back. That is the whole reason
// a submenu can be placed exactly over the row that owns it on the very frame it
// opens, with no lag and nothing measured twice.

public namespace OverlayLevel {
    // The layer a surface floats on.
    let surface: Number = 0

    // The layer a submenu floats on: over the menu it came out of.
    let submenu: Number = 1

    // The layer an element in transit flies on: over every surface, including the
    // one it is on its way into.
    let transit: Number = 100

    // The z every overlay shares.
    //
    // One number, not a range. Ordering WITHIN an application's overlay is settled
    // by the order things were drawn into it, and ordering BETWEEN applications is
    // the compositor's -- so a second overlay z would be a third answer to a
    // question two layers already answer.
    let overlay: Number = 1
}

// One floating view: what to draw, and the rectangle it hangs from.
public struct Overlay {
    // The anchor, in canvas coordinates — the bounds of whatever opened this.
    var anchorX: Number = 0.0
    var anchorY: Number = 0.0
    var anchorW: Number = 0.0
    var anchorH: Number = 0.0
    // What draws over what. Higher is nearer.
    //
    // Presentation ORDER cannot answer this: a card is presented after the
    // element it contains, because lowering the card is what lowers the
    // element — so the thing that should be in front is always declared first.
    // An element in transit is above the surface it is traveling into, and
    // says so rather than hoping it was hoisted late enough.
    var z: Number = 0
    // The view, lowered.
    var content: CALayerDescription = CALayerDescription {}
    // Where it hangs under its anchor: how far below it, and where across it,
    // from 0 (the two leading edges together) to 1 (the two trailing edges).
    var spacing: Number = 0.0
    var alignment: Number = 0.0
    // The key a press anywhere off the view fires, zero when such a press
    // should reach whatever is underneath instead. A menu is dismissed this
    // way. The press is taken from `dismissTop` down: what stands above it
    // stays live while the view is out, as the menu bar does over its menu.
    var dismissKey: Number = 0
    var dismissTop: Number = 0.0
}

public struct OverlaySink {
    var overlays: [Overlay] = []
    var collecting: Bool = false
}

public function overlaySinkEnsure() {
    if !ambientStateHas(StateSlot.overlaySink) {
        ambientStatePut(StateSlot.overlaySink, nativeUserData(nativeState(OverlaySink {})))
    }
}

// Open collection for the frame about to be built, discarding the last one's.
// The tree is rebuilt every frame and what floats above it is rebuilt with it.
public function overlayCollect() {
    overlaySinkEnsure()
    var sink = nativeRecover<OverlaySink>(ambientStateGet(StateSlot.overlaySink))
    var empty: [Overlay] = []
    sink.overlays = move empty
    sink.collecting = true
}

public function overlayStopCollecting() {
    overlaySinkEnsure()
    var sink = nativeRecover<OverlaySink>(ambientStateGet(StateSlot.overlaySink))
    sink.collecting = false
}

// Hand a lowered view to the overlay layer, to be drawn over everything at the
// given anchor.
public function overlayPresent(overlay: Overlay) {
    overlaySinkEnsure()
    var sink = nativeRecover<OverlaySink>(ambientStateGet(StateSlot.overlaySink))
    if !sink.collecting {
        // Presented with no frame collecting: there is no root to hoist it to,
        // so it is dropped rather than held for whichever frame is built next.
        return
    }
    sink.overlays.append(move overlay)
}

public function overlaysThisFrame() -> [Overlay] {
    overlaySinkEnsure()
    let sink = nativeRecover<OverlaySink>(ambientStateGet(StateSlot.overlaySink))
    return copy sink.overlays
}

// The anchor a control that is opening something should use: the bounds of the
// region the press landed on, which is the control itself.
public function pressAnchor() -> Overlay {
    return Overlay {
        anchorX: foundationPressBoundsX(),
        anchorY: foundationPressBoundsY(),
        anchorW: foundationPressBoundsW(),
        anchorH: foundationPressBoundsH()
    }
}

// The application's content with everything that floats stacked over it.
//
// Absolute arrangement, because an overlay is placed at a point rather than laid
// out among siblings: each one is offset to its own anchor and takes its natural
// size there. The stack fills the canvas, so that offset is in canvas
// coordinates — the same ones the anchor was recorded in. An overlay is held
// inside the canvas by the margin a window keeps its chrome off its edges, or
// by its anchor where that sits nearer an edge.
//
// The content sits in the stack whether anything floats or not. The retained
// tree knows a layer by where it stands, so content that moved one level down
// whenever a menu opened would be a different tree each time: every layer in
// the window would be matched to another and animate into it.
public function overlayStack(
    content: CALayerDescription,
    overlays: [Overlay],
    width: Number,
    height: Number
) -> CALayerDescription {
    let margin = windowChromeMetrics().edgeInset
    var layers: [CALayerDescription] = []
    layers.append(move content)
    for i in overlayOrder(overlays) {
        if overlays[i].dismissKey != 0 {
            layers.append(
                CALayerDescription {
                    hittable: true,
                    hitKey: overlays[i].dismissKey,
                    layout: CALayoutIntent { offset: Point { x: 0.0, y: overlays[i].dismissTop } }
                }
            )
        }
        var floating = copy overlays[i].content
        let size = floating.measure(width - margin * 2.0)
        let x = overlays[i].anchorX + (overlays[i].anchorW - size.width) * overlays[i].alignment
        let y = overlays[i].anchorY + overlays[i].anchorH + overlays[i].spacing
        floating.layout.widthFill = false
        floating.layout.heightFill = false
        // The margin keeps it in from the window's edges, but never further in
        // than its anchor: a control that sits nearer the edge than the margin
        // has what it presents hung from it where it is, flush with it.
        let left = min(margin, overlays[i].anchorX)
        let top = min(margin, overlays[i].anchorY)
        let right = max(width - margin, overlays[i].anchorX + overlays[i].anchorW)
        let bottom = max(height - margin, overlays[i].anchorY + overlays[i].anchorH)
        floating.layout.offset = Point {
            x: min(max(x, left), right - size.width),
            y: min(max(y, top), bottom - size.height)
        }
        layers.append(move floating)
    }
    return CALayerDescription { sublayers: move layers }
}

// The order the overlays draw in: by level, nearest last, and in the order
// they were presented within a level.
public function overlayOrder(overlays: borrow [Overlay]) -> [Number] {
    var presented: [(Number, Number)] = []
    for (index, overlay) in overlays.enumerated() { presented.append((overlay.z, index)) }
    // The sort is stable, so a level keeps the order it was presented in.
    let ordered = presented.sorted({ a, b in return a.0 < b.0 })
    var order: [Number] = []
    for (level, index) in ordered { order.append(index) }
    return order
}
