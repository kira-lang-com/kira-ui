import Foundation
import KiraGraphics
import KiraUIFoundation


// Interactive widget app: `rootBuilder` runs EVERY frame, so widgets rebuilt from it observe
// current `@State` values (state lives in the ambient slot store, not in the widget values) and
// input-driven state writes appear on the next frame. The foundation's retained tree, incremental
// layout, and batched compositor absorb the per-frame rebuild cost.
//
// The builder returns a `KiraUIApp` (not a bare widget) because a function TYPE cannot carry
// `Any Widget` today; the app struct stores the existential widget value instead.
function kiraUiNoopEngineFrame(frame: borrow mut KiraGraphics.RenderFrame) {
    let ignored = frame.backend
    return
}

function RunWidgetInteractiveApp(
    title: String,
    width: Int,
    height: Int,
    rootBuilder: borrow () -> KiraUIApp,
    // Host hook: runs first every frame, before the UI pass — where a hosting engine ticks
    // and renders its offscreen viewport texture (shown via TextureViewport).
    engineFrame: borrow (borrow mut KiraGraphics.RenderFrame) -> Void = kiraUiNoopEngineFrame,
    showFpsOverlay: Bool = true,
    // See RunFoundationInteractiveApp: fixed-structure hosts (editor chrome) pass
    // false so resize-only frames skip the widget rebuild and reconcile.
    rebuildOnResize: Bool = true,
    // A window the desktop shows through: everything the widget tree does not
    // paint is a hole rather than a page, so a floating panel is the shape of
    // what it draws. Nothing in the tree changes — a widget cannot tell.
    transparent: Bool = false,
    // How opaque the whole window is composited, before its content.
    opacity: Float = 1.0,
    // Launch-time harness — capture, quit-after, input scripts — as a value
    // rather than environment variables. Passed straight through to the
    // foundation runner; default is unconfigured (environment as before).
    harness: KiraGraphics.HarnessConfig = KiraGraphics.HarnessConfig {},
) {
    let hostEngineFrame: borrow (borrow mut KiraGraphics.RenderFrame) -> Void = engineFrame
    let windowAwareEngineFrame: (borrow mut KiraGraphics.RenderFrame) -> Void = { frame in
        kiraUiConsumeWindowCommand(frame)
        hostEngineFrame(frame)
        return
    }
    RunFoundationInteractiveApp(move title, width, height, { context in
        // Auto-minted hit-area keys are build-sequence numbers, so the counter
        // starts over with every build: a tree whose keys drift frame to frame
        // is a tree the foundation reconciles as new regions every frame, and a
        // press landing on a region that no longer exists is a click nobody
        // gets. The application does not have to know that — it happens here,
        // once, for every interactive app.
        kiraUiTapSeqReset()
        // Surface targets are collected around the whole build, not around a
        // split view's columns, because an application that renders into
        // textures may have no window furniture at all: a component with no
        // window still has regions, and they are declared wherever they are.
        kiraUiSurfaceCollect()
        let build: borrow () -> KiraUIApp = rootBuilder
        let app = build()
        let root = app.content
        let lowered = root.lower(context, ModifierContext {})
        kiraUiSurfaceStopCollecting()
        return lowered
    },
        engineFrame: windowAwareEngineFrame,
        needsRebuild: foundationNoContinuousRebuild,
        showFpsOverlay: showFpsOverlay,
        showGraphicsHud: false,
        rebuildOnResize: rebuildOnResize,
        windowMode: .Windowed,
        transparent: transparent,
        opacity: opacity,
        harness: move harness,
        windowDragRegion: kiraUiToolbarWindowDragRegion
    )
    return
}

// The drawn width of a text run at a given size.
//
// Anything that has to be as wide as a piece of text — a rule under a heading, a
// measured underline, a hand-placed caret — otherwise ends up carrying a number
// somebody sampled off a mock, one per string, which stops being true the moment
// the text or the font changes.
function kiraUiTextWidth(content: borrow String, size: Float, weight: FontWeight = .Regular) -> Float {
    return foundationTextRunWidth(content, size, foundationFontWeight(weight))
}

// Text as its Unicode scalars, and back again.
//
// An app that edits text (a rename field, an inline label editor) works in
// codepoints rather than bytes so a caret index means one character. That is
// the same conversion `TextField` runs, and re-exporting it here is what lets an
// app do its own editing without naming the foundation package: KiraUI and
// KiraGraphics are the whole surface an app is meant to see.
function kiraUiStringToCodepoints(content: borrow String) -> [Int] {
    return foundationStringToCodepoints(content)
}

// The `[start, end)` slice of `codes` as a string. Out-of-range indices
// contribute nothing, so a caret range never has to be clamped first.
function kiraUiStringFromCodepoints(codes: borrow [Int], start: Int, end: Int) -> String {
    return foundationStringFromCodepoints(codes, start, end)
}

// Runs a KiraUI app, interactively.
//
// The block is a BUILDER, and it runs every frame — which is what makes the app
// respond to anything. A tree lowered once is a picture: `@State` lives in the
// ambient slot store, so a press that changes it changes nothing on screen until
// the widgets are built again from the new value. Lowering is `@Consuming`, so
// "again" means a fresh tree, so it means a builder rather than a value.
//
//     RunKiraApp {
//         KiraUIApp(
//             name: "Workspace",
//             content: WorkspaceHome().theme(Opacity())
//         )
//     }
//
// The brace is a zero-parameter closure — no `in` — because the parameter is a
// function type and that is what a brace means in that position.
function RunKiraApp(app: borrow () -> KiraUIApp) {
    let build: borrow () -> KiraUIApp = app
    RunFoundationInteractiveApp("Kira UI", 1280, 720, { context in
        kiraUiTapSeqReset()
        kiraUiSurfaceCollect()
        let made = build()
        let root = made.content
        let lowered = root.lower(context, ModifierContext {})
        kiraUiSurfaceStopCollecting()
        return lowered
    },
        engineFrame: kiraUiWindowEngineFrame,
        needsRebuild: foundationNoContinuousRebuild,
        showFpsOverlay: true,
        showGraphicsHud: false,
        rebuildOnResize: true,
        windowMode: .Windowed,
        transparent: false,
        opacity: 1.0,
        harness: KiraGraphics.HarnessConfig {},
        windowDragRegion: kiraUiToolbarWindowDragRegion
    )
    return
}

function kiraUiWindowEngineFrame(frame: borrow mut KiraGraphics.RenderFrame) {
    kiraUiConsumeWindowCommand(frame)
    return
}
