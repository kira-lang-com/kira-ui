import Foundation

// Sets the vertical gap between rows of List. A nil value restores the
// platform default; explicit zero removes any previously inherited spacing.
public function resolvedListRowSpacing(modifiers: borrow ModifierContext) -> Number {
    return match modifiers.listRowSpacing {
        Some(value) -> max(value, 0.0)
        None -> 0.0
    }
}

extend Widget {
    // SwiftUI: `.listRowSpacing(_ spacing: CGFloat?)`.
    function listRowSpacing(spacing: Number?) -> Any Widget {
        return ModifierDeltaLayer(delta: modifierDeltaListRowSpacing(move spacing)) { self }
    }
}