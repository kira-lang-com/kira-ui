// --- Switches, sliders and progress bars --------------------------------------

// A switch's capsule track and the knob held inside it, off its ends.
struct SwitchMetrics {
    let width: Float
    let height: Float
    let knobWidth: Float
    let knobInset: Float
}

let switchMetrics = SwitchMetrics {
    width: catalogMetric(kiraUICatalogStack, metricSwitchWidth()),
