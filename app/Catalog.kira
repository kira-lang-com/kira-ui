}

// How opaque a switch or slider stands while it is disabled.
let disabledControlOpacity = catalogMetric(kiraUICatalogStack, metricDisabledControlOpacity())

// A progress bar's track.
let progressTrackHeight = catalogMetric(kiraUICatalogStack, metricProgressTrackHeight())

// A switch's track on and off, the knob a switch and a slider share and the
// shadow a slider's knob casts, the wash in a held slider knob's glass, and the
// tracks under a slider's knob and a progress bar's fill.
let switchOn = catalogAdaptive(kiraUICatalogStack, "switchOn")
let switchOff = catalogAdaptive(kiraUICatalogStack, "switchOff")
let controlKnob = catalogAdaptive(kiraUICatalogStack, "controlKnob")
let knobShadow = catalogAdaptive(kiraUICatalogStack, "knobShadow")
let sliderTrack = catalogAdaptive(kiraUICatalogStack, "sliderTrack")
let sliderKnobGlass = catalogAdaptive(kiraUICatalogStack, "sliderKnobGlass")
let progressTrack = catalogAdaptive(kiraUICatalogStack, "progressTrack")

// The shadow a menu's card casts: its color, how far it blurs and how far below
// the card it falls.
let menuShadow = catalogAdaptive(kiraUICatalogStack, "menuShadow")
let menuShadowRadius = catalogMetric(kiraUICatalogStack, metricMenuShadowRadius())
let menuShadowOffset = catalogMetric(kiraUICatalogStack, metricMenuShadowOffset())

// --- Text fields --------------------------------------------------------------

// The insertion point a focused field draws in the accent.
struct CaretMetrics {
    let width: Float
    let height: Float
}

let caretMetrics = CaretMetrics {
    width: catalogMetric(kiraUICatalogStack, metricCaretWidth()),
    height: catalogMetric(kiraUICatalogStack, metricCaretHeight())
}
