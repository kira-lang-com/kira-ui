import Foundation
import KCoreUI

// Where the default style's values come from.
//
// Every colour and every text metric `DefaultStyle` ships is read out of a
// KCoreUI catalog rather than written as a literal here. Nothing about the
// `Theme` API changes: a widget still asks the theme for tokens, and a custom
// style that fills its own tokens still overrides them. What changed is where
// the numbers live.
//
// That is worth the indirection because a token literal is a value one theme
// can replace and nothing else can. A catalog entry is a value that varies by
// appearance, by contrast, by anything else in the environment, and that an
// application can override with a partial blob without touching a line of the
// toolkit.
//
// KiraUI ships the blob as its own package asset. The parsed stack below is a
// module constant, so every style reads the same catalog rather than reparsing
// it for each eager token group.

// The catalog in effect, read from disk.
//
// A file read and a parse per call, which is once per token set while the theme
// vocabulary still builds its tokens eagerly in field defaults. A program that
// draws frames loads a catalog once and keeps the `UIResources` it builds from
// it; that is where this is going, and what retires the eager token sets.
function loadKiraUICatalogStack() -> CatalogStack {
    attempt {
        let catalog = try loadDefaultCatalog()
        return catalogStackOf(catalog)
    } handle {
        NotKira { return CatalogStack() }
        UnsupportedVersion { return CatalogStack() }
        TruncatedHeader { return CatalogStack() }
        TruncatedTable { return CatalogStack() }
        OffsetOutOfRange { return CatalogStack() }
        NamesUnsorted { return CatalogStack() }
        ConstraintsUnsorted { return CatalogStack() }
        DuplicateRendition { return CatalogStack() }
        ReservedTraitValue { return CatalogStack() }
    }
}

let kiraUICatalogStack = loadKiraUICatalogStack()

// The trait vector the toolkit resolves against.
//
// Appearance comes through `resolvedAppearance`, which is still the one place
// the host override and the platform's own answer are reconciled. The rest is
// what this build can observe; a trait the toolkit cannot yet read stays at its
// default rather than being guessed.
function kiraUICatalogEnvironment(appearance: borrow Appearance) -> UIEnvironment {
    var environment = UIEnvironment()
    match appearance {
        Light -> { environment.appearance = .Light }
        Dark -> { environment.appearance = .Dark }
    }
    return environment
}

// KiraUI declares its own `Color`, distinct from the one a catalog answers
// with, so the channels are carried across by hand. Two identical declarations
// are two types, and that is the seam between them.
function catalogColorAt(stack: borrow CatalogStack, name: borrow String, appearance: borrow Appearance) -> Color {
    let resolved = resolveColor(stack, name, kiraUICatalogEnvironment(appearance))
    return Color {
        r: resolved.r,
        g: resolved.g,
        b: resolved.b,
        a: resolved.a
    }
}

// A catalog colour as the adaptive pair the style vocabulary is written in.
//
// The pair is what `AdaptiveColor` is, so this is the other seam: above it the
// toolkit's tokens are unchanged, below it the values are renditions selected
// by an environment. A catalog resource with more variants than these two still
// has them; this reads the two the theme vocabulary can hold.
function catalogAdaptive(stack: borrow CatalogStack, name: borrow String) -> AdaptiveColor {
    return AdaptiveColor {
        light: catalogColorAt(stack, name, .Light),
        dark: catalogColorAt(stack, name, .Dark)
    }
}

// A catalog text style as the toolkit's own font shape.
function catalogFont(stack: borrow CatalogStack, name: borrow String) -> FontImplementation {
    let resolved = resolveTypography(stack, name, kiraUICatalogEnvironment(.Light))
    return FontImplementation {
        size: resolved.value.size,
        weight: catalogFontWeight(resolved.value.weight),
        lineHeight: resolved.value.lineHeight,
        tracking: resolved.value.tracking
    }
}

// The numeric weight axis, which is what every shaper and every platform font
// API speaks, narrowed to the three weights the toolkit draws.
function catalogFontWeight(weight: Int) -> FontWeight {
    if weight >= 700 {
        return .Bold
    }
    if weight >= 600 {
        return .SemiBold
    }
    return .Regular
}

// A border is a catalog colour and a width the toolkit still owns. The width is
// a hairline's geometry rather than its appearance, and nothing in the
// environment changes it.
function catalogBorder(stack: borrow CatalogStack, name: borrow String, width: Float) -> BorderImplementation {
    return BorderImplementation {
        color: catalogAdaptive(stack, name),
        width: width
    }
}

// --- The default style's tokens --------------------------------------------

function catalogPaletteTokens() -> StylePaletteTokens {
    return StylePaletteTokens {
        red: catalogAdaptive(kiraUICatalogStack, colorSystemRed()),
        orange: catalogAdaptive(kiraUICatalogStack, colorSystemOrange()),
        yellow: catalogAdaptive(kiraUICatalogStack, colorSystemYellow()),
        green: catalogAdaptive(kiraUICatalogStack, colorSystemGreen()),
        mint: catalogAdaptive(kiraUICatalogStack, colorSystemMint()),
        teal: catalogAdaptive(kiraUICatalogStack, colorSystemTeal()),
        cyan: catalogAdaptive(kiraUICatalogStack, colorSystemCyan()),
        blue: catalogAdaptive(kiraUICatalogStack, colorSystemBlue()),
        indigo: catalogAdaptive(kiraUICatalogStack, colorSystemIndigo()),
        purple: catalogAdaptive(kiraUICatalogStack, colorSystemPurple()),
        pink: catalogAdaptive(kiraUICatalogStack, colorSystemPink()),
        brown: catalogAdaptive(kiraUICatalogStack, colorSystemBrown()),
        gray: catalogAdaptive(kiraUICatalogStack, colorSystemGray())
    }
}

function catalogForegroundTokens() -> StyleForegroundTokens {
    return StyleForegroundTokens {
        primary: catalogAdaptive(kiraUICatalogStack, colorLabel()),
        secondary: catalogAdaptive(kiraUICatalogStack, colorSecondaryLabel()),
        tertiary: catalogAdaptive(kiraUICatalogStack, colorTertiaryLabel()),
        quaternary: catalogAdaptive(kiraUICatalogStack, colorQuaternaryLabel()),
        // Ink that stays readable on a filled control. Apple names no such
        // colour, so the catalog carries it under a name of the toolkit's own
        // rather than the declared Apple surface growing an entry Apple has not
        // got.
        inverse: catalogAdaptive(kiraUICatalogStack, "inverseLabel")
    }
}

function catalogBackgroundTokens() -> StyleBackgroundTokens {
    return StyleBackgroundTokens {
        canvas: catalogAdaptive(kiraUICatalogStack, colorSystemBackground()),
        surface: catalogAdaptive(kiraUICatalogStack, colorSecondarySystemBackground()),
        raised: catalogAdaptive(kiraUICatalogStack, colorTertiarySystemBackground()),
        overlay: catalogAdaptive(kiraUICatalogStack, colorWindowBackground())
    }
}

function catalogFillTokens() -> StyleFillTokens {
    return StyleFillTokens {
        control: catalogAdaptive(kiraUICatalogStack, colorSystemFill()),
        hover: catalogAdaptive(kiraUICatalogStack, colorSecondarySystemFill()),
        selection: catalogAdaptive(kiraUICatalogStack, colorSelection())
    }
}

function catalogTintTokens() -> StyleTintTokens {
    return StyleTintTokens {
        accent: catalogAdaptive(kiraUICatalogStack, colorTint()),
        success: catalogAdaptive(kiraUICatalogStack, "success"),
        warning: catalogAdaptive(kiraUICatalogStack, "warning"),
        danger: catalogAdaptive(kiraUICatalogStack, "danger")
    }
}

function catalogBorderTokens() -> StyleBorderTokens {
    return StyleBorderTokens {
        none: catalogBorder(kiraUICatalogStack, colorSeparator(), 0.0),
        subtle: catalogBorder(kiraUICatalogStack, colorSeparator(), 1.0),
        standard: catalogBorder(kiraUICatalogStack, "standardBorder", 1.0),
        strong: catalogBorder(kiraUICatalogStack, "strongBorder", 1.5),
        focus: catalogBorder(kiraUICatalogStack, "focusRing", 2.0)
    }
}

function catalogTypographyTokens() -> StyleTypographyTokens {
    return StyleTypographyTokens {
        caption: catalogFont(kiraUICatalogStack, textCaption()),
        body: catalogFont(kiraUICatalogStack, textBody()),
        control: catalogFont(kiraUICatalogStack, "control"),
        title: catalogFont(kiraUICatalogStack, textTitle()),
        bodyEmphasis: catalogFont(kiraUICatalogStack, "bodyEmphasis"),
        subheadline: catalogFont(kiraUICatalogStack, textSubheadline()),
        footnote: catalogFont(kiraUICatalogStack, textFootnote()),
        overline: catalogFont(kiraUICatalogStack, "overline"),
        label: catalogFont(kiraUICatalogStack, "label"),
        section: catalogFont(kiraUICatalogStack, "section"),
        headline: catalogFont(kiraUICatalogStack, textHeadline()),
        title1: catalogFont(kiraUICatalogStack, "title1"),
        title2: catalogFont(kiraUICatalogStack, textTitle2()),
        title3: catalogFont(kiraUICatalogStack, textTitle3()),
        largeTitle: catalogFont(kiraUICatalogStack, textLargeTitle())
    }
}

// --- Window chrome ---------------------------------------------------------

// The lengths the window's chrome is laid out with, read once from the catalog.
//
// Every one is a catalog metric, so the bar is the platform's bar wherever the
// catalog has measured it and an application overrides a length with a partial
// blob rather than with code.
struct WindowChromeMetrics {
    let toolbarHeight: Float
    let itemHeight: Float
    let itemWidth: Float
    let groupSpacing: Float
    let groupInset: Float
    let itemSpacing: Float
    let spacerWidth: Float
    let edgeInset: Float
    let titleInset: Float
    let titleSpacing: Float
    let labelInset: Float
    let symbolSize: Float
    let symbolWeight: Float
    let controlsLeading: Float
    let controlDiameter: Float
    let controlSpacing: Float
    let controlsTrailing: Float
    let dividerThickness: Float

    // Where the bar's own content may start: past the close, minimise and zoom
    // buttons and the room the platform leaves after them.
    function controlsEnd() -> Float {
        return controlsLeading + controlDiameter * 3.0 + controlSpacing * 2.0 + controlsTrailing
    }
}

function catalogMetric(stack: borrow CatalogStack, name: borrow String) -> Float {
    return resolveMetric(stack, name, kiraUICatalogEnvironment(.Light)).points
}

function catalogWindowChromeMetrics() -> WindowChromeMetrics {
    return WindowChromeMetrics {
        toolbarHeight: catalogMetric(kiraUICatalogStack, metricToolbarHeight()),
        itemHeight: catalogMetric(kiraUICatalogStack, metricToolbarItemHeight()),
        itemWidth: catalogMetric(kiraUICatalogStack, metricToolbarItemWidth()),
        groupSpacing: catalogMetric(kiraUICatalogStack, metricToolbarGroupSpacing()),
        groupInset: catalogMetric(kiraUICatalogStack, metricToolbarGroupInset()),
        itemSpacing: catalogMetric(kiraUICatalogStack, metricToolbarItemSpacing()),
        spacerWidth: catalogMetric(kiraUICatalogStack, metricToolbarSpacerWidth()),
        edgeInset: catalogMetric(kiraUICatalogStack, metricToolbarEdgeInset()),
        titleInset: catalogMetric(kiraUICatalogStack, metricToolbarTitleInset()),
        titleSpacing: catalogMetric(kiraUICatalogStack, metricToolbarTitleSpacing()),
        labelInset: catalogMetric(kiraUICatalogStack, metricToolbarItemLabelInset()),
        symbolSize: catalogMetric(kiraUICatalogStack, metricToolbarSymbolSize()),
        symbolWeight: catalogMetric(kiraUICatalogStack, metricToolbarSymbolWeight()),
        controlsLeading: catalogMetric(kiraUICatalogStack, metricWindowControlsLeading()),
        controlDiameter: catalogMetric(kiraUICatalogStack, metricWindowControlDiameter()),
        controlSpacing: catalogMetric(kiraUICatalogStack, metricWindowControlSpacing()),
        controlsTrailing: catalogMetric(kiraUICatalogStack, metricWindowControlsTrailing()),
        dividerThickness: catalogMetric(kiraUICatalogStack, metricSplitDividerThickness())
    }
}

let windowChromeMetrics = catalogWindowChromeMetrics()

// The window title's typeface: a toolkit text style, since Apple names none.
let windowTitleFont = catalogFont(kiraUICatalogStack, "windowTitle")

// --- Sidebar ---------------------------------------------------------------

// The lengths a `List` in a split view's sidebar column is laid out with, all
// of them from the column's own edge: the section title's row, where its text
// starts and how far down, the rows and where their content starts, the
// selection band and its corner, and the column the glyph is centred in before
// the title.
struct SidebarMetrics {
    let headerHeight: Float
    let headerInset: Float
    let headerTopInset: Float
    let rowHeight: Float
    let rowInset: Float
    let selectionInset: Float
    let selectionRadius: Float
    let iconColumn: Float
    let titleSpacing: Float
    let symbolSize: Float
}

function catalogSidebarMetrics() -> SidebarMetrics {
    return SidebarMetrics {
        headerHeight: catalogMetric(kiraUICatalogStack, metricSidebarHeaderHeight()),
        headerInset: catalogMetric(kiraUICatalogStack, metricSidebarHeaderInset()),
        headerTopInset: catalogMetric(kiraUICatalogStack, metricSidebarHeaderTopInset()),
        rowHeight: catalogMetric(kiraUICatalogStack, metricSidebarRowHeight()),
        rowInset: catalogMetric(kiraUICatalogStack, metricSidebarRowInset()),
        selectionInset: catalogMetric(kiraUICatalogStack, metricSidebarSelectionInset()),
        selectionRadius: catalogMetric(kiraUICatalogStack, metricSidebarSelectionRadius()),
        iconColumn: catalogMetric(kiraUICatalogStack, metricSidebarIconColumn()),
        titleSpacing: catalogMetric(kiraUICatalogStack, metricSidebarTitleSpacing()),
        symbolSize: catalogMetric(kiraUICatalogStack, metricSidebarSymbolSize())
    }
}

let sidebarMetrics = catalogSidebarMetrics()

// The selected row's band: a wash over the column's glass, not the accent.
let sidebarSelection = catalogAdaptive(kiraUICatalogStack, "sidebarSelection")

// --- Inset grouped list ------------------------------------------------------

// The lengths `Form` and an inset grouped `List` are laid out with: the
// readable column and the gaps down it, the card and its rows, and the room
// around a header and a footer.
struct ListMetrics {
    let readableWidth: Float
    let sectionSpacing: Float
    let topInset: Float
    let cornerRadius: Float
    let rowHeight: Float
    let rowInset: Float
    let separatorThickness: Float
    let accessorySpacing: Float
    let headerPadding: Float
    let footerTopInset: Float
    let footerBottomInset: Float
}

function catalogListMetrics() -> ListMetrics {
    return ListMetrics {
        readableWidth: catalogMetric(kiraUICatalogStack, metricListReadableWidth()),
        sectionSpacing: catalogMetric(kiraUICatalogStack, metricListSectionSpacing()),
        topInset: catalogMetric(kiraUICatalogStack, metricListTopInset()),
        cornerRadius: catalogMetric(kiraUICatalogStack, metricListCornerRadius()),
        rowHeight: catalogMetric(kiraUICatalogStack, metricListRowHeight()),
        rowInset: catalogMetric(kiraUICatalogStack, metricListRowInset()),
        separatorThickness: catalogMetric(kiraUICatalogStack, metricListSeparatorThickness()),
        accessorySpacing: catalogMetric(kiraUICatalogStack, metricListAccessorySpacing()),
        headerPadding: catalogMetric(kiraUICatalogStack, metricListHeaderPadding()),
        footerTopInset: catalogMetric(kiraUICatalogStack, metricListFooterTopInset()),
        footerBottomInset: catalogMetric(kiraUICatalogStack, metricListFooterBottomInset())
    }
}

let listMetrics = catalogListMetrics()

// What a grouped list is painted with: the canvas the sections sit on, the
// card its rows share, and the hairline between two rows.
let groupedBackground = catalogAdaptive(kiraUICatalogStack, colorSystemGroupedBackground())
let groupedCardBackground = catalogAdaptive(kiraUICatalogStack, colorSecondarySystemGroupedBackground())
let listSeparator = catalogAdaptive(kiraUICatalogStack, colorSeparator())

// --- Large title -------------------------------------------------------------

// Where a column's large title sits under the bar, and the room it leaves
// before the content.
struct LargeTitleMetrics {
    let topInset: Float
    let bottomInset: Float
}

let largeTitleMetrics = LargeTitleMetrics {
    topInset: catalogMetric(kiraUICatalogStack, metricLargeTitleTopInset()),
    bottomInset: catalogMetric(kiraUICatalogStack, metricLargeTitleBottomInset())
}
