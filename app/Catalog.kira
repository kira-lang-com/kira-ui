struct LargeTitleMetrics {
    let topInset: Float
    let bottomInset: Float
}

let largeTitleMetrics = LargeTitleMetrics {
    topInset: catalogMetric(kiraUICatalogStack, metricLargeTitleTopInset()),
    bottomInset: catalogMetric(kiraUICatalogStack, metricLargeTitleBottomInset())
}

// How a stack moves between its views: the moving view's corner, how dark
// the view under it sits, and when a swipe back starts and goes
// through.
struct NavigationTransitionMetrics {
    let pageCornerRadius: Float
    let coveredDim: Float
    let coveredParallax: Float
    let commitFraction: Float
    let commitVelocity: Float
    let swipeSlop: Float
}

let navigationTransitionMetrics = NavigationTransitionMetrics {
    pageCornerRadius: catalogMetric(kiraUICatalogStack, metricNavigationPageCornerRadius()),
    coveredDim: catalogMetric(kiraUICatalogStack, metricNavigationCoveredDim()),
    coveredParallax: catalogMetric(kiraUICatalogStack, metricNavigationCoveredParallax()),
    commitFraction: catalogMetric(kiraUICatalogStack, metricNavigationSwipeCommitFraction()),
    commitVelocity: catalogMetric(kiraUICatalogStack, metricNavigationSwipeCommitVelocity()),
    swipeSlop: catalogMetric(kiraUICatalogStack, metricNavigationSwipeSlop())
}

// A bar's menu growing out of its button's glass and going home into it: the
// springs its width, height and fall ride each way and how hard the fall is
// launched, the spring it squares off on and how far along it starts, when it
// shows its rows and how magnified they arrive, and when the button's glyph
// goes and comes back.
struct MenuMorphMetrics {
    let growthResponse: Float
    let growthDamping: Float
    let heightResponse: Float
    let heightDamping: Float
    let dropResponse: Float
    let dropDamping: Float
    let dropLaunch: Float
    let closeResponse: Float
    let closeDamping: Float
    let closeHeightResponse: Float
    let closeHeightDamping: Float
    let sinkResponse: Float
    let sinkDamping: Float
    let sinkLaunch: Float
    let cornerResponse: Float
    let roundness: Float
    let contentOpen: Float
    let contentClose: Float
    let contentZoom: Float
    let contentBlur: Float
    let glyphGone: Float
    let glyphReturn: Float
}

let menuMorphMetrics = MenuMorphMetrics {
    growthResponse: catalogMetric(kiraUICatalogStack, metricMenuMorphGrowthResponse()),
    growthDamping: catalogMetric(kiraUICatalogStack, metricMenuMorphGrowthDamping()),
    heightResponse: catalogMetric(kiraUICatalogStack, metricMenuMorphHeightResponse()),
    heightDamping: catalogMetric(kiraUICatalogStack, metricMenuMorphHeightDamping()),
    dropResponse: catalogMetric(kiraUICatalogStack, metricMenuMorphDropResponse()),
    dropDamping: catalogMetric(kiraUICatalogStack, metricMenuMorphDropDamping()),
    dropLaunch: catalogMetric(kiraUICatalogStack, metricMenuMorphDropLaunch()),
    closeResponse: catalogMetric(kiraUICatalogStack, metricMenuMorphCloseResponse()),
    closeDamping: catalogMetric(kiraUICatalogStack, metricMenuMorphCloseDamping()),
    closeHeightResponse: catalogMetric(kiraUICatalogStack, metricMenuMorphCloseHeightResponse()),
    closeHeightDamping: catalogMetric(kiraUICatalogStack, metricMenuMorphCloseHeightDamping()),
    sinkResponse: catalogMetric(kiraUICatalogStack, metricMenuMorphSinkResponse()),
    sinkDamping: catalogMetric(kiraUICatalogStack, metricMenuMorphSinkDamping()),
    sinkLaunch: catalogMetric(kiraUICatalogStack, metricMenuMorphSinkLaunch()),
    cornerResponse: catalogMetric(kiraUICatalogStack, metricMenuMorphCornerResponse()),
    roundness: catalogMetric(kiraUICatalogStack, metricMenuMorphRoundness()),
    contentOpen: catalogMetric(kiraUICatalogStack, metricMenuMorphContentOpen()),
    contentClose: catalogMetric(kiraUICatalogStack, metricMenuMorphContentClose()),
    contentZoom: catalogMetric(kiraUICatalogStack, metricMenuMorphContentZoom()),
    contentBlur: catalogMetric(kiraUICatalogStack, metricMenuMorphContentBlur()),
    glyphGone: catalogMetric(kiraUICatalogStack, metricMenuMorphGlyphGone()),
    glyphReturn: catalogMetric(kiraUICatalogStack, metricMenuMorphGlyphReturn())
}

// A submenu coming out of its row over the menu it is in: the springs its card
// grows and shrinks on; how the menu behind it falls back -- how far, how dim,
// after how long, and on which springs, going and coming back; where the
// header sits in the card; and at what point of the growth the chevron has
// turned, the glass shows and goes, and the items show and go.
struct MenuSubmenuMetrics {
    let openResponse: Float
    let openDamping: Float
    let closeResponse: Float
    let closeDamping: Float
    let recededOpacity: Float
    let recedeScale: Float
    let recedeHold: Float
