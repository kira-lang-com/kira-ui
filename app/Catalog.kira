    headerCenter: catalogMetric(kiraUICatalogStack, metricMenuSubmenuHeaderCenter()),
    chevronTurn: catalogMetric(kiraUICatalogStack, metricMenuSubmenuChevronTurn()),
    cardAppear: catalogMetric(kiraUICatalogStack, metricMenuSubmenuCardAppear()),
