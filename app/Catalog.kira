struct SliderMetrics {
    let height: Float
    let trackHeight: Float
    let knobWidth: Float
    let knobHeight: Float
    // How far in from either end of the track the knob's center stops.
    let knobInset: Float
    let heldKnobWidth: Float
    let heldKnobHeight: Float
    let knobShadowRadius: Float
    let knobShadowOffset: Float
    let knobContactShadowRadius: Float
    let knobContactShadowOffset: Float
}

let sliderMetrics = SliderMetrics {
    height: catalogMetric(kiraUICatalogStack, metricSliderHeight()),
    trackHeight: catalogMetric(kiraUICatalogStack, metricSliderTrackHeight()),
