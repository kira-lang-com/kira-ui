import Foundation
import KCoreUI

// Where the default style's values come from.
//
// Every color and every text metric `DefaultStyle` ships is read out of a
// KCoreUI catalog rather than written as a literal here. Nothing about the
// `Theme` API changes: a widget still asks the theme for tokens, and a custom
// style that fills its own tokens still overrides them. What changed is where
// the numbers live.
//
// That is worth the indirection because a token literal is a value one theme
// can replace and nothing else can. A catalog entry is a value that varies by
// appearance, by contrast, by anything else in the environment, and that an
// application can override with a partial blob without touching a line of the
// toolkit.
//
// KiraUI ships the blob as its own package asset. The parsed stack below is a
// module constant, and so is every token group read out of it: a theme is
// built wherever a widget asks for one, many times a frame, and each build
// reading its colors out of the catalog again was nearly all of a frame.

// The catalog in effect, read from disk, once. When it does not load, the
// program draws with the empty stack: every color and text size reads as zero,
// so text is set at size 0 and lays out to nothing. The fault says why.
public function loadKiraUICatalogStack() -> CatalogStack {
    match loadDefaultCatalog() {
        Ok(catalog) -> return catalogStackOf(catalog)
        Error(failure) -> {
            log fault("the default catalog did not load; every color and text size reads as zero", path: defaultCatalogPath(), failure)
            return CatalogStack()
        }
    }
}

public let kiraUICatalogStack = loadKiraUICatalogStack()

// The trait vector the toolkit resolves against.
//
// Appearance comes through `resolvedAppearance`, which is still the one place
// the host override and the platform's own answer are reconciled. The idiom is
// the interface mode's: the desktop's, or a tablet's, whose kit the catalog's
// floor is read off. The rest is what this build can observe; a trait the
// toolkit cannot yet read stays at its default rather than being guessed.
public function kiraUICatalogEnvironment(appearance: borrow Appearance, mode: borrow InterfaceMode) -> UIEnvironment {
    var environment = UIEnvironment()
    match appearance {
        Light -> { environment.appearance = .Light }
        Dark -> { environment.appearance = .Dark }
    }
    match mode {
        AdaptiveDesktop -> { environment.idiom = .Desktop }
        AdaptiveMobile -> { environment.idiom = .Pad }
    }
    return environment
}

// KiraUI declares its own `Color`, distinct from the one a catalog answers
// with, so the channels are carried across by hand. Two identical declarations
// are two types, and that is the seam between them.
//
// A mode sizes an interface and does not paint it, so a color is read once, in
// the mode the program starts in.
public function catalogColorAt(stack: borrow CatalogStack, name: borrow String, appearance: borrow Appearance) -> Color {
    let resolved = resolveColor(stack, name, kiraUICatalogEnvironment(appearance, hostInterfaceMode()))
    return Color {
        r: resolved.r,
        g: resolved.g,
        b: resolved.b,
        a: resolved.a
    }
}

// A catalog color as the adaptive pair the style vocabulary is written in.
//
// The pair is what `AdaptiveColor` is, so this is the other seam: above it the
// toolkit's tokens are unchanged, below it the values are renditions selected
// by an environment. A catalog resource with more variants than these two still
// has them; this reads the two the theme vocabulary can hold.
public function catalogAdaptive(stack: borrow CatalogStack, name: borrow String) -> AdaptiveColor {
    return AdaptiveColor {
        light: catalogColorAt(stack, name, .Light),
        dark: catalogColorAt(stack, name, .Dark)
    }
}

// A catalog text style as the toolkit's own font shape, at `mode`'s size.
public function catalogFont(stack: borrow CatalogStack, name: borrow String, mode: borrow InterfaceMode) -> FontImplementation {
    let resolved = resolveTypography(stack, name, kiraUICatalogEnvironment(.Light, mode))
    return FontImplementation {
        size: resolved.value.size,
        weight: catalogFontWeight(resolved.value.weight),
        lineHeight: resolved.value.lineHeight,
        tracking: resolved.value.tracking
    }
}

// The numeric weight axis, which is what every shaper and every platform font
// API speaks, narrowed to the three weights the toolkit draws.
public function catalogFontWeight(weight: Int) -> FontWeight {
    if weight >= 700 {
        return .Bold
    }
    if weight >= 600 {
        return .SemiBold
    }
    return .Regular
}

// A border is a catalog color and a width the toolkit still owns. The width is
// a hairline's geometry rather than its appearance, and nothing in the
// environment changes it.
public function catalogBorder(stack: borrow CatalogStack, name: borrow String, width: Float) -> BorderImplementation {
    return BorderImplementation {
        color: catalogAdaptive(stack, name),
        width: width
    }
}

// --- The default style's tokens --------------------------------------------

public function catalogPaletteTokens() -> StylePaletteTokens {
    return StylePaletteTokens {
        red: catalogAdaptive(kiraUICatalogStack, colorSystemRed()),
        orange: catalogAdaptive(kiraUICatalogStack, colorSystemOrange()),
        yellow: catalogAdaptive(kiraUICatalogStack, colorSystemYellow()),
        green: catalogAdaptive(kiraUICatalogStack, colorSystemGreen()),
        mint: catalogAdaptive(kiraUICatalogStack, colorSystemMint()),
        teal: catalogAdaptive(kiraUICatalogStack, colorSystemTeal()),
        cyan: catalogAdaptive(kiraUICatalogStack, colorSystemCyan()),
        blue: catalogAdaptive(kiraUICatalogStack, colorSystemBlue()),
        indigo: catalogAdaptive(kiraUICatalogStack, colorSystemIndigo()),
        purple: catalogAdaptive(kiraUICatalogStack, colorSystemPurple()),
        pink: catalogAdaptive(kiraUICatalogStack, colorSystemPink()),
        brown: catalogAdaptive(kiraUICatalogStack, colorSystemBrown()),
        gray: catalogAdaptive(kiraUICatalogStack, colorSystemGray())
    }
}

public function catalogForegroundTokens() -> StyleForegroundTokens {
    return StyleForegroundTokens {
        primary: catalogAdaptive(kiraUICatalogStack, colorLabel()),
        secondary: catalogAdaptive(kiraUICatalogStack, colorSecondaryLabel()),
        tertiary: catalogAdaptive(kiraUICatalogStack, colorTertiaryLabel()),
        quaternary: catalogAdaptive(kiraUICatalogStack, colorQuaternaryLabel()),
        // Ink that stays readable on a filled control. Apple names no such
        // color, so the catalog carries it under a name of the toolkit's own
        // rather than the declared Apple surface growing an entry Apple has not
        // got.
        inverse: catalogAdaptive(kiraUICatalogStack, "inverseLabel")
    }
}

public function catalogBackgroundTokens() -> StyleBackgroundTokens {
    return StyleBackgroundTokens {
        canvas: catalogAdaptive(kiraUICatalogStack, colorSystemBackground()),
        surface: catalogAdaptive(kiraUICatalogStack, colorSecondarySystemBackground()),
        raised: catalogAdaptive(kiraUICatalogStack, colorTertiarySystemBackground()),
        overlay: catalogAdaptive(kiraUICatalogStack, colorWindowBackground())
    }
}

public function catalogFillTokens() -> StyleFillTokens {
    return StyleFillTokens {
        control: catalogAdaptive(kiraUICatalogStack, colorSystemFill()),
        hover: catalogAdaptive(kiraUICatalogStack, colorSecondarySystemFill()),
        selection: catalogAdaptive(kiraUICatalogStack, colorSelection())
    }
}

public function catalogTintTokens() -> StyleTintTokens {
    return StyleTintTokens {
        accent: catalogAdaptive(kiraUICatalogStack, colorTint()),
        success: catalogAdaptive(kiraUICatalogStack, "success"),
        warning: catalogAdaptive(kiraUICatalogStack, "warning"),
        danger: catalogAdaptive(kiraUICatalogStack, "danger")
    }
}

public function catalogBorderTokens() -> StyleBorderTokens {
    return StyleBorderTokens {
        none: catalogBorder(kiraUICatalogStack, colorSeparator(), 0.0),
        subtle: catalogBorder(kiraUICatalogStack, colorSeparator(), 1.0),
        standard: catalogBorder(kiraUICatalogStack, "standardBorder", 1.0),
        strong: catalogBorder(kiraUICatalogStack, "strongBorder", 1.5),
        focus: catalogBorder(kiraUICatalogStack, "focusRing", 2.0)
    }
}

public function catalogTypographyTokens(mode: InterfaceMode) -> StyleTypographyTokens {
    return StyleTypographyTokens {
        caption: catalogFont(kiraUICatalogStack, textCaption(), mode),
        caption2: catalogFont(kiraUICatalogStack, textCaption2(), mode),
        callout: catalogFont(kiraUICatalogStack, textCallout(), mode),
        body: catalogFont(kiraUICatalogStack, textBody(), mode),
        control: catalogFont(kiraUICatalogStack, "control", mode),
        title: catalogFont(kiraUICatalogStack, textTitle(), mode),
        bodyEmphasis: catalogFont(kiraUICatalogStack, "bodyEmphasis", mode),
        subheadline: catalogFont(kiraUICatalogStack, textSubheadline(), mode),
        footnote: catalogFont(kiraUICatalogStack, textFootnote(), mode),
        overline: catalogFont(kiraUICatalogStack, "overline", mode),
        label: catalogFont(kiraUICatalogStack, "label", mode),
        section: catalogFont(kiraUICatalogStack, "section", mode),
        headline: catalogFont(kiraUICatalogStack, textHeadline(), mode),
        title1: catalogFont(kiraUICatalogStack, "title1", mode),
        title2: catalogFont(kiraUICatalogStack, textTitle2(), mode),
        title3: catalogFont(kiraUICatalogStack, textTitle3(), mode),
        largeTitle: catalogFont(kiraUICatalogStack, textLargeTitle(), mode)
    }
}

// The default style's token groups, each read out of the catalog once.
public let catalogPalette = catalogPaletteTokens()
public let catalogForegrounds = catalogForegroundTokens()
public let catalogBackgrounds = catalogBackgroundTokens()
public let catalogFills = catalogFillTokens()
public let catalogTints = catalogTintTokens()
public let catalogBorders = catalogBorderTokens()

// The text styles at each size, each read out of the catalog once.
let desktopTypography = catalogTypographyTokens(.AdaptiveDesktop)
let mobileTypography = catalogTypographyTokens(.AdaptiveMobile)

// The default style's text styles, at the size the interface is drawn at.
public function catalogTypography() -> StyleTypographyTokens {
    return interfaceMode() == .AdaptiveDesktop ? desktopTypography : mobileTypography
}

// A length the catalog states, at `mode`'s size.
public function catalogMetric(stack: borrow CatalogStack, name: borrow String, mode: borrow InterfaceMode) -> Float {
    return resolveMetric(stack, name, kiraUICatalogEnvironment(.Light, mode)).points
}
