import Foundation
import KCoreAnimation

extend Widget {
    // SwiftUI's `onLongTouchGesture(minimumDuration:perform:onTouchingChanged:)`.
    // Unlike tap, recognition happens while the pointer is held down. The
    // contact-state callback is emitted for down, release and cancellation.
    function onLongTouchGesture(
        minimumDuration: Number = 0.5,
        action: () -> Void,
        onTouchingChanged: (Bool) -> Void = layerNoopFlag
    ) -> Any Widget {
        return LongPressGestureLayer(
            minimumDuration: minimumDuration,
            maximumDistance: 10.0,
            action: action,
            touchingChanged: onTouchingChanged
        ) { self }
    }
}