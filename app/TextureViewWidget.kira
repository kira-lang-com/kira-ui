import KiraLayout
import Foundation
import KiraUIFoundation

// The editor-viewport widget: shows an external KiraGraphics texture (an offscreen render
// target the engine draws into) inside the widget tree, filling whatever box the layout
// gives it. One external texture is supported per frame (the compositor's slot-1 binding).
Widget TextureViewport(texture: Int) {
    function lower(context: borrow KiraUIFoundation.FoundationUiContext, modifiers: borrow ModifierContext) -> KiraUIFoundation.FoundationView {
        let ignored = context.frameCount
        return KiraUIFoundation.TextureView(
            texture: texture,
            width: KiraUIFoundation.SizeMode.Fill,
            height: KiraUIFoundation.SizeMode.Fill,
            flex: 1,
            opacity: modifiers.opacity,
            radius: 0.0
        )
    }
}
