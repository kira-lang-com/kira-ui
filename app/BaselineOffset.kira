import Foundation
import KCoreAnimation

// SwiftUI baselineOffset is inherited by Text and expands the glyph's view
// bounds in the direction of the displacement; the enclosing stack measures
// that expansion rather than letting shifted glyphs intrude into adjacent
// content. Positive values raise the run, negative values lower it.
public function modifierDeltaBaselineOffset(value: Number) -> ModifierDelta {
    return ModifierDelta { hasBaselineOffset: true, baselineOffset: value }
}

extend Widget {
    // SwiftUI: `.baselineOffset(_ baselineOffset: CGFloat)`.
    function baselineOffset(value: Number) -> Any Widget {
        return ModifierDeltaLayer(delta: modifierDeltaBaselineOffset(value)) { self }
    }
}