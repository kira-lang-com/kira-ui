import KiraGraphics
import Foundation
import KCoreAnimation
import KiraLayout

// The shape a container is drawn in, stated AT THE POINT OF USE:
//
//     content.background(.Frosted, in: .RoundedRect(12.0))
//     content.glassEffect(in: .Capsule)
//
// which is why SwiftUI has no panel widget to wrap something in. The material
// and the shape are two arguments to a modifier on the content itself, so the
// same content is a plain box in one place and a glass capsule in another
// without a second container type having to exist for the second case. A
// container widget forces the opposite: every combination it does not take an
// argument for is a container someone has to add.
//
// These are SwiftUI's shape shorthands — `.rect`, `.rect(cornerRadius:)`,
// `.capsule`, `.circle`. `.Radius` is the one addition, and it is here because
// KiraUI's themes carry a corner-radius scale: a container that names `.Medium`
// follows the theme where a literal 12 stops following it.
enum ContainerShape {
    Rect
    RoundedRect(Float)
    Radius(CornerRadius)
    Capsule
    Circle
    // A CONTINUOUS corner: the curvature runs into the straight edges instead of
    // meeting them where a circular arc's second derivative jumps. It is most of
    // why a platform menu or a sheet reads as expensive, and it is not a corner
    // radius that has been rounded harder — it is a different curve. So it is
    // its own case rather than a flag on `RoundedRect`.
    Squircle(Float)
}

// A capsule is a rounded rect whose radius no box can reach, so one number
// answers for both and the renderer needs no separate case.
function containerShapeUnbounded() -> Float {
    return infinity
}

function containerShapeRadius(shape: ContainerShape, modifiers: borrow ModifierContext) -> Float {
    match shape {
        Rect -> return 0.0
        RoundedRect(value) -> return value
        Radius(style) -> return cornerRadiusImplementation(move style, modifiers)
        Capsule -> return containerShapeUnbounded()
        Circle -> return containerShapeUnbounded()
        Squircle(value) -> return value
    }
}

// Which corner curve the surface is drawn with. Every shape but the squircle is
// a circular arc.
function containerShapeSurfaceShape(shape: borrow ContainerShape) -> FoundationShape {
    match shape {
        Squircle(value) -> return foundationShape(.Squircle)
        Rect -> return foundationShape(.RegularRoundedRect)
        RoundedRect(value) -> return foundationShape(.RegularRoundedRect)
        Radius(style) -> return foundationShape(.RegularRoundedRect)
        Capsule -> return foundationShape(.RegularRoundedRect)
        Circle -> return foundationShape(.RegularRoundedRect)
    }
}

// What `.background(_:in:)` and `.glassEffect(in:)` both lower to: one surface
// painted BEHIND the content, taking the footprint the content already resolved
// to rather than a footprint of its own. That is the whole difference from a
// container — a background never moves what it is behind.
construct SurfaceLayer(style: Material, shape: ContainerShape) extends Widget {
    let content: some Widget


    // A material surface wrapping the content: a filled, clipping layer with the
    // content as its sublayer. Liquid Glass describes a `CAContent.Glass` layer —
    // the compositor captures the backdrop behind it, blurs it and refracts it
    // through the surface; every other material fills flat.
    function describe(context: borrow BuildContext, modifiers: borrow ModifierContext) -> CALayerDescription {
        let radius = containerShapeRadius(shape, modifiers)
        if style == .LayeredGlass {
            return CALayerDescription {
                cornerRadius: radius,
                clipsChildren: true,
                capturesBackdrop: true,
                content: .Glass(CAGlass {
                    blur: 1.0,
                    edgeRefraction: 1.0,
                    tint: caColorFromFoundation(modifierTokens(modifiers).glassTint),
                    material: CAGlassMaterial {},
                    shapeKind: surfaceLayerGlassShapeKind(shape)
                }),
                sublayers: [content.describe(context, modifierContextForChildren(modifiers))]
            }
        }
        var borderWidth = 1.0
        if modifiers.hasThemeBorder == false {
            borderWidth = 0.0
        }
        return CALayerDescription {
            cornerRadius: radius,
            clipsChildren: true,
            capturesBackdrop: false,
            content: .Solid(CASolid {
                fill: caColorFromFoundation(surfaceGlassFill(Color {}, style, modifiers)),
                border: caColorFromFoundation(modifierSurfaceBorder(transparentFoundationColor(), modifiers)),
                borderWidth: borderWidth,
                cornerRadius: radius
            }),
            sublayers: [content.describe(context, modifierContextForChildren(modifiers))]
        }
    }
}

// A continuous superellipse corner draws as shape kind 1 (the platform menu /
// control corner); every other container shape is a circular-arc rounded rect.
function surfaceLayerGlassShapeKind(shape: borrow ContainerShape) -> Int {
    match shape {
        Squircle(value) -> return 1
        Rect -> return 0
        RoundedRect(value) -> return 0
        Radius(style) -> return 0
        Capsule -> return 0
        Circle -> return 0
    }
}

// --- Shapes ------------------------------------------------------------------
//
// SwiftUI's shapes are RESIZABLE views: `RoundedRectangle(cornerRadius: 12)`
// states a corner and nothing else, and takes the size of whatever it is placed
// in. That is what makes `.background(RoundedRectangle(cornerRadius: 12))` work
// without repeating the content's size — and what makes a `Panel` unnecessary,
// because a background shape already fills the box behind the content.
//
construct RoundedRectangle(
    cornerRadius: Float = 0.0,
    style: CornerRadius = .None,
    followsTheme: Bool = false,
) extends Widget {
    // Two ways to name one corner, so one name answers to both.
    //
    // SwiftUI's shape takes a LENGTH, and a length is right wherever a size
    // class computed it. KiraUI's themes also carry a radius scale, and a
    // container that names `.Medium` keeps following the theme where a literal
    // 12 stops following it the moment the theme is retuned. Neither is a
    // different shape, so neither gets a different type: the token spelling is
    // an `init`, and `RoundedRectangle(…)` names both.
    init(radius: CornerRadius) {
        return RoundedRectangle(cornerRadius: 0.0, style: radius, followsTheme: true)
    }


    function describe(context: borrow BuildContext, modifiers: borrow ModifierContext) -> CALayerDescription {
        var radius = cornerRadius
        if followsTheme {
            radius = cornerRadiusImplementation(style, modifiers)
        }
        return shapeDescription(context, modifiers, radius, 0)
    }
}

// The square-cornered one. A swatch, a hairline rule, a band of colour behind a
// page — sized by `.width(...)` / `.height(...)` / `.fillWidth()` like any other
// view, and filled by the cascade or by `.fill(...)`.
construct Rectangle() extends Widget {

    function describe(context: borrow BuildContext, modifiers: borrow ModifierContext) -> CALayerDescription {
        return shapeDescription(context, modifiers, 0.0, 0)
    }
}

construct Capsule() extends Widget {

    function describe(context: borrow BuildContext, modifiers: borrow ModifierContext) -> CALayerDescription {
        return shapeDescription(context, modifiers, containerShapeUnbounded(), 0)
    }
}

// One shape, filled the way the modifiers in effect say to fill it: `.material`
// picks the material, `.backgroundStyle` / `.foregroundColor` the flat fill,
// `.themeBorder` the edge. A shape does not name its own colour, exactly as
// SwiftUI's does not — `.fill(...)` and the cascade decide.
function shapeDescription(
    context: borrow BuildContext,
    modifiers: borrow ModifierContext,
    radius: Float,
    shapeKind: Int,
) -> CALayerDescription {
    let ignored = context.frameCount
    var style: Material = .Flat
    if modifiers.hasMaterial {
        style = modifiers.material
    }
    var border = modifierSurfaceBorder(transparentFoundationColor(), modifiers)
    var borderWidth = 1.0
    if modifiers.hasThemeBorder == false {
        borderWidth = 0.0
    }
    if style == .LayeredGlass {
        border = transparentFoundationColor()
    }
    return CALayerDescription {
        cornerRadius: radius,
        content: .Solid(CASolid {
            fill: caColorFromFoundation(surfaceGlassFill(Color {}, style, modifiers)),
            border: caColorFromFoundation(border),
            borderWidth: borderWidth,
            cornerRadius: radius,
            shapeKind: shapeKind
        })
    }
}

// `.padding(_:)`: the content held off its own edges by one length, and nothing
// else changed about it.
construct PaddingLayer(length: Float) extends Widget {
    let content: some Widget


    // A wrapper that holds the child off its edges by one length on every side.
    // The child fills the inner box; the wrapper takes the child's own fill/hug.
    function describe(context: borrow BuildContext, modifiers: borrow ModifierContext) -> CALayerDescription {
        let described = content.describe(context, modifierContextForChildren(modifiers))
        let fillsWidth = described.layout.widthFill
        let fillsHeight = described.layout.heightFill
        return CALayerDescription {
            layout: CALayoutIntent {
                widthFill: fillsWidth,
                heightFill: fillsHeight,
                paddingLeading: length,
                paddingTop: length,
                paddingTrailing: length,
                paddingBottom: length
            },
            sublayers: [described]
        }
    }
}
