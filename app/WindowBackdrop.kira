import Foundation
import Ember
import KiraLayout
import KCoreAnimation

// What is behind the window, shown through its navigation chrome.
//
// A Mac's sidebar is not the window's own pixels blurred. It is the desktop
// and the windows under this one, blurred and tinted by the window server,
// so a sidebar over a blue wallpaper reads blue. A window can do that only
// where its host composites it over what is behind it and draws that behind
// it on its say-so; the host says so with `windowBackdropAvailableSet`.
//
// Where it can, the split view hands its sidebar to the window rather than
// drawing it in place. The window draws its canvas and its content, cuts the
// sidebar's strip out of everything drawn so far, and draws the sidebar's
// content over the hole; the host asks for the backdrop under the hole.

struct WindowBackdrop {
    // Whether the host draws what is behind the window under its holes.
    var available: Bool = false
    // AppKit supplies native material behind the *entire* window, including
    // the toolbar. A compositor host such as MosaicDisplay may supply only
    // the leading strip: its toolbar must continue using KiraUI's material.
    var nativeToolbar: Bool = false
    // A one-shot optional diagnostic proves the runtime really issued the
    // toolbar and leading-column cuts, not just created an AppKit blur view.
    var nativeProbeReported: Bool = false
    // This frame's sidebar, handed over by the split view, and how wide and
    // tall the strip it stands in is, in the window's points.
    var sidebar: [CALayerDescription] = []
    var width: Number = 0.0
    var height: Number = 0.0
    var railWidth: Number = 0.0
    // The radius applies to the ONE content/background corner at the
    // toolbar/sidebar junction. It is never applied to the sidebar or rail.
    var paneCornerRadius: Number = 0.0
    // Rail windows share one material across the toolbar, rail and sidebar.
    // The two rectangular pieces tile the L-shaped chrome without overlap.
    var unified: Bool = false
    var viewportWidth: Number = 0.0
    // Whether the sidebar is drawn dark, which the backdrop is tinted for.
    var dark: Bool = false
    // The glass this frame's chrome lays over the strip, taken out of the
    // frame for the host to draw.
    var glass: [WindowBackdropPiece] = []
}

// A piece of glass over the sidebar's strip that the host draws over the
// backdrop, as a Mac's window server does, rather than the window drawing it
// over a guess at what is there. Its box is in points from the strip's top
// leading corner.
public struct WindowBackdropPiece {
    var x: Number = 0.0
    var y: Number = 0.0
    var width: Number = 0.0
    var height: Number = 0.0
    var corner: Number = 0.0
    var capsule: Bool = false
    var continuous: Bool = false
    // The glass it is made of, where the compositor draws it.
    var recipe: CAGlassRecipe = .Clear
}

function windowBackdropEnsure() {
    if !ambientStateHas(StateSlot.windowBackdrop) {
        ambientStatePut(StateSlot.windowBackdrop, nativeUserData(nativeState(WindowBackdrop {})))
    }
}

// The host says whether it draws what is behind the window under its holes.
public function windowBackdropAvailableSet(available: Bool, toolbar: Bool = false) {
    unsafe {
        windowBackdropEnsure()
        var state = nativeRecover<WindowBackdrop>(ambientStateGet(StateSlot.windowBackdrop))
        state.available = available
        state.nativeToolbar = available && toolbar
    }
}

// Whether a sidebar shows what is behind the window this frame: on a
// computer, on a host that draws the backdrop. Both MosaicDisplay (which draws
// the app's frame) and AppKit (which supplies the native window frame) qualify.
public function windowBackdropShown() -> Bool {
    unsafe {
        windowBackdropEnsure()
        let state = nativeRecover<WindowBackdrop>(ambientStateGet(StateSlot.windowBackdrop))
        return state.available && interfaceMode() == .AdaptiveDesktop
    }
}

// Forgets the last frame's sidebar, before the content lowers.
function windowBackdropCollect() {
    unsafe {
        windowBackdropEnsure()
        var state = nativeRecover<WindowBackdrop>(ambientStateGet(StateSlot.windowBackdrop))
        var none: [CALayerDescription] = []
        state.sidebar = move none
        state.width = 0.0
        state.height = 0.0
        state.railWidth = 0.0
        state.paneCornerRadius = 0.0
        state.unified = false
        state.viewportWidth = 0.0
    }
}

// The split view hands the window its sidebar: `sidebar` drawn from the
// window's top leading corner, over a strip `width` wide and `height` tall,
// in the scheme `scheme`.
public function windowBackdropSidebar(
    sidebar: CALayerDescription,
    width: Number,
    height: Number,
    scheme: FoundationScheme,
    unified: Bool = false,
    viewportWidth: Number = 0.0,
    railWidth: Number = 0.0,
    cornerRadius: Number = 0.0
) {
    unsafe {
        windowBackdropEnsure()
        var state = nativeRecover<WindowBackdrop>(ambientStateGet(StateSlot.windowBackdrop))
        var held: [CALayerDescription] = [sidebar]
        state.sidebar = move held
        state.width = width
        state.height = height
        state.railWidth = railWidth
        state.paneCornerRadius = cornerRadius
        state.dark = scheme == .Dark
        state.unified = unified
        state.viewportWidth = viewportWidth
    }
}

// The strip the backdrop shows through this frame, in the window's points:
// its width, zero when there is none, and its height.
public function windowBackdropStrip() -> Size {
    // The host receives a cut only when it really supplies a native backdrop.
    // A standalone KiraUI window paints the same material in its own frame.
    if !windowBackdropShown() { return Size {} }
    unsafe {
        windowBackdropEnsure()
        let state = nativeRecover<WindowBackdrop>(ambientStateGet(StateSlot.windowBackdrop))
        return Size { width: state.width, height: state.height }
    }
}

// Whether this frame's sidebar is drawn dark.
public function windowBackdropDark() -> Bool {
    unsafe {
        windowBackdropEnsure()
        let state = nativeRecover<WindowBackdrop>(ambientStateGet(StateSlot.windowBackdrop))
        return state.dark
    }
}

// The same measured toolbar boundary drives both Metal's cutout and its
// native backdrop displacement field. It cannot be guessed from titlebar
// constants: toolbars can grow when their content or safe area changes.
function windowBackdropUnifiedTop(state: borrow WindowBackdrop) -> Number {
    let measured = windowBarTop(state.viewportWidth)
    return min(
        measured > 0.0 ? measured : TitleBarMetrics.height,
        state.height
    )
}

// The native compositor's L-shaped transparent substrate, expressed in
// window points: its full-height leading width and its full-width top height.
// Other split configurations do not contain this union and return no geometry.
function windowBackdropChromeField() -> Size {
    if !windowBackdropShown() { return Size {} }
    unsafe {
        windowBackdropEnsure()
        let state = nativeRecover<WindowBackdrop>(ambientStateGet(StateSlot.windowBackdrop))
        if !state.unified || !state.nativeToolbar || state.width <= 0.0 { return Size {} }
        return Size {
            width: state.width,
            height: windowBackdropUnifiedTop(state)
        }
    }
}

// The cut and the sidebar over it, for the window to draw over its content.
function windowBackdropLayers(modifiers: borrow ModifierContext) -> [CALayerDescription] {
    unsafe {
        windowBackdropEnsure()
        var state = nativeRecover<WindowBackdrop>(ambientStateGet(StateSlot.windowBackdrop))
        var layers: [CALayerDescription] = []
        if state.width <= 0.0 { return layers }
        let native = windowBackdropShown()
        var toolbarBottom = 0.0
        if state.unified {
            let scheme: FoundationScheme = state.dark ? .Dark : .Light
            let top = windowBackdropUnifiedTop(state)
            toolbarBottom = top
            // The toolbar spans the window. The leading rail+sidebar below it
            // uses the SAME edgeless material recipe and starts precisely at
            // the toolbar's bottom. The two glass regions never tint twice.
            if native && state.nativeToolbar {
                if !state.nativeProbeReported && environmentValue("KIRA_METAL_BACKDROP_PROBE") == "1" {
                    log info(
                        "macOS native material chrome cutouts",
                        toolbarWidth: state.viewportWidth,
                        toolbarHeight: top,
                        railAndSidebarWidth: state.width,
                        railAndSidebarHeight: state.height
                    )
                    state.nativeProbeReported = true
                }
                // The NSVisualEffectView is already behind the Metal surface,
                // across the full titlebar. Cut this part of the otherwise
                // opaque document as well as the leading rail/sidebar: one
                // continuous real desktop blur, with toolbar controls drawn
                // on top in WindowChrome.
                layers.append(windowBackdropCut(state.viewportWidth, top, 0.0))
            } else {
                layers.append(windowNavigationMaterial(
                    state.viewportWidth, top, 0.0, scheme
                ))
            }
            if !native && state.height > top {
                layers.append(windowNavigationMaterial(
                    state.width, state.height - top, top, scheme
                ))
            }
        }
        if native {
            layers.append(windowBackdropCut(state.width, state.height, 0.0))
        }
        if state.width > state.railWidth && state.height > toolbarBottom {
            // Tint ONLY the sidebar below the unified toolbar. The toolbar is
            // a single clear macOS titlebar material, even above the sidebar;
            // the rail remains clear below it as well.
            layers.append(windowSidebarShade(
                state.railWidth,
                state.width - state.railWidth,
                toolbarBottom,
                state.height - toolbarBottom,
                state.dark ? .Dark : .Light
            ))
        }
        if native && state.nativeToolbar && state.unified
            && state.paneCornerRadius > 0.0 && state.width < state.viewportWidth {
            // The old rounded wrappers had no visible effect at the corner:
            // the full-window opaque canvas was still painted underneath.
            // Cut ONLY the radius-sized square at the actual content junction
            // (sidebar trailing edge, toolbar bottom), refill it with the
            // sidebar's translucent material, then paint the content canvas
            // inside a top-leading-only rounded mask. This gives a real
            // visible corner without clipping every edge or altering hit areas.
            let radius = min(
                state.paneCornerRadius,
                min(state.viewportWidth - state.width, state.height - toolbarBottom)
            )
            if radius > 0.0 {
                layers.append(windowBackdropCutAt(state.width, toolbarBottom, radius, radius))
                layers.append(windowSidebarShade(
                    state.width, radius, toolbarBottom, radius,
                    state.dark ? .Dark : .Light
                ))
                layers.append(windowContentCornerCanvas(
                    state.width, toolbarBottom, radius,
                    colorFromFoundation(windowCanvas(modifiers))
                ))
            }
        }
        for layer in state.sidebar {
            layers.append(copy layer)
        }
        return layers
    }
}

function windowSidebarShade(
    leading: Number,
    width: Number,
    top: Number,
    height: Number,
    scheme: FoundationScheme
) -> CALayerDescription {
    let activity: FoundationWindowActivity = windowActive() ? .Active : .Inactive
    let tone = foundationSidebarTint(scheme, activity).lower.color
    // A darkened system-material tint, not a painted opaque panel. The native
    // NSVisualEffectView remains visible through the remaining alpha.
    let opacity = scheme == .Dark ? 0.30 : 0.34
    return CALayerDescription {
        disablesActions: true,
        layout: CALayoutIntent {
            widthFill: false, heightFill: false,
            fixedWidth: width, fixedHeight: height,
            offset: Point { x: leading, y: top }
        },
        content: .Solid(CASolid {
            fill: CAColor {
                r: tone.r * 0.62, g: tone.g * 0.62,
                b: tone.b * 0.62, a: opacity
            }
        })
    }
}

// Paint a single, top-leading continuous corner of the content canvas after
// removing the underlying opaque frame pixels. The cutout is radius-sized,
// but the signed-distance renderer clamps a rounded rectangle's radius to
// half its dimensions. Paint a 2*radius continuous shape and clip it to the
// radius-sized top-left quadrant: this preserves the full native radius and
// doesn't paint over document controls in the rest of the content pane.
function windowContentCornerCanvas(
    x: Number, y: Number, radius: Number, color: CAColor
) -> CALayerDescription {
    return CALayerDescription {
        disablesActions: true,
        clipsChildren: true,
        layout: CALayoutIntent {
            widthFill: false, heightFill: false,
            fixedWidth: radius, fixedHeight: radius,
            offset: Point { x: x, y: y }
        },
        sublayers: [CALayerDescription {
            disablesActions: true,
            layout: CALayoutIntent {
                widthFill: false, heightFill: false,
                fixedWidth: radius * 2.0, fixedHeight: radius * 2.0
            },
            content: .Solid(CASolid {
                fill: color,
                cornerRadius: radius,
                shapeKind: WindowShape.continuous + ClipCorner.squareStride * (
                    ClipCorner.topTrailing + ClipCorner.bottomLeading + ClipCorner.bottomTrailing
                )
            })
        }]
    }
}

function windowBackdropCutAt(
    x: Number, y: Number, width: Number, height: Number
) -> CALayerDescription {
    return CALayerDescription {
        disablesActions: true,
        layout: CALayoutIntent {
            widthFill: false, heightFill: false,
            fixedWidth: width, fixedHeight: height,
            offset: Point { x: x, y: y }
        },
        content: .Solid(CASolid {
            fill: CAColor { r: 1.0, g: 1.0, b: 1.0, a: 1.0 },
            blend: .DestinationOut
        })
    }
}

// A source-over native material is not painted as an opaque tint in our Metal
// window. This blend opens the actual alpha hole through the canvas and any
// content already drawn; NSVisualEffectView supplies the material behind it.
function windowBackdropCut(width: Number, height: Number, y: Number) -> CALayerDescription {
    return CALayerDescription {
        disablesActions: true,
        layout: CALayoutIntent {
            widthFill: false,
            heightFill: false,
            fixedWidth: width,
            fixedHeight: height,
            offset: Point { y: y }
        },
        content: .Solid(CASolid {
            fill: CAColor { r: 1.0, g: 1.0, b: 1.0, a: 1.0 },
            blend: .DestinationOut
        })
    }
}

// One edge-free macOS navigation material for both chrome regions. This is a
// backdrop-sampling glass, not an opaque color or Liquid Glass control lens.
// Keeping all instances on the same recipe ensures a continuous tint and blur
// where the toolbar meets the rail and sidebar.
function windowNavigationMaterial(
    width: Number,
    height: Number,
    y: Number,
    scheme: FoundationScheme
) -> CALayerDescription {
    return CALayerDescription {
        disablesActions: true,
        capturesBackdrop: true,
        layout: CALayoutIntent {
            widthFill: false,
            heightFill: false,
            fixedWidth: width,
            fixedHeight: height,
            offset: Point { x: 0.0, y: y }
        },
        content: .Glass(windowBackdropGlass(scheme, windowActive()))
    }
}

// The tone the sidebar material reads as, opaque, as near as the window can
// know it without seeing what is behind it: the material lays its tint's
// luminance at the tint's opacity and drains most of the color, so a gray at
// that share of the luminance. The rest is the desktop behind the window,
// taken as dark, as the default picture is: over it the light sidebar
// measures 0.81, where the tint's luminance alone is 0.895, and glass laid
// over the hole at the brighter tone draws its rim lighter than the sidebar
// around it.
function windowBackdropTone(dark: Bool) -> CAColor {
    let scheme: FoundationScheme = dark ? .Dark : .Light
    let activity: FoundationWindowActivity = windowActive() ? .Active : .Inactive
    let lower = foundationSidebarTint(scheme, activity).lower
    let tone = lower.color
    let gray = (tone.r * 0.2126 + tone.g * 0.7152 + tone.b * 0.0722) * lower.alpha
    return CAColor { r: gray, g: gray, b: gray, a: 1.0 }
}

// A Mac's sidebar material, for the scheme and whether its window is in
// front: what is behind it blurred, set at the sidebar tone's luminance and
// drained of most of its color, so it reads as a darker tone of the window.
// No lens and no rim, since it meets the window's edges and the detail with
// none. The window server draws it under a window's hole with this glass.
public function windowBackdropGlass(scheme: FoundationScheme, active: Bool) -> CAGlass {
    let activity: FoundationWindowActivity = active ? .Active : .Inactive
    let stack = foundationSidebarTint(scheme, activity)
    let tone = stack.lower
    return CAGlass {
        blur: 1.0,
        edgeRefraction: 0.0,
        tint: CAColor { r: tone.color.r, g: tone.color.g, b: tone.color.b, a: tone.alpha },
        material: foundationGlassMaterialWithTint(
            CAGlassMaterial {
                lensMaxBend: 0.0,
                borderSpread: 0.0,
                borderSideOffset: 0.0,
                borderSideSpread: 0.0,
                borderGray: 1.0,
                borderSideGray: 1.0,
                innerRimStrength: 0.0
            },
            stack
        ),
        shapeKind: surfaceLayerGlassShapeKind(.Rect)
    }
}

// Takes the glass the window's chrome lays over the sidebar's strip out of
// the laid-out frame `described`, for the host to draw over the backdrop.
// Glass the window drew there would refract and tint the tone it took the
// backdrop for, and its rim would read lighter or darker than the sidebar
// around it. A piece lit by a press or the pointer, faded, or moved by a
// transform stays in the frame, which alone draws those; its contents stay
// in the frame either way.
public function windowBackdropLiftGlass(
    described: borrow mut CALayerDescription,
    scale: Number = 1.0
) {
    unsafe {
        let shown = windowBackdropShown()
        windowBackdropEnsure()
        var state = nativeRecover<WindowBackdrop>(ambientStateGet(StateSlot.windowBackdrop))
        var lifted: [WindowBackdropPiece] = []
        if shown && state.width > 0.0 {
            windowBackdropLiftIn(described, Point {}, state.sidebar.count, lifted)
        }
        state.glass = move lifted
        if scale != 1.0 {
            state.width *= scale
            state.height *= scale
            for index in 0..state.glass.count {
                state.glass[index].x *= scale
                state.glass[index].y *= scale
                state.glass[index].width *= scale
                state.glass[index].height *= scale
                state.glass[index].corner *= scale
            }
        }
    }
}

public function windowBackdropCount() -> Number {
    unsafe {
        windowBackdropEnsure()
        let state = nativeRecover<WindowBackdrop>(ambientStateGet(StateSlot.windowBackdrop))
        return state.glass.count + state.sidebar.count
    }
}

// The glass lifted out of this frame, bottom first.
public function windowBackdropPieces() -> [WindowBackdropPiece] {
    unsafe {
        windowBackdropEnsure()
        let state = nativeRecover<WindowBackdrop>(ambientStateGet(StateSlot.windowBackdrop))
        return copy state.glass
    }
}

// Finds the cut in `layer`, whose parent's top leading corner stands at
// `origin`, and lifts the glass from the chrome drawn after the cut and the
// `sidebar` layers over it (`windowLayers`). Whether it found the cut.
function windowBackdropLiftIn(
    layer: borrow mut CALayerDescription,
    origin: Point,
    sidebar: Number,
    lifted: borrow mut [WindowBackdropPiece]
) -> Bool {
    let corner = windowBackdropCorner(layer, origin)
    for i in 0..layer.sublayers.count {
        if windowBackdropIsCut(layer.sublayers[i]) {
            let chrome = i + 1 + sidebar
            if chrome < layer.sublayers.count {
                let cut = layer.sublayers[i]
                let strip = Rect {
                    x: corner.x + cut.position.x,
                    y: corner.y + cut.position.y,
                    width: cut.size.width,
                    height: cut.size.height
                }
                windowBackdropLiftChrome(layer.sublayers[chrome], copy corner, strip, lifted)
            }
            return true
        }
        if windowBackdropLiftIn(layer.sublayers[i], copy corner, sidebar, lifted) {
            return true
        }
    }
    return false
}

// Lifts the plain glass in `layer` that lies inside `strip`.
function windowBackdropLiftChrome(
    layer: borrow mut CALayerDescription,
    origin: Point,
    strip: borrow Rect,
    lifted: borrow mut [WindowBackdropPiece]
) {
    if layer.opacity != 1.0 || layer.scaleX != 1.0 || layer.scaleY != 1.0 || layer.rotation != 0.0 {
        return
    }
    let corner = windowBackdropCorner(layer, origin)
    var piece = WindowBackdropPiece {
        x: corner.x - strip.x,
        y: corner.y - strip.y,
        width: layer.size.width,
        height: layer.size.height,
        corner: layer.cornerRadius
    }
    let inside = piece.x >= -0.5 && piece.y >= -0.5 && piece.width > 0.0 && piece.height > 0.0
        && piece.x + piece.width <= strip.width + 0.5
        && piece.y + piece.height <= strip.height + 0.5
    var lifts = false
    match layer.content {
        Glass(glass) -> {
            let unlit = glass.glowStrength == 0.0 && glass.glowWash == 0.0
            match glass.style {
                Some(style) -> { lifts = inside && unlit && style.recipe == .Regular }
                None -> {}
            }
            // A capsule's radius is unbounded: past half its height.
            let half = min(piece.width, piece.height) * 0.5
            piece.capsule = layer.cornerRadius >= half - 0.01
            if piece.capsule { piece.corner = half }
            piece.continuous = glass.shapeKind == 1
        }
        Empty, Solid, Text, Texture, Icon, Gradient -> {}
    }
    if lifts {
        layer.content = .Empty
        lifted.append(move piece)
    }
    for i in 0..layer.sublayers.count {
        windowBackdropLiftChrome(layer.sublayers[i], copy corner, strip, lifted)
    }
}

// Where `layer`'s top leading corner stands, its parent's at `origin`: a
// layer lifted over everything else is placed from the window itself.
function windowBackdropCorner(layer: borrow CALayerDescription, origin: borrow Point) -> Point {
    let parent = match layer.level {
        Inline -> copy origin
        Overlay(z) -> Point {}
    }
    return Point { x: parent.x + layer.position.x, y: parent.y + layer.position.y }
}

function windowBackdropIsCut(layer: borrow CALayerDescription) -> Bool {
    return match layer.content {
        Solid(s) -> s.blend == .DestinationOut
        Empty, Text, Texture, Icon, Glass, Gradient -> false
    }
}
