import Foundation
import KiraGraphics
import KiraLayout
import KCoreAnimation

// Top-level application destinations, matching SwiftUI's `TabView`:
//
//     TabView {
//         Tab("Home", systemImage: .House, value: 0) { HomePage() }
//         Tab("Search", systemImage: .Search, value: 1) { SearchPage() }
//     }
//
// The selected tab's content is the window's content. Every tab puts itself on
// the window's chrome as it is lowered, and the chrome floats them in one
// capsule of glass in the toolbar's row, as iPad does.

public struct KiraUiTabSelectionState {
    var selection: Int = 0
}

public struct KiraUiTabEnvironment {
    var key: Int = 0
    var active: Bool = false
}

public function kiraUiTabEnvironmentKey() -> String {
    return "kiraui.tab.environment"
}

public function kiraUiTabEnvironment() -> KiraUiTabEnvironment {
    if kiraUiStateSlotHas(kiraUiTabEnvironmentKey()) == false {
        kiraUiStateSlotPut(
            kiraUiTabEnvironmentKey(),
            nativeUserData(nativeState(KiraUiTabEnvironment {}))
        )
    }
    return nativeRecover<KiraUiTabEnvironment>(
        kiraUiStateSlotGet(kiraUiTabEnvironmentKey())
    )
}

public function kiraUiTabEnter(key: Int) -> KiraUiTabEnvironment {
    let previous = kiraUiTabEnvironment()
    var current = nativeRecover<KiraUiTabEnvironment>(
        kiraUiStateSlotGet(kiraUiTabEnvironmentKey())
    )
    current.key = key
    current.active = true
    return previous
}

public function kiraUiTabLeave(previous: borrow KiraUiTabEnvironment) {
    var current = nativeRecover<KiraUiTabEnvironment>(
        kiraUiStateSlotGet(kiraUiTabEnvironmentKey())
    )
    current.key = previous.key
    current.active = previous.active
    return
}

public function kiraUiTabSelectionKey(key: Int) -> String {
    return kiraUiSlotKey("kiraui.tab.selection.", key)
}

public function kiraUiTabEnsure(key: Int, initialSelection: Int) {
    let slot = kiraUiTabSelectionKey(key)
    if kiraUiStateSlotHas(copy slot) == false {
        kiraUiStateSlotPut(
            move slot,
            nativeUserData(nativeState(KiraUiTabSelectionState {
                selection: initialSelection
            }))
        )
    }
    return
}

public function kiraUiTabSelection(key: Int) -> Int {
    kiraUiTabEnsure(key, 0)
    let state = nativeRecover<KiraUiTabSelectionState>(
        kiraUiStateSlotGet(kiraUiTabSelectionKey(key))
    )
    return state.selection
}

public function kiraUiTabSetSelection(key: Int, selection: Int) {
    kiraUiTabEnsure(key, selection)
    var state = nativeRecover<KiraUiTabSelectionState>(
        kiraUiStateSlotGet(kiraUiTabSelectionKey(key))
    )
    state.selection = selection
    return
}

public function kiraUiTabSelectFn(key: Int, selection: Int) -> () -> Void {
    let tabKey = key
    let selected = selection
    let press: () -> Void = { in
        kiraUiTabSetSelection(tabKey, selected)
        return
    }
    return press
}

public construct Tab(
    title: String,
    systemImage: Symbol,
    value: Int,
) extends Widget {
    let content: some Widget


    // Every tab puts itself on the bar; only the selected one's content is
    // the window's. The iPad's bar names a tab by its title alone; the symbol
    // is for the sidebar a tab view becomes.
    function describe(context: borrow BuildContext, modifiers: borrow ModifierContext) -> CALayerDescription {
        let environment = kiraUiTabEnvironment()
        if environment.active == false {
            return content.describe(context, modifiers)
        }
        let selected = kiraUiTabSelection(environment.key) == value
        kiraUiChromeAppend(.Tab, KiraUiToolbarEntry {
            content: tabBarItem(title, selected, kiraUiTabSelectFn(environment.key, value), context, modifiers)
        })
        if selected {
            return content.describe(context, modifiers)
        }
        return CALayerDescription {}
    }
}

// One tab on the bar, pressed to select it.
public function tabBarItem(
    title: borrow String,
    selected: Bool,
    select: () -> Void,
    context: borrow BuildContext,
    modifiers: borrow ModifierContext,
) -> CALayerDescription {
    let key = kiraUiTapSeqKey()
    kiraUiLayerActionRegister(key, move select)
    var item = tabBarItemFace(tabBarItemLabel(title, .None, selected, context, modifiers), selected, modifiers)
    item.hittable = !modifiers.disabled
    item.hitKey = key
    return item
}

// What a tab looks like, with nothing to press: its label held off the ends
// of a capsule the bar's height less its inset, on the selection capsule when
// it is the one selected.
public function tabBarItemFace(
    label: CALayerDescription,
    selected: Bool,
    modifiers: borrow ModifierContext,
) -> CALayerDescription {
    let metrics = tabBarMetrics()
    let radius = metrics.tabHeight / 2.0
    return CALayerDescription {
        layout: CALayoutIntent {
            axis: .Row,
            widthFill: false,
            heightFill: false,
            fixedHeight: metrics.tabHeight,
            paddingLeading: metrics.labelInset,
            paddingTrailing: metrics.labelInset,
            alignment: Point { x: 0.5, y: 0.5 }
        },
        cornerRadius: radius,
        content: .Solid(CASolid {
            fill: caColorFromFoundation(modifierColor(foundationColor(tabBarItemFill(selected, modifiers)), modifiers)),
            cornerRadius: radius
        }),
        sublayers: [move label]
    }
}

// A tab's label: the subheadline face, medium, in the bar's ink; bold in the
// primary ink when the tab is selected. A tab view's bar names a tab by its title
// alone, the symbol being for the sidebar it becomes.
public function tabBarItemLabel(
    title: borrow String,
    systemImage: Symbol,
    selected: Bool,
    context: borrow BuildContext,
    modifiers: borrow ModifierContext,
) -> CALayerDescription {
    let face = modifierTypography(modifiers, .subheadline)
    let label = Label(title: copy title, systemImage: systemImage)
        .font(size: face.size, weight: selected ? .Bold : .Medium)
    return label.describe(context, tabBarItemInk(selected, modifiers))
}

// The ink everything on a tab is set in: the primary when it is selected, the
// bar's own otherwise.
public function tabBarItemInk(selected: Bool, modifiers: borrow ModifierContext) -> ModifierContext {
    if selected {
        return modifierContextApply(modifiers, modifierDeltaForegroundColor(.Primary))
    }
    return modifierContextApply(modifiers, modifierDeltaTextColor(themeAdaptiveColor(tabLabel, modifierAppearance(modifiers))))
}

// The capsule behind a tab: the selection's when it is selected, nothing
// otherwise.
public function tabBarItemFill(selected: Bool, modifiers: borrow ModifierContext) -> Color {
    if selected {
        return themeAdaptiveColor(tabSelection, modifierAppearance(modifiers))
    }
    return Color { a: 0.0 }
}

// The bar a tab view's tabs float in: one capsule of glass holding them off
// every side.
public function tabBarCapsule(
    tabs: [CALayerDescription],
    context: borrow BuildContext,
    modifiers: borrow ModifierContext,
) -> CALayerDescription {
    let metrics = tabBarMetrics()
    let row = CALayerDescription {
        layout: CALayoutIntent {
            axis: .Row,
            widthFill: false,
            heightFill: false,
            paddingLeading: metrics.inset,
            paddingTop: metrics.inset,
            paddingTrailing: metrics.inset,
            paddingBottom: metrics.inset,
            alignment: Point { x: 0.0, y: 0.5 }
        },
        sublayers: move tabs
    }
    return interactiveGlassDescription(
        context,
        kiraUiTapSeqKey(),
        CALayoutIntent {
            widthFill: false,
            heightFill: false,
            fixedHeight: metrics.height
        },
        containerShapeRadius(.Capsule, modifiers),
        .Capsule,
        modifiers,
        [row]
    )
}

public construct TabView(initialSelection: Int = 0) extends Widget {
    let children: [some Widget]


    function describe(context: borrow BuildContext, modifiers: borrow ModifierContext) -> CALayerDescription {
        let key = kiraUiTapSeqKey()
        kiraUiTabEnsure(key, initialSelection)
        let previous = kiraUiTabEnter(key)
        let content = ZStack(alignment: .TopLeading) {
            For(tab in children) {
                tab
            }
        }.fillWidth().fillHeight().describe(context, modifiers)
        kiraUiTabLeave(previous)
        return content
    }
}
