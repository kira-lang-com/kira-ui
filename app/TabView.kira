import Foundation
import Ember
import KiraLayout
import KCoreAnimation

// Top-level application destinations, matching SwiftUI's `TabView`:
//
//     @State var selection: Destination = .home
//
//     TabView(selection: $selection) {
//         Tab(title: "Home", systemImage: .House, value: Destination.home) { HomePage() }
//         Tab(title: "Search", systemImage: .Search, value: Destination.search) { SearchPage() }
//     }
//
// or, as SwiftUI's views written before `Tab` do, any view tagged with its
// value and given the item it shows on the bar:
//
//     HomePage()
//         .tag(Destination.home)
//         .tabItem { Label(title: "Home", systemImage: .House) }
//
// A tab is selected when its value is the selection, and pressing it makes it
// so (Tag.kira). The selected tab's content is the window's content. Every tab puts
// itself on the window's chrome as it is lowered, and the chrome floats them
// in one capsule of glass: in the toolbar's row, as iPad does, and at the foot
// of the screen on a phone, as iPhone does.

// Whether a tab view's bar floats at the foot of the window, as a phone's
// does, rather than in the toolbar's row.
public function tabBarAtFoot(context: borrow BuildContext) -> Bool {
    return resolvedNavigationDevice(context.viewportWidth) == .Phone
}

// The tab `entry` is, shown on the bar as `item`: it puts itself on the bar,
// and its content is the window's when it is the one selected. The content
// is built outside the tab view, so a tag inside it is not taken for a tab.
public function tabDescribed(
    entry: TagEntry,
    item: borrow Any Widget,
    content: borrow Any Widget,
    context: borrow BuildContext,
    modifiers: borrow ModifierContext,
) -> CALayerDescription {
    let selected = entry.selected
    var shown = CALayerDescription {}
    if tabBarAtFoot(context) {
        shown = phoneTabBarItem(item, selected, copy entry.select, context, modifiers)
    } else {
        shown = tabBarItem(item, selected, copy entry.select, context, modifiers)
    }
    // A tab is one element, reading its title, that selects it.
    var node = accessibilityPressable(.Tab, copy entry.select, modifiers)
    if selected {
        node.traits = node.traits.union(AccessibilityTraits.isSelected)
    }
    shown.accessibilityCombined(move node)
    chromeAppend(.Tab, ToolbarEntry { content: move shown })
    if !selected {
        return CALayerDescription {}
    }
    let previous = tagEnter(TagEnvironment {})
    let described = content.describe(context, modifiers)
    tagLeave(move previous)
    return described
}

@Instance(Number)
@Instance(String)
public construct Tab<Value>(title: String, systemImage: Symbol, value: Value) extends Widget {
    let content: some Widget

    // The iPad's bar names a tab by its title alone; the symbol is for the
    // sidebar a tab view becomes, and for a phone's bar, which stacks it over
    // the title.
    function describe(
        context: borrow BuildContext,
        modifiers: borrow ModifierContext
    ) -> CALayerDescription {
        match tagEnvironment().selector {
            Some(selector) -> {
                if selector.role == .Tab {
                    if tabBarAtFoot(context) {
                        return tabDescribed(
                            tagEntry(selector, value),
                            Label(title: title, systemImage: systemImage),
                            content,
                            context,
                            modifiers
                        )
                    }
                    return tabDescribed(
                        tagEntry(selector, value),
                        Text(content: title),
                        content,
                        context,
                        modifiers
                    )
                }
            }
            None -> {}
        }
        return content.describe(context, modifiers)
    }
}

extend Widget {
    // What this view shows on a tab view's bar.
    function tabItem(label: some Widget) -> Any Widget {
        return TabItemLayer(label: label) {
            self
        }
    }
}

// A tagged view inside a tab view: a tab, once its bar item is known, which a
// `tabItem` written either side of the tag gives.
public function taggedTab(
    entry: TagEntry,
    content: borrow Any Widget,
    context: borrow BuildContext,
    modifiers: borrow ModifierContext,
) -> CALayerDescription {
    var environment = tagEnvironment()
    match environment.item {
        Some(item) -> return tabDescribed(move entry, item, content, context, modifiers)
        None -> {}
    }
    environment.entry = .Some(move entry)
    let previous = tagEnter(move environment)
    let described = content.describe(context, modifiers)
    tagLeave(move previous)
    return described
}

// A view with the item it shows on a tab view's bar. Inside a tab view, it is
// a tab once its tag is known.
public construct TabItemLayer(label: Any Widget) extends Widget {
    let content: some Widget

    function describe(
        context: borrow BuildContext,
        modifiers: borrow ModifierContext
    ) -> CALayerDescription {
        var environment = tagEnvironment()
        if !environment.within(.Tab) {
            return content.describe(context, modifiers)
        }
        match environment.entry {
            Some(entry) -> return tabDescribed(move entry, label, content, context, modifiers)
            None -> {}
        }
        environment.item = .Some(copy label)
        let previous = tagEnter(move environment)
        let described = content.describe(context, modifiers)
        tagLeave(move previous)
        return described
    }
}

// One tab on the bar, pressed to select it.
public function tabBarItem(
    label: borrow Any Widget,
    selected: Bool,
    select: () -> Void,
    context: borrow BuildContext,
    modifiers: borrow ModifierContext,
) -> CALayerDescription {
    let key = tapSeqKey()
    layerActionRegister(key, move select)
    var item = tabBarItemFace(
        tabBarInkedLabel(label, selected, context, modifiers),
        selected,
        modifiers
    )
    item.hittable = !modifiers.disabled
    item.hitKey = key
    return item
}

// What a tab looks like, with nothing to press: its label held off the ends
// of a capsule the bar's height less its inset, on the selection capsule when
// it is the one selected.
public function tabBarItemFace(
    label: CALayerDescription,
    selected: Bool,
    modifiers: borrow ModifierContext,
) -> CALayerDescription {
    let metrics = tabBarMetrics()
    let radius = metrics.tabHeight / 2.0
    return CALayerDescription {
        layout: CALayoutIntent {
            axis: .Row,
            widthFill: false,
            heightFill: false,
            fixedHeight: metrics.tabHeight,
            paddingLeading: metrics.labelInset,
            paddingTrailing: metrics.labelInset,
            alignment: Point { x: 0.5, y: 0.5 }
        },
        cornerRadius: radius,
        content: .Solid(tabBarItemFill(selected, radius, modifiers)),
        sublayers: [move label]
    }
}

// A button standing in a tab bar: the kit's symbol cell, its label held the
// tab's symbol inset off either end of a box the tab's height, in an
// unselected tab's ink. Nothing is drawn behind it; the bar's glass is its
// surface.
public function tabBarButtonDescription(
    context: borrow BuildContext,
    modifiers: borrow ModifierContext,
    key: Number,
    label: borrow Any Widget,
) -> CALayerDescription {
    let metrics = tabBarMetrics()
    let ink = tabBarItemInk(false, modifierContextForPresentation(modifiers))
    var described = label.describe(
        context,
        buttonPressedModifiers(ink, key, context, buttonPressedTextOpacity)
    )
    described.layout.widthFill = false
    described.layout.heightFill = false
    var cell = CALayerDescription {
        hittable: !modifiers.disabled,
        hitKey: key,
        opacity: modifiers.disabled ? 0.4 : 1.0,
        layout: CALayoutIntent {
            widthFill: false,
            heightFill: false,
            fixedHeight: metrics.tabHeight,
            paddingLeading: metrics.symbolInset,
            paddingTrailing: metrics.symbolInset,
            alignment: Point { x: 0.5, y: 0.5 }
        },
        sublayers: [described]
    }
    buttonPressTiming(cell, key, context)
    return cell
}

// A tab's label: its symbol and title, set as `tabBarInkedLabel` sets them.
public function tabBarItemLabel(
    title: borrow String,
    systemImage: Symbol,
    selected: Bool,
    context: borrow BuildContext,
    modifiers: borrow ModifierContext,
) -> CALayerDescription {
    // The symbol at its own width, not centered in a list's icon column: a
    // tab's inset is to its ink, so the column's empty side would widen the
    // leading end past the trailing one.
    let column = sidebarMetrics()
    let label = HStack(spacing: .Length(tabBarLabelGap()), alignment: .Center) {
        if systemImage != .None {
            Icon(symbol: systemImage).font(size: resolvedLength(column.symbolSize))
        }
        Text(content: copy title)
    }
    return tabBarInkedLabel(label, selected, context, modifiers)
}

// `label` set as a tab's label is: in the subheadline face, medium, in the
// bar's ink; bold in the primary ink when the tab is selected.
public function tabBarInkedLabel(
    label: borrow Any Widget,
    selected: Bool,
    context: borrow BuildContext,
    modifiers: borrow ModifierContext,
) -> CALayerDescription {
    let face = modifierTypography(modifiers, .subheadline)
    let styled = label
    .hugWidth()
    .font(size: resolvedLength(face.size), weight: selected ? .Bold : .Medium)
    if selected {
        var layers: [CALayerDescription] = []
        for ink in tabBarSelectedInks(modifiers) {
            layers.append(styled.describe(context, ink))
        }
        return tabBarInked(move layers)
    }
    return styled.describe(context, tabBarItemInk(false, modifiers))
}

// The gap between a tab's symbol and its title: the one a label's column
// leaves after its symbol.
public function tabBarLabelGap() -> Number {
    let column = sidebarMetrics()
    return column.titleSpacing + (column.iconColumn - column.symbolSize) / 2.0
}

// The kit's selected tab sets its title through a mask over two fills: black
// at half in the dark, then the accent dodged into what that leaves; white at
// half in the light, then the accent burned into it. Each fill is one ink, and
// the title is drawn once in each, the second over the first.
public function tabBarSelectedInks(modifiers: borrow ModifierContext) -> [ModifierContext] {
    if tabBarTinted(modifiers) {
        return [tabBarItemInk(true, modifiers)]
    }
    if modifierAppearance(modifiers) == .Dark {
        return [
            modifierContextApply(
                modifiers,
                modifierDeltaTextInk(RGBAColor { r: 0.0, g: 0.0, b: 0.0, a: 0.5 }, .Normal)
            ),
            modifierContextApply(
                modifiers,
                modifierDeltaTextInk(
                    RGBAColor { r: 0.0, g: 145.0 / 255.0, b: 1.0, a: 1.0 },
                    .LinearDodge
                )
            )
        ]
    }
    return [
        modifierContextApply(
            modifiers,
            modifierDeltaTextInk(RGBAColor { r: 1.0, g: 1.0, b: 1.0, a: 0.5 }, .Normal)
        ),
        modifierContextApply(
            modifiers,
            modifierDeltaTextInk(RGBAColor { r: 0.0, g: 136.0 / 255.0, b: 1.0, a: 1.0 }, .LinearBurn)
        )
    ]
}

// The passes of one selected label laid over each other, centered in the box
// the largest of them needs.
public function tabBarInked(layers: [CALayerDescription]) -> CALayerDescription {
    return CALayerDescription {
        layout: CALayoutIntent {
            widthFill: false,
            heightFill: false,
            alignment: Point { x: 0.5, y: 0.5 }
        },
        sublayers: move layers
    }
}

// Whether the application tinted the bar with an ink of its own rather than
// the accent: then every item on it, selected or not, is set plainly in that
// ink, and the selection is the capsule behind it and the heavier title.
public function tabBarTinted(modifiers: borrow ModifierContext) -> Bool {
    return modifiers.hasTint && modifiers.tint != .Accent
}

// The ink everything on a tab is set in: the accent when it is selected, the
// bar's own otherwise, and the application's tint either way when it set one.
// A selected label is drawn in `tabBarSelectedInks`.
public function tabBarItemInk(
    selected: Bool,
    modifiers: borrow ModifierContext
) -> ModifierContext {
    if tabBarTinted(modifiers) {
        let tint = primaryColorAsColor(modifiers.tint, modifierTokens(modifiers))
        return modifierContextApply(modifiers, modifierDeltaTextInk(move tint, .Normal))
    }
    if selected {
        return modifierContextApply(modifiers, modifierDeltaForegroundColor(.Accent))
    }
    var ink = tabLabel.light
    if modifierAppearance(modifiers) == .Dark {
        ink = tabLabel.dark
    }
    return modifierContextApply(
        modifiers,
        modifierDeltaTextInk(ink.color.toFoundation(1.0), copy ink.blend)
    )
}

// The capsule behind a tab: the selection's when it is selected, burned or
// dodged into the glass, and nothing otherwise.
public function tabBarItemFill(
    selected: Bool,
    radius: Number,
    modifiers: borrow ModifierContext
) -> CASolid {
    if !selected {
        return CASolid { fill: CAColor { a: 0.0 }, cornerRadius: radius }
    }
    var ink = tabSelection.light
    if modifierAppearance(modifiers) == .Dark {
        ink = tabSelection.dark
    }
    return CASolid {
        fill: colorFromFoundation(
            modifierColor(foundationColor(ink.color.toFoundation(1.0)), modifiers)
        ),
        cornerRadius: radius,
        blend: ink.blend
    }
}

// The bar a tab view's tabs float in: one capsule of glass holding them off
// every side.
function tabBarCapsule(
    tabs: [CALayerDescription],
    context: borrow BuildContext,
    modifiers: borrow ModifierContext,
) -> CALayerDescription {
    let metrics = tabBarMetrics()
    let row = CALayerDescription {
        layout: CALayoutIntent {
            axis: .Row,
            widthFill: false,
            heightFill: false,
            paddingLeading: metrics.inset,
            paddingTop: metrics.inset,
            paddingTrailing: metrics.inset,
            paddingBottom: metrics.inset,
            alignment: Point { x: 0.0, y: 0.5 }
        },
        sublayers: move tabs
    }
    return interactiveGlassDescription(
        context,
        tapSeqKey(),
        CALayoutIntent {
            widthFill: false,
            heightFill: false,
            fixedHeight: metrics.height,
            alignment: Point { x: 0.0, y: 0.5 }
        },
        containerShapeRadius(.Capsule, modifiers),
        .Capsule,
        modifiers,
        [row]
    )
}

// --- The phone's bar -----------------------------------------------------------

// One tab on a phone's bar, pressed to select it.
public function phoneTabBarItem(
    label: borrow Any Widget,
    selected: Bool,
    select: () -> Void,
    context: borrow BuildContext,
    modifiers: borrow ModifierContext,
) -> CALayerDescription {
    let key = tapSeqKey()
    layerActionRegister(key, move select)
    var item = phoneTabBarItemFace(
        phoneTabBarInkedLabel(label, selected, context, modifiers),
        selected,
        modifiers
    )
    item.hittable = !modifiers.disabled
    item.hitKey = key
    return item
}

// What a phone's tab looks like, with nothing to press: its label stacked
// under its top and held off its ends, on the selection capsule when it is the
// one selected. The capsule is the tab's whole box, which reaches past the
// tab's own ends into the next one's.
public function phoneTabBarItemFace(
    label: CALayerDescription,
    selected: Bool,
    modifiers: borrow ModifierContext,
) -> CALayerDescription {
    let bar = phoneTabBarMetrics
    let radius = bar.tabHeight / 2.0
    return CALayerDescription {
        layout: CALayoutIntent {
            axis: .Column,
            widthFill: false,
            heightFill: false,
            fixedWidth: bar.tabWidth,
            fixedHeight: bar.tabHeight,
            paddingLeading: bar.sideInset,
            paddingTop: bar.topInset,
            paddingTrailing: bar.sideInset,
            alignment: Point { x: 0.5, y: 0.0 }
        },
        cornerRadius: radius,
        content: .Solid(phoneTabBarItemFill(selected, radius, modifiers)),
        sublayers: [move label]
    }
}

// The capsule behind a phone's selected tab: the selection's ink laid over the
// glass as it is, where the iPad's is burned or dodged into it, and nothing
// behind any other tab.
public function phoneTabBarItemFill(
    selected: Bool,
    radius: Number,
    modifiers: borrow ModifierContext
) -> CASolid {
    if !selected {
        return CASolid { fill: CAColor { a: 0.0 }, cornerRadius: radius }
    }
    var ink = tabSelection.light
    if modifierAppearance(modifiers) == .Dark {
        ink = tabSelection.dark
    }
    return CASolid {
        fill: colorFromFoundation(
            modifierColor(foundationColor(ink.color.toFoundation(1.0)), modifiers)
        ),
        cornerRadius: radius
    }
}

// `label` set as a phone's tab sets it: its symbol over its title, in the
// vibrant label's ink, or through the selected tab's mask when it is the one
// selected.
public function phoneTabBarInkedLabel(
    label: borrow Any Widget,
    selected: Bool,
    context: borrow BuildContext,
    modifiers: borrow ModifierContext,
) -> CALayerDescription {
    let presented = modifierContextPresenting(modifiers, .PhoneTabBar)
    if selected {
        var layers: [CALayerDescription] = []
        for ink in tabBarSelectedInks(presented) {
            layers.append(label.describe(context, ink))
        }
        return tabBarInked(move layers)
    }
    if tabBarTinted(presented) {
        return label.describe(context, tabBarItemInk(false, presented))
    }
    var ink = vibrantLabelInk.light
    if modifierAppearance(presented) == .Dark {
        ink = vibrantLabelInk.dark
    }
    return label.describe(
        context,
        modifierContextApply(
            presented,
            modifierDeltaTextInk(ink.color.toFoundation(1.0), copy ink.blend)
        )
    )
}

// The bar a phone's tabs float in: one capsule of glass reaching past them,
// centered at the foot of the window. Its tabs keep their width while they
// fit inside the screen's margins, and share that room when they do not.
public function phoneTabBar(
    tabs: [CALayerDescription],
    context: borrow BuildContext,
    modifiers: borrow ModifierContext,
) -> CALayerDescription {
    let bar = phoneTabBarMetrics
    var row = move tabs
    let count = Number(row.count)
    let room = context.viewportWidth - bar.edgeInset * 2.0
    if count * bar.tabWidth - (count - 1.0) * bar.tabOverlap > room {
        let width = (room + (count - 1.0) * bar.tabOverlap) / count
        for i in 0..row.count {
            row[i].layout.fixedWidth = width
        }
    }
    let tabsRow = CALayerDescription {
        layout: CALayoutIntent {
            axis: .Row,
            spacing: -bar.tabOverlap,
            widthFill: false,
            heightFill: false,
            paddingLeading: bar.glassOutset,
            paddingTop: bar.glassOutset,
            paddingTrailing: bar.glassOutset,
            paddingBottom: bar.glassOutset,
            alignment: Point { x: 0.0, y: 0.5 }
        },
        sublayers: move row
    }
    let glass = interactiveGlassDescription(
        context,
        tapSeqKey(),
        CALayoutIntent {
            widthFill: false,
            heightFill: false,
            fixedHeight: bar.tabHeight + bar.glassOutset * 2.0,
            alignment: Point { x: 0.0, y: 0.5 }
        },
        containerShapeRadius(.Capsule, modifiers),
        .Capsule,
        modifiers,
        [tabsRow]
    )
    return CALayerDescription {
        layout: CALayoutIntent {
            paddingBottom: bar.bottomInset - bar.glassOutset,
            alignment: Point { x: 0.5, y: 1.0 }
        },
        sublayers: [glass]
    }
}

@Instance(Number)
@Instance(String)
public construct TabView<SelectionValue>(selection: Binding<SelectionValue>) extends Widget {
    let children: [some Widget]

    body {
        TagScope(selector: tagSelector(.Tab, selection)) {
            ZStack(alignment: .TopLeading) {
                For(tab in children) {
                    tab
                }
            }
            .fillWidth()
            .fillHeight()
        }
    }
}
