import Foundation

// An app, as SwiftUI's `App` is: its body is what its window shows, and
// `@Main` on it makes the program run it.
//
//     @Main
//     construct ShowcaseApp() extends App {
//         body {
//             ShowcaseRootView()
//         }
//     }
//
// The window builds the body again whenever the interface is, so what the
// body reads, its `@Environment` and `@State` properties included, is read
// afresh each time.
public construct App {
    @Required let body: Any Widget

    // Runs the app in a window of its own until the window closes.
    function main() {
        let app = copy self
        RunKiraWindowApp("", 1280, 720, { in
            return app.body
        })
    }
}
