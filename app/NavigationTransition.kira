import Foundation
import KiraGraphics
import KCoreAnimation

// How a stack moves between its views, matching UIKit's push and pop.
//
// A pushed view slides in from the trailing edge over the one it covers; going
// back slides it off again. Going back is also a swipe: two fingers on a
// trackpad or one on a screen, started anywhere on the view that is not a
// control and moved across it toward the trailing edge. The view follows the
// fingers, and when they lift it either goes the rest of the way or settles
// back, by how far it went and how fast it was thrown. A mouse never swipes:
// neither its wheel nor a drag is a gesture of the view's.
//
// While the stack moves it shows two views at once, by their paths: the one
// moving (`front`) and the one under it (`covered`). The path itself changes
// at once, as the push or the pop happens; the transition only remembers what
// was on screen so the stack can keep showing it until the motion ends.
//
// The motion itself is the compositor's, as a UIKit transition is Core
// Animation's. The stack describes its pages twice: once where the motion
// starts, at once, so the view coming in has somewhere to come in from, and
// once where it ends, in a transaction on the push spring. The compositor
// carries them between the two, and nothing is built again until the spring
// settles -- a transition costs the frames it draws, not a build of the whole
// interface for each of them. Only fingers move the pages frame by frame,
// because only they know where the pages go next.

public struct KiraUiNavigationTransition {
    var active: Bool = false
    var front: [Any NavigationValue] = []
    var covered: [Any NavigationValue] = []
    // How far the front view is off the page: 0 in place, 1 gone. Live: where
    // the fingers have it, or where the spring has it as of the last build.
    var progress: Float = 0.0
    var spring: MotionSpringState = MotionSpringState {}
    // Where the stack describes the front view: the spring's target, under
    // the fingers while they drag.
    var shown: Float = 0.0
    // Whether the compositor has been handed the motion; when it was, and
    // when the spring will have settled.
    var started: Bool = false
    var startedAt: Float = 0.0
    var settlesAt: Float = 0.0
    // The frame the motion ended on, which lands the pages where they rest
    // at once rather than animating the last of it.
    var landedOn: Int = -1
    // Whether fingers are moving the view rather than the spring.
    var dragging: Bool = false
    // A swipe that began and has not yet moved far enough to be one, the way
    // it has moved so far, and where a touch last was.
    var tracking: Bool = false
    var travel: Float = 0.0
    var drift: Float = 0.0
    var lastX: Float = 0.0
    var lastY: Float = 0.0
    // How fast the fingers are going across, in points a second: what they
    // moved since the last frame, turned into a speed when the frame comes.
    var pending: Float = 0.0
    var velocity: Float = 0.0
    // How wide the view is, which is how far it has to go to be gone.
    var width: Float = 1.0
    // How many values at the head of the path are a sidebar's selection rather
    // than views pushed: 1 beside a sidebar, whose chosen row is the stack's
    // root and is not gone back from; 0 otherwise.
    var rootDepth: Int = 0
    // A back button pressed while the stack was still moving: held until the
    // motion ends, and only then gone back on.
    var heldBack: Bool = false
    // The frame the transition last advanced on: a split view and the stack
    // in its detail both advance it, and it moves once.
    var advancedOn: Int = -1
    // Whether a stacked split view is sliding its detail over its sidebar,
    // which a stack in the detail then leaves to it; see `NavigationSplitView`.
    var splitSlides: Bool = false
}

public function kiraUiNavigationTransitionKey() -> String {
    return "kiraui.navigation.transition"
}

public function kiraUiNavigationTransitionEnsure() {
    if kiraUiStateSlotHas(kiraUiNavigationTransitionKey()) == false {
        kiraUiStateSlotPut(
            kiraUiNavigationTransitionKey(),
            nativeUserData(nativeState(KiraUiNavigationTransition {}))
        )
    }
    return
}

// The transition as it stands, to read.
public function kiraUiNavigationTransition() -> KiraUiNavigationTransition {
    kiraUiNavigationTransitionEnsure()
    return nativeRecover<KiraUiNavigationTransition>(kiraUiStateSlotGet(kiraUiNavigationTransitionKey()))
}

// The front view starts `from` and the spring takes it to `to`, carrying the
// speed it already had. A page not yet on screen enters from where `from`
// puts it; one already there -- a swipe let go, a motion turned around -- is
// taken from where it stands.
public function navigationTransitionSpring(state: borrow mut KiraUiNavigationTransition, from: Float, to: Float, velocity: Float) {
    let metrics = navigationTransitionMetrics
    // Slowed animations stretch the spring's time, which its response is.
    let slowdown = max(Float(kiraUiClockState().slowdown), 1.0)
    var spring = MotionSpring { response: metrics.pushResponse * slowdown, damping: metrics.pushDamping, target: to }
    if kiraUiReducedMotion() {
        spring = motionCurveReduced(spring)
    }
    state.spring = motionSpringStart(move spring, from, velocity)
    state.progress = from
    state.shown = from
    state.started = false
    state.dragging = false
    state.active = true
    return
}

// How long the spring takes to settle, to the tolerance the compositor's own
// channels settle to, so the build that ends the motion comes on the frame
// the pages arrive.
public function navigationSpringDuration(spring: borrow MotionSpringState) -> Float {
    let step = 1.0 / 240.0
    var t = step
    while t < 4.0 {
        let sample = motionSpringSample(spring, t)
        if motionSpringSettled(spring, sample, motionSpringEpsilon()) {
            return t
        }
        t = t + step
    }
    return t
}

// Where the spring has the front view at `now`.
public function navigationTransitionLive(state: borrow KiraUiNavigationTransition, now: Float) -> Float {
    if !state.started {
        return state.shown
    }
    let sample = motionSpringSample(state.spring, now - state.startedAt)
    return min(max(sample.value, 0.0), 1.0)
}

// The transaction the moving pages change in: the push spring while the
// compositor carries them, at once on the frame the motion starts or lands
// and under fingers, which move them themselves.
public function navigationTransitionAnimation(state: borrow KiraUiNavigationTransition, frameCount: Int) -> CALayerAnimation {
    if !state.active || state.dragging || !state.started || state.landedOn == frameCount {
        return .Timed(caImmediateTiming())
    }
    // The speed the spring started with, as a fraction of its way per second.
    let span = state.spring.spring.target - state.spring.origin
    var velocity = 0.0
    if abs(span) > 0.0001 {
        velocity = state.spring.velocity / span
    }
    return .Timed(caMeasuredSpringTiming(state.spring.spring.response, state.spring.spring.damping, velocity, false))
}

// A push: the new view comes in over the one that was showing.
public function kiraUiNavigationTransitionPush(before: [Any NavigationValue], after: [Any NavigationValue]) {
    kiraUiNavigationTransitionEnsure()
    var state = nativeRecover<KiraUiNavigationTransition>(kiraUiStateSlotGet(kiraUiNavigationTransitionKey()))
    state.front = move after
    state.covered = move before
    navigationTransitionSpring(state, 1.0, 0.0, 0.0)
    return
}

// A pop: the view that was showing goes off the one under it.
public function kiraUiNavigationTransitionPop(before: [Any NavigationValue], after: [Any NavigationValue]) {
    kiraUiNavigationTransitionEnsure()
    var state = nativeRecover<KiraUiNavigationTransition>(kiraUiStateSlotGet(kiraUiNavigationTransitionKey()))
    // A push still coming in turns around where it is: both its pages are
    // on screen, already moving, and the compositor retargets them there.
    let turning = state.active
    let now = kiraUiClockNow()
    let from = turning ? navigationTransitionLive(state, now) : 0.0
    var velocity = 0.0
    if turning && state.started {
        velocity = motionSpringSample(state.spring, now - state.startedAt).velocity
    }
    state.front = move before
    state.covered = move after
    navigationTransitionSpring(state, from, 1.0, velocity)
    return
}

// The path was replaced outright, as choosing a sidebar's row does: whatever
// was moving stops, and the new view is simply there.
public function kiraUiNavigationTransitionCancel() {
    kiraUiNavigationTransitionEnsure()
    var state = nativeRecover<KiraUiNavigationTransition>(kiraUiStateSlotGet(kiraUiNavigationTransitionKey()))
    state.active = false
    state.dragging = false
    state.tracking = false
    state.heldBack = false
    return
}

// One build of the transition, as the stack lowers: the fingers' speed is
// brought up to date, and where the stack describes the pages is decided --
// where the motion ends, with a build asked for when the compositor will have
// taken them there.
public function kiraUiNavigationTransitionAdvance(context: borrow BuildContext) {
    kiraUiNavigationTransitionEnsure()
    var state = nativeRecover<KiraUiNavigationTransition>(kiraUiStateSlotGet(kiraUiNavigationTransitionKey()))
    if state.advancedOn == context.frameCount {
        return
    }
    state.advancedOn = context.frameCount
    state.width = max(context.viewportWidth, 1.0)
    let delta = kiraUiClockDelta()
    if delta > 0.0 {
        state.velocity = state.velocity * 0.4 + (state.pending / delta) * 0.6
    }
    state.pending = 0.0
    if !state.active {
        return
    }
    if state.dragging {
        state.shown = state.progress
        return
    }
    let now = kiraUiClockNow()
    if !state.started {
        state.started = true
        state.startedAt = now
        state.settlesAt = now + navigationSpringDuration(state.spring)
    }
    if now >= state.settlesAt {
        state.active = false
        state.started = false
        state.progress = 0.0
        state.shown = 0.0
        state.landedOn = context.frameCount
        if state.heldBack {
            state.heldBack = false
            navigationTransitionReleaseBack(state.rootDepth)
            // The back it held starts a pop of its own, and this build has
            // already advanced: the next one starts it.
            kiraUiClockStillMoving()
        }
        return
    }
    state.progress = navigationTransitionLive(state, now)
    state.shown = state.spring.spring.target
    kiraUiClockWakeAt(state.settlesAt)
    return
}

// Where a page coming on screen enters from: where the spring started, or
// under the fingers, which describe it where it is.
public function navigationTransitionFrom(state: borrow KiraUiNavigationTransition) -> Float {
    return state.dragging ? state.shown : state.spring.origin
}

// Whether the spring is taking a view off: a pop on its way, the path already
// gone back. Fingers that come down on one go back from the view under it.
public function navigationTransitionPopping(state: borrow KiraUiNavigationTransition) -> Bool {
    return state.active && !state.dragging && state.spring.spring.target > 0.5
}

// Whether the stack is going back: popping, or under fingers swiping back.
public function kiraUiNavigationGoingBack() -> Bool {
    let state = kiraUiNavigationTransition()
    return state.active && (state.dragging || state.spring.spring.target > 0.5)
}

// The back button was pressed. It takes the press however the stack stands,
// but goes back only from a view that has stopped: pressed mid-motion it waits
// for the motion to end, so it never goes back from a view already leaving.
public function kiraUiNavigationBack() {
    kiraUiNavigationTransitionEnsure()
    var state = nativeRecover<KiraUiNavigationTransition>(kiraUiStateSlotGet(kiraUiNavigationTransitionKey()))
    if state.active {
        state.heldBack = true
        return
    }
    navigationTransitionReleaseBack(state.rootDepth)
    return
}

// A held press goes back once the motion ends -- if, where it ended, there is
// still a view to go back to. It lands at once, in the frame the motion ended
// in, so the stack goes straight on into it.
public function navigationTransitionReleaseBack(rootDepth: Int) {
    if kiraUiNavigationValues().count > rootDepth {
        kiraUiNavigationPop()
        kiraUiNavigationSettle()
    }
    return
}

// A stacked split view is sliding its detail over its sidebar, or has stopped.
public function kiraUiNavigationSetSplitSlides(slides: Bool) {
    kiraUiNavigationTransitionEnsure()
    var state = nativeRecover<KiraUiNavigationTransition>(kiraUiStateSlotGet(kiraUiNavigationTransitionKey()))
    state.splitSlides = slides
    return
}

// How deep the stack's root is in the path; see `rootDepth`.
public function kiraUiNavigationSetRootDepth(depth: Int) {
    kiraUiNavigationTransitionEnsure()
    var state = nativeRecover<KiraUiNavigationTransition>(kiraUiStateSlotGet(kiraUiNavigationTransitionKey()))
    state.rootDepth = depth
    return
}

public function kiraUiNavigationRootDepth() -> Int {
    return kiraUiNavigationTransition().rootDepth
}

// --- The swipe back -----------------------------------------------------------

// Fingers came down at this point. They may become a swipe back when the stack
// has somewhere to go back to and they are on the view itself -- past the
// sidebar, and on no control. A push still moving, or a view settling back, is
// caught where it stands, as UIKit's transitions are: the fingers take the
// view from there. A pop still moving has already gone back, so the fingers
// go back again from the view it uncovered, and need not wait for it.
public function kiraUiNavigationSwipeBegin(x: Float, y: Float, overControl: Bool) {
    kiraUiNavigationTransitionEnsure()
    var state = nativeRecover<KiraUiNavigationTransition>(kiraUiStateSlotGet(kiraUiNavigationTransitionKey()))
    state.tracking = false
    let depth = state.active && !navigationTransitionPopping(state) ? state.front.count : kiraUiNavigationValues().count
    if state.dragging || overControl || depth <= state.rootDepth {
        return
    }
    if x < kiraUiToolbarNavigationWidth() {
        return
    }
    state.tracking = true
    state.travel = 0.0
    state.drift = 0.0
    state.lastX = x
    state.lastY = y
    state.velocity = 0.0
    state.pending = 0.0
    return
}

// The fingers moved this far, toward the trailing edge when `across` is
// positive. Whether anything is being swiped, so the caller knows the motion
// was taken.
public function kiraUiNavigationSwipeMove(across: Float, down: Float) -> Bool {
    kiraUiNavigationTransitionEnsure()
    var state = nativeRecover<KiraUiNavigationTransition>(kiraUiStateSlotGet(kiraUiNavigationTransitionKey()))
    if state.dragging {
        state.progress = min(max(state.progress + across / state.width, 0.0), 1.0)
        state.pending = state.pending + across
        kiraUiClockStillMoving()
        return true
    }
    if !state.tracking {
        return false
    }
    state.travel = state.travel + across
    state.drift = state.drift + abs(down)
    if abs(state.travel) < navigationTransitionMetrics.swipeSlop && state.drift < navigationTransitionMetrics.swipeSlop {
        return false
    }
    state.tracking = false
    // Only a motion more across than down, and toward the trailing edge, is a
    // swipe back; anything else belongs to whatever is under the fingers.
    if state.travel <= state.drift {
        return false
    }
    // The pop the fingers came down on is done: its view is gone at once and
    // the swipe is a new one, from where the path now stands.
    if navigationTransitionPopping(state) {
        state.active = false
        state.heldBack = false
    }
    // A motion the compositor is carrying is caught where it has the view.
    if state.active {
        state.progress = navigationTransitionLive(state, kiraUiClockNow())
        state.started = false
    }
    state.dragging = true
    state.pending = state.travel
    kiraUiClockStillMoving()
    if state.active {
        return true
    }
    let path = kiraUiNavigationValues()
    var under: [Any NavigationValue] = []
    var index = 0
    while index < path.count - 1 {
        under.append(copy path[index])
        index = index + 1
    }
    state.front = move path
    state.covered = move under
    state.active = true
    state.progress = 0.0
    state.shown = 0.0
    return true
}

// The same for a touch, which reports where it is rather than how far it went.
public function kiraUiNavigationSwipeTouchMove(x: Float, y: Float) -> Bool {
    kiraUiNavigationTransitionEnsure()
    var state = nativeRecover<KiraUiNavigationTransition>(kiraUiStateSlotGet(kiraUiNavigationTransitionKey()))
    let across = x - state.lastX
    let down = y - state.lastY
    state.lastX = x
    state.lastY = y
    return kiraUiNavigationSwipeMove(across, down)
}

// The fingers lifted. Past the commit fraction, or thrown faster than the
// commit velocity, the stack goes back; otherwise the view settles where it
// was -- which, for a pop the fingers caught, takes the path forward again.
// A throw back toward the leading edge always settles.
public function kiraUiNavigationSwipeEnd() {
    kiraUiNavigationTransitionEnsure()
    var state = nativeRecover<KiraUiNavigationTransition>(kiraUiStateSlotGet(kiraUiNavigationTransitionKey()))
    state.tracking = false
    if !state.dragging {
        return
    }
    let metrics = navigationTransitionMetrics
    let speed = state.velocity
    let thrown = speed > metrics.commitVelocity
    let held = state.progress > metrics.commitFraction && speed > 0.0 - metrics.commitVelocity
    let from = state.progress
    let carried = speed / state.width
    if thrown || held {
        kiraUiNavigationStore(copy state.covered)
        navigationTransitionSpring(state, from, 1.0, carried)
        return
    }
    kiraUiNavigationStore(copy state.front)
    navigationTransitionSpring(state, from, 0.0, carried)
    return
}
