import KiraGraphics
import Foundation
import KiraLayout
import KiraUIFoundation

// Painted containers.
//
// A themed box is `.background(RoundedRectangle(radius: …))` on the content —
// see the note further down. `SurfaceBox` is the low-level escape hatch for the
// rare case that needs to name explicit colors.

// --- Glass -------------------------------------------------------------------

// Which of the platform's material steps this style's Liquid Glass is.
//
// `MaterialLevel` names four; the foundation's table has six, and the two it
// adds are the ends — a fully clear step no platform material occupies, and
// Chrome, which is a different kind of surface rather than a heavier one. So the
// four map onto the middle of the table and the ends stay reachable only by
// naming them.
function surfaceGlassFrostFor(level: borrow MaterialLevel) -> FoundationFrost {
    match level {
        Low -> return .Light;
        Medium -> return .Medium;
        // Regular, which is what an iOS menu and an inspector are made of.
        High -> return .High;
        XHigh -> return .XHigh;
    }
}

// The step the THEME asks for, rather than one figure for every glass surface
// in the library. A style that states `.XHigh` and is drawn at `.Medium` is a
// style that does not decide what its own material is.
function surfaceGlassFrost(modifiers: borrow ModifierContext) -> FoundationFrost {
    return surfaceGlassFrostFor(modifierTokens(modifiers).glassLevel)
}

// The glass scheme follows the SAME appearance the theme's color tokens resolve
// through. Sniffing the environment here independently is how a light token set
// used to end up washed over a dark glass stack.
function surfaceGlassScheme(modifiers: borrow ModifierContext) -> FoundationScheme {
    match modifierTheme(modifiers).appearance() {
        Light -> return .Light;
        Dark -> return .Dark;
    }
}

function surfaceGlassStack(modifiers: borrow ModifierContext) -> FoundationTintStack {
    return foundationFrostStack(surfaceGlassFrost(modifiers), surfaceGlassScheme(modifiers))
}

function surfaceGlassMaterial(
    material: borrow Material,
    modifiers: borrow ModifierContext,
) -> FoundationGlassMaterial {
    match material {
        LayeredGlass -> {
            let stack = surfaceGlassStack(modifiers)
            let base = FoundationGlassMaterial {}
            return foundationGlassMaterialWithTint(
                base,
                stack
            )
        }
        Flat -> return FoundationGlassMaterial {}
        Frosted -> return FoundationGlassMaterial {}
        WindowBackdrop -> return FoundationGlassMaterial {}
    }
}

function surfaceGlassFill(
    fill: Color,
    material: borrow Material,
    modifiers: borrow ModifierContext,
) -> FoundationColor {
    // A Liquid Glass surface owns its wash. Passing a token fill through here
    // used to turn the material's lower layer into an opaque rectangle, hiding
    // the captured backdrop. Use the named Foundation stack instead; an explicit
    // `.fill(...)` remains an intentional override.
    if modifiers.hasFill == false && material == .LayeredGlass {
        // Through the opacity in effect, like every other fill this function can
        // return. The stack is the material's OWN wash and does not know about
        // the modifiers around it, so taking it straight left `.opacity(...)` with
        // no effect on glass at all: a panel asked to fade held full strength for
        // the whole of its fade and then disappeared on the frame its value ran
        // out. Anything that opens or closes on glass — a menu, a popover, a
        // sheet — is that panel.
        return modifierColor(foundationTintFill(surfaceGlassStack(modifiers)), modifiers)
    }
    return modifierSurfaceFill(foundationColor(move fill), modifiers)
}

// Derived from the step, so a heavier material is a blurrier one without the
// two ever being stated apart and drifting.
function surfaceGlassBlur(material: borrow Material, modifiers: borrow ModifierContext) -> Float {
    match material {
        LayeredGlass -> return foundationFrostBlur(surfaceGlassFrost(modifiers));
        Flat -> return 1.0;
        Frosted -> return 1.0;
        WindowBackdrop -> return 1.0;
    }
}

// Painted containers are NOT a widget here.
//
// SwiftUI has no `Panel`: a themed box is content with a shape behind it —
//
//     content.background(RoundedRectangle(radius: .Small))
//         .backgroundStyle(.Surface)
//         .material(.LayeredGlass)
//
// which is the same five tokens the container used to take as arguments, minus
// the container. The difference matters because a container can only paint the
// combinations it declared parameters for, and every combination it did not is
// a second container someone has to add; a background is one modifier that
// composes with every other one already there. `Shapes.kira` holds the shapes
// and `SurfaceBox` below is still the escape hatch for explicit colours.

// --- Section -----------------------------------------------------------------

// A run of rows under a header, grouped the way SwiftUI's `Section` groups one:
//
//     Section {
//         Picker(label = "Mode", options = modes(), selection = mode, onSelect = chooseMode)
//         Toggle(isOn = blurOn, onToggle = toggleBlur)
//     } header: {
//         Text("Liquid Glass")
//     } footer: {
//         Text("Applies to every layer.")
//     }
//
// `header` and `footer` are VIEWS, as they are in SwiftUI — a header carrying a
// scope picker beside its title is a header, not a special case the section has
// to declare an argument for. The section supplies their presentation (the
// footnote size and the secondary ink a grouped header is set in) and each one
// keeps whatever it states for itself, since the nearer modifier wins.
//
// The rows sit together on one raised surface and the header sits above it at
// the group's own inset. Writing that per section is what produced headers lined
// up with nothing. Consecutive rows are divided by a hairline, the way a grouped
// list divides them: a card of rows with nothing between them reads as one
// control, not as a list of properties.
//
// Every length here comes from the size class, so `.controlSize(.Small)` on the
// panel is the whole statement of how dense the section is.
construct Section(spacing: Spacing = .ExtraSmall) extends Widget {
    // The rows are the bare block, and the two lines around them name their own
    // slots: `Section { … } header: { … } footer: { … }`. Both default to
    // nothing, so a section states only the lines it has.
    let children: [some Widget]
    let header: some Widget = EmptyView()
    let footer: some Widget = EmptyView()

    function lower(context: borrow FoundationUiContext, modifiers: borrow ModifierContext) -> FoundationView {
        let metrics = resolvedControlMetrics(modifiers)
        // A row's content begins where the card's corner arc ends, so the card's
        // radius IS the inset and the rows are told it rather than carrying a
        // number of their own. Stated separately the two drift: an eleven-point
        // inset inside a twelve-point corner starts the label a point under the
        // arc, and retuning the radius leaves the inset behind entirely.
        let cardRadius = cornerRadiusImplementation(.Medium, modifiers)
        let inset = modifierContextApply(modifiers, modifierDeltaContentInset(cardRadius))
        let rows = sectionRowViews(context, inset, children, metrics)
        let card = Column(
            children: move rows,
            width: .Fill,
            height: .Hug,
            spacing: 0.0,
            padding: uniformInsets(metrics.cardPadding),
            crossAxisAlignment: .Stretch
        )
        let section = VStack(spacing: spacing) {
            SectionBand(inset: metrics.headerInset, height: metrics.headerHeight) {
                header
            }
            .typography(.footnote)
            .foregroundColor(.Secondary)

            FoundationRaw(view: move card)
            .background(RoundedRectangle(cornerRadius: cardRadius))
            .backgroundStyle(.Raised)
            .hugHeight()

            SectionBand(inset: metrics.headerInset, height: metrics.headerHeight) {
                footer
            }
            .typography(.caption)
            .foregroundColor(.Tertiary)
        }
        return section.lower(context, modifiers)
    }
}

// A header or footer line: its content across the section's width, held off the
// card's leading and trailing edges.
construct SectionBand(inset: Float, height: Float) extends Widget {
    let content: some Widget

    function lower(context: borrow FoundationUiContext, modifiers: borrow ModifierContext) -> FoundationView {
        let band = HStack(spacing: .None, alignment: .Center) {
            content
        }
        return Frame(
            band.lower(context, modifiers),
            .Fill,
            .Fixed(height),
            0,
            .Leading,
            EdgeInsets {
                leading: inset
                trailing: inset
            }
        )
    }
}

// The section's rows with a hairline between each consecutive pair.
function sectionRowViews(
    context: borrow FoundationUiContext,
    modifiers: borrow ModifierContext,
    children: [Any Widget],
    metrics: borrow ControlMetricsImplementation,
) -> [FoundationView] {
    var rows: [FoundationView] = []
    let childModifiers = modifierContextForChildren(modifiers)
    var index = 0
    while index < children.count {
        if index > 0 {
            // How far the hairline is held off the card's edges is the
            // divider's own decision, taken from the size class.
            rows.append(Divider().themeBorder(.Subtle).lower(context, modifiers))
        }
        rows.append(children[index].lower(context, childModifiers))
        index = index + 1
    }
    return rows
}
