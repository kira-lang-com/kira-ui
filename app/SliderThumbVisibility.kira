import Foundation

extend Widget {
    // SwiftUI: `.sliderThumbVisibility(_ visibility: Visibility)`.
    // This inherited control environment is consumed by Slider itself; it
    // changes the knob drawing, not the accessible value or its drag gesture.
    function sliderThumbVisibility(visibility: Visibility) -> Any Widget {
        return ModifierDeltaLayer(
            delta: modifierDeltaSliderThumbVisibility(visibility)
        ) { self }
    }
}