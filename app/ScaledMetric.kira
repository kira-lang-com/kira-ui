import Foundation

// SwiftUI's `@ScaledMetric`: a length an application states for its own views,
// scaled with the type the interface is drawn in.
//
// Every length a modifier takes is one of these. `scaledMetric(points)` states
// it at the mobile size, where the kit draws, and on a desktop it takes the
// ratio its text style takes there, 13 to 17 for the body. A bare number is
// not a length: it was meant for one size and says nothing of the other.
public struct ScaledMetric {
    let points: Number
}

public function scaledMetric(points: Number, relativeTo: TypographyStyle = .body) -> ScaledMetric {
    if interfaceMode() == .AdaptiveMobile {
        return ScaledMetric { points: points }
    }
    let desktop = desktopTypography.font(relativeTo).size
    return ScaledMetric { points: points * desktop / mobileTypography.font(relativeTo).size }
}

// A length already at the size the interface is drawn at: one the catalog
// states for the mode in effect, or one worked out from such lengths. The
// toolkit's own views hand theirs to a modifier as this.
public function resolvedLength(points: Number) -> ScaledMetric {
    return ScaledMetric { points: points }
}
