import Foundation

extend Widget {
    // SwiftUI's `.labelsVisibility(_:)` controls the inherited label
    // visibility of labeled controls. `Automatic` restores the normal control
    // presentation in KiraUI; `Visible` explicitly re-enables a label below
    // a hidden ancestor; `Hidden` uses the same semantic channel as
    // `.labelsHidden()`. Do not treat this as whole-view opacity.
    function labelsVisibility(visibility: Visibility) -> Any Widget {
        return ModifierDeltaLayer(
            delta: modifierDeltaLabelsHidden(visibility == .Hidden)
        ) { self }
    }
}