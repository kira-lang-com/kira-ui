import Foundation
import KiraGraphics
import KiraLayout
import KCoreAnimation

// A menu, and the submenus that open inside it.
//
//     ContextMenu {
//         Button("Start Slideshow", systemImage: .PlayRectangle, action: startSlideshow)
//
//         Menu("Add To", systemImage: .PhotoOnRectangle) {
//             Button("Album", action: addToAlbum)
//             Button("Shared Album", action: addToShared)
//         }
//     }
//
// # A submenu opens out of its own row
//
// The platform's submenu does not fly a second panel out to the side. The row
// that owns it becomes the header of a card of its own, exactly as wide as the
// menu was, and the card opens out of the row: its top rises to leave air
// over the header, its bottom falls past the last item, and the header rides
// up between them, set emphasized, its chevron turned down. The card's items
// are there almost at once, uncovered where they will stay; its glass comes up
// over the menu's only once it is half open. The card stays where the row was
// unless it would run off the window, and then rises as far as it has to.
//
// Everything else in the menu falls back behind it -- smaller, toward where
// the menu came from, and dimmer -- so the submenu is the only thing at the
// front. Pressing the header again, or anywhere on the menu behind, puts it
// back: the items go first, and the card closes into a pill on the row.
//
// The row keeps its place in the menu while it is out, so nothing below it
// moves, and the card is presented over the menu at the row's rectangle.
//
// # Going waits, coming back does not
//
// Measured off the platform's menu frame by frame. The card opens and closes
// on one short critically damped spring, and the menu behind shrinks on that
// same spring. Its ink does not: going, it HOLDS at full strength while the
// submenu arrives and only then dims, slowly -- a spring cannot express a
// hold, since a spring starts moving immediately, so it is a hold and then a
// spring. Coming back there is no hold and the ink returns in a fraction of
// the time: what you are returning to arrives first.

// --- measured metrics --------------------------------------------------------
//
// From Apple's iOS and iPadOS 27 design kit, its iPad menu: a 238pt card with
// ten points of air top and bottom, 36pt rows held 16pt off its edges, a 28pt
// glyph column eight points before 15pt titles, and separators that are a line
// in a 16pt band.

// Menu geometry resolves through the active control-size table. The regular
// defaults are the kit's; Mini/Small/Large are theme-owned variants in
// Metrics.kira.
function menuRowPitch(modifiers: borrow ModifierContext) -> Float {
    return resolvedControlMetrics(modifiers).menuRowHeight
}

function menuRowLeading(modifiers: borrow ModifierContext) -> Float {
    return resolvedControlMetrics(modifiers).menuLeadingInset
}

function menuRowTrailing(modifiers: borrow ModifierContext) -> Float {
    return resolvedControlMetrics(modifiers).menuTrailingInset
}

function menuLabelSize(modifiers: borrow ModifierContext) -> Float {
    return resolvedControlMetrics(modifiers).menuLabelSize
}

// The corner every menu card takes -- the panel and the submenu that opens over
// it alike. It is part of menu presentation geometry, so it resolves through the
// active metric table rather than living as a private literal here.
function menuCardRadius(modifiers: borrow ModifierContext) -> Float {
    return resolvedControlMetrics(modifiers).menuCardRadius
}

// --- the submenu's motion ---------------------------------------------------
//
// Every number is the catalog's, measured off the platform's menu; see
// `MenuSubmenuMetrics`.

// The submenu's card growing out of its row, and going back into it.
function menuSubmenuSpring(opening: Bool) -> MotionSpring {
    let metrics = menuSubmenuMetrics
    if opening {
        return MotionSpring { response: metrics.openResponse, damping: metrics.openDamping, target: 1.0 }
    }
    return MotionSpring { response: metrics.closeResponse, damping: metrics.closeDamping, target: 0.0 }
}

// The menu behind it falling back. Slow, and it starts late -- see
// `recedeHold`.
function menuRecedeInSpring() -> MotionSpring {
    return MotionSpring { response: menuSubmenuMetrics.recedeInResponse, damping: menuSubmenuMetrics.recedeInDamping, target: 1.0 }
}

// The menu behind it coming back. Nothing like the same motion, and no hold at
// all: the thing you are returning to does not wait.
function menuRecedeOutSpring() -> MotionSpring {
    return MotionSpring { response: menuSubmenuMetrics.recedeOutResponse, damping: menuSubmenuMetrics.recedeOutDamping, target: 0.0 }
}

// --- which submenu is open ---------------------------------------------------

// One submenu at a time, as on the platform, and how far the menu behind it has
// receded.
//
// The recession is held HERE rather than on the menu that is receding because it
// is one motion shared by everything that is not the open submenu. A card that
// sprang its own would have to be told when a submenu three rows down opened,
// which is the wiring this avoids.
struct KiraUiMenuState {
    // The key of the expanded `Menu`, or 0 when none is.
    var openKey: Int = 0
    // The key of the `Menu` presented from a bar, whose card floats under
    // its button, or 0 when none is.
    var presentedKey: Int = 0
    // How far the menu behind has dimmed, on a spring of its own.
    var recede: MotionSpringState = MotionSpringState {}
    var receded: Float = 0.0
    // How far it has shrunk, on a spring of its own.
    var shrink: MotionSpringState = MotionSpringState {}
    var shrunk: Float = 0.0
    // Where across the screen the row that opened the submenu stood, its
    // center at the press. The menu gives way toward the side it stands on;
    // see `menuRecessionAnchor`.
    var sideX: Float = 0.0
    // Seconds still to wait before the recession starts moving. See
    // `recedeHold`: the menu stands at full strength while the submenu
    // arrives, and a spring has no way to say that — it leaves the instant it is
    // retargeted.
    var holdRemaining: Float = 0.0
    // The point on the screen the receding menu shrinks toward, and whether a
    // menu has said where it is. A submenu open in it rides its shrink about
    // the same point; see `kiraUiMenuRecedesFrom`.
    var pivot: Point = Point {}
    var pivoted: Bool = false
    // The last frame the recession was advanced on. Several cards may read it in
    // one build and each would otherwise advance it again, integrating the
    // spring two or three times per frame — which is a transition that runs at
    // triple speed on exactly the layouts that nest menus.
    var advancedOn: Int = 0
}

function kiraUiMenuSlotKey() -> String {
    return "kiraui.menu"
}

// The slot, made the first time it is asked for. A writer recovers it in
// place after this: a recovered value handed back out of a function is a
// copy, and what was written to it would be lost.
function kiraUiMenuEnsure() {
    if kiraUiStateSlotHas(kiraUiMenuSlotKey()) == false {
        kiraUiStateSlotPut(kiraUiMenuSlotKey(), nativeUserData(nativeState(KiraUiMenuState {})))
    }
    return
}

// The state as it stands, to read.
function kiraUiMenuState() -> KiraUiMenuState {
    kiraUiMenuEnsure()
    return nativeRecover<KiraUiMenuState>(kiraUiStateSlotGet(kiraUiMenuSlotKey()))
}

function kiraUiOpenMenuKey() -> Int {
    return kiraUiMenuState().openKey
}

// Points a spring at a new end from wherever it currently is, on a named curve.
//
// The sample-then-restart rather than `motionSpringRetarget` is what allows the
// CURVE to change with the direction: a submenu closed while it is still opening
// continues from where it is, at the speed it has, but on the closing curve.
function menuRetarget(state: borrow mut MotionSpringState, target: Float, spring: MotionSpring, launch: Float = 0.0) {
    let now = motionSpringSample(state, state.elapsed)
    var curve = spring
    if kiraUiReducedMotion() {
        curve = motionCurveReduced(spring)
    }
    let started = motionSpringStart(move curve, now.value, now.velocity + launch)
    state.spring = started.spring
    state.origin = started.origin
    state.velocity = started.velocity
    state.elapsed = started.elapsed
    return
}

// Choosing an item dismisses the menu it was in.
//
// A menu is a question, and picking an answer ends it — a submenu that stayed
// open after its item was chosen would leave the user to close a panel they have
// already finished with. The action runs first: what it does is the point, and
// the dismissal is what happens to the menu afterwards.
function kiraUiMenuChooseFn(action: () -> Void) -> () -> Void {
    let chosen = action
    let press: () -> Void = { in
        chosen()
        kiraUiMenuEnsure()
        var state = nativeRecover<KiraUiMenuState>(kiraUiStateSlotGet(kiraUiMenuSlotKey()))
        if state.openKey != 0 {
            menuRevealRetarget(state.openKey, false)
            state.openKey = 0
            menuRecessionRetarget(state, false)
        }
        if state.presentedKey != 0 {
            menuMorphRetarget(state.presentedKey, false)
            state.presentedKey = 0
        }
        return
    }
    return press
}

// Presents a bar's menu under its button, or puts it away if it is the one
// already out. Whatever other menu was out goes.
function kiraUiPresentMenuFn(key: Int) -> () -> Void {
    let target = key
    let press: () -> Void = { in
        kiraUiMenuEnsure()
        var state = nativeRecover<KiraUiMenuState>(kiraUiStateSlotGet(kiraUiMenuSlotKey()))
        let presented = state.presentedKey
        if presented != 0 {
            menuMorphRetarget(presented, false)
            state.presentedKey = 0
        }
        if presented != target {
            state.presentedKey = target
            menuMorphRetarget(target, true)
        }
        return
    }
    return press
}

// Puts away whichever bar menu is out: a press anywhere off its card.
function kiraUiDismissMenuFn() -> () -> Void {
    let press: () -> Void = { in
        kiraUiMenuEnsure()
        var state = nativeRecover<KiraUiMenuState>(kiraUiStateSlotGet(kiraUiMenuSlotKey()))
        if state.presentedKey != 0 {
            menuMorphRetarget(state.presentedKey, false)
            state.presentedKey = 0
        }
        return
    }
    return press
}

// Every menu out is put away at once, with no motion home: what it came out
// of is gone, as when the path is replaced with one that starts elsewhere.
// Its keys name controls of the new views now, which must not find it open.
function kiraUiMenuDismissAll() {
    kiraUiMenuEnsure()
    var state = nativeRecover<KiraUiMenuState>(kiraUiStateSlotGet(kiraUiMenuSlotKey()))
    if state.openKey != 0 {
        menuRevealPutAway(state.openKey)
        state.openKey = 0
    }
    if state.presentedKey != 0 {
        menuRevealPutAway(state.presentedKey)
        state.presentedKey = 0
    }
    state.recede = MotionSpringState {}
    state.receded = 0.0
    state.shrink = MotionSpringState {}
    state.shrunk = 0.0
    state.holdRemaining = 0.0
    state.pivoted = false
    return
}

function menuRevealPutAway(key: Int) {
    menuRevealEnsure(key)
    var reveal = nativeRecover<KiraUiMenuReveal>(kiraUiStateSlotGet(menuRevealSlotKey(key)))
    reveal.progress = MotionSpringState {}
    reveal.amount = 0.0
    reveal.widthAmount = 0.0
    reveal.height = MotionSpringState {}
    reveal.heightAmount = 0.0
    reveal.across = MotionSpringState {}
    reveal.acrossAmount = 0.0
    reveal.fall = MotionSpringState {}
    reveal.fallen = 0.0
    reveal.corner = MotionSpringState {}
    reveal.cornered = 0.0
    reveal.homeward = 0.0
    reveal.rise = MotionSpringState {}
    reveal.risen = 0.0
    reveal.opening = false
    return
}

// Opens a submenu, or closes it if it is the one already open.
function kiraUiToggleMenuFn(key: Int) -> () -> Void {
    let target = key
    let press: () -> Void = { in
        kiraUiMenuEnsure()
        var state = nativeRecover<KiraUiMenuState>(kiraUiStateSlotGet(kiraUiMenuSlotKey()))
        var opening = true
        // Whichever was open is told to close, whatever happens next.
        //
        // `openKey` names one submenu, but each one's growth is its OWN spring —
        // so a menu that lost the open slot without being retargeted keeps the
        // value it had and its card stands there for good. Opening a second
        // submenu left the first floating over the menu permanently, which is
        // the whole of "panels everywhere": nothing ever told them to leave.
        if state.openKey != 0 && state.openKey != target {
            menuRevealRetarget(state.openKey, false)
        }
        if state.openKey == target {
            state.openKey = 0
            opening = false
        } else {
            state.openKey = target
        }
        menuRecessionRetarget(state, opening)
        menuRevealRetarget(target, opening)
        return
    }
    return press
}

// Sends the menu behind a submenu back, or brings it forward. Its size eases
// out and back on one spring of its own, starting with the submenu and
// settling well after it; its ink waits out the hold going and comes straight
// back returning -- the swap described at the top of this file.
function menuRecessionRetarget(state: borrow mut KiraUiMenuState, opening: Bool) {
    let metrics = menuSubmenuMetrics
    menuRetarget(state.shrink, opening ? 1.0 : 0.0, MotionSpring { response: metrics.shrinkResponse, damping: metrics.shrinkDamping, target: opening ? 1.0 : 0.0 })
    if opening {
        state.sideX = foundationPressBoundsX() + foundationPressBoundsW() / 2.0
        menuRetarget(state.recede, 1.0, menuRecedeInSpring())
        state.holdRemaining = menuSubmenuMetrics.recedeHold
        return
    }
    menuRetarget(state.recede, 0.0, menuRecedeOutSpring())
    // No hold coming back. Whatever was still to run of one is dropped, so a
    // submenu shut during the hold brings the menu straight back instead of
    // finishing a wait for a dim that never began.
    state.holdRemaining = 0.0
    return
}

// --- one submenu's own reveal ------------------------------------------------

// How far this submenu's card has grown. Per-menu, because a menu closing while
// another opens are two motions at once and one value cannot hold both.
struct KiraUiMenuReveal {
    var progress: MotionSpringState = MotionSpringState {}
    var amount: Float = 0.0
    // Where the row was when it was pressed.
    //
    // Captured at the press and kept, because `foundationPressBounds…` describes
    // the LAST press wherever it landed — read again on any later frame it is
    // whatever was clicked since, and the card would jump to it. Kept here it is
    // the rectangle of the row that owns this submenu, for as long as the
    // submenu is open.
    var anchorX: Float = 0.0
    var anchorY: Float = 0.0
    var anchorW: Float = 0.0
    var anchorH: Float = 0.0
    // A bar's menu only: whether it is on its way out or home, how far its
    // height has grown, how far its center has gone across and fallen from
    // the button toward the card's, and how far it has gone toward squaring
    // off. Each rides a spring of its own: out, the growth carries the width
    // and the center across, and the fall, looser than either, drops the
    // glass past the card before it spreads back up into it; home, the
    // width and height shrink together and the center flies on one spring.
    // The growth's own value rides beside `amount` unclamped: the box takes
    // the spring as it is, overshoot and all, since cutting it off at either
    // end is a corner in the motion.
    var opening: Bool = false
    var widthAmount: Float = 0.0
    var height: MotionSpringState = MotionSpringState {}
    var heightAmount: Float = 0.0
    var across: MotionSpringState = MotionSpringState {}
    var acrossAmount: Float = 0.0
    var fall: MotionSpringState = MotionSpringState {}
    var fallen: Float = 0.0
    var corner: MotionSpringState = MotionSpringState {}
    var cornered: Float = 0.0
    // How long, in seconds, it has been on its way home: what the button's
    // own glass, leading it there, is timed by.
    var homeward: Float = 0.0
    // A submenu only: how far its card has risen off its row. It is thrown
    // up as it opens, past where it rests, and settles back down onto it.
    var rise: MotionSpringState = MotionSpringState {}
    var risen: Float = 0.0
}

function menuRevealSlotKey(key: Int) -> String {
    return kiraUiSlotKey("kiraui.menu.", key)
}

// The slot, made the first time it is asked for. A writer recovers it in
// place after this: a recovered value handed back out of a function is a
// copy, and what was written to it would be lost.
function menuRevealEnsure(key: Int) {
    if kiraUiStateSlotHas(menuRevealSlotKey(key)) == false {
        kiraUiStateSlotPut(menuRevealSlotKey(key), nativeUserData(nativeState(KiraUiMenuReveal {})))
    }
    return
}

// The state as it stands, to read.
function menuRevealState(key: Int) -> KiraUiMenuReveal {
    menuRevealEnsure(key)
    return nativeRecover<KiraUiMenuReveal>(kiraUiStateSlotGet(menuRevealSlotKey(key)))
}

// The rectangle this submenu hangs from, and the view slot to fill in.
function kiraUiMenuAnchor(key: Int) -> KiraUiOverlay {
    let reveal = menuRevealState(key)
    return KiraUiOverlay {
        anchorX: reveal.anchorX,
        anchorY: reveal.anchorY,
        anchorW: reveal.anchorW,
        anchorH: reveal.anchorH
    }
}

function menuRevealRetarget(key: Int, opening: Bool) {
    menuRevealEnsure(key)
    var reveal = nativeRecover<KiraUiMenuReveal>(kiraUiStateSlotGet(menuRevealSlotKey(key)))
    // The row's own bounds, recorded just before this handler ran — but only
    // when the submenu is opening from FULLY CLOSED.
    //
    // The row is in two places depending on this value: in the menu when the
    // card is shut, and inside the card when it is not. Re-opening while the
    // card is still on its way out therefore records the row's position INSIDE
    // the card, which is the anchor plus the card's padding — so the anchor
    // moves by that much, the card opens lower, and the next re-open moves it
    // again. Clicking open and shut quickly walks the panel down the screen.
    //
    // A submenu that is still visible already knows where it belongs. Only one
    // that is completely gone has to ask.
    if opening && reveal.amount <= 0.0 {
        reveal.anchorX = foundationPressBoundsX()
        reveal.anchorY = foundationPressBoundsY()
        reveal.anchorW = foundationPressBoundsW()
        reveal.anchorH = foundationPressBoundsH()
    }
    reveal.opening = opening
    menuRetarget(reveal.progress, opening ? 1.0 : 0.0, menuSubmenuSpring(opening))
    menuRetarget(reveal.rise, opening ? 1.0 : 0.0, menuSubmenuSpring(opening), opening ? menuSubmenuMetrics.riseLaunch : 0.0)
    return
}

// --- a bar's menu, growing out of its button ----------------------------------

// The springs a bar's menu rides, each way; see `MenuMorphMetrics`.
function menuMorphSpring(response: Float, damping: Float, target: Float) -> MotionSpring {
    return MotionSpring { response: response, damping: damping, target: target }
}

// Sends a bar's menu out of its button or home into it, from wherever it is.
// The button is recorded at the press, and only when the menu is all the way
// home: until then the button is under the card and the press landed on it.
// Only a menu leaving from home starts round; one caught on its way home goes
// back out the shape it is.
function menuMorphRetarget(key: Int, opening: Bool) {
    menuRevealEnsure(key)
    var reveal = nativeRecover<KiraUiMenuReveal>(kiraUiStateSlotGet(menuRevealSlotKey(key)))
    let metrics = menuMorphMetrics
    if opening && reveal.amount <= 0.0 {
        reveal.anchorX = foundationPressBoundsX()
        reveal.anchorY = foundationPressBoundsY()
        reveal.anchorW = foundationPressBoundsW()
        reveal.anchorH = foundationPressBoundsH()
        reveal.corner = MotionSpringState {}
        reveal.cornered = 0.0
    }
    reveal.opening = opening
    if opening {
        menuRetarget(reveal.progress, 1.0, menuMorphSpring(metrics.growthResponse, metrics.growthDamping, 1.0))
        menuRetarget(reveal.height, 1.0, menuMorphSpring(metrics.heightResponse, metrics.heightDamping, 1.0))
        menuRetarget(reveal.across, 1.0, menuMorphSpring(metrics.growthResponse, metrics.growthDamping, 1.0))
        menuRetarget(reveal.fall, 1.0, menuMorphSpring(metrics.dropResponse, metrics.dropDamping, 1.0), metrics.dropLaunch)
        menuRetarget(reveal.corner, 1.0, menuMorphSpring(metrics.cornerResponse, 1.0, 1.0))
    } else {
        reveal.homeward = 0.0
        menuRetarget(reveal.progress, 0.0, menuMorphSpring(metrics.closeResponse, metrics.closeDamping, 0.0))
        menuRetarget(reveal.height, 0.0, menuMorphSpring(metrics.closeResponse, metrics.closeDamping, 0.0))
        menuRetarget(reveal.across, 0.0, menuMorphSpring(metrics.flightResponse, metrics.flightDamping, 0.0))
        menuRetarget(reveal.fall, 0.0, menuMorphSpring(metrics.flightResponse, metrics.flightDamping, 0.0))
        menuRetarget(reveal.corner, 0.0, menuMorphSpring(metrics.closeCornerResponse, 1.0, 0.0))
    }
    return
}

// Advances a bar's menu by a frame and answers where it is. The fall is left
// unclamped: overshooting the card is its whole motion.
function menuMorphAdvance(key: Int) -> KiraUiMenuReveal {
    menuRevealEnsure(key)
    var reveal = nativeRecover<KiraUiMenuReveal>(kiraUiStateSlotGet(menuRevealSlotKey(key)))
    let delta = kiraUiClockDelta()
    let growth = motionSpringAdvance(reveal.progress, delta)
    let height = motionSpringAdvance(reveal.height, delta)
    let across = motionSpringAdvance(reveal.across, delta)
    let fall = motionSpringAdvance(reveal.fall, delta)
    let corner = motionSpringAdvance(reveal.corner, delta)
    reveal.amount = min(max(growth.value, 0.0), 1.0)
    reveal.widthAmount = growth.value
    reveal.heightAmount = height.value
    reveal.acrossAmount = across.value
    reveal.fallen = fall.value
    reveal.cornered = min(max(corner.value, 0.0), 1.0)
    if !reveal.opening {
        reveal.homeward = reveal.homeward + delta
    }
    let grown = motionSpringSettled(reveal.progress, growth, motionSpringEpsilon())
    let risen = motionSpringSettled(reveal.height, height, motionSpringEpsilon())
    let crossed = motionSpringSettled(reveal.across, across, motionSpringEpsilon())
    let landed = motionSpringSettled(reveal.fall, fall, motionSpringEpsilon())
    let squared = motionSpringSettled(reveal.corner, corner, motionSpringEpsilon())
    // Home, the button's glass leading the menu there runs on its own time,
    // and the menu stays out until it has run it: let go when the springs
    // land, the two would still be apart and the glyph not yet back.
    let arrived = reveal.opening || reveal.homeward >= menuMorphMetrics.closeDuration
    if grown && risen && crossed && landed && squared && arrived {
        reveal.amount = min(max(reveal.progress.spring.target, 0.0), 1.0)
        reveal.widthAmount = reveal.progress.spring.target
        reveal.heightAmount = reveal.height.spring.target
        reveal.acrossAmount = reveal.across.spring.target
        reveal.fallen = reveal.fall.spring.target
        reveal.cornered = min(max(reveal.corner.spring.target, 0.0), 1.0)
        return copy reveal
    }
    kiraUiClockStillMoving()
    return copy reveal
}

// Whether a bar button's glass is out with its menu: from the press that opens
// the menu until the menu is home again. The bar draws that button bare, since
// the glass it would sit on is the menu's.
function kiraUiMenuHoldsGlass(key: Int) -> Bool {
    if key == 0 || kiraUiStateSlotHas(menuRevealSlotKey(key)) == false {
        return false
    }
    return kiraUiMenuState().presentedKey == key || menuRevealState(key).amount > 0.0
}

// Advances this submenu's reveal by a frame and answers where it is.
//
// Reports to the clock while it is unfinished, which is what keeps the frames
// coming: an interactive app only rebuilds when something happened, and a
// spring settling is the one thing that happens while nothing does.
function menuRevealAdvance(key: Int) -> Float {
    menuRevealEnsure(key)
    var reveal = nativeRecover<KiraUiMenuReveal>(kiraUiStateSlotGet(menuRevealSlotKey(key)))
    let delta = kiraUiClockDelta()
    let sample = motionSpringAdvance(reveal.progress, delta)
    let thrown = motionSpringAdvance(reveal.rise, delta)
    // Past open as the spring overshoots, which is the card's bounce; never
    // past shut, which would be a card smaller than its row.
    reveal.amount = max(sample.value, 0.0)
    reveal.risen = thrown.value
    if motionSpringSettled(reveal.progress, sample, motionSpringEpsilon()) && motionSpringSettled(reveal.rise, thrown, motionSpringEpsilon()) {
        // Landed exactly. A card left 0.999 open is one drawn a fraction short
        // of its own height for as long as it is on screen.
        reveal.amount = min(max(reveal.progress.spring.target, 0.0), 1.0)
        reveal.risen = reveal.rise.spring.target
        return reveal.amount
    }
    kiraUiClockStillMoving()
    return reveal.amount
}

// What the menu behind an open submenu is drawn with at one moment: its ink,
// its size, and the point it shrinks about.
struct MenuRecession {
    var ink: Float = 1.0
    var scale: Float = 1.0
    var anchor: StackAlignment = .Top
    // The point it shrinks toward, on the screen, when it is known.
    var pivot: Point = Point {}
    var pivoted: Bool = false
}

// The point a menu shrinks about: its top, at the side of the screen it stands
// on. A menu out at the trailing edge holds that edge and comes in from the
// leading one, the side with room, as Music's does; one in the middle third of
// the screen comes in from both, half on each.
function menuRecessionAnchor(sideX: Float, viewportWidth: Float) -> StackAlignment {
    let third = viewportWidth / 3.0
    if sideX < third {
        return .TopLeading
    }
    if sideX > viewportWidth - third {
        return .TopTrailing
    }
    return .Top
}

// Advances the shared recession, once per frame however many cards ask, and
// answers where it stands.
function kiraUiMenuRecession(context: borrow BuildContext) -> MenuRecession {
    kiraUiMenuEnsure()
    var state = nativeRecover<KiraUiMenuState>(kiraUiStateSlotGet(kiraUiMenuSlotKey()))
    if state.advancedOn != context.frameCount {
        state.advancedOn = context.frameCount
        let delta = kiraUiClockDelta()
        state.shrunk = menuRecessionStep(state.shrink, delta)
        // Held: the ink stays exactly where it is and its spring's clock does
        // not start. Reported as still moving, because a hold is part of the
        // transition and the frames have to keep coming or it would end here.
        if state.holdRemaining > 0.0 {
            state.holdRemaining = state.holdRemaining - delta
            kiraUiClockStillMoving()
        } else {
            state.receded = menuRecessionStep(state.recede, delta)
        }
    }
    let metrics = menuSubmenuMetrics
    return MenuRecession {
        ink: 1.0 - (1.0 - metrics.recededOpacity) * min(state.receded, 1.0),
        scale: 1.0 - (1.0 - metrics.recedeScale) * state.shrunk,
        anchor: menuRecessionAnchor(state.sideX, context.viewportWidth),
        pivot: state.pivot,
        pivoted: state.pivoted
    }
}

// The receding menu says the point it shrinks toward, so a submenu open in
// it can fall back with it rather than hang still while the menu moves under
// it.
function kiraUiMenuRecedesFrom(pivot: Point) {
    kiraUiMenuEnsure()
    var state = nativeRecover<KiraUiMenuState>(kiraUiStateSlotGet(kiraUiMenuSlotKey()))
    state.pivot = pivot
    state.pivoted = true
    return
}

// One frame of one of the recession's springs, landing exactly on its end.
// Past its end as the spring overshoots -- the menu shrinking a touch further
// than it rests -- and never back past where it started.
function menuRecessionStep(state: borrow mut MotionSpringState, delta: Float) -> Float {
    let sample = motionSpringAdvance(state, delta)
    if motionSpringSettled(state, sample, motionSpringEpsilon()) {
        return min(max(state.spring.target, 0.0), 1.0)
    }
    kiraUiClockStillMoving()
    return max(sample.value, 0.0)
}

// --- a control's presentation inside a menu ----------------------------------

// What `Button` describes when the environment says it is in a menu: a row.
//
// Full width, the panel's own ink, no fill, and the standard row height — so a
// run of them reads as a list rather than as a stack of controls. The press
// region is the whole row, which is what a menu is: you aim at the line, not at
// the words on it.
function menuRowDescription(
    context: borrow BuildContext,
    modifiers: borrow ModifierContext,
    key: Int,
    label: some Widget,
) -> CALayerDescription {
    // The menu's own type size, stated here so a plain `Button(title:)` in a
    // menu is set exactly as the platform sets one.
    let labelModifiers = modifierContextApply(
        modifierContextForPresentation(modifiers),
        modifierDeltaFont(menuLabelSize(modifiers), .Regular)
    )
    // A one-line row stands at the menu's pitch with its line centered; a title
    // that wraps keeps that same air above and below and the row grows.
    let pitch = menuRowPitch(modifiers)
    let air = max((pitch - foundationTextLineBox(menuLabelSize(modifiers), foundationFontWeight(.Regular))) / 2.0, 0.0)
    return CALayerDescription {
        hittable: !modifiers.disabled,
        hitKey: key,
        layout: CALayoutIntent {
            axis: .Row,
            heightFill: false,
            minHeight: pitch,
            paddingLeading: menuRowLeading(modifiers),
            paddingTrailing: menuRowTrailing(modifiers),
            paddingTop: air,
            paddingBottom: air,
            alignment: Point { x: 0.0, y: 0.5 }
        },
        sublayers: [label.describe(context, labelModifiers)]
    }
}

// What `Button` describes in the group of actions across the top of a menu.
//
// An equal COLUMN, its glyph above its title — `.frame(maxWidth: .infinity)` on
// a `VStack { Image; Text }`. Equal rather than hugging is the whole point: the
// actions stand on equal shares of the panel whatever their titles are, so
// "Duplicate" does not push "Hide" off its share.
function menuActionDescription(
    context: borrow BuildContext,
    modifiers: borrow ModifierContext,
    key: Int,
    label: some Widget,
) -> CALayerDescription {
    let pad = menuActionPad(modifiers)
    return CALayerDescription {
        hittable: !modifiers.disabled,
        hitKey: key,
        layout: CALayoutIntent {
            heightFill: false,
            paddingLeading: pad,
            paddingTrailing: pad,
            flex: 1
        },
        sublayers: [label.describe(context, modifierContextForPresentation(modifiers))]
    }
}

function menuActionPad(modifiers: borrow ModifierContext) -> Float {
    return resolvedControlMetrics(modifiers).menuActionPadding
}

// A press region for a menu row, with NO wash of its own.
//
// The generic click layer paints a white hover highlight behind whatever it
// wraps. Under glass that is not a highlight, it is fuel: the wash lands in the
// backdrop the card captures, the material's dodge layers take it, and an eight
// percent white comes back out as a solid white bar across the row. Measured on
// the row under the pointer while a submenu closes — 254 against the 85 the same
// row reads when the pointer is anywhere else.
//
// So a menu row states its own highlight (see `MenuHeader`, and `menuRowView`
// for the ordinary rows) and takes a press region that draws nothing. This is
// the same reason `DismissArea` is its own leaf rather than an `.onClick`.
function menuHeaderLightFill(strength: Float) -> Color {
    return Color { r: 1.0, g: 1.0, b: 1.0, a: 0.16 * strength }
}

// How far the lit pill stands in from the card's edge.
function menuPillInset(modifiers: borrow ModifierContext) -> Float {
    return resolvedControlMetrics(modifiers).menuPillInset
}

// The corner of the highlight a menu row lights up with. A rounded pill inset in
// the panel rather than a band across it, which is what the platform draws.
function menuRowRadius(modifiers: borrow ModifierContext) -> Float {
    return resolvedControlMetrics(modifiers).menuRowRadius
}

// --- the menu row ------------------------------------------------------------

// How far the chevron has turned, in radians.
//
// ONE glyph, turned — not two glyphs swapped at the halfway point. A symbol is
// rasterized trimmed to its ink, so a chevron pointing right and one pointing
// down are different widths and different pictures: swapping them changes the
// shape in a single frame and re-resolves the row around it, which is the
// padding that appeared and disappeared at each end of the animation.
//
// A quarter turn clockwise, following the reveal and done before it is, so the
// chevron points down by the time the card has mostly opened -- and on the way
// back stays down until the card is mostly shut.
function menuChevronTurn(amount: Float) -> Float {
    return 1.5707963267948966 * menuHeaderEmphasis(amount)
}

// How far a header has gone from its row's weight to its card's, on the
// chevron's schedule.
function menuHeaderEmphasis(amount: Float) -> Float {
    return min(max(amount / menuSubmenuMetrics.chevronTurn, 0.0), 1.0)
}

// The box the chevron is centered in. A turning glyph sweeps its own diagonal, so
// the box is squared and large enough to hold it at every angle rather than at
// the two it rests at.
function menuChevronBox(modifiers: borrow ModifierContext) -> Float {
    return resolvedControlMetrics(modifiers).menuChevronBox
}

// A submenu's header: the row that owns it, which stays put while the card grows
// around it and is pressed again to close.
//
// While the submenu is out the row is its card's header: emphasized, its
// chevron turned down and its label thickened to semibold with the same value
// that grows the card, both done before the card is.
construct MenuHeader(title: String, systemImage: Symbol, amount: Float, key: Int) extends Widget {

    // The header row as one press region: label, spacer and the disclosure
    // chevron, inset as every menu row is. The chevron turns inside a squared
    // box, so the row does not re-resolve around it while it turns.
    function describe(context: borrow BuildContext, modifiers: borrow ModifierContext) -> CALayerDescription {
        let row = HStack(spacing: .Small, alignment: .Center) {
            Label(title: title, systemImage: systemImage)
                .font(size: menuLabelSize(modifiers), weight: fontWeightBetween(.Regular, .SemiBold, menuHeaderEmphasis(amount)))

            Spacer()

            ZStack(alignment: .Center) {
                Icon(symbol: .ChevronRight)
                    .font(size: resolvedControlMetrics(modifiers).menuChevronSize)
                    .foregroundColor(.Secondary)
                    .rotationEffect(menuChevronTurn(amount))
            }
            .width(menuChevronBox(modifiers))
            .height(menuChevronBox(modifiers))
        }
        .height(menuRowPitch(modifiers))
        return CALayerDescription {
            hittable: true,
            hitKey: key,
            layout: CALayoutIntent {
                heightFill: false,
                paddingLeading: menuRowLeading(modifiers),
                paddingTrailing: menuRowTrailing(modifiers)
            },
            sublayers: [row.describe(context, modifiers)]
        }
    }
}

// A submenu.
//
// Collapsed it is a row in the menu. Open, that same row is the header of a card
// floating above the menu — the card closes around the element rather than
// appearing beneath it. The row is LIFTED into the card rather than copied, so
// there is one of it: one view, one hit region, one key. What stays behind is
// its SPACE, so the rows below do not slide up into a gap and back down.
//
// # The structure does not change while it animates
//
// This is the whole difference between it working and it not. A widget that
// swaps its shape at either end of a transition — a row here on one frame and
// inside a card on the next, a placeholder that is the traveling size rather
// than the resting one — re-resolves layout at exactly the moments the eye is
// following it, moves its keys, and leaves frames where its press region does
// not exist. What that produces is padding appearing and disappearing at each
// end, panels landing in the wrong place, and clicks that turn the chevron and
// open nothing.
//
// So there are exactly two shapes, and the boundary between them is a single
// value reaching zero:
//
//   amount == 0   the row is in the menu, nothing floats
//   amount  > 0   the row is in the card, the card floats, the menu holds a
//                 gap of the ROW's natural height — the same height whatever
//                 the animation is currently doing
//
// The row's key is the menu's own key in both, so the press region is one region
// that never changes identity. The gap is the row's resting height in both, so
// nothing below it ever moves.
//
// The card carries the animation instead: it grows and shrinks and fades, and it
// is a floating view, so nothing reflows when it does. A closing submenu shrinks
// away rather than standing at full size until its spring happens to reach zero.
construct Menu(title: String, systemImage: Symbol = .None) extends Widget {
    let children: [some Widget]


    function describe(context: borrow BuildContext, modifiers: borrow ModifierContext) -> CALayerDescription {
        if modifiers.controlPresentation == .Toolbar {
            return presentedMenuDescription(context, modifiers)
        }
        let key = kiraUiTapSeqKey()
        kiraUiLayerActionRegister(key, kiraUiToggleMenuFn(key))
        let amount = menuRevealAdvance(key)
        let header = MenuHeader(title: title, systemImage: systemImage, amount: amount, key: key)
        var row = header.describe(context, modifiers)
        if amount <= 0.0 {
            return row
        }
        // Out: the row keeps its place and draws nothing there. While the card
        // is open its header is the row's press; while it goes back the row's
        // own place is, so pressing it again reopens it at once.
        let open = kiraUiOpenMenuKey() == key
        row.sublayers[0].opacity = 0.0
        if open {
            layerInert(row)
        }
        let band = kiraUiTapSeqEnterOverlay()
        let overlayModifiers = modifierContextForOverlay(modifiers)
        let lifted = header.describe(context, overlayModifiers)
        let rule = Divider().describe(context, overlayModifiers)
        var items = VStack(spacing: .None) {
            For(item in children) {
                item
            }
        }
        .describe(context, overlayModifiers)
        menuCardFoot(items, modifiers)
        var overlay = kiraUiMenuAnchor(key)
        let reveal = menuRevealState(key)
        var card = menuSubmenuCard(context, key, move lifted, move rule, move items, reveal, modifiers)
        if !open {
            layerInert(card)
        }
        // The card's box, placed exactly: the row's left edge, and its top
        // where the card's top lands open.
        overlay.z = kiraUiOverlayZSubmenu()
        overlay.alignment = 0.0
        overlay.spacing = menuSubmenuTop(reveal, card.layout.fixedHeight, context.viewportHeight) - overlay.anchorY - overlay.anchorH
        overlay.content = move card
        if open {
            let dismissKey = kiraUiTapSeqKey()
            kiraUiLayerActionRegister(dismissKey, kiraUiToggleMenuFn(key))
            overlay.dismissKey = dismissKey
        }
        kiraUiTapSeqLeaveOverlay(band)
        kiraUiOverlayPresent(move overlay)
        return row
    }

    // On a bar a menu is a button whose glass becomes the menu, as on the
    // platform since iOS 26. Pressed, the glass leaves the button and grows
    // into the card, falling past it and spreading back up, the items coming
    // clear in it; dismissed, the items blur away first and the glass sinks a
    // touch, then shrinks home into the button as it flies. The card covers the
    // button, its top and trailing edges on the button's. The button shows the
    // symbol when the menu has one, as the platform's bar does, and the title
    // when it has none.
    function presentedMenuDescription(context: borrow BuildContext, modifiers: borrow ModifierContext) -> CALayerDescription {
        let key = kiraUiTapSeqKey()
        kiraUiLayerActionRegister(key, kiraUiPresentMenuFn(key))
        var label: Any Widget = Text(content: title)
        if systemImage != .None {
            label = Icon(symbol: systemImage)
        }
        var button = toolbarButtonDescription(context, modifiers, key, label)
        if !kiraUiMenuHoldsGlass(key) {
            return button
        }
        let reveal = menuMorphAdvance(key)
        let presented = kiraUiMenuState().presentedKey == key
        // The glyph travels with the glass, so the button keeps only its press.
        var glyph = copy button.sublayers[0]
        button.sublayers[0].opacity = 0.0
        let band = kiraUiTapSeqEnterOverlay()
        let overlayModifiers = modifierContextForOverlay(modifiers)
        var items = MenuItems() {
            For(item in children) {
                item
            }
        }
        .describe(context, overlayModifiers)
        if !presented {
            layerInert(items)
        }
        var overlay = kiraUiMenuAnchor(key)
        // Hung by its own height above the bottom of the button: over it.
        overlay.spacing = 0.0 - overlay.anchorH
        overlay.alignment = 1.0
        var morph = menuMorphDescription(move items, move glyph, reveal, modifiers)
        // Falls back behind a submenu open in it, as a whole, toward the button
        // it came out of.
        let recession = kiraUiMenuRecession(context)
        morph.scaleX = recession.scale
        morph.scaleY = recession.scale
        morph.anchorPoint = stackAlignmentUnitPoint(.TopTrailing)
        kiraUiMenuRecedesFrom(Point { x: overlay.anchorX + overlay.anchorW, y: overlay.anchorY })
        overlay.content = move morph
        if presented {
            let dismissKey = kiraUiTapSeqKey()
            kiraUiLayerActionRegister(dismissKey, kiraUiDismissMenuFn())
            overlay.dismissKey = dismissKey
        }
        kiraUiTapSeqLeaveOverlay(band)
        kiraUiOverlayPresent(move overlay)
        return button
    }
}

// Where an open submenu's card tops out: so the header is where its row was,
// the card's air above it, unless the card would run off the bottom of the
// window -- then as far up as it has to go, and never off the top.
function menuSubmenuTop(reveal: borrow KiraUiMenuReveal, full: Float, viewportHeight: Float) -> Float {
    let margin = windowChromeMetrics.edgeInset
    let inset = menuSubmenuMetrics.headerCenter - reveal.anchorH * 0.5
    return max(min(reveal.anchorY - inset, viewportHeight - margin - full), margin)
}

// A submenu's card at one moment, in a box the open card's size: the row's
// width, from its top to the last item.
//
// The card is the row at first, on the row, and opens on one spring: its top
// rises to the box's and its bottom falls to the box's, the header riding
// between them to its place under the card's air, so the items are uncovered
// in place rather than slid in. They are there almost at once, over the rows
// of the menu behind as those dim; the card's own glass, and the rule under
// its header, come up only once it is half open, over the menu's. Going back the items go first and the glass
// last, as a pill the size of the row, back on it.
function menuSubmenuCard(
    context: borrow BuildContext,
    key: Int,
    header: CALayerDescription,
    rule: CALayerDescription,
    items: CALayerDescription,
    reveal: borrow KiraUiMenuReveal,
    modifiers: borrow ModifierContext,
) -> CALayerDescription {
    let metrics = menuSubmenuMetrics
    let width = reveal.anchorW
    let rowHeight = reveal.anchorH
    let inset = metrics.headerCenter - rowHeight * 0.5
    let full = inset + rowHeight + caMeasure(rule, width).height + caMeasure(items, width).height
    let top = menuSubmenuTop(reveal, full, context.viewportHeight)
    let grown = reveal.amount
    // The menu it opened in falls back toward its pivot, taking the row this
    // card hangs from with it, and the card follows, overshoot and all. Shut,
    // the card IS that row, so it shrinks with the menu as the row does and
    // hands over to it exactly wherever the menu's own spring has got to;
    // open, it is its own card at its own size, and only falls back with it.
    let recession = kiraUiMenuRecession(context)
    let shut = 1.0 - min(max(grown, 0.0), 1.0)
    let scale = recession.pivoted ? 1.0 - (1.0 - recession.scale) * shut : 1.0
    let followed = recession.pivoted ? (1.0 - recession.scale) * (reveal.anchorY - recession.pivot.y) * (1.0 - shut) : 0.0
    let height = rowHeight + (full - rowHeight) * grown
    let radius = min(menuCardRadius(modifiers), height * 0.5)

    var glassOpacity = min(max(grown / metrics.cardVanish, 0.0), 1.0)
    var itemsOpacity = min(max((grown - metrics.itemsVanish) / metrics.itemsVanishSpan, 0.0), 1.0)
    if reveal.opening {
        glassOpacity = min(max((grown - metrics.cardAppear) / metrics.cardAppearSpan, 0.0), 1.0)
        itemsOpacity = min(max((grown - metrics.itemsAppear) / metrics.itemsAppearSpan, 0.0), 1.0)
    }
    var glass = interactiveGlassDescription(
        context,
        key,
        CALayoutIntent {
            widthFill: false,
            heightFill: false,
            fixedWidth: width,
            fixedHeight: height
        },
        radius,
        .Squircle(radius),
        modifiers,
        []
    )
    glass.opacity = glassOpacity

    // The rule under the header is the card's, not the items': it comes and
    // goes with the glass.
    var divider = move rule
    divider.opacity = divider.opacity * glassOpacity
    var shown = move items
    shown.opacity = shown.opacity * itemsOpacity
    let content = CALayerDescription {
        layout: CALayoutIntent {
            axis: .Column,
            widthFill: false,
            heightFill: false,
            fixedWidth: width,
            offset: Point { x: 0.0, y: inset * grown }
        },
        sublayers: [move header, move divider, move shown]
    }

    var card = CALayerDescription {
        anchorPoint: Point {
            x: (recession.pivot.x - reveal.anchorX) / width,
            y: (recession.pivot.y - top + followed) / full
        },
        scaleX: scale,
        scaleY: scale,
        layout: CALayoutIntent {
            widthFill: false,
            heightFill: false,
            fixedWidth: width,
            fixedHeight: full,
            offset: Point { x: 0.0, y: 0.0 - followed }
        },
        sublayers: [CALayerDescription {
            layout: CALayoutIntent {
                widthFill: false,
                heightFill: false,
                fixedWidth: width,
                fixedHeight: height,
                offset: Point { x: 0.0, y: (reveal.anchorY - top) * (1.0 - grown) - metrics.rise * reveal.risen }
            },
            cornerRadius: radius,
            clipsChildren: true,
            sublayers: [move glass, move content]
        }]
    }
    layerImmediate(card)
    return card
}

// The glass of a bar's menu at one moment, in a box the card's size whose top
// trailing corner is the button's.
//
// The menu is the button's own glass, growing: its width and its center across
// go from the button's to the card's with the growth, its height with a spring
// of its own, and its center down with the fall. Out of the button it is an
// ellipse, the circle the button is stretched to the box, and once its corner
// spring is far enough along it squares off into the card, one shape the whole
// way. Home it is two: it shrinks to the button's size, rounds and flies home,
// while the button's own glass comes up out of it and leads it there, fused,
// until both land as one.
//
// The button's glyph rides the glass at its center, gone as the glass grows
// and back before it lands. The rows are drawn twice: under the glass, where
// it bends and blurs them as it bends what is behind it, and on it, clear,
// once it has grown round them.
function menuMorphDescription(
    items: CALayerDescription,
    glyph: CALayerDescription,
    reveal: borrow KiraUiMenuReveal,
    modifiers: borrow ModifierContext,
) -> CALayerDescription {
    let metrics = menuMorphMetrics
    let card = caMeasure(items, 100000.0)
    let buttonW = reveal.anchorW
    let buttonH = reveal.anchorH
    let buttonX = card.width - buttonW
    let grown = reveal.amount
    let width = max(buttonW + (card.width - buttonW) * reveal.widthAmount, 1.0)
    let height = max(buttonH + (card.height - buttonH) * reveal.heightAmount, 1.0)
    let centerX = buttonX + buttonW * 0.5 + (card.width * 0.5 - buttonX - buttonW * 0.5) * reveal.acrossAmount
    let centerY = buttonH * 0.5 + (card.height - buttonH) * 0.5 * reveal.fallen
    let x = centerX - width * 0.5
    let y = centerY - height * 0.5
    // One radius runs the whole shape: the long half side is the ellipse,
    // and coming down from it the ends straighten and the corners close in
    // to the card's. Home it stays the card's, which the shrinking box,
    // shorter than it at the last, widens back into the button's circle.
    let long = max(width, height) * 0.5
    let cardRadius = menuCardRadius(modifiers)
    let squared = menuMorphPhase(reveal.cornered, metrics.roundness, 1.0)
    let radius = min(long + (cardRadius - long) * squared, long)
    var glass = liquidGlassContent(.Squircle(radius), modifiers)
    glass.shapeKind = 2
    // A menu is the platform's large glass whatever its size, blurring as far
    // as glass blurs; the button's glass blurs out to it as it grows.
    let button = caGlassRampAt(glass.sizing.blurRadius, buttonW, buttonH)
    let farthest = button + (glass.sizing.blurRadius.maximum - button) * min(max(grown, 0.0), 1.0)
    glass.sizing.blurRadius = CAGlassRamp { base: farthest, minimum: farthest, maximum: farthest }

    // Home, the button's own glass is back as a second shape, the button's
    // size, on the line from the card's center to the button. It comes up
    // out of the menu's glass and leads it home, the two fused, and is drawn
    // back into it as both land; see `menuMorphLead`.
    let homeward = min(reveal.homeward / metrics.closeDuration, 1.0)
    var lead = Point { x: centerX, y: centerY }
    if !reveal.opening {
        let lineX = buttonX + buttonW * 0.5 - card.width * 0.5
        let lineY = buttonH * 0.5 - card.height * 0.5
        let line = max(sqrt(lineX * lineX + lineY * lineY), 0.0001)
        let along = menuMorphLead(width * 0.5, height * 0.5, radius, buttonW * 0.5, buttonH * 0.5, lineX / line, lineY / line, homeward)
        lead = Point { x: centerX + lineX / line * along, y: centerY + lineY / line * along }
        glass.morphWidth = buttonW
        glass.morphHeight = buttonH
        glass.morphX = lead.x - buttonW * 0.5 - x
        glass.morphY = lead.y - buttonH * 0.5 - y
        // The long half side, which the wide corner draws as the button's
        // round; the short one would be its squircle, and the button would
        // round off under it the moment the menu left.
        glass.morphRadius = max(buttonW, buttonH) * 0.5
        // Two shapes on top of each other fuse into one larger than either,
        // so the reach lets go as they close in: landed, the glass is the
        // button's own size and nothing changes when the menu leaves.
        let apart = sqrt((lead.x - centerX) * (lead.x - centerX) + (lead.y - centerY) * (lead.y - centerY))
        glass.morphBlend = metrics.homeBlend * menuMorphPhase(apart, 0.0, metrics.homeBlend)
    }

    // The rows are there well before the glass has grown round them, under a
    // blur that clears as it finishes, and larger than their own size until
    // the glass has squared off. Home they fade early, at their own size.
    let shown = reveal.opening ? menuMorphPhase(grown, metrics.contentOpen, 1.0) : 1.0 - menuMorphPhase(homeward, 0.0, metrics.contentClose)
    let zoom = reveal.opening ? 1.0 + metrics.contentZoom * (1.0 - menuMorphPhase(reveal.cornered, 0.8, 1.0)) : 1.0
    let offset = Point { x: (width - card.width) * 0.5, y: (height - card.height) * 0.5 }
    let bent = reveal.opening ? menuMorphPhase(grown, metrics.glyphGone, metrics.glyphReturn) : 0.0
    var under = copy items
    under.opacity = under.opacity * bent * (1.0 - shown)
    under.scaleX = zoom
    under.scaleY = zoom
    under.layout.widthFill = false
    under.layout.heightFill = false
    under.layout.offset = offset
    var content = move items
    content.opacity = content.opacity * (reveal.opening ? menuMorphPhase(shown, 0.0, 0.4) : shown)
    content.blur = reveal.opening ? metrics.contentBlur * (1.0 - shown) : 0.0
    content.scaleX = zoom
    content.scaleY = zoom
    content.layout.widthFill = false
    content.layout.heightFill = false
    content.layout.offset = offset

    let shapeKind = glass.shapeKind
    let box = CALayoutIntent {
        widthFill: false,
        heightFill: false,
        fixedWidth: width,
        fixedHeight: height,
        offset: Point { x: x, y: y }
    }
    let rows = CALayerDescription {
        layout: copy box,
        cornerRadius: radius,
        clipsChildren: true,
        content: .Solid(CASolid { fill: CAColor { a: 0.0 }, cornerRadius: radius, shapeKind: shapeKind }),
        sublayers: [move under]
    }
    var surface = CALayerDescription {
        layout: move box,
        cornerRadius: radius,
        clipsChildren: true,
        capturesBackdrop: true,
        content: .Glass(move glass),
        sublayers: [move content]
    }
    var layers: [CALayerDescription] = [move rows]
    // The button's glyph rides the glass out at its center, gone as it grows,
    // and comes back home on the button's glass, out of a blur.
    if reveal.opening {
        surface.sublayers.append(menuMorphGlyph(
            move glyph,
            Point { x: (width - buttonW) * 0.5, y: (height - buttonH) * 0.5 },
            buttonW,
            buttonH,
            1.0 - menuMorphPhase(grown, 0.0, metrics.glyphGone)
        ))
        layers.append(move surface)
    } else {
        layers.append(move surface)
        let back = menuMorphPhase(homeward, 0.0, metrics.glyphBack)
        var returning = menuMorphGlyph(move glyph, Point { x: lead.x - buttonW * 0.5, y: lead.y - buttonH * 0.5 }, buttonW, buttonH, back)
        returning.blur = metrics.glyphBlur * (1.0 - back)
        layers.append(move returning)
    }
    var morph = CALayerDescription {
        layout: CALayoutIntent {
            widthFill: false,
            heightFill: false,
            fixedWidth: card.width,
            fixedHeight: card.height
        },
        sublayers: move layers
    }
    layerImmediate(morph)
    return morph
}

// How far along the stretch from `start` to `end` a value is, eased in and out
// at both ends: what each part of a bar's menu that comes or goes partway
// through the motion rides, so none of them starts or stops on a corner.
function menuMorphPhase(value: Float, start: Float, end: Float) -> Float {
    let t = min(max((value - start) / max(end - start, 0.0001), 0.0), 1.0)
    return t * t * (3.0 - 2.0 * t)
}

// How far out along the line home from the menu's center the button's glass
// sits, `progress` of the way through the way home, after Telegram's fit of
// UIKit's (LensTransitionContainer). Its gap to the menu's edge along the line
// starts deep inside, `homeDepth` plus its own length past it, and comes up to
// just inside the edge over the first `homeSurface`; from `homeLead` on it
// pushes out past the edge, toward `homeReach` ahead of it, while being drawn
// back toward the menu's center, all the way by the end.
function menuMorphLead(
    halfWidth: Float,
    halfHeight: Float,
    radius: Float,
    buttonHalfWidth: Float,
    buttonHalfHeight: Float,
    lineX: Float,
    lineY: Float,
    progress: Float,
) -> Float {
    let metrics = menuMorphMetrics
    let edge = menuMorphReach(halfWidth, halfHeight, radius, lineX, lineY)
    let extent = abs(lineX) * buttonHalfWidth + abs(lineY) * buttonHalfHeight
    let left = 1.0 - progress
    let inside = menuMorphEaseOut(left / (1.0 - metrics.homeLead))
    let below = menuMorphEaseOut((left - (1.0 - metrics.homeSurface)) / metrics.homeSurface)
    let surfacing = metrics.homeReach - inside * (metrics.homeReach + min(buttonHalfWidth, buttonHalfHeight))
    let sunk = surfacing + (0.0 - metrics.homeDepth - extent * 2.0 - surfacing) * below
    let gap = min(sunk + (0.0 - edge - extent - sunk) * menuMorphEaseOut(progress), metrics.homeReach)
    return edge + gap + extent
}

// How far from its center a rounded box of these half sides reaches along the
// unit direction (`x`, `y`): to a side, or round a corner.
function menuMorphReach(halfWidth: Float, halfHeight: Float, radius: Float, x: Float, y: Float) -> Float {
    let across = abs(x)
    let down = abs(y)
    let corner = min(radius, min(halfWidth, halfHeight))
    let toSide = across > 0.0001 ? halfWidth / across : 100000.0
    let toTop = down > 0.0001 ? halfHeight / down : 100000.0
    let flat = min(toSide, toTop)
    let innerX = halfWidth - corner
    let innerY = halfHeight - corner
    if across * flat <= innerX || down * flat <= innerY {
        return flat
    }
    let middle = across * innerX + down * innerY
    let rest = innerX * innerX + innerY * innerY - corner * corner
    return middle + sqrt(max(middle * middle - rest, 0.0))
}

// A cubic ease out of the stretch from 0 to 1.
function menuMorphEaseOut(value: Float) -> Float {
    let rest = 1.0 - min(max(value, 0.0), 1.0)
    return 1.0 - rest * rest * rest
}

// The button's glyph in a box the button's size, centered as the button
// centers it, at `origin` in the glass.
function menuMorphGlyph(glyph: CALayerDescription, origin: Point, width: Float, height: Float, opacity: Float) -> CALayerDescription {
    return CALayerDescription {
        opacity: opacity,
        layout: CALayoutIntent {
            widthFill: false,
            heightFill: false,
            fixedWidth: width,
            fixedHeight: height,
            alignment: Point { x: 0.5, y: 0.5 },
            offset: origin
        },
        sublayers: [move glyph]
    }
}

// --- the card a menu is presented in -----------------------------------------

// The panel a menu's rows sit on.
//
// This is what `.contextMenu { … }` will present once the library can present
// anything; until then an application places it. Either way it is the thing that
// RECEDES when a submenu inside it opens, which is why the recession is read
// here rather than pushed down from the menu that caused it.
construct ContextMenu() extends Widget {
    let children: [some Widget]


    function describe(context: borrow BuildContext, modifiers: borrow ModifierContext) -> CALayerDescription {
        let recession = kiraUiMenuRecession(context)
        // The panel is the platform's menu material at every size, not the
        // regular glass `.glassEffect` puts under a control, and it is lifted
        // off what it is over by the kit's wide, soft shadow.
        let card = SurfaceLayer(style: .LayeredGlass, shape: .Squircle(menuCardRadius(modifiers))) {
            MenuItems() {
                For(item in children) {
                    item
                }
            }
        }
        .shadow(
            color: themeAdaptiveColor(menuShadow, modifierTheme(modifiers).appearance()),
            radius: menuShadowRadius,
            x: 0.0,
            y: menuShadowOffset
        )
        .scaleEffect(recession.scale, anchor: recession.anchor)
        return card.describe(context, modifierContextPresenting(modifiers, .MenuRow))
    }
}

// A menu's rows, without the card: what a `ContextMenu` sets on its panel and
// a bar's menu carries inside the glass it grows. The card is the platform's
// width, not its rows': a short menu is not a narrow one, and a long title
// wraps rather than widening it. The rows dim while a submenu is open over
// them.
construct MenuItems() extends Widget {
    let children: [some Widget]


    function describe(context: borrow BuildContext, modifiers: borrow ModifierContext) -> CALayerDescription {
        let recession = kiraUiMenuRecession(context)
        let metrics = resolvedControlMetrics(modifiers)
        let rows = VStack(spacing: .None) {
            For(item in children) {
                item
            }
        }
        .opacity(recession.ink)
        .width(metrics.menuCardWidth)
        var described = rows.describe(context, modifierContextPresenting(modifiers, .MenuRow))
        described.layout.paddingTop = metrics.menuCardPadding
        menuCardFoot(described, modifiers)
        return described
    }
}

// A menu card's rows end on the card's padding, whichever card they are in:
// a menu's own, or a submenu's under its header.
function menuCardFoot(rows: borrow mut CALayerDescription, modifiers: borrow ModifierContext) {
    rows.layout.paddingBottom = resolvedControlMetrics(modifiers).menuCardPadding
    return
}
