}

// Fill-width clickable with an auto-assigned stable per-build key.
Widget TappableFill(onPress: () -> Void, radius: Float) {
    @Content let children: [Any Widget]

    function lower(context: borrow KiraUIFoundation.FoundationUiContext, modifiers: borrow ModifierContext) -> KiraUIFoundation.FoundationView {
        let k = kiraUiTapSeqKey()
        let press = onPress
        return KiraUIFoundation.FoundationView {
            kind: KiraUIFoundation.FoundationViewKind.HitArea
            key: k
            width: KiraUIFoundation.SizeMode.Fill
            height: KiraUIFoundation.SizeMode.Hug
            backgroundFill: modifierColor(kiraUiTapBackground(k), modifiers)
            radius: radius
            disabled: modifiers.disabled
            focusable: true
            autofocus: modifiers.hasFocused && modifiers.focused
            onPress: press
            children: loweredChildren(context, modifiers, children)
        }
    }
}

// --- DismissArea ------------------------------------------------------------

// A window-filling hit region that paints nothing: the backdrop a floating
// overlay (a context menu, a modal card) puts underneath itself so any click
// outside dismisses it.
//
// The Tappable family cannot serve here. Every one of them paints the hover /
// press wash `kiraUiTapBackground` returns, and a wash over a Fill/Fill region
// tints the entire window for as long as the overlay is open. So this is its
// own leaf: same HitArea node, no `backgroundFill`, and a transparent Fill/Fill
// Surface child so the region has something to size against.
Widget DismissArea(key: Int, onPress: () -> Void) {
    function lower(context: borrow KiraUIFoundation.FoundationUiContext, modifiers: borrow ModifierContext) -> KiraUIFoundation.FoundationView {
        let ignored = context.frameCount
        let press = onPress
        var kids: [KiraUIFoundation.FoundationView] = []
        kids.append(KiraUIFoundation.FoundationView {
            kind: KiraUIFoundation.FoundationViewKind.Surface
            width: KiraUIFoundation.SizeMode.Fill
            height: KiraUIFoundation.SizeMode.Fill
            fill: transparentFoundationColor()
        })
        return KiraUIFoundation.FoundationView {
            kind: KiraUIFoundation.FoundationViewKind.HitArea
            key: key
            width: KiraUIFoundation.SizeMode.Fill
            height: KiraUIFoundation.SizeMode.Fill
            disabled: modifiers.disabled
            onPress: press
            children: move kids
        }
    }
}

// --- Expanded ---------------------------------------------------------------

// Fills leftover main-axis space in a stack (an Expanded node with the given
// flex weight). Columns/rows mixing fixed and flexing children lay out reliably
// when the flexing children are built ALL-flex with weights; flex 1 is the plain
// "take the rest" case.
Widget Expanded(flex: Int) {
    @Content let content: Any Widget

    function lower(context: borrow KiraUIFoundation.FoundationUiContext, modifiers: borrow ModifierContext) -> KiraUIFoundation.FoundationView {
        let childModifiers = modifierContextForChildren(modifiers)
        return KiraUIFoundation.FoundationView {
            kind: KiraUIFoundation.FoundationViewKind.Expanded
            width: KiraUIFoundation.SizeMode.Fill
            height: KiraUIFoundation.SizeMode.Fill
            flex: flex
            children: [content.lower(context, childModifiers)]
        }
    }
}

// --- SurfaceBox -------------------------------------------------------------

// A painted Surface container with explicit size, fill, border and corner
// radius, wrapping its children. The general replacement for raw
// FoundationView.Surface construction (menu cards, hover layers, badges,
// transparent spacer gaps). Pass SizeMode.Fixed(...) for a fixed box or
// SizeMode.Fill to stretch to the parent.
Widget SurfaceBox(
    fill: Color,
    border: Color,
    borderWidth: Float,
    radius: Float,
    width: KiraUIFoundation.SizeMode,
    height: KiraUIFoundation.SizeMode,
) {
    @Content let children: [Any Widget]

    function lower(context: borrow KiraUIFoundation.FoundationUiContext, modifiers: borrow ModifierContext) -> KiraUIFoundation.FoundationView {
        var selectedMaterial = KiraUIFoundation.FoundationMaterial.Flat
        if modifiers.hasMaterial {
            selectedMaterial = foundationMaterial(modifiers.material)
        }
        return KiraUIFoundation.FoundationView {
            kind: KiraUIFoundation.FoundationViewKind.Surface
            width: width
            height: height
            fill: modifierSurfaceFill(foundationColor(fill), modifiers)
            border: modifierColor(foundationColor(border), modifiers)
            borderWidth: borderWidth
            radius: radius
            material: selectedMaterial
            disabled: modifiers.disabled
            children: loweredChildren(context, modifiers, children)
        }
    }
}

// --- GestureTextureView -----------------------------------------------------

// An external KiraGraphics texture (an engine viewport render target) wrapped in
// a gesture hit area: scroll drives `onScroll`, and a held drag past the
// threshold drives `onDragStart` / `onDragMove` / `onDragEnd` (dx/dy deltas).
// The texture fills whatever box the layout gives it; the whole region flexes
// like a Fill leaf. `key` must be nonzero and stable across frames.
Widget GestureTextureView(
    key: Int,
    texture: Int,
    radius: Float,
    onScroll: (Float, Float) -> Void,
    onDragStart: (Float, Float) -> Void,
    onDragMove: (Float, Float) -> Void,
    onDragEnd: (Float, Float) -> Void,
) {
    function lower(context: borrow KiraUIFoundation.FoundationUiContext, modifiers: borrow ModifierContext) -> KiraUIFoundation.FoundationView {
        let ignored = context.frameCount
        let k = key
        let cornerRadius = radius
        let scroll = onScroll
        let dragStart = onDragStart
        let dragMove = onDragMove
        let dragEnd = onDragEnd
        var kids: [KiraUIFoundation.FoundationView] = []
        kids.append(KiraUIFoundation.FoundationView {
            kind: KiraUIFoundation.FoundationViewKind.TextureView
            width: KiraUIFoundation.SizeMode.Fill
            height: KiraUIFoundation.SizeMode.Fill
            flex: 1
            texture: texture
            textureOpacity: modifiers.opacity
            radius: cornerRadius
        })
        return KiraUIFoundation.FoundationView {
            kind: KiraUIFoundation.FoundationViewKind.HitArea
            key: k
            width: KiraUIFoundation.SizeMode.Fill
            height: KiraUIFoundation.SizeMode.Fill
            flex: 1
            onScroll: scroll
            disabled: modifiers.disabled
            interaction: KiraUIFoundation.FoundationInteraction {
                onDragStart: dragStart
                onDragMove: dragMove
                onDragEnd: dragEnd
            }
            children: move kids
        }
    }
}
