// The insertion point a focused field draws in the accent.
public struct CaretMetrics {
    let width: Float
    let height: Float
}

public function catalogCaretMetrics(mode: InterfaceMode) -> CaretMetrics {
    return CaretMetrics {
        width: catalogMetric(kiraUICatalogStack, metricCaretWidth(), mode),
        height: catalogMetric(kiraUICatalogStack, metricCaretHeight(), mode)
    }
}

let desktopCaretMetrics = catalogCaretMetrics(.AdaptiveDesktop)
let mobileCaretMetrics = catalogCaretMetrics(.AdaptiveMobile)

public function caretMetrics() -> CaretMetrics {
    return interfaceMode() == .AdaptiveDesktop ? desktopCaretMetrics : mobileCaretMetrics
}
