import Foundation
import KCoreUI

// The lengths menus, tab bars, switches, sliders, progress bars and text
// fields are laid out and moved with, and the colors they are painted with,
// resolved once for each interface mode as the chrome's are.

// --- Menus -------------------------------------------------------------------

// A menu's card and what is in it, at the regular control size: its rows,
// held off the card's edges, and the type in them; the card's width, the air
// at its top and bottom and its corner; the rule between two groups; the
// pill a row lights in and the chevron that opens a submenu; the column a
// row's glyph is centered in and the gap before its title; and the actions
// across the top -- their glyph and caption, and the air around and between
// them. A computer's menu is the platform's dense one, a touch screen's has
// rows a finger lands on.
public struct MenuMetrics {
    let rowHeight: Number
    let leadingInset: Number
    let trailingInset: Number
    var labelSize: Number
    let cardWidth: Number
    let cardPadding: Number
    let cardRadius: Number
    let dividerInset: Number
    let dividerVerticalInset: Number
    let actionPadding: Number
    let pillInset: Number
    let chevronBox: Number
    let chevronSize: Number
    let iconColumn: Number
    let iconGap: Number
    let actionIconSize: Number
    let actionLabelSize: Number
    let actionSpacing: Number
    let actionsTopInset: Number
    let actionsBottomInset: Number
    let actionsInset: Number
    let actionsGap: Number
}

public function catalogMenuMetrics(mode: InterfaceMode) -> MenuMetrics {
    return MenuMetrics {
        rowHeight: catalogMetric(catalogStack, MetricName.menuRowHeight, mode),
        leadingInset: catalogMetric(catalogStack, MetricName.menuLeadingInset, mode),
        trailingInset: catalogMetric(catalogStack, MetricName.menuTrailingInset, mode),
        labelSize: catalogMetric(catalogStack, MetricName.menuLabelSize, mode),
        cardWidth: catalogMetric(catalogStack, MetricName.menuCardWidth, mode),
        cardPadding: catalogMetric(catalogStack, MetricName.menuCardPadding, mode),
        cardRadius: catalogMetric(catalogStack, MetricName.menuCardRadius, mode),
        dividerInset: catalogMetric(catalogStack, MetricName.menuDividerInset, mode),
        dividerVerticalInset: catalogMetric(
            catalogStack,
            MetricName.menuDividerVerticalInset,
            mode
        ),
        actionPadding: catalogMetric(catalogStack, MetricName.menuActionPadding, mode),
        pillInset: catalogMetric(catalogStack, MetricName.menuPillInset, mode),
        chevronBox: catalogMetric(catalogStack, MetricName.menuChevronBox, mode),
        chevronSize: catalogMetric(catalogStack, MetricName.menuChevronSize, mode),
        iconColumn: catalogMetric(catalogStack, MetricName.menuIconColumn, mode),
        iconGap: catalogMetric(catalogStack, MetricName.menuIconGap, mode),
        actionIconSize: catalogMetric(catalogStack, MetricName.menuActionIconSize, mode),
        actionLabelSize: catalogMetric(catalogStack, MetricName.menuActionLabelSize, mode),
        actionSpacing: catalogMetric(catalogStack, MetricName.menuActionSpacing, mode),
        actionsTopInset: catalogMetric(catalogStack, MetricName.menuActionsTopInset, mode),
        actionsBottomInset: catalogMetric(catalogStack, MetricName.menuActionsBottomInset, mode),
        actionsInset: catalogMetric(catalogStack, MetricName.menuActionsInset, mode),
        actionsGap: catalogMetric(catalogStack, MetricName.menuActionsGap, mode)
    }
}

let desktopMenuMetrics = catalogMenuMetrics(.AdaptiveDesktop)
let mobileMenuMetrics = catalogMenuMetrics(.AdaptiveMobile)

// The menu geometry in effect here: the interface's. A Mac menu opened from a
// control is set in the control's font, as an `NSPopUpButton` sets its menu,
// while its rows keep their height at every size; a touch menu ignores the
// control size.
public function menuMetrics(modifiers: borrow ModifierContext) -> MenuMetrics {
    if interfaceMode() != .AdaptiveDesktop { return copy mobileMenuMetrics }
    var metrics = copy desktopMenuMetrics
    metrics.labelSize = resolvedControlSizeMetrics(modifiers).fontSize
    return metrics
}

// A bar's menu growing out of its button's glass and going home into it: the
// springs its width, height and fall ride out and how hard the fall is
// launched, the spring it squares off on and how far along it starts, when it
// shows its rows and how magnified they arrive, and when the button's glyph
// goes. Home: the springs it shrinks, flies and rounds on, how long the way
// home takes, and how the button's own glass leads it there -- how deep in
// the menu it starts, how far out of it it leads, when it surfaces and when
// it starts to lead, the reach that fuses the two, and when the rows go and
// the glyph comes back, out of how much blur.
public struct MenuMorphMetrics {
    let growthResponse: Number
    let growthDamping: Number
    let heightResponse: Number
    let heightDamping: Number
    let dropResponse: Number
    let dropDamping: Number
    let dropLaunch: Number
    let closeResponse: Number
    let closeDamping: Number
    let flightResponse: Number
    let flightDamping: Number
    let cornerResponse: Number
    let closeCornerResponse: Number
    let closeDuration: Number
    let roundness: Number
    let contentOpen: Number
    let contentClose: Number
    let contentZoom: Number
    let contentBlur: Number
    let glyphGone: Number
    let glyphReturn: Number
    let glyphBack: Number
    let glyphBlur: Number
    let homeReach: Number
    let homeDepth: Number
    let homeSurface: Number
    let homeLead: Number
    let homeBlend: Number
}

public function catalogMenuMorphMetrics(mode: InterfaceMode) -> MenuMorphMetrics {
    return MenuMorphMetrics {
        growthResponse: catalogMetric(catalogStack, MetricName.menuMorphGrowthResponse, mode),
        growthDamping: catalogMetric(catalogStack, MetricName.menuMorphGrowthDamping, mode),
        heightResponse: catalogMetric(catalogStack, MetricName.menuMorphHeightResponse, mode),
        heightDamping: catalogMetric(catalogStack, MetricName.menuMorphHeightDamping, mode),
        dropResponse: catalogMetric(catalogStack, MetricName.menuMorphDropResponse, mode),
        dropDamping: catalogMetric(catalogStack, MetricName.menuMorphDropDamping, mode),
        dropLaunch: catalogMetric(catalogStack, MetricName.menuMorphDropLaunch, mode),
        closeResponse: catalogMetric(catalogStack, MetricName.menuMorphCloseResponse, mode),
        closeDamping: catalogMetric(catalogStack, MetricName.menuMorphCloseDamping, mode),
        flightResponse: catalogMetric(catalogStack, MetricName.menuMorphFlightResponse, mode),
        flightDamping: catalogMetric(catalogStack, MetricName.menuMorphFlightDamping, mode),
        cornerResponse: catalogMetric(catalogStack, MetricName.menuMorphCornerResponse, mode),
        closeCornerResponse: catalogMetric(
            catalogStack,
            MetricName.menuMorphCloseCornerResponse,
            mode
        ),
        closeDuration: catalogMetric(catalogStack, MetricName.menuMorphCloseDuration, mode),
        roundness: catalogMetric(catalogStack, MetricName.menuMorphRoundness, mode),
        contentOpen: catalogMetric(catalogStack, MetricName.menuMorphContentOpen, mode),
        contentClose: catalogMetric(catalogStack, MetricName.menuMorphContentClose, mode),
        contentZoom: catalogMetric(catalogStack, MetricName.menuMorphContentZoom, mode),
        contentBlur: catalogMetric(catalogStack, MetricName.menuMorphContentBlur, mode),
        glyphGone: catalogMetric(catalogStack, MetricName.menuMorphGlyphGone, mode),
        glyphReturn: catalogMetric(catalogStack, MetricName.menuMorphGlyphReturn, mode),
        glyphBack: catalogMetric(catalogStack, MetricName.menuMorphGlyphBack, mode),
        glyphBlur: catalogMetric(catalogStack, MetricName.menuMorphGlyphBlur, mode),
        homeReach: catalogMetric(catalogStack, MetricName.menuMorphHomeReach, mode),
        homeDepth: catalogMetric(catalogStack, MetricName.menuMorphHomeDepth, mode),
        homeSurface: catalogMetric(catalogStack, MetricName.menuMorphHomeSurface, mode),
        homeLead: catalogMetric(catalogStack, MetricName.menuMorphHomeLead, mode),
        homeBlend: catalogMetric(catalogStack, MetricName.menuMorphHomeBlend, mode)
    }
}

let desktopMenuMorphMetrics = catalogMenuMorphMetrics(.AdaptiveDesktop)
let mobileMenuMorphMetrics = catalogMenuMorphMetrics(.AdaptiveMobile)

public function menuMorphMetrics() -> MenuMorphMetrics {
    return interfaceMode() == .AdaptiveDesktop ? desktopMenuMorphMetrics : mobileMenuMorphMetrics
}

// A submenu coming out of its row over the menu it is in: the springs its card
// grows and shrinks on; how the menu behind it falls back -- how far, how dim,
// after how long, and on which springs, going and coming back, and the one
// spring it shrinks and grows back on; how far the card rests above its row,
// past where the menu's fall carries it, and how hard it is thrown up past
// that as it opens; where the
// header sits in the card; and at what point of the growth the chevron has
// turned, the glass shows and goes, and the items show and go.
public struct MenuSubmenuMetrics {
    let openResponse: Number
    let openDamping: Number
    let closeResponse: Number
    let closeDamping: Number
    let recededOpacity: Number
    let recedeScale: Number
    let recedeHold: Number
    let dwell: Number
    let widen: Number
    let recedeInResponse: Number
    let recedeInDamping: Number
    let recedeOutResponse: Number
    let recedeOutDamping: Number
    let shrinkResponse: Number
    let shrinkDamping: Number
    let rise: Number
    let riseLaunch: Number
    let headerCenter: Number
    let chevronTurn: Number
    let cardAppear: Number
    let cardAppearSpan: Number
    let cardVanish: Number
    let itemsAppear: Number
    let itemsAppearSpan: Number
    let itemsVanish: Number
    let itemsVanishSpan: Number
}

public function catalogMenuSubmenuMetrics(mode: InterfaceMode) -> MenuSubmenuMetrics {
    return MenuSubmenuMetrics {
        openResponse: catalogMetric(catalogStack, MetricName.menuSubmenuOpenResponse, mode),
        openDamping: catalogMetric(catalogStack, MetricName.menuSubmenuOpenDamping, mode),
        closeResponse: catalogMetric(catalogStack, MetricName.menuSubmenuCloseResponse, mode),
        closeDamping: catalogMetric(catalogStack, MetricName.menuSubmenuCloseDamping, mode),
        recededOpacity: catalogMetric(catalogStack, MetricName.menuSubmenuRecededOpacity, mode),
        recedeScale: catalogMetric(catalogStack, MetricName.menuSubmenuRecedeScale, mode),
        recedeHold: catalogMetric(catalogStack, MetricName.menuSubmenuRecedeHold, mode),
        dwell: catalogMetric(catalogStack, MetricName.menuSubmenuDwell, mode),
        widen: catalogMetric(catalogStack, MetricName.menuSubmenuWiden, mode),
        recedeInResponse: catalogMetric(catalogStack, MetricName.menuSubmenuRecedeInResponse, mode),
        recedeInDamping: catalogMetric(catalogStack, MetricName.menuSubmenuRecedeInDamping, mode),
        recedeOutResponse: catalogMetric(
            catalogStack,
            MetricName.menuSubmenuRecedeOutResponse,
            mode
        ),
        recedeOutDamping: catalogMetric(catalogStack, MetricName.menuSubmenuRecedeOutDamping, mode),
        shrinkResponse: catalogMetric(catalogStack, MetricName.menuSubmenuShrinkResponse, mode),
        shrinkDamping: catalogMetric(catalogStack, MetricName.menuSubmenuShrinkDamping, mode),
        rise: catalogMetric(catalogStack, MetricName.menuSubmenuRise, mode),
        riseLaunch: catalogMetric(catalogStack, MetricName.menuSubmenuRiseLaunch, mode),
        headerCenter: catalogMetric(catalogStack, MetricName.menuSubmenuHeaderCenter, mode),
        chevronTurn: catalogMetric(catalogStack, MetricName.menuSubmenuChevronTurn, mode),
        cardAppear: catalogMetric(catalogStack, MetricName.menuSubmenuCardAppear, mode),
        cardAppearSpan: catalogMetric(catalogStack, MetricName.menuSubmenuCardAppearSpan, mode),
        cardVanish: catalogMetric(catalogStack, MetricName.menuSubmenuCardVanish, mode),
        itemsAppear: catalogMetric(catalogStack, MetricName.menuSubmenuItemsAppear, mode),
        itemsAppearSpan: catalogMetric(catalogStack, MetricName.menuSubmenuItemsAppearSpan, mode),
        itemsVanish: catalogMetric(catalogStack, MetricName.menuSubmenuItemsVanish, mode),
        itemsVanishSpan: catalogMetric(catalogStack, MetricName.menuSubmenuItemsVanishSpan, mode)
    }
}

let desktopMenuSubmenuMetrics = catalogMenuSubmenuMetrics(.AdaptiveDesktop)
let mobileMenuSubmenuMetrics = catalogMenuSubmenuMetrics(.AdaptiveMobile)

public function menuSubmenuMetrics() -> MenuSubmenuMetrics {
    return interfaceMode() == .AdaptiveDesktop ? desktopMenuSubmenuMetrics : mobileMenuSubmenuMetrics
}

// --- Tab bar -----------------------------------------------------------------

// The capsule a `TabView` floats in the toolbar's row and the tabs in it.
public struct TabBarMetrics {
    let height: Number
    let inset: Number
    let tabHeight: Number
    let labelInset: Number
    let symbolInset: Number
}

public function catalogTabBarMetrics(mode: InterfaceMode) -> TabBarMetrics {
    return TabBarMetrics {
        height: catalogMetric(catalogStack, MetricName.tabBarHeight, mode),
        inset: catalogMetric(catalogStack, MetricName.tabBarInset, mode),
        tabHeight: catalogMetric(catalogStack, MetricName.tabHeight, mode),
        labelInset: catalogMetric(catalogStack, MetricName.tabLabelInset, mode),
        symbolInset: catalogMetric(catalogStack, MetricName.tabSymbolInset, mode)
    }
}

let desktopTabBarMetrics = catalogTabBarMetrics(.AdaptiveDesktop)
let mobileTabBarMetrics = catalogTabBarMetrics(.AdaptiveMobile)

public function tabBarMetrics() -> TabBarMetrics {
    return interfaceMode() == .AdaptiveDesktop ? desktopTabBarMetrics : mobileTabBarMetrics
}

// The bar a `TabView` floats at the foot of a phone's screen and the tabs in
// it, each of which stacks its symbol over its title.
public struct PhoneTabBarMetrics {
    let edgeInset: Number
    let bottomInset: Number
    let glassOutset: Number
    let tabAdvance: Number
    let rowInset: Number
    let tabHeight: Number
    let tabOverlap: Number
    let topInset: Number
    let sideInset: Number
    let symbolSize: Number
    let symbolLine: Number
    let titleSize: Number
    let titleLine: Number
    let titleSpacing: Number
}

public let phoneTabBarMetrics = PhoneTabBarMetrics {
    edgeInset: catalogMetric(catalogStack, MetricName.phoneTabBarEdgeInset, .AdaptiveMobile),
    bottomInset: catalogMetric(catalogStack, MetricName.phoneTabBarBottomInset, .AdaptiveMobile),
    glassOutset: catalogMetric(catalogStack, MetricName.phoneTabBarGlassOutset, .AdaptiveMobile),
    tabAdvance: catalogMetric(catalogStack, MetricName.phoneTabAdvance, .AdaptiveMobile),
    rowInset: catalogMetric(catalogStack, MetricName.phoneTabRowInset, .AdaptiveMobile),
    tabHeight: catalogMetric(catalogStack, MetricName.phoneTabHeight, .AdaptiveMobile),
    tabOverlap: catalogMetric(catalogStack, MetricName.phoneTabOverlap, .AdaptiveMobile),
    topInset: catalogMetric(catalogStack, MetricName.phoneTabTopInset, .AdaptiveMobile),
    sideInset: catalogMetric(catalogStack, MetricName.phoneTabSideInset, .AdaptiveMobile),
    symbolSize: catalogMetric(catalogStack, MetricName.phoneTabSymbolSize, .AdaptiveMobile),
    symbolLine: catalogMetric(catalogStack, MetricName.phoneTabSymbolLine, .AdaptiveMobile),
    titleSize: catalogMetric(catalogStack, MetricName.phoneTabTitleSize, .AdaptiveMobile),
    titleLine: catalogMetric(catalogStack, MetricName.phoneTabTitleLine, .AdaptiveMobile),
    titleSpacing: catalogMetric(catalogStack, MetricName.phoneTabTitleSpacing, .AdaptiveMobile)
}

// An unselected tab's title, and the capsule behind the selected one, whose
// title takes the accent. The capsule is burned or dodged into the glass the
// tabs float in, so it is an ink rather than a color.
public let tabLabel = catalogVibrantInk(catalogStack, "tabLabel")
public let tabSelection = catalogVibrantInk(catalogStack, "tabSelection")

// --- Control sizes -------------------------------------------------------------

// An inline control at one `ControlSize`: how tall it stands, how far its label
// is held off its ends, and the size that label is set at. A text field of the
// size stands at its own height, not a button's, and holds its text off its
// ends by the field inset, which is one at every size. A switch stands at its
// A button's bezel and a field's are each rounded by their own radius.
public struct ControlSizeMetrics {
    let height: Number
    let labelInset: Number
    let fontSize: Number
    let cornerRadius: Number
    let fieldHeight: Number
    let fieldInset: Number
    let fieldCornerRadius: Number
}

// The four sizes, read for one interface.
struct ControlSizeTable {
    let mini: ControlSizeMetrics
    let small: ControlSizeMetrics
    let regular: ControlSizeMetrics
    let large: ControlSizeMetrics
}

function catalogControlSize(
    height: borrow String,
    labelInset: borrow String,
    fontSize: borrow String,
    cornerRadius: borrow String,
    fieldHeight: borrow String,
    fieldCornerRadius: borrow String,
    mode: borrow InterfaceMode,
) -> ControlSizeMetrics {
    return ControlSizeMetrics {
        height: catalogMetric(catalogStack, height, mode),
        labelInset: catalogMetric(catalogStack, labelInset, mode),
        fontSize: catalogMetric(catalogStack, fontSize, mode),
        cornerRadius: catalogMetric(catalogStack, cornerRadius, mode),
        fieldHeight: catalogMetric(catalogStack, fieldHeight, mode),
        fieldInset: catalogMetric(catalogStack, MetricName.fieldLabelInset, mode),
        fieldCornerRadius: catalogMetric(catalogStack, fieldCornerRadius, mode)
    }
}

function catalogControlSizeTable(mode: borrow InterfaceMode) -> ControlSizeTable {
    return ControlSizeTable {
        mini: catalogControlSize(
            MetricName.controlMiniHeight,
            MetricName.controlMiniLabelInset,
            MetricName.controlMiniFontSize,
            MetricName.controlMiniCornerRadius,
            MetricName.controlMiniFieldHeight,
            MetricName.controlMiniFieldCornerRadius,
            mode
        ),
        small: catalogControlSize(
            MetricName.controlSmallHeight,
            MetricName.controlSmallLabelInset,
            MetricName.controlSmallFontSize,
            MetricName.controlSmallCornerRadius,
            MetricName.controlSmallFieldHeight,
            MetricName.controlSmallFieldCornerRadius,
            mode
        ),
        regular: catalogControlSize(
            MetricName.controlRegularHeight,
            MetricName.controlRegularLabelInset,
            MetricName.controlRegularFontSize,
            MetricName.controlRegularCornerRadius,
            MetricName.controlRegularFieldHeight,
            MetricName.controlRegularFieldCornerRadius,
            mode
        ),
        large: catalogControlSize(
            MetricName.controlLargeHeight,
            MetricName.controlLargeLabelInset,
            MetricName.controlLargeFontSize,
            MetricName.controlLargeCornerRadius,
            MetricName.controlLargeFieldHeight,
            MetricName.controlLargeFieldCornerRadius,
            mode
        )
    }
}

let desktopControlSizes = catalogControlSizeTable(.AdaptiveDesktop)
let mobileControlSizes = catalogControlSizeTable(.AdaptiveMobile)

public function controlSizeMetrics(size: borrow ControlSize) -> ControlSizeMetrics {
    let table = interfaceMode() == .AdaptiveDesktop ? desktopControlSizes : mobileControlSizes
    match size {
        Mini -> return table.mini
        Small -> return table.small
        Regular -> return table.regular
        Large -> return table.large
    }
}

// The size in effect here: the cascaded `.controlSize(...)`, or regular.
public function resolvedControlSizeMetrics(modifiers: borrow ModifierContext) -> ControlSizeMetrics {
    return controlSizeMetrics(modifiers.controlSize)
}

// --- Pop-up buttons -------------------------------------------------------------

// A Mac's pop-up button at one `ControlSize`: its height, its title held off
// its leading end, its chevron the spacing past the title, drawn at the
// chevron size and held off the trailing end. Its bezel is a button's.
public struct PopUpMetrics {
    let height: Number
    let leadingInset: Number
    let chevronSpacing: Number
    let chevronSize: Number
    let trailingInset: Number
}

function catalogPopUp(
    height: borrow String,
    leadingInset: borrow String,
    chevronSpacing: borrow String,
    chevronSize: borrow String,
    trailingInset: borrow String,
) -> PopUpMetrics {
    return PopUpMetrics {
        height: catalogMetric(catalogStack, height, .AdaptiveDesktop),
        leadingInset: catalogMetric(catalogStack, leadingInset, .AdaptiveDesktop),
        chevronSpacing: catalogMetric(catalogStack, chevronSpacing, .AdaptiveDesktop),
        chevronSize: catalogMetric(catalogStack, chevronSize, .AdaptiveDesktop),
        trailingInset: catalogMetric(catalogStack, trailingInset, .AdaptiveDesktop)
    }
}

let miniPopUp = catalogPopUp(
    MetricName.popUpMiniHeight,
    MetricName.popUpMiniLeadingInset,
    MetricName.popUpMiniChevronSpacing,
    MetricName.popUpMiniChevronSize,
    MetricName.popUpMiniTrailingInset
)
let smallPopUp = catalogPopUp(
    MetricName.popUpSmallHeight,
    MetricName.popUpSmallLeadingInset,
    MetricName.popUpSmallChevronSpacing,
    MetricName.popUpSmallChevronSize,
    MetricName.popUpSmallTrailingInset
)
let regularPopUp = catalogPopUp(
    MetricName.popUpRegularHeight,
    MetricName.popUpRegularLeadingInset,
    MetricName.popUpRegularChevronSpacing,
    MetricName.popUpRegularChevronSize,
    MetricName.popUpRegularTrailingInset
)
let largePopUp = catalogPopUp(
    MetricName.popUpLargeHeight,
    MetricName.popUpLargeLeadingInset,
    MetricName.popUpLargeChevronSpacing,
    MetricName.popUpLargeChevronSize,
    MetricName.popUpLargeTrailingInset
)

public function popUpMetrics(size: borrow ControlSize) -> PopUpMetrics {
    match size {
        Mini -> return miniPopUp
        Small -> return smallPopUp
        Regular -> return regularPopUp
        Large -> return largePopUp
    }
}

// --- Checkboxes -----------------------------------------------------------------

// A Mac's checkbox at one `ControlSize`: the side of its box, how round the
// box is, the size its checkmark is set at, and the gap before its title.
public struct CheckboxMetrics {
    let size: Number
    let cornerRadius: Number
    let checkmarkSize: Number
    let spacing: Number
}

function catalogCheckbox(
    size: borrow String,
    cornerRadius: borrow String,
    checkmarkSize: borrow String,
    spacing: borrow String,
) -> CheckboxMetrics {
    return CheckboxMetrics {
        size: catalogMetric(catalogStack, size, .AdaptiveDesktop),
        cornerRadius: catalogMetric(catalogStack, cornerRadius, .AdaptiveDesktop),
        checkmarkSize: catalogMetric(catalogStack, checkmarkSize, .AdaptiveDesktop),
        spacing: catalogMetric(catalogStack, spacing, .AdaptiveDesktop)
    }
}

let miniCheckbox = catalogCheckbox(
    MetricName.checkboxMiniSize,
    MetricName.checkboxMiniCornerRadius,
    MetricName.checkboxMiniCheckmarkSize,
    MetricName.checkboxMiniSpacing
)
let smallCheckbox = catalogCheckbox(
    MetricName.checkboxSmallSize,
    MetricName.checkboxSmallCornerRadius,
    MetricName.checkboxSmallCheckmarkSize,
    MetricName.checkboxSmallSpacing
)
let regularCheckbox = catalogCheckbox(
    MetricName.checkboxRegularSize,
    MetricName.checkboxRegularCornerRadius,
    MetricName.checkboxRegularCheckmarkSize,
    MetricName.checkboxRegularSpacing
)
let largeCheckbox = catalogCheckbox(
    MetricName.checkboxLargeSize,
    MetricName.checkboxLargeCornerRadius,
    MetricName.checkboxLargeCheckmarkSize,
    MetricName.checkboxLargeSpacing
)

public function checkboxMetrics(size: borrow ControlSize) -> CheckboxMetrics {
    match size {
        Mini -> return miniCheckbox
        Small -> return smallCheckbox
        Regular -> return regularCheckbox
        Large -> return largeCheckbox
    }
}

// --- Switches, sliders and progress bars --------------------------------------

// A switch's capsule track and the knob held inside it, off its ends.
public struct SwitchMetrics {
    let width: Number
    let height: Number
    let knobWidth: Number
    let knobInset: Number
}

function catalogSwitch(
    width: borrow String,
    height: borrow String,
    knobWidth: borrow String,
    knobInset: borrow String,
    mode: borrow InterfaceMode,
) -> SwitchMetrics {
    return SwitchMetrics {
        width: catalogMetric(catalogStack, width, mode),
        height: catalogMetric(catalogStack, height, mode),
        knobWidth: catalogMetric(catalogStack, knobWidth, mode),
        knobInset: catalogMetric(catalogStack, knobInset, mode)
    }
}

// The four sizes of switch, read for one interface.
struct SwitchSizeTable {
    let mini: SwitchMetrics
    let small: SwitchMetrics
    let regular: SwitchMetrics
    let large: SwitchMetrics
}

function catalogSwitchTable(mode: borrow InterfaceMode) -> SwitchSizeTable {
    return SwitchSizeTable {
        mini: catalogSwitch(
            MetricName.switchMiniWidth,
            MetricName.switchMiniHeight,
            MetricName.switchMiniKnobWidth,
            MetricName.switchMiniKnobInset,
            mode
        ),
        small: catalogSwitch(
            MetricName.switchSmallWidth,
            MetricName.switchSmallHeight,
            MetricName.switchSmallKnobWidth,
            MetricName.switchSmallKnobInset,
            mode
        ),
        regular: catalogSwitch(
            MetricName.switchRegularWidth,
            MetricName.switchRegularHeight,
            MetricName.switchRegularKnobWidth,
            MetricName.switchRegularKnobInset,
            mode
        ),
        large: catalogSwitch(
            MetricName.switchLargeWidth,
            MetricName.switchLargeHeight,
            MetricName.switchLargeKnobWidth,
            MetricName.switchLargeKnobInset,
            mode
        )
    }
}

let desktopSwitches = catalogSwitchTable(.AdaptiveDesktop)
let mobileSwitches = catalogSwitchTable(.AdaptiveMobile)

public function switchMetrics(size: borrow ControlSize) -> SwitchMetrics {
    let table = interfaceMode() == .AdaptiveDesktop ? desktopSwitches : mobileSwitches
    match size {
        Mini -> return table.mini
        Small -> return table.small
        Regular -> return table.regular
        Large -> return table.large
    }
}

// A slider's height, the track through its middle, the knob that rides it and
// the two shadows the knob casts: a soft one falling away from it and a tight
// one where it meets the track.
public struct SliderMetrics {
    let height: Number
    let trackHeight: Number
    let knobWidth: Number
    let knobHeight: Number
    // How far in from either end of the track the knob's center stops.
    let knobInset: Number
    let heldKnobWidth: Number
    let heldKnobHeight: Number
    let knobShadowRadius: Number
    let knobShadowOffset: Number
    let knobContactShadowRadius: Number
    let knobContactShadowOffset: Number
}

function catalogSlider(
    height: borrow String,
    trackHeight: borrow String,
    knobWidth: borrow String,
    knobHeight: borrow String,
    knobInset: borrow String,
    mode: borrow InterfaceMode,
) -> SliderMetrics {
    return SliderMetrics {
        height: catalogMetric(catalogStack, height, mode),
        trackHeight: catalogMetric(catalogStack, trackHeight, mode),
        knobWidth: catalogMetric(catalogStack, knobWidth, mode),
        knobHeight: catalogMetric(catalogStack, knobHeight, mode),
        knobInset: catalogMetric(catalogStack, knobInset, mode),
        heldKnobWidth: catalogMetric(catalogStack, MetricName.sliderHeldKnobWidth, mode),
        heldKnobHeight: catalogMetric(catalogStack, MetricName.sliderHeldKnobHeight, mode),
        knobShadowRadius: catalogMetric(catalogStack, MetricName.knobShadowRadius, mode),
        knobShadowOffset: catalogMetric(catalogStack, MetricName.knobShadowOffset, mode),
        knobContactShadowRadius: catalogMetric(
            catalogStack,
            MetricName.knobContactShadowRadius,
            mode
        ),
        knobContactShadowOffset: catalogMetric(
            catalogStack,
            MetricName.knobContactShadowOffset,
            mode
        )
    }
}

// The four sizes of slider, read for one interface.
struct SliderSizeTable {
    let mini: SliderMetrics
    let small: SliderMetrics
    let regular: SliderMetrics
    let large: SliderMetrics
}

function catalogSliderTable(mode: borrow InterfaceMode) -> SliderSizeTable {
    return SliderSizeTable {
        mini: catalogSlider(
            MetricName.sliderMiniHeight,
            MetricName.sliderMiniTrackHeight,
            MetricName.sliderMiniKnobWidth,
            MetricName.sliderMiniKnobHeight,
            MetricName.sliderMiniKnobInset,
            mode
        ),
        small: catalogSlider(
            MetricName.sliderSmallHeight,
            MetricName.sliderSmallTrackHeight,
            MetricName.sliderSmallKnobWidth,
            MetricName.sliderSmallKnobHeight,
            MetricName.sliderSmallKnobInset,
            mode
        ),
        regular: catalogSlider(
            MetricName.sliderRegularHeight,
            MetricName.sliderRegularTrackHeight,
            MetricName.sliderRegularKnobWidth,
            MetricName.sliderRegularKnobHeight,
            MetricName.sliderRegularKnobInset,
            mode
        ),
        large: catalogSlider(
            MetricName.sliderLargeHeight,
            MetricName.sliderLargeTrackHeight,
            MetricName.sliderLargeKnobWidth,
            MetricName.sliderLargeKnobHeight,
            MetricName.sliderLargeKnobInset,
            mode
        )
    }
}

let desktopSliders = catalogSliderTable(.AdaptiveDesktop)
let mobileSliders = catalogSliderTable(.AdaptiveMobile)

public function sliderMetrics(size: borrow ControlSize) -> SliderMetrics {
    let table = interfaceMode() == .AdaptiveDesktop ? desktopSliders : mobileSliders
    match size {
        Mini -> return table.mini
        Small -> return table.small
        Regular -> return table.regular
        Large -> return table.large
    }
}

// How opaque a switch or slider stands while it is disabled.
public function catalogDisabledControlOpacity(mode: InterfaceMode) -> Number {
    return catalogMetric(catalogStack, MetricName.disabledControlOpacity, mode)
}

let desktopDisabledControlOpacity = catalogDisabledControlOpacity(.AdaptiveDesktop)
let mobileDisabledControlOpacity = catalogDisabledControlOpacity(.AdaptiveMobile)

public function disabledControlOpacity() -> Number {
    return interfaceMode() == .AdaptiveDesktop ? desktopDisabledControlOpacity : mobileDisabledControlOpacity
}

// A progress bar: the height it stands, the track through its middle and the
// edge drawn around that track.
public struct ProgressMetrics {
    let height: Number
    let trackHeight: Number
    let trackBorderWidth: Number
}

public function catalogProgressMetrics(mode: InterfaceMode) -> ProgressMetrics {
    return ProgressMetrics {
        height: catalogMetric(catalogStack, MetricName.progressHeight, mode),
        trackHeight: catalogMetric(catalogStack, MetricName.progressTrackHeight, mode),
        trackBorderWidth: catalogMetric(catalogStack, MetricName.progressTrackBorderWidth, mode)
    }
}

let desktopProgressMetrics = catalogProgressMetrics(.AdaptiveDesktop)
let mobileProgressMetrics = catalogProgressMetrics(.AdaptiveMobile)

public function progressMetrics() -> ProgressMetrics {
    return interfaceMode() == .AdaptiveDesktop ? desktopProgressMetrics : mobileProgressMetrics
}

// A switch's track on and off, the knob a switch and a slider share and the
// shadow a slider's knob casts, the wash in a held slider knob's glass, and the
// tracks under a slider's knob and a progress bar's fill.
public let switchOn = catalogAdaptive(catalogStack, "switchOn")
public let switchOff = catalogAdaptive(catalogStack, "switchOff")
public let controlKnob = catalogAdaptive(catalogStack, "controlKnob")
public let knobShadow = catalogAdaptive(catalogStack, "knobShadow")
public let sliderTrack = catalogAdaptive(catalogStack, "sliderTrack")
public let sliderKnobGlass = catalogAdaptive(catalogStack, "sliderKnobGlass")
public let progressTrack = catalogAdaptive(catalogStack, "progressTrack")
public let progressTrackBorder = catalogAdaptive(catalogStack, "progressTrackBorder")

// A Mac text field's bezel and the hairline around it.
public let fieldBackground = catalogAdaptive(catalogStack, "fieldBackground")
public let fieldBorder = catalogAdaptive(catalogStack, "fieldBorder")

// The shadow a menu's card casts, and the wash under the row a press is on.
public let menuShadow = catalogAdaptive(catalogStack, "menuShadow")
public let menuRowHighlight = catalogAdaptive(catalogStack, "menuRowHighlight")
// How far a menu's shadow blurs and how far below the card it falls.
public struct MenuShadowMetrics {
    let radius: Number
    let offset: Number
}

public function catalogMenuShadowMetrics(mode: InterfaceMode) -> MenuShadowMetrics {
    return MenuShadowMetrics {
        radius: catalogMetric(catalogStack, MetricName.menuShadowRadius, mode),
        offset: catalogMetric(catalogStack, MetricName.menuShadowOffset, mode)
    }
}

let desktopMenuShadowMetrics = catalogMenuShadowMetrics(.AdaptiveDesktop)
let mobileMenuShadowMetrics = catalogMenuShadowMetrics(.AdaptiveMobile)

public function menuShadowMetrics() -> MenuShadowMetrics {
    return interfaceMode() == .AdaptiveDesktop ? desktopMenuShadowMetrics : mobileMenuShadowMetrics
}

// --- Text fields --------------------------------------------------------------

// The insertion point a focused field draws in the accent.
public struct CaretMetrics {
    let width: Number
    let height: Number
}

public function catalogCaretMetrics(mode: InterfaceMode) -> CaretMetrics {
    return CaretMetrics {
        width: catalogMetric(catalogStack, MetricName.caretWidth, mode),
        height: catalogMetric(catalogStack, MetricName.caretHeight, mode)
    }
}

let desktopCaretMetrics = catalogCaretMetrics(.AdaptiveDesktop)
let mobileCaretMetrics = catalogCaretMetrics(.AdaptiveMobile)

public function caretMetrics() -> CaretMetrics {
    return interfaceMode() == .AdaptiveDesktop ? desktopCaretMetrics : mobileCaretMetrics
}
