import Foundation
import KCoreAnimation

// Layout for the retained description tree.
//
// The compositor draws whatever `position`/`size` a layer carries; this is what
// puts them there. It reads the `CALayoutIntent` each widget's `describe()`
// recorded — an axis, a sizing mode, spacing, padding, a flex weight — and
// resolves the tree against an offered size, exactly as a stack-based layout
// does: measure what each subtree wants, then place each one in the space it is
// given.
//
// Two passes. `caMeasure` walks bottom-up and answers how large a subtree wants
// to be when nothing forces its size. `caPlace` walks top-down, deciding each
// layer's final box from the size offered to it and handing each child the box
// it gets. Kept apart because a fill child's size is the parent's to give and a
// hug parent's size is the children's to report — one pass cannot know both at
// the node it is on.
//
// Height follows width. Text that wraps is taller the narrower it is set, so a
// subtree is always measured against the width it could be given, and a row
// whose content overflows that width narrows the content that can give some
// back before anything is placed.

// What a subtree wants along each axis, at most `availableWidth` wide where its
// content can wrap, when it is neither filled nor fixed.
//
// For a description still being built: it is measured as it stands now, on a
// copy, since whatever builds it may change it after asking.
//
// Only a layout pass keeps measures on a layer, and every frame lays out a tree
// `describe` has just built, so a description reaches here, and reaches
// `caLayoutTree`, with none kept.
public function caMeasure(node: borrow CALayerDescription, availableWidth: Float) -> Size {
    var scratch = copy node
    return caMeasureLaid(scratch, availableWidth)
}

// `caMeasure` inside a layout pass, which keeps each answer on the layer it
// is about. Placing a layer measures it at the width offered and again at the
// width it took, and its parent has measured it already: without the answers
// kept, a tree costs a walk of every subtree under each of its ancestors, many
// times over.
public function caMeasureLaid(node: borrow mut CALayerDescription, availableWidth: Float) -> Size {
    if availableWidth == node.measuredAt {
        return node.measured
    }
    if availableWidth == node.measuredAtLast {
        return node.measuredLast
    }
    let size = caMeasureSubtree(node, availableWidth)
    node.measuredAtLast = node.measuredAt
    node.measuredLast = node.measured
    node.measuredAt = availableWidth
    node.measured = size
    return size
}

function caMeasureSubtree(node: borrow mut CALayerDescription, availableWidth: Float) -> Size {
    let intent = node.layout
    var outerWidth = caCappedWidth(intent, availableWidth)
    if intent.fixedWidth >= 0.0 {
        outerWidth = intent.fixedWidth
    }
    let innerWidth = max(outerWidth - intent.paddingLeading - intent.paddingTrailing, 0.0)

    // A fixed or intrinsic extent answers directly; otherwise the extent is what
    // the content or the arrangement of the sublayers comes to.
    let content = caContentSize(node, innerWidth)
    var contentWidth = content.width
    var contentHeight = content.height

    match intent.axis {
        None -> {
            // A wrapper or overlay wants the largest of what it holds.
            for i in 0..node.sublayers.count {
                let child = caMeasureLaid(node.sublayers[i], innerWidth)
                contentWidth = max(contentWidth, child.width)
                contentHeight = max(contentHeight, child.height)
            }
        }
        Row -> {
            let widths = caRowWidths(node, innerWidth, false)
            var sum = 0.0
            var maxH = 0.0
            for i in 0..node.sublayers.count {
                let child = caMeasureLaid(node.sublayers[i], widths[i])
                sum = sum + widths[i]
                maxH = max(maxH, child.height)
            }
            contentWidth = sum + caStackSpacing(node)
            contentHeight = maxH
        }
        Column -> {
            var sum = 0.0
            var maxW = 0.0
            for i in 0..node.sublayers.count {
                let child = caMeasureLaid(node.sublayers[i], innerWidth)
                sum = sum + child.height
                maxW = max(maxW, child.width)
            }
            contentWidth = maxW
            contentHeight = sum + caStackSpacing(node)
        }
    }

    var wantW = contentWidth + intent.paddingLeading + intent.paddingTrailing
    var wantH = contentHeight + intent.paddingTop + intent.paddingBottom
    if intent.fixedWidth >= 0.0 {
        wantW = intent.fixedWidth
    }
    if intent.fixedHeight >= 0.0 {
        wantH = intent.fixedHeight
    }
    return Size { width: max(caCappedWidth(intent, wantW), intent.minWidth), height: max(wantH, intent.minHeight) }
}

// A width held under the layer's ceiling, when it has one.
public function caCappedWidth(intent: borrow CALayoutIntent, width: Float) -> Float {
    if intent.maxWidth >= 0.0 {
        return min(width, intent.maxWidth)
    }
    return width
}

// The size a layer's own content asks for at `width`: its intrinsic extent, or —
// for text that wraps and does not fit — the lines it breaks into there.
public function caContentSize(node: borrow CALayerDescription, width: Float) -> Size {
    let intrinsic = Size { width: node.layout.intrinsicWidth, height: node.layout.intrinsicHeight }
    if intrinsic.width <= width + 0.5 {
        return intrinsic
    }
    match node.content {
        Text(t) -> {
            if t.wraps {
                return foundationTextWrappedSize(t.content, t.size, t.weight, width)
            }
        }
        else -> {}
    }
    return intrinsic
}

// The width each sublayer of a row gets out of `innerWidth`.
//
// Every child first takes what it wants. When that overflows the row, each
// child in turn is offered its width less the overflow and gives back what it
// can — text by wrapping, a fixed glyph not at all — until the row fits or
// nothing more gives. When `sharesLeftover`, flex children then split what is
// left on top of their minimum width, as a flex basis; a measure has no
// leftover to share, so there they ask like the rest.
public function caRowWidths(node: borrow mut CALayerDescription, innerWidth: Float, sharesLeftover: Bool) -> [Float] {
    let count = node.sublayers.count
    var widths: [Float] = []
    var used = 0.0
    var flexTotal = 0
    for i in 0..count {
        let flex = node.sublayers[i].layout.flex
        if sharesLeftover && flex > 0 {
            let basis = node.sublayers[i].layout.minWidth
            flexTotal = flexTotal + flex
            used = used + basis
            widths.append(basis)
        } else {
            let want = caMeasureLaid(node.sublayers[i], innerWidth).width
            used = used + want
            widths.append(want)
        }
    }
    used = used + caStackSpacing(node)

    var overflow = used - innerWidth
    for i in 0..count {
        if overflow <= 0.5 {
            break
        }
        if sharesLeftover && node.sublayers[i].layout.flex > 0 {
            continue
        }
        let offered = max(widths[i] - overflow, 0.0)
        let given = min(caMeasureLaid(node.sublayers[i], offered).width, widths[i])
        overflow = overflow - (widths[i] - given)
        widths[i] = given
    }

    if flexTotal > 0 {
        let leftover = max(-overflow, 0.0)
        for i in 0..count {
            let flex = node.sublayers[i].layout.flex
            if flex > 0 {
                widths[i] = node.sublayers[i].layout.minWidth + leftover * Float(flex) / Float(flexTotal)
            }
        }
    }
    return widths
}

// The gap a stack leaves before its sublayer at `index`: none before the first,
// and otherwise its spacing, scaled by how fully the sublayer stands in the
// stack and by how fully anything before it does. A sublayer folding away in
// the middle so takes one gap with it, and one folding away at either end
// takes the gap on its inner side -- what the stack closes up to without it.
public function caGapBefore(node: borrow CALayerDescription, index: Int) -> Float {
    var before = 0.0
    for i in 0..index {
        before = max(before, node.sublayers[i].layout.presence)
    }
    return node.layout.spacing * min(node.sublayers[index].layout.presence, before)
}

// Every gap a stack leaves between its sublayers.
public function caStackSpacing(node: borrow CALayerDescription) -> Float {
    var total = 0.0
    for i in 0..node.sublayers.count {
        total = total + caGapBefore(node, i)
    }
    return total
}

// This layer's own size given the space offered to it: fixed wins, then fill
// takes the offer, then it hugs what it measured.
public function caResolvedExtent(intent: borrow CALayoutIntent, measured: Float, offered: Float, fixed: Float, fill: Bool) -> Float {
    if fixed >= 0.0 {
        return fixed
    }
    if fill {
        return offered
    }
    return measured
}

// Place `node` in a box of the offered size and lay its sublayers out inside it.
public function caPlace(node: borrow mut CALayerDescription, offeredWidth: Float, offeredHeight: Float) {
    let intent = node.layout
    let width = max(caCappedWidth(intent, caResolvedExtent(intent, caMeasureLaid(node, offeredWidth).width, offeredWidth, intent.fixedWidth, intent.widthFill)), intent.minWidth)
    // Height is measured at the width the layer resolved to, which a fill
    // layer may have been handed rather than asked for.
    let height = max(caResolvedExtent(intent, caMeasureLaid(node, width).height, offeredHeight, intent.fixedHeight, intent.heightFill), intent.minHeight)
    node.size = Size { width: width, height: height }

    let innerX = intent.paddingLeading
    let innerY = intent.paddingTop
    let innerW = width - intent.paddingLeading - intent.paddingTrailing
    let innerH = height - intent.paddingTop - intent.paddingBottom

    if node.scrollAxis != .None {
        caPlaceScrolling(node, innerX, innerY, innerW, innerH)
        return
    }
    match intent.axis {
        None -> {
            // Every sublayer shares the inner box, and one that resolved smaller
            // than it sits where the layer's alignment says.
            for i in 0..node.sublayers.count {
                caPlace(node.sublayers[i], innerW, innerH)
                let child = node.sublayers[i].size
                node.sublayers[i].position = Point {
                    x: innerX + (innerW - child.width) * intent.alignment.x,
                    y: innerY + (innerH - child.height) * intent.alignment.y
                }
            }
        }
        Row -> {
            caPlaceRow(node, innerX, innerY, innerW, innerH)
        }
        Column -> {
            caPlaceColumn(node, innerX, innerY, innerW, innerH)
        }
    }
}

// As long as anything could want: what a scrolling layer offers along its axis.
public let caUnboundedLength = 1000000.0

// A scrolling layer: each sublayer is as long along the axis as it wants, from
// the start of the inner box, and sits across it where the layer's alignment
// says. How long the longest came out, against the box it is shown through,
// is what the layer can scroll, and goes to the scroll view under its key.
public function caPlaceScrolling(
    node: borrow mut CALayerDescription,
    originX: Float,
    originY: Float,
    innerWidth: Float,
    innerHeight: Float,
) {
    let vertical = node.scrollAxis == .Column
    var length = 0.0
    for i in 0..node.sublayers.count {
        let wanted = caMeasureLaid(node.sublayers[i], vertical ? innerWidth : caUnboundedLength)
        if vertical {
            caPlace(node.sublayers[i], innerWidth, wanted.height)
        } else {
            caPlace(node.sublayers[i], wanted.width, innerHeight)
        }
        let child = node.sublayers[i].size
        if vertical {
            node.sublayers[i].position = Point { x: originX + (innerWidth - child.width) * node.layout.alignment.x, y: originY }
            length = max(length, child.height)
        } else {
            node.sublayers[i].position = Point { x: originX, y: originY + (innerHeight - child.height) * node.layout.alignment.y }
            length = max(length, child.width)
        }
    }
    kiraUiScrollMeasured(node.hitKey, length, vertical ? innerHeight : innerWidth)
}

// A row: each sublayer takes the width `caRowWidths` gives it, placed at the
// running offset, and sits across the row where the row's alignment says.
public function caPlaceRow(
    node: borrow mut CALayerDescription,
    originX: Float,
    originY: Float,
    innerWidth: Float,
    innerHeight: Float,
) {
    let widths = caRowWidths(node, innerWidth, true)
    var cursor = 0.0
    for i in 0..node.sublayers.count {
        cursor = cursor + caGapBefore(node, i)
        caPlace(node.sublayers[i], widths[i], innerHeight)
        let across = (innerHeight - node.sublayers[i].size.height) * node.layout.alignment.y
        node.sublayers[i].position = Point { x: originX + cursor, y: originY + across }
        cursor = cursor + widths[i]
    }
}

// A column: fixed-height sublayers take what they measure at the column's
// width, flex ones split the remainder on top of their minimum height, and
// each sits across the column where the column's alignment says.
public function caPlaceColumn(
    node: borrow mut CALayerDescription,
    originX: Float,
    originY: Float,
    innerWidth: Float,
    innerHeight: Float,
) {
    let count = node.sublayers.count
    if count == 0 {
        return
    }
    // The height the non-flex children want, and the total flex weight sharing
    // what is left.
    var heights: [Float] = []
    var fixedMain = 0.0
    var flexTotal = 0
    for i in 0..count {
        let flex = node.sublayers[i].layout.flex
        if flex > 0 {
            let basis = node.sublayers[i].layout.minHeight
            flexTotal = flexTotal + flex
            fixedMain = fixedMain + basis
            heights.append(basis)
        } else {
            let want = caMeasureLaid(node.sublayers[i], innerWidth).height
            fixedMain = fixedMain + want
            heights.append(want)
        }
    }
    let leftover = max(innerHeight - fixedMain - caStackSpacing(node), 0.0)

    var cursor = 0.0
    for i in 0..count {
        let flex = node.sublayers[i].layout.flex
        if flex > 0 && flexTotal > 0 {
            heights[i] = node.sublayers[i].layout.minHeight + leftover * Float(flex) / Float(flexTotal)
        }
        cursor = cursor + caGapBefore(node, i)
        caPlace(node.sublayers[i], innerWidth, heights[i])
        let across = (innerWidth - node.sublayers[i].size.width) * node.layout.alignment.x
        node.sublayers[i].position = Point { x: originX + across, y: originY + cursor }
        cursor = cursor + heights[i]
    }
}

// Lay a whole tree out against a window of the given size, ready to reconcile.
public function caLayoutTree(root: borrow mut CALayerDescription, width: Float, height: Float) {
    caPlace(root, width, height)
    root.position = Point { x: 0.0, y: 0.0 }
    caResolveGuides(root)
    caApplyOffsets(root)
}

// Moves each follower's leading edge to the guide it follows, as published by
// the sublayers placed before it, in the follower's parent's coordinates.
public function caResolveGuides(node: borrow mut CALayerDescription) {
    for i in 0..node.sublayers.count {
        let tag = node.sublayers[i].layout.followsGuide
        if tag != 0 {
            var found = false
            var at = 0.0
            for j in 0..i {
                if !found {
                    let answer = caGuideIn(node.sublayers[j], tag)
                    if answer.found {
                        found = true
                        at = node.sublayers[j].position.x + answer.x
                    }
                }
            }
            if found {
                let trailing = node.sublayers[i].position.x + node.sublayers[i].size.width
                node.sublayers[i].position = Point { x: at, y: node.sublayers[i].position.y }
                node.sublayers[i].size = Size { width: max(trailing - at, 0.0), height: node.sublayers[i].size.height }
            }
        }
        caResolveGuides(node.sublayers[i])
    }
}

public struct CAGuideAnswer {
    var found: Bool = false
    var x: Float = 0.0
}

// Where `tag` sits in a layer's own coordinates, as the layer or the first of
// its sublayers to publish it answers.
public function caGuideIn(node: borrow CALayerDescription, tag: Int) -> CAGuideAnswer {
    if node.layout.guide == tag {
        return CAGuideAnswer { found: true, x: node.layout.guideFraction * node.size.width + node.layout.guidePosition }
    }
    for child in node.sublayers {
        let answer = caGuideIn(child, tag)
        if answer.found {
            return CAGuideAnswer { found: true, x: child.position.x + answer.x }
        }
    }
    return CAGuideAnswer {}
}

// Moves every layer by its offset once everything is placed, so it is drawn
// displaced while its siblings sit where they would without it.
public function caApplyOffsets(node: borrow mut CALayerDescription) {
    node.position = Point {
        x: node.position.x + node.layout.offset.x,
        y: node.position.y + node.layout.offset.y
    }
    for i in 0..node.sublayers.count {
        caApplyOffsets(node.sublayers[i])
    }
}
