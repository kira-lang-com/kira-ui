import Foundation
import KiraUI
import KCoreAnimation

// Builds the `CALayerDescription` a widget contributes to the retained tree,
// with the default environment every test starts from.
function describedLayer(root: Any Widget) -> CALayerDescription {
    let widgetContext = buildContext(FoundationUiContext {})
    return root.describe(widgetContext, ModifierContext {})
}

// The same, in the viewport of a wide window, where a split view shows both of
// its columns.
function describedLayerInWideWindow(root: Any Widget) -> CALayerDescription {
    let widgetContext = buildContext(
        FoundationUiContext { viewport: Size { width: 1100.0, height: 720.0 } }
    )
    return root.describe(widgetContext, ModifierContext {})
}

// The same, inside a sidebar, where its sections and rows take the sidebar's
// presentation.
function describedLayerInSidebar(root: Any Widget) -> CALayerDescription {
    let widgetContext = buildContext(FoundationUiContext {})
    return root.describe(widgetContext, modifierContextPresenting(ModifierContext {}, .Sidebar))
}
