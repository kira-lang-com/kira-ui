import Foundation
import KiraUI
import KCoreAnimation

// The text a layer draws, as the compositor carries it: its content, size,
// weight and colour. A layer with any other content has no text run, so the
// empty run is returned for it.
function textRunOf(layer: borrow CALayerDescription) -> CAText {
    var run = CAText {}
    match layer.content {
        Text(text) -> run = copy text
        else -> {
            // Only a text layer carries a run; every other content keeps the empty one.
        }
    }
    return run
}
