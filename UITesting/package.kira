// KiraUI UI tests: tests that launch an application, find its elements
// as assistive technology reads them, and press and type into them as a
// person would. A UI test package depends on this library, writes `@Test`
// functions, and is run beside its application by `ui test`.
construct KiraUITesting extends Package {
    let version: String = "0.1.0"
    let kind: PackageKind = .Library
    let dependencies: [Dependency] = [Dependency { name: "KiraUI", path: ".." }]
}
