// Canonical OpacityUI Theme API showcase.
//
// KiraUI owns the token vocabulary: the palette (what `.foregroundColor(...)`
// resolves), the foreground hierarchy, the background elevation roles, the
// control fills, the tints, the borders, and the materials. OpacityUI fills
// every group and assigns one global style to every native component.
// Constructor arguments are the component overrides.

import KiraUI
import KiraUIFoundation


construct OpacityStyle() extends StyleImplementation {
    let palette = StylePaletteTokens {
        red = AdaptiveColor {
            light = Color { r = 1.0, g = 0.231, b = 0.188, a = 1.0 }
            dark = Color { r = 1.0, g = 0.271, b = 0.227, a = 1.0 }
        }

        orange = AdaptiveColor {
            light = Color { r = 1.0, g = 0.584, b = 0.0, a = 1.0 }
            dark = Color { r = 1.0, g = 0.624, b = 0.039, a = 1.0 }
        }

        yellow = AdaptiveColor {
            light = Color { r = 1.0, g = 0.8, b = 0.0, a = 1.0 }
            dark = Color { r = 1.0, g = 0.839, b = 0.039, a = 1.0 }
        }

        green = AdaptiveColor {
            light = Color { r = 0.204, g = 0.78, b = 0.349, a = 1.0 }
            dark = Color { r = 0.188, g = 0.82, b = 0.345, a = 1.0 }
        }

        mint = AdaptiveColor {
            light = Color { r = 0.0, g = 0.78, b = 0.745, a = 1.0 }
            dark = Color { r = 0.388, g = 0.902, b = 0.886, a = 1.0 }
        }

        teal = AdaptiveColor {
            light = Color { r = 0.188, g = 0.69, b = 0.78, a = 1.0 }
            dark = Color { r = 0.251, g = 0.784, b = 0.878, a = 1.0 }
        }

        cyan = AdaptiveColor {
            light = Color { r = 0.196, g = 0.678, b = 0.902, a = 1.0 }
            dark = Color { r = 0.392, g = 0.824, b = 1.0, a = 1.0 }
        }

        blue = AdaptiveColor {
            light = Color { r = 0.20, g = 0.45, b = 0.96, a = 1.0 }
            dark = Color { r = 0.43, g = 0.67, b = 1.0, a = 1.0 }
        }

        indigo = AdaptiveColor {
            light = Color { r = 0.345, g = 0.337, b = 0.839, a = 1.0 }
            dark = Color { r = 0.369, g = 0.361, b = 0.902, a = 1.0 }
        }

        purple = AdaptiveColor {
            light = Color { r = 0.686, g = 0.322, b = 0.871, a = 1.0 }
            dark = Color { r = 0.749, g = 0.353, b = 0.949, a = 1.0 }
        }

        pink = AdaptiveColor {
            light = Color { r = 1.0, g = 0.176, b = 0.333, a = 1.0 }
            dark = Color { r = 1.0, g = 0.216, b = 0.373, a = 1.0 }
        }

        brown = AdaptiveColor {
            light = Color { r = 0.635, g = 0.518, b = 0.369, a = 1.0 }
            dark = Color { r = 0.675, g = 0.557, b = 0.408, a = 1.0 }
        }

        gray = AdaptiveColor {
            light = Color { r = 0.557, g = 0.557, b = 0.576, a = 1.0 }
            dark = Color { r = 0.557, g = 0.557, b = 0.576, a = 1.0 }
        }
    }

    let foregrounds = StyleForegroundTokens {
        primary = AdaptiveColor {
            light = Color { r = 0.08, g = 0.09, b = 0.12, a = 1.0 }
            dark = Color { r = 0.95, g = 0.96, b = 0.99, a = 1.0 }
        }

        secondary = AdaptiveColor {
            light = Color { r = 0.38, g = 0.40, b = 0.46, a = 1.0 }
