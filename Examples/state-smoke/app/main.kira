import KCoreAnimation
import KiraUI

construct Panel {
    @Required let body: Int
}

construct Demo() extends Panel {
    @State var count: Int = 100
    @State var label: String = "start"
    let body: Int = 1

    function bump() -> Int {
        count = count + 1
        return count
    }

    function rename(next: String) {
        label = move next
        return
    }

    function read() -> String {
        return label
    }
}

construct StateLabel() extends Widget {
    @State var label: String = "from-state"
    body {
        Text(label)
    }
}

function ssText(view: borrow CALayerDescription) -> String {
    var out = ""
    match view.content {
        Text(run) -> { out = run.content }
        Empty -> {}
        Solid(s) -> {}
        Texture(x) -> {}
        Icon(i) -> {}
        Glass(g) -> {}
        Gradient(g) -> {}
    }
    return out
}

function ssTextureHandle(view: borrow CALayerDescription) -> Int {
    var out = 0 - 1
    match view.content {
        Texture(tex) -> { out = tex.handle.raw }
        Empty -> {}
        Solid(s) -> {}
        Text(t) -> {}
        Icon(i) -> {}
        Glass(g) -> {}
        Gradient(g) -> {}
    }
    return out
}

@Main
function main() {
    if is_State_propertyWrapper() {
        print("state-is-wrapper")
    }
    let d = Demo()
    if d.bump() == 101 {
        print("first-bump-ok")
    }
    // A fresh instance sees the SAME state (identity = declaration, not instance).
    let d2 = Demo()
    if d2.bump() == 102 {
        print("persists-across-instances")
    }
    d2.rename("changed")
    if d.read() == "changed" {
        print("string-state-persists")
    }
    // @State read inside a real Widget `body` builder: the lowered foundation view carries the
    // CURRENT state value, and a state write shows up on the next lower (the interactive loop's
    // per-frame rebuild).
    let context = buildContext(FoundationUiContext {})
    let before = StateLabel().describe(context, ModifierContext {})
    if ssText(before) == "from-state" {
        print("widget-body-reads-state")
    }
    __pw_StateLabel_set_label("relowered")
    let after = StateLabel().describe(context, ModifierContext {})
    if ssText(after) == "relowered" {
        print("widget-body-sees-state-write")
    }
    if viewportLowerSurface() {
        print("viewport-widget-lowers")
    }
}

// Compile-surface check: the Viewport widget lowers to a foundation TextureView leaf.
function viewportLowerSurface() -> Bool {
    let context = buildContext(FoundationUiContext {})
    let lowered = TextureViewport(texture: TextureHandle(7)).describe(context, ModifierContext {})
    return ssTextureHandle(lowered) == 7
}

// Compile-surface check: the interactive runner lowers widgets per frame. Never called here
// (headless smoke); referencing it keeps the closure/lowering path checked.
function interactiveRunnerSurface() {
    RunKiraWindowApp("unused", 640, 480, { in
        return AppSurface {
            Text("hi")
        }
    })
    return
}
