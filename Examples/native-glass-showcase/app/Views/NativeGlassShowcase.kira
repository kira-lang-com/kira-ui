import Foundation
import KiraUI

// Native compositor glass is visible over the desktop, while every opaque
// region still uses the normal portable Liquid Glass rendering path.
construct NativeGlassShowcase() extends Widget {
    body {
        VStack(spacing = .Large) {
            Text("KiraUI native compositor glass")
            .font(size = scaledMetric(27.0), weight = .Bold)

            HStack(spacing = .Large) {
                VStack(spacing = .Medium) {
                    Text("Transparent substrate")
                    .font(size = scaledMetric(20.0), weight = .SemiBold)
                    Text("Refraction samples macOS behind the window.")
                }
                .padding(scaledMetric(25.0))
                .glassEffect(.Regular, .RoundedRect(28.0))

                VStack(spacing = .Medium) {
                    Text("Portable fallback")
                    .font(size = scaledMetric(20.0), weight = .SemiBold)
                    Text("Opaque surfaces stay in KiraUI's renderer.")
                }
                .padding(scaledMetric(25.0))
                .background(LinearGradient(start: RGBAColor { r: 0.09, g: 0.11, b: 0.14, a: 1.0 }, end: RGBAColor { r: 0.12, g: 0.13, b: 0.16, a: 1.0 }))
                .glassEffect(.Regular, .RoundedRect(28.0))
            }
        }
        .padding(scaledMetric(35.0))
    }
}
