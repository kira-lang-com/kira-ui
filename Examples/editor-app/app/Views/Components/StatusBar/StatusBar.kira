import KiraUI

// The line under the workspace: where the caret is, from the project down to
// the symbol it stands in, and what the file is written in.
construct StatusBar(path: [String], details: [String]) extends Widget {
    body {
        HStack(spacing = .Medium) {
            Breadcrumb(path = path)
            Spacer()
            For(detail in details) {
                Text(detail)
            }
        }
        .typography(.subheadline)
        .foregroundColor(.Secondary)
        .inset(horizontal = .Medium, vertical = .Small)
    }
}
