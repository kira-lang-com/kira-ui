import KiraUI

// A path, each step after the first set off from the one before by a slash.
construct Breadcrumb(path: [String]) extends Widget {
    body {
        HStack(spacing = .Small) {
            For(index in indices(path.count)) {
                if index > 0 {
                    Text("/")
                    .foregroundColor(.Tertiary)
                }
                Text(path[index])
            }
        }
    }
}
