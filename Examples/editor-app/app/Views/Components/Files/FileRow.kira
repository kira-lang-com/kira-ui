import KiraUI

// One entry in the file tree: its glyph and name, held in by how deep it is.
construct FileRow(
    name: String,
    symbol: Symbol,
    indent: Number,
    isSelected: Bool = false
) extends Widget {
    body {
        HStack(spacing = .Small) {
            EmptyView()
            .width(scaledMetric(indent))
            Icon(symbol = symbol)
            .imageScale(.Small)
            .foregroundColor(.Accent)
            Text(name)
            .typography(.subheadline)
            .foregroundColor(isSelected ? .Primary : .Secondary)
            Spacer()
        }
        .padding(scaledMetric(4.0))
    }
}
