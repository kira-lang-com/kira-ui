import KiraUI

// The project's files, folders open down to the document being edited.
construct FileTree() extends Widget {
    body {
        VStack(spacing = .None) {
            FileRow(name = "kira", symbol = .Folder, indent = 0.0)
            FileRow(name = "community", symbol = .Folder, indent = 12.0)
            FileRow(name = "platform", symbol = .Folder, indent = 24.0)
            FileRow(name = "node-rpc-client", symbol = .Folder, indent = 36.0)
            FileRow(name = "src", symbol = .Folder, indent = 48.0)
            FileRow(name = "rpc-node.ts", symbol = .DocText, indent = 60.0, isSelected = true)
            FileRow(name = "rpc.ts", symbol = .DocText, indent = 60.0)
            FileRow(name = "test", symbol = .Folder, indent = 48.0)
            FileRow(name = "test.js", symbol = .DocText, indent = 60.0)
            FileRow(name = "package.json", symbol = .Doc, indent = 36.0)
            FileRow(name = "tsconfig.json", symbol = .Doc, indent = 36.0)
        }
        .padding(scaledMetric(6.0))
    }
}
