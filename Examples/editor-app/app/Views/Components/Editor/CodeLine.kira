import KiraUI

// One line of the document on its number's baseline: the number in the
// gutter, then the text, held in by its indent level. Set monospaced, every
// number takes the same width, and the gutter stands as far from the text as
// the editor's margin stands from the panel's edge.
construct CodeLine(number: String, text: String, indent: Number = 0.0) extends Widget {
    body {
        HStack(spacing: .None, alignment: .FirstTextBaseline) {
            Text(number)
            .typography(.callout)
            .foregroundColor(.Tertiary)
            EmptyView()
            .width(scaledMetric(10 + indent * 28))
            Text(text)
            .typography(.callout)
            .foregroundColor(.Primary)
            Spacer()
        }
    }
}
