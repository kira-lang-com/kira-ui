import KiraUI

// A document: its lines, numbered in the margin.
construct CodeEditor(document: Document) extends Widget {
    body {
        VStack(spacing = .Micro) {
            For(line in document.lines) {
                CodeLine(
                    number = String(line.number),
                    text = line.text,
                    indent = Number(line.indent)
                )
            }
        }
        .monospaced()
        .padding(scaledMetric(12.0))
    }
}
