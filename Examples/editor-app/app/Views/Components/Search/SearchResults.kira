import KiraUI

// What a search across the project found, a file to a row.
construct SearchResults() extends Widget {
    body {
        VStack(spacing = .None) {
            FileRow(name = "rpc-node.ts  —  3 matches", symbol = .DocText, indent = 0.0)
            FileRow(name = "rpc.ts  —  1 match", symbol = .DocText, indent = 0.0)
            FileRow(name = "test.js  —  2 matches", symbol = .DocText, indent = 0.0)
        }
        .padding(scaledMetric(6.0))
    }
}
