import KiraUI

// The files opened lately, most recent first.
construct HistoryList() extends Widget {
    body {
        VStack(spacing = .None) {
            FileRow(name = "rpc-node.ts", symbol = .Clock, indent = 0.0)
            FileRow(name = "package.json", symbol = .Clock, indent = 0.0)
            FileRow(name = "main.rs", symbol = .Clock, indent = 0.0)
        }
        .padding(scaledMetric(6.0))
    }
}
