import KiraUI

// A key on the keyboard, as a shortcut names it.
construct KeyCap(key: String) extends Widget {
    body {
        ZStack {
            RoundedRectangle(cornerRadius = 6.0)
                .backgroundStyle(.Control)
            Text(key)
                .foregroundColor(.Secondary)
        }
        .size(24.0)
    }
}
