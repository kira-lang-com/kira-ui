import KiraUI

// One way to reach the assistant: its keys, right-aligned in their column,
// then what they do and where.
construct AssistantShortcut(keys: [String], title: String, detail: String) extends Widget {
    body {
        HStack(spacing = .Medium) {
            HStack(spacing = .ExtraSmall) {
                Spacer()
                For(key in keys) {
                    KeyCap(key = key)
                }
            }
            .width(scaledMetric(52.0))
            Text(title)
            .foregroundColor(.Primary)
            Text(detail)
            .foregroundColor(.Secondary)
            Spacer()
        }
        .typography(.subheadline)
    }
}
