import KiraUI

// The assistant, waiting for a question: what it is, the shortcuts that reach
// it, and the field a question is asked in.
construct AssistantView() extends Widget {
    body {
        VStack(spacing = .Large) {
            Spacer()
            VStack(spacing = .Small) {
                Icon(symbol = .Sparkles)
                .imageScale(.Large)
                .foregroundColor(.Purple)
                Text("AI Assistant")
                .typography(.title3)
                .fontWeight(.SemiBold)
                .foregroundColor(.Primary)
                Text("Ask AI Assistant different questions or try other AI actions")
                .typography(.subheadline)
                .foregroundColor(.Secondary)
            }
            VStack(spacing = .Small) {
                AssistantShortcut(keys = ["⌘", "."], title = "Ask AI", detail = "Editor & Terminal")
                AssistantShortcut(keys = ["⌥", "↩"], title = "AI Actions", detail = "Editor")
                AssistantShortcut(keys = ["/"], title = "AI Commands", detail = "Chat")
            }
            Spacer()
            AssistantPromptField()
        }
        .fillHeight()
        .padding(scaledMetric(12.0))
    }
}
