import KiraUI

// Where a question is asked: attaching a file, the field, then sending, on one
// capsule of glass.
construct AssistantPromptField() extends Widget {
    body {
        HStack(spacing = .Small) {
            Icon(symbol = .Plus)
                .foregroundColor(.Secondary)
            TextField(key = 4100, initial = "", placeholder = "Ask AI Assistant", onSubmit = { in
                return
            })
            .backgroundStyle(.Clear)
            Icon(symbol = .Paperplane)
                .foregroundColor(.Secondary)
        }
        .inset(horizontal = .Medium)
        .glassEffect()
    }
}
