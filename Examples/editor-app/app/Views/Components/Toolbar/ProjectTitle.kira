import KiraUI

// The bar's title: the project, and the branch it has checked out.
construct ProjectTitle(project: String, branch: String) extends Widget {
    body {
        HStack(spacing = .Small) {
            Text(project)
            .fontWeight(.SemiBold)
            .foregroundColor(.Primary)
            Icon(symbol = .ArrowBranch)
            .imageScale(.Small)
            .foregroundColor(.Secondary)
            Text(branch)
            .foregroundColor(.Secondary)
        }
        .typography(.subheadline)
        .inset(horizontal = .Medium)
    }
}
