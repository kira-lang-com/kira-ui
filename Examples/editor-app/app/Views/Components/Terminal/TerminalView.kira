import KiraUI

// The project's shell: its prompt and what the last command printed.
construct TerminalView() extends Widget {
    body {
        VStack(spacing = .ExtraSmall) {
            HStack(spacing = .Small) {
                Text("$")
                    .typography(.callout)
                    .foregroundColor(.Success)
                Text("kira")
                    .typography(.callout)
                    .fontWeight(.Bold)
                    .foregroundColor(.Accent)
                Text("npm test")
                    .typography(.callout)
                    .foregroundColor(.Primary)
                Spacer()
            }
            Text("PASS  test/rpc.test.js (4 tests)")
                .typography(.callout)
                .foregroundColor(.Success)
            Text("Time: 0.82 s")
                .typography(.callout)
                .foregroundColor(.Secondary)
        }
        .padding(12.0)
    }
}
