import KiraUI

// The editor: its panels where they start, the line under them that says where
// the caret is, the bar over all of it -- the buttons that fold each edge
// away, the project's title, and running and finding things -- and the
// commands on the menu bar that do the same from the keyboard. Everything after
// the first frame is the person's: which panels are up, where each one stands
// and how wide every edge is open.
construct EditorWindow() extends Widget {
    @State var layout: WorkspaceLayout = WorkspaceLayout {}

    body {
        Workspace(layout = layout, center = .AcceptsPanels) {
            Panel(value = FilesPanel(), title = "Files", systemImage = .Folder, edge = .Leading) {
                FileTree()
            }

            Panel(value = SearchPanel(), title = "Search", systemImage = .Search, edge = .Leading) {
                SearchResults()
            }

            Panel(
                value = HistoryPanel(),
                title = "History",
                systemImage = .Clock,
                edge = .Leading,
                isPresented = false
            ) {
                HistoryList()
            }

            For(document in openDocuments()) {
                Panel(
                    value = DocumentPanel(name = document.name),
                    title = document.name,
                    systemImage = .DocText,
                    edge = .Center
                ) {
                    CodeEditor(document = document)
                }
            }

            Panel(
                value = TerminalPanel(),
                title = "Terminal",
                systemImage = .Command,
                edge = .Bottom
            ) {
                TerminalView()
            }

            Panel(
                value = AssistantPanel(),
                title = "AI Assistant",
                systemImage = .Sparkles,
                edge = .Trailing
            ) {
                AssistantView()
            }
        }
        .labelStyle(.TitleOnly)
        .safeAreaInset(edge = .Bottom) {
            StatusBar(
                path = ["community", "platform", "node-rpc-client", "src", "rpc-node.ts", "server"],
                details = ["18:49", "UTF-8", "TypeScript", "Node.js 23.3.0"]
            )
        }
        .toolbar {
            ToolbarItemGroup(placement = .Navigation) {
                PanelEdgeToggle(edge = .Leading)
                PanelEdgeToggle(edge = .Bottom)
                PanelEdgeToggle(edge = .Trailing)
            }

            ToolbarItemGroup(placement = .Navigation) {
                Button(action = { in return }) {
                    Icon(symbol = .CircleGrid3x3)
                }
                Button(action = { in return }) {
                    Icon(symbol = .PersonBadgePlus)
                }
            }

            ToolbarItem(placement = .Principal) {
                ProjectTitle(project = "kira", branch = "main")
            }

            ToolbarItemGroup(placement = .PrimaryAction) {
                Button(action = { in return }) {
                    Icon(symbol = .BoltFill)
                    .foregroundColor(.Accent)
                }
                Button(action = { in return }) {
                    Icon(symbol = .PlayFill)
                }
            }

            ToolbarItemGroup(placement = .PrimaryAction) {
                Button(action = { in return }) {
                    Icon(symbol = .Search)
                }
                Button(action = { in return }) {
                    Icon(symbol = .Bell)
                }
                Button(action = { in return }) {
                    Icon(symbol = .Gear)
                }
            }
        }
        .commands {
            CommandGroup(placement = .Before(.Toolbar)) {
                Button(
                    layout.isVisible(.Leading) ? "Hide Navigator" : "Show Navigator",
                    action = panelEdgeToggleAction(.Leading)
                )
                .keyboardShortcut("0")
                Button(
                    layout.isVisible(.Bottom) ? "Hide Terminal" : "Show Terminal",
                    action = panelEdgeToggleAction(.Bottom)
                )
                .keyboardShortcut("Y", modifiers = [.Shift, .Command])
                Button(
                    layout.isVisible(.Trailing) ? "Hide Assistant" : "Show Assistant",
                    action = panelEdgeToggleAction(.Trailing)
                )
                .keyboardShortcut("0", modifiers = [.Option, .Command])
            }

            CommandMenu(title = "Go") {
                Button(
                    "Files",
                    action = { in
                        layout.show(FilesPanel())
                        return
                    }
                )
                .keyboardShortcut("1")
                Button(
                    "Search",
                    action = { in
                        layout.show(SearchPanel())
                        return
                    }
                )
                .keyboardShortcut("F", modifiers = [.Shift, .Command])
                Button(
                    "History",
                    action = { in
                        layout.show(HistoryPanel())
                        return
                    }
                )
                .keyboardShortcut("2")

                Divider()

                Button(
                    "Terminal",
                    action = { in
                        layout.show(TerminalPanel())
                        return
                    }
                )
                .keyboardShortcut("T", modifiers = [.Control, .Command])
                Button(
                    "AI Assistant",
                    action = { in
                        layout.show(AssistantPanel())
                        return
                    }
                )
                .keyboardShortcut("I", modifiers = [.Control, .Command])
            }
        }
    }
}
