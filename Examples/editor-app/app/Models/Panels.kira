import KiraUI

// The editor's panels. Each is a TYPE, as a navigation route is: the workspace
// keeps a panel by what it is wherever the person has put it.

construct FilesPanel() extends PanelValue {
    function panelType() -> String { return "FilesPanel" }
}

construct SearchPanel() extends PanelValue {
    function panelType() -> String { return "SearchPanel" }
}

construct HistoryPanel() extends PanelValue {
    function panelType() -> String { return "HistoryPanel" }
}

// A document is a panel per file, kept by the file's name.
construct DocumentPanel(name: String) extends PanelValue {
    function panelType() -> String { return "DocumentPanel " + name }
}

construct TerminalPanel() extends PanelValue {
    function panelType() -> String { return "TerminalPanel" }
}

construct AssistantPanel() extends PanelValue {
    function panelType() -> String { return "AssistantPanel" }
}
