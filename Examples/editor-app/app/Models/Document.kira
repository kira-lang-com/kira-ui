import KiraUI

// A file the editor has open: its name and the lines in view, each with its
// number and how deep it is indented.
struct Document {
    let name: String
    let lines: [SourceLine]
}

struct SourceLine {
    let number: Number
    let text: String
    let indent: Number = 0
}

// The files open when the editor starts.
function openDocuments() -> [Document] {
    return [Document {
        name: "rpc-node.ts",
        lines: [SourceLine {
            number: 12,
            text: "import { JsonRpc, Transport } from \"./rpc\""
        }, SourceLine { number: 13, text: "" }, SourceLine {
            number: 14,
            text: "const debug = require(\"debug\")(\"rpc\")"
        }, SourceLine { number: 15, text: "" }, SourceLine {
            number: 16,
            text: "export function connect(port: number = 63342) {"
        }, SourceLine {
            number: 17,
            text: "const transport = new SocketTransport()",
            indent: 1
        }, SourceLine {
            number: 18,
            text: "const server = new JsonRpc(transport, domains)",
            indent: 1
        }, SourceLine { number: 19, text: "transport.connect(port)", indent: 1 }, SourceLine {
            number: 20,
            text: "return server",
            indent: 1
        }, SourceLine { number: 21, text: "}" }, SourceLine { number: 22, text: "" }, SourceLine {
            number: 23,
            text: "export function close(server: JsonRpc) {"
        }, SourceLine { number: 24, text: "server.close()", indent: 1 }, SourceLine {
            number: 25,
            text: "}"
        }]
    }, Document {
        name: "rpc.ts",
        lines: [SourceLine { number: 1, text: "export interface Transport {" }, SourceLine {
            number: 2,
            text: "send(message: string): void",
            indent: 1
        }, SourceLine {
            number: 3,
            text: "onMessage(handler: (message: string) => void): void",
            indent: 1
        }, SourceLine { number: 4, text: "}" }, SourceLine { number: 5, text: "" }, SourceLine {
            number: 6,
            text: "export class JsonRpc {"
        }, SourceLine {
            number: 7,
            text: "constructor(private transport: Transport) {}",
            indent: 1
        }, SourceLine { number: 8, text: "}" }]
    }, Document {
        name: "package.json",
        lines: [SourceLine { number: 1, text: "{" }, SourceLine {
            number: 2,
            text: "\"name\": \"node-rpc-client\",",
            indent: 1
        }, SourceLine { number: 3, text: "\"version\": \"1.4.0\",", indent: 1 }, SourceLine {
            number: 4,
            text: "\"main\": \"src/rpc-node.ts\"",
            indent: 1
        }, SourceLine { number: 5, text: "}" }]
    }]
}
