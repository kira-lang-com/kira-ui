import KiraUI
import Foundation

// An editor's window: a project's files down one side, an assistant down the
// other, a terminal across the foot and the document in the middle -- every
// panel the person's to close, bring back, or drag to another edge.

@Main
function main() {
    EditorApp()
    return
}

// The window, event pump, and frame loop own the process main thread, and a
// lifecycle is how a Kira program claims it.
@MainThreadLifecycle
function EditorApp() {
    RunKiraWindowApp("KiraUI Editor", 1440, 900, { in
        return EditorWindow()
    })
    return
}
