import KiraUI
import Foundation

@Main
function entry() {
    BasicKiraUiApp()
}

function BasicKiraUiApp() {
    RunKiraWindowApp(
        "Basic Kira UI App",
        1280,
        720,
        { in
            return BasicKiraUiHome()
        }
    )
}

construct BasicKiraUiHome() extends Widget {
    body {
        AppSurface {
            VStack(spacing = .Large) {
                Text("Kira UI")
                .font(size = scaledMetric(30.0), weight = .Bold)

                Text(
                    "Current widget declarations lower through UI Foundation and the graphics backend."
                )
                .font(size = scaledMetric(14.0))
                .opacity(0.68)

                HStack(spacing = .Medium) {
                    InfoCard(label = "Surface", value = "AppSurface", accent = colorPurple())
                    InfoCard(label = "Layout", value = "VStack / HStack", accent = colorCyan())
                    InfoCard(label = "Backend", value = "Foundation", accent = colorGreen())
                }

                VStack(spacing = .Small) {
                    Text("This example now uses the current widget surface.")
                    .font(size = scaledMetric(16.0), weight = .SemiBold)

                    Text(
                        "No raw Foundation bridge fields, no legacy .node access, and no manual low-level view wiring."
                    )
                    .font(size = scaledMetric(13.0))
                    .opacity(0.60)
                }
                .padding(scaledMetric(16.0))
                .glassEffect(.Regular, .RoundedRect(24.0))
            }
            .inset(horizontal = .ExtraLarge, vertical = .ExtraLarge)
        }
        .background(AppBackground())
    }
}

construct InfoCard(label: String, value: String, accent: RGBAColor) extends Widget {
    body {
        GroupBox {
            VStack(spacing = .ExtraSmall) {
                Text(value)
                .font(size = scaledMetric(22.0), weight = .Bold)
                .fill(accent)

                Text(label)
                .font(size = scaledMetric(12.0))
                .opacity(0.55)
            }
        }
        .minWidth(scaledMetric(220.0))
    }
}

construct AppBackground() extends Widget {
    body {
        LinearGradient(
            start: RGBAColor { r: 0.10, g: 0.06, b: 0.18, a: 1.0 },
            end: RGBAColor { r: 0.02, g: 0.02, b: 0.05, a: 1.0 }
        )
    }
}
