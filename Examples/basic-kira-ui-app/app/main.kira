import KiraUI

@Main
function entry() {
    RunKiraApp { in
        return KiraUIApp(
            name: "Basic Kira UI App",
            content: BasicKiraUiHome()
        )
    }
    return
}

Widget BasicKiraUiHome() {
    body {
        AppSurface {
            VStack(spacing = .Large) {
                Text("Kira UI")
                    .font(size = 30.0, weight = .Bold)

                Text("Current widget declarations lower through UI Foundation and the graphics backend.")
                    .font(size = 14.0)
                    .opacity(0.68)

                HStack(spacing = .Medium) {
                    InfoCard(
                        label = "Surface",
                        value = "AppSurface",
                        accent = colorPurple()
                    )
                    InfoCard(
                        label = "Layout",
                        value = "VStack / HStack",
                        accent = colorCyan()
                    )
                    InfoCard(
                        label = "Backend",
                        value = "Foundation",
                        accent = colorGreen()
                    )
                }

                Card(material = .LayeredGlass) {
                    VStack(spacing = .Small) {
                        Text("This example now uses the current widget surface.")
                            .font(size = 16.0, weight = .SemiBold)

                        Text("No raw Foundation bridge fields, no legacy .node access, and no manual low-level view wiring.")
                            .font(size = 13.0)
                            .opacity(0.60)
                    }
                }
            }
            .inset(horizontal = .ExtraLarge, vertical = .ExtraLarge)
        }
        .background(AppBackground())
    }
}

Widget InfoCard(label: String, value: String, accent: Color) {
    body {
        Card(material = .Frosted) {
            VStack(spacing = .ExtraSmall) {
                Text(value)
                    .font(size = 22.0, weight = .Bold)
                    .fill(accent)

                Text(label)
                    .font(size = 12.0)
                    .opacity(0.55)
            }
        }
        .minWidth(220.0)
    }
}

Widget AppBackground() {
    body {
        LinearGradient(
            start: Color {
                r: 0.10
                g: 0.06
                b: 0.18
                a: 1.0
            },
            end: Color {
                r: 0.02
                g: 0.02
                b: 0.05
                a: 1.0
            }
        )
    }
}
