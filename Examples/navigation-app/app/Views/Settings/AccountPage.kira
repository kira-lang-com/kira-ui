import KiraUI

// A page nested under Settings.
construct AccountPage() extends Widget {
    body {
        Form {
            Section {
                LabeledContent(label = "Name") {
                    Text("Kira")
                }

                LabeledContent(label = "Plan") {
                    Text("Team")
                }
            } header: {
                Text("Account")
            } footer: {
                Text("Every link appends a value; no page owns a router.")
            }
        }
        .navigationTitle("Account")
    }
}
