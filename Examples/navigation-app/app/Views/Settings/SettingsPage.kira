import KiraUI

// The third branch, with a page of its own below it.
construct SettingsPage() extends Widget {
    body {
        Form {
            Section {
                NavigationLink(value = AccountRoute()) {
                    Label(title = "Account", systemImage = .Person)
                }
            } header: {
                Text("General")
            }

            Section {
                Button(title = "Return to Workspace", action = workspaceRefreshAction())
            }
        }
        .navigationTitle("Settings")
    }
}
