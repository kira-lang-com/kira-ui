import KiraUI

// A project, one level below Projects.
construct ProjectOverviewPage() extends Widget {
    body {
        Form {
            Section {
                LabeledContent(label = "Language") {
                    Text("Kira")
                }

                LabeledContent(label = "Files") {
                    Text("128")
                }
            } header: {
                Text("Overview")
            }

            Section {
                NavigationLink(value = ProjectFilesRoute()) {
                    Text("Browse Files")
                }
            } footer: {
                Text("The page shown is the one registered for the last value in the path.")
            }
        }
        .navigationTitle("KiraUI")
    }
}
