import KiraUI

// A project's files: the third level, which continues into a file.
construct ProjectFilesPage() extends Widget {
    body {
        Form {
            Section {
                NavigationLink(value = ProjectFileDetailRoute()) {
                    Text("app/Navigation.kira")
                }

                NavigationLink(value = ProjectOverviewRoute()) {
                    Text("Back to Overview")
                }
            } header: {
                Text("Files")
            } footer: {
                Text("Pushing a value already in the path revisits its page on top.")
            }
        }
        .navigationTitle("Files")
    }
}
