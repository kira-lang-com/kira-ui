import KiraUI

// The first level of the project flow.
construct ProjectsPage() extends Widget {
    body {
        Form {
            Section {
                NavigationLink(value = ProjectOverviewRoute()) {
                    Text("KiraUI")
                }

                NavigationLink(value = ProjectFilesRoute()) {
                    Text("Design System")
                }
            } header: {
                Text("Projects")
            } footer: {
                Text("Open a project's overview, or jump straight to its files.")
            }
        }
        .navigationTitle("Projects")
    }
}
