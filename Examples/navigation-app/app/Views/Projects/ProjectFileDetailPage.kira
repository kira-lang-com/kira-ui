import KiraUI

// One file: the deepest page in the example.
construct ProjectFileDetailPage() extends Widget {
    body {
        Form {
            Section {
                LabeledContent(label = "Path") {
                    Text("app/Navigation.kira")
                }

                LabeledContent(label = "Lines") {
                    Text("712")
                }
            } header: {
                Text("File")
            } footer: {
                Text("On a phone this is a pushed page with Back. On a wider window it stays in the detail column.")
            }
        }
        .navigationTitle("Navigation.kira")
    }
}
