import KiraUI

// The window's sidebar: one section of the workspace's three branches.
//
// Nothing here says how a sidebar looks. The split view puts this in its
// sidebar column, which gives the list the sidebar style: the section title
// over its rows, each link a row that carries the selection band while the
// path runs through it, each label's glyph in the accent.
construct WorkspaceSidebar() extends Widget {
    body {
        List {
            Section {
                NavigationLink(value = ProjectsRoute()) {
                    Label(title = "Projects", systemImage = .Folder)
                }

                NavigationLink(value = ActivityRoute()) {
                    Label(title = "Activity", systemImage = .Clock)
                }

                NavigationLink(value = SettingsRoute()) {
                    Label(title = "Settings", systemImage = .Gear)
                }
            } header: {
                Text("Workspace")
            }
        }
        .navigationTitle("Workspace")
        // `.Automatic` is the trailing end of the section over the view that
        // declared it, and the sidebar declares this — so the item lands at the
        // sidebar's trailing edge without anything here naming a position. The
        // column says what it wants on the bar; the bar decides where.
        .toolbar {
            ToolbarItem(placement = .Automatic) {
                Button(action = workspaceAddAction()) {
                    Icon(symbol = .Plus)
                }
            }
        }
    }
}
