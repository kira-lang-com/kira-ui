import KiraUI

// The window's sidebar: the workspace's three branches, then the kitchen's
// component families.
//
// Nothing here says how a sidebar looks. The split view puts this in its
// sidebar column, which gives the list the sidebar style: the section title
// over its rows, each link a row that carries the selection band while the
// path runs through it, each label's glyph in the accent.
construct WorkspaceSidebar() extends Widget {
    body {
        List {
            Section {
                NavigationLink(value = ProjectsRoute()) {
                    Label(title = "Projects", systemImage = .Folder)
                }

                NavigationLink(value = ActivityRoute()) {
                    Label(title = "Activity", systemImage = .Clock)
                }

                NavigationLink(value = SettingsRoute()) {
                    Label(title = "Settings", systemImage = .Gear)
                }
            } header: {
                Text("Workspace")
            }

            // The kitchen: every component KiraUI has, a family to a row. Each
            // opens a page of its own pages, so the path runs three and four
            // layers deep from here.
            Section {
                NavigationLink(value = ControlsRoute()) {
                    Label(title = "Controls", systemImage = .SliderHorizontal3)
                }

                NavigationLink(value = TextRoute()) {
                    Label(title = "Text", systemImage = .Textformat)
                }

                NavigationLink(value = MenusRoute()) {
                    Label(title = "Menus", systemImage = .ListBullet)
                }

                NavigationLink(value = LayoutRoute()) {
                    Label(title = "Layout", systemImage = .SquareStack3dUp)
                }

                NavigationLink(value = SymbolsRoute()) {
                    Label(title = "Symbols", systemImage = .Star)
                }

                NavigationLink(value = LayersRoute()) {
                    Label(title = "Navigation", systemImage = .SidebarLeft)
                }
            } header: {
                Text("Kitchen")
            }
        }
        .navigationTitle("Workspace")
    }
}
