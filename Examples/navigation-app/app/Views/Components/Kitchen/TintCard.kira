import KiraUI

// A card in one color of the palette, its name set on it.
construct TintCard(name: String, tint: PrimaryColor) extends Widget {
    body {
        ZStack(alignment = .Leading) {
            RoundedRectangle(cornerRadius = 16.0)
            .foregroundColor(tint)
            .height(scaledMetric(72.0))

            Text(name)
            .foregroundColor(.White)
            .padding(scaledMetric(16.0))
        }
    }
}
