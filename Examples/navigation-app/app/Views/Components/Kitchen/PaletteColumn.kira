import KiraUI

// The palette's colors, one card each, down the column.
construct PaletteColumn() extends Widget {
    body {
        VStack(spacing = .Medium) {
            TintCard(name = "Red", tint = .Red)
            TintCard(name = "Orange", tint = .Orange)
            TintCard(name = "Yellow", tint = .Yellow)
            TintCard(name = "Green", tint = .Green)
            TintCard(name = "Mint", tint = .Mint)
            TintCard(name = "Teal", tint = .Teal)
            TintCard(name = "Cyan", tint = .Cyan)
            TintCard(name = "Blue", tint = .Blue)
            TintCard(name = "Indigo", tint = .Indigo)
            TintCard(name = "Purple", tint = .Purple)
            TintCard(name = "Pink", tint = .Pink)
            TintCard(name = "Brown", tint = .Brown)
        }
    }
}
