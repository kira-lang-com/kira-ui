import KiraUI

// The menu a document carries: three actions across the top, rows in groups,
// two of them owning submenus, and Delete last.
construct DocumentMenu() extends Widget {
    body {
        ContextMenu {
            ControlGroup {
                Button(action = documentMenuAction) { Label(title = "Copy", systemImage = .DocOnDoc) }
                Button(action = documentMenuAction) { Label(title = "Share", systemImage = .SquareArrowUp) }
                Button(action = documentMenuAction) { Label(title = "Pin", systemImage = .Bookmark) }
            }

            Divider()

            Button(action = documentMenuAction) { Label(title = "Rename", systemImage = .Pencil) }
            Button(action = documentMenuAction) { Label(title = "Duplicate", systemImage = .PlusSquareOnSquare) }

            Divider()

            Menu(title = "Move To", systemImage = .Folder) {
                Button(action = documentMenuAction) { Text("Projects") }
                Button(action = documentMenuAction) { Text("Archive") }
                Button(action = documentMenuAction) { Text("Shared") }
            }

            Menu(title = "Tags", systemImage = .Tag) {
                Button(action = documentMenuAction) { Text("Red") }
                Button(action = documentMenuAction) { Text("Green") }
                Button(action = documentMenuAction) { Text("Blue") }
            }

            Divider()

            Button(action = documentMenuAction) { Label(title = "Delete", systemImage = .Trash) }
        }
    }
}

function documentMenuAction() { return }
