import KiraUI

// A row of symbols at the large scale, in the secondary ink.
construct SymbolRow(symbols: [Symbol]) extends Widget {
    body {
        HStack(spacing = .ExtraLarge) {
            For(symbol in symbols) {
                Icon(symbol = symbol)
                    .imageScale(.Large)
            }
        }
        .foregroundColor(.Secondary)
        .padding(8.0)
    }
}
