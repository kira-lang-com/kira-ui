import KiraUI

// The detail column: one stack, every page a destination of it.
//
// Each mapping is a layer in the same value-driven stack, so a deep link is the
// route values appended in order — [ProjectsRoute(), ProjectOverviewRoute(),
// ProjectFilesRoute(), ProjectFileDetailRoute()].
construct WorkspaceDetail(path: NavigationPath) extends Widget {
    body {
        NavigationStack(path = path) {
            WorkspaceHome()
            .navigationDestination(forType = ProjectsRoute()) {
                ProjectsPage()
            }
            .navigationDestination(forType = ProjectOverviewRoute()) {
                ProjectOverviewPage()
            }
            .navigationDestination(forType = ProjectFilesRoute()) {
                ProjectFilesPage()
            }
            .navigationDestination(forType = ProjectFileDetailRoute()) {
                ProjectFileDetailPage()
            }
            .navigationDestination(forType = ActivityRoute()) {
                ActivityPage()
            }
            .navigationDestination(forType = ActivityDetailRoute()) {
                ActivityDetailPage()
            }
            .navigationDestination(forType = SettingsRoute()) {
                SettingsPage()
            }
            .navigationDestination(forType = AccountRoute()) {
                AccountPage()
            }
            // The kitchen.
            .navigationDestination(forType = ControlsRoute()) {
                ControlsPage()
            }
            .navigationDestination(forType = ButtonsRoute()) {
                ButtonsPage()
            }
            .navigationDestination(forType = TogglesRoute()) {
                TogglesPage()
            }
            .navigationDestination(forType = SlidersRoute()) {
                SlidersPage()
            }
            .navigationDestination(forType = PickersRoute()) {
                PickersPage()
            }
            .navigationDestination(forType = ProgressRoute()) {
                ProgressPage()
            }
            .navigationDestination(forType = FieldsRoute()) {
                FieldsPage()
            }
            .navigationDestination(forType = TextRoute()) {
                TextPage()
            }
            .navigationDestination(forType = TypographyRoute()) {
                TypographyPage()
            }
            .navigationDestination(forType = LabelsRoute()) {
                LabelsPage()
            }
            .navigationDestination(forType = InksRoute()) {
                InksPage()
            }
            .navigationDestination(forType = MenusRoute()) {
                MenusPage()
            }
            .navigationDestination(forType = ContextMenuRoute()) {
                ContextMenuPage()
            }
            .navigationDestination(forType = ToolbarMenusRoute()) {
                ToolbarMenusPage()
            }
            .navigationDestination(forType = LayoutRoute()) {
                LayoutPage()
            }
            .navigationDestination(forType = StacksRoute()) {
                StacksPage()
            }
            .navigationDestination(forType = ShapesRoute()) {
                ShapesPage()
            }
            .navigationDestination(forType = GlassRoute()) {
                GlassPage()
            }
            .navigationDestination(forType = GroupBoxRoute()) {
                GroupBoxPage()
            }
            .navigationDestination(forType = SymbolsRoute()) {
                SymbolsPage()
            }
            .navigationDestination(forType = SymbolScalesRoute()) {
                SymbolScalesPage()
            }
            .navigationDestination(forType = LayersRoute()) {
                LayersPage()
            }
            .navigationDestination(forType = LayerTwoRoute()) {
                LayerTwoPage()
            }
            .navigationDestination(forType = LayerThreeRoute()) {
                LayerThreePage()
            }
            .navigationDestination(forType = LayerFourRoute()) {
                LayerFourPage()
            }
            .navigationDestination(forType = TabsRoute()) {
                TabsPage()
            }
        }
        // Three items and one spacer, which is two pieces of glass.
        //
        // Items on a bar share a background by default — that is the whole
        // Liquid Glass toolbar look, and it is why nothing here asks for one.
        // `ToolbarSpacer` is the opt-out: it closes the run before it and opens
        // the next, so the two actions arrive as one capsule and the overflow
        // arrives as its own beside it.
        .toolbar {
            ToolbarItemGroup(placement = .PrimaryAction) {
                Button(action = workspaceRefreshAction()) {
                    Icon(symbol = .ArrowClockwise)
                }

                Button(action = workspaceRefreshAction()) {
                    Icon(symbol = .Bell)
                }
            }

            ToolbarSpacer(.Fixed, placement = .PrimaryAction)

            ToolbarItem(placement = .PrimaryAction) {
                Menu(title = "More", systemImage = .Ellipsis) {
                    Button(action = workspaceAddAction()) {
                        Label(title = "New Project", systemImage = .Plus)
                    }

                    Button(action = workspaceRefreshAction()) {
                        Label(title = "Refresh", systemImage = .ArrowClockwise)
                    }
                }
            }
        }
    }
}
