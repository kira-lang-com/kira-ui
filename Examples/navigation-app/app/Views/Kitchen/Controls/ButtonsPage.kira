import KiraUI

// Buttons: a text label, a label with a glyph, the destructive role, a
// disabled one, and a counter that proves the actions run.
construct ButtonsPage() extends Widget {
    @State var taps: Int = 0

    body {
        Form {
            Section {
                LabeledContent(label = "Text") {
                    Button(action = { in
                        taps = taps + 1
                        return
                    }) { Text("Continue") }
                }

                LabeledContent(label = "Label") {
                    Button(action = { in
                        taps = taps + 1
                        return
                    }) {
                        Label(title = "Share", systemImage = .ShareUp)
                    }
                }

                LabeledContent(label = "Destructive") {
                    Button(role = .Destructive, action = { in
                        taps = 0
                        return
                    }) { Text("Delete") }
                }

                LabeledContent(label = "Disabled") {
                    Button(action = { in
                        return
                    }) { Text("Unavailable") }
                    .disabled(true)
                }
            } header: {
                Text("Styles")
            }

            Section {
                LabeledContent(label = "Taps") {
                    Text(String(taps))
                        .foregroundColor(.Secondary)
                }
            } footer: {
                Text("Delete resets the count.")
            }
        }
        .navigationTitle("Buttons")
    }
}
