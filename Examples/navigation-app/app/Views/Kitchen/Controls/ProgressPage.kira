import KiraUI

// Progress: the bar at a few fixed values, a tinted one, and one a slider
// drives.
construct ProgressPage() extends Widget {
    @State var download: Float = 0.45

    body {
        Form {
            Section {
                Progress(value = 0.0)
                Progress(value = 0.25)
                Progress(value = 1.0)
            } header: {
                Text("Values")
            } footer: {
                Text("Empty, a quarter, complete.")
            }

            Section {
                Progress(value = 0.6)
                    .tint(.Green)
                Progress(value = 0.3)
                    .tint(.Pink)
            } header: {
                Text("Tinted")
            }

            Section {
                Progress(value = download)

                Slider(value = download, onChange = { value in
                    download = value
                    return
                })
            } header: {
                Text("Live")
            } footer: {
                Text("Drag the slider to drive the bar.")
            }
        }
        .navigationTitle("Progress")
    }
}
