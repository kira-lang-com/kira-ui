import KiraUI

// Progress: the bar at a few fixed values, a tinted one, and one a slider
// drives.
construct ProgressPage() extends Widget {
    @State var download: Number = 0.45

    body {
        Form {
            Section {
                ProgressView(value = 0.0)
                ProgressView(value = 0.25)
                ProgressView(value = 1.0)
            } header: {
                Text("Values")
            } footer: {
                Text("Empty, a quarter, complete.")
            }

            Section {
                ProgressView(value = 0.6)
                .tint(.Green)
                ProgressView(value = 0.3)
                .tint(.Pink)
            } header: {
                Text("Tinted")
            }

            Section {
                ProgressView(value = download)

                Slider(
                    value = download,
                    onChange = { value in
                        download = value
                        return
                    }
                )
            } header: {
                Text("Live")
            } footer: {
                Text("Drag the slider to drive the bar.")
            }
        }
        .navigationTitle("Progress")
    }
}
