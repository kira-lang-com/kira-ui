import KiraUI

// Switches: each row owns one piece of @State and flips it when pressed. The
// last row follows the first, so a switch can also gate another.
construct TogglesPage() extends Widget {
    @State var wifi: Bool = true
    @State var bluetooth: Bool = false
    @State var airDrop: Bool = true

    body {
        Form {
            Section {
                LabeledContent(label = "Wi-Fi", symbol = .Wifi) {
                    Toggle(isOn = wifi)
                        .onClick({ in
                            wifi = !wifi
                            return
                        })
                }

                LabeledContent(label = "Bluetooth", symbol = .Bolt) {
                    Toggle(isOn = bluetooth)
                        .onClick({ in
                            bluetooth = !bluetooth
                            return
                        })
                }

                LabeledContent(label = "AirDrop", symbol = .ShareUp, active = wifi) {
                    Toggle(isOn = airDrop)
                        .onClick({ in
                            airDrop = !airDrop
                            return
                        })
                }
                .disabled(!wifi)
            } header: {
                Text("Connections")
            } footer: {
                Text("AirDrop needs Wi-Fi: turning Wi-Fi off dims and disables it.")
            }
        }
        .navigationTitle("Toggles")
    }
}
