import KiraUI

// Fields: text a press focuses and the keyboard edits, a number with its unit
// beside the property it sets, and the window's search field.
construct FieldsPage() extends Widget {
    @State var submitted: Int = 0
    @State var query: String = ""

    body {
        Form {
            Section {
                TextField(key = 1, initial = "", placeholder = "Name", width = 0.0, height = 44.0, onSubmit = { in
                    submitted = submitted + 1
                    return
                })

                TextField(key = 2, initial = "kira@example.com", placeholder = "Email", width = 0.0, height = 44.0, onSubmit = { in
                    submitted = submitted + 1
                    return
                })
            } header: {
                Text("Profile")
            } footer: {
                Text("Press a field to type in it. Return submits, Escape ends editing.")
            }

            Section {
                LabeledContent(label = "Submitted") {
                    Text(String(submitted))
                }

                LabeledContent(label = "Opacity") {
                    ValueField(text = "80", unit = "%")
                }
            } header: {
                Text("Values")
            }

            Section {
                LabeledContent(label = "Query") {
                    Text(query)
                }

                Button(action = { in
                    query = ""
                    return
                }) { Text("Clear Search") }
            } header: {
                Text("Search")
            } footer: {
                Text("The search field in the toolbar writes the query; clearing it here empties the field.")
            }
        }
        .navigationTitle("Fields")
        .searchable(text = query, onChange = { text in
            query = move text
            return
        })
    }
}
