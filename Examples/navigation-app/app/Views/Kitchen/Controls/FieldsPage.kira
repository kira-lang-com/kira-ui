import KiraUI

// Fields: text a press focuses and the keyboard edits, a number with its unit
// beside the property it sets, and the window's search field.
construct FieldsPage() extends Widget {
    @State var submitted: Number = 0
    @State var name: String = ""
    @State var email: String = "kira@example.com"
    @State var query: String = ""

    body {
        Form {
            Section {
                TextField(title = "Name", text = $name)

                TextField(title = "Email", text = $email)
            } header: {
                Text("Profile")
            } footer: {
                Text("Press a field to type in it. Return submits, Escape ends editing.")
            }

            Section {
                LabeledContent(label = "Submitted") {
                    Text(String(submitted))
                }

                LabeledContent(label = "Opacity") {
                    ValueField(text = "80", unit = "%")
                }
            } header: {
                Text("Values")
            }

            Section {
                LabeledContent(label = "Query") {
                    Text(query)
                }

                Button(
                    action = { in
                        query = ""
                        return
                    }
                ) { Text("Clear Search") }
            } header: {
                Text("Search")
            } footer: {
                Text(
                    "The search field in the toolbar writes the query; clearing it here empties the field."
                )
            }
        }
        .onSubmit(action = { in
            submitted++
            return
        })
        .navigationTitle("Fields")
        .searchable(text: $query)
    }
}
