import KiraUI

// Sliders: two values over 0...1, each across its row between the symbols for
// its two ends the way Control Center sets them, written back by its own drag
// and read out below.
construct SlidersPage() extends Widget {
    @State var brightness: Float = 0.6
    @State var volume: Float = 0.3

    body {
        Form {
            Section {
                HStack(spacing = .Medium) {
                    Icon(symbol = .SunMin)
                    Slider(value = brightness, onChange = { value in
                        brightness = value
                        return
                    })
                    Icon(symbol = .SunMax)
                }
                .foregroundColor(.Secondary)

                HStack(spacing = .Medium) {
                    Icon(symbol = .Speaker)
                    Slider(value = volume, onChange = { value in
                        volume = value
                        return
                    })
                    Icon(symbol = .Speaker3)
                }
                .foregroundColor(.Secondary)
            } header: {
                Text("Levels")
            }

            Section {
                LabeledContent(label = "Brightness") {
                    Text(String(Int(brightness * 100.0 + 0.5)) + "%")
                }

                LabeledContent(label = "Volume") {
                    Text(String(Int(volume * 100.0 + 0.5)) + "%")
                }
            } header: {
                Text("Readout")
            }

            Section {
                Slider(value = 0.5)
                    .tint(.Orange)

                Slider(value = 0.8)
                    .disabled(true)
            } header: {
                Text("Tinted and Disabled")
            }
        }
        .navigationTitle("Sliders")
    }
}
