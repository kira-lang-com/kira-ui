import KiraUI

// Pickers: a menu of options whose choice is @State, and a second picker that
// is disabled to show the resting look.
construct PickersPage() extends Widget {
    @State var appearance: Int = 0
    @State var accent: Int = 2

    body {
        Form {
            Section {
                LabeledContent(label = "Appearance") {
                    Picker(options = ["Automatic", "Light", "Dark"], selection = appearance, onSelect = { index in
                        appearance = index
                        return
                    })
                }

                LabeledContent(label = "Accent") {
                    Picker(options = ["Red", "Orange", "Blue", "Purple"], selection = accent, onSelect = { index in
                        accent = index
                        return
                    })
                }

                LabeledContent(label = "Region") {
                    Picker(options = ["Europe"], selection = 0)
                }
                .disabled(true)
            } header: {
                Text("Display")
            }
        }
        .navigationTitle("Pickers")
    }
}
