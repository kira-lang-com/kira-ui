import KiraUI

// Pickers: a menu of options whose choice is @State, and a second picker that
// is disabled to show the resting look.
construct PickersPage() extends Widget {
    @State var appearance: Number = 0
    @State var accent: Number = 2
    @State var region: Number = 0

    body {
        Form {
            Section {
                Picker(title = "Appearance", selection = $appearance) {
                    Text("Automatic").tag(0)
                    Text("Light").tag(1)
                    Text("Dark").tag(2)
                }

                Picker(title = "Accent", selection = $accent) {
                    Text("Red").tag(0)
                    Text("Orange").tag(1)
                    Text("Blue").tag(2)
                    Text("Purple").tag(3)
                }

                Picker(title = "Region", selection = $region) {
                    Text("Europe").tag(0)
                }
                .disabled(true)
            } header: {
                Text("Display")
            }
        }
        .navigationTitle("Pickers")
    }
}
