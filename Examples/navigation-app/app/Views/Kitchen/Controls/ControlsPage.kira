import KiraUI

// The controls family: one row per control, each opening a page that shows it
// in every state it has.
construct ControlsPage() extends Widget {
    body {
        Form {
            Section {
                NavigationLink(value = ButtonsRoute()) {
                    Label(title = "Buttons", systemImage = .HandPointRight)
                }

                NavigationLink(value = TogglesRoute()) {
                    Label(title = "Toggles", systemImage = .Power)
                }

                NavigationLink(value = SlidersRoute()) {
                    Label(title = "Sliders", systemImage = .SliderHorizontal3)
                }

                NavigationLink(value = PickersRoute()) {
                    Label(title = "Pickers", systemImage = .ChevronUpChevronDown)
                }
            } header: {
                Text("Input")
            }

            Section {
                NavigationLink(value = ProgressRoute()) {
                    Label(title = "Progress", systemImage = .Hourglass)
                }

                NavigationLink(value = FieldsRoute()) {
                    Label(title = "Fields", systemImage = .TextCursor)
                }
            } header: {
                Text("Values")
            } footer: {
                Text("Every control here reads and writes @State on its page.")
            }
        }
        .navigationTitle("Controls")
    }
}
