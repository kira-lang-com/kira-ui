import KiraUI
import Foundation

// A context menu on its own, over bands of color so the glass has something
// to be glass about.
construct ContextMenuPage() extends Widget {
    body {
        ZStack(alignment = .Center) {
            LinearGradient(
                start = Color { r = 0.98, g = 0.62, b = 0.36, a = 1.0 },
                end = Color { r = 0.36, g = 0.42, b = 0.92, a = 1.0 },
                direction = .Diagonal
            )
            .fillWidth()
            .fillHeight()

            DocumentMenu()
        }
        .navigationTitle("Context Menu")
    }
}
