import KiraUI

// Menus on the bar: a sort menu with a submenu inside it, beside a single
// action.
construct ToolbarMenusPage() extends Widget {
    @State var sorted: String = "Name"

    body {
        Form {
            Section {
                HStack {
                    Text("Sorted By")
                    Spacer()
                    Text(sorted)
                        .foregroundColor(.Secondary)
                }
            } header: {
                Text("Order")
            } footer: {
                Text("Open the menu on the bar. Group By opens inside it.")
            }
        }
        .navigationTitle("Toolbar Menus")
        .toolbar {
            ToolbarItem(placement = .PrimaryAction) {
                Menu(title = "Sort", systemImage = .ArrowUpArrowDown) {
                    Button(action = { in
                        sorted = "Name"
                        return
                    }) {
                        Label(title = "Name", systemImage = .TextformatSize)
                    }

                    Button(action = { in
                        sorted = "Date"
                        return
                    }) {
                        Label(title = "Date", systemImage = .Calendar)
                    }

                    Divider()

                    Menu(title = "Group By", systemImage = .RectangleStack) {
                        Button(title = "Kind", action = { in
                            sorted = "Kind"
                            return
                        })
                        Button(title = "Size", action = { in
                            sorted = "Size"
                            return
                        })
                        Button(title = "Tag", action = { in
                            sorted = "Tag"
                            return
                        })
                    }
                }
            }
        }
    }
}
