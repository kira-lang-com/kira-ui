import KiraUI

// The menus family: a context menu standing on the page, and menus that open
// from the bar.
construct MenusPage() extends Widget {
    body {
        Form {
            Section {
                NavigationLink(value = ContextMenuRoute()) {
                    Label(title = "Context Menu", systemImage = .SquareOnSquare)
                }

                NavigationLink(value = ToolbarMenusRoute()) {
                    Label(title = "Toolbar Menus", systemImage = .Ellipsis)
                }
            } header: {
                Text("Menus")
            } footer: {
                Text("Menus nest: a row that owns a menu opens it as a card over the menu.")
            }
        }
        .navigationTitle("Menus")
    }
}
