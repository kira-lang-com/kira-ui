import KiraUI

// Symbol scales: one symbol at every image scale, then tinted.
construct SymbolScalesPage() extends Widget {
    body {
        Form {
            Section {
                HStack(spacing = .ExtraLarge) {
                    Icon(symbol = .StarFill).imageScale(.Small)
                    Icon(symbol = .StarFill).imageScale(.Medium)
                    Icon(symbol = .StarFill).imageScale(.Large)
                    Icon(symbol = .StarFill).imageScale(.ExtraLarge)
                }
                .foregroundColor(.Accent)
                .padding(12.0)
            } header: {
                Text("Image Scale")
            } footer: {
                Text("Small, medium, large and extra large.")
            }

            Section {
                HStack(spacing = .ExtraLarge) {
                    Icon(symbol = .HeartFill).foregroundColor(.Red)
                    Icon(symbol = .BoltFill).foregroundColor(.Yellow)
                    Icon(symbol = .DropFill).foregroundColor(.Blue)
                    Icon(symbol = .SunMax).foregroundColor(.Orange)
                }
                .imageScale(.Large)
                .padding(12.0)
            } header: {
                Text("Colored")
            }
        }
        .navigationTitle("Scales")
    }
}
