import KiraUI

// Symbols: a grid of the set, outline beside fill, and a page of scales.
construct SymbolsPage() extends Widget {
    body {
        Form {
            Section {
                SymbolRow(symbols = [.Heart, .Star, .Bell, .Folder, .Bookmark, .Flag, .Person, .Lock])
                SymbolRow(symbols = [.HeartFill, .StarFill, .BellFill, .FolderFill, .BookmarkFill, .FlagFill, .PersonFill, .LockFill])
            } header: {
                Text("Outline and Fill")
            }

            Section {
                SymbolRow(symbols = [.House, .Search, .Gear, .Envelope, .Paperplane, .Calendar, .Clock, .Map])
                SymbolRow(symbols = [.Camera, .Photo, .Mic, .Phone, .MusicNote, .Globe, .Wifi, .Link])
                SymbolRow(symbols = [.Cloud, .Bolt, .Flame, .Moon, .SunMax, .Gift, .Scissors, .Trash])
            } header: {
                Text("Everyday")
            }

            Section {
                NavigationLink(value = SymbolScalesRoute()) {
                    Label(title = "Scales", systemImage = .TextformatSize)
                }
            } footer: {
                Text("Symbols follow the ink of whatever holds them.")
            }
        }
        .navigationTitle("Symbols")
    }
}
