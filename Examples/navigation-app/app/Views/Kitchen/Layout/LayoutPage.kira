import KiraUI

// The layout family: stacks, shapes, glass and group boxes.
construct LayoutPage() extends Widget {
    body {
        Form {
            Section {
                NavigationLink(value = StacksRoute()) {
                    Label(title = "Stacks", systemImage = .SquareStack3dUp)
                }

                NavigationLink(value = ShapesRoute()) {
                    Label(title = "Shapes", systemImage = .Circle)
                }
            } header: {
                Text("Structure")
            }

            Section {
                NavigationLink(value = GlassRoute()) {
                    Label(title = "Liquid Glass", systemImage = .Capsule)
                }

                NavigationLink(value = GroupBoxRoute()) {
                    Label(title = "Group Box", systemImage = .RectangleStack)
                }
            } header: {
                Text("Surfaces")
            }
        }
        .navigationTitle("Layout")
    }
}
