import KiraUI

// Group boxes: a labeled box of text, one holding a value, and one holding a
// control with no label at all.
construct GroupBoxPage() extends Widget {
    @State var backsUp: Bool = true

    body {
        VStack(spacing = .Large) {
            GroupBox {
                Text("Three devices are signed in to this account.")
                    .foregroundColor(.Secondary)
            } label: {
                Label(title = "Devices", systemImage = .Desktopcomputer)
            }

            GroupBox {
                Progress(value = 0.62)
                Text("62 GB of 100 GB used")
                    .typography(.footnote)
                    .foregroundColor(.Secondary)
            } label: {
                Text("Storage")
            }

            GroupBox {
                HStack {
                    Text("Back Up Automatically")
                    Spacer()
                    Toggle(isOn = backsUp, onChange = { on in
                        backsUp = on
                        return
                    })
                }
            }
        }
        .scenePadding()
        .navigationTitle("Group Box")
    }
}
