import KiraUI
import Foundation

// Liquid Glass: regular and clear glass in each shape, over a gradient so the
// lensing shows. The round pieces are interactive: press and pull them.
construct GlassPage() extends Widget {
    body {
        ZStack(alignment = .Center) {
            LinearGradient(
                start = RGBAColor { r = 0.36, g = 0.78, b = 0.98, a = 1.0 },
                end = RGBAColor { r = 0.98, g = 0.40, b = 0.62, a = 1.0 },
                direction = .Diagonal
            )
            .fillWidth()
            .fillHeight()

            VStack(spacing = .ExtraLarge, alignment = .Center) {
                HStack(spacing = .Large) {
                    Icon(symbol = .HeartFill)
                    .padding(scaledMetric(16.0))
                    .glassEffect(glass = .Regular, shape = .Circle, interactive = true)
                    Icon(symbol = .StarFill)
                    .padding(scaledMetric(16.0))
                    .glassEffect(glass = .Regular, shape = .Circle, interactive = true)
                    Icon(symbol = .BoltFill)
                    .padding(scaledMetric(16.0))
                    .glassEffect(glass = .Regular, shape = .Circle, interactive = true)
                }
                .hugWidth()

                Text("Regular Glass")
                .padding(scaledMetric(16.0))
                .glassEffect()

                Text("Clear Glass")
                .padding(scaledMetric(16.0))
                .glassEffect(glass = .Clear)

                Text("Continuous Corners")
                .padding(scaledMetric(20.0))
                .glassEffect(glass = .Regular, shape = .Squircle(20.0))
            }
            .hugWidth()
        }
        .navigationTitle("Liquid Glass")
    }
}
