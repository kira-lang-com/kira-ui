import KiraUI
import Foundation

// Shapes: the four SwiftUI shapes in the accent, and a gradient.
construct ShapesPage() extends Widget {
    body {
        Form {
            Section {
                HStack(spacing = .Large) {
                    Rectangle().size(52.0)
                    RoundedRectangle(cornerRadius = 12.0).size(52.0)
                    Capsule().width(96.0).height(52.0)
                    Circle().size(52.0)
                }
                .foregroundColor(.Accent)
                .padding(12.0)
            } header: {
                Text("Shapes")
            } footer: {
                Text("Rectangle, RoundedRectangle, Capsule and Circle.")
            }

            Section {
                LinearGradient(
                    start = Color { r = 0.20, g = 0.78, b = 0.35, a = 1.0 },
                    end = Color { r = 0.00, g = 0.48, b = 1.00, a = 1.0 },
                    direction = .Across,
                    radius = .Medium
                )
                .height(64.0)
                .padding(12.0)

                LinearGradient(
                    start = Color { r = 1.00, g = 0.18, b = 0.33, a = 1.0 },
                    end = Color { r = 0.69, g = 0.32, b = 0.87, a = 1.0 },
                    direction = .Diagonal,
                    radius = .Medium
                )
                .height(64.0)
                .padding(12.0)
            } header: {
                Text("Gradients")
            }
        }
        .navigationTitle("Shapes")
    }
}
