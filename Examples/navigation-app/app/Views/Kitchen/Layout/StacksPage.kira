import KiraUI

// Stacks: a row, a column and an overlay, then a spacer pushing a row apart and
// a divider between two lines.
construct StacksPage() extends Widget {
    body {
        Form {
            Section {
                HStack(spacing = .Small) {
                    Capsule().foregroundColor(.Red).width(scaledMetric(64.0)).height(scaledMetric(28.0))
                    Capsule().foregroundColor(.Orange).width(scaledMetric(64.0)).height(scaledMetric(28.0))
                    Capsule().foregroundColor(.Yellow).width(scaledMetric(64.0)).height(scaledMetric(28.0))
                }
            } header: {
                Text("HStack")
            }

            Section {
                VStack(spacing = .Small) {
                    Capsule().foregroundColor(.Green).width(scaledMetric(160.0)).height(scaledMetric(12.0))
                    Capsule().foregroundColor(.Teal).width(scaledMetric(120.0)).height(scaledMetric(12.0))
                    Capsule().foregroundColor(.Blue).width(scaledMetric(80.0)).height(scaledMetric(12.0))
                }
                .padding(scaledMetric(12.0))
            } header: {
                Text("VStack")
            }

            Section {
                ZStack(alignment = .Center) {
                    Circle().foregroundColor(.Indigo).size(scaledMetric(72.0))
                    Circle().foregroundColor(.Purple).size(scaledMetric(48.0))
                    Circle().foregroundColor(.Pink).size(scaledMetric(24.0))
                }
                .padding(scaledMetric(12.0))
            } header: {
                Text("ZStack")
            }

            Section {
                HStack {
                    Text("Leading")
                    Spacer()
                    Text("Trailing")
                    .foregroundColor(.Secondary)
                }

                VStack(spacing = .Small) {
                    Text("Above")
                    Divider()
                    Text("Below")
                }
                .padding(scaledMetric(12.0))
            } header: {
                Text("Spacer and Divider")
            }
        }
        .navigationTitle("Stacks")
    }
}
