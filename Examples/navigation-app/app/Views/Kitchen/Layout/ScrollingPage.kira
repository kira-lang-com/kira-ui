import KiraUI

// Scrolling: the palette three times over, longer than any window. Two fingers
// drag it, a throw coasts and runs out past an end, a wheel steps it, and the
// bar along the trailing edge scrubs it when held.
construct ScrollingPage() extends Widget {
    body {
        ScrollView {
            VStack(spacing = .Medium) {
                PaletteColumn()
                PaletteColumn()
                PaletteColumn()
            }
            .padding(16.0)
        }
        .navigationTitle("Scrolling")
    }
}
