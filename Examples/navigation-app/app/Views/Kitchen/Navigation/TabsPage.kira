import KiraUI

// Tabs: a tab view of three, each its own page.
construct TabsPage() extends Widget {
    body {
        TabView(initialSelection = 0) {
            Tab(title = "Library", systemImage = .RectangleStack, value = 0) {
                Form {
                    Section {
                        Label(title = "Recents", systemImage = .Clock)
                        Label(title = "Favorites", systemImage = .HeartFill)
                    } header: {
                        Text("Library")
                    }
                }
            }

            Tab(title = "Search", systemImage = .Search, value = 1) {
                Form {
                    Section {
                        Text("Search the library.")
                            .foregroundColor(.Secondary)
                    } header: {
                        Text("Search")
                    }
                }
            }

            Tab(title = "Settings", systemImage = .Gear, value = 2) {
                Form {
                    Section {
                        Label(title = "Account", systemImage = .Person)
                        Label(title = "Notifications", systemImage = .Bell)
                    } header: {
                        Text("Settings")
                    }
                }
            }
        }
        .navigationTitle("Tabs")
    }
}
