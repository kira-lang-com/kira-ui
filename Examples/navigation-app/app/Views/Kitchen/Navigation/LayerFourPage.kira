import KiraUI

// The bottom of the stack: nothing further to push.
construct LayerFourPage() extends Widget {
    body {
        Form {
            Section {
                Label(title = "The Bottom", systemImage = .CheckmarkCircleFill)
                    .tint(.Green)
            } footer: {
                Text("Four layers in. Back walks up one at a time.")
            }
        }
        .navigationTitle("Layer Four")
    }
}
