import KiraUI

// The navigation family: a stack that pushes four layers deep, and tabs.
construct LayersPage() extends Widget {
    body {
        Form {
            Section {
                NavigationLink(value = LayerTwoRoute()) {
                    Label(title = "Push a Layer", systemImage = .ArrowRight)
                }
            } header: {
                Text("Stack")
            } footer: {
                Text("Each layer pushes the next. Back pops one; the sidebar pops them all.")
            }

            Section {
                NavigationLink(value = TabsRoute()) {
                    Label(title = "Tabs", systemImage = .RectangleStack)
                }
            } header: {
                Text("Tabs")
            }
        }
        .navigationTitle("Navigation")
    }
}
