import KiraUI

// The second layer of the stack.
construct LayerTwoPage() extends Widget {
    body {
        Form {
            Section {
                NavigationLink(value = LayerThreeRoute()) {
                    Label(title = "Layer Three", systemImage = .ArrowRight)
                }
            } footer: {
                Text("Two layers in.")
            }
        }
        .navigationTitle("Layer Two")
    }
}
