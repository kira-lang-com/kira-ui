import KiraUI

// The third layer of the stack.
construct LayerThreePage() extends Widget {
    body {
        Form {
            Section {
                NavigationLink(value = LayerFourRoute()) {
                    Label(title = "Layer Four", systemImage = .ArrowRight)
                }
            } footer: {
                Text("Three layers in.")
            }
        }
        .navigationTitle("Layer Three")
    }
}
