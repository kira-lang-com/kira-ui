import KiraUI

// The text family: the type scale, labels, and the inks text is set in.
construct TextPage() extends Widget {
    body {
        Form {
            Section {
                NavigationLink(value = TypographyRoute()) {
                    Label(title = "Typography", systemImage = .TextformatSize)
                }

                NavigationLink(value = LabelsRoute()) {
                    Label(title = "Labels", systemImage = .Tag)
                }

                NavigationLink(value = InksRoute()) {
                    Label(title = "Inks", systemImage = .Paintbrush)
                }
            } header: {
                Text("Text")
            } footer: {
                Text("Every face and color comes from the theme, never from the page.")
            }
        }
        .navigationTitle("Text")
    }
}
