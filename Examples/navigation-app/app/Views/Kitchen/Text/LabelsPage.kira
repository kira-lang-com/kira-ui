import KiraUI

// Labels: a title beside its symbol, the way a row, a button and a menu item
// all carry one.
construct LabelsPage() extends Widget {
    body {
        Form {
            Section {
                Label(title = "Inbox", systemImage = .Tray)
                Label(title = "Favorites", systemImage = .HeartFill)
                Label(title = "Flagged", systemImage = .FlagFill)
                Label(title = "Archive", systemImage = .Archivebox)
            } header: {
                Text("Labels")
            }

            Section {
                Label(title = "Starred", systemImage = .StarFill)
                    .tint(.Yellow)
                Label(title = "Urgent", systemImage = .ExclamationmarkTriangle)
                    .tint(.Orange)
                Label(title = "Secured", systemImage = .LockFill)
                    .tint(.Green)
            } header: {
                Text("Tinted")
            } footer: {
                Text("A tint recolors the symbol and leaves the title in the primary ink.")
            }

            Section {
                HStack(spacing = .Large) {
                    Icon(symbol = .Bold)
                    Icon(symbol = .Italic)
                    Icon(symbol = .Underline)
                    Icon(symbol = .TextAlignleft)
                    Icon(symbol = .TextQuote)
                }
                .foregroundColor(.Accent)
            } header: {
                Text("Symbols Alone")
            }
        }
        .navigationTitle("Labels")
    }
}
