import KiraUI

// Typography: Apple's eleven text styles in the kit's order, the styles the
// toolkit adds, and the four weights.
construct TypographyPage() extends Widget {
    body {
        Form {
            Section {
                Text("Large Title").typography(.largeTitle)
                Text("Title 1").typography(.title)
                Text("Title 2").typography(.title2)
                Text("Title 3").typography(.title3)
                Text("Headline").typography(.headline)
                Text("Body").typography(.body)
                Text("Callout").typography(.callout)
                Text("Subheadline").typography(.subheadline)
                Text("Footnote").typography(.footnote)
                Text("Caption 1").typography(.caption)
                Text("Caption 2").typography(.caption2)
            } header: {
                Text("Text Styles")
            } footer: {
                Text("The default Dynamic Type size, read off the iPadOS 27 kit.")
            }

            Section {
                Text("Display").typography(.title1)
                Text("Section").typography(.section)
                Text("Control").typography(.control)
                Text("Body Emphasis").typography(.bodyEmphasis)
                Text("Label").typography(.label)
                Text("Overline").typography(.overline)
            } header: {
                Text("Toolkit")
            }

            Section {
                Text("Regular").font(size = 17.0, weight = .Regular)
                Text("Medium").font(size = 17.0, weight = .Medium)
                Text("Semibold").font(size = 17.0, weight = .SemiBold)
                Text("Bold").font(size = 17.0, weight = .Bold)
            } header: {
                Text("Weights")
            }
        }
        .navigationTitle("Typography")
    }
}
