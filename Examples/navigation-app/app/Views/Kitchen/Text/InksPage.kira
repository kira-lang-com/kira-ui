import KiraUI

// Inks: the hierarchy text is set in, the intents a control speaks with, and
// the system palette.
construct InksPage() extends Widget {
    body {
        Form {
            Section {
                Text("Primary").foregroundColor(.Primary)
                Text("Secondary").foregroundColor(.Secondary)
                Text("Tertiary").foregroundColor(.Tertiary)
                Text("Quaternary").foregroundColor(.Quaternary)
            } header: {
                Text("Hierarchy")
            }

            Section {
                Text("Accent").foregroundColor(.Accent)
                Text("Success").foregroundColor(.Success)
                Text("Warning").foregroundColor(.Warning)
                Text("Danger").foregroundColor(.Danger)
            } header: {
                Text("Intents")
            }

            Section {
                InkSwatch(name = "Red", ink = .Red)
                InkSwatch(name = "Orange", ink = .Orange)
                InkSwatch(name = "Yellow", ink = .Yellow)
                InkSwatch(name = "Green", ink = .Green)
                InkSwatch(name = "Mint", ink = .Mint)
                InkSwatch(name = "Teal", ink = .Teal)
                InkSwatch(name = "Cyan", ink = .Cyan)
                InkSwatch(name = "Blue", ink = .Blue)
                InkSwatch(name = "Indigo", ink = .Indigo)
                InkSwatch(name = "Purple", ink = .Purple)
                InkSwatch(name = "Pink", ink = .Pink)
                InkSwatch(name = "Brown", ink = .Brown)
                InkSwatch(name = "Gray", ink = .Gray)
            } header: {
                Text("Palette")
            }
        }
        .navigationTitle("Inks")
    }
}
