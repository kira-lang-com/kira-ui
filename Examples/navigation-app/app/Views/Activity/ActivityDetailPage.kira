import KiraUI

// One event under Activity.
construct ActivityDetailPage() extends Widget {
    body {
        Form {
            Section {
                LabeledContent(label = "Status") {
                    Text("Open")
                }

                LabeledContent(label = "Comments") {
                    Text("4")
                }
            } header: {
                Text("Review")
            } footer: {
                Text("Selected by the same path as Projects and Settings.")
            }
        }
        .navigationTitle("Navigation API Review")
    }
}
