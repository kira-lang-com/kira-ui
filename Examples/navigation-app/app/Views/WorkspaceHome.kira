import KiraUI

// The root of the detail stack: where each branch starts, and what the
// workspace holds.
construct WorkspaceHome() extends Widget {
    body {
        Form {
            Section {
                NavigationLink(value = ProjectsRoute()) {
                    Label(title = "Projects", systemImage = .Folder)
                }

                NavigationLink(value = ActivityRoute()) {
                    Label(title = "Activity", systemImage = .Clock)
                }
            } header: {
                Text("Get Started")
            } footer: {
                Text("Each branch is a layered flow pushed onto the same path.")
            }

            Section {
                LabeledContent(label = "Projects") {
                    Text("2")
                }

                LabeledContent(label = "Open Reviews") {
                    Text("1")
                }
            } header: {
                Text("Workspace")
            }
        }
        .navigationTitle("Workspace")
    }
}
