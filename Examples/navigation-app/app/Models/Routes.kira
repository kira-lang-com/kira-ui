import KiraUI

// The app's routes, one per page, as a SwiftUI app's are: a link appends one,
// and the stack shows the page it draws.

// The workspace.
construct ProjectsRoute() extends NavigationRoute {
    function routeKey() -> String {
        return "projects"
    }

    function destination() -> Any Widget {
        return ProjectsPage()
    }
}

construct ActivityRoute() extends NavigationRoute {
    function routeKey() -> String {
        return "activity"
    }

    function destination() -> Any Widget {
        return ActivityPage()
