import KiraUI

// The app's navigation values. Each is a route TYPE, not a numeric ID: a link
// appends one, and the destination registered for its type is what shows.
construct ProjectsRoute() extends NavigationValue {
    function navigationType() -> String { return "ProjectsRoute" }
}

construct ActivityRoute() extends NavigationValue {
    function navigationType() -> String { return "ActivityRoute" }
}

construct SettingsRoute() extends NavigationValue {
    function navigationType() -> String { return "SettingsRoute" }
}

construct ProjectOverviewRoute() extends NavigationValue {
    function navigationType() -> String { return "ProjectOverviewRoute" }
}

construct ProjectFilesRoute() extends NavigationValue {
    function navigationType() -> String { return "ProjectFilesRoute" }
}

construct ProjectFileDetailRoute() extends NavigationValue {
    function navigationType() -> String { return "ProjectFileDetailRoute" }
}

construct ActivityDetailRoute() extends NavigationValue {
    function navigationType() -> String { return "ActivityDetailRoute" }
}

construct AccountRoute() extends NavigationValue {
    function navigationType() -> String { return "AccountRoute" }
}

// The kitchen's navigation values: one per page, a family's page first and
// then the pages it opens. Like the workspace routes above, each is a TYPE, so
// any page can push any other and the stack shows whatever is registered for it.

construct ControlsRoute() extends NavigationValue {
    function navigationType() -> String { return "ControlsRoute" }
}

