import KiraUI
import OpacityUI

// A real layered navigation app:
//
//   NavigationSplitView
//       NavigationStack
//           WorkspaceHome
//             -> ProjectsPage
//               -> ProjectOverviewPage
//                 -> ProjectFilesPage
//
// The split view owns the responsive sidebar/detail presentation. The nested
// stack owns the value-driven detail layers. On a narrow viewport the split
// view collapses to the same stack without changing the path.

// Typed navigation values. These are route types, not numeric IDs.
construct ProjectsRoute() extends NavigationValue {
    navigationType { return "ProjectsRoute" }
}

construct ActivityRoute() extends NavigationValue {
    navigationType { return "ActivityRoute" }
}

construct SettingsRoute() extends NavigationValue {
    navigationType { return "SettingsRoute" }
}

construct ProjectOverviewRoute() extends NavigationValue {
    navigationType { return "ProjectOverviewRoute" }
}

construct ProjectFilesRoute() extends NavigationValue {
    navigationType { return "ProjectFilesRoute" }
}

construct ProjectFileDetailRoute() extends NavigationValue {
    navigationType { return "ProjectFileDetailRoute" }
}

construct ActivityDetailRoute() extends NavigationValue {
    navigationType { return "ActivityDetailRoute" }
}

construct AccountRoute() extends NavigationValue {
    navigationType { return "AccountRoute" }
}

@Main
function main() {
    RunWidgetInteractiveApp(
        title = "KiraUI Layered Navigation",
        width = 1280,
        height = 820,
        rootBuilder = { in
            // Every token comes from ONE style. Without a theme the app falls
            // back to KiraUI's built-in default, and that default resolved the
            // canvas dark while resolving the toolbar's surface light — a bar
            // the same colour as nothing else on screen, carrying ink chosen for
            // the opposite appearance. A style is the thing that makes the two
            // agree, so the app names one.
            return KiraUIApp(
                name: "KiraUI Layered Navigation",
                // `AppSurface` paints the window in the theme's canvas. Without
                // it every region the tree does not cover shows the graphics
                // layer's clear colour — a hardcoded light page — so a dark app
                // wore a cream band wherever its widgets stopped.
                content: AppSurface() {
                    LayeredNavigationApp()
                }
                .theme(Opacity())
            )
        }
    )
    return
}

construct LayeredNavigationApp() extends Widget {
    // This is the single source of truth for both the split presentation and
    // the compact stack presentation. Links never receive a router object.
    @State var navigationPath: NavigationPath = NavigationPath {}

    body {
        NavigationSplitView(path = navigationPath) {
            WorkspaceSidebar()
        } detail: {
            WorkspaceDetail(path = navigationPath)
        }
    }
}

// Both bar actions return to the root, which is the one thing this demo can
// honestly do from anywhere.
function workspaceRefreshAction() -> () -> Void {
    return { in
        NavigationPath {}.removeAll()
        return
    }
}

// The plus opens the projects branch. A demo whose content is fixed has nothing
// to create, so the button does the nearest real thing rather than nothing —
// a control wired to an empty body teaches the reader that this is where a
// no-op goes.
function workspaceAddAction() -> () -> Void {
    return { in
        NavigationPath {}.append(ProjectsRoute())
        return
    }
}

construct WorkspaceSidebar() extends Widget {
    body {
        AppSurface {
            VStack(spacing = .Small) {
                Text("Kira Workspace")
                    .font(size = 22.0, weight = .Bold)

                Text("The same path drives desktop split view and phone stack navigation.")
                    .font(size = 13.0)
                    .opacity(0.62)

                NavigationRow(
                    title = "Projects",
                    detail = "Three layered destinations",
                    route = ProjectsRoute()
                )

                NavigationRow(
                    title = "Activity",
                    detail = "A second destination branch",
                    route = ActivityRoute()
                )

                NavigationRow(
                    title = "Settings",
                    detail = "A nested account screen",
                    route = SettingsRoute()
                )
            }
            .surfacePadding(20.0)
        }
        .navigationTitle("Workspace")
        // `.Automatic` is the trailing end of the section over the view that
        // declared it, and the sidebar declares this — so the item lands at the
        // sidebar's trailing edge without anything here naming a position. The
        // column says what it wants on the bar; the bar decides where.
        .toolbar {
            ToolbarItem(placement = .Automatic) {
                Button(action = workspaceAddAction()) {
                    Icon(symbol = .Plus)
                }
            }
        }
    }
}

construct NavigationRow(title: String, detail: String, route: Any NavigationValue) extends Widget {
    body {
        NavigationLink(value = move route) {
            Card(material = .Frosted) {
                VStack(spacing = .ExtraSmall) {
                    Text(title)
                        .font(size = 16.0, weight = .SemiBold)

                    Text(detail)
                        .font(size = 12.0)
                        .opacity(0.62)
                }
                .surfacePadding(12.0)
            }
        }
    }
}

construct WorkspaceDetail(path: NavigationPath) extends Widget {
    body {
        NavigationStack(path = path) {
            WorkspaceHome(path = path)
        }
        // Each mapping is a layer in the same value-driven stack. The route
        // values can be appended in sequence for a deep link such as
        // [ProjectsRoute(), ProjectOverviewRoute(), ProjectFilesRoute(),
        //  ProjectFileDetailRoute()].
        .navigationDestination(forType = ProjectsRoute()) {
            ProjectsPage(path = path)
        }
        .navigationDestination(forType = ActivityRoute()) {
            ActivityPage(path = path)
        }
        .navigationDestination(forType = SettingsRoute()) {
            SettingsPage(path = path)
        }
        .navigationDestination(forType = ProjectOverviewRoute()) {
            ProjectOverviewPage(path = path)
        }
        .navigationDestination(forType = ProjectFilesRoute()) {
            ProjectFilesPage(path = path)
        }
        .navigationDestination(forType = ProjectFileDetailRoute()) {
            ProjectFileDetailPage(path = path)
        }
        .navigationDestination(forType = ActivityDetailRoute()) {
            ActivityDetailPage(path = path)
        }
        .navigationDestination(forType = AccountRoute()) {
            AccountPage(path = path)
        }
        .navigationTitle("Overview")
        // Three items and one spacer, which is two pieces of glass.
        //
        // Items on a bar share a background by default — that is the whole
        // Liquid Glass toolbar look, and it is why nothing here asks for one.
        // `ToolbarSpacer` is the opt-out: it closes the run before it and opens
        // the next, so the two actions arrive as one capsule and the overflow
        // arrives as its own beside it.
        .toolbar {
            ToolbarItemGroup(placement = .PrimaryAction) {
                Button(action = workspaceRefreshAction()) {
                    Icon(symbol = .ArrowClockwise)
                }

                Button(action = workspaceRefreshAction()) {
                    Icon(symbol = .Bell)
                }
            }

            ToolbarSpacer(.Fixed, placement = .PrimaryAction)

            ToolbarItem(placement = .PrimaryAction) {
                Button(action = workspaceRefreshAction()) {
                    Icon(symbol = .EllipsisCircle)
                }
            }
        }
    }
}

construct WorkspaceHome(path: NavigationPath) extends Widget {
    body {
        AppSurface {
            VStack(spacing = .Medium) {
                Text("Workspace")
                    .font(size = 30.0, weight = .Bold)

                Text("Choose a branch from the sidebar or start a layered flow here.")
                    .font(size = 15.0)
                    .opacity(0.64)

                HStack(spacing = .Small) {
                    NavigationRow(
                        title = "Open Projects",
                        detail = "Projects → overview → files",
                        route = ProjectsRoute()
                    )

                    NavigationRow(
                        title = "Open Activity",
                        detail = "Activity → event detail",
                        route = ActivityRoute()
                    )
                }
                .fillHeight()
            }
            .surfacePadding(28.0)
        }
    }
}

construct ProjectsPage(path: NavigationPath) extends Widget {
    body {
        LayerPage(
            title = "Projects",
            subtitle = "The first level of the project flow."
        ) {
            VStack(spacing = .Small) {
                NavigationLink(value = ProjectOverviewRoute()) {
                    LayerRow(
                        title = "KiraUI",
                        detail = "Open the project overview"
                    )
                }

                NavigationLink(value = ProjectFilesRoute()) {
                    LayerRow(
                        title = "Design system",
                        detail = "Jump directly to project files"
                    )
                }
            }
        }
    }
}

construct ProjectOverviewPage(path: NavigationPath) extends Widget {
    body {
        LayerPage(
            title = "KiraUI Overview",
            subtitle = "A second level nested below Projects."
        ) {
            VStack(spacing = .Small) {
                Text("This destination is selected by the last value in NavigationPath.")
                    .font(size = 14.0)
                    .opacity(0.68)

                NavigationLink(value = ProjectFilesRoute()) {
                    LayerRow(
                        title = "Browse files",
                        detail = "Continue to the third level"
                    )
                }
            }
        }
    }
}

construct ProjectFilesPage(path: NavigationPath) extends Widget {
    body {
        LayerPage(
            title = "Project Files",
            subtitle = "A third level that can continue into a file."
        ) {
            VStack(spacing = .Small) {
                NavigationLink(value = ProjectFileDetailRoute()) {
                    LayerRow(
                        title = "app/Navigation.kira",
                        detail = "Open file detail"
                    )
                }

                NavigationLink(value = ProjectOverviewRoute()) {
                    LayerRow(
                        title = "Back to overview",
                        detail = "Push a value to revisit a layer"
                    )
                }
            }
        }
    }
}

construct ProjectFileDetailPage(path: NavigationPath) extends Widget {
    body {
        LayerPage(
            title = "Navigation.kira",
            subtitle = "The deepest screen in this example."
        ) {
            Text("On a phone this is a pushed screen with Back. On a PC or TV it remains in the detail column.")
                .font(size = 14.0)
                .opacity(0.68)
        }
    }
}

construct ActivityPage(path: NavigationPath) extends Widget {
    body {
        LayerPage(
            title = "Activity",
            subtitle = "A separate branch sharing the same path."
        ) {
            NavigationLink(value = ActivityDetailRoute()) {
                LayerRow(
                    title = "Navigation API review",
                    detail = "Open activity detail"
                )
            }
        }
    }
}

construct ActivityDetailPage(path: NavigationPath) extends Widget {
    body {
        LayerPage(
            title = "Navigation API review",
            subtitle = "A detail leaf under Activity."
        ) {
            Text("The branch is selected by the same NavigationPath as Projects and Settings.")
                .font(size = 14.0)
                .opacity(0.68)
        }
    }
}

construct SettingsPage(path: NavigationPath) extends Widget {
    body {
        LayerPage(
            title = "Settings",
            subtitle = "A third root branch with its own child."
        ) {
            NavigationLink(value = AccountRoute()) {
                LayerRow(
                    title = "Account",
                    detail = "Open account settings"
                )
            }
        }
    }
}

construct AccountPage(path: NavigationPath) extends Widget {
    body {
        LayerPage(
            title = "Account",
            subtitle = "A nested Settings destination."
        ) {
            Text("All links remain value-based. No destination page owns a router.")
                .font(size = 14.0)
                .opacity(0.68)
        }
    }
}

construct LayerPage(title: String, subtitle: String) extends Widget {
    @Content let content: Any Widget

    body {
        AppSurface {
            VStack(spacing = .Medium) {
                Text(title)
                    .font(size = 28.0, weight = .Bold)

                Text(subtitle)
                    .font(size = 14.0)
                    .opacity(0.64)

                content
            }
            .surfacePadding(28.0)
        }
    }
}

construct LayerRow(title: String, detail: String) extends Widget {
    body {
        Card(material = .Frosted) {
            VStack(spacing = .ExtraSmall) {
                Text(title)
                    .font(size = 16.0, weight = .SemiBold)

                Text(detail)
                    .font(size = 13.0)
                    .opacity(0.62)
            }
            .surfacePadding(14.0)
        }
    }
}
