import KiraUI
import Foundation

// A real layered navigation app:
//
//   NavigationSplitView
//       NavigationStack
//           WorkspaceHome
//             -> ProjectsPage
//               -> ProjectOverviewPage
//                 -> ProjectFilesPage
//
// The split view owns the responsive sidebar/detail presentation. The nested
// stack owns the value-driven detail layers. On a narrow viewport the split
// view collapses to the same stack without changing the path.

@Main
function main() {
    NavigationApp()
    return
}

// The window, event pump, and frame loop own the process main thread, and a
// lifecycle is how a Kira program claims it. `@Main` above only schedules this
// and returns; the process stays alive until the window closes.
@MainThreadLifecycle
function NavigationApp() {
    // Every token comes from ONE style. Without a theme the app falls back to
    // KiraUI's built-in default. The window paints its own canvas, so the root
    // view is the app itself.
    RunKiraWindowApp("KiraUI Layered Navigation", 1280, 820, { in
        return LayeredNavigationApp()
    })
    return
}

construct LayeredNavigationApp() extends Widget {
    // This is the single source of truth for both the split presentation and
    // the compact stack presentation. Links never receive a router object.
    @State var navigationPath: NavigationPath = NavigationPath {}

    body {
        NavigationSplitView(path = navigationPath) {
            WorkspaceSidebar()
        } detail: {
            WorkspaceDetail(path = navigationPath)
        }
    }
}

// Both bar actions return to the root, which is the one thing this demo can
// honestly do from anywhere.
function workspaceRefreshAction() -> () -> Void {
    return { in
        NavigationPath {}.removeAll()
        return
    }
}

// The plus opens the projects branch. A demo whose content is fixed has nothing
// to create, so the button does the nearest real thing rather than nothing —
// a control wired to an empty body teaches the reader that this is where a
// no-op goes.
function workspaceAddAction() -> () -> Void {
    return { in
        NavigationPath {}.append(ProjectsRoute())
        return
    }
}
