import KiraUI
import KiraUIFoundation

function checkModifier(label: String, condition: Bool) {
    if condition {
        print("PASS: " + label)
    } else {
        print("FAIL: " + label)
    }
    return
}

function checkContextPropagation() {
    let themeDelta = modifierDeltaTheme(DefaultTheme {})
    let themed = modifierContextApply(ModifierContext {}, move themeDelta)
    let themedChildren = modifierContextForChildren(themed)
    checkModifier("theme is inherited", themedChildren.hasTheme)

    let blueDelta = modifierDeltaForegroundColor(.Blue)
    let blue = modifierContextApply(ModifierContext {}, move blueDelta)
    let greenDelta = modifierDeltaForegroundColor(.Green)
    let green = modifierContextApply(blue, move greenDelta)
    checkModifier("nearest foreground color wins", green.foregroundColor == .Green)
    checkModifier(
        "foreground color cascades to children",
        modifierContextForChildren(green).foregroundColor == .Green
    )

    let materialDelta = modifierDeltaMaterial(.Frosted)
    let frosted = modifierContextApply(ModifierContext {}, move materialDelta)
    checkModifier("material is scoped", frosted.hasMaterial && modifierContextForChildren(frosted).hasMaterial == false)

    let parentFontDelta = modifierDeltaFont(17.0, .Regular)
    let parentFont = modifierContextApply(ModifierContext {}, move parentFontDelta)
    let childFontContext = modifierContextForChildren(parentFont)
    let childFontDelta = modifierDeltaFont(31.0, .Bold)
    let childFont = modifierContextApply(childFontContext, move childFontDelta)
    checkModifier("font cascades", childFontContext.fontSize == 17.0)
    checkModifier("nearer font wins", childFont.fontSize == 31.0)

    let disabledDelta = modifierDeltaDisabled(true)
    let disabled = modifierContextApply(ModifierContext {}, move disabledDelta)
    let enabledDelta = modifierDeltaDisabled(false)
    let stillDisabled = modifierContextApply(disabled, move enabledDelta)
    checkModifier("disabled composes environmentally", stillDisabled.disabled)

    let focusedDelta = modifierDeltaFocused(true)
    let focused = modifierContextApply(ModifierContext {}, move focusedDelta)
    let focusedChild = modifierContextForChildren(focused)
    checkModifier("focus is isolated", focused.hasFocused && focusedChild.hasFocused == false)
    return
}

function checkLoweringPropagation() {
    let foundationContext = KiraUIFoundation.FoundationUiContext {}
    let styled = VStack(spacing = .None) {
        Text("Parent font")
        Text("Child font").font(size = 31.0, weight = .Bold)
    }
        .font(size = 17.0)
        .foregroundColor(.Blue)
    let styledView = styled.lower(foundationContext, ModifierContext {})
    checkModifier("foreground color reaches text", styledView.children[0].color.b == 1.0)
    checkModifier("parent font reaches first child", styledView.children[0].size == 17.0)
    checkModifier("explicit child font wins", styledView.children[1].size == 31.0)

    // The cascade is the SwiftUI rule: a foreground names the subtree's ink
    // until something nearer restates it.
    let cascaded = VStack(spacing = .None) {
        Text("One")
        Text("Two").foregroundColor(.Green)
    }
        .foregroundColor(.Red)
    let cascadedView = cascaded.lower(foundationContext, ModifierContext {})
    checkModifier("foreground cascades to first child", cascadedView.children[0].color.r == 1.0)
    checkModifier("nearer foreground wins for second child", cascadedView.children[1].color.g == 0.82)

    let nested = VStack(spacing = .None) {
        Card(material = .Flat) {
            Text("Green")
        }
            .foregroundColor(.Green)
        Text("Blue")
    }
        .foregroundColor(.Blue)
    let nestedView = nested.lower(foundationContext, ModifierContext {})
    // Card lowers to Surface -> Column -> content, so the text is two levels in.
    checkModifier("nested foreground overrides parent", nestedView.children[0].children[0].children[0].color.g == 0.82)
    checkModifier("parent foreground remains for sibling", nestedView.children[1].color.b == 1.0)

    // The SwiftUI rule: the modifier call nearest the widget is the innermost
    // layer, so it wins over a later call in the same chain.
    let ordered = Text("Order")
        .foregroundColor(.Blue)
        .foregroundColor(.Green)
    let orderedView = ordered.lower(foundationContext, ModifierContext {})
    checkModifier("modifier call nearest the widget wins", orderedView.color.g == 0.518)

    let mixed = Text("Mixed")
        .inset(horizontal = .ExtraSmall, vertical = .ExtraSmall)
        .foregroundColor(.Cyan)
        .font(size = 19.0)
    let mixedView = mixed.lower(foundationContext, ModifierContext {})
    checkModifier("semantic values cross structural wrappers", mixedView.children[0].color.b == 1.0)
    checkModifier("mixed chain preserves cascading font", mixedView.children[0].size == 19.0)

    let washed = Text("Washed")
        .backgroundColor(.Blue)
        .lower(foundationContext, ModifierContext {})
    checkModifier("background color paints behind the widget", washed.fill.b == 1.0)

    let opacityView = Text("Alpha")
        .opacity(0.5)
        .opacity(0.5)
        .lower(foundationContext, ModifierContext {})
    checkModifier("opacity composes without a tree walk", opacityView.color.a == 0.25)
    return
}

// Button's label is intentionally an implementation detail of the control;
// this fixture keeps the API expression in the compiler-checked test surface.
function buttonNoop() {
    return
}

function buttonForegroundFixture() -> Any Widget {
    return Button(title = "Continue", role = .Normal, action = buttonNoop)
        .foregroundColor(.Purple)
        .focused(true)
        .disabled(true)
}

function checkButtonPresentation() {
    let foundationContext = KiraUIFoundation.FoundationUiContext {}
    let buttonView = buttonForegroundFixture().lower(foundationContext, ModifierContext {})
    checkModifier("button label takes the cascading foreground", buttonView.children[0].color.r == 0.749)
    checkModifier("button receives disabled environment", buttonView.disabled)
    checkModifier("button receives isolated focus", buttonView.autofocus)
    return
}

@Main
function main() {
    checkContextPropagation()
    checkLoweringPropagation()
    checkButtonPresentation()
    return
}
