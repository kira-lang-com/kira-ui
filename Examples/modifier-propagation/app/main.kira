import KiraUI
import KCoreAnimation

function checkModifier(label: String, condition: Bool) {
    if condition {
        print("PASS: " + label)
    } else {
        print("FAIL: " + label)
    }
}

function checkContextPropagation() {
    let themeDelta = modifierDeltaTheme(DefaultTheme {})
    let themed = modifierContextApply(ModifierContext {}, move themeDelta)
    let themedChildren = modifierContextForChildren(themed)
    checkModifier("theme is inherited", themedChildren.hasTheme)

    let blueDelta = modifierDeltaForegroundColor(.Blue)
    let blue = modifierContextApply(ModifierContext {}, move blueDelta)
    let greenDelta = modifierDeltaForegroundColor(.Green)
    let green = modifierContextApply(blue, move greenDelta)
    checkModifier("nearest foreground color wins", green.foregroundColor == .Green)
    checkModifier(
        "foreground color cascades to children",
        modifierContextForChildren(green).foregroundColor == .Green
    )

    let materialDelta = modifierDeltaMaterial(.Frosted)
    let frosted = modifierContextApply(ModifierContext {}, move materialDelta)
    checkModifier(
        "material is scoped",
        frosted.hasMaterial && !modifierContextForChildren(frosted).hasMaterial
    )

    let parentFontDelta = modifierDeltaFont(17.0, .Regular)
    let parentFont = modifierContextApply(ModifierContext {}, move parentFontDelta)
    let childFontContext = modifierContextForChildren(parentFont)
    let childFontDelta = modifierDeltaFont(31.0, .Bold)
    let childFont = modifierContextApply(childFontContext, move childFontDelta)
    checkModifier("font cascades", childFontContext.fontSize == 17.0)
    checkModifier("nearer font wins", childFont.fontSize == 31.0)

    let disabledDelta = modifierDeltaDisabled(true)
    let disabled = modifierContextApply(ModifierContext {}, move disabledDelta)
    let enabledDelta = modifierDeltaDisabled(false)
    let stillDisabled = modifierContextApply(disabled, move enabledDelta)
    checkModifier("disabled composes environmentally", stillDisabled.disabled)

    let focusedDelta = modifierDeltaFocus(FocusBinding {})
    let focused = modifierContextApply(ModifierContext {}, move focusedDelta)
    let focusedChild = modifierContextForChildren(focused)
    checkModifier("focus is isolated", focused.focus.count == 1 && focusedChild.focus.count == 0)
}

extend CALayerDescription {
    // The text run a described leaf carries, or an empty run for a non-text layer.
    function textRun() -> CAText {
        var out = CAText {}
        match content {
            Text(run) -> { out = run }
            Empty -> {}
            Solid(s) -> {}
            Texture(x) -> {}
            Icon(i) -> {}
            Glass(g) -> {}
            Gradient(g) -> {}
        }
        return out
    }

    // The solid fill a described layer paints, or a clear color for others.
    function solidFill() -> CAColor {
        var out = CAColor { a: 0.0 }
        match content {
            Solid(s) -> { out = s.fill }
            Empty -> {}
            Text(t) -> {}
            Texture(x) -> {}
            Icon(i) -> {}
            Glass(g) -> {}
            Gradient(g) -> {}
        }
        return out
    }
}

function checkLoweringPropagation() {
    let ctx = buildContext(FoundationUiContext {})
    let styled = VStack(spacing = .None) {
        Text("Parent font")
        Text("Child font").font(size = scaledMetric(31.0), weight = .Bold)
    }
    .font(size = scaledMetric(17.0))
    .foregroundColor(.Blue)
    let styledView = styled.describe(ctx, ModifierContext {})
    checkModifier("foreground color reaches text", styledView.sublayers[0].textRun().color.b == 1.0)
    checkModifier("parent font reaches first child", styledView.sublayers[0].textRun().size == 17.0)
    checkModifier("explicit child font wins", styledView.sublayers[1].textRun().size == 31.0)

    // The cascade is the SwiftUI rule: a foreground names the subtree's ink
    // until something nearer restates it.
    let cascaded = VStack(spacing = .None) {
        Text("One")
        Text("Two").foregroundColor(.Green)
    }
    .foregroundColor(.Red)
    let cascadedView = cascaded.describe(ctx, ModifierContext {})
    checkModifier(
        "foreground cascades to first child",
        cascadedView.sublayers[0].textRun().color.r == 1.0
    )
    checkModifier(
        "nearer foreground wins for second child",
        cascadedView.sublayers[1].textRun().color.g == 0.82
    )

    let nested = VStack(spacing = .None) {
        GroupBox {
            Text("Green")
        }
        .foregroundColor(.Green)
        Text("Blue")
    }
    .foregroundColor(.Blue)
    let nestedView = nested.describe(ctx, ModifierContext {})
    // A group box describes as a solid layer holding its rows, so the text is one
    // level in rather than two.
    checkModifier(
        "nested foreground overrides parent",
        nestedView.sublayers[0].sublayers[0].textRun().color.g == 0.82
    )
    checkModifier(
        "parent foreground remains for sibling",
        nestedView.sublayers[1].textRun().color.b == 1.0
    )

    // The SwiftUI rule: the modifier call nearest the widget is the innermost
    // layer, so it wins over a later call in the same chain.
    let ordered = Text("Order")
    .foregroundColor(.Blue)
    .foregroundColor(.Green)
    let orderedView = ordered.describe(ctx, ModifierContext {})
    checkModifier("modifier call nearest the widget wins", orderedView.textRun().color.g == 0.518)

    let mixed = Text("Mixed")
    .inset(horizontal = .ExtraSmall, vertical = .ExtraSmall)
    .foregroundColor(.Cyan)
    .font(size = scaledMetric(19.0))
    let mixedView = mixed.describe(ctx, ModifierContext {})
    checkModifier(
        "semantic values cross structural wrappers",
        mixedView.sublayers[0].textRun().color.b == 1.0
    )
    checkModifier(
        "mixed chain preserves cascading font",
        mixedView.sublayers[0].textRun().size == 19.0
    )

    let washed = Text("Washed")
    .backgroundColor(.Blue)
    .describe(ctx, ModifierContext {})
    checkModifier("background color paints behind the widget", washed.solidFill().b == 1.0)

    let opacityView = Text("Alpha")
    .opacity(0.5)
    .opacity(0.5)
    .describe(ctx, ModifierContext {})
    checkModifier("opacity composes without a tree walk", opacityView.opacity == 0.25)
}

// Button's label is intentionally an implementation detail of the control;
// this fixture keeps the API expression in the compiler-checked test surface.
function buttonNoop() {}

function buttonForegroundFixture() -> Any Widget {
    return Button(title = "Continue", role = .Normal, action = buttonNoop)
    .foregroundColor(.Purple)
    .disabled(true)
}

function checkButtonPresentation() {
    let foundationContext = buildContext(FoundationUiContext {})
    let ctx = buildContext(FoundationUiContext {})
    let buttonView = buttonForegroundFixture().describe(ctx, ModifierContext {})
    checkModifier(
        "button label takes the cascading foreground",
        buttonView.sublayers[0].textRun().color.r == 0.749
    )
    // A disabled control is not hittable; the retained layer carries that rather
    // than a `disabled` view flag.
    checkModifier("button receives disabled environment", !buttonView.hittable)
}

@Main
function main() {
    checkContextPropagation()
    checkLoweringPropagation()
    checkButtonPresentation()
}
