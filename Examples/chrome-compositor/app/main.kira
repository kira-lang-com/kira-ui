import KiraUI
import KiraGraphics

construct DetailRoute() extends NavigationValue {
    function navigationType() -> String {
        return "DetailRoute"
    }
}

function chromeExampleAction() {
    return
}

@Main
function main() {
    RunKiraWindowApp("KiraUI Chrome Compositor", 980, 720, { in
        return AppSurface() {
            ChromeExample()
        }
    })
    return
}

construct ChromeExample() extends Widget {
    @State var path: NavigationPath = NavigationPath {}

    body {
        TabView(initialSelection = 0) {
            Tab(title = "Home", systemImage = .House, value = 0) {
                NavigationStack(path = path) {
                    VStack(spacing = .Medium, alignment = .Center) {
                        Text("Chrome compositor")
                            .typography(.title)

                        Text("Toolbar, navigation and tabs are composed by one window chrome owner.")
                            .foregroundColor(.Secondary)

                        NavigationLink(value = DetailRoute()) {
                            Button(title = "Open detail", action = chromeExampleAction)
                        }
                    }
                    .fillWidth()
                    .fillHeight()
                    .navigationTitle("Home")
                    .toolbar {
                        ToolbarItem(placement = .PrimaryAction) {
                            Button(action = chromeExampleAction) {
                                Icon(symbol = .Plus)
                            }
                        }
                    }
                    .navigationDestination(
                        forType = DetailRoute(),
                        destination = DetailPage()
                    )
                }
            }

            Tab(title = "Search", systemImage = .Search, value = 1) {
                VStack(spacing = .Medium, alignment = .Center) {
                    Icon(symbol = .Search)
                        .imageScale(.Large)
                    Text("Search")
                        .typography(.title)
                }
                .fillWidth()
                .fillHeight()
                .navigationTitle("Search")
            }

            Tab(title = "Settings", systemImage = .Gear, value = 2) {
                VStack(spacing = .Medium, alignment = .Center) {
                    Icon(symbol = .Gear)
                        .imageScale(.Large)
                    Text("Settings")
                        .typography(.title)
                }
                .fillWidth()
                .fillHeight()
                .navigationTitle("Settings")
            }
        }
    }
}

construct DetailPage() extends Widget {
    body {
        VStack(spacing = .Medium, alignment = .Center) {
            Text("Detail")
                .typography(.title)
            Text("Back is now chrome too.")
                .foregroundColor(.Secondary)
        }
        .fillWidth()
        .fillHeight()
        .navigationTitle("Detail")
    }
}
