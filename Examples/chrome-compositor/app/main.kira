import KiraUI
import Ember

// The page the home tab's stack goes on to.
construct DetailRoute() extends NavigationRoute {
    function routeKey() -> String {
        return "detail"
    }

    function destination() -> Any Widget {
        return DetailPage()
    }
}

function chromeExampleAction() {}

@Main
function main() {
    ChromeCompositorApp()
}

function ChromeCompositorApp() {
    RunKiraWindowApp(
        "KiraUI Chrome Compositor",
        980,
        720,
        { in
            return AppSurface() {
                ChromeExample()
            }
        }
    )
}

construct ChromeExample() extends Widget {
    @State var path: NavigationPath = NavigationPath {}
    @State var selection: Number = 0

    body {
        TabView(selection: $selection) {
            Tab(title = "Home", systemImage = .House, value = 0) {
                NavigationStack(path = path) {
                    VStack(spacing = .Medium, alignment = .Center) {
                        Text("Chrome compositor")
                        .typography(.title)

                        Text(
                            "Toolbar, navigation and tabs are composed by one window chrome owner."
                        )
                        .foregroundColor(.Secondary)

                        NavigationLink(value = DetailRoute()) {
                            Button(title = "Open detail", action = chromeExampleAction)
                        }
                    }
                    .fillWidth()
                    .fillHeight()
                    .navigationTitle("Home")
                    .toolbar {
                        ToolbarItem(placement = .PrimaryAction) {
                            Button(action = chromeExampleAction) {
                                Icon(symbol = .Plus)
                            }
                        }
                    }
                }
            }

            Tab(title = "Search", systemImage = .Search, value = 1) {
                VStack(spacing = .Medium, alignment = .Center) {
                    Icon(symbol = .Search)
                    .imageScale(.Large)
                    Text("Search")
                    .typography(.title)
                }
                .fillWidth()
                .fillHeight()
                .navigationTitle("Search")
            }

            Tab(title = "Settings", systemImage = .Gear, value = 2) {
                VStack(spacing = .Medium, alignment = .Center) {
                    Icon(symbol = .Gear)
                    .imageScale(.Large)
                    Text("Settings")
                    .typography(.title)
                }
                .fillWidth()
                .fillHeight()
                .navigationTitle("Settings")
            }
        }
    }
}

construct DetailPage() extends Widget {
    body {
        VStack(spacing = .Medium, alignment = .Center) {
            Text("Detail")
            .typography(.title)
            Text("Back is now chrome too.")
            .foregroundColor(.Secondary)
        }
        .fillWidth()
        .fillHeight()
        .navigationTitle("Detail")
    }
}
