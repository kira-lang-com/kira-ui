import KiraUI
import KiraGraphics
import KCoreAnimation

// A context menu on Liquid Glass, over a photograph — the whole menu is widgets
// now (`ContextMenu`/`ControlGroup`/`Menu`/`Button`/`Label`), and the glass is
// the toolkit's own: `ContextMenu` describes a `CAContent.Glass` card that
// captures and refracts whatever is drawn behind it. Here that is a photo,
// loaded once into a texture the backdrop shows.

struct GlassMenuState {
    var textureId: Int = 0
    var textureTried: Bool = false
}

function glassMenuSlot() -> String {
    return "liquidglassmenu.state"
}

function glassMenuEnsure() {
    if stateSlotHas(glassMenuSlot()) == false {
        stateSlotPut(glassMenuSlot(), nativeUserData(nativeState(GlassMenuState {})))
    }
    return
}

// The loaded backdrop texture, read by the screen. Zero until the first frame
// has run its engine hook.
function glassMenuTextureId() -> Int {
    glassMenuEnsure()
    let state = nativeRecover<GlassMenuState>(stateSlotGet(glassMenuSlot()))
    return state.textureId
}

// Load the photograph once, on the first frame, when a Graphics handle exists.
function glassMenuLoadTexture(frame: borrow mut RenderFrame) {
    glassMenuEnsure()
    var state = nativeRecover<GlassMenuState>(stateSlotGet(glassMenuSlot()))
    if state.textureTried {
        return
    }
    state.textureTried = true
    state.textureId = glassMenuBackdropTexture(foundationFrameGraphics(frame))
    return
}

function glassMenuBackdropTexture(graphics: borrow Graphics) -> Int {
    attempt {
        let tex = try loadRgbaTexture(graphics, "assets/background-cubes-cool.rgba", 1600, 900)
        return tex
    }
    handle {
        AssetUnreadable { return 0 }
        DeviceRefused { return 0 }
        ShaderRejected { return 0 }
    }
}

@Main
function main() {
    GlassMenuApp()
    return
}

// The window, event pump, and frame loop own the process main thread, and a
// lifecycle is how a Kira program claims it. `@Main` above only schedules this
// and returns; the process stays alive until the window closes.
@MainThreadLifecycle
function GlassMenuApp() {
    RunKiraWindowApp(
        // 1000x940 physical at a 3x render scale, matching the reference
        // screenshots: a menu measured at 1x cannot say whether a hairline is a
        // hairline.
        title: "Liquid Glass — menu",
        width: 1000,
        height: 940,
        rootBuilder: { in
            return GlassMenuScreen()
        },
        engineFrame: { frame in
            glassMenuLoadTexture(frame)
            return
        }
    )
    return
}
