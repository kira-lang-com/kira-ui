import KiraUI

// A photo's context menu, exactly as the platform's Photos app arranges it:
// three actions across the top, then rows in groups, some of them owning
// submenus that open inside the card. `ContextMenu` is the Liquid Glass card —
// it refracts whatever is drawn behind it, which is why this example stands it
// over a photograph.
//
// Every row is one declaration. The submenus that grow out of "Add To" and
// "Adjust Info" are `Menu`'s doing, not anything stated here.
construct PhotoMenu() extends Widget {
    body {
        ContextMenu {
            ControlGroup {
                Button(action = photoCopy) { Label(title = "Copy", systemImage = .DocOnDoc) }
                Button(action = photoDuplicate) { Label(title = "Duplicate", systemImage = .PlusSquareOnSquare) }
                Button(action = photoHide) { Label(title = "Hide", systemImage = .EyeSlash) }
            }

            Divider()

            Button(action = photoSlideshow) { Label(title = "Start Slideshow", systemImage = .PlayRectangle) }

            Divider()

            Menu(title = "Add To", systemImage = .PhotoOnRectangle) {
                Button(title = "Recents", action = photoAddToRecents)
                Button(title = "Favorites", action = photoAddToFavorites)
                Button(title = "Shared Album", action = photoAddToShared)
            }

            Menu(title = "Adjust Info", systemImage = .InfoCircle) {
                Button(title = "Adjust Date & Time", action = photoAdjustDate)
                Button(title = "Adjust Location", action = photoAdjustLocation)
            }

            Menu(title = "Edits", systemImage = .SliderHorizontal3) {
                Button(title = "Copy Edits", action = photoCopyEdits)
                Button(title = "Paste Edits", action = photoPasteEdits)
                Button(title = "Reset Adjustments", action = photoResetEdits)
            }

            Divider()

            Button(action = photoSaveFrame) { Label(title = "Save Video Frame as Photo", systemImage = .Photo) }
        }
    }
}

function photoCopy() { return }
function photoDuplicate() { return }
function photoHide() { return }
function photoSlideshow() { return }
function photoAddToRecents() { return }
function photoAddToFavorites() { return }
function photoAddToShared() { return }
function photoAdjustDate() { return }
function photoAdjustLocation() { return }
function photoCopyEdits() { return }
function photoPasteEdits() { return }
function photoResetEdits() { return }
function photoSaveFrame() { return }
