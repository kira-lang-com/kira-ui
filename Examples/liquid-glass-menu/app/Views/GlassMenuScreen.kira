import KiraUI
import KiraGraphics
import KCoreAnimation
import Foundation

// The page the menu sits on: a photograph, so the glass has something to be
// glass about. A menu over a flat color shows nothing of the material — the
// wash, the blur and the edge refraction only read against real content — so
// this example refracts a loaded photo rather than the color bands the plain
// `menu` example uses. Until the texture loads (the first frame), the same bands
// stand in so the window is never empty.
construct GlassMenuScreen() extends Widget {
    body {
        ZStack(alignment = .Center) {
            glassMenuBackdrop()
            PhotoMenu()
        }
    }
}

function glassMenuBackdrop() -> Any Widget {
    let texId = glassMenuTextureId()
    if texId > 0 {
        return TextureViewport(texture: TextureHandle(texId))
            .fillWidth()
            .fillHeight()
    }
    return VStack(spacing = .None) {
        Rectangle().fill(Color { r = 0.16, g = 0.42, b = 0.72, a = 1.0 }).height(180.0)
        Rectangle().fill(Color { r = 0.86, g = 0.55, b = 0.28, a = 1.0 }).height(150.0)
        Rectangle().fill(Color { r = 0.93, g = 0.86, b = 0.72, a = 1.0 }).height(170.0)
        Rectangle().fill(Color { r = 0.22, g = 0.31, b = 0.25, a = 1.0 }).fillHeight()
    }
    .fillWidth()
    .fillHeight()
}
