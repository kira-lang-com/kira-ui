
// The evaluator: recursive descent over the typed tokens, every value complex,
// with the cursor carried explicitly because the parser never holds state the
// token array does not give it.

// One parse step's answer: the value, where the parse stopped, and whether it
// gave up. `failed` travels up rather than trapping, so a malformed expression
// leaves the display saying Error instead of ending the run.
struct Step {
    var value: Cx = Cx {}
    var pos: Int = 0
    var failed: Bool = false
}

struct EvalOutcome {
    var value: Cx = Cx {}
    var failed: Bool = false
}

function stepValue(s: Step) -> Cx {
    return s.value
}

// Entry point. An empty expression fails quietly: there is nothing to show.
function evaluateTokens(tokens: borrow [Tok], degrees: Bool) -> EvalOutcome {
    var outcome = EvalOutcome {}
    if tokens.count == 0 {
        outcome.failed = true
        return outcome
    }
    let parsed = parseSum(tokens, 0, degrees)
    if parsed.failed || parsed.pos != tokens.count {
        outcome.failed = true
        return outcome
    }
    let v = parsed.value
    if v.re != v.re || v.im != v.im {
        outcome.failed = true
        return outcome
    }
    if v.re > calcOverflowBound() || v.re < -calcOverflowBound() {
        outcome.failed = true
        return outcome
    }
    outcome.value = v
    return outcome
}

// --- Grammar -----------------------------------------------------------------
//
// sum   := term { (+|-) term }
// term  := unary { (*|/|mod|nPr|nCr) unary }     implicit × when two values abut
// unary := - unary | power
// power := postfix [ ^ unary ]                   right associative
// postfix := primary { ! | % }
// primary := number | π | e | i | name(expr[,expr]) | ( sum )

function peekKind(tokens: borrow [Tok], pos: Int) -> Int {
    if pos >= tokens.count {
        // A kind that matches nothing: the end of input reads as "no token".
        return 0 - 99
    }
    return tokens[pos].kind
}

function parseSum(tokens: borrow [Tok], start: Int, degrees: Bool) -> Step {
    let firstTerm = parseTerm(tokens, start, degrees)
    if firstTerm.failed {
        return firstTerm
    }
    var accumulator = firstTerm.value
    var pos = firstTerm.pos
    var going = true
    while going {
        let kind = peekKind(tokens, pos)
        if kind == tokAdd() {
            let nextTerm = parseTerm(tokens, pos + 1, degrees)
            if nextTerm.failed {
                return nextTerm
            }
            accumulator = cxAdd(accumulator, nextTerm.value)
            pos = nextTerm.pos
        } else {
            if kind == tokSub() {
                let nextTerm = parseTerm(tokens, pos + 1, degrees)
                if nextTerm.failed {
                    return nextTerm
                }
                accumulator = cxSub(accumulator, nextTerm.value)
                pos = nextTerm.pos
            } else {
                going = false
            }
        }
    }
    var done = Step {}
    done.value = accumulator
    done.pos = pos
    return done
}

function startsAValue(kind: Int) -> Bool {
    if kind == tokNum() {
        return true
    }
    if kind == tokLPar() {
        return true
    }
    if kind == tokFn() {
        return true
    }
    if kind == tokPi() {
        return true
    }
    if kind == tokE() {
        return true
    }
    if kind == tokI() {
        return true
    }
    return false
}

function parseTerm(tokens: borrow [Tok], start: Int, degrees: Bool) -> Step {
    let firstFactor = parseUnary(tokens, start, degrees)
    if firstFactor.failed {
        return firstFactor
    }
    var accumulator = firstFactor.value
    var pos = firstFactor.pos
    var going = true
    while going {
        let kind = peekKind(tokens, pos)
        if kind == tokMul() || kind == tokDiv() || kind == tokMod() || kind == tokNPr() || kind == tokNCr() {
            let nextFactor = parseUnary(tokens, pos + 1, degrees)
            if nextFactor.failed {
                return nextFactor
            }
            let combined = applyBinary(kind, accumulator, nextFactor.value)
            if combined.failed {
                var bad = Step {}
                bad.failed = true
                bad.pos = nextFactor.pos
                return bad
            }
            accumulator = combined.value
            pos = nextFactor.pos
        } else {
            if startsAValue(kind) {
                // Two values side by side multiply: 3i, 2π, (1+i)(2−i).
                let nextFactor = parseUnary(tokens, pos, degrees)
                if nextFactor.failed {
                    return nextFactor
                }
                accumulator = cxMul(accumulator, nextFactor.value)
                pos = nextFactor.pos
            } else {
                going = false
            }
        }
    }
    var done = Step {}
    done.value = accumulator
    done.pos = pos
    return done
}

function parseUnary(tokens: borrow [Tok], start: Int, degrees: Bool) -> Step {
    let kind = peekKind(tokens, start)
    if kind == tokSub() {
        let inner = parseUnary(tokens, start + 1, degrees)
        if inner.failed {
            return inner
        }
        var negated = Step {}
        negated.value = cxNeg(inner.value)
        negated.pos = inner.pos
        return negated
    }
    return parsePower(tokens, start, degrees)
}

function parsePower(tokens: borrow [Tok], start: Int, degrees: Bool) -> Step {
    let baseStep = parsePostfix(tokens, start, degrees)
    if baseStep.failed {
        return baseStep
    }
    if peekKind(tokens, baseStep.pos) != tokPow() {
        return baseStep
    }
    // Right associative: 2^3^2 reads 2^(3^2), and the exponent may carry its
    // own unary minus.
    let exponentStep = parseUnary(tokens, baseStep.pos + 1, degrees)
    if exponentStep.failed {
        return exponentStep
    }
    var raised = Step {}
    raised.value = cxPow(baseStep.value, exponentStep.value)
    raised.pos = exponentStep.pos
    return raised
}

function parsePostfix(tokens: borrow [Tok], start: Int, degrees: Bool) -> Step {
    let primaryStep = parsePrimary(tokens, start, degrees)
    if primaryStep.failed {
        return primaryStep
    }
    var value = primaryStep.value
    var pos = primaryStep.pos
    var going = true
    while going {
        let kind = peekKind(tokens, pos)
        if kind == tokFact() {
            if value.im != 0.0 {
                var bad = Step {}
                bad.failed = true
                bad.pos = pos + 1
                return bad
            }
            let f = factorialF(value.re)
            if f < 0.0 {
                var bad = Step {}
                bad.failed = true
                bad.pos = pos + 1
                return bad
            }
            value = cxReal(f)
            pos = pos + 1
        } else {
            if kind == tokPct() {
                value = cxScale(value, 0.01)
                pos = pos + 1
            } else {
                going = false
            }
        }
    }
    var done = Step {}
    done.value = value
    done.pos = pos
    return done
}

function parsePrimary(tokens: borrow [Tok], start: Int, degrees: Bool) -> Step {
    if start >= tokens.count {
        var bad = Step {}
        bad.failed = true
        bad.pos = start
        return bad
    }
    let t = tokens[start]
    if t.kind == tokNum() {
        var done = Step {}
        done.value = cx(t.re, t.im)
        done.pos = start + 1
        return done
    }
    if t.kind == tokPi() {
        var done = Step {}
        done.value = cxReal(calcPi())
        done.pos = start + 1
        return done
    }
    if t.kind == tokE() {
        var done = Step {}
        done.value = cxReal(calcE())
        done.pos = start + 1
        return done
    }
    if t.kind == tokI() {
        var done = Step {}
        done.value = cx(0.0, 1.0)
        done.pos = start + 1
        return done
    }
    if t.kind == tokLPar() {
        let inner = parseSum(tokens, start + 1, degrees)
        if inner.failed {
            return inner
        }
        if peekKind(tokens, inner.pos) != tokRPar() {
            var bad = Step {}
            bad.failed = true
            bad.pos = inner.pos
            return bad
        }
        var done = Step {}
        done.value = inner.value
        done.pos = inner.pos + 1
        return done
    }
    if t.kind == tokFn() {
        return parseCall(tokens, start, degrees, t.name)
    }
    var bad = Step {}
    bad.failed = true
    bad.pos = start
    return bad
}

function parseCall(tokens: borrow [Tok], start: Int, degrees: Bool, name: borrow String) -> Step {
    if peekKind(tokens, start + 1) != tokLPar() {
        var bad = Step {}
        bad.failed = true
        bad.pos = start + 1
        return bad
    }
    let firstArg = parseSum(tokens, start + 2, degrees)
    if firstArg.failed {
        return firstArg
    }
    var secondValue = cxReal(0.0)
    var hasSecond = false
    var afterArgs = firstArg.pos
    if peekKind(tokens, firstArg.pos) == tokComma() {
        let secondArg = parseSum(tokens, firstArg.pos + 1, degrees)
        if secondArg.failed {
            return secondArg
        }
        secondValue = secondArg.value
        hasSecond = true
        afterArgs = secondArg.pos
    }
    if peekKind(tokens, afterArgs) != tokRPar() {
        var bad = Step {}
        bad.failed = true
        bad.pos = afterArgs
        return bad
    }
    let applied = applyFunction(name, firstArg.value, secondValue, hasSecond, degrees)
    var done = Step {}
    if applied.failed {
        done.failed = true
        done.pos = afterArgs + 1
        return done
    }
    done.value = applied.value
    done.pos = afterArgs + 1
    return done
}

// --- Application -------------------------------------------------------------

struct Applied {
    var value: Cx = Cx {}
    var failed: Bool = false
}

function appliedBad() -> Applied {
    var a = Applied {}
    a.failed = true
    return a
}

function appliedOk(v: Cx) -> Applied {
    var a = Applied {}
    a.value = v
    return a
}

function applyBinary(kind: Int, a: borrow Cx, b: borrow Cx) -> Applied {
    if kind == tokMul() {
        return appliedOk(cxMul(a, b))
    }
    if kind == tokDiv() {
        if b.re == 0.0 && b.im == 0.0 {
            return appliedBad()
        }
        return appliedOk(cxDiv(a, b))
    }
    if kind == tokMod() {
        if b.re == 0.0 || a.im != 0.0 || b.im != 0.0 {
            return appliedBad()
        }
        return appliedOk(cxReal(a.re % b.re))
    }
    if kind == tokNPr() {
        if a.im != 0.0 || b.im != 0.0 {
            return appliedBad()
        }
        let p = permutationsF(a.re, b.re)
        if p < 0.0 {
            return appliedBad()
        }
        return appliedOk(cxReal(p))
    }
    if kind == tokNCr() {
        if a.im != 0.0 || b.im != 0.0 {
            return appliedBad()
        }
        let c = combinationsF(a.re, b.re)
        if c < 0.0 {
            return appliedBad()
        }
        return appliedOk(cxReal(c))
    }
    return appliedBad()
}

function scaleAngleForMode(a: borrow Cx, degrees: Bool) -> Cx {
    if degrees {
        return cxScale(a, calcPi() / 180.0)
    }
    return a
}

function unscaleAngleForMode(a: borrow Cx, degrees: Bool) -> Cx {
    if degrees {
        return cxScale(a, 180.0 / calcPi())
    }
    return a
}

function applyFunction(
    name: borrow String,
    a: borrow Cx,
    b: borrow Cx,
    hasSecond: Bool,
    degrees: Bool,
) -> Applied {
    if name == "sin" {
        return appliedOk(cxSin(scaleAngleForMode(a, degrees)))
    }
    if name == "cos" {
        return appliedOk(cxCos(scaleAngleForMode(a, degrees)))
    }
    if name == "tan" {
        let r = cxTan(scaleAngleForMode(a, degrees))
        if cxAbs(r) > 1000000000000000.0 {
            return appliedBad()
        }
        return appliedOk(copy r)
    }
    if name == "asin" {
        if a.im != 0.0 || a.re < -1.0 || a.re > 1.0 {
            return appliedBad()
        }
        return appliedOk(unscaleAngleForMode(cxReal(asinF(a.re)), degrees))
    }
    if name == "acos" {
        if a.im != 0.0 || a.re < -1.0 || a.re > 1.0 {
            return appliedBad()
        }
        return appliedOk(unscaleAngleForMode(cxReal(acosF(a.re)), degrees))
    }
    if name == "atan" {
        if a.im != 0.0 {
            return appliedBad()
        }
        return appliedOk(unscaleAngleForMode(cxReal(atanF(a.re)), degrees))
    }
    if name == "sinh" {
        return appliedOk(cxSinh(a))
    }
    if name == "cosh" {
        return appliedOk(cxCosh(a))
    }
    if name == "tanh" {
        return appliedOk(cxTanh(a))
    }
    if name == "asinh" {
        return appliedOk(cxLn(cxAdd(a, cxSqrt(cxAdd(cxMul(a, a), cxReal(1.0))))))
    }
    if name == "acosh" {
        let root = cxSqrt(cxSub(cxMul(a, a), cxReal(1.0)))
        return appliedOk(cxLn(cxAdd(a, root)))
    }
    if name == "atanh" {
        let numerator = cxAdd(cxReal(1.0), a)
        let denominator = cxSub(cxReal(1.0), a)
        if denominator.re == 0.0 && denominator.im == 0.0 {
            return appliedBad()
        }
        return appliedOk(cxScale(cxLn(cxDiv(numerator, denominator)), 0.5))
    }
    if name == "ln" {
        if a.re == 0.0 && a.im == 0.0 {
            return appliedBad()
        }
        return appliedOk(cxLn(a))
    }
    if name == "log" {
        if a.re == 0.0 && a.im == 0.0 {
            return appliedBad()
        }
        return appliedOk(cxLog10(a))
    }
    if name == "logb" {
        if hasSecond == false {
            return appliedBad()
        }
        if b.re == 0.0 && b.im == 0.0 {
            return appliedBad()
        }
        if a.re == 0.0 && a.im == 0.0 {
            return appliedBad()
        }
        return appliedOk(cxDiv(cxLn(b), cxLn(a)))
    }
    if name == "exp" {
        return appliedOk(cxExp(a))
    }
    if name == "sqrt" {
        return appliedOk(cxSqrt(a))
    }
    if name == "abs" {
        return appliedOk(cxReal(cxAbs(a)))
    }
    if name == "arg" {
        if a.re == 0.0 && a.im == 0.0 {
            return appliedBad()
        }
        return appliedOk(unscaleAngleForMode(cxReal(cxImOverRe(a)), degrees))
    }
    if name == "conj" {
        return appliedOk(cxConj(a))
    }
    if name == "re" {
        return appliedOk(cxReal(a.re))
    }
    if name == "im" {
        return appliedOk(cxReal(a.im))
    }
    if name == "floor" {
        if a.im != 0.0 {
            return appliedBad()
        }
        return appliedOk(cxReal(floor(a.re)))
    }
    if name == "round" {
        if a.im != 0.0 {
            return appliedBad()
        }
        return appliedOk(cxReal(floor(a.re + 0.5)))
    }
    return appliedBad()
}
