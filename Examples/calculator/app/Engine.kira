import Foundation

// The calculator's arithmetic: complex numbers, the transcendentals the
// compiler does not ship, an evaluator over the token stream the keypad
// produces, and the two formatters the display reads.
//
// Precision target is ten significant digits — what the display can show —
// reached with range-reduced series rather than naive ones, so the last digit
// shown is the last digit earned.

// One complex value. Every quantity in the machine is one of these, including
// every intermediate, so a calculation never switches arithmetic halfway.
struct Cx {
    var re: Float = 0.0
    var im: Float = 0.0
}

function cx(re: Float, im: Float) -> Cx {
    return Cx { re: re im: im }
}

function cxReal(re: Float) -> Cx {
    return Cx { re: re im: 0.0 }
}

// The three constants the engine builds on, named as functions because module
// scope holds declarations here, not values.
function calcPi() -> Float {
    return 3.141592653589793
}

function calcE() -> Float {
    return 2.718281828459045
}

function calcLn2() -> Float {
    return 0.6931471805599453
}

// The overflow story: past e^700 the display cannot carry the answer, so the
// evaluator calls it before the formatter ever sees an infinity.
function calcOverflowBound() -> Float {
    return expF(700.0)
}

// --- Complex arithmetic ------------------------------------------------------

function cxAdd(a: borrow Cx, b: borrow Cx) -> Cx {
    return cx(a.re + b.re, a.im + b.im)
}

function cxSub(a: borrow Cx, b: borrow Cx) -> Cx {
    return cx(a.re - b.re, a.im - b.im)
}

function cxNeg(a: borrow Cx) -> Cx {
    return cx(0.0 - a.re, 0.0 - a.im)
}

function cxMul(a: borrow Cx, b: borrow Cx) -> Cx {
    return cx(a.re * b.re - a.im * b.im, a.re * b.im + a.im * b.re)
}

function cxScale(a: borrow Cx, s: Float) -> Cx {
    return cx(a.re * s, a.im * s)
}

function cxDiv(a: borrow Cx, b: borrow Cx) -> Cx {
    let d = b.re * b.re + b.im * b.im
    if d == 0.0 {
        return cx(0.0, 0.0)
    }
    return cx((a.re * b.re + a.im * b.im) / d, (a.im * b.re - a.re * b.im) / d)
}

function positiveF(v: Float) -> Float {
    if v < 0.0 {
        return 0.0 - v
    }
    return v
}

function cxAbs(a: borrow Cx) -> Float {
    // hypot without hypot: scale so squaring cannot overflow the range a
    // calculator reaches through powers.
    let ar = positiveF(a.re)
    let ai = positiveF(a.im)
    var large = ar
    if ai > large {
        large = ai
    }
    if large == 0.0 {
        return 0.0
    }
    let sr = ar / large
    let si = ai / large
    return large * sqrt(sr * sr + si * si)
}

function cxArg(a: borrow Cx) -> Float {
    if a.re == 0.0 && a.im == 0.0 {
        return 0.0
    }
    return atanF(cxImOverRe(a))
}

// atan2(y, x) assembled from the quadrant-free atan: the axis cases fall out
// of the signs once atan itself is right.
function cxImOverRe(a: borrow Cx) -> Float {
    if a.re == 0.0 {
        if a.im > 0.0 {
            return calcPi() / 2.0
        }
        if a.im < 0.0 {
            return 0.0 - calcPi() / 2.0
        }
        return 0.0
    }
    let ratio = a.im / a.re
    if a.re > 0.0 {
        return atanF(ratio)
    }
    if a.im >= 0.0 {
        return atanF(ratio) + calcPi()
    }
    return atanF(ratio) - calcPi()
}

function cxConj(a: borrow Cx) -> Cx {
    return cx(a.re, 0.0 - a.im)
}

// --- Real transcendentals ----------------------------------------------------

// e^x. Reduced to r in ±ln2/2 around n*ln2, then a Taylor series whose twelfth
// term is already past double precision, then scaled back by repeated
// doubling — exact steps, so only the series rounds.
function expF(x: Float) -> Float {
    if x == 0.0 {
        return 1.0
    }
    if x > 709.0 {
        return calcOverflowBound()
    }
    if x < -745.0 {
        return 0.0
    }
    var n = 0
    var r = x
    var halving = false
    if r < 0.0 {
        r = 0.0 - r
        halving = true
    }
    while r > calcLn2() / 2.0 {
        r = r - calcLn2()
        n = n + 1
    }
    var term = 1.0
    var sum = 1.0
    var k = 1
    while k < 24 {
        term = term * r / Float(k)
        sum = sum + term
        if sum + term == sum {
            k = 24
        }
        k = k + 1
    }
    var doubled = 0
    while doubled < n {
        sum = sum * 2.0
        doubled = doubled + 1
    }
    if halving {
        return 1.0 / sum
    }
    return sum
}

function sinhF(x: Float) -> Float {
    let e = expF(x)
    return (e - 1.0 / e) / 2.0
}

function coshF(x: Float) -> Float {
    let e = expF(x)
    return (e + 1.0 / e) / 2.0
}

function tanhF(x: Float) -> Float {
    if x > 19.0 {
        return 1.0
    }
    if x < -19.0 {
        return 0.0 - 1.0
    }
    let e = expF(2.0 * x)
    return (e - 1.0) / (e + 1.0)
}

// Natural log. Halve until the mantissa sits in [1/sqrt2, sqrt2), then the
// atanh series converges to double precision in about a dozen terms.
function lnF(v: Float) -> Float {
    if v <= 0.0 {
        return 0.0 - 745.0
    }
    var m = v
    var k = 0
    while m >= 1.4142135623730951 {
        m = m / 2.0
        k = k + 1
    }
    while m < 0.7071067811865476 {
        m = m * 2.0
        k = k - 1
    }
    let s = (m - 1.0) / (m + 1.0)
    let s2 = s * s
    var term = s
    var sum = s
    var n = 1.0
    while n < 40.0 {
        term = term * s2
        let next = sum + term / (2.0 * n + 1.0)
        if next == sum {
            n = 99.0
        }
        sum = next
        n = n + 1.0
    }
    return 2.0 * sum + Float(k) * calcLn2()
}

function log10F(v: Float) -> Float {
    return lnF(v) / lnF(10.0)
}

// Arctangent. The argument-reduction identity atan(x) = 2·atan(x/(1+sqrt(1+x²)))
// runs until the argument is small enough that the alternating series lands
// within a ulp of the answer in a handful of terms.
function atanF(x: Float) -> Float {
    if x != x {
        return 0.0
    }
    var reduced = x
    var folds = 0
    while reduced > 0.35 || reduced < -0.35 {
        reduced = reduced / (1.0 + sqrt(1.0 + reduced * reduced))
        folds = folds + 1
        if folds > 60 {
            break
        }
    }
    var term = reduced
    var sum = reduced
    var k = 1
    while k < 60 {
        term = term * reduced * reduced
        let next = sum + Float(signIsh(k)) * term / Float(2 * k + 1)
        if next == sum {
            k = 70
        }
        sum = next
        k = k + 1
    }
    var doubled = 0
    while doubled < folds {
        sum = 2.0 * sum
        doubled = doubled + 1
    }
    return sum
}

function signIsh(k: Int) -> Int {
    if k % 2 == 0 {
        return 1
    }
    return 0 - 1
}

function asinF(x: Float) -> Float {
    if x > 1.0 {
        return calcPi() / 2.0
    }
    if x < -1.0 {
        return 0.0 - calcPi() / 2.0
    }
    if x == 1.0 {
        return calcPi() / 2.0
    }
    if x == -1.0 {
        return 0.0 - calcPi() / 2.0
    }
    return atanF(x / sqrt(1.0 - x * x))
}

function acosF(x: Float) -> Float {
    return calcPi() / 2.0 - asinF(x)
}

// --- Complex transcendentals -------------------------------------------------

function cxSin(a: borrow Cx) -> Cx {
    return cx(sin(a.re) * coshF(a.im), cos(a.re) * sinhF(a.im))
}

function cxCos(a: borrow Cx) -> Cx {
    return cx(cos(a.re) * coshF(a.im), 0.0 - sin(a.re) * sinhF(a.im))
}

function cxTan(a: borrow Cx) -> Cx {
    let denominator = cos(2.0 * a.re) + coshF(2.0 * a.im)
    if denominator == 0.0 {
        return cx(0.0, 0.0)
    }
    return cx(sin(2.0 * a.re) / denominator, sinhF(2.0 * a.im) / denominator)
}

function cxSinh(a: borrow Cx) -> Cx {
    return cx(sinhF(a.re) * cos(a.im), coshF(a.re) * sin(a.im))
}

function cxCosh(a: borrow Cx) -> Cx {
    return cx(coshF(a.re) * cos(a.im), sinhF(a.re) * sin(a.im))
}

function cxTanh(a: borrow Cx) -> Cx {
    let e = cxExp(a)
    let inverse = cxReciprocal(e)
    return cxScale(cxSub(e, inverse), 0.5)
}

function cxExp(a: borrow Cx) -> Cx {
    let magnitude = expF(a.re)
    return cx(magnitude * cos(a.im), magnitude * sin(a.im))
}

function cxReciprocal(a: borrow Cx) -> Cx {
    return cxDiv(cxReal(1.0), a)
}

function cxLn(a: borrow Cx) -> Cx {
    return cx(lnF(cxAbs(a)), cxArg(a))
}

function cxLog10(a: borrow Cx) -> Cx {
    return cxScale(cxLn(a), 1.0 / lnF(10.0))
}

// z^w through the polar form, with the small-integer-exponent cases taken
// exactly by repeated multiplication so 2^10 never learns about logarithms.
function cxPow(base: borrow Cx, power: borrow Cx) -> Cx {
    if base.re == 0.0 && base.im == 0.0 {
        if power.re == 0.0 && power.im == 0.0 {
            return cxReal(1.0)
        }
        return cx(0.0, 0.0)
    }
    if power.im == 0.0 {
        let n = power.re
        if n == Float(Int(n)) {
            var exponent = Int(n)
            var invert = false
            if exponent < 0 {
                invert = true
                exponent = 0 - exponent
            }
            if exponent <= 256 {
                var accumulator = cxReal(1.0)
                var step = 0
                while step < exponent {
                    accumulator = cxMul(accumulator, base)
                    step = step + 1
                }
                if invert {
                    return cxReciprocal(accumulator)
                }
                return accumulator
            }
        }
    }
    // Principal branch: (-8)^(1/3) answers the principal 1+i·sqrt(3), which is
    // what a complex calculator conventionally says.
    let lnBase = cxLn(base)
    return cxExp(cxMul(power, lnBase))
}

function cxSqrt(a: borrow Cx) -> Cx {
    if a.im == 0.0 && a.re >= 0.0 {
        return cxReal(sqrt(a.re))
    }
    if a.im == 0.0 && a.re < 0.0 {
        return cx(0.0, sqrt(0.0 - a.re))
    }
    return cxPow(a, cxReal(0.5))
}

// --- Discrete operations -----------------------------------------------------

function factorialF(n: Float) -> Float {
    if n < 0.0 || n != Float(Int(n)) || n > 170.0 {
        return 0.0 - 1.0
    }
    var accumulator = 1.0
    var k = 2.0
    while k <= n + 0.5 {
        accumulator = accumulator * k
        k = k + 1.0
    }
    return accumulator
}

function permutationsF(n: Float, r: Float) -> Float {
    if n < 0.0 || r < 0.0 || r > n {
        return 0.0 - 1.0
    }
    if n != Float(Int(n)) || r != Float(Int(r)) {
        return 0.0 - 1.0
    }
    var accumulator = 1.0
    var k = 0.0
    while k < r {
        accumulator = accumulator * (n - k)
        if accumulator > expF(690.0) {
            return 0.0 - 1.0
        }
        k = k + 1.0
    }
    return accumulator
}

function combinationsF(n: Float, r: Float) -> Float {
    if r > n / 2.0 {
        return combinationsF(n, n - r)
    }
    if n < 0.0 || r < 0.0 || r > n {
        return 0.0 - 1.0
    }
    if n != Float(Int(n)) || r != Float(Int(r)) {
        return 0.0 - 1.0
    }
    var accumulator = 1.0
    var k = 1.0
    while k <= r {
        accumulator = accumulator * (n - r + k) / k
        k = k + 1.0
    }
    return Float(Int(accumulator + 0.5))
}

// --- Degrees -----------------------------------------------------------------

function toRadians(angle: Float, degrees: Bool) -> Float {
    if degrees {
        return angle * calcPi() / 180.0
    }
    return angle
}

function fromRadians(angle: Float, degrees: Bool) -> Float {
    if degrees {
        return angle * 180.0 / calcPi()
    }
    return angle
}
