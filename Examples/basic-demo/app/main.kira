import KiraUI

// The original Basic Demo palette, expressed once through KiraUI's Theme API.
// `KIRA_UI_APPEARANCE=light` selects the light branch; any other value selects
// the dark branch, so the same widget tree can be captured in both schemes.
StyleImplementation EpureeStyle {
    let colors = StyleColorTokens {
        foregroundPrimary = AdaptiveColor {
            light = Color { r = 0.11, g = 0.11, b = 0.12, a = 1.0 }
            dark = Color { r = 0.94, g = 0.93, b = 0.91, a = 1.0 }
        }

        foregroundSecondary = AdaptiveColor {
            light = Color { r = 0.56, g = 0.56, b = 0.58, a = 1.0 }
            dark = Color { r = 0.70, g = 0.68, b = 0.66, a = 1.0 }
        }

        foregroundDisabled = AdaptiveColor {
            light = Color { r = 0.69, g = 0.68, b = 0.66, a = 1.0 }
            dark = Color { r = 0.48, g = 0.46, b = 0.45, a = 1.0 }
        }

        foregroundInverse = AdaptiveColor {
            light = Color { r = 1.0, g = 1.0, b = 1.0, a = 1.0 }
            dark = Color { r = 0.08, g = 0.075, b = 0.08, a = 1.0 }
        }

        backgroundCanvas = AdaptiveColor {
            light = Color { r = 0.96, g = 0.95, b = 0.93, a = 1.0 }
            dark = Color { r = 0.08, g = 0.075, b = 0.08, a = 1.0 }
        }

        backgroundSurface = AdaptiveColor {
            light = Color { r = 1.0, g = 1.0, b = 1.0, a = 1.0 }
            dark = Color { r = 0.13, g = 0.12, b = 0.13, a = 1.0 }
        }

        backgroundRaised = AdaptiveColor {
            light = Color { r = 1.0, g = 1.0, b = 1.0, a = 1.0 }
            dark = Color { r = 0.17, g = 0.16, b = 0.17, a = 1.0 }
        }

        backgroundOverlay = AdaptiveColor {
            light = Color { r = 1.0, g = 1.0, b = 1.0, a = 0.94 }
            dark = Color { r = 0.21, g = 0.19, b = 0.20, a = 0.94 }
        }

        backgroundControl = AdaptiveColor {
            light = Color { r = 0.93, g = 0.91, b = 0.88, a = 1.0 }
            dark = Color { r = 0.12, g = 0.105, b = 0.11, a = 1.0 }
        }

        accent = AdaptiveColor {
            light = Color { r = 0.61, g = 0.53, b = 0.48, a = 1.0 }
            dark = Color { r = 0.80, g = 0.70, b = 0.63, a = 1.0 }
        }

        danger = AdaptiveColor {
            light = Color { r = 0.72, g = 0.25, b = 0.22, a = 1.0 }
            dark = Color { r = 0.95, g = 0.40, b = 0.36, a = 1.0 }
        }

        success = AdaptiveColor {
            light = Color { r = 0.45, g = 0.68, b = 0.50, a = 1.0 }
            dark = Color { r = 0.52, g = 0.80, b = 0.58, a = 1.0 }
        }

        warning = AdaptiveColor {
            light = Color { r = 0.76, g = 0.58, b = 0.40, a = 1.0 }
            dark = Color { r = 0.91, g = 0.69, b = 0.40, a = 1.0 }
        }

        borderSubtle = AdaptiveColor {
            light = Color { r = 0.91, g = 0.89, b = 0.85, a = 1.0 }
            dark = Color { r = 1.0, g = 1.0, b = 1.0, a = 0.12 }
        }

        borderStandard = AdaptiveColor {
            light = Color { r = 0.89, g = 0.86, b = 0.82, a = 1.0 }
            dark = Color { r = 1.0, g = 1.0, b = 1.0, a = 0.22 }
        }

        borderStrong = AdaptiveColor {
            light = Color { r = 0.76, g = 0.72, b = 0.66, a = 1.0 }
            dark = Color { r = 1.0, g = 1.0, b = 1.0, a = 0.34 }
        }

        borderFocus = AdaptiveColor {
            light = Color { r = 0.61, g = 0.53, b = 0.48, a = 0.90 }
            dark = Color { r = 0.80, g = 0.70, b = 0.63, a = 0.95 }
        }

        glassTint = AdaptiveColor {
            light = Color { r = 1.0, g = 1.0, b = 1.0, a = 1.0 }
            dark = Color { r = 0.90, g = 0.86, b = 0.83, a = 1.0 }
        }
    }

    let cornerRadii = StyleCornerRadiusTokens {
        none = 0.0
        small = 16.0
        medium = 24.0
        large = 32.0
        extraLarge = 64.0
        capsule = 999.0
    }

    let spacing = StyleSpacingTokens {
        none = 0.0
        extraSmall = 4.0
        small = 8.0
        medium = 16.0
        large = 20.0
        extraLarge = 28.0
        section = 32.0
    }

    let typography = StyleTypographyTokens {
        caption = FontImplementation {
            size = 12.0
            weight = FontWeight.Regular
            lineHeight = 16.0
            tracking = 0.2
        }

        body = FontImplementation {
            size = 15.0
            weight = FontWeight.Regular
            lineHeight = 21.0
            tracking = 0.0
        }

        subheadline = FontImplementation {
            size = 13.0
            weight = FontWeight.Regular
            lineHeight = 18.0
            tracking = 0.0
        }

        control = FontImplementation {
            size = 15.0
            weight = FontWeight.SemiBold
            lineHeight = 20.0
            tracking = 0.0
        }

        title = FontImplementation {
            size = 30.0
            weight = FontWeight.Bold
            lineHeight = 36.0
            tracking = -0.3
        }

        bodyEmphasis = FontImplementation {
            size = 14.0
            weight = FontWeight.SemiBold
            lineHeight = 20.0
            tracking = 0.0
        }

        footnote = FontImplementation {
            size = 11.0
            weight = FontWeight.Regular
            lineHeight = 15.0
            tracking = 0.0
        }

        overline = FontImplementation {
            size = 10.0
            weight = FontWeight.SemiBold
            lineHeight = 13.0
            tracking = 0.5
        }

        label = FontImplementation {
            size = 12.0
            weight = FontWeight.SemiBold
            lineHeight = 16.0
            tracking = 0.0
        }

        section = FontImplementation {
            size = 16.0
            weight = FontWeight.Bold
            lineHeight = 20.0
            tracking = 0.0
        }

        headline = FontImplementation {
            size = 18.0
            weight = FontWeight.SemiBold
            lineHeight = 23.0
            tracking = 0.0
        }

        title1 = FontImplementation {
            size = 30.0
            weight = FontWeight.Bold
            lineHeight = 36.0
            tracking = -0.3
        }

        title2 = FontImplementation {
            size = 24.0
            weight = FontWeight.Bold
            lineHeight = 29.0
            tracking = -0.2
        }

        title3 = FontImplementation {
            size = 28.0
            weight = FontWeight.Bold
            lineHeight = 34.0
            tracking = -0.2
        }
    }

    let borders = StyleBorderTokens {
        none = BorderImplementation {
            color = .BorderSubtle
            width = 0.0
        }

        subtle = BorderImplementation {
            color = .BorderSubtle
            width = 1.0
        }

        standard = BorderImplementation {
            color = .BorderStandard
            width = 1.0
        }

        strong = BorderImplementation {
            color = .BorderStrong
            width = 1.5
        }

        focus = BorderImplementation {
            color = .BorderFocus
            width = 2.0
        }
    }

    let materials = StyleMaterialTokens {
        frosted = FrostedMaterialImplementation {
            level = .Medium
        }

        liquidGlass = LiquidGlassMaterialImplementation {
            level = .High
            edgeLighting = true
        }
    }
}

Theme EpureeUI {
    let StyleImplementation = EpureeStyle {}
    let text = EpureeStyle {}
    let icon = EpureeStyle {}
    let button = EpureeStyle {}
    let card = EpureeStyle {}
    let progress = EpureeStyle {}
    let textField = EpureeStyle {}
    let toggle = EpureeStyle {}
    let slider = EpureeStyle {}
    let sidebar = EpureeStyle {}
    let divider = EpureeStyle {}
}

@Main
function entry() {
    RunWidgetInteractiveApp(
        title: "Kira UI Foundation",
        width: 1280,
        height: 720,
        rootBuilder: { in
            return KiraUIApp(
                name: "Kira UI Foundation",
                content: BasicDemoHome()
                    .theme(EpureeUI())
            )
        },
        engineFrame: kiraUiNoopEngineFrame,
        showFpsOverlay: false,
        rebuildOnResize: true
    )

    return
}

Widget BasicDemoHome() {
    body {
        AppSurface(padding = Spacing.Medium) {
            HStack(spacing = Spacing.Medium, distribution = Distribution.Fill) {
                Sidebar()
                    .width(260.0)
                    .fillHeight()

                MainPanel()
            }
        }
    }
}

Widget Sidebar() {
    body {
        Card(material = Material.Flat) {
            VStack(spacing = Spacing.Medium) {
                Text("KIRA")
                    .typography(.title2)

                Text("UI FOUNDATION")
                    .typography(.overline)
                    .themeColor(.Accent)

                Divider()
                    .themeBorder(.Standard)

                Text("DASHBOARD")
                    .typography(.label)
                    .themeColor(.Secondary)

                Text("ANALYTICS")
                    .typography(.caption)
                    .themeColor(.Muted)

                Text("SETTINGS")
                    .typography(.caption)
                    .themeColor(.Muted)

                Spacer()

                Text("v0.1.0")
                    .typography(.footnote)
                    .themeColor(.Muted)
            }
            .fillHeight()
        }
        .themeSurface(.Control)
        .surfaceRadius(32.0)
        .themeBorder(.Standard)
    }
}

Widget MainPanel() {
    body {
        VStack(spacing = Spacing.Medium) {
                Text("Dashboard")
                    .typography(.title1)

                Text("Light / Epuree")
                    .typography(.label)
                    .themeColor(.Accent)

            StatsRow()

            HStack(spacing = Spacing.Medium, distribution = Distribution.Stretch) {
                ComponentsCard()

                ActivityCard()
                    .width(360.0)
            }
        }
    }
}

Widget StatsRow() {
    body {
        HStack(spacing = Spacing.Medium, distribution = Distribution.Start) {
            MetricCard(value = "12,458", label = "TOTAL USERS")
            MetricCard(value = "342", label = "ACTIVE NOW")
            MetricCard(value = "8.2K", label = "REVENUE")
            MetricCard(value = "24%", label = "BOUNCE RATE")
        }
    }
}

Widget MetricCard(value: String, label: String) {
    body {
        Card(material = Material.Flat) {
            VStack(spacing = Spacing.Medium) {
                Text(value)
                    .typography(.title3)

                Text(label)
                    .typography(.caption)
            }
        }
        .surfaceRadius(16.0)
    }
}

Widget ComponentsCard() {
    body {
        Card(material = Material.Flat) {
            VStack(spacing = Spacing.Medium) {
                Text("COMPONENTS")
                    .typography(.section)

                Text("Rounded corners — regular and squircle cards")
                    .typography(.subheadline)

                HStack(spacing = Spacing.Medium, distribution = Distribution.Stretch) {
                    RegularPreviewCard()
                    SquirclePreviewCard()
                }
            }
        }
        .surfaceRadius(24.0)
    }
}

Widget RegularPreviewCard() {
    body {
        Card(material = Material.Flat) {
            VStack(spacing = Spacing.Medium) {
                Text("REGULAR ROUND")
                    .typography(.headline)

                Text("Classic Rect")
                    .typography(.caption)

                Spacer()
                    .size(120.0)
            }
        }
        .surfaceRadius(16.0)
    }
}

Widget SquirclePreviewCard() {
    body {
        Card(material = Material.Flat) {
            VStack(spacing = Spacing.Medium) {
                Text("SQUIRCLE")
                    .typography(.headline)

        Text("VM HOT PATCH CALLBACKS")
                    .typography(.caption)

                Spacer()
                    .size(120.0)
            }
        }
        .surfaceRadius(64.0)
        .surfaceShape(SurfaceShape.Squircle)
        .contentMargins(.automatic(extra: 8))
    }
}

Widget ActivityCard() {
    body {
        Card(material = Material.Flat) {
            VStack(spacing = Spacing.Medium) {
                Text("RECENT ACTIVITY")
                    .typography(.section)

                ActivityRow(label = "New user registered", detail = "2 minutes ago")
                Divider()
                ActivityRow(label = "Layout engine updated", detail = "1 hour ago")
                Divider()
                ActivityRow(label = "Squircle shader deployed", detail = "3 hours ago")
                Divider()
                ActivityRow(label = "Theme changed to Epuree", detail = "Yesterday")
            }
        }
        .surfaceRadius(24.0)
    }
}

Widget ActivityRow(label: String, detail: String) {
    body {
        HStack(spacing = Spacing.Medium) {
            Circle()
                .width(8.0)
                .height(8.0)
                .themeColor(.Accent)

            VStack(spacing = Spacing.Medium) {
                Text(label)
                    .typography(.bodyEmphasis)

                Text(detail)
                    .typography(.caption)
                    .themeColor(.Secondary)
            }
        }
    }
}
