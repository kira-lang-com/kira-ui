import KiraUI

// The menu a photograph carries, as the platform's own Photos app arranges it:
// three actions across the top, then rows in groups, with two of them owning
// submenus that open inside the card.
//
// This is the whole point of the example — every row below is one declaration,
// and the submenu that grows out of "Add To" is `Menu`'s doing rather than
// anything stated here.
construct PhotoMenu() extends Widget {
    body {
        ContextMenu {
            ControlGroup {
                Button(action = copy) { Label(title = "Copy", systemImage = .DocOnDoc) }
                Button(action = duplicate) { Label(title = "Duplicate", systemImage = .PlusSquareOnSquare) }
                Button(action = hide) { Label(title = "Hide", systemImage = .EyeSlash) }
            }

            Divider()

            Button(action = startSlideshow) { Label(title = "Start Slideshow", systemImage = .PlayRectangle) }

            Divider()

            Menu(title = "Add To", systemImage = .PhotoOnRectangle) {
                Button(title = "Recents", action = addToRecents)
                Button(title = "Favourites", action = addToFavourites)
                Button(title = "Shared Album", action = addToShared)
            }

            Menu(title = "Adjust Info", systemImage = .InfoCircle) {
                Button(title = "Adjust Date & Time", action = adjustDate)
                Button(title = "Adjust Location", action = adjustLocation)
            }

            Divider()

            Button(action = saveFrame) { Label(title = "Save Video Frame as Photo", systemImage = .Photo) }
        }
    }
}

function copy() { return }
function duplicate() { return }
function hide() { return }
function startSlideshow() { return }
function addToRecents() { return }
function addToFavourites() { return }
function addToShared() { return }
function adjustDate() { return }
function adjustLocation() { return }
function saveFrame() { return }
