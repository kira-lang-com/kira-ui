import KiraUI

// The page the menu sits on.
//
// Something for the glass to be glass about: a menu over a flat page shows
// nothing of the material, so the card stands over bands of colour and the
// recession that happens behind an open submenu is legible against them.
construct MenuScreen() extends Widget {
    body {
        ZStack(alignment = .Center) {
            VStack(spacing = .None) {
                Rectangle().fill(Color { r = 0.16, g = 0.42, b = 0.72, a = 1.0 }).height(180.0)
                Rectangle().fill(Color { r = 0.86, g = 0.55, b = 0.28, a = 1.0 }).height(150.0)
                Rectangle().fill(Color { r = 0.93, g = 0.86, b = 0.72, a = 1.0 }).height(170.0)
                Rectangle().fill(Color { r = 0.22, g = 0.31, b = 0.25, a = 1.0 }).fillHeight()
            }
            .fillWidth()
            .fillHeight()

            PhotoMenu()
        }
    }
}
