import KiraUI

// A context menu whose submenus open inside it.
//
// Press "Add To" or "Adjust Info": the card grows downward to hold the submenu,
// the row that owns it becomes that submenu's header, and the rest of the menu
// recedes behind it. Press the header again to come back.

@Main
function main() {
    MenuApp()
    return
}

// The window, event pump, and frame loop own the process main thread, and a
// lifecycle is how a Kira program claims it. `@Main` above only schedules this
// and returns; the process stays alive until the window closes.
@MainThreadLifecycle
function MenuApp() {
    RunKiraApp { in
        return KiraUIApp(
            name = "Menu",
            content = MenuScreen()
        )
    }
    return
}
