import KiraUI
import Foundation

// A context menu whose submenus open inside it.
//
// Press "Add To" or "Adjust Info": the card grows downward to hold the submenu,
// the row that owns it becomes that submenu's header, and the rest of the menu
// recedes behind it. Press the header again to come back.

@Main
function main() {
    MenuApp()
}

function MenuApp() {
    RunKiraWindowApp(
        "Menu",
        1280,
        720,
        { in
            return MenuScreen()
        }
    )
}
