// Canonical OpacityUI Theme API showcase.
//
// KiraUI owns every global token name and the ContentStyle, ControlStyle,
// SurfaceStyle, ProgressStyle, and SeparatorStyle constructs. OpacityUI fills
// every token and assigns one global style to every native component.
// Constructor arguments are the component overrides.

import KiraUI
import KiraUIFoundation


StyleImplementation OpacityStyle {
    let colors = StyleColorTokens {
        foregroundPrimary = AdaptiveColor {
            light = Color { r = 0.08, g = 0.09, b = 0.12, a = 1.0 }
            dark = Color { r = 0.95, g = 0.96, b = 0.99, a = 1.0 }
        }

        foregroundSecondary = AdaptiveColor {
            light = Color { r = 0.38, g = 0.40, b = 0.46, a = 1.0 }
            dark = Color { r = 0.68, g = 0.71, b = 0.78, a = 1.0 }
        }

        foregroundDisabled = AdaptiveColor {
            light = Color { r = 0.50, g = 0.51, b = 0.55, a = 0.58 }
            dark = Color { r = 0.58, g = 0.60, b = 0.66, a = 0.58 }
        }

        foregroundInverse = AdaptiveColor {
            light = Color { r = 0.98, g = 0.98, b = 1.0, a = 1.0 }
            dark = Color { r = 0.06, g = 0.07, b = 0.10, a = 1.0 }
        }

        backgroundCanvas = AdaptiveColor {
            light = Color { r = 0.95, g = 0.96, b = 0.98, a = 1.0 }
            dark = Color { r = 0.035, g = 0.04, b = 0.065, a = 1.0 }
        }

        backgroundSurface = AdaptiveColor {
            light = Color { r = 1.0, g = 1.0, b = 1.0, a = 0.92 }
            dark = Color { r = 0.08, g = 0.10, b = 0.15, a = 0.92 }
        }

        backgroundRaised = AdaptiveColor {
            light = Color { r = 1.0, g = 1.0, b = 1.0, a = 0.98 }
            dark = Color { r = 0.12, g = 0.14, b = 0.20, a = 0.96 }
        }

        backgroundOverlay = AdaptiveColor {
            light = Color { r = 0.96, g = 0.97, b = 1.0, a = 0.88 }
            dark = Color { r = 0.10, g = 0.12, b = 0.18, a = 0.88 }
        }

        backgroundControl = AdaptiveColor {
            light = Color { r = 0.91, g = 0.93, b = 0.98, a = 1.0 }
            dark = Color { r = 0.16, g = 0.18, b = 0.26, a = 1.0 }
        }

        accent = AdaptiveColor {
            light = Color { r = 0.20, g = 0.45, b = 0.96, a = 1.0 }
            dark = Color { r = 0.43, g = 0.67, b = 1.0, a = 1.0 }
        }

        danger = AdaptiveColor {
            light = Color { r = 0.82, g = 0.12, b = 0.18, a = 1.0 }
            dark = Color { r = 0.96, g = 0.31, b = 0.37, a = 1.0 }
        }

        success = AdaptiveColor {
            light = Color { r = 0.12, g = 0.58, b = 0.30, a = 1.0 }
            dark = Color { r = 0.34, g = 0.85, b = 0.52, a = 1.0 }
        }

        warning = AdaptiveColor {
            light = Color { r = 0.78, g = 0.48, b = 0.06, a = 1.0 }
            dark = Color { r = 0.98, g = 0.75, b = 0.25, a = 1.0 }
        }

        borderSubtle = AdaptiveColor {
            light = Color { r = 0.08, g = 0.10, b = 0.16, a = 0.10 }
            dark = Color { r = 1.0, g = 1.0, b = 1.0, a = 0.10 }
        }

        borderStandard = AdaptiveColor {
            light = Color { r = 0.08, g = 0.10, b = 0.16, a = 0.18 }
            dark = Color { r = 1.0, g = 1.0, b = 1.0, a = 0.18 }
        }

        borderStrong = AdaptiveColor {
            light = Color { r = 0.08, g = 0.10, b = 0.16, a = 0.32 }
            dark = Color { r = 1.0, g = 1.0, b = 1.0, a = 0.32 }
        }

        borderFocus = AdaptiveColor {
            light = Color { r = 0.20, g = 0.45, b = 0.96, a = 0.86 }
            dark = Color { r = 0.43, g = 0.67, b = 1.0, a = 0.90 }
        }

        glassTint = AdaptiveColor {
            light = Color { r = 1.0, g = 1.0, b = 1.0, a = 1.0 }
            dark = Color { r = 0.72, g = 0.78, b = 0.92, a = 1.0 }
        }
    }

    let cornerRadii = StyleCornerRadiusTokens {
        none = 0.0
        small = 8.0
        medium = 12.0
        large = 18.0
        extraLarge = 24.0
        capsule = 999.0
    }

    let spacing = StyleSpacingTokens {
        none = 0.0
        extraSmall = 4.0
        small = 8.0
        medium = 12.0
        large = 18.0
        extraLarge = 24.0
        section = 32.0
    }

    let typography = StyleTypographyTokens {
        caption = FontImplementation {
            size = 12.0
            weight = .Regular
            lineHeight = 16.0
            tracking = 0.2
        }

        body = FontImplementation {
            size = 15.0
            weight = .Regular
            lineHeight = 21.0
            tracking = 0.0
        }

        control = FontImplementation {
            size = 15.0
            weight = .SemiBold
            lineHeight = 20.0
            tracking = 0.0
        }

        title = FontImplementation {
            size = 28.0
            weight = .Bold
            lineHeight = 34.0
            tracking = -0.3
        }
    }

    let borders = StyleBorderTokens {
        none = BorderImplementation {
            color = .BorderSubtle
            width = 0.0
        }

        subtle = BorderImplementation {
            color = .BorderSubtle
            width = 1.0
        }

        standard = BorderImplementation {
            color = .BorderStandard
            width = 1.0
        }

        strong = BorderImplementation {
            color = .BorderStrong
            width = 1.5
        }

        focus = BorderImplementation {
            color = .BorderFocus
            width = 2.0
        }
    }

    let materials = StyleMaterialTokens {
        frosted = FrostedMaterialImplementation {
            level = .Medium
        }

        liquidGlass = LiquidGlassMaterialImplementation {
            level = .XHigh
            edgeLighting = true
        }
    }

}


Theme OpacityUI {
    let StyleImplementation = OpacityStyle {}

    let text = StyleImplementation {}
    let icon = StyleImplementation {}

    let button = StyleImplementation {
        additionalEffect = [
            ShadowEffect {
                level: .Light
            }
        ]
    }

    let card = StyleImplementation {}

    let progress = StyleImplementation {}

    let textField = StyleImplementation {}

    let toggle = StyleImplementation {}

    let slider = StyleImplementation {}

    let sidebar = StyleImplementation {
        liquidGlass.material: .XHigh
    }

    let divider = StyleImplementation {
        thickness: 1.5
    }
}


Widget DashboardShell() {
    @State var dangerVisible: Bool = true

    body {
        VStack(spacing = .Large) {
            Card(title = "Rendering") {
                Text(
                    "Card uses the global SurfaceStyle selected by OpacityUI. "
                    + "Its material is LiquidGlass."
                )

                Button(title = "Preview glass", action = previewGlass)
                    .foregroundColor(.Purple)
                    .focused(true)
            }

            Card(title = "Live Systems") {
                HStack(spacing = .Medium) {
                    Icon(symbol = .Archivebox)
                    Text("All clusters stable")
                    Progress(value = 0.82)
                }

                Button(title = "Open monitor", action = openMonitor)
                    .foregroundColor(.Green)
            }
            .themeColor(.Green)
            .material(.Flat)

            if dangerVisible {
                Card(title = "Danger Zone") {
                    Text("This label explicitly asks for danger foreground.")
                        .foregroundColor(.Danger)

                    Button(
                        title = "Purge cache",
                        role = .Destructive,
                        action = purgeCache
                    )
                }
                .themeColor(.Danger)
            }
        }
        .themeColor(.Blue)
    }
}


function previewGlass() { return }
function openMonitor() { return }
function purgeCache() { return }


@Main
function main() {
    RunKiraApp { in
        return KiraUIApp(
            name = "OpacityUI Theme Showcase",
            content = DashboardShell()
                .theme(OpacityUI())
        )
    }
    return
}
