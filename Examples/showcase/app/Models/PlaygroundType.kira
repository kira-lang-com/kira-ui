import KiraUI
import Foundation

// All Showcase playgrounds.
@Derive(CaseIterable)
enum PlaygroundType {
    Color
    Divider
    FocusState
    Label
    LabeledContent
    Link
    OnSubmit
    ScenePhase
    SecureField
    Spacer
    Toggle
    ZIndex
}

extend PlaygroundType {
    function title() -> String {
        match self {
            Color -> return "Color"
            Divider -> return "Divider"
            FocusState -> return "FocusState"
            Label -> return "Label"
            LabeledContent -> return "Labeled Content"
            Link -> return "Link"
            OnSubmit -> return "OnSubmit"
            ScenePhase -> return "ScenePhase"
            SecureField -> return "SecureField"
            Spacer -> return "Spacer"
            Toggle -> return "Toggle"
            ZIndex -> return "ZIndex"
        }
    }

    function body() -> Any Widget {
        match self {
            Color -> return ColorPlayground()
            Divider -> return DividerPlayground()
            FocusState -> return FocusStatePlayground()
            Label -> return LabelPlayground()
            LabeledContent -> return LabeledContentPlayground()
            Link -> return LinkPlayground()
            OnSubmit -> return OnSubmitPlayground()
            ScenePhase -> return ScenePhasePlayground()
            SecureField -> return SecureFieldPlayground()
            Spacer -> return SpacerPlayground()
            Toggle -> return TogglePlayground()
            ZIndex -> return ZIndexPlayground()
        }
    }
}

// The page a playground's row goes on to: the playground under its title.
construct PlaygroundRoute(playground: PlaygroundType) extends NavigationRoute {
    function routeKey() -> String {
        return "playground/" + playground.title()
    }

    function destination() -> Any Widget {
        return playground.body().navigationTitle(playground.title())
    }
}
