import KiraUI
import Foundation

@Main
function main() {
    let bundleIdentifier: String = klist!("Info.klist", "BundleIdentifier")
    RunKiraWindowApp(
        "Showcase",
        1180,
        820,
        { in
            return ContentView()
        },
        noopEngineFrame,
        false,
        move bundleIdentifier
    )
}
