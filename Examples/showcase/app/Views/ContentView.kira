import KiraUI

// The tabs the app opens on, by the value each is tagged with.
namespace ContentTab {
    let about: String = "about"
    let showcase: String = "showcase"
    let settings: String = "settings"
}

construct ContentView() extends Widget {
    @AppStorage("tab") var tab: String = ContentTab.about
    @AppStorage("appearance") var appearance: String = ""

    body {
        TabView(selection: $tab) {
            AboutView()
            .tag(ContentTab.about)
            .tabItem {
                Label(title = "About", systemImage = .InfoCircle)
            }
            PlaygroundNavigationView()
            .tag(ContentTab.showcase)
            .tabItem {
                Label {
                    Text("Showcase")
                } icon: {
                    Image(name = "widgets")
                }
            }
            SettingsView(appearance: $appearance)
            .tag(ContentTab.settings)
            .tabItem {
                Label(title = "Settings", systemImage = .GearSolid)
            }
        }
        .preferredColorScheme(colorScheme(appearance))
    }
}

// The scheme the appearance setting asks for, or the person's own while it
// asks for none.
function colorScheme(appearance: borrow String) -> Optional<ColorScheme> {
    match appearance {
        "dark" -> return .Some(.Dark)
        "light" -> return .Some(.Light)
        else -> return .None
    }
}
