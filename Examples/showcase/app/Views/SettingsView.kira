import KiraUI

construct SettingsView(appearance: Binding<String>) extends Widget {
    body {
        NavigationStack {
            Form {
                Picker(title: "Appearance", selection: appearance) {
                    Text("System").tag("")
                    Text("Light").tag("light")
                    Text("Dark").tag("dark")
                }
                LabeledContent(
                    label: ShowcaseApp.name,
                    value: ShowcaseApp.version + " (" + String(ShowcaseApp.buildNumber) + ")"
                )
            }
            .navigationTitle("Settings")
        }
    }
}
