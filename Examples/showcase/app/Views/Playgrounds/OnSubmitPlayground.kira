import KiraUI

construct OnSubmitPlayground() extends Widget {
    @State var text1: String = ""
    @State var text2: String = ""
    @State var submitText: String = ""

    body {
        Form {
            HStack {
                Text(submitText)
                Spacer()
                Button(title: "Clear", action: { in
                    submitText = ""
                    return
                })
            }
            TextField(title: "Text1", text: $text1)
            .onSubmit(action: { in
                submitText = submitText + "Text1 "
                return
            })
            TextField(title: "Text2", text: $text2)
            .onSubmit(action: { in
                submitText = submitText + "Text2 "
                return
            })
        }
        .onSubmit(action: { in
            submitText = submitText + "Form "
            return
        })
        .toolbar {
            PlaygroundSourceLink(file: "OnSubmitPlayground.swift")
        }
    }
}
