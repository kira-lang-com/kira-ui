import KiraUI

construct LinkPlayground() extends Widget {
    let destination: String = "https://example.com"

    body {
        ScrollView {
            VStack(spacing: .Length(16.0)) {
                Link(destination: destination) {
                    Text(".init(destination:label:)")
                }
                Link(title: ".init(title:destination:)", destination: destination)
                Link(destination: destination) {
                    Icon(symbol: .HeartFill)
                }
                .border(color: .Blue)
                Link(title: ".buttonStyle(.Bordered)", destination: destination)
                .buttonStyle(.Bordered)
                Link(title: ".foregroundColor(.Red)", destination: destination)
                .foregroundColor(.Red)
                Link(title: ".tint(.Red)", destination: destination)
                .tint(.Red)
                Button(title: "openURL(_:)", action: { in
                    openURL(destination)
                    return
                })
            }
            .padding()
        }
    }
}
