import KiraUI

construct TogglePlayground() extends Widget {
    @State var isOn: Bool = false

    body {
        ScrollView {
            VStack(spacing: .Length(16.0)) {
                Toggle(isOn: isOn, onChange: { on in
                    isOn = on
                    return
                }) {
                    Text("Viewbuilder init")
                }
                Toggle(title: "String init", isOn: $isOn)
                Toggle(title: "Fixed width", isOn: $isOn)
                .width(scaledMetric(200.0))
                VStack {
                    Text(".labelsHidden():")
                    Toggle(title: "Label", isOn: $isOn)
                }
                .labelsHidden()
                Toggle(title: ".disabled(true)", isOn: $isOn)
                .disabled(true)
                Toggle(title: ".foregroundColor(.Red)", isOn: $isOn)
                .foregroundColor(.Red)
                Toggle(title: ".tint(.Red)", isOn: $isOn)
                .tint(.Red)
            }
            .padding()
        }
        .toolbar {
            PlaygroundSourceLink(file: "TogglePlayground.swift")
        }
    }
}
