import KiraUI

construct DividerPlayground() extends Widget {
    body {
        ScrollView {
            VStack(spacing: .Length(16.0)) {
                VStack {
                    Text("Default")
                    Divider()
                }
                VStack {
                    Text("Fixed width")
                    Divider()
                    .width(scaledMetric(100.0))
                }
                HStack {
                    Text("Vertical")
                    .padding()
                    Divider()
                }
                .height(scaledMetric(100.0))
                HStack {
                    Text("Vertical fixed height")
                    .padding()
                    Divider()
                    .height(scaledMetric(50.0))
                }
                .height(scaledMetric(100.0))
                VStack {
                    Text(".foregroundColor(.Red)")
                    Divider()
                    .foregroundColor(.Red)
                }
                VStack {
                    Text(".tint(.Red)")
                    Divider()
                    .tint(.Red)
                }
                Text("Note: colors should not affect Divider appearance")
                .typography(.caption)
            }
            .padding()
        }
    }
}
