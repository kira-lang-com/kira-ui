import KiraUI

construct SecureFieldPlayground() extends Widget {
    @State var text: String = ""

    body {
        ScrollView {
            VStack(spacing: .Length(16.0)) {
                SecureField(title: "Default", text: $text)
                SecureField(title: "With prompt", text: $text, prompt: "Prompt")
                SecureField(title: "Fixed width", text: $text)
                .width(scaledMetric(200.0))
                SecureField(title: ".disabled(true)", text: $text)
                .disabled(true)
                SecureField(title: ".foregroundColor(.Red)", text: $text)
                .foregroundColor(.Red)
                SecureField(title: ".tint(.Red)", text: $text)
                .tint(.Red)
            }
            .textFieldStyle(.RoundedBorder)
            .padding()
        }
        .toolbar {
            PlaygroundSourceLink(file: "SecureFieldPlayground.swift")
        }
    }
}
