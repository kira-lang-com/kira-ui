import KiraUI

construct ColorPlayground() extends Widget {
    body {
        ScrollView {
            VStack(spacing: .Length(16)) {
                colorRow(Text("Red"), Color(.Red))
                colorRow(Text("Red, .opacity(0.5)"), Color(.Red).opacity(0.5))
                colorRow(Text("RGB"), Color(red: 1, green: 0, blue: 0))
                colorRow(Text("White, Opacity"), Color(white: 0.5, opacity: 1))
                colorRow(Text("Accent color"), Color(.Accent))
                colorRow(Text("Red"), Color(.Red))
                colorRow(Text("Orange"), Color(.Orange))
                colorRow(Text("Yellow"), Color(.Yellow))
                colorRow(Text("Green"), Color(.Green))
                colorRow(Text("Mint"), Color(.Mint))
                colorRow(Text("Teal"), Color(.Teal))
                colorRow(Text("Cyan"), Color(.Cyan))
                colorRow(Text("Blue"), Color(.Blue))
                colorRow(Text("Indigo"), Color(.Indigo))
                colorRow(Text("Purple"), Color(.Purple))
                colorRow(Text("Pink"), Color(.Pink))
                colorRow(Text("Brown"), Color(.Brown))
                colorRow(Text("White"), Color(.White))
                colorRow(Text("Gray"), Color(.Gray))
                colorRow(Text("Black"), Color(.Black))
                colorRow(Text("Clear"), Color(.Clear))
                colorRow(Text("Primary"), Color(.Primary))
                colorRow(Text("Secondary"), Color(.Secondary))
            }
            .padding()
        }
    }

    function colorRow(label: Text, color: Any Widget) -> Any Widget {
        return HStack {
            label
            Spacer()
            color
            .frame(width: 100, height: 100)
        }
    }
}
