import KiraUI

construct SpacerPlayground() extends Widget {
    body {
        ScrollView {
            VStack(spacing: .Length(16.0)) {
                HStack {
                    Text("Before")
                    Spacer()
                    Text("After")
                }
                HStack {
                    Text("Before fixed")
                    Spacer()
                    .width(scaledMetric(100.0))
                    Text("After fixed")
                }
                VStack {
                    Text("Before vstack")
                    Spacer()
                    .height(scaledMetric(100.0))
                    Text("After vstack")
                }
                HStack {
                    Text("Before minLength")
                    Spacer(minLength: scaledMetric(32.0))
                    Text("After minLength")
                }
                .width(scaledMetric(200.0))
            }
            .padding()
        }
    }
}
