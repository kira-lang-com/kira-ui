import KiraUI

construct ScenePhasePlayground() extends Widget {
    @Environment(\.scenePhase) let scenePhase: ScenePhase
    @State var history: [ScenePhase] = []

    body {
        List {
            Section {
                For(phase in history) {
                    Text(description_ScenePhase(phase))
                }
            } header: {
                Text("ScenePhase history")
            }
        }
        .onChange(of: scenePhase, action: { previous, phase in
            history.append(phase)
            return
        })
    }
}
