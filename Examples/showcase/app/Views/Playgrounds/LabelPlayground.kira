import KiraUI

construct LabelPlayground() extends Widget {
    body {
        ScrollView {
            VStack(spacing: .Length(16.0)) {
                Label {
                    Text(".init(content:icon:)")
                } icon: {
                    Icon(symbol: .StarFill)
                }
                Label(title = ".init(title:systemImage:)", systemImage = .StarFill)
                Label(title = ".typography(.title)", systemImage = .StarFill)
                .typography(.title)
                Label(title = ".foregroundColor(.Red)", systemImage = .StarFill)
                .foregroundColor(.Red)

                VStack {
                    Label(title = ".tint(.Red)", systemImage = .StarFill)
                    .tint(.Red)
                    Text("Note: tint should not affect Label appearance")
                    .typography(.caption)
                }

                Section {
                    Label(title = "Icon + Title", systemImage = .HeartFill)
                    .labelStyle(.TitleAndIcon)
                    Label(title = "Title Only", systemImage = .HeartFill)
                    .labelStyle(.TitleOnly)
                    HStack {
                        Text("Icon Only:")
                        .foregroundColor(.Secondary)
                        Label(title = "Icon Only", systemImage = .HeartFill)
                        .labelStyle(.IconOnly)
                    }
                } header: {
                    Text("Label Styles")
                }
            }
            .padding()
            .toolbar {
                ToolbarItemGroup(placement = .Navigation) {
                    Label(title = "Icon Only", systemImage = .HeartFill)
                    Label(title = "+ Title", systemImage = .StarFill)
                    .labelStyle(.TitleAndIcon)
                    Label(title = "Title Only", systemImage = .StarFill)
                    .labelStyle(.TitleOnly)
                }
            }
        }
        .toolbar {
            PlaygroundSourceLink(file: "LabelPlayground.swift")
        }
    }
}
