import KiraUI

construct FocusStatePlayground() extends Widget {
    @State var textA: String = ""
    @State var textB: String = ""

    @FocusState var focusBool: Bool = false
    @FocusState var focusEnum: FocusField? = .None

    body {
        Form {
            NavigationLink(title: "Push", value: PushedRoute())
            Text("Boolean: \(focusBool)")
            Text("Enum: \(focusEnum == .Some(.TextA) ? "A" : (focusEnum == .Some(.TextB) ? "B" : "nil"))")
            TextField(title: "textA", text: $textA)
            .focused($focusBool)
            .focused($focusEnum, equals: .TextA)
            TextField(title: "textB", text: $textB)
            .focused($focusEnum, equals: .TextB)
            Button(title: "Set focus to A via Boolean", action: { in
                focusBool = true
                return
            })
            Button(title: "Set focus to A via Enum", action: { in
                focusEnum = .Some(.TextA)
                return
            })
            Button(title: "Set focus to B via Enum", action: { in
                focusEnum = .Some(.TextB)
                return
            })
            Button(title: "Nil Enum", action: { in
                focusEnum = .None
                return
            })
        }
    }
}

enum FocusField {
    TextA
    TextB
}

// The page "Push" goes on to.
construct PushedRoute() extends NavigationRoute {
    function routeKey() -> String {
        return "focus-state/pushed"
    }

    function destination() -> Any Widget {
        return Text("Pushed")
    }
}
