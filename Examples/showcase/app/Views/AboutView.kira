import KiraUI

// What the Showcase app is.
construct AboutView() extends Widget {
    body {
        VStack {
            VStack(spacing: .None) {
                Text("Showcase is an app written in Kira and KiraUI. It demonstrates and exercises KiraUI's support for various SwiftUI constructs.")
                .padding()
            }
            .background(
                RoundedRectangle(cornerRadius: 20.0)
                .stroke()
                .opacity(0.2)
            )
        }
        .padding()
    }
}
